// 498:0
[mainmodal_window]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
onload=script8420(contact_scroll_blood:mainmodal_window_background, contact_scroll_blood:mainmodal_window_border, contact_scroll_blood:mainmodal_window_content, contact_scroll_blood:mainmodal_window_close_button, "Scroll", toplevel_v2_default_main_modal_skin_data, 1007)

// 498:1
[mainmodal_window_background]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=mainmodal_window

// 498:2
[mainmodal_window_content]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=mainmodal_window

// 498:3
[com_3]
type=graphic
width=496
height=293
xmode=abs_centre
ymode=abs_centre
layer=mainmodal_window_content
graphic=rs3_parchment_scroll_background

// 498:4
[com_4]
type=model
width=424
height=262
xmode=abs_centre
ymode=abs_centre
layer=mainmodal_window_content
model=if_scroll_bloodstain
modelorigin=-15,-47
modelangle=406,0,0
modelzoom=450

// 498:5
[contact_scroll_text]
type=text
width=388
height=181
xmode=abs_centre
ymode=abs_centre
layer=mainmodal_window_content
textfont=museo_sans_13pt_bold
fontmono=no
text=Kaleef<br><br>Your mission is to contact our agent inside Menaphos.<br>Use the tunnels beneath the temple of lesser gods.<br>Be vigilant of traps and the hostile natives.<br> They're about as welcoming as the Menaphites only slightly better looking.<br><br>Os
textlineheight=17
textalignh=centre
colour=0x000000

// 498:6
[mainmodal_window_border]
type=layer
widthmode=minus
heightmode=minus
layer=mainmodal_window

// 498:7
[mainmodal_window_close_button]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_right
layer=mainmodal_window
transmitop=1
op1=Close
onop=closebutton_click

