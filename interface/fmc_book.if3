// 1200:0
[grids]
type=text
width=14739
height=14729
widthmode=proportion
heightmode=proportion
xmode=abs_centre
ymode=abs_centre
layer=guide_clickarea
textfont=palatino_linotype_14pt_regular
fontmono=no
text=Firemaker's Guide
textalignh=centre
textalignv=centre
colour=0x3d1206
onmouseover=script5595(event_com)
onmouseleave=script5596(event_com)
onclick=script5597(event_com)
onrelease=script5596(event_com)

