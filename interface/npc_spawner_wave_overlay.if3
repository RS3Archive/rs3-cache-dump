// 849:0
[bespoke_window]
type=layer
width=124
height=74
xmode=abs_centre
onload=script11033(55640065, 55640070, 55640066, -1, "", 21259, 1005, 33700)

// 849:1
[bespoke_window_background]
type=layer
x=4
y=4
width=8
height=8
widthmode=minus
heightmode=minus
layer=bespoke_window

// 849:2
[bespoke_window_content]
type=layer
x=4
y=4
width=8
height=8
widthmode=minus
heightmode=minus
layer=bespoke_window

// 849:3
[wave_text]
type=text
x=10
y=3
width=55
height=24
layer=bespoke_window_content
textfont=museo_sans_17pt_bold
fontmono=no
text=Wave:
textshadow=yes
onvartransmit=script2779

// 849:4
[wave_numbers]
type=text
x=76
y=3
width=34
height=24
layer=bespoke_window_content
textfont=museo_sans_17pt_bold
fontmono=no
text=X/Y
textshadow=yes
onload=script2779
onvartransmit=script2779

// 849:5
[start_encounter_button]
type=layer
x=8
y=36
width=100
height=27
layer=bespoke_window_content
transmitop=1
op1=Start
onload=script13968(event_com, -1, 28553, "Start")

// 849:6
[bespoke_window_border]
type=layer
widthmode=minus
heightmode=minus
layer=bespoke_window

