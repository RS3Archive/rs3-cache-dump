// 1149:4
[mainmodal_window]
type=layer
widthmode=minus
heightmode=minus
ymode=abs_centre
onload=script8420(hw11_adboard:mainmodal_window_background, hw11_adboard:mainmodal_window_border, hw11_adboard:mainmodal_window_content, hw11_adboard:mainmodal_window_close_button, "Advertisement board", 21218, string_1007)

// 1149:5
[mainmodal_window_background]
