// 1794:0
[background]
type=layer
y=10
width=16
height=54
widthmode=minus
xmode=abs_centre
layer=content_layer
onload=rs3_background_panel(event_com, rs3_content_container_active)

// 1794:1
[trail_reward_box]
type=layer
y=10
width=16
height=54
widthmode=minus
xmode=abs_centre
layer=content_layer

// 1794:2
[mainmodal_window]
type=layer
width=110
height=110
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
onload=script8420(cs_week_2016_clues_reward:mainmodal_window_background, cs_week_2016_clues_reward:mainmodal_window_border, cs_week_2016_clues_reward:mainmodal_window_content, cs_week_2016_clues_reward:mainmodal_window_close_button, "Trail Complete!", toplevel_v2_default_main_modal_skin_data, 1007)

// 1794:3
[mainmodal_window_background]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=mainmodal_window

// 1794:4
[mainmodal_window_content]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=mainmodal_window

// 1794:5
[content_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=mainmodal_window_content

// 1794:6
[current_value]
type=text
y=-12
width=20
height=20
widthmode=minus
xmode=abs_centre
ymode=abs_centre
layer=content_layer
textfont=cinzel_13pt_bold
fontmono=no
text=Current Reward Value: XXXXXXXXXX coins!
textalignh=centre
textalignv=centre
textshadow=yes

// 1794:7
[mainmodal_window_border]
type=layer
widthmode=minus
heightmode=minus
layer=mainmodal_window

// 1794:8
[mainmodal_window_close_button]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_right
layer=mainmodal_window
transmitop=1
op1=Close
onop=closebutton_click

