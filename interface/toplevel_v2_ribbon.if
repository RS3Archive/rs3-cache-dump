// 1431:0
[window_build]
type=layer
widthmode=minus
heightmode=minus
layer=window_holder

// 1431:1
[ribbon_root]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre

// 1431:2
[legacy_columns]
type=layer
widthmode=minus
heightmode=minus
layer=ribbon_root
onvartransmit=script9928(toplevel_v2_ribbon:left_column, toplevel_v2_ribbon:right_column)
onvartransmitlist=toplevel_v2_general_varp

// 1431:3
[left_column]
type=graphic
width=20
heightmode=minus
layer=legacy_columns
hide=yes
graphic="rs3_legacy_column_tile,1"
tiling=yes
colour=0xffffff
clickmask=no

// 1431:4
[right_column]
type=graphic
width=20
heightmode=minus
xmode=abs_right
layer=legacy_columns
hide=yes
graphic="rs3_legacy_column_tile,1"
tiling=yes
colour=0xffffff
clickmask=no

// 1431:5
[quickchild_listener]
type=layer
width=1
height=1
xmode=abs_right
layer=ribbon_root

// 1431:6
[parent_listener]
type=layer
width=1
height=1
xmode=abs_right
layer=ribbon_root
transmitop1=yes
transmitop2=yes
transmitop3=yes
transmitop4=yes
transmitop5=yes
transmitop6=yes
transmitop7=yes
transmitop8=yes
op1=Open
op2=Open
op3=Open
op4=Open
op5=Open
op6=Open
op7=Open
op8=Open
opcursor1=cursor_open
opcursor0=cursor_open
onop=script5587(event_op)

// 1431:7
[error_msg]
type=text
width=45
height=45
widthmode=minus
heightmode=minus
layer=ribbon_root
textfont=museo_sans_11pt_regular_multiline
text=Click on the drawers to add buttons to this panel.
textalignh=1
textalignv=1
textshadow=yes

// 1431:8
[window_holder]
type=layer
widthmode=minus
heightmode=minus
layer=ribbon_root
onload=script13833(toplevel_v2_ribbon:window_build, toplevel_v2_ribbon:window_click)
onvartransmit=script13833(toplevel_v2_ribbon:window_build, toplevel_v2_ribbon:window_click)
onvartransmitlist=toplevel_v2_general_varp,toplevel_v2_skins_varp,toplevel_v2_parent_lock,toplevel_v2_parent_lock_2,seasonal_main,league_active_player

// 1431:9
[extra_button]
type=graphic
x=243
width=15
height=15
xmode=abs_centre
ymode=abs_centre
layer=ribbon_root
graphic=rs3_hud_menu_settings_btn
colour=0xffffff
clickmask=no
transmitop1=yes
op1=Select
opcursor0=cursor_use
onload=script10389(event_com)
