// 1431:10
[mode_button]
type=graphic
width=15
height=15
xmode=abs_right
ymode=abs_bottom
layer=ribbon_root
graphic=rs3_menu_btn_edit_normal
colour=0xffffff
clickmask=no
transmitop1=yes
op1=Select
opcursor0=cursor_use
onload=script10389(event_com)
onmouseover=graphic_swapper(event_com, rs3_menu_btn_edit_over)
onmouseleave=graphic_swapper(event_com, rs3_menu_btn_edit_normal)
onop=script2401

// 1431:11
[league_button]
type=graphic
width=48
height=48
ymode=abs_centre
layer=ribbon_root
noclickthrough=yes
graphic=rs3_icon_menu_leagues_active
colour=0xffffff
