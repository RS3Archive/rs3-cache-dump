// 423:0
[mainmodal_window]
type=layer
y=3
width=410
heightmode=minus
xmode=abs_centre
ymode=abs_centre
onload=script8420(fairy2_certificate_broken:mainmodal_window_background, fairy2_certificate_broken:mainmodal_window_border, fairy2_certificate_broken:mainmodal_window_content, fairy2_certificate_broken:mainmodal_window_close_button, "Certificate", toplevel_v2_default_main_modal_skin_data, 1007)

// 423:1
[mainmodal_window_background]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=mainmodal_window

// 423:2
[mainmodal_window_content]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=mainmodal_window

// 423:3
[com_3]
type=model
width=394
height=324
layer=mainmodal_window_content
model=fairy2_certificate_broken
modelorigin=16,5
modelangle=0,2047,0
modelzoom=179

// 423:4
[mainmodal_window_border]
type=layer
widthmode=minus
heightmode=minus
layer=mainmodal_window

// 423:5
[com_5]
type=text
x=80
y=98
width=276
height=17
layer=mainmodal_window_content
textfont=museo_sans_13pt_bold
fontmono=no
text=Certificate of Advanced Healing
textalignh=centre
textshadow=yes

// 423:6
[mainmodal_window_close_button]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_right
layer=mainmodal_window
transmitop=1
op1=Close
onop=closebutton_click

