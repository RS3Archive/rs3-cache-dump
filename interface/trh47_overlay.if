// 226:0
[universe]
type=layer
y=8
width=758
height=356
xmode=abs_centre
onload=trh47_interface_init
onvartransmit=script16301
onvartransmitlist=trh_promos_var21

// 226:1
[main_layer]
type=layer
width=758
height=356
layer=universe

// 226:2
[progress_layer]
type=layer
width=270
height=55
