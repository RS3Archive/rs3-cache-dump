// 975:0
[bespoke_window]
type=layer
width=218
height=80
xmode=abs_centre
ymode=abs_centre
onload=script8420(notes_colour_select:bespoke_window_background, notes_colour_select:bespoke_window_border, notes_colour_select:bespoke_window_content, notes_colour_select:close_button, "Select Colour", 21259, null)

// 975:1
[bespoke_window_background]
type=layer
x=4
y=4
width=8
height=8
widthmode=minus
heightmode=minus
layer=bespoke_window

// 975:2
[bespoke_window_content]
type=layer
x=4
y=4
width=8
height=8
widthmode=minus
heightmode=minus
layer=bespoke_window

// 975:3
[white_button_layer]
