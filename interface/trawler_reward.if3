// 367:0
[com_0]
type=model
width=302
height=254
xmode=abs_centre
ymode=abs_centre
layer=modal_dialog_window_content
model=ship_landednet
modelorigin=11,-2
modelangle=238,147,0
modelzoom=586

// 367:1
[items]
type=layer
x=10
y=10
width=20
height=240
widthmode=minus
layer=modal_dialog_window_content
noclickthrough=yes
onload=trawler_reward_setup(event_com)
oninvtransmit=trawler_reward_setup(event_com){trawler_rewardinv}

// 367:2
[warning]
type=text
x=10
y=10
width=20
height=24
widthmode=minus
ymode=abs_bottom
layer=modal_dialog_window_content
textfont=museo_sans_11pt_regular
fontmono=no
text=Items left in the net will be dumped on the ground<br>when this interface is closed.
textalignh=centre
textalignv=centre
textshadow=yes

// 367:3
[modal_dialog_window]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
onload=script8420(trawler_reward:modal_dialog_window_background, trawler_reward:modal_dialog_window_border, trawler_reward:modal_dialog_window_content, trawler_reward:modal_dialog_window_close_button, "Trawler Catch", toplevel_v2_default_modal_dialogue_skin_data, 1007)

// 367:4
[modal_dialog_window_background]
type=layer
y=40
width=16
height=48
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=modal_dialog_window

// 367:5
[modal_dialog_window_content]
type=layer
y=40
width=16
height=48
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=modal_dialog_window

// 367:6
[modal_dialog_window_border]
type=layer
widthmode=minus
heightmode=minus
layer=modal_dialog_window

// 367:7
[modal_dialog_window_close_button]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_right
layer=modal_dialog_window
transmitop=1
op1=Close
onop=closebutton_click

