// 410:8
[mainmodal_window]
type=layer
width=350
heightmode=minus
xmode=abs_centre
ymode=abs_centre
onload=script8420(warguild_defence:mainmodal_window_background, warguild_defence:mainmodal_window_border, warguild_defence:mainmodal_window_content, warguild_defence:mainmodal_window_close_button, "Catapult defence key", toplevel_v2_default_main_modal_skin_data, 1007)

