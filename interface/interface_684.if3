width=273
height=172
layer=com_0
textfont=fontmetrics_26
fontmono=no
text=Watch out for rabbits wandering around the farmyard. They are hungry and will look for flags, as they often mean hidden food! If a rabbit eats the seed under a flag, you will not get any points for it and will lose the flag. 
colour=0xaed0e0
transmitop=10
op10= 
onload=script10496(event_com, event_comsubid, 2)

// 684:3
