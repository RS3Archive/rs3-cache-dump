// 427:0
[mainmodal_window]
type=layer
widthmode=minus
heightmode=minus
ymode=abs_centre
onload=script8420(scroll_godfather:mainmodal_window_background, scroll_godfather:mainmodal_window_border, scroll_godfather:mainmodal_window_content, scroll_godfather:mainmodal_window_close_button, "Godfather scroll", 21218, string_1007)

// 427:1
