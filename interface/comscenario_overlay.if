// 1609:0
[button_draw]
type=layer
y=5
width=10
height=20
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_bottom
layer=button_layer

// 1609:1
[background]
type=layer
width=500
height=75
xmode=abs_centre
onload=script8420(comscenario_overlay:bespoke_window_background, comscenario_overlay:bespoke_window_border, comscenario_overlay:bespoke_window_content, null, "", 21259, null)
onvartransmit=comscenario_overlay_init
onvartransmitlist=comscenario_struct

// 1609:2
[button_layer]
type=layer
width=500
height=75
xmode=abs_centre

// 1609:3
[close_button]
type=graphic
x=482
y=3
width=16
height=16
layer=button_layer
graphic=rs3_btn_modal_window_1_close_nml
colour=0xffffff
clickmask=no
transmitop1=yes
op1=Close
onmouseover=graphic_swapper(event_com, rs3_btn_modal_window_1_close_ovr)
onmouseleave=graphic_swapper(event_com, rs3_btn_modal_window_1_close_nml)

