widthmode=minus
xmode=abs_centre
layer=com_11
textfont=fontmetrics_28
fontmono=no
text=Gain a Prestige level by completing your Assassin Contracts. Each level allows you to claim one prize. Complete the contracts up to five times to unlock all the prizes. The assassin walk override unlock token can also be won from Treasure Hunter.
textalignh=centre
