// 1818:3
[com_3]
type=text
x=5
width=180
widthmode=minus
heightmode=minus
layer=com_2
textfont=fontmetrics_207
fontmono=no
text=Sliske has placed you and the other gods into a Labyrinth that seems to span as far as your eyes can see.<br><br>There are two stages of the Labyrinth and each stage has been split into four sections.<br><br>The exit of the Labyrinth is always in the most <col=0xFFFFFF>north-easterly room of the north east section</col>.<br><br>Some parts of the Labyrinth seem to be impassable because that room needs to be rotated. If you encounter one of these rooms you will need to find and complete one of Sliske's devious puzzle rooms to rotate it to the correct position.<br><br>Beware: You are racing against all the other gods and the longer you take working out your path, the further ahead they get. <col=0xffffff>Time stands still when you are in a room, but advances when you leave through an archway</col>. Choose your steps carefully.
textalignh=centre
textalignv=centre
textshadow=yes
colour=0x7592a0

