// 1281:11
[close_button_layer]
type=graphic
width=32
height=32
xmode=abs_right
layer=bespoke_window
hide=yes
graphic="rs3_btn_close_24px,0"
colour=0xffffff
clickmask=no
transmitop1=yes
op1=Select
opcursor0=cursor_use
onload=script13914(event_com, rs3tli_24px_close_button)
onop=closebutton_click

// 1281:12
[nothing_to_show]
