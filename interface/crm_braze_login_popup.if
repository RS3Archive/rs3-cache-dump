width=800
height=600
hide=yes

// 1281:1
[backgroundlayer]
type=layer
width=800
height=600
layer=mainlayer

// 1281:2
[contentslayer]
type=layer
width=800
height=600
layer=mainlayer

// 1281:3
[boarderlayer]
type=layer
width=800
height=600
layer=mainlayer

// 1281:4
[closebuttonlayer]
type=layer
width=800
height=600
layer=mainlayer
