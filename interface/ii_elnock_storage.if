// 592:0
[contents]
type=layer
width=265
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=modal_dialog_window_content

// 592:1
[modal_dialog_window]
type=layer
width=280
height=250
xmode=abs_centre
ymode=abs_centre
onload=script8420(ii_elnock_storage:modal_dialog_window_background, ii_elnock_storage:modal_dialog_window_border, ii_elnock_storage:modal_dialog_window_content, ii_elnock_storage:modal_dialog_window_close_button, "Elnock's Equipment Store", 21217, string_1007)

// 592:2
[impling_jar_name]
type=text
height=32
widthmode=minus
heightmode=minus
layer=impling_jar
textfont=p12_full
textalignh=1
textalignv=2
textshadow=yes
colour=0x870000

// 592:3
[impling_jar_remove]
type=graphic
width=36
height=32
xmode=abs_centre
ymode=abs_bottom
layer=impling_jar
outline=1
graphicshadow=1
clickmask=no
transmitop1=yes
transmitop2=yes
transmitop3=yes
transmitop4=yes
transmitop10=yes
opbase=<col=ff9040>Impling jar
op1=Remove 1
op2=Remove 5
op3=Remove All
op4=Remove X
op10=Examine
onload=ii_storage_update(event_com, ii_impling_jar, 127, ii_elnock_storage:impling_jar_name)
onvartransmit=ii_storage_update(event_com, ii_impling_jar, 127, ii_elnock_storage:impling_jar_name)
onvartransmitlist=ii_player

