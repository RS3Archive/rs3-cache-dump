width=494
height=460
xmode=abs_centre
ymode=abs_centre
onload=script8420(mtxfair17_scav:background_layer, mtxfair17_scav:border_layer, mtxfair17_scav:content_layer, mtxfair17_scav:closebutton_layer, "Trixie's List", 21218, null)

