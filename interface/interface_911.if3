// 911:0
[com_0]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
onload=lobbyscreen_options_load

// 911:1
[com_1]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=com_0

// 911:2
[com_2]
type=text
height=30
widthmode=minus
layer=com_1
textfont=fontmetrics_93
fontmono=no
text=Options
textalignv=centre
textshadow=yes
colour=0xffcb05
onload=script10496(event_com, event_comsubid, 0)

// 911:3
[com_3]
type=layer
height=30
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_bottom
layer=com_1

