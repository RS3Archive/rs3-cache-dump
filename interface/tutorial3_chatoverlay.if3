[universe]
type=layer
width=6
height=6
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
onload=script2778(tutorial3_chatoverlay:display, tutorial3_chatoverlay:skip, tutorial3_chatoverlay:text_layer, tutorial3_chatoverlay:scrollbar)
onvartransmit=script2778(tutorial3_chatoverlay:display, tutorial3_chatoverlay:skip, tutorial3_chatoverlay:text_layer, tutorial3_chatoverlay:scrollbar)
onvarctransmit=script2778(tutorial3_chatoverlay:display, tutorial3_chatoverlay:skip, tutorial3_chatoverlay:text_layer, tutorial3_chatoverlay:scrollbar)
onvarcstrtransmit=script2778(tutorial3_chatoverlay:display, tutorial3_chatoverlay:skip, tutorial3_chatoverlay:text_layer, tutorial3_chatoverlay:scrollbar)
onvartransmitlist=option_mouse,tutorial,tutorial3_voice_enabled
onvarctransmitlist=tutorial3_object,tutorial3_graphic,tutorial3_imagewidth,tutorial3_imageheight
onvarcstrtransmitlist=varclientstring_2398,varclientstring_2399

// 896:1
[display]
type=layer
widthmode=minus
heightmode=minus
