// 896:0
[universe]
type=layer
width=6
height=6
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
onload=script2778(58720257, 58720260, 58720258, 58720259)
onvartransmit=script2778(58720257, 58720260, 58720258, 58720259){option_mouse, tutorial, tutorial3_voice_enabled}
onvarctransmit=script2778(58720257, 58720260, 58720258, 58720259){tutorial3_object, tutorial3_graphic, tutorial3_imagewidth, tutorial3_imageheight}
onvarcstrtransmit=script2778(58720257, 58720260, 58720258, 58720259){varclientstring_2398, varclientstring_2399}

// 896:1
[display]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=universe

// 896:2
[text_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=display

// 896:3
[scrollbar]
type=layer
width=16
heightmode=minus
xmode=abs_right
ymode=abs_centre
layer=display

// 896:4
[skip]
type=layer
width=180
height=22
xmode=abs_right
ymode=abs_bottom
layer=universe
hide=yes
transmitop=1
op1=Skip Tutorial
onmouseover=graphic_swapper(58720261, 2262)
onmouseleave=graphic_swapper(58720261, 2261)

// 896:5
[skip_graphic]
type=graphic
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=skip
graphic="km_buttonlongtemp00,0"
colour=0x000000

// 896:6
[com_6]
type=text
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=skip
textfont=p12_full
text=Skip Tutorial
textalignh=centre
textalignv=centre
textshadow=yes

