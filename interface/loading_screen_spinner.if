// 499:0
[base]
type=layer
widthmode=minus
heightmode=minus
noclickthrough=yes

// 499:1
[loading_rect]
type=rectangle
widthmode=minus
heightmode=minus
layer=base
colour=0x010000
fill=yes

// 499:2
[logo_layer]
type=layer
y=-77
width=705
height=352
xmode=abs_centre
ymode=abs_centre
layer=base

// 499:3
[rs3_logo]
type=graphic
x=-12
y=-50
width=556
height=182
xmode=abs_centre
ymode=abs_centre
layer=logo_layer
graphic=rs3_logo_medium
colour=0xffffff
clickmask=no

// 499:4
[spinner]
type=layer
y=44
width=100
height=100
xmode=abs_centre
ymode=abs_centre
layer=base
onload=spinner_create(event_com, 1, -1)

// 499:5
[map_loading_text]
type=text
y=-21
width=200
height=32
xmode=abs_centre
ymode=abs_centre
layer=base
textfont=cinzel_13pt_bold
text=loading
textalignh=1
textalignv=1
textshadow=yes

