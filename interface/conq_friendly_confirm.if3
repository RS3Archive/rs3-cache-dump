y=10
width=150
height=27
ymode=abs_bottom
layer=mainmodal_window_content
onload=script13968(conq_friendly_confirm:decline_build, conq_friendly_confirm:decline_click, rs3tli_negative_button, "Decline")

// 1021:12
[stake_status]
