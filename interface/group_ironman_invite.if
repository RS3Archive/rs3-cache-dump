// 1301:0
[bespoke_window]
type=layer
width=300
height=160
onload=script8420(group_ironman_invite:bespoke_window_background, group_ironman_invite:bespoke_window_border, group_ironman_invite:bespoke_window_content, null, "", 21259, string_1023)

// 1301:1
[bespoke_window_background]
type=layer
x=4
y=4
width=8
height=8
widthmode=minus
heightmode=minus
layer=bespoke_window

// 1301:2
[bespoke_window_content]
type=layer
x=4
y=4
width=8
height=8
widthmode=minus
heightmode=minus
layer=bespoke_window

// 1301:3
[confirm_button]
type=button
y=40
width=180
height=30
xmode=abs_centre
ymode=abs_bottom
layer=bespoke_window_content
noclickthrough=yes
sprite.graphic=button_action_positive
text.text=Accept
stylesheet=button_action_positive
transmitop1=yes
op1=Accept
onload=stylesheet_set(event_com)

// 1301:4
[invite_text]
type=text
y=5
height=65
widthmode=minus
layer=bespoke_window_content
textfont=museo_sans_13pt_regular
text=WWWWWWWWWWWW has invited you to join the group: Dungeoneering (Frozen)
textlineheight=14
textalignh=1
textalignv=1
textshadow=yes
colour=0xffcb05
maxlines=3
onload=script19475(event_com)
onvartransmit=script19475(event_com)
onvarctransmit=script19475(event_com)
onvartransmitlist=group_ironman_invite_type
onvarctransmitlist=group_ironman_cache_clan_name_client,group_ironman_inviter_name_client,group_ironman_create_ruleset_client

// 1301:5
[bespoke_window_border]
type=layer
widthmode=minus
heightmode=minus
layer=bespoke_window

// 1301:6
[cancel_button]
type=button
y=5
width=180
height=30
xmode=abs_centre
ymode=abs_bottom
layer=bespoke_window_content
noclickthrough=yes
sprite.graphic=button_action_negative
text.text=Decline
stylesheet=button_action_negative
transmitop1=yes
op1=Decline
onload=stylesheet_set(event_com)

