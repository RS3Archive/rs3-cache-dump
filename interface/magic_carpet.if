// 1928:0
[details_holder]
type=layer
widthmode=minus
heightmode=minus
layer=details_layer
onload=rs3_background_panel(event_com, rs3_icon_holder)

// 1928:1
[map]
type=graphic
width=361
height=294
xmode=abs_centre
ymode=abs_centre
layer=world_map
graphic=magic_carpet_shadow
colour=0xffffff
clickmask=no

// 1928:2
[com_2]
