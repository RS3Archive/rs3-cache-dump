// 1402:0
[modal_dialog_window]
type=layer
width=350
height=205
xmode=abs_centre
ymode=abs_centre
onload=script8420(combatv2_teleother:modal_dialog_window_background, combatv2_teleother:modal_dialog_window_border, combatv2_teleother:modal_dialog_window_content, combatv2_teleother:modal_dialog_window_close_button, "Teleport Offer", 21217, string_1007)

// 1402:1
[accept_button]
type=layer
width=140
height=27
ymode=abs_centre
layer=buttons_container
onload=script9798(combatv2_teleother:positive_build, combatv2_teleother:positive_click, rs3tli_positive_button, "Accept", "Accept")

// 1402:2
[decline_button]
type=layer
width=140
height=27
xmode=abs_right
ymode=abs_centre
layer=buttons_container
onload=script9798(combatv2_teleother:neutral_build_pause, combatv2_teleother:neutral_click_pause, rs3tli_neutral_button, "Decline", "Decline")
onop=closebutton_click

// 1402:3
[warning]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=buttons_container
noclickthrough=yes

// 1402:4
[warning_background]
type=layer
widthmode=minus
heightmode=minus
layer=warning
onload=script10896(event_com, null, rs3tli_content_panel_black)

// 1402:5
[warning_text]
