ymode=abs_centre
layer=warning
textfont=museo_sans_13pt_regular
text=Please think carefully!
textlineheight=13
textalignh=1
textalignv=1
textshadow=yes
colour=0xff0000

// 1402:6
[positive_build]
type=layer
widthmode=minus
heightmode=minus
layer=accept_button

// 1402:7
[positive_click]
