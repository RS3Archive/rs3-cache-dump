// 1234:0
[main_layer]
type=layer
width=85
height=30
onload=script3421(event_com, -1, 1025)

// 1234:1
[minigame_layer]
type=layer
width=25
height=25
ymode=abs_bottom
layer=main_layer
onvartransmit=script11065
onvartransmitlist=toplevel_v2_general_varp

// 1234:2
[fav_icon]
type=graphic
widthmode=minus
heightmode=minus
layer=minigame_layer
graphic="rs3_dnd_mini_games_icons,7"
colour=0xffffff
clickmask=no
onmouserepeat=script11066(event_com)

// 1234:3
[clock_window]
type=layer
x=25
width=55
height=25
ymode=abs_bottom
layer=main_layer
onload=script13018(clock_wrapper:clock_window_background, clock_wrapper:clock_window_border, clock_wrapper:clock_window_content)
onvartransmit=script18278
onvartransmitlist=toplevel_v2_general_varp

// 1234:4
[event_alert_layer]
type=layer
width=18
height=18
xmode=abs_right
layer=main_layer
hide=yes
onmouserepeat=script1272(event_com)

// 1234:5
[clock_window_background]
type=layer
x=4
y=4
width=8
height=8
widthmode=minus
heightmode=minus
layer=clock_window

// 1234:6
[clock_window_content]
type=layer
x=4
y=4
width=8
height=8
widthmode=minus
heightmode=minus
layer=clock_window

// 1234:7
[utc_layer]
type=layer
widthmode=minus
heightmode=minus
layer=clock_window_content

// 1234:8
[oplayer]
type=layer
width=47
height=17
layer=clock_window_content
transmitop1=yes
op1=Open Calendar

// 1234:9
[clock_window_border]
type=layer
widthmode=minus
heightmode=minus
layer=clock_window

// 1234:10
[com_10]
type=graphic
widthmode=minus
heightmode=minus
layer=event_alert_layer
graphic=rs3_icon_info
colour=0xffffff
clickmask=no

// 1234:11
[alert_text]
type=text
widthmode=minus
heightmode=minus
layer=event_alert_layer
hide=yes
textfont=p11_full
textshadow=yes

