// 785:2
[mainmodal_window]
type=layer
width=62
height=72
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
onload=script8420(51445763, 51445765, 51445764, 51445766, "Circus Rewards", 21218, 1007)

// 785:3
[mainmodal_window_background]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=mainmodal_window

// 785:4
[mainmodal_window_content]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=mainmodal_window

// 785:5
[mainmodal_window_border]
type=layer
widthmode=minus
heightmode=minus
layer=mainmodal_window

// 785:6
[mainmodal_window_close_button]
