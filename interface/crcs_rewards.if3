// 785:0
[main_inv]
type=layer
x=-10
width=391
height=210
xmode=abs_centre
ymode=abs_centre
layer=mainmodal_window_content
transmitop=10
op10= 

// 785:1
[scrollbar]
type=layer
x=10
width=16
height=210
xmode=abs_right
ymode=abs_centre
layer=mainmodal_window_content
