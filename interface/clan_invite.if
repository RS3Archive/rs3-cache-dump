// 699:0
[bespoke_window]
type=layer
width=300
height=140
onload=script8420(clan_invite:bespoke_window_background, clan_invite:bespoke_window_border, clan_invite:bespoke_window_content, null, "", 21259, string_1023)

// 699:1
[bespoke_window_background]
type=layer
x=4
y=4
width=8
height=8
widthmode=minus
heightmode=minus
layer=bespoke_window

// 699:2
[bespoke_window_content]
type=layer
x=4
y=4
width=8
height=8
widthmode=minus
heightmode=minus
layer=bespoke_window

// 699:3
[invite_text]
type=text
height=45
widthmode=minus
layer=bespoke_window_content
textfont=museo_sans_13pt_regular
text=WWWWWWWWWWWW has invited you to join the group: Dungeoneering (Frozen)
textlineheight=14
textalignh=1
textalignv=1
textshadow=yes
colour=0xffcb05
maxlines=3
onload=script10385(event_com)
onvarctransmit=script10385(event_com)
onvarctransmitlist=group_invited_name,group_inviter_name

// 699:4
[accept]
type=layer
y=47
width=150
height=27
xmode=abs_centre
layer=bespoke_window_content
transmitop1=yes
op1=Select
opcursor0=cursor_use
onload=script13968(event_com, null, rs3tli_positive_button, "Accept")

// 699:5
[decline]
type=layer
y=77
width=150
height=27
xmode=abs_centre
layer=bespoke_window_content
transmitop1=yes
op1=Select
opcursor0=cursor_use
onload=script13968(event_com, null, rs3tli_neutral_button, "Decline")

// 699:6
[checkbox_default]
type=layer
y=4
width=20
height=18
widthmode=minus
xmode=abs_centre
ymode=abs_bottom
layer=bespoke_window_content
transmitop1=yes
op1=Toggle
onload=script886
onvartransmit=script886
onop=script10387
onvartransmitlist=group_perm1

// 699:7
[checkbox]
type=graphic
width=18
height=18
ymode=abs_centre
layer=checkbox_default
graphic="rs3_btn_checkbox,0"
colour=0xffffff
clickmask=no

// 699:8
[checkbox_text]
type=text
width=23
widthmode=minus
heightmode=minus
xmode=abs_right
ymode=abs_centre
layer=checkbox_default
textfont=museo_sans_11pt_regular
text=Show this popup by default.
textalignv=1
textshadow=yes
colour=0xaed0e0
onload=script10496(event_com, event_comsubid, 2)

// 699:9
[bespoke_window_border]
type=layer
