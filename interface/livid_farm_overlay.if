// 752:0
[bespoke_window]
type=layer
width=180
height=30
onload=script8420(livid_farm_overlay:bespoke_window_background, livid_farm_overlay:bespoke_window_border, livid_farm_overlay:bespoke_window_content, null, "", 21259, null)

// 752:1
[bespoke_window_background]
type=layer
x=4
y=4
width=8
height=8
widthmode=minus
heightmode=minus
layer=bespoke_window

// 752:2
[bespoke_window_content]
type=layer
x=4
y=4
width=8
height=8
widthmode=minus
heightmode=minus
layer=bespoke_window

// 752:3
[livid_farm_points]
type=text
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=bespoke_window_content
textfont=museo_sans_11pt_regular
text=Current produce: 0
textalignh=1
textalignv=1
textshadow=yes
colour=0x7592a0
onload=script10204
onvartransmit=script10205
onvartransmitlist=lunarfm_main4

// 752:4
[bespoke_window_border]
type=layer
widthmode=minus
heightmode=minus
layer=bespoke_window

