// 512:0
[bespoke_window]
type=layer
width=300
height=112
xmode=abs_centre
ymode=abs_centre
transmitop1=yes
op1=Close
onload=script8420(info_popup:bespoke_window_background, info_popup:bespoke_window_border, info_popup:bespoke_window_content, null, "", 21259, null)

// 512:1
[bespoke_window_background]
type=layer
x=4
y=4
width=8
height=8
widthmode=minus
heightmode=minus
layer=bespoke_window

// 512:2
[bespoke_window_content]
type=layer
x=4
y=4
width=8
height=8
widthmode=minus
heightmode=minus
layer=bespoke_window

// 512:3
[header_layer]
type=layer
height=64
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=bespoke_window_content

// 512:4
[title]
type=text
height=20
widthmode=minus
layer=header_layer
textfont=cinzel_13pt_bold
textalignh=1
textalignv=1
textshadow=yes
onload=script10496(event_com, event_comsubid, 0)

// 512:5
[subtitle]
type=text
height=20
widthmode=minus
heightmode=minus
ymode=abs_bottom
layer=header_layer
textfont=museo_sans_13pt_bold
textalignh=1
textalignv=1
textshadow=yes
onload=script10496(event_com, event_comsubid, 2)

// 512:6
[icon_layer]
type=layer
x=2
y=4
width=58
height=58
ymode=abs_bottom
layer=bespoke_window_content

// 512:7
[graphic]
type=graphic
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=icon_layer
colour=0xffffff
clickmask=no

// 512:8
[obj]
type=graphic
width=36
height=32
xmode=abs_centre
ymode=abs_centre
layer=icon_layer
noclickthrough=yes
colour=0xffffff
clickmask=no

// 512:9
[bespoke_window_border]
type=layer
widthmode=minus
heightmode=minus
layer=bespoke_window

// 512:10
[bespoke_window_flash]
type=layer
widthmode=minus
heightmode=minus
layer=bespoke_window

// 512:11
[description]
type=text
x=4
y=4
width=67
height=58
widthmode=minus
xmode=abs_right
ymode=abs_bottom
layer=bespoke_window_content
textfont=museo_sans_11pt_regular
textalignh=1
textalignv=1
textshadow=yes
onload=script10496(event_com, event_comsubid, 3)

// 512:12
[flash]
type=rectangle
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=bespoke_window_flash
colour=0xffffff
fill=yes

