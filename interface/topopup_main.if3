// 70:12
[mainmodal_window]
type=layer
widthmode=minus
heightmode=minus
ymode=abs_centre
onload=script8420(topopup_main:mainmodal_window_background, topopup_main:mainmodal_window_border, topopup_main:mainmodal_window_content, topopup_main:mainmodal_window_close_button, "Special Offer", toplevel_v2_default_main_modal_skin_data, 1007)

