// 478:0
[imp_deposit_instructions]
type=text
y=2
height=30
widthmode=minus
xmode=abs_centre
ymode=abs_bottom
layer=mainmodal_window_content
textfont=museo_sans_11pt_regular
text=Select an item or stack of items to deposit. <br>You can deposit up to 2 items or stacks.
textalignh=1
textshadow=yes
colour=0xff981f
onload=script10496(event_com, event_comsubid, 2)

// 478:1
[imp_deposit_layer]
type=layer
y=-10
width=10
height=36
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=mainmodal_window_content
oninvtransmit=imp_bank_setup
oninvtransmitlist=inv

// 478:2
[mainmodal_window]
type=layer
width=350
height=250
xmode=abs_centre
ymode=abs_centre
onload=script8420(bank_deposit_imp:mainmodal_window_background, bank_deposit_imp:mainmodal_window_border, bank_deposit_imp:mainmodal_window_content, bank_deposit_imp:mainmodal_window_close_button, "Imp Release Negotiation Form", 21218, string_1007)

// 478:3
[mainmodal_window_background]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=mainmodal_window

// 478:4
[mainmodal_window_content]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=mainmodal_window

// 478:5
[mainmodal_window_border]
type=layer
widthmode=minus
heightmode=minus
layer=mainmodal_window

// 478:6
[mainmodal_window_close_button]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_right
layer=mainmodal_window
transmitop1=yes
op1=Close
onop=closebutton_click

