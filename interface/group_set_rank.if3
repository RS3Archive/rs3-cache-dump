// 1525:0
[invite_text]
type=text
height=45
widthmode=minus
layer=mainmodal_window_content
textfont=museo_sans_13pt_regular
fontmono=no
textlineheight=15
textalignh=centre
textalignv=centre
textshadow=yes
maxlines=3

// 1525:1
[base]
type=layer
widthmode=minus
heightmode=minus
onload=script8420(99942402, 99942405, 99942403, 99942406, "Set Rank", 21218, 1023)

// 1525:2
[mainmodal_window_background]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=base

// 1525:3
[mainmodal_window_content]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=base
onload=static_dropdown_create(99942404, 99942407, 9174, "Select a rank", 0)

// 1525:4
[dropdown_base_build]
type=layer
y=45
height=45
widthmode=minus
heightmode=minus
layer=mainmodal_window_content

// 1525:5
[mainmodal_window_border]
type=layer
widthmode=minus
heightmode=minus
layer=base

// 1525:6
[mainmodal_window_close_button]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_right
layer=base
transmitop=1
op1=Close

// 1525:7
[dropdown_base_text]
type=layer
y=45
height=45
widthmode=minus
heightmode=minus
layer=mainmodal_window_content
transmitop=1
op1=Select
opcursor0=cursor_use

