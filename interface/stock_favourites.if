y=30
width=16
height=34
heightmode=minus
xmode=abs_right
layer=search_layer

// 707:25
[search_warning_layer]
type=layer
y=20
height=20
widthmode=minus
heightmode=minus
layer=search_layer

// 707:26
[com_26]
type=text
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=search_warning_layer
textfont=museo_sans_13pt_regular
text=Grand Exchange Favourite Item Search<br><br>To search for an item, start by typing part of its name.<br>Then simply select the item you want from the results on display.
textalignh=1
textalignv=1
textshadow=yes
colour=0xffcb05

