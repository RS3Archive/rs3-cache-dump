opcursor0=cursor_use

// 707:22
[search_build]
type=layer
widthmode=minus
heightmode=minus
layer=search_scrolling

// 707:23
[search_obj]
type=layer
widthmode=minus
heightmode=minus
layer=search_scrolling

// 707:24
[search_build_scrollbar]
type=layer
