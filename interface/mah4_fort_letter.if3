// 86:0
[mainmodal_window]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
onload=script8420(mah4_fort_letter:mainmodal_window_background, mah4_fort_letter:mainmodal_window_border, mah4_fort_letter:mainmodal_window_content, mah4_fort_letter:mainmodal_window_close_button, "Letter", toplevel_v2_default_main_modal_skin_data, 1007)

// 86:1
[mainmodal_window_background]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=mainmodal_window

// 86:2
[mainmodal_window_content]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=mainmodal_window

// 86:3
[com_3]
type=graphic
width=496
height=293
xmode=abs_centre
ymode=abs_centre
layer=mainmodal_window_content
graphic=rs3_parchment_scroll_background

