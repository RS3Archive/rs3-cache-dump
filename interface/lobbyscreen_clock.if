// 801:0
[main_layer]
type=layer
widthmode=minus
heightmode=minus

// 801:1
[clock_window]
type=layer
width=55
height=25
ymode=abs_bottom
layer=main_layer
onload=script3938(lobbyscreen_clock:clock_window_background, lobbyscreen_clock:clock_window_border, lobbyscreen_clock:clock_window_content, null, "", 21259, null)

// 801:2
[clock_window_background]
type=layer
x=4
y=4
width=8
height=8
widthmode=minus
heightmode=minus
layer=clock_window

// 801:3
[clock_window_content]
type=layer
x=4
y=4
width=8
height=8
widthmode=minus
heightmode=minus
layer=clock_window

// 801:4
[utc_layer]
type=layer
widthmode=minus
heightmode=minus
layer=clock_window_content

// 801:5
[time]
type=text
widthmode=minus
heightmode=minus
layer=utc_layer
textfont=notosans_14
text=22:22
textalignh=1
textalignv=1
textshadow=yes
colour=0xffcb05
onload=script10496(event_com, event_comsubid, 0)

// 801:6
[clock_window_border]
type=layer
widthmode=minus
heightmode=minus
layer=clock_window

