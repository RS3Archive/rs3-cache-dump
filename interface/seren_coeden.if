// 1667:4
[close]
type=graphic
x=7
y=4
width=38
height=38
xmode=abs_right
layer=eyelids
graphic="aif_close_1,0"
colour=0xffffff
clickmask=no
transmitop1=yes
op1=Exit
opcursor0=cursor_enter
onmouseover=graphic_swapper(event_com, "aif_close_1,1")
onmouseleave=graphic_swapper(event_com, "aif_close_1,0")

