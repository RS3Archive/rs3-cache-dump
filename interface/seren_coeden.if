// 1667:0
[com_0]
type=rectangle
widthmode=minus
heightmode=minus
layer=background
colour=0xffffff

// 1667:1
[background]
type=layer
widthmode=minus
heightmode=minus
noclickthrough=yes

// 1667:2
[top_lid]
type=rectangle
height=1
widthmode=minus
layer=eyelids
colour=0x000000
fill=yes
ontimer=script11782(event_com)

// 1667:3
[bottom_lid]
type=rectangle
height=1
widthmode=minus
ymode=abs_bottom
layer=eyelids
colour=0x000000
fill=yes
