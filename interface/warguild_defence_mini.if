// 411:0
[title]
type=text
y=4
height=20
widthmode=minus
xmode=abs_centre
textfont=cinzel_15pt_bold
text=Defence style
textalignh=1
textshadow=yes
colour=0xe1e1e1
onload=script10496(event_com, event_comsubid, 0)

// 411:1
[warguild_stab]
type=layer
y=30
width=20
height=45
widthmode=minus
xmode=abs_centre
transmitop1=yes
op1=Select
opcursor0=cursor_use
onload=warguild_defence_select(1)
onop=warguild_defence_select(1)

