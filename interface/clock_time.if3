// 1233:0
[layer_time]
type=layer
widthmode=minus
heightmode=minus
onload=script18280(clock_time:text_time)
onvartransmit=script18281(clock_time:text_time){toplevel_v2_general_varp_2, clock_time_date_minutes}

// 1233:1
[text_time]
type=text
widthmode=minus
heightmode=minus
layer=layer_time
textfont=museo_sans_13pt_regular
fontmono=no
text=99:99
textalignh=centre
textalignv=centre
textshadow=yes
colour=0xffcb05

