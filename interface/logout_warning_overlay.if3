// 734:0
[blackout_layer]
type=layer
widthmode=minus
heightmode=minus
noclickthrough=yes
transmitop=1
op1=Close

// 734:1
[com_1]
type=rectangle
widthmode=minus
heightmode=minus
layer=blackout_layer
colour=0x000000
fill=yes
trans=128

// 734:2
[main_holder]
type=layer
width=350
height=250
xmode=abs_centre
ymode=abs_centre
noclickthrough=yes

// 734:3
[background]
type=layer
widthmode=minus
heightmode=minus
layer=main_holder

// 734:4
[border]
type=layer
widthmode=minus
heightmode=minus
layer=main_holder

// 734:5
[content]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=main_holder
onload=script8420(48103427, 48103428, 48103429, 48103433, "Warning", 21218, 1007)

// 734:6
[cancel_button_layer]
type=layer
x=15
y=10
width=150
height=27
ymode=abs_bottom
layer=content
transmitop=1
op1=Cancel
onload=script13968(event_com, -1, 28554, "Cancel")

// 734:7
[proceed_button_layer]
type=layer
x=10
y=10
width=150
height=27
xmode=abs_right
ymode=abs_bottom
layer=content
transmitop=1
op1=Continue
onload=script13968(event_com, -1, 28553, "Continue")

// 734:8
[warning_text]
type=text
y=8
width=10
height=50
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=content
textfont=notosans_13
fontmono=no
text=To complete this purchase you will be temporarily logged out of the game and taken to our website.
textshadow=yes

// 734:9
[close_button]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_right
layer=main_holder
transmitop=1
op1=Close

