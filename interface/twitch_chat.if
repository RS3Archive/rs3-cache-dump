// 228:0
[rebuild_timer]
type=layer
widthmode=minus
heightmode=minus
layer=chat

// 228:1
[divider_graphic_2]
type=graphic
y=16
height=12
widthmode=minus
xmode=abs_centre
layer=chat
graphic="aif_chat_window_frame_1,6"
alpha=yes
colour=0xffffff
clickmask=no

// 228:2
[divider_graphic]
type=graphic
y=12
height=12
widthmode=minus
xmode=abs_centre
ymode=abs_bottom
layer=chat
graphic="aif_chat_window_frame_1,6"
alpha=yes
colour=0xffffff
clickmask=no

// 228:3
[player_name]
type=text
height=17
widthmode=minus
ymode=abs_bottom
layer=chat
textfont=p12_full
textalignv=2
colour=0x000000
transmitop1=yes
transmitop2=yes
transmitop3=yes
transmitop4=yes
transmitop5=yes
transmitop6=yes
transmitop7=yes
transmitop8=yes
op1=Public Chat
op2=Public Quick Chat
op3=Friends Chat
op4=Friends Chat Quick Chat
op5=Clan Chat
op6=Clan Quick Chat
op7=Guest Clan Chat
op8=Guest Clan Quick Chat
onmouseleave=script8805
onmouserepeat=script8799("Allows you to change where you are<br>chatting through right-click options.", event_com, event_comsubid)

// 228:4
[highlight_rect]
type=rectangle
height=17
widthmode=minus
ymode=abs_bottom
layer=chat
hide=yes
colour=0xffffff

// 228:5
[inputarea]
type=layer
x=50
width=28
height=17
widthmode=minus
ymode=abs_bottom
layer=chat
noclickthrough=yes

// 228:6
[scrollarea]
type=layer
y=18
width=16
height=44
widthmode=minus
heightmode=minus
ymode=abs_bottom
layer=chat
scrollheight=999

// 228:7
[scrollbar]
type=layer
y=18
width=16
height=44
heightmode=minus
xmode=abs_right
ymode=abs_bottom
layer=chat
noclickthrough=yes
onload=rs3_scrollbar_vertical(event_com, twitch_chat:scrollarea)

// 228:8
[tooltip]
type=layer
widthmode=minus
heightmode=minus
layer=chat

// 228:9
[chat]
type=layer
widthmode=minus
heightmode=minus
onload=chatdefault_init(24)

// 228:10
[input]
type=text
height=17
widthmode=minus
layer=inputarea
textfont=p12_full
textalignv=2
colour=0x000000
transmitop1=yes
op1=Enter message
onop=script8513(24)

// 228:11
[caret]
type=line
height=10
ymode=abs_centre
layer=inputarea
hide=yes
colour=0x000000

