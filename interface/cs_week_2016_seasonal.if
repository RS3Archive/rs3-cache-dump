// 1795:27
[the_drop_text]
type=text
x=7
y=199
width=583
height=53
layer=general_layer
textfont=museo_sans_11pt_regular
text=With the appearance of Count Check he's also brought back the drop! Compete against other players for a title and xp lamp rewards.<br> Also if you complete the drop with every question correct you'll be entered into a real life raffle!<br> The next drop will be activated in 00mins
textshadow=yes

// 1795:28
[cs_clues_title]
type=text
x=7
y=260
width=490
height=23
layer=general_layer
textfont=cinzel_18pt_bold
text=Introducing Community Support Clue Scrolls!
textalignv=1
textshadow=yes
colour=0xffcb05

// 1795:29
[cs_clues_text]
type=text
x=7
y=287
width=583
height=82
layer=general_layer
textfont=museo_sans_11pt_regular
text=Count Check also has another trick up his sleeve!, Clue scrolls! Every day during CS week you'll be able to ask him for a Special Community Support Clue Scroll which will reward two caskets per clue! However one of these caskets can only be opened if you have an authenticator AND a bank pin!<br>Also If you miss a day, it doesn't matter you can catch up on missed days anytime you like during CS week!
textshadow=yes

// 1795:30
[drop_reward_title]
type=text
x=10
y=2
