// 1795:31
[drop_reward_text]
type=text
x=10
y=27
width=16
height=146
widthmode=minus
layer=drop_reward_layer
textfont=museo_sans_11pt_regular
text=This version of the drop is has Community Support Themed questions, so get those security hats on!<br>The rewards you'll be able to get from the drop are:<br><br> - The knowledgeable Title!<br> - A Large Exp Lamp<br> - Entry into an exclusive CS Week only Raffle
textshadow=yes

