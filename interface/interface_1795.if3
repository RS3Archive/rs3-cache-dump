// 1795:34
[com_34]
type=text
x=10
y=27
width=16
height=27
widthmode=minus
heightmode=minus
layer=com_9
textfont=fontmetrics_26
fontmono=no
text=Through out CS week if you have a Bank PIN and Authenticator you'll get lots of bonus rewards!<br> - If you have a Bank PIN or Authenticator enabled you'll recieve one additional Treasure hunter key and if you've got both enabled you'll recieve two! You'll also be entered into a competition to win membersship, concept art & other prizes! <br> - If you boast your secure account to Count Check and he's impressed he'll give you an extra xp lamp<br> - When completing the Customer Service scrolls if you have a Secure account you'll be able to open an extra casket every day!
textshadow=yes

