// 1508:0
[new_record_model]
type=model
x=-1
y=2
width=81
height=42
xmode=abs_centre
ymode=abs_centre
layer=new_record_layer
model=level_up_fireworks_interface_golder
modelorigin_x=-1
modelorigin_y=3
modelangle_x=853
modelangle_y=0
modelangle_z=0
modelzoom=3000
modelanim=interface_fireworks

// 1508:1
[new_record]
type=text
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=new_record_layer
textfont=museo_sans_17pt_bold
text=New Record!
textalignh=1
textalignv=1
textshadow=yes

// 1508:2
[time_text]
type=text
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=time_layer
textfont=museo_sans_17pt_bold
text=00:00:00
textalignh=1
textalignv=1
textshadow=yes

// 1508:3
[container_layer]
type=layer
width=120
height=35
onload=script15916

// 1508:4
[content_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=container_layer

// 1508:5
[background_layer]
type=layer
width=120
height=35
layer=content_layer
onload=rs3_background_panel(event_com, rs3_content_container_inactive)

// 1508:6
[time_layer]
type=layer
width=30
widthmode=minus
heightmode=minus
xmode=abs_right
layer=content_layer

// 1508:7
[positive_button_layer]
type=layer
width=30
widthmode=minus
heightmode=minus
xmode=abs_right
layer=content_layer

// 1508:8
[icon_button_layer]
type=layer
x=5
width=26
height=26
ymode=abs_centre
layer=content_layer

// 1508:9
[new_record_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_right
layer=container_layer
hide=yes

// 1508:10
[boss_icon]
type=graphic
width=24
height=24
xmode=abs_centre
ymode=abs_centre
layer=icon_button_layer
graphic="rs3_icon_timer_boss,0"
colour=0xffffff
clickmask=no

// 1508:11
[positive_button_on_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=positive_button_layer
