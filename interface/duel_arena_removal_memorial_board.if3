// 939:0
[mainmodal_window]
type=layer
width=512
height=334
ymode=abs_centre
onload=script8420(duel_arena_removal_memorial_board:mainmodal_window_background, duel_arena_removal_memorial_board:mainmodal_window_border, duel_arena_removal_memorial_board:mainmodal_window_content, duel_arena_removal_memorial_board:mainmodal_window_close_button, "Memento Mori", toplevel_v2_default_main_modal_skin_data, 1007)

// 939:1
[mainmodal_window_background]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=mainmodal_window

// 939:2
[mainmodal_window_content]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=mainmodal_window

// 939:3
[mainmodal_window_content_text]
type=text
width=16
height=16
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=mainmodal_window_content
noclickthrough=yes
textfont=museo_sans_15pt_bold
fontmono=no
text=Here lie the ruins of the Duel Arena.<br><br>Once a combat ground where many fought for fame and riches, it was destroyed in the course of the Elder God Wars.<br><br>The ruins stand in honour of Het and in memory of the many combatants who fought here.
textalignh=centre
textalignv=centre
textshadow=yes

// 939:4
[mainmodal_window_border]
type=layer
widthmode=minus
heightmode=minus
layer=mainmodal_window

// 939:5
[mainmodal_window_close_button]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_right
layer=mainmodal_window
transmitop=1
op1=Close
onop=closebutton_click

