// 1423:0
[dont_show_again_text]
type=text
x=20
y=-2
width=16
height=15
widthmode=minus
xmode=abs_right
ymode=abs_centre
layer=dont_show_again_layer
textfont=museo_sans_11pt_regular
text=Don't show this message again
textalignh=2
textalignv=1
textshadow=yes
colour=0x7592a0
onload=script10496(event_com, event_comsubid, 3)

// 1423:1
