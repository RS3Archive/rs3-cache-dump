layer=mainmodal_window

// 1423:4
[mainmodal_window_content]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=mainmodal_window

// 1423:5
[button_op]
type=layer
y=5
width=170
height=27
xmode=abs_centre
ymode=abs_bottom
layer=mainmodal_window_content
