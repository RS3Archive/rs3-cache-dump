y=60
width=300
height=225
xmode=abs_centre
onload=script8420(fps_warning:mainmodal_window_background, fps_warning:mainmodal_window_border, fps_warning:mainmodal_window_content, fps_warning:mainmodal_window_close_button, "High Frame Rate", 21218, string_1007)

// 1423:3
