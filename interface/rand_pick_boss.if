// 217:0
[bounding_box]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
onload=script8420(rand_pick_boss:background_layer, rand_pick_boss:frame_layer, rand_pick_boss:content_layer, rand_pick_boss:close_button_layer, "Choose Next Boss", 21218, null)

