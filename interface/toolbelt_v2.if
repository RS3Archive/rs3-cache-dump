textfont=museo_sans_11pt_regular_multiline
text=Key Ring
textalignh=1
textalignv=1
textshadow=yes
colour=0xaed0e0
onload=script5836(event_com, rs3tli_obj_icon)

// 1944:99
[modal_dialog_window_border]
type=layer
widthmode=minus
heightmode=minus
layer=modal_dialog_window

// 1944:100
[modal_dialog_window_close_button]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_right
layer=modal_dialog_window
transmitop1=yes
op1=Close
onop=toolbelt_hide_settings

// 1944:101
[mainmodal_window_border]
type=layer
widthmode=minus
heightmode=minus
layer=mainmodal_window

// 1944:102
[mainmodal_window_close_button]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_right
layer=mainmodal_window
transmitop1=yes
opkey1=0,13,0
op1=Close
onop=closebutton_click

