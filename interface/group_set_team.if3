// 1526:0
[base]
type=layer
widthmode=minus
heightmode=minus
onload=script8420(100007939, 100007945, 100007940, 100007946, "Set Team", 21218, 1023)

// 1526:1
[loading_back]
type=rectangle
widthmode=minus
heightmode=minus
layer=loading_layer
colour=0x000000
fill=yes
trans=150

// 1526:2
[loading_text]
type=text
widthmode=minus
heightmode=minus
layer=loading_layer
textfont=museo_sans_11pt_regular
fontmono=no
text=Loading group data...
textalignh=centre
textalignv=centre
textshadow=yes

// 1526:3
[mainmodal_window_background]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=base

// 1526:4
[mainmodal_window_content]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=base
onload=script10380(100007941, 100007942, 100007944, 100007938)

// 1526:5
[dropdown_base_build]
type=layer
y=45
height=45
widthmode=minus
heightmode=minus
layer=mainmodal_window_content

// 1526:6
[dropdown_base_text]
type=layer
y=45
height=45
widthmode=minus
heightmode=minus
layer=mainmodal_window_content
transmitop=1
op1=Select
opcursor0=cursor_use

// 1526:7
[invite_text]
type=text
height=45
widthmode=minus
layer=mainmodal_window_content
textfont=museo_sans_13pt_regular
fontmono=no
textlineheight=15
textalignh=centre
textalignv=centre
textshadow=yes
maxlines=3

// 1526:8
[loading_layer]
type=layer
widthmode=minus
heightmode=minus
layer=mainmodal_window_content
hide=yes

// 1526:9
[mainmodal_window_border]
type=layer
widthmode=minus
heightmode=minus
layer=base

// 1526:10
[mainmodal_window_close_button]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_right
layer=base
transmitop=1
op1=Close

