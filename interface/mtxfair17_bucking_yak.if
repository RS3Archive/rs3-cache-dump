ymode=abs_centre
layer=quit_button_layer
onload=script7276(event_com)

// 1237:9
[quit_button_hit_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=quit_button_layer
onload=script7277(event_com)

// 1237:10
[quit_button_selected_layer]
type=layer
widthmode=minus
heightmode=minus
