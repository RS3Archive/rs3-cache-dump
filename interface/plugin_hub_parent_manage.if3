ymode=abs_centre
layer=dropdown

// 1604:13
[dropdown_click]
type=layer
width=200
heightmode=minus
xmode=abs_right
ymode=abs_centre
layer=dropdown

// 1604:14
[search_bar]
type=layer
height=30
widthmode=minus
layer=filter_layer
noclickthrough=yes

// 1604:15
[search_input]
type=input
height=24
widthmode=minus
ymode=abs_centre
layer=search_bar
noclickthrough=yes
enabled=yes
filtermode=0
visibilitymode=0
unknown8=0
colour=ffffff
text.textfont=notosans_12
text.fontmono=no
text.text=Search...
text.textalignv=centre
text.textshadow=yes
scrollbar.unknown17=yes
scrollbar.unknown18=yes
scrollbar.unknown19=16
scrollbar.unknown20=10
stylesheet=input_searchbox_24px
event24=yes
onload=stylesheet_set(event_com)
oncontentchanged=script21149(event_text, 2)

