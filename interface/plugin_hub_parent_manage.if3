[filter_contents]
type=layer
y=34
height=34
widthmode=minus
heightmode=minus
layer=filter_layer
noclickthrough=yes

// 1604:17
[filters]
type=panel
width=16
widthmode=minus
heightmode=minus
layer=filter_contents
noclickthrough=yes
isvertical=yes
childspacing=4

// 1604:18
[filter_scrollbar]
type=layer
width=16
heightmode=minus
xmode=abs_right
layer=filter_contents
noclickthrough=yes

// 1604:19
[settings_layer]
type=layer
widthmode=minus
heightmode=minus

// 1604:20
[search_listener]
