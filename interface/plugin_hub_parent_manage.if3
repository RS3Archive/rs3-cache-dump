// 1604:0
[listeners_and_timers]
type=layer
width=1
height=1
noclickthrough=yes

// 1604:1
[rebuild_listener]
type=layer
width=1
height=1
layer=listeners_and_timers
noclickthrough=yes

// 1604:2
[main]
type=layer
widthmode=minus
heightmode=minus
noclickthrough=yes
onload=script21141(2, plugin_hub_parent_manage:search_input)

// 1604:3
[content]
type=layer
widthmode=minus
heightmode=minus
layer=main
noclickthrough=yes

// 1604:4
[loading_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=main
hide=yes
noclickthrough=yes
onload=spinner_create(event_com, 1, -1)

// 1604:5
[sort]
type=layer
height=30
widthmode=minus
xmode=abs_right
layer=content
noclickthrough=yes

// 1604:6
[filter_layer]
type=layer
width=176
heightmode=minus
layer=content
noclickthrough=yes

// 1604:7
[list_layer]
type=layer
width=180
widthmode=minus
heightmode=minus
xmode=abs_right
layer=content

// 1604:8
[list_contents]
type=layer
height=34
widthmode=minus
heightmode=minus
ymode=abs_bottom
layer=list_layer
noclickthrough=yes

// 1604:9
[list]
type=layer
width=16
widthmode=minus
heightmode=minus
layer=list_contents
noclickthrough=yes

// 1604:10
[list_scrollbar]
type=layer
width=16
heightmode=minus
xmode=abs_right
layer=list_contents
noclickthrough=yes

// 1604:11
[dropdown]
