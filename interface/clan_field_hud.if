// 1112:0
[universe]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
onload=clan_field_hud_init(event_com)

// 1112:1
[info_area]
type=layer
x=5
y=5
width=100
height=100
xmode=abs_right
layer=universe

// 1112:2
[background_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=info_area
onload=rs3_background_panel(event_com, rs3_content_container_inactive)

// 1112:3
[info]
type=layer
width=8
height=8
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=info_area

// 1112:4
[caller_layer]
type=layer
height=45
widthmode=minus
xmode=abs_centre
ymode=abs_centre
layer=universe
onload=script1807(event_com, clan_field_hud:caller_name, clan_field_hud:caller_text)

// 1112:5
[caller_icon]
type=graphic
width=13
height=13
layer=caller_layer
graphic="coppa_mouth_button,2"
colour=0xffffff
clickmask=no
transmitop1=yes
transmitop2=yes
opbase=<ff9040>Caller</col>
op1=Set
op2=Clear
onop=meslayer_mode12(event_op)

// 1112:6
[caller_name]
type=text
x=15
width=100
height=15
layer=caller_layer
textfont=b12_full
textshadow=yes
colour=0x00ffff
transmitop1=yes
transmitop2=yes
opbase=<ff9040>Caller</col>
op1=Set
op2=Clear
onop=meslayer_mode12(event_op)

// 1112:7
[caller_text]
type=text
height=15
widthmode=minus
heightmode=minus
ymode=abs_bottom
layer=caller_layer
textfont=p12_full
textshadow=yes
colour=0x00ffff

