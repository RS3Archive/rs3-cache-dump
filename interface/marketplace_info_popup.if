// 904:0
[blackout_layer]
type=layer
widthmode=minus
heightmode=minus
noclickthrough=yes
transmitop1=yes
op1=Close

// 904:1
[com_1]
type=rectangle
widthmode=minus
heightmode=minus
layer=blackout_layer
colour=0x000000
fill=yes
trans=128

// 904:2
[main_holder]
type=layer
width=550
height=150
xmode=abs_centre
ymode=abs_centre
noclickthrough=yes

// 904:3
[background]
type=layer
widthmode=minus
heightmode=minus
layer=main_holder

// 904:4
[content]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=main_holder

// 904:5
[proceed_button_layer]
type=layer
y=10
width=150
height=27
xmode=abs_centre
ymode=abs_bottom
layer=content
transmitop1=yes
op1=Continue
onload=script13968(event_com, null, rs3tli_mobile_3x1_positive_button, "Continue")

// 904:6
[info_text]
type=text
y=8
width=10
height=50
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=content
textfont=museo_sans_13pt_regular
text=Info
textshadow=yes

// 904:7
[close_button]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_right
layer=main_holder
transmitop1=yes
op1=Close

