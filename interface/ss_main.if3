// 1309:0
[modal_dialog_window]
type=layer
width=300
height=200
xmode=abs_centre
ymode=abs_centre
onload=script8420(85786625, 85786636, 85786626, 85786637, "Co-op Slayer", 21217, 1007)

// 1309:1
[modal_dialog_window_background]
type=layer
y=40
width=16
height=48
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=modal_dialog_window

// 1309:2
[modal_dialog_window_content]
type=layer
y=40
width=16
height=48
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=modal_dialog_window

// 1309:3
[invite_button]
type=layer
y=-47
width=40
height=28
widthmode=minus
xmode=abs_centre
ymode=abs_centre
layer=modal_dialog_window_content
onload=script6233(85786628, 85786629, 28556, "Invite Player")
onmouserepeat=script6436(event_com)

// 1309:4
[invite_build]
type=layer
widthmode=minus
heightmode=minus
layer=invite_button

// 1309:5
[invite_click]
type=layer
widthmode=minus
heightmode=minus
layer=invite_button
transmitop=1
op1=Select
opcursor0=cursor_use

// 1309:6
[view_button]
type=layer
width=40
height=28
widthmode=minus
xmode=abs_centre
ymode=abs_centre
layer=modal_dialog_window_content
onload=script6233(85786631, 85786632, 28556, "View Invitation")
onmouserepeat=script8799("View your current invitation.", event_com, event_comsubid)

// 1309:7
[view_build]
type=layer
widthmode=minus
heightmode=minus
layer=view_button

// 1309:8
[view_click]
type=layer
widthmode=minus
heightmode=minus
layer=view_button
transmitop=1
op1=Select
opcursor0=cursor_use

// 1309:9
[leave_button]
type=layer
