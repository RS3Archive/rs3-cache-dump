// 223:0
[emote_default]
type=layer
widthmode=minus
heightmode=minus
onload=crcs_agility_open

// 223:1
[emote_scroll]
type=layer
width=20
widthmode=minus
heightmode=minus
layer=emote_default
scrollheight=550

// 223:2
[emote_button_1]
type=layer
y=5
width=10
height=45
widthmode=minus
xmode=abs_centre
layer=emote_scroll

// 223:3
[peng_emote_shiver]
type=layer
widthmode=minus
heightmode=minus
layer=emote_button_1
transmitop=1
op1=Select
opcursor0=cursor_use
onload=script6233(event_com, null, rs3tli_3x3_button, "")

// 223:4
[emote_graphic_1]
type=graphic
x=2
width=40
height=40
ymode=abs_centre
layer=emote_button_1
graphic="peng_emotes,0"

// 223:5
[emote_button_text_1]
type=text
width=50
widthmode=minus
heightmode=minus
xmode=abs_right
layer=emote_button_1
textfont=museo_sans_11pt_regular
fontmono=no
text=Shiver
textalignv=centre
textshadow=yes
onload=script4242(event_com, event_comsubid, museo_sans_11pt_regular, museo_sans_13pt_regular, 3)

