x=10
y=15
width=200
height=30
xmode=abs_right
ymode=abs_bottom
layer=mainmodal_window_content
noclickthrough=yes
sprite.graphic=button_action_neutral
text.text=Don't ignore them
stylesheet=button_action_neutral
transmitop1=yes
op1=Don't Ignore Player
onbuttonpressed=script3207(0)

// 913:7
[mainmodal_window_border]
type=layer
widthmode=minus
heightmode=minus
layer=mainmodal_window

