// 690:2
[paragraph2]
type=text
x=208
y=27
width=278
height=170
layer=content_layer_1
textfont=museo_sans_11pt_regular
text=Farmers wander the area looking for seeds that have been dug up by mistake. They will also collect any flags you have placed, resetting the nearby area and giving you points if the flag is in the right place.
colour=0xaed0e0
transmitop10=yes
op10=  
onload=script10496(event_com, event_comsubid, 2)

// 690:3
[paragraph3]
type=text
x=22
y=214
width=286
height=169
layer=content_layer_1
textfont=museo_sans_11pt_regular
text=If you place a flag over a seed, you will be able to get the flag back from Mrs. Winkin or Farmer Blinkin. If you placed a flag wrongly, you will have to pay 500gp for a new one.
colour=0xaed0e0
transmitop10=yes
op10=  
onload=script10496(event_com, event_comsubid, 2)

