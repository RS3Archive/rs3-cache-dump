// 1578:0
[listeners_and_timers]
type=layer
width=1
height=1
noclickthrough=yes

// 1578:1
[close_listener]
type=layer
width=1
height=1
layer=listeners_and_timers
transmitop=1
op1=Close

// 1578:2
[status_listener]
type=layer
width=1
height=1
layer=listeners_and_timers
noclickthrough=yes

// 1578:3
[base]
type=layer
widthmode=minus
heightmode=minus
noclickthrough=yes

// 1578:4
[com_4]
type=rectangle
widthmode=minus
heightmode=minus
layer=base
colour=0x000000
fill=yes
trans=128

// 1578:5
[settings]
type=layer
width=592
height=354
xmode=abs_centre
ymode=abs_centre

// 1578:6
[background]
type=layer
y=40
width=16
height=48
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=settings

// 1578:7
[content]
type=layer
y=40
width=16
height=48
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=settings

// 1578:8
[body]
type=layer
y=4
width=8
height=60
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=content
noclickthrough=yes

// 1578:9
[input_wrapper]
type=layer
x=14
y=4
width=278
height=24
xmode=abs_centre
layer=body
noclickthrough=yes

// 1578:10
[show_hide_wrapper]
type=layer
width=24
height=24
xmode=abs_right
layer=input_wrapper
noclickthrough=yes

// 1578:11
[input]
type=input
width=250
height=24
ymode=abs_centre
layer=input_wrapper
noclickthrough=yes
enabled=yes
filtermode=0
visibilitymode=1
unknown8=255
colour=ffffffff
text.textfont=notosans_12
text.fontmono=no
text.textshadow=yes
scrollbar.unknown17=yes
scrollbar.unknown18=yes
scrollbar.unknown19=16
scrollbar.unknown20=10

// 1578:12
[show_hide]
type=button
widthmode=minus
heightmode=minus
layer=show_hide_wrapper
noclickthrough=yes
sprite.graphic=button_cornered_neutral
text.textfont=notosans_12
text.fontmono=no
text.textalignh=centre
text.textalignv=centre
text.textshadow=yes
stylesheet=button_cornered_neutral
onbuttonpressed=script21181

// 1578:13
[show_hide_graphic]
type=graphic
width=16
height=16
xmode=abs_centre
ymode=abs_centre
layer=show_hide_wrapper
