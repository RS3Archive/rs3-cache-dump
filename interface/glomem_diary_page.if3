// 304:0
[mainmodal_window]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
onload=script8420(glomem_diary_page:mainmodal_window_background, glomem_diary_page:mainmodal_window_border, glomem_diary_page:mainmodal_window_content, glomem_diary_page:mainmodal_window_close_button, "Diary page", toplevel_v2_default_main_modal_skin_data, 1007)

// 304:1
[mainmodal_window_background]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=mainmodal_window

// 304:2
[mainmodal_window_content]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=mainmodal_window

// 304:3
[com_3]
type=graphic
width=496
height=293
xmode=abs_centre
ymode=abs_centre
layer=mainmodal_window_content
graphic=rs3_parchment_scroll_background

// 304:4
[pagetext]
type=text
width=70
height=228
widthmode=minus
xmode=abs_centre
ymode=abs_centre
layer=mainmodal_window_content
textfont=museo_sans_13pt_bold
fontmono=no
text=Save yourself !
colour=0x000000

// 304:5
[mainmodal_window_border]
type=layer
widthmode=minus
heightmode=minus
layer=mainmodal_window

// 304:6
[mainmodal_window_close_button]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_right
layer=mainmodal_window
transmitop=1
op1=Close
onop=closebutton_click

