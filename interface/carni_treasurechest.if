// 1304:23
[com_23]
type=text
width=10
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=info_container
textfont=verdana_11pt_regular
text=Your treasure chest allows you to bury loot for your friends to dig up.<br><br>Click an item in your inventory to put it in the chest.<br><br>Decide how exclusive you want to make your treasure hunt: <col=ff0000>PIN</col> or <col=ff0000>Key</col>. If you choose <col=ff0000>Key</col>, your chest can only be found by players to whom you give a key. If you choose <col=ff0000>PIN</col>, anyone who guesses the PIN can find it. You could announce the PIN in the form of a riddle.<br><br>When you <col=ff0000>bury</col> the chest, you receive a <col=ff0000>keyring</col>. Use the keyring on people to offer them a <col=ff0000>key</col>.
textlineheight=12
textalignv=1
textshadow=yes
colour=0xebe0bc

