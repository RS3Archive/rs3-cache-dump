// 428:0
[hourglass_layer]
type=layer
x=5
y=5
width=100
height=128
onload=ntk_text(ntk_overlay:roomnumber, ntk_overlay:levelreq)
onvartransmit=ntk_text(ntk_overlay:roomnumber, ntk_overlay:levelreq)
onvartransmitlist=ntk_var_temp

// 428:1
[bottom]
type=model
width=88
height=37
xmode=abs_centre
ymode=abs_bottom
layer=hourglass_layer
model=if_game_ntk_hourglass_bottom
modelorigin_x=-7
modelorigin_y=4
modelangle_x=124
modelangle_y=0
modelangle_z=0
modelzoom=656

// 428:2
[sand]
type=model
x=16
y=15
width=53
height=97
layer=hourglass_layer
model=if_game_ntk_sand_01
modelorigin_x=0
modelorigin_y=51
modelangle_x=133
modelangle_y=0
modelangle_z=0
modelzoom=656

// 428:3
[top]
type=model
width=95
height=118
xmode=abs_centre
layer=hourglass_layer
model=if_game_ntk_hourglass_top
modelorigin_x=-7
modelorigin_y=52
modelangle_x=133
modelangle_y=0
modelangle_z=0
modelzoom=656

// 428:4
[roomnumber]
type=text
x=-6
y=-7
height=8192
widthmode=minus
heightmode=proportion
xmode=abs_centre
layer=hourglass_layer
textfont=menu_font_small
textlineheight=16
textalignh=1
textalignv=1
textshadow=yes

// 428:5
[levelreq]
type=text
x=-6
height=8192
widthmode=minus
heightmode=proportion
xmode=abs_centre
ymode=abs_bottom
layer=hourglass_layer
textfont=menu_font_small
textlineheight=16
textalignh=1
textalignv=1
textshadow=yes

// 428:6
[timerbar_layer]
type=layer
x=96
y=15
width=12
height=110
onload=ntk_timer(ntk_overlay:timerbar, ntk_overlay:border, ntk_overlay:sand)
onvartransmit=ntk_timer(ntk_overlay:timerbar, ntk_overlay:border, ntk_overlay:sand)
onvartransmitlist=ntk_var2

// 428:7
[com_7]
type=rectangle
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=timerbar_layer
colour=0x000000
fill=yes

// 428:8
[border]
type=rectangle
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=timerbar_layer
colour=0xa4a429

// 428:9
[timerbar_container]
type=layer
width=4
height=4
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=timerbar_layer

// 428:10
[timerbar]
type=rectangle
height=16391
widthmode=minus
heightmode=proportion
xmode=abs_centre
ymode=abs_bottom
layer=timerbar_container
colour=0xa4a429
fill=yes

