// 687:0
[content_layer]
type=layer
x=7
y=7
width=512
height=334
xmode=proportion_centre
ymode=proportion_centre
layer=bespoke_window_content

// 687:1
[bespoke_window]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
onload=script8420(rabbit_instructions_sign01:bespoke_window_background, rabbit_instructions_sign01:bespoke_window_border, rabbit_instructions_sign01:bespoke_window_content, rabbit_instructions_sign01:bespoke_window_close, "", 21259, string_1007)

// 687:2
[paragraph01]
type=text
x=206
y=18
width=272
height=169
layer=content_layer
textfont=museo_sans_11pt_regular
text=Use a spade to dig in the farmer's field and try to work out where the seeds have been planted. Try not to dig up the seeds, as this will lose you points! Usually, when you dig a square, you will uncover a number, which shows how many seeds are in the holes next to it.
colour=0xaed0e0
onload=script10496(event_com, event_comsubid, 2)

// 687:3
[paragraph02]
type=text
x=18
y=205
width=286
height=169
layer=content_layer
textfont=museo_sans_11pt_regular
text=Plant your flags in holes where you think that seeds may be found. If you are correct, you will get lots of points, but if you are wrong, you will lose the flag. If you are close to other players, you might get some points if they find seeds, too!"
colour=0xaed0e0
onload=script10496(event_com, event_comsubid, 2)

