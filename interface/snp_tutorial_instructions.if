// 208:0
[background]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre

// 208:1
[border]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
onload=script8420(snp_tutorial_instructions:background, snp_tutorial_instructions:border, null, null, "", 23001, string_1006)

// 208:2
[title]
type=text
height=30
widthmode=minus
xmode=abs_centre
layer=root
textfont=cinzel_12pt_bold
textalignh=1
textalignv=1
textshadow=yes
colour=0x000000
onload=script2732(event_com, -1, 0)

// 208:3
[textbox]
type=text
y=33
width=56
height=37
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=root
textfont=tutorial_font
textalignh=1
textalignv=1
colour=0x000000

// 208:4
[root]
type=layer
width=16
height=16
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre

