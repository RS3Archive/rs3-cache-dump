// 228:3
[com_3]
type=text
height=17
widthmode=minus
ymode=abs_bottom
layer=com_9
textfont=fontmetrics_67
fontmono=no
textalignv=bottom
colour=0x000000
transmitop=1,2,3,4,5,6,7,8
