// 1310:9
[accept_button]
type=layer
x=20
y=10
width=150
height=27
xmode=abs_right
ymode=abs_bottom
layer=modal_dialog_window_content
onload=script13968(ss_invite:accept_build, ss_invite:accept_click, rs3tli_positive_button, "Accept")

// 1310:10
[accept_build]
type=layer
widthmode=minus
heightmode=minus
layer=accept_button

// 1310:11
[accept_click]
type=layer
widthmode=minus
heightmode=minus
layer=accept_button
transmitop=1
op1=Select
opcursor0=cursor_use

// 1310:12
[decline_button]
