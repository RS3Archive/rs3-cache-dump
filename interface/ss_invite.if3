// 1310:0
[modal_dialog_window]
type=layer
width=400
height=180
xmode=abs_centre
ymode=abs_centre
onload=script8420(ss_invite:modal_dialog_window_background, ss_invite:modal_dialog_window_border, ss_invite:modal_dialog_window_content, ss_invite:modal_dialog_window_close_button, "Group Slayer Invitation", toplevel_v2_default_modal_dialogue_skin_data, 1007)

// 1310:1
[modal_dialog_window_background]
type=layer
y=40
width=16
height=48
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=modal_dialog_window

// 1310:2
[modal_dialog_window_content]
type=layer
y=40
width=16
height=48
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=modal_dialog_window

// 1310:3
[com_3]
type=text
y=2
height=20
widthmode=minus
xmode=abs_centre
layer=modal_dialog_window_content
textfont=museo_sans_13pt_bold
fontmono=no
text=You have been invited to a Slayer group by:
textalignh=centre
textalignv=centre
textshadow=yes
colour=0xffcb05
onload=script10496(event_com, event_comsubid, 1)

