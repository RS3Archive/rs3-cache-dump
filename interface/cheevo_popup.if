// 1853:0
[root]
type=layer
width=300
height=112
xmode=abs_centre
ymode=abs_centre

// 1853:1
[cheevo_popup]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=root
transmitop1=yes
op1=Close
onload=script8420(cheevo_popup:cheevo_popup_background, cheevo_popup:cheevo_popup_border, cheevo_popup:cheevo_popup_content, null, "", 21259, null)

// 1853:2
[flash_layer]
type=layer
width=300
height=112
layer=root
hide=yes

// 1853:3
[flash_rect]
type=rectangle
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=flash_layer
colour=0xffffff
fill=yes

// 1853:4
[cheevo_popup_background]
type=layer
x=4
y=4
width=8
height=8
widthmode=minus
heightmode=minus
layer=cheevo_popup

// 1853:5
[cheevo_popup_content]
type=layer
x=4
y=4
width=8
height=8
widthmode=minus
heightmode=minus
layer=cheevo_popup
onload=script13320(event_com)

// 1853:6
[cheevo_icon]
type=graphic
x=2
y=4
width=58
height=58
ymode=abs_bottom
layer=cheevo_popup_content
colour=0xffffff
clickmask=no

// 1853:7
[cheevo_heading]
type=text
height=20
widthmode=minus
layer=cheevo_popup_content
textfont=cinzel_13pt_bold
textalignh=1
textalignv=1
textshadow=yes
onload=script10496(event_com, event_comsubid, 0)

// 1853:8
[cheevo_title]
type=text
y=19
height=20
widthmode=minus
layer=cheevo_popup_content
textfont=museo_sans_13pt_bold
textalignh=1
textalignv=2
textshadow=yes
onload=script10496(event_com, event_comsubid, 2)

// 1853:9
[cheevo_details]
type=text
x=4
y=4
width=67
height=58
widthmode=minus
xmode=abs_right
ymode=abs_bottom
layer=cheevo_popup_content
textfont=museo_sans_11pt_regular
textalignh=1
textalignv=1
textshadow=yes
onload=script10496(event_com, event_comsubid, 3)

// 1853:10
[cheevo_popup_border]
type=layer
widthmode=minus
heightmode=minus
layer=cheevo_popup

