// 946:0
[close_button]
type=graphic
x=2
y=2
width=16
height=16
xmode=abs_right
graphic="rs3_btn_custom_modal,0"
colour=0xffffff
clickmask=no
transmitop1=yes
op1=Close
onmouseover=graphic_swapper(event_com, "rs3_btn_custom_modal,1")
onmouseleave=graphic_swapper(event_com, "rs3_btn_custom_modal,0")

// 946:1
[inventory_layer]
type=layer
y=52
height=52
widthmode=minus
heightmode=minus
scrollheight=252
onload=script1561(lore_bob, rand_inspect_bob:list_layer, rand_inspect_bob:slot_layer, rand_inspect_bob:item_layer, rand_inspect_bob:scrollbar)
oninvtransmit=script1433(lore_bob, rand_inspect_bob:list_layer, rand_inspect_bob:slot_layer, rand_inspect_bob:item_layer, rand_inspect_bob:scrollbar)
oninvtransmitlist=lore_bob

// 946:2
[list_layer]
type=layer
widthmode=minus
heightmode=minus
layer=inventory_layer

// 946:3
[slot_layer]
type=layer
widthmode=minus
heightmode=minus
layer=list_layer

// 946:4
[item_layer]
type=layer
widthmode=minus
heightmode=minus
layer=list_layer

// 946:5
[scrollbar]
type=layer
width=16
heightmode=minus
xmode=abs_right
layer=inventory_layer

// 946:6
[stat_name]
type=text
y=2
width=163
height=18
xmode=abs_centre
textfont=museo_sans_13pt_bold
text=Player ~ Name
textalignh=1
textshadow=yes
colour=0xffcb05

// 946:7
