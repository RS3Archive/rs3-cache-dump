// 1142:0
[universe]
type=layer
width=641
height=424
xmode=abs_centre
ymode=abs_centre
onload=script8420(challenge_returner_popup:background, challenge_returner_popup:border, challenge_returner_popup:content, null, "", ab_upsell_skin, -1)

// 1142:1
[background]
type=layer
x=4
y=4
width=4
height=4
widthmode=minus
heightmode=minus
layer=universe

// 1142:2
[content]
type=layer
x=4
y=4
width=4
height=4
widthmode=minus
heightmode=minus
layer=universe

// 1142:3
[background_image]
type=graphic
width=633
height=416
layer=content
tiling=yes

// 1142:4
[body_text]
type=text
x=25
y=110
width=360
height=170
widthmode=minus
heightmode=minus
layer=content
textfont=notosans_15
fontmono=no
onload=script199(event_com)

// 1142:5
[header_text]
type=layer
x=-16
y=-3
height=78
widthmode=minus
layer=content

// 1142:6
[header_intro]
type=text
y=-4
widthmode=minus
heightmode=minus
layer=header_text
textfont=cinzel_15pt_bold
fontmono=no
text=WELCOME BACK!
textalignh=centre
textalignv=centre
textshadow=yes
colour=0xfff8c1

// 1142:7
[header_main]
type=text
y=17
width=125
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=header_text
textfont=cinzel_25pt_bold_multiline
fontmono=no
text=RETURNER REWARDS AWAIT!
textalignh=centre
textalignv=centre
textshadow=yes
colour=0xfff8c1
onload=script198(event_com)

// 1142:8
[challenges_button]
type=button
y=20
width=195
height=32
xmode=abs_centre
ymode=abs_bottom
layer=content
noclickthrough=yes
sprite.graphic=button_action_positive
text.fontmono=no
text.text=Go To Challenges
text.textalignh=centre
text.textalignv=centre
text.textshadow=yes
stylesheet=button_action_positive
transmitop=1
op1=Select
opcursor0=cursor_use

// 1142:9
[close_button]
type=graphic
x=10
y=10
width=66
height=36
xmode=abs_right
layer=universe
noclickthrough=yes
graphic=btn_close_deafult
transmitop=1
op1=Select
opcursor0=cursor_use
onmouseover=cc_if_colour_swapper(event_com, -1, 0)
onmouseleave=cc_if_colour_swapper(event_com, -1, 15066597)

// 1142:10
[border]
type=layer
widthmode=minus
heightmode=minus
layer=universe

