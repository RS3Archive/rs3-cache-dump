y=32
width=16
height=48
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=window

// 507:39
[centre]
type=layer
width=506
height=98
xmode=abs_centre
ymode=abs_centre
layer=content

// 507:40
[border]
type=layer
widthmode=minus
heightmode=minus
layer=window

// 507:41
[close]
