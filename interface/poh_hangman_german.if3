textfont=p12_full
fontmono=no
text=Enter up to five letters in any order then click 'guess' again.
colour=0x6633ff

// 507:37
[background]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=window

// 507:38
[content]
