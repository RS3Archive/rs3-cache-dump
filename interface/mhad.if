widthmode=proportion
xmode=abs_centre
ymode=abs_bottom
layer=charity_middle_layer
textfont=notosans_12
text=Rise Above The Disorder is dedicated to making mental health care free and available to everyone.<br><br>Since 2013, they have helped over 29,000 people gain access to mental health services whilst creating equality in health care.<br><br>They believe that everyone has a right to health, happiness, and the mental health care they deserve.
