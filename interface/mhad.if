// 1069:12
[charitytext]
type=text
y=120
width=14745
height=241
widthmode=proportion
xmode=abs_centre
layer=charity_left_layer
textfont=notosans_12
text=CPSL Mind supports those with poor mental health to live well, whatever that means for them.<br><br>They enable people to maintain positive mental health, especially those who are going through tough times.<br><br>They inspire connections and eliminate stigma within our communities for the benefit of everyone's mental health.
textlineheight=16
textalignh=1
textshadow=yes
colour=0xe6e6e6

