// 1840:0
[ragdoll_layer]
type=layer
widthmode=minus
heightmode=minus

// 1840:1
[ragdoll_background_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=ragdoll_layer
onload=script32(toplevel_v2_ragdoll_store_main:ragdoll_layer, toplevel_v2_ragdoll_store_main:ragdoll_backing_layer, toplevel_v2_ragdoll_store_main:ragdoll_spotlight_layer)

// 1840:2
[ragdoll_drag_layer]
type=layer
width=166
height=291
xmode=abs_centre
ymode=abs_centre
layer=ragdoll_layer
dragdepth=1
onload=script10769(event_com, toplevel_v2_ragdoll_store_main:ragdoll_model)

// 1840:3
[ragdoll_model]
type=model
width=166
height=291
xmode=abs_centre
ymode=abs_centre
layer=ragdoll_layer
model=null
modelzoom=800

// 1840:4
[ragdoll_backing_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=ragdoll_background_layer

// 1840:5
[ragdoll_spotlight_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=ragdoll_background_layer

