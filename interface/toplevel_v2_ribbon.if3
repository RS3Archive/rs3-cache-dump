// 1431:0
[window_build]
type=layer
widthmode=minus
heightmode=minus
layer=window_holder

// 1431:1
[ribbon_root]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre

// 1431:2
[quickchild_listener]
type=layer
width=1
height=1
xmode=abs_right
layer=ribbon_root

// 1431:3
[parent_listener]
type=layer
width=1
height=1
xmode=abs_right
layer=ribbon_root
transmitop=1,2,3,4,5,6,7,8
op1=Open
op2=Open
op3=Open
op4=Open
op5=Open
op6=Open
op7=Open
op8=Open
opcursor0=cursor_open
opcursor1=cursor_open
onop=script5587(event_op)

// 1431:4
[error_msg]
type=text
width=45
height=45
widthmode=minus
heightmode=minus
layer=ribbon_root
textfont=museo_sans_11pt_regular_multiline
fontmono=no
text=Click on the drawers to add buttons to this panel.
textalignh=centre
textalignv=centre
textshadow=yes

// 1431:5
[window_holder]
type=layer
widthmode=minus
heightmode=minus
layer=ribbon_root
onload=script13833(toplevel_v2_ribbon:window_build, toplevel_v2_ribbon:window_click)
onvartransmit=script13833(toplevel_v2_ribbon:window_build, toplevel_v2_ribbon:window_click){toplevel_v2_general_varp, toplevel_v2_skins_varp, toplevel_v2_parent_lock, toplevel_v2_parent_lock_2, seasonal_main, league_active_player}

// 1431:6
[extra_button]
type=graphic
x=243
width=15
height=15
xmode=abs_centre
ymode=abs_centre
layer=ribbon_root
graphic=rs3_hud_menu_settings_btn
transmitop=1
op1=Select
opcursor0=cursor_use
onload=script10389(event_com)
onmouserepeat=script2399(event_com)

// 1431:7
[mode_button]
type=graphic
width=15
height=15
xmode=abs_right
ymode=abs_bottom
layer=ribbon_root
graphic=rs3_menu_btn_edit_normal
transmitop=1
op1=Select
opcursor0=cursor_use
onload=script10389(event_com)
onmouseover=graphic_swapper(event_com, rs3_menu_btn_edit_over)
onmouseleave=graphic_swapper(event_com, rs3_menu_btn_edit_normal)
onop=script2401

// 1431:8
[league_button]
type=graphic
width=48
height=48
ymode=abs_centre
layer=ribbon_root
noclickthrough=yes
transmitop=1
op1=View Leagues
onload=script10389(event_com)

// 1431:9
[window_click]
type=layer
widthmode=minus
heightmode=minus
layer=window_holder

// 1431:10
[intern_note_layer]
type=layer
widthmode=minus
heightmode=minus
layer=window_holder

