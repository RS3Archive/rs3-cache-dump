layer=mainmodal_window

// 498:2
[mainmodal_window_content]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=mainmodal_window

// 498:3
[com_3]
type=graphic
width=496
height=293
