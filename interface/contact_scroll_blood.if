// 498:0
[mainmodal_window]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
onload=script8420(contact_scroll_blood:mainmodal_window_background, contact_scroll_blood:mainmodal_window_border, contact_scroll_blood:mainmodal_window_content, contact_scroll_blood:mainmodal_window_close_button, "Scroll", 21218, string_1007)

// 498:1
[mainmodal_window_background]
type=layer
