// 1919:0
[compass_layer]
type=layer
width=36
height=36
noclickthrough=yes

// 1919:1
[com_1]
type=graphic
width=33
height=33
xmode=abs_centre
ymode=abs_centre
layer=compass_layer
graphic=navigation_backing_compass
colour=0xffffff
clickmask=no
onmouseover=graphic_swapper(event_com, navigation_highlight_compass)
onmouseleave=graphic_swapper(event_com, navigation_backing_compass)
onmouserepeat=script8799("Reset Camera", event_com, -1)

// 1919:2
[compass]
type=graphic
contenttype=1339
width=33
height=33
xmode=abs_centre
ymode=abs_centre
layer=compass_layer
graphic=compassmask_2
colour=0xffffff
transmitop1=yes
transmitop2=yes
transmitop3=yes
op1=Face Camera North
op2=Face Camera South
op3=Freecam
onload=script10040(event_com)
onop=script11075(event_op)

