// 1052:0
[mainmodal_window]
type=layer
width=650
height=300
xmode=abs_centre
ymode=abs_centre
onload=script8420(gamemode_seasonal_login_popup:mainmodal_window_background, gamemode_seasonal_login_popup:mainmodal_window_border, gamemode_seasonal_login_popup:mainmodal_window_content, null, "Fresh Start World Event Transition", 1728, string_1047)

// 1052:1
[mainmodal_window_background]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=mainmodal_window

// 1052:2
[mainmodal_window_content]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=mainmodal_window

// 1052:3
[content_panel_blue]
type=layer
y=8
width=16
height=16
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=mainmodal_window_content
onload=script10896(event_com, null, rs3tli_content_panel_blue)

// 1052:4
[inner_border]
type=layer
width=36
height=36
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=mainmodal_window_content

// 1052:5
[title_text]
type=text
height=30
widthmode=minus
layer=inner_border
noclickthrough=yes
textfont=notosans_bold_18
text=The Fresh Start World Event will end in:
textalignh=1
textalignv=1
colour=0xfff7d6
onload=gamemode_seasonal_transition_title_setup(event_com, gamemode_seasonal_login_popup:time_title, gamemode_seasonal_login_popup:time_remaining)

// 1052:6
[time]
type=layer
y=35
height=40
widthmode=minus
layer=inner_border

// 1052:7
[transition_text]
type=text
y=85
width=20
height=20
widthmode=minus
xmode=abs_centre
layer=inner_border
noclickthrough=yes
textfont=notosans_14
text=You can transition to the Standard Game before the event ends.
textalignh=1
textalignv=1
colour=0xddf2ff

// 1052:8
[blacklist_text]
type=text
y=115
width=20
height=60
widthmode=minus
xmode=abs_centre
layer=inner_border
noclickthrough=yes
textfont=notosans_14
text=The teleport button will send you to Burthorpe, where you can talk to Gale Freshman and request to transition to the Standard Game.
textalignh=1
textalignv=1
colour=0xddf2ff

// 1052:9
[btn_continue]
type=button
x=-120
y=10
width=200
height=40
xmode=abs_centre
ymode=abs_bottom
layer=inner_border
noclickthrough=yes
sprite.graphic=button_action_neutral
text.fontmono=no
text.text=Continue playing
text.textshadow=no
stylesheet=button_action_neutral
transmitop1=yes
op1=Teleport
onload=stylesheet_set(event_com)

// 1052:10
[btn_teleport]
type=button
x=120
y=10
width=200
height=40
xmode=abs_centre
ymode=abs_bottom
layer=inner_border
noclickthrough=yes
sprite.graphic=button_action_positive
text.fontmono=no
text.text=Teleport to the host
text.textshadow=no
stylesheet=button_action_positive
transmitop1=yes
op1=Teleport
onload=stylesheet_set(event_com)

