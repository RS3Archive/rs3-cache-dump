height=20
widthmode=minus
layer=offset
textfont=notosans_bold_13
text=WikiSync
textalignh=1
textshadow=yes
colour=0xffcb05
onload=script10496(event_com, event_comsubid, 0)

// 1406:6
[wiki_text]
