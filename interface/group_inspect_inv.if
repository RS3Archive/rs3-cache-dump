// 65:0
[inventory_layer]
type=layer
y=52
height=52
widthmode=minus
heightmode=minus
scrollheight=252
onload=script6111(inv, group_inspect_inv:list_layer, group_inspect_inv:slot_layer, group_inspect_inv:item_layer, group_inspect_inv:scrollbar)
oninvtransmit=script6111(inv, group_inspect_inv:list_layer, group_inspect_inv:slot_layer, group_inspect_inv:item_layer, group_inspect_inv:scrollbar)
oninvtransmitlist=inv

// 65:1
[list_layer]
type=layer
widthmode=minus
heightmode=minus
layer=inventory_layer

// 65:2
[slot_layer]
type=layer
widthmode=minus
heightmode=minus
layer=list_layer

// 65:3
[item_layer]
type=layer
widthmode=minus
heightmode=minus
layer=list_layer

// 65:4
[scrollbar]
type=layer
width=16
heightmode=minus
xmode=abs_right
layer=inventory_layer

// 65:5
[stat_name]
type=text
y=2
width=163
height=18
xmode=abs_centre
textfont=museo_sans_13pt_bold
text=Player ~ Name
textalignh=1
textshadow=yes
colour=0xffcb05

// 65:6
[tooltip_bounding_layer]
type=layer
width=16391
height=16391
widthmode=proportion
heightmode=proportion

// 65:7
[tooltip]
type=layer
x=102
y=39
width=64
height=18
layer=tooltip_bounding_layer

// 65:8
[tabs_layer]
type=layer
y=24
height=28
widthmode=minus

// 65:9
[inv_button]
type=layer
width=36
height=28
layer=tabs_layer
transmitop1=yes
op1=View-Inventory

// 65:10
[inv_button_bg]
type=graphic
width=32
height=32
layer=inv_button
graphic="rs3_btn_menu_0,1"
colour=0xffffff
clickmask=no

// 65:11
[inv_graphic]
