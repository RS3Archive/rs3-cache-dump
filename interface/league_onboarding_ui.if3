// 1404:0
[blocker]
type=layer
widthmode=minus
heightmode=minus
noclickthrough=yes

// 1404:1
[window_bg]
type=rectangle
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
noclickthrough=yes
colour=0x010101
fill=yes

// 1404:2
[logo_bg]
type=graphic
widthmode=minus
heightmode=minus
noclickthrough=yes
graphic=rs3_ui_game_mode_leagues_default_background
tiling=yes

// 1404:3
[window_size]
type=layer
width=800
height=600
xmode=abs_centre
ymode=abs_centre
noclickthrough=yes

// 1404:4
[logo_wrapper]
type=layer
width=250
height=228
xmode=abs_centre
layer=window_size
noclickthrough=yes

// 1404:5
[panels_bg]
type=layer
width=700
height=420
xmode=abs_centre
ymode=abs_bottom
layer=window_size
onload=script10069(league_onboarding_ui:bg, league_onboarding_ui:border, null, null, "", toplevel_v2_nondragable_dialogue_skin_data, -1, null)

// 1404:6
[contents]
type=layer
width=640
height=400
xmode=abs_centre
ymode=abs_bottom
layer=window_size
noclickthrough=yes

// 1404:7
[subheader]
type=layer
y=5
height=40
widthmode=minus
xmode=abs_centre
layer=contents
noclickthrough=yes

// 1404:8
[contents_l]
type=layer
y=12
width=300
height=60
heightmode=minus
ymode=abs_bottom
layer=contents
noclickthrough=yes

// 1404:9
[contents_r]
type=layer
y=12
width=300
height=60
heightmode=minus
xmode=abs_right
ymode=abs_bottom
layer=contents
noclickthrough=yes

// 1404:10
[bg_contents_l]
type=button
widthmode=minus
heightmode=minus
layer=contents_l
noclickthrough=yes
sprite.graphic=background_default
text.textfont=notosans_12
text.fontmono=no
text.textalignh=centre
text.textalignv=centre
text.textshadow=yes
stylesheet=background_default
onload=stylesheet_set(event_com)

// 1404:11
[header_l]
type=text
y=6
width=8
height=14
widthmode=minus
xmode=abs_centre
layer=contents_l
noclickthrough=yes
textfont=notosans_bold_13
fontmono=no
text=Modern Interface Mode
textalignh=centre
textalignv=centre
textshadow=yes
colour=0xffcb05

// 1404:12
[body_l]
type=text
y=24
width=8
height=40
widthmode=minus
xmode=abs_centre
layer=contents_l
noclickthrough=yes
textfont=notosans_12
fontmono=no
text=A fully customisable UI, with up to 5 customisable actionbars on screen.
textalignh=centre
textalignv=centre
textshadow=yes
colour=0x8facbb

// 1404:13
[graphic_l]
type=graphic
y=64
width=280
height=230
xmode=abs_centre
layer=contents_l
noclickthrough=yes
graphic=leagues_2_ui_setup_modern

// 1404:14
[eoc_button]
type=button
y=8
width=20
height=30
widthmode=minus
xmode=abs_centre
ymode=abs_bottom
layer=contents_l
noclickthrough=yes
sprite.graphic=button_action_positive
text.textfont=notosans_12
text.fontmono=no
text.text=Modern Interface Mode
text.textalignh=centre
text.textalignv=centre
text.textshadow=yes
stylesheet=button_action_positive
transmitop=1
op1=Modern

// 1404:15
[logo]
type=graphic
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=logo_wrapper
noclickthrough=yes
graphic=league_logo_500x456
onload=script21080(event_com)

