// 328:0
[com_0]
type=rectangle
widthmode=minus
heightmode=minus
layer=temple_layer
colour=0x000000
fill=yes
trans=150

// 328:1
[com_1]
type=graphic
y=20
height=1
widthmode=minus
xmode=abs_centre
layer=temple_layer
graphic=icon_divider_runepass

// 328:2
[title]
type=text
width=1
height=16
widthmode=minus
xmode=abs_centre
layer=temple_layer
textfont=museo_sans_15pt_bold
fontmono=no
text=Temple Repair
textalignh=centre
textalignv=centre
textshadow=yes
colour=0xffcb05
onload=script10496(event_com, event_comsubid, 1)

// 328:3
[repair_text]
type=text
y=25
width=118
height=15
layer=temple_layer
textfont=museo_sans_13pt_bold
fontmono=no
text=Repair State :
textalignh=right
textalignv=centre
textshadow=yes
colour=0xaed0e0
onload=script10496(event_com, event_comsubid, 2)

// 328:4
[temple_repaired_state]
type=text
y=25
width=38
height=15
xmode=abs_right
layer=temple_layer
textfont=museo_sans_13pt_bold
fontmono=no
text=****
textshadow=yes
onvartransmit=script1254{temple_repaired_p, temple_resources_p, temple_sanctity_p}

// 328:5
[resource_text]
type=text
y=40
width=118
height=15
layer=temple_layer
textfont=museo_sans_13pt_bold
fontmono=no
text=Resources :
textalignh=right
textalignv=centre
textshadow=yes
colour=0xaed0e0
onload=script10496(event_com, event_comsubid, 2)

