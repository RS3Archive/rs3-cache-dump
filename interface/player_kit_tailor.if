// 729:5
[background_layer]
type=layer
widthmode=minus
heightmode=minus
layer=universe

// 729:6
[universe]
type=layer
width=600
height=400
xmode=abs_centre
ymode=abs_centre
onload=script8420(player_kit_tailor:background_layer, player_kit_tailor:frame_layer, player_kit_tailor:content_layer, player_kit_tailor:close_button_layer, "Clothing Selection", 21218, string_1007)

// 729:7
[content_layer]
