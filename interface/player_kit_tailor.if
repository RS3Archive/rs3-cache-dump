y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=universe
onload=player_kit_body_initialise

// 729:8
[confirm]
type=button
x=40
y=10
width=160
height=32
xmode=abs_right
ymode=abs_bottom
layer=content_layer
noclickthrough=yes
text.textfont=notosans_12
text.text=Confirm
stylesheet=button_action_positive
transmitop1=yes
op1=Confirm

