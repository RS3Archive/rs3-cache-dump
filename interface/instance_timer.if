// 861:0
[container_layer]
type=layer
width=160
height=35
onload=script15913

// 861:1
[collection_log_icon]
type=graphic
width=32
height=32
xmode=abs_centre
ymode=abs_centre
layer=collection_log_button_layer
graphic="rs3_icon_boss_collection_log,0"
colour=0xffffff
clickmask=no
onload=graphic_swapper(event_com, "rs3_icon_boss_collection_log,0")
onmouseover=graphic_swapper(event_com, "rs3_icon_boss_collection_log,1")
onmouseleave=graphic_swapper(event_com, "rs3_icon_boss_collection_log,0")
onclick=graphic_swapper(event_com, "rs3_icon_boss_collection_log,0")
onrelease=graphic_swapper(event_com, "rs3_icon_boss_collection_log,1")

// 861:2
[content_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=container_layer

// 861:3
[background_layer]
type=layer
widthmode=minus
heightmode=minus
layer=content_layer
onload=rs3_background_panel(event_com, rs3_content_container_inactive)

// 861:4
[time_layer]
type=layer
x=40
width=70
widthmode=minus
heightmode=minus
xmode=abs_right
layer=content_layer

// 861:5
[icon_button_layer]
type=layer
x=5
width=26
height=26
ymode=abs_centre
layer=content_layer

// 861:6
[collection_log_button_layer]
type=layer
x=5
width=36
height=36
xmode=abs_right
layer=content_layer
transmitop1=yes
op1=Collection log
onload=script12110("Open the boss collection log for the boss you are currently fighting.", event_com, event_comsubid)

// 861:7
[timer_tooltip_layer]
type=layer
width=120
heightmode=minus
layer=content_layer

// 861:8
[time_text]
type=text
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=time_layer
textfont=museo_sans_17pt_bold
text=00:00:00
textalignh=1
textalignv=1
textshadow=yes

// 861:9
[instance_icon]
type=graphic
width=24
height=24
xmode=abs_centre
ymode=abs_centre
layer=icon_button_layer
graphic="rs3_icon_timer_instance,0"
colour=0xffffff
clickmask=no

