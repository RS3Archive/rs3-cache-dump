// 360:0
[content_layer]
type=layer
width=512
height=334
xmode=proportion_centre
ymode=proportion_centre

// 360:1
[mainmodal_window]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
onload=script8420(trail_map15:mainmodal_window_background, trail_map15:mainmodal_window_border, trail_map15:mainmodal_window_content, trail_map15:mainmodal_window_close_button, "Treasure Map", 21218, string_1007)

// 360:2
[mainmodal_window_background]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=mainmodal_window

// 360:3
[mainmodal_window_content]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=mainmodal_window

// 360:4
[background_scroll]
type=graphic
width=496
height=293
xmode=abs_centre
layer=mainmodal_window_content
graphic=treasure_trails_map_15
colour=0xffffff
clickmask=no

// 360:5
[mainmodal_window_border]
type=layer
widthmode=minus
heightmode=minus
layer=mainmodal_window

// 360:6
[mainmodal_window_close_button]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_right
layer=mainmodal_window
transmitop1=yes
op1=Close
onop=closebutton_click

