// 838:0
[universe]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
onload=sidebook_build(event_com, 54919169, 54919170)
onvarctransmit=sidebook_build(54919168, 54919169, 54919170){sidebook_currentpage}

// 838:1
[titlelayer]
type=layer
height=28
widthmode=minus
xmode=abs_centre
layer=universe

// 838:2
[textlayer]
type=layer
y=28
height=44
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=universe

// 838:3
[title]
type=text
width=20
widthmode=minus
heightmode=minus
ymode=abs_centre
layer=titlelayer
textfont=cinzel_12pt_bold
fontmono=no
textlineheight=13
textalignh=centre
textalignv=centre
textshadow=yes
colour=0xffcb05

// 838:4
[close]
type=graphic
x=3
width=16
height=16
xmode=abs_right
ymode=abs_centre
layer=titlelayer
graphic="rs3_btn_close_24px,0"
transmitop=1
op1=Close

// 838:5
[buttons]
type=layer
height=16
widthmode=minus
xmode=abs_centre
ymode=abs_bottom
layer=universe

// 838:6
[page+]
type=graphic
x=15
width=16
height=16
xmode=abs_centre
ymode=abs_centre
layer=buttons
graphic="catcon_catapult_arrows,2"
transmitop=1
op1=Next page
onmouseover=graphic_swapper(event_com, 1175)
onmouseleave=graphic_swapper(event_com, 1174)
onop=script2066(event_op, 54919168, 54919169, 54919170)

// 838:7
[page-]
type=graphic
x=-15
width=16
height=16
xmode=abs_centre
ymode=abs_centre
layer=buttons
graphic="catcon_catapult_arrows,0"
transmitop=1
op1=Previous page
onmouseover=graphic_swapper(event_com, 1173)
onmouseleave=graphic_swapper(event_com, 1172)
onop=script2067(event_op, 54919168, 54919169, 54919170)

// 838:8
[page++]
type=graphic
x=47
width=20
height=16
xmode=abs_centre
ymode=abs_centre
layer=buttons
graphic="gnome_copter_arrows,2"
transmitop=1
op1=Final page
onmouseover=graphic_swapper(event_com, 801)
onmouseleave=graphic_swapper(event_com, 787)
onop=script2069(event_op, 54919168, 54919169, 54919170)

// 838:9
[page--]
type=graphic
x=-47
width=20
height=16
xmode=abs_centre
ymode=abs_centre
layer=buttons
graphic="gnome_copter_arrows,0"
transmitop=1
op1=First page
onmouseover=graphic_swapper(event_com, 786)
onmouseleave=graphic_swapper(event_com, 785)
onop=script2068(event_op, 54919168, 54919169, 54919170)

