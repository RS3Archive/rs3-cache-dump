// 565:0
[cws_warning_layer]
type=layer
width=270
height=20
ymode=abs_bottom
layer=mainmodal_window_content
pausebutton=yes

// 565:1
[warning]
type=text
width=10
height=95
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=mainmodal_window_content
textfont=museo_sans_11pt_regular_multiline
text=The desert is a VERY dangerous place. Do not<br> enter if you are afraid of dying. Beware of high temperatures, sandstorms, robbers and slavers.<br> No responsibility is taken by Shantay if anything<br> bad should happen to you, in any circumstances whatsoever.
textalignh=1
textalignv=1
textshadow=yes
colour=0xff0000
onload=cws_setup(cws_warning_10:cws_warning_layer, cws_warning_10:cws_toggle_button, 10)
onvartransmit=cws_setup(cws_warning_10:cws_warning_layer, cws_warning_10:cws_toggle_button, 10)
onvartransmitlist=cws_var

// 565:2
[warn1]
type=text
y=70
height=15
widthmode=minus
xmode=abs_centre
ymode=abs_bottom
layer=mainmodal_window_content
textfont=museo_sans_11pt_regular
text=Proceed regardless
textalignh=1
textalignv=1
textshadow=yes
colour=0xff0000
pausebutton=yes
pausetext=Proceed
onmouseover=text_colour_swapper(event_com, 16777215)
onmouseleave=text_colour_swapper(event_com, 16711680)

// 565:3
[warn2]
type=text
y=45
height=15
widthmode=minus
xmode=abs_centre
ymode=abs_bottom
layer=mainmodal_window_content
textfont=museo_sans_11pt_regular
text=Stay out
textalignh=1
textalignv=1
textshadow=yes
colour=0x31ff00
pausebutton=yes
pausetext=Stay out
onmouseover=text_colour_swapper(event_com, 16750623)
onmouseleave=text_colour_swapper(event_com, 65282)

// 565:4
[warn3]
type=text
width=245
heightmode=minus
xmode=abs_right
ymode=abs_centre
layer=cws_warning_layer
textfont=museo_sans_11pt_regular
text=Don't ask me this again
textalignv=1
textshadow=yes

// 565:5
[cws_toggle_button]
type=layer
x=2
width=16
height=16
ymode=abs_centre
layer=cws_warning_layer
onvartransmit=script5886(cws_warning_10:checkbox_selected_layer, cws_warning_10:checkbox_deselected_layer, 10)
onop=script5885(cws_warning_10:checkbox_selected_layer, cws_warning_10:checkbox_deselected_layer)
onvartransmitlist=cws_var,cws_var_2,cws_var_3,cws_var_4

// 565:6
[checkbox_selected_layer]
type=layer
width=16391
height=16384
widthmode=proportion
heightmode=proportion
layer=cws_toggle_button
onload=script7755(event_com)

// 565:7
[checkbox_deselected_layer]
type=layer
width=16391
height=16391
widthmode=proportion
heightmode=proportion
layer=cws_toggle_button
onload=script7756(event_com)

// 565:8
[mainmodal_window]
type=layer
width=350
height=270
xmode=abs_centre
ymode=abs_centre
onload=script8420(cws_warning_10:mainmodal_window_background, cws_warning_10:mainmodal_window_border, cws_warning_10:mainmodal_window_content, cws_warning_10:mainmodal_window_close_button, "Warning", 21218, string_1007)

// 565:9
[mainmodal_window_background]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=mainmodal_window

// 565:10
[mainmodal_window_content]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=mainmodal_window

// 565:11
[mainmodal_window_border]
type=layer
widthmode=minus
heightmode=minus
layer=mainmodal_window

// 565:12
[mainmodal_window_close_button]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_right
layer=mainmodal_window
transmitop1=yes
op1=Close
onop=closebutton_click

