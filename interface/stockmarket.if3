// 105:0
[listeners]
type=layer
width=2
height=2
noclickthrough=yes

// 105:1
[stocktransmit_layer]
type=layer
widthmode=minus
heightmode=minus
layer=listeners

// 105:2
[custom_percent_listener]
type=layer
width=2
height=2
layer=listeners
noclickthrough=yes
onvartransmit=script20873{exchange_settings}

// 105:3
[stockmarket]
type=layer
widthmode=minus
heightmode=minus
candrop=yes
onload=stockmarket_onload
onvartransmit=stockmarket_onvartransmit{stock_offeritem, stock_offerslot, stock_offerprice, stock_offercount, stock_offertype, exchange_version}

// 105:4
[quantity_input_clickout]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
hide=yes
noclickthrough=yes

// 105:5
[price_input_clickout]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
hide=yes
noclickthrough=yes

// 105:6
[stockmarket_bg]
type=layer
widthmode=minus
heightmode=minus
layer=stockmarket
onload=script8420(event_com, stockmarket:stockmarket_frame, stockmarket:stockmarket_content, null, "", toplevel_v2_bespoke_window_skin_data, -1)

// 105:7
[stockmarket_content]
type=layer
width=8
height=8
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=stockmarket

// 105:8
[stockmarket_frame]
type=layer
widthmode=minus
heightmode=minus
layer=stockmarket

// 105:9
[newofferlayer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=stockmarket

// 105:10
[search_layer]
type=layer
height=253
widthmode=minus
heightmode=minus
ymode=abs_bottom
layer=newofferlayer

// 105:11
[summarylayer]
type=layer
widthmode=minus
heightmode=minus
layer=stockmarket_content
hide=yes

// 105:12
[offersummary0]
type=layer
x=4
y=4
width=170
height=122
layer=summarylayer
transmitop=1,2,4,5,6,7,8
