ymode=abs_centre
layer=close_layer
onload=script11645(event_com, rs3tli_24px_close_button, 2)

// 1756:7
[close_button_selected_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=close_layer
hide=yes
onload=script11645(event_com, rs3tli_24px_close_button, 4)

// 1756:8
[close_button_active_layer]
type=layer
widthmode=minus
heightmode=minus
layer=close_layer
