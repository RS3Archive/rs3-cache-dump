// 1756:0
[holiday_graphic]
type=graphic
width=57
height=57
xmode=abs_centre
ymode=abs_bottom
layer=holiday_button
graphic="menaphos_countdown_icon_floater,0"
colour=0xffffff
clickmask=no
onmouseover=graphic_swapper(holiday_event:holiday_graphic, "menaphos_countdown_icon_floater,1")
onmouseleave=graphic_swapper(holiday_event:holiday_graphic, "menaphos_countdown_icon_floater,0")

// 1756:1
[universe]
type=layer
width=116
height=75
noclickthrough=yes
dragdeadzone=5
dragdeadtime=20
onload=script3421(event_com, event_comsubid, 1037)

// 1756:2
[main_button_gfx]
type=graphic
width=112
height=57
xmode=abs_right
ymode=abs_bottom
layer=universe
graphic=rs3_top_level_floater_nml
colour=0xffffff
clickmask=no
onload=script4213(event_com)
onmouseover=graphic_swapper(holiday_event:main_button_gfx, rs3_top_level_floater_ovr)
onmouseleave=graphic_swapper(holiday_event:main_button_gfx, rs3_top_level_floater_nml)
onvartransmit=script12479(event_com)
onvartransmitlist=toplevel_v2_skins_varp

// 1756:3
[holiday_button]
type=layer
y=3
width=76
height=66
ymode=abs_bottom
layer=universe
transmitop1=yes
op1=View
onload=script4213(event_com)

// 1756:4
[close_layer]
type=layer
x=18
y=15
width=24
height=24
xmode=abs_right
ymode=abs_bottom
layer=universe

// 1756:5
[close_button_on_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=close_layer
