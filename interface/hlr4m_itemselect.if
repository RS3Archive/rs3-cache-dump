// 1127:0
[modal_dialog_window]
type=layer
width=315
height=254
xmode=abs_centre
ymode=abs_centre
onload=script8420(hlr4m_itemselect:modal_dialog_window_background, hlr4m_itemselect:modal_dialog_window_border, hlr4m_itemselect:modal_dialog_window_content, hlr4m_itemselect:modal_dialog_window_close_button, "Congratulations", 21217, string_1007)

// 1127:1
[modal_dialog_window_background]
type=layer
y=40
width=16
height=48
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=modal_dialog_window

// 1127:2
[modal_dialog_window_content]
type=layer
y=40
width=16
height=48
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=modal_dialog_window

// 1127:3
[reward_name]
type=text
y=5
width=20
height=25
widthmode=minus
xmode=abs_centre
layer=modal_dialog_window_content
textfont=museo_sans_11pt_regular
text=You have received a piece of hybrid armour!
textalignh=1
textalignv=1
textshadow=yes
colour=0xefbe65
onload=script10496(event_com, -1, 0)

// 1127:4
[reward_text]
type=text
y=30
width=20
height=68
widthmode=minus
xmode=abs_centre
layer=modal_dialog_window_content
textfont=museo_sans_11pt_regular_multiline
text=Select the reward you would prefer:
textalignh=1
textalignv=1
textshadow=yes
colour=0xa88d65
onload=script10496(event_com, -1, 0)

