// 462:0
[base]
type=layer
widthmode=minus
heightmode=minus

// 462:1
[controls]
type=layer
y=10
width=96
height=96
xmode=abs_centre
layer=base

// 462:2
[flip_button]
type=layer
y=110
width=150
height=24
xmode=abs_centre
layer=base
onload=script6233(slug2_ressembling_torn_paper_controll:flip_build, slug2_ressembling_torn_paper_controll:flip_click, rs3tli_3x3_button, "Flip Piece")

// 462:3
[move_up]
type=graphic
width=32
height=32
xmode=abs_centre
layer=controls
graphic="rs3_icon_direction_up_32px,0"
colour=0xffffff
clickmask=no
transmitop1=yes
op1=Select
opcursor0=cursor_use
onload=script13914(event_com, rs3tli_icon_arrow_up)
onmouserepeat=script8799("Move schematic up.", event_com, event_comsubid)

