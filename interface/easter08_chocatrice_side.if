y=10
width=38
height=38
xmode=abs_centre
ymode=abs_bottom
layer=lore_bounding_box
onmouserepeat=script8799("Calls the chocatrice to you if you get separated.", event_com, event_comsubid)

// 716:6
[call_icon]
