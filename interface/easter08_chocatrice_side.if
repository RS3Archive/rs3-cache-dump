// 716:0
[chathead]
type=model
y=10
width=69
height=125
xmode=abs_centre
layer=lore_familairs
model=easter08_chocatrice_chat
modelorigin_x=5
modelorigin_y=14
modelangle_x=2033
modelangle_y=1833
modelangle_z=0
modelzoom=2296
modelanim=lore_cockatrice_chat_idle

// 716:1
[target_clickarea]
type=graphic
width=32
height=32
xmode=abs_centre
ymode=abs_centre
layer=target_layer
graphic="rs3_btn_icon_32px,0"
colour=0xffffff
clickmask=no
targetverb=Target
onload=script13914(event_com, rs3tli_32px_icon_button)
