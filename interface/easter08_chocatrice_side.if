// 716:4
[call_clickarea]
type=graphic
width=32
height=32
xmode=abs_centre
ymode=abs_centre
layer=call_button
graphic="rs3_btn_icon_32px,0"
colour=0xffffff
clickmask=no
transmitop1=yes
op1=Select
opcursor0=cursor_use
onload=script13914(event_com, rs3tli_32px_icon_button)

// 716:5
[call_button]
