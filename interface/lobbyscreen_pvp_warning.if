model=ditch_wilderness_sign_skull_mirror
modelorigin_x=0
modelorigin_y=3
modelangle_x=0
modelangle_y=0
modelangle_z=0
modelzoom=2440

// 821:8
[windowmode_confirm_border]
type=layer
widthmode=minus
heightmode=minus
layer=windowmode_confirm_window

// 821:9
[button_layer]
type=layer
y=5
width=60
height=42
widthmode=minus
xmode=abs_centre
ymode=abs_bottom
