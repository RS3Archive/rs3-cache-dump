// 1665:0
[house_settings_wrapper]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_right

// 1665:1
[house_settings_title]
type=text
y=5
width=20
height=20
widthmode=minus
xmode=abs_centre
layer=house_settings_wrapper
textfont=museo_sans_13pt_regular
fontmono=no
text=House Settings
textalignv=centre
textshadow=yes
colour=0xffcb05
onload=script10496(event_com, -1, 0)

// 1665:2
[com_2]
type=text
x=10
y=24
width=52
height=32
widthmode=minus
layer=house_settings_wrapper
textfont=museo_sans_11pt_regular
fontmono=no
text=Total  number of rooms:
textalignv=centre
textshadow=yes
onload=script10496(event_com, -1, 2)

// 1665:3
[total_rooms]
type=text
x=10
y=24
width=32
height=32
xmode=abs_right
layer=house_settings_wrapper
textfont=museo_sans_11pt_regular
fontmono=no
text=-
textalignh=centre
textalignv=centre
textshadow=yes
onload=script10496(event_com, -1, 2)
onvarctransmit=script9821(event_com){poh_options_number_of_rooms}

// 1665:4
[building_mode_bg]
type=layer
widthmode=minus
heightmode=minus
layer=building_mode_wrapper
onload=rs3_background_panel(event_com, 21361)

// 1665:5
[building_mode_wrapper]
type=layer
y=55
width=20
height=30
widthmode=minus
xmode=abs_centre
layer=house_settings_wrapper
onmouserepeat=script8799("Turn building mode in your player-owned house on or off.", event_com, -1)

// 1665:6
[building_mode_static_checkbox]
type=layer
width=10
height=10
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=building_mode_wrapper
onload=script1020
onvartransmit=script1020{poh_general_temp, poh_general_temp}

// 1665:7
[call_butler_button_layer]
type=layer
y=90
width=20
height=40
widthmode=minus
xmode=abs_centre
layer=house_settings_wrapper
onload=script6233(109117452, 109117453, 28556, "Call Butler")

// 1665:8
[expel_guests_button_layer]
type=layer
y=135
width=20
height=40
widthmode=minus
xmode=abs_centre
layer=house_settings_wrapper
onload=script1022
onvartransmit=script1022{poh_general_temp}

// 1665:9
[leave_house_button_layer]
type=layer
y=180
width=20
height=40
widthmode=minus
xmode=abs_centre
layer=house_settings_wrapper
onload=script6233(109117456, 109117457, 28556, "Leave House")

// 1665:10
[building_mode_checkbox_build]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=building_mode_static_checkbox

// 1665:11
[building_mode_checkbox_click]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=building_mode_static_checkbox
transmitop=1
op1=Select
opcursor0=cursor_use

// 1665:12
[call_butler_button_layer_build]
type=layer
widthmode=minus
heightmode=minus
layer=call_butler_button_layer

// 1665:13
[call_butler_button_layer_click]
type=layer
widthmode=minus
heightmode=minus
layer=call_butler_button_layer
transmitop=1
op1=Select
opcursor0=cursor_use

