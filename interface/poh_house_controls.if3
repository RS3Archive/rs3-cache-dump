// 1665:0
[house_settings_wrapper]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_right
noclickthrough=yes
onload=script20719
onvartransmit=script20720{construction_house_core2}
onvarcstrtransmit=script20720{varclientstring_8434, varclientstring_8435, varclientstring_8436, varclientstring_8437, varclientstring_8438, varclientstring_8439}

// 1665:1
[house_settings_title]
type=text
width=20
height=20
widthmode=minus
xmode=abs_centre
layer=house_settings_wrapper
textfont=museo_sans_13pt_regular
fontmono=no
text=House Controls
textalignh=centre
textalignv=centre
textshadow=yes
colour=0xffcb05
onload=script10496(event_com, -1, 0)

// 1665:2
[neighbourhood_info_tooltip]
type=graphic
width=24
height=24
layer=house_settings_wrapper
graphic="rs3_icon_info_32px,0"
transmitop=1
op1=Select
opcursor0=cursor_use
onload=script13914(event_com, rs3tli_icon_info)
onmouserepeat=script20728

