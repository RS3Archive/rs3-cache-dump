// 1184:0
[background]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre

// 1184:1
[border]
type=layer
widthmode=minus
heightmode=minus
onload=script8420(chat_v2_left:background, chat_v2_left:border, null, null, "", 23001, string_1006)

// 1184:2
[layer_1]
type=layer
width=16
height=16
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre

// 1184:3
[title_layer]
type=layer
width=230
height=30
widthmode=minus
xmode=abs_centre
layer=layer_1

// 1184:4
[title_text]
type=text
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=title_layer
textfont=cinzel_12pt_bold
text=Name
textlineheight=10
textalignh=1
textalignv=1
textshadow=yes
colour=0xffcb05
onload=script2732(event_com, -1, 0)

// 1184:5
[chathead_holder]
type=layer
y=-5
width=624
height=134
ymode=abs_bottom
layer=layer_1
onload=script10007(event_com, chat_v2_left:ring_background, chat_v2_left:ring_foreground, chat_v2_left:chat_mask_left, chatv2_chathead_holder_left)

// 1184:6
[ring_background]
type=graphic
width=67
height=134
ymode=abs_bottom
layer=chathead_holder
graphic=rs3_ui_dialogue_chathead_background
colour=0xffffff
clickmask=no

// 1184:7
[ring_foreground]
type=graphic
x=67
width=67
height=134
ymode=abs_bottom
layer=chathead_holder
graphic=rs3_ui_dialogue_chathead_foreground
colour=0xffffff
clickmask=no

// 1184:8
[chathead_1]
type=model
x=55
y=6
width=32
height=32
ymode=abs_centre
layer=chathead_holder
model=null
modelorigin_x=0
modelorigin_y=0
modelangle_x=40
modelangle_y=1882
modelangle_z=0
modelzoom=2150
onvartransmit=script2619(event_com)
onvartransmitlist=mtx_modular_pet_chat_data

// 1184:9
[chat_mask_left]
type=graphic
x=-6
y=12
width=138
height=109
ymode=abs_centre
layer=chathead_holder
graphic=rs3_ui_dialogue_chathead_foreground_overlay
colour=0xffffff
clickmask=no

// 1184:10
[chat_text]
type=text
x=20
y=20
width=156
height=60
widthmode=minus
heightmode=minus
xmode=abs_right
ymode=abs_bottom
layer=layer_1
textfont=museo_sans_11pt_regular
