// 326:0
[run_layer]
type=layer
width=34
height=34
noclickthrough=yes

// 326:1
[run_background]
type=graphic
width=34
height=34
xmode=abs_centre
ymode=abs_centre
layer=run_layer
graphic=navigation_backing_energy
clickmask=yes
transmitop=6,7
op6=Toggle run mode
op7=Rest
onload=topstat_run_button_init(event_com)
onmouseleave=script8805
onmouserepeat=script8799("Run Energy", event_com, -1)
onvarctransmit=topstat_run_button_update(event_com){option_run_status_varc}

// 326:2
[run_circle]
type=graphic
width=34
height=34
xmode=abs_centre
ymode=abs_centre
layer=run_layer
graphic=navigation_backing_energy
clickmask=yes

// 326:3
[run_background_1]
type=graphic
width=36
height=36
xmode=abs_centre
ymode=abs_centre
layer=run_layer
graphic=navigation_energy_click_area
clickmask=yes
onmouseover=graphic_swapper(event_com, navigation_highlight_energy)
onmouseleave=graphic_swapper(event_com, navigation_energy_click_area)
onclick=graphic_swapper(event_com, null)

// 326:4
[run_hide]
type=graphic
width=28
height=28
xmode=abs_centre
ymode=abs_centre
layer=run_layer
graphic=navigation_level_energy_circle
tiling=yes
clickmask=yes

// 326:5
[run_graphic]
type=graphic
width=22
height=28
xmode=abs_centre
ymode=abs_centre
layer=run_layer
graphic=navigation_icon_energy_off
clickmask=yes
onload=script2304(toplevel_v2_run_energy:run_background, toplevel_v2_run_energy:run_hide, toplevel_v2_run_energy:run_text)
ondragcomplete=script7001(event_com, event_comsubid, event_com2)

// 326:6
[run_text]
type=text
widthmode=minus
heightmode=minus
layer=run_layer
textfont=museo_sans_11pt_regular
fontmono=no
text=100%
textalignh=centre
textalignv=centre
textshadow=yes
onload=script1019(event_com)

