// 1602:0
[root_layer]
type=layer
widthmode=minus
heightmode=minus

// 1602:1
[stats_background]
type=layer
y=10
width=19
height=55
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=root_layer
onload=rs3_background_panel(event_com, rs3_content_container_active)

// 1602:2
[bars]
type=layer
y=45
width=30
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=root_layer

// 1602:3
[com_3]
type=rectangle
height=12
widthmode=minus
xmode=abs_centre
layer=bars
colour=0x071820
fill=yes
onload=script8194(event_com, rs3_rect_dark)

// 1602:4
[positive_button_layer]
type=layer
y=10
width=150
height=27
xmode=abs_centre
ymode=abs_bottom
layer=root_layer

// 1602:5
[com_5]
type=text
y=10
width=40
height=30
widthmode=minus
xmode=abs_centre
layer=root_layer
textfont=cinzel_18pt_bold
text=Easter Stats
textalignh=1
textalignv=1
textshadow=yes
onload=script10496(event_com, event_comsubid, 1)

// 1602:6
[stat_names]
type=text
x=20
y=45
width=190
height=124
heightmode=minus
layer=root_layer
textfont=museo_sans_11pt_regular
textshadow=yes
onload=script10496(event_com, event_comsubid, 3)

// 1602:7
[stat_numbers]
type=text
x=20
y=43
width=150
height=210
xmode=abs_right
layer=root_layer
textfont=museo_sans_11pt_regular
textalignh=2
textshadow=yes

// 1602:8
[positive_button_on_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=positive_button_layer
onload=script7041(event_com)

// 1602:9
