// 825:0
[com_0]
type=rectangle
widthmode=minus
heightmode=minus
colour=0x000000
fill=yes
trans=43

// 825:1
[windowmode_confirm_window]
type=layer
width=350
height=200
xmode=abs_centre
ymode=abs_centre
onload=script10069(lobbyscreen_windowmode_confirm:windowmode_confirm_background, lobbyscreen_windowmode_confirm:windowmode_confirm_border, lobbyscreen_windowmode_confirm:windowmode_confirm_content, null, "Display Setting Changed", 28782, null, null)

// 825:2
[windowmode_confirm_background]
type=layer
widthmode=minus
heightmode=minus
layer=windowmode_confirm_window

// 825:3
[windowmode_confirm_content]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=windowmode_confirm_window

// 825:4
[windowmode_confirm_border]
type=layer
widthmode=minus
heightmode=minus
layer=windowmode_confirm_window

// 825:5
[text]
type=text
width=30
height=66
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=windowmode_confirm_content
textfont=notosans_11
text=Your display has been changed.<br>Do you want to keep this setting?
textalignh=1
textalignv=1
textshadow=yes
colour=0x7592a0

// 825:6
[countdown]
type=text
y=51
width=30
height=15
widthmode=minus
xmode=abs_centre
ymode=abs_bottom
layer=windowmode_confirm_content
textfont=notosans_11
textalignh=1
textalignv=1
textshadow=yes

// 825:7
[buttons]
type=layer
y=16
height=27
widthmode=minus
xmode=abs_centre
ymode=abs_bottom
layer=windowmode_confirm_content

// 825:8
[yes]
type=button
x=-66
width=100
height=27
xmode=abs_centre
ymode=abs_bottom
layer=buttons
noclickthrough=yes
sprite.graphic=button_action_positive
text.text=Yes
stylesheet=button_action_positive

// 825:9
[no]
type=button
x=66
width=100
height=27
xmode=abs_centre
ymode=abs_centre
layer=buttons
noclickthrough=yes
sprite.graphic=button_action_neutral
text.text=No
stylesheet=button_action_neutral

