// 911:0
[universe]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
onload=lobbyscreen_options_load

// 911:1
[contents]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=universe

// 911:2
[title]
type=text
height=30
widthmode=minus
layer=contents
textfont=cinzel_18pt_bold
text=Options
textalignv=1
textshadow=yes
colour=0xffcb05
onload=script10496(event_com, event_comsubid, 0)

// 911:3
[audio_layer]
type=layer
y=30
height=45
widthmode=minus
xmode=abs_centre
layer=contents

// 911:4
[tool_bar_audio_bar]
type=layer
width=20
height=8
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=audio_layer

// 911:5
[options_client_if]
type=layer
height=75
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_bottom
layer=contents

// 911:6
[mute_button]
type=layer
width=32
height=32
ymode=abs_centre
layer=tool_bar_audio_bar
onclick=loginscreen_slider_click_icon

// 911:7
[audio_mute]
type=graphic
width=32
height=32
ymode=abs_centre
layer=mute_button
graphic="options_icons,2"
colour=0xffffff
clickmask=no
onmouserepeat=script8799("Mute", event_com, event_comsubid)

// 911:8
[audio_cross]
type=graphic
width=32
height=32
xmode=abs_centre
ymode=abs_centre
layer=mute_button
graphic="mtxbeach16_map_icons,4"
outline=1
colour=0xffffff
clickmask=no
onload=script15656
onmouserepeat=script8799("Unmute", event_com, event_comsubid)

// 911:9
[tool_bar_vol_layer]
type=layer
width=38
widthmode=minus
heightmode=minus
xmode=abs_right
ymode=abs_centre
layer=tool_bar_audio_bar
onload=loginscreen_slider_init(lobbyscreen_pane_options:audio_build, lobbyscreen_pane_options:audio_click)

// 911:10
[audio_build]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=tool_bar_vol_layer

// 911:11
[audio_click]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=tool_bar_vol_layer
onmouserepeat=script8799("Change volume", event_com, event_comsubid)

