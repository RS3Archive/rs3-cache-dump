// 1040:0
[notification_text]
type=text
x=5
y=5
width=10
height=10
widthmode=minus
heightmode=minus
layer=notification_text_window_content
textfont=museo_sans_15pt_bold
textlineheight=17
textalignh=1
textalignv=1
textshadow=yes

// 1040:1
[bespoke_window]
