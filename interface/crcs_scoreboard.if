// 788:0
[last_fifty]
type=text
y=5
width=4
height=20
widthmode=minus
xmode=abs_centre
layer=mainmodal_window_content
textfont=cinzel_13pt_bold
text=Last fifty performances on this world:
textalignh=1
textshadow=yes
colour=0xbf751d
onload=script10496(event_com, event_comsubid, 0)

