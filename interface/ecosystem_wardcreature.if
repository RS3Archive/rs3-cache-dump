// 311:0
[jadinko_layer]
type=layer
width=10
height=10
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=mainmodal_window_content

// 311:1
[buttons]
type=layer
x=5
width=180
height=190
xmode=abs_right
ymode=abs_centre
layer=mainmodal_window_content
onload=script9615
onvartransmit=script9615
onvartransmitlist=ecosystem_temp_7

// 311:2
[ward_button]
type=layer
width=150
height=27
xmode=abs_right
ymode=abs_bottom
layer=mainmodal_window_content
transmitop1=yes
op1=Select
opcursor0=cursor_use
onload=script13968(event_com, null, rs3tli_positive_button, "Ward Off")

// 311:3
[mainmodal_window]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
onload=script8420(ecosystem_wardcreature:mainmodal_window_background, ecosystem_wardcreature:mainmodal_window_border, ecosystem_wardcreature:mainmodal_window_content, ecosystem_wardcreature:mainmodal_window_close_button, "Jadinko Warding", 21218, string_1007)

// 311:4
[bigmodel]
type=model
width=289
height=151
ymode=abs_centre
layer=jadinko_layer
model=eco_vine_creature_green
modelorigin_x=1
modelorigin_y=55
modelangle_x=108
modelangle_y=256
modelangle_z=0
modelzoom=358
modelanim=eco_vine_creature_walk

// 311:5
[name]
type=text
y=20
width=289
height=20
layer=jadinko_layer
textfont=cinzel_13pt_bold
text=Common Jadinko
textalignh=1
textalignv=1
textshadow=yes
colour=0xffcb05
onload=script10496(event_com, event_comsubid, 1)

// 311:6
[mainmodal_window_background]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=mainmodal_window

// 311:7
[mainmodal_window_content]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=mainmodal_window

// 311:8
[build]
type=layer
widthmode=minus
heightmode=minus
layer=buttons

// 311:9
[mainmodal_window_border]
type=layer
widthmode=minus
heightmode=minus
layer=mainmodal_window

// 311:10
[mainmodal_window_close_button]
