// 389:2
[resultlist]
type=layer
x=50
width=70
height=25
widthmode=minus
heightmode=minus
layer=root

// 389:3
[resultlist_hide]
type=layer
x=50
width=70
height=25
widthmode=minus
heightmode=minus
layer=root

// 389:4
[com_4]
type=text
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=resultlist_hide
textfont=museo_sans_13pt_bold
text=To search for an item, start by typing part of its name.<br>Then, simply select the item you want from the results on display.
textlineheight=15
textalignh=1
textalignv=1
textshadow=yes
colour=0xffcb05
onload=stylesheet_set_text(event_com, text_subtitle_paper_journal)

