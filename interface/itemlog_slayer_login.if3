// 400:0
[bespoke_window]
type=layer
width=488
height=308
xmode=abs_centre
ymode=abs_centre
onload=script8420(26214401, 26214404, 26214402, 26214405, "", 21259, 1007)

// 400:1
[bespoke_window_background]
type=layer
x=4
y=4
width=8
height=8
widthmode=minus
heightmode=minus
layer=bespoke_window

// 400:2
[bespoke_window_content]
type=layer
x=4
y=4
width=8
height=8
widthmode=minus
heightmode=minus
layer=bespoke_window

// 400:3
[bg_graphic]
type=graphic
width=480
height=300
layer=bespoke_window_content
graphic=slayer_collections_popup_en
transmitop=1
op1=Select
opcursor0=cursor_use
onload=script338(event_com, 7619, 7620, 7621, 7622)

// 400:4
[bespoke_window_border]
type=layer
widthmode=minus
heightmode=minus
layer=bespoke_window

// 400:5
[close_button_layer]
type=layer
widthmode=minus
heightmode=minus
layer=bespoke_window
transmitop=1
op1=Close
onop=closebutton_click

