// 587:0
[mainmodal_window]
type=layer
width=276
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
onload=script8420(kr_scrap_paper:mainmodal_window_background, kr_scrap_paper:mainmodal_window_border, kr_scrap_paper:mainmodal_window_content, kr_scrap_paper:mainmodal_window_close_button, "Scrap Paper", toplevel_v2_default_main_modal_skin_data, 1007)

// 587:1
[mainmodal_window_background]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=mainmodal_window

// 587:2
[mainmodal_window_content]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=mainmodal_window

// 587:3
[com_3]
type=graphic
width=496
height=293
xmode=abs_centre
ymode=abs_centre
layer=mainmodal_window_content
graphic=rs3_parchment_scroll_background

// 587:4
[text]
type=text
x=5
width=298
height=176
xmode=abs_right
ymode=abs_centre
layer=mainmodal_window_content
textfont=museo_sans_15pt_bold
fontmono=no
text=Meet at Camel<br> We'll storm<br> She'll ensure w<br> The servants<br> silence.
textalignh=right
textalignv=centre
colour=0x000000
opbase=rm

// 587:5
[mainmodal_window_border]
type=layer
widthmode=minus
heightmode=minus
layer=mainmodal_window

// 587:6
[mainmodal_window_close_button]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_right
layer=mainmodal_window
transmitop=1
op1=Close
onop=closebutton_click

