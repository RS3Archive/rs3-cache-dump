// 651:0
[send_to_inv]
type=button
width=8
height=27
widthmode=minus
xmode=abs_centre
layer=bespoke_window_content
noclickthrough=yes
sprite.graphic=button_action_positive
text.textfont=notosans_12
text.fontmono=no
text.text=To Backpack
text.textalignh=centre
text.textalignv=centre
text.textshadow=yes
stylesheet=button_action_positive
transmitop=1
op1=To Backpack
onload=stylesheet_set(event_com)
onmouserepeat=script10009("", event_com, event_comsubid)

// 651:1
[send_to_bank]
type=button
y=4
width=8
height=27
widthmode=minus
xmode=abs_centre
ymode=abs_bottom
layer=bespoke_window_content
noclickthrough=yes
sprite.graphic=button_action_neutral
text.textfont=notosans_12
text.fontmono=no
text.text=To Bank
text.textalignh=centre
text.textalignv=centre
text.textshadow=yes
stylesheet=button_action_neutral
transmitop=1
op1=To Bank
onload=stylesheet_set(event_com)
onmouserepeat=script10009("", event_com, event_comsubid)

// 651:2
[bespoke_window]
type=layer
widthmode=minus
heightmode=minus
onload=script8420(stockmarket_collectall:bespoke_window_background, stockmarket_collectall:bespoke_window_border, stockmarket_collectall:bespoke_window_content, null, "Collect All", toplevel_v2_bespoke_window_skin_data, -1)

// 651:3
[bespoke_window_background]
type=layer
x=4
y=4
width=8
height=8
widthmode=minus
heightmode=minus
layer=bespoke_window

// 651:4
[bespoke_window_content]
type=layer
x=4
y=4
width=8
height=8
widthmode=minus
heightmode=minus
layer=bespoke_window

// 651:5
[bespoke_window_border]
type=layer
widthmode=minus
heightmode=minus
layer=bespoke_window

