// 180:0
[main_countdown]
type=layer
width=214
height=42
xmode=abs_centre
hide=yes
onload=script11033(11796482, 11796486, 11796483, -1, "", 21259, 1005, 33700)

// 180:1
[starting_countdown]
type=layer
x=187
y=44
width=581
height=245
xmode=proportion_centre
ymode=proportion_centre
hide=yes

// 180:2
[bespoke_window_background]
type=layer
x=4
y=4
width=8
height=8
widthmode=minus
heightmode=minus
layer=main_countdown

// 180:3
[bespoke_window_content]
type=layer
x=4
y=4
width=8
height=8
widthmode=minus
heightmode=minus
layer=main_countdown

// 180:4
[title_text]
type=text
x=10
y=3
width=132
height=24
layer=bespoke_window_content
textfont=museo_sans_17pt_bold
fontmono=no
text=Time remaining:
textshadow=yes
onvartransmit=script2779

// 180:5
[time_remaining]
type=text
x=149
y=3
width=50
height=24
layer=bespoke_window_content
textfont=museo_sans_17pt_bold
fontmono=no
text=00:00
textshadow=yes
onload=script1220
onvartransmit=script1220

// 180:6
[bespoke_window_border]
type=layer
widthmode=minus
heightmode=minus
layer=main_countdown

// 180:7
[countdown_number]
type=graphic
width=256
height=256
xmode=proportion_centre
ymode=proportion_centre
layer=starting_countdown
graphic="menaphos_tombs_countdown,3"

