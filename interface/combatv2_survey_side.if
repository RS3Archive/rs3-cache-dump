// 1374:0
[title_text]
type=text
y=5
width=10
height=35
widthmode=minus
xmode=abs_centre
layer=academy
textfont=museo_sans_11pt_regular
text=The Evolution of Combat is now live!
textlineheight=14
textalignh=1
textshadow=yes

// 1374:1
[unequipped_text]
