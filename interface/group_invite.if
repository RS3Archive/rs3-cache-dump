// 1521:0
[bespoke_window]
type=layer
width=300
height=160
onload=script8420(group_invite:bespoke_window_background, group_invite:bespoke_window_border, group_invite:bespoke_window_content, null, "", 21259, string_1023)

// 1521:1
[bespoke_window_background]
type=layer
x=4
y=4
width=8
height=8
widthmode=minus
heightmode=minus
layer=bespoke_window

// 1521:2
[bespoke_window_content]
type=layer
x=4
y=4
width=8
height=8
widthmode=minus
heightmode=minus
layer=bespoke_window

// 1521:3
[invite_text]
type=text
height=45
widthmode=minus
layer=bespoke_window_content
textfont=museo_sans_13pt_regular
text=WWWWWWWWWWWW has invited you to join the group: Dungeoneering (Frozen)
textlineheight=14
textalignh=1
textalignv=1
textshadow=yes
colour=0xffcb05
maxlines=3
onload=script10385(event_com)
onvarctransmit=script10385(event_com)
onvarctransmitlist=group_invited_name,group_inviter_name

// 1521:4
[accept]
type=layer
y=47
width=150
height=27
xmode=abs_centre
layer=bespoke_window_content
transmitop1=yes
op1=Select
opcursor0=cursor_use
onload=script13968(event_com, null, rs3tli_positive_button, "Accept")

// 1521:5
[decline]
type=layer
y=77
width=150
height=27
xmode=abs_centre
layer=bespoke_window_content
transmitop1=yes
op1=Select
opcursor0=cursor_use
onload=script13968(event_com, null, rs3tli_neutral_button, "Decline")

