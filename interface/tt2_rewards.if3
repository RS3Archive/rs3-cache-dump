// 1123:0
[reward_name]
type=text
y=5
height=20
widthmode=minus
layer=details_layer
textfont=cinzel_15pt_bold
fontmono=no
text=Rewards
textalignh=centre
textalignv=centre
textshadow=yes
colour=0xffcb05
onload=script10496(event_com, event_comsubid, 1)

// 1123:1
[reward_description]
type=text
y=25
width=10
height=60
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=details_layer
textfont=notosans_11
fontmono=no
textalignv=centre
textshadow=yes
colour=0xaed0e0
onload=script10496(event_com, event_comsubid, 2)

// 1123:2
[confirm_button]
type=layer
y=5
width=10
height=27
widthmode=minus
xmode=abs_centre
ymode=abs_bottom
layer=details_layer
onload=script13968(tt2_rewards:confirm_build, tt2_rewards:confirm_click, rs3tli_positive_button, "Confirm")

// 1123:3
[reward_selection_layer]
type=layer
x=10
width=170
widthmode=minus
heightmode=minus
layer=mainmodal_window_content

// 1123:4
[right_panel]
type=layer
x=10
y=10
width=350
height=20
widthmode=minus
heightmode=minus
xmode=abs_right
layer=mainmodal_window_content

// 1123:5
[bg9]
type=layer
widthmode=minus
heightmode=minus
layer=right_panel
onload=script10896(event_com, null, rs3tli_content_panel_black)

// 1123:6
[mainmodal_window]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
onload=script8420(tt2_rewards:mainmodal_window_background, tt2_rewards:mainmodal_window_border, tt2_rewards:mainmodal_window_content, tt2_rewards:mainmodal_window_close_button, "Temple Trekking Rewards", toplevel_v2_default_main_modal_skin_data, 1007)

// 1123:7
[start_text]
type=text
width=10
height=10
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=right_panel
textfont=museo_sans_13pt_bold
fontmono=no
text=Select a reward on the left for more information.
textalignh=centre
textalignv=centre
textshadow=yes
colour=0xffcb05
onload=script10496(event_com, event_comsubid, 1)

// 1123:8
[details_layer]
type=layer
x=5
y=5
width=10
height=10
widthmode=minus
heightmode=minus
layer=right_panel
hide=yes

