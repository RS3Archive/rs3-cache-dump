width=120
height=40
widthmode=minus
layer=bars
textfont=museo_sans_11pt_regular
fontmono=no
text=The blue "Water" bar shows much water the Trawler has taken on. Watch out! If the bar completely fills up you will sink!
textalignh=centre
textalignv=centre
textshadow=yes
colour=0xaed0e0
onload=script10496(event_com, event_comsubid, 2)

// 368:15
[activity_bar_info_text]
type=text
width=120
height=68
widthmode=minus
ymode=abs_bottom
layer=bars
textfont=museo_sans_11pt_regular
fontmono=no
text=The green "Activity" bar shows much you have contributed to this Trawler trip. If the bar ever becomes empty, you will be removed from the Trawler. You can fill the bar up by performing the following actions:
textalignh=centre
textalignv=centre
textshadow=yes
colour=0xaed0e0
onload=script10496(event_com, event_comsubid, 2)

