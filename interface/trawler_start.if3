// 368:1
[bailing_bucket_text]
type=text
width=70
widthmode=minus
heightmode=minus
xmode=abs_right
layer=bucket
textfont=museo_sans_11pt_regular
fontmono=no
text=If the Trawler starts to fill with water, you can use bailing buckets to reduce the water level.
textlineheight=20
textalignh=centre
textalignv=centre
textshadow=yes
colour=0xaed0e0
onload=script10496(event_com, event_comsubid, 2)

