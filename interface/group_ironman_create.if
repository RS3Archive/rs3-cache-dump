// 1300:0
[main_layer]
type=layer
width=190
height=11
heightmode=minus
xmode=abs_centre
onload=script19416
onvartransmit=script19417(1)
ontimer=script19417(0)
onvartransmitlist=group_ironman_temp

// 1300:1
[info_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=main_layer

// 1300:2
[group_layer]
type=layer
widthmode=minus
heightmode=minus
layer=main_layer
hide=yes

// 1300:3
[content_layer]
type=layer
widthmode=minus
heightmode=minus
layer=group_layer

// 1300:4
[title]
type=text
y=4
width=10
height=15
widthmode=minus
xmode=abs_centre
layer=content_layer
textfont=notosans_14
text=Create a Group
textalignh=1
textalignv=1
textshadow=yes
colour=0xffcb05
onload=script10496(event_com, event_comsubid, 0)

// 1300:5
[com_5]
type=text
x=5
y=24
width=150
height=15
layer=content_layer
textfont=notosans_12
text=Group Name:
textalignv=1
textshadow=yes
colour=0xffcb05
onload=script10496(event_com, event_comsubid, 2)

// 1300:6
[group_name]
type=text
x=5
y=39
width=150
height=15
layer=content_layer
textfont=notosans_12
textalignv=1
textshadow=yes

// 1300:7
[com_7]
type=text
x=5
y=55
width=150
height=15
layer=content_layer
textfont=notosans_12
text=Ruleset:
