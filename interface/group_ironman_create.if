x=5
y=27
width=26
height=26
xmode=abs_right
layer=content_layer
onload=script14459("Choose group name.", event_com, event_comsubid)

// 1300:10
[edit_group_name_button]
type=button
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=edit_group_name_layer
noclickthrough=yes
sprite.graphic=button_icon_neutral
stylesheet=button_icon_neutral
transmitop1=yes
op1=Choose Group Name
onload=stylesheet_set(event_com)

// 1300:11
[edit_name_button]
type=graphic
width=18
height=18
xmode=abs_centre
ymode=abs_centre
layer=edit_group_name_layer
graphic=rs3_menu_btn_edit_normal
colour=0xffffff
clickmask=no

// 1300:12
[edit_group_ruleset_layer]
type=layer
x=5
y=58
width=26
height=26
xmode=abs_right
layer=content_layer
onload=script14459("Change ruleset.", event_com, event_comsubid)

// 1300:13
[members]
type=layer
y=90
width=190
height=197
layer=content_layer

// 1300:14
[creator_buttons_layer]
type=layer
y=255
height=75
widthmode=minus
layer=content_layer

// 1300:15
[confirm_button]
