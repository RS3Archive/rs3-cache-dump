// 1505:0
[topstat_circle_prayer]
type=graphic
x=1
width=31
height=31
xmode=abs_right
ymode=abs_bottom
layer=globe_layer
graphic="aif_topstat_fill_full,1"
colour=0xffffffff

// 1505:1
[topstat_prayer]
type=layer
width=67
height=34
noclickthrough=yes

// 1505:2
[topstat_background_prayer]
type=graphic
width=67
height=34
layer=topstat_prayer
graphic=topstat_slot_full_lrg
hflip=yes
colour=0xffffffff
transmitop=1,2
op1=Turn Quick Prayers On
op2=Select Quick Prayers
onload=script8050(event_com)
onmouseover=graphic_swapper(event_com, 23530)
onmouseleave=graphic_swapper(event_com, 23529)
onvartransmit=topstat_prayer_custom(98631680, event_com, 782, 1209){prayer_perm1, prayer_points_var, topstat_prayer_if}
onop=topstat_prayer_button_op(event_op, 98631680, event_com, 782, 1209)
onvarctransmit=topstat_prayer_custom(98631680, event_com, 782, 1209){prayer_custom_view_client}

// 1505:3
[globe_layer]
type=layer
y=1
height=31
widthmode=minus
xmode=abs_right
layer=topstat_prayer
onload=script9890(event_com)
onvartransmit=script8119(event_com){prayer_points_var}
onstattransmit=script8119(event_com){prayer}

// 1505:4
[topstat_graphic_prayer]
type=graphic
x=7
width=20
height=20
xmode=abs_right
ymode=abs_centre
layer=topstat_prayer
graphic="aif_topstat_icon,1"

