// 1500:0
[rightside_wrapper]
type=layer
width=16384
height=16391
widthmode=proportion
heightmode=proportion
onload=script6785
onvartransmit=script6785
onvartransmitlist=ql4_quest_viewing_perm,quest_areas

// 1500:1
[journal_layer]
type=layer
width=16391
height=16391
widthmode=proportion
heightmode=proportion
layer=rightside_wrapper

// 1500:2
[journal_wiki_layer]
type=layer
x=2
y=2
width=60
height=24
xmode=abs_right
layer=journal_layer

// 1500:3
[btn_journal_wiki]
type=button
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=journal_wiki_layer
noclickthrough=yes
stylesheet=button_default
transmitop1=yes
op1=Quick Guide
onload=stylesheet_set(event_com)

// 1500:4
[com_4]
type=graphic
width=47
height=17
xmode=abs_centre
ymode=abs_centre
layer=journal_wiki_layer
graphic="rs3_icon_rs_wiki_desktop,0"
colour=0xffffff
clickmask=no

// 1500:5
[progress_layer_1]
type=layer
height=35
widthmode=minus
xmode=abs_centre
ymode=abs_bottom
layer=journal_layer

// 1500:6
[info_holder_active_3]
type=layer
widthmode=minus
heightmode=minus
ymode=abs_centre
layer=progress_layer_1
hide=yes
onload=rs3_background_panel(event_com, rs3_content_container_active)

// 1500:7
[history_1]
type=layer
x=4
width=84
height=27
ymode=abs_centre
layer=progress_layer_1

// 1500:8
[forward_1]
type=layer
width=40
height=27
xmode=abs_right
ymode=abs_centre
