// 1406:11
[button_start_league]
type=button
y=4
width=180
height=30
xmode=abs_centre
ymode=abs_bottom
layer=offset
noclickthrough=yes
unknown1=2
sprite.graphic=button_action_positive
text.textfont=notosans_12
text.fontmono=no
text.text=Play Leagues
text.textalignh=centre
text.textalignv=centre
text.textshadow=yes
stylesheet=button_action_positive
transmitop=1
op1=Enable WikiSync
onload=stylesheet_set(event_com)
onbuttonpressed=script21079

