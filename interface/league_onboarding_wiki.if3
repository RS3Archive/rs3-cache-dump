// 1406:0
[mainmodal_window]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
onload=script8420(league_onboarding_wiki:mainmodal_window_background, league_onboarding_wiki:mainmodal_window_border, league_onboarding_wiki:mainmodal_window_content, league_onboarding_wiki:mainmodal_window_close_button, "Additional Features", toplevel_v2_default_main_modal_skin_data, 1007)

// 1406:1
[mainmodal_window_background]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=mainmodal_window

// 1406:2
[mainmodal_window_content]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=mainmodal_window

// 1406:3
[divider]
type=layer
y=174
height=2
widthmode=minus
layer=mainmodal_window_content
noclickthrough=yes
onload=script11740(event_com)

// 1406:4
[offset]
type=layer
width=8
height=8
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=mainmodal_window_content
noclickthrough=yes
onload=script20236
onvartransmit=script20236{option_toggle3}

// 1406:5
[wiki_title]
type=text
height=20
widthmode=minus
layer=offset
textfont=notosans_bold_13
fontmono=no
text=WikiSync
textalignh=centre
textshadow=yes
colour=0xffcb05
onload=script10496(event_com, event_comsubid, 0)

// 1406:6
[wiki_text]
