// 107:0
[stockside_window]
type=layer
widthmode=minus
heightmode=minus
onload=script660

// 107:1
[stockside_window_background]
type=layer
x=4
y=4
width=8
height=8
widthmode=minus
heightmode=minus
layer=stockside_window

// 107:2
[stockside_window_content]
type=layer
x=4
y=4
width=8
height=8
widthmode=minus
heightmode=minus
layer=stockside_window

// 107:3
[root]
type=layer
widthmode=minus
heightmode=minus
layer=stockside_window_content

// 107:4
[oplayer]
type=layer
layer=root
hide=yes
transmitop1=yes
transmitop10=yes
op1=Offer
op10=Examine
opcursor0=cursor_prayer

// 107:5
[scroll_layer]
type=layer
