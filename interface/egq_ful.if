// 1565:0
[green_large_progress_layer]
type=layer
x=2
y=2
width=450
height=30
ontimer=script2856(egq_ful:green_large_progress_value_layer)

// 1565:1
[com_1]
type=graphic
width=12
height=30
ymode=abs_centre
layer=green_large_progress_layer
