// 1643:0
[main_layer]
type=layer
width=270
height=280
xmode=abs_centre
ymode=abs_centre

// 1643:1
[background]
type=layer
width=270
height=300
xmode=abs_centre
ymode=abs_centre
layer=main_layer
onload=rs3_background_panel(event_com, rs3_content_container_active)

// 1643:2
[title_box]
type=layer
y=10
width=241
height=44
xmode=abs_centre
layer=main_layer

// 1643:3
[title_text]
type=text
x=26
width=194
height=32
ymode=abs_centre
layer=title_box
textfont=museo_sans_15pt_bold
text=CONGRATULATIONS!
textalignh=1
textalignv=1
textshadow=yes
colour=0xffcb05

// 1643:4
