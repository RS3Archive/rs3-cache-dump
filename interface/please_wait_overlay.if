// 218:0
[blackout_layer]
type=layer
widthmode=minus
heightmode=minus

// 218:1
[mainmodal_window]
type=layer
width=270
height=164
xmode=abs_centre
ymode=abs_centre
onload=script8420(please_wait_overlay:mainmodal_window_background, please_wait_overlay:mainmodal_window_border, please_wait_overlay:mainmodal_window_content, please_wait_overlay:mainmodal_window_close_button, "Please Wait", 1006, null)

// 218:2
[mainmodal_window_background]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=mainmodal_window

// 218:3
[mainmodal_window_border]
type=layer
widthmode=minus
heightmode=minus
layer=mainmodal_window

// 218:4
[mainmodal_window_content]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=mainmodal_window

// 218:5
[loading_spinner_layer]
type=layer
width=72
height=72
xmode=abs_centre
ymode=abs_centre
layer=mainmodal_window_content
onload=spinner_create(event_com, 1, -1)

// 218:6
[info_text]
type=text
y=5
width=10
height=50
widthmode=minus
xmode=abs_centre
layer=mainmodal_window_content
hide=yes
textfont=museo_sans_11pt_regular_multiline
textalignh=1
textshadow=yes
onload=script10496(event_com, event_comsubid, 3)

// 218:7
[mainmodal_window_close_button]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_right
layer=mainmodal_window
hide=yes
transmitop1=yes
op1=Close
onop=closebutton_click

// 218:8
[com_8]
type=rectangle
widthmode=minus
heightmode=minus
layer=blackout_layer
colour=0x000000
fill=yes
trans=128

