// 1192:0
[background]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre

// 1192:1
[border]
type=layer
widthmode=minus
heightmode=minus
onload=script11726(chat_v2_left_overlay:background, chat_v2_left_overlay:border, null, null, "", 23001, string_1006)

// 1192:2
[layer_1]
type=layer
width=16
height=16
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre

// 1192:3
[title_layer]
type=layer
width=230
height=30
widthmode=minus
xmode=abs_centre
layer=layer_1

// 1192:4
[title_text]
type=text
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=title_layer
textfont=cinzel_12pt_bold
text=Name
textlineheight=10
textalignh=1
textalignv=1
textshadow=yes
colour=0xffcb05
onload=script2732(event_com, -1, 0)

// 1192:5
[chathead_holder]
type=layer
y=-5
width=624
height=134
ymode=abs_bottom
layer=layer_1
onload=script10007(event_com, chat_v2_left_overlay:ring_background, chat_v2_left_overlay:ring_foreground, chat_v2_left_overlay:chat_mask_left, chatv2_chathead_holder_left)

// 1192:6
[ring_background]
type=graphic
width=67
height=134
ymode=abs_bottom
layer=chathead_holder
graphic=rs3_ui_dialogue_chathead_background
colour=0xffffff
clickmask=no

// 1192:7
[ring_foreground]
type=graphic
x=67
width=67
height=134
ymode=abs_bottom
layer=chathead_holder
graphic=rs3_ui_dialogue_chathead_foreground
colour=0xffffff
clickmask=no

// 1192:8
[chathead_1]
type=model
x=55
y=45
width=32
height=32
ymode=abs_bottom
layer=chathead_holder
model=null
modelorigin_x=0
modelorigin_y=0
modelangle_x=40
modelangle_y=1882
modelangle_z=0
modelzoom=2150
onvartransmit=script2619(event_com)
onvartransmitlist=mtx_modular_pet_chat_data

// 1192:9
[chat_mask_left]
type=graphic
x=-6
width=138
height=109
ymode=abs_bottom
layer=chathead_holder
graphic=rs3_ui_dialogue_chathead_foreground_overlay
colour=0xffffff
clickmask=no

// 1192:10
[chat_text]
type=text
x=58
y=20
width=156
height=60
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_bottom
layer=layer_1
textfont=museo_sans_11pt_regular
textlineheight=15
textalignh=1
textalignv=1
colour=0x000000

// 1192:11
[click_continue_button]
type=layer
width=80
height=20
xmode=abs_centre
ymode=abs_bottom
layer=layer_1
hide=yes
pausebutton=yes

// 1192:12
[click_continue_button_on]
type=layer
widthmode=minus
heightmode=minus
layer=click_continue_button
onload=script11645(event_com, chatv2_continue_button, 1)

// 1192:13
[click_continue_button_over]
type=layer
widthmode=minus
heightmode=minus
layer=click_continue_button
onload=script11645(event_com, chatv2_continue_button, 2)

// 1192:14
[click_continue_button_hit]
type=layer
widthmode=minus
heightmode=minus
layer=click_continue_button
onload=script11645(event_com, chatv2_continue_button, 3)

// 1192:15
[click_continue]
type=layer
widthmode=minus
heightmode=minus
layer=layer_1
hide=yes
pausebutton=yes
pausetext=Continue
onload=script5584(chat_v2_left_overlay:click_continue_button, event_com)

