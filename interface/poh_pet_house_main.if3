// 879:0
[build_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=content_layer

// 879:1
[background_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=root_layer

// 879:2
[content_layer]
type=layer
y=40
width=16
height=48
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=root_layer

// 879:3
[frame_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=root_layer

// 879:4
[root_layer]
type=layer
width=490
height=320
xmode=abs_centre
ymode=abs_centre
onload=script8420(57606145, 57606147, 57606146, 57606149, "Pet House", 21218, -1)

// 879:5
[close_button_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=root_layer
transmitop=1
op1=Close
onop=closebutton_click

