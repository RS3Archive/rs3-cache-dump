// 239:5
[messagescroll2_gf]
type=text
x=30
y=45
width=450
height=66
layer=mainmodal_window_content
textfont=museo_sans_13pt_regular
text=This morning I received a complaint about your inability to repair the Camp Tyras catapult, arriving without the tools and materials required.  To avoid further delay, I'll repeat your instructions:
textlineheight=15
colour=0x362407

// 239:6
[messagescroll3]
type=text
x=30
y=130
width=450
height=81
layer=mainmodal_window_content
textfont=museo_sans_13pt_regular
text=*The replacement wooden parts must be made from MAHOGANY planks and at least MITHRIL nails. <br>*You will need METAL PARTS, which have been ordered from Rolad, the dwarf scholar.<br>The pride of the King's Engineers is at stake, Claus.
textlineheight=15
colour=0x362407

