// 1898:0
[chipbackground]
type=graphic
width=268
height=268
xmode=abs_centre
ymode=abs_centre
layer=lhs
graphic=mtxrunefest2017_skillchip_bg
colour=0xffffff
clickmask=no

// 1898:1
[rhs]
type=layer
width=203
heightmode=minus
xmode=abs_right
ymode=abs_centre
layer=bespoke_window_content

// 1898:2
[skillchip_info]
type=layer
y=40
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=rhs

// 1898:3
[title]
type=text
height=40
widthmode=minus
xmode=abs_centre
layer=rhs
textfont=cinzel_25pt_bold_multiline
text=RuneFest 2017
textlineheight=19
textalignh=1
textalignv=1
textshadow=yes
colour=0xffcd37

// 1898:4
[infotext]
type=text
x=-3
y=40
width=12
height=120
widthmode=minus
xmode=abs_centre
layer=rhs
textfont=museo_sans_11pt_regular_multiline
text=Unlock the RuneFest 2017 skill chips by completing activities in-game.<br><br>Complete all 8 and you'll unlock the 9th and final skill chip!
textalignh=3
textshadow=yes
colour=0x7592a0

// 1898:5
[task_info]
type=layer
y=160
height=166
widthmode=minus
layer=rhs

// 1898:6
[progress_bar_outer]
type=layer
y=20
width=160
height=16
xmode=abs_centre
ymode=abs_bottom
layer=task_info
onmouserepeat=script8799("Tracks your task progress.", event_com, -1)

// 1898:7
[task_text]
type=text
x=-3
y=20
width=12
height=80
widthmode=minus
xmode=abs_centre
layer=task_info
textfont=museo_sans_11pt_regular_multiline
text=Short task info here when a player clicks on the skillchip
textalignh=1
textshadow=yes
colour=0x7592a0

// 1898:8
[task_title]
type=text
height=20
widthmode=minus
xmode=abs_centre
layer=task_info
textfont=cinzel_18pt_bold
text=Task title
textlineheight=19
textalignh=1
textalignv=1
textshadow=yes
colour=0xffcd37

// 1898:9
[progress]
type=text
y=40
height=20
widthmode=minus
xmode=abs_centre
ymode=abs_bottom
layer=task_info
textfont=museo_sans_13pt_regular
text=Progress
textlineheight=19
textalignh=1
textalignv=1
textshadow=yes
colour=0xaed0e0

// 1898:10
[lhs]
type=layer
width=202
widthmode=minus
heightmode=minus
layer=bespoke_window_content

// 1898:11
[bespoke_window]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
onload=script8420(mtxrunefest2017:bespoke_window_background, mtxrunefest2017:bespoke_window_border, mtxrunefest2017:bespoke_window_content, mtxrunefest2017:mainmodal_window_close_button, "", 21259, null)

// 1898:12
[bespoke_window_background]
type=layer
x=4
y=4
width=8
height=8
widthmode=minus
heightmode=minus
layer=bespoke_window

// 1898:13
[bespoke_window_content]
type=layer
x=4
y=4
width=8
height=8
widthmode=minus
heightmode=minus
layer=bespoke_window

// 1898:14
[bespoke_window_border]
type=layer
widthmode=minus
heightmode=minus
layer=bespoke_window

// 1898:15
[mainmodal_window_close_button]
type=layer
widthmode=minus
heightmode=minus
layer=bespoke_window
transmitop1=yes
op1=Close
onop=closebutton_click

