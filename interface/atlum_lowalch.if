// 12:0
[modal_dialog_window]
type=layer
width=360
height=255
xmode=abs_centre
ymode=abs_centre
onload=script8420(atlum_lowalch:modal_dialog_window_background, atlum_lowalch:modal_dialog_window_border, atlum_lowalch:modal_dialog_window_content, atlum_lowalch:modal_dialog_window_close_button, "", 21217, string_1007)

// 12:1
[modal_dialog_window_background]
type=layer
y=40
width=16
height=48
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=modal_dialog_window

// 12:2
[modal_dialog_window_content]
type=layer
y=40
width=16
height=48
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=modal_dialog_window

// 12:3
[inventory_layer]
type=layer
y=5
width=5
height=5
widthmode=minus
heightmode=minus
xmode=abs_right
layer=modal_dialog_window_content

// 12:4
[modal_dialog_window_border]
type=layer
widthmode=minus
heightmode=minus
layer=modal_dialog_window

// 12:5
[modal_dialog_window_close_button]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_right
layer=modal_dialog_window
transmitop1=yes
op1=Close
onop=closebutton_click

// 12:6
[title]
type=text
y=8
height=26
widthmode=minus
xmode=abs_centre
layer=modal_dialog_window
textfont=cinzel_13pt_bold
textalignh=1
textalignv=1
textshadow=yes
colour=0xffcd05
onload=script10496(event_com, event_comsubid, 0)

