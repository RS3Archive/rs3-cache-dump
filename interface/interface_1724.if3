// 1724:7
[com_7]
type=text
width=462
height=284
xmode=abs_centre
ymode=abs_centre
layer=com_3
textfont=fontmetrics_27
fontmono=no
text=From far below came strains of gruff, tuneless humming. I rubbed my eyes, and peered down through the branches to see a stocky dwarf staggering towards the tree's roots. He leant against the trunk with one hand, chuckled to himself – as if at some private joke – and fumbled with his breeches. There was a trickling sound, and I grimaced. <br><br>Ugh…right. After this, I can sleep?<br><br>Silence. Good enough for me.<br><br>I clambered up into the high branches, and squinted around until I found a giant leaf, still welling with water from the night's rain. I flipped it with the end of my staff, and rainwater gushed down to the sound of dwarven curses. <br><br>I lay back in the morning sun and laughed, the boughs bobbing in time.
textalignh=centre
textalignv=centre
colour=0x191919
trans=255

