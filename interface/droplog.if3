// 1678:0
[droplog_window_content]
type=layer
widthmode=minus
heightmode=minus
onload=script9884(0)
onvartransmit=script9884(0){telemetry_setup}
oninvtransmit=script9884(0){droplog}
onvarctransmit=script9884(0){droplog_value_var1, droplog_value_var2, droplog_value_var3, droplog_value_var4, droplog_value_var5, droplog_value_var6, droplog_value_var7, droplog_value_var8, droplog_value_var9, droplog_value_var10}

// 1678:1
[droplog_build_layer]
type=layer
height=33
widthmode=minus
heightmode=minus
layer=droplog_window_content

// 1678:2
[droplog_options_layer]
type=layer
height=33
widthmode=minus
xmode=abs_centre
ymode=abs_bottom
layer=droplog_window_content

// 1678:3
[separator]
type=layer
height=2
widthmode=minus
layer=droplog_options_layer
onload=script11741(event_com)

// 1678:4
[open_parent_button]
type=layer
x=4
width=24
height=10
heightmode=minus
ymode=abs_centre
layer=droplog_options_layer

// 1678:5
[open_parent_button_click]
type=button
widthmode=minus
heightmode=minus
layer=open_parent_button
noclickthrough=yes
sprite.graphic=button_icon_neutral
text.fontmono=no
text.textalignh=centre
text.textalignv=centre
text.textshadow=yes
stylesheet=button_icon_neutral
transmitop=1
op1=Open
opcursor0=cursor_open
onload=stylesheet_set(event_com)

// 1678:6
[loot_button]
type=layer
x=32
width=24
height=10
heightmode=minus
ymode=abs_centre
layer=droplog_options_layer

// 1678:7
[loot_button_click]
type=button
widthmode=minus
heightmode=minus
layer=loot_button
noclickthrough=yes
sprite.graphic=button_icon_neutral
text.fontmono=no
text.textalignh=centre
text.textalignv=centre
text.textshadow=yes
stylesheet=button_icon_neutral
transmitop=1
op1=Loot
onload=stylesheet_set(event_com)

// 1678:8
[reset_button]
type=layer
x=4
width=24
height=10
heightmode=minus
xmode=abs_right
ymode=abs_centre
layer=droplog_options_layer

// 1678:9
[reset_button_click]
type=button
widthmode=minus
heightmode=minus
layer=reset_button
noclickthrough=yes
sprite.graphic=button_icon_negative
text.fontmono=no
text.textalignh=centre
text.textalignv=centre
text.textshadow=yes
stylesheet=button_icon_negative
transmitop=1
op1=Reset
onload=stylesheet_set(event_com)

// 1678:10
[build_layer]
type=layer
widthmode=minus
heightmode=minus
layer=droplog_build_layer

// 1678:11
[scrollbar_layer]
type=layer
width=16
heightmode=minus
xmode=abs_right
layer=droplog_build_layer
hide=yes

// 1678:12
[open_parent_button_graphic]
type=graphic
width=23
height=23
xmode=abs_centre
ymode=abs_centre
layer=open_parent_button
graphic="rs3_icon_settings_23px,0"

// 1678:13
[loot_button_graphic]
type=graphic
width=24
height=24
xmode=abs_centre
ymode=abs_centre
layer=loot_button
graphic="rs3_icon_wardrobe_view_grid_24px,0"

// 1678:14
[reset_button_graphic]
type=graphic
width=20
height=20
xmode=abs_centre
ymode=abs_centre
layer=reset_button
graphic="rs3_icon_stopwatch_reset,0"

