// 370:0
[current_kills_bg]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=current_kills_wrapper
onload=rs3_background_panel(event_com, rs3_content_container_inactive)

// 370:1
[com_1]
type=text
width=85
heightmode=minus
ymode=abs_centre
layer=current_kills_wrapper
textfont=museo_sans_11pt_regular
text=Current Kills:
textalignh=1
textalignv=1
textshadow=yes

// 370:2
[com_2]
type=text
x=85
width=50
heightmode=minus
ymode=abs_centre
layer=current_kills_wrapper
textfont=museo_sans_11pt_regular
text=000000
textalignv=1
textshadow=yes
onload=script14317(event_com)

// 370:3
[name]
type=text
y=16
width=10
height=32
widthmode=minus
xmode=abs_centre
layer=hats_view
textfont=museo_sans_11pt_regular
textalignh=1
textshadow=yes
onload=script10496(event_com, -1, 0)

// 370:4
[chompy_hats]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
onload=script8420(chompybird_hats:chompy_hats_background, chompybird_hats:chompy_hats_border, chompybird_hats:chompy_hats_content, chompybird_hats:chompy_hats_close_button, "Chompy Hunter Hats", 21218, string_1007)

// 370:5
[chompy_hats_background]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=chompy_hats

// 370:6
[chompy_hats_content]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=chompy_hats
onload=script4227(chompybird_hats:build, chompybird_hats:click, chompybird_hats:scrollbar)

// 370:7
[hats]
type=layer
x=5
y=5
width=295
height=287
layer=chompy_hats_content

// 370:8
[hats_image]
type=model
width=100
height=100
xmode=abs_centre
ymode=abs_centre
layer=hats_view
model=null
modelorigin_x=0
modelorigin_y=0
modelangle_x=0
modelangle_y=0
modelangle_z=0
modelzoom=800

// 370:9
[build]
type=layer
widthmode=minus
heightmode=minus
layer=hats

// 370:10
[click]
type=layer
widthmode=minus
heightmode=minus
layer=hats

// 370:11
[scrollbar]
type=layer
x=300
width=16
heightmode=minus
layer=chompy_hats_content

// 370:12
[hats_view]
type=layer
width=180
heightmode=minus
xmode=abs_right
layer=chompy_hats_content

// 370:13
[current_kills_wrapper]
type=layer
y=15
width=135
height=33
xmode=abs_centre
ymode=abs_bottom
layer=hats_view

// 370:14
[chompy_hats_border]
type=layer
widthmode=minus
heightmode=minus
layer=chompy_hats

// 370:15
[chompy_hats_close_button]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_right
layer=chompy_hats
transmitop1=yes
op1=Close
onop=closebutton_click

