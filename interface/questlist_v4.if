// 190:0
[list_main]
type=layer
y=30
height=30
widthmode=minus
heightmode=minus
onload=ql4_init(event_com)
onvartransmit=ql4_refresh(event_com)
onstattransmit=ql4_refresh(event_com)
onvarctransmit=ql4_refresh(event_com)
onvartransmitlist=ql4_temp
onvarctransmitlist=ql4_reinit

// 190:1
[label_status]
type=text
x=5
y=1
width=10
height=15
widthmode=minus
layer=list_main
textfont=museo_sans_11pt_regular
textshadow=yes
colour=0xeb981f
transmitop10=yes
op10=Change filters

// 190:2
[content]
type=layer
y=15
height=33
widthmode=minus
heightmode=minus
layer=list_main
onvartransmit=ql4_init(questlist_v4:list_main)
onvartransmitlist=toplevel_v2_general_varp

// 190:3
[top_line]
type=layer
y=15
height=2
widthmode=minus
layer=list_main
onload=script349(event_com)

// 190:4
[scrollbar]
type=layer
width=16
heightmode=minus
xmode=abs_right
ymode=abs_bottom
layer=content

// 190:5
[quests]
type=layer
width=16
widthmode=minus
heightmode=minus
ymode=abs_bottom
layer=content

// 190:6
[bottom_line]
type=layer
y=15
height=2
widthmode=minus
ymode=abs_bottom
layer=list_main
onload=script349(event_com)

// 190:7
[com_7]
type=text
y=1
width=8
height=15
widthmode=minus
xmode=abs_centre
ymode=abs_bottom
layer=list_main
textfont=museo_sans_11pt_regular
textalignv=2
textshadow=yes
colour=0xeb981f
onload=script2166(event_com)
onmouseleave=script8805
onvartransmit=script2166(event_com)
onmouserepeat=script8799("The number of Quest Points<br>you have gained.", event_com, event_comsubid)
onvartransmitlist=qp,qp_total

// 190:8
[controls_filters_button_layer]
type=layer
width=25
height=25
ymode=abs_centre
layer=controls_layer

// 190:9
[controls_filters_button]
type=button
widthmode=minus
heightmode=minus
layer=controls_filters_button_layer
noclickthrough=yes
cantoggle=yes
stylesheet=button_default
transmitop1=yes
op1=Select
opcursor0=cursor_use
onload=stylesheet_set(event_com)
onop=script16141(event_com)

// 190:10
[controls_filters_button_graphic]
type=graphic
width=19
height=19
xmode=abs_centre
ymode=abs_centre
layer=controls_filters_button_layer
graphic="rs3_icon_filter,3"
colour=0xffffff
clickmask=no

// 190:11
[controls_static_dropdown]
type=layer
x=30
width=32
height=24
widthmode=minus
ymode=abs_centre
layer=controls_layer
onload=ql4_dropdown_onload(questlist_v4:controls_dropdown_build, questlist_v4:controls_dropdown_click)
onvartransmit=ql4_dropdown_onload(questlist_v4:controls_dropdown_build, questlist_v4:controls_dropdown_click)
onvartransmitlist=ql4_main

// 190:12
[controls_dropdown_build]
type=layer
widthmode=minus
heightmode=minus
layer=controls_static_dropdown
noclickthrough=yes

// 190:13
[controls_dropdown_click]
type=layer
widthmode=minus
heightmode=minus
layer=controls_static_dropdown
noclickthrough=yes
transmitop1=yes
op1=Select
opcursor0=cursor_use

// 190:14
[controls_filters_layer]
type=layer
x=4
y=32
width=30
height=130
widthmode=minus
hide=yes
onvartransmit=script17182
onvartransmitlist=ql4_main,ql4_main,ql4_main,ql4_main

// 190:15
[controls_layer]
type=layer
x=4
y=2
width=8
height=30
widthmode=minus

// 190:16
[controls_background_layer]
type=layer
widthmode=minus
heightmode=minus
layer=controls_filters_layer
noclickthrough=yes
stylesheet=background_default
onload=script7767(event_com, rs3_content_container_active, 0)

// 190:17
[controls_checkbox_locked]
type=check
x=10
y=6
width=20
height=25
widthmode=minus
layer=controls_filters_layer
noclickthrough=yes
alignment=255
colour=0xffffff
text.text=Show Locked
text.textalignv=1
stylesheet=checkbox_default_left_aligned
transmitop1=yes
op1=Select
opcursor0=cursor_use
onload=stylesheet_set(event_com)
onmouserepeat=script8799("Filter quests you cannot start due to unmet requirements.", event_com, event_comsubid)

// 190:18
[controls_checkbox_completed]
type=check
x=10
y=36
width=20
height=25
widthmode=minus
layer=controls_filters_layer
noclickthrough=yes
alignment=255
colour=0xffffff
text.text=Show Completed
text.textalignv=1
stylesheet=checkbox_default_left_aligned
transmitop1=yes
op1=Select
opcursor0=cursor_use
onload=stylesheet_set(event_com)
onmouserepeat=script8799("Filter quests you have completed.", event_com, event_comsubid)

// 190:19
[controls_checkbox_quests]
type=check
x=10
y=66
width=20
height=25
widthmode=minus
layer=controls_filters_layer
noclickthrough=yes
alignment=255
colour=0xffffff
text.text=Show Quests
text.textalignv=1
stylesheet=checkbox_default_left_aligned
transmitop1=yes
op1=Select
opcursor0=cursor_use
onload=stylesheet_set(event_com)
onmouserepeat=script8799("Filter full-length quests.", event_com, event_comsubid)

