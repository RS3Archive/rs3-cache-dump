// 712:0
[mainmodal_window]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
onload=script8420(ken_kent_note:mainmodal_window_background, ken_kent_note:mainmodal_window_border, ken_kent_note:mainmodal_window_content, ken_kent_note:mainmodal_window_close_button, "Note", toplevel_v2_default_main_modal_skin_data, 1007)

// 712:1
[mainmodal_window_background]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=mainmodal_window

// 712:2
[mainmodal_window_content]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=mainmodal_window

// 712:3
[com_3]
type=graphic
width=496
height=293
xmode=abs_centre
ymode=abs_centre
layer=mainmodal_window_content
graphic=rs3_parchment_scroll_background

// 712:4
[messagescroll1]
type=text
x=73
y=30
width=248
height=32
layer=mainmodal_window_content
textfont=quill_oblique_large
fontmono=no
text=Dear friend,
colour=0x000000

// 712:5
[messagescroll2]
type=text
x=80
y=90
width=360
height=115
layer=mainmodal_window_content
textfont=museo_sans_13pt_regular
fontmono=no
text=Come and meet me at the entrance to the Legends' Guild as soon as possible. There are things I would like to discuss with you, but it is difficult to talk in Witchaven...
colour=0x362407

// 712:6
[mainmodal_window_border]
type=layer
widthmode=minus
heightmode=minus
layer=mainmodal_window

// 712:7
[messagescroll3]
