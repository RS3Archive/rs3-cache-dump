// 1642:0
[universe]
type=layer
widthmode=minus
heightmode=minus
onload=script15086

// 1642:1
[progress_bar]
type=layer
x=10
width=44
height=180
layer=universe
noclickthrough=yes
onload=script11650
onvartransmit=script11650{mtxbeach15_main}

// 1642:2
[progress_bar_top]
type=graphic
height=98
widthmode=minus
xmode=abs_centre
layer=progress_bar
graphic="live_event_beach_progress_background,0"

// 1642:3
[spotlight_plot_layer]
type=layer
x=64
y=3
width=200
height=45
layer=universe
noclickthrough=yes
onload=script11653
onvartransmit=script11653{mtxbeach15_main_2, mtxbeach16_main2}

// 1642:4
[spotlight_plot_background]
type=layer
widthmode=minus
heightmode=minus
layer=spotlight_plot_layer
onload=script10896(event_com, -1, 2830)
onmouserepeat=script8799("Skilling at the spotlit plot will give 10% extra XP. The spotlight changes every 15 minutes.", event_com, -1)

// 1642:5
[spotlight_plot_text]
type=text
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=spotlight_plot_layer
textfont=museo_sans_15pt_regular
text=Spotlight Plot:<br>Coconut Shy
textlineheight=19
textalignh=centre
textalignv=centre
textshadow=yes
colour=0xaed0e0
onload=script10496(event_com, event_comsubid, 3)

// 1642:6
[progress_bar_middle]
type=graphic
height=88
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=progress_bar
graphic="live_event_beach_progress_background,1"

// 1642:7
[progress_bar_bottom]
type=graphic
height=98
widthmode=minus
xmode=abs_centre
ymode=abs_bottom
layer=progress_bar
graphic="live_event_beach_progress_background,2"

// 1642:8
[progress_bar_fill]
type=layer
height=37
widthmode=minus
xmode=abs_centre
ymode=abs_bottom
layer=progress_bar

// 1642:9
[progress_bar_fill_inner]
type=layer
height=180
widthmode=minus
ymode=abs_bottom
layer=progress_bar_fill

// 1642:10
[progress_bar_fill_top]
type=graphic
height=44
widthmode=minus
xmode=abs_centre
layer=progress_bar_fill_inner
graphic="live_event_beach_progress_fill,0"

// 1642:11
[progress_bar_fill_middle]
type=graphic
height=88
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=progress_bar_fill_inner
graphic="live_event_beach_progress_fill,1"

// 1642:12
[progress_bar_fill_bottom]
type=graphic
height=44
widthmode=minus
xmode=abs_centre
ymode=abs_bottom
layer=progress_bar_fill_inner
graphic="live_event_beach_progress_fill,2"

// 1642:13
[progress_bar_tooltip_layer]
type=layer
widthmode=minus
heightmode=minus
layer=progress_bar
onload=script11651

