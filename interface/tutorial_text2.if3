// 421:0
[tut3_layer]
type=layer
x=6
y=-1
width=33
height=12
widthmode=minus
heightmode=minus
ymode=abs_centre
layer=layer_1
scrollheight=200

// 421:1
[scroll_bar]
type=layer
x=7
y=5
width=16
height=11
heightmode=minus
xmode=abs_right
layer=layer_1
onload=scrollbar_vertical(event_com, tutorial_text2:tut3_layer)

// 421:2
