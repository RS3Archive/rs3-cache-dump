// 1863:0
[back_panel]
type=graphic
width=440
height=276
layer=content_layer
graphic=mtxfair17_zoltanticket
colour=0xffffff
clickmask=no

// 1863:1
[text_layer]
type=layer
widthmode=minus
heightmode=minus
layer=content_layer

// 1863:2
[top_text]
type=text
y=60
width=320
height=20
xmode=abs_centre
layer=text_layer
textfont=cinzel_18pt_bold
