textalignh=1
colour=0x6e203c

// 1863:3
[middle_text]
type=text
y=96
width=320
height=76
xmode=abs_centre
layer=text_layer
textfont=cinzel_15pt_bold
text=When you're on top of the world it's all downhill from there.
textalignh=1
colour=0x340e00

// 1863:4
[bottom_text]
type=text
y=60
width=320
height=36
xmode=abs_centre
ymode=abs_bottom
layer=text_layer
textfont=museo_sans_11pt_regular_multiline
text=All fortunes are final and cannot be returned. Terms and conditions apply.
textalignh=1
colour=0x080808

// 1863:5
[main_layer]
type=layer
width=456
height=316
xmode=abs_centre
ymode=abs_centre
onload=script8420(mtxfair17_zoltan:background_layer, mtxfair17_zoltan:border_layer, mtxfair17_zoltan:content_layer, mtxfair17_zoltan:closebutton_layer, "Your Mis-Fortune", 21218, null)

// 1863:6
[background_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=main_layer

// 1863:7
[content_layer]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=main_layer
onload=script4026

// 1863:8
[border_layer]
type=layer
widthmode=minus
heightmode=minus
layer=main_layer

// 1863:9
[closebutton_layer]
type=layer
widthmode=minus
heightmode=minus
