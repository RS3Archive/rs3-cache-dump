// 1134:7
[text2]
type=text
x=30
y=150
width=430
height=93
layer=mainmodal_window_content
textfont=museo_sans_13pt_regular
text=Of course, though life was good, now I am just like the rest of us; struggling to survive in this place. I will be in sector four. Please meet me in the clearing in the centre. I have so much to tell you.
colour=0x000000

