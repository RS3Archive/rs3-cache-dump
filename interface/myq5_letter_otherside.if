// 1134:5
[text1]
type=text
x=30
y=50
width=430
height=91
layer=mainmodal_window_content
textfont=museo_sans_13pt_regular
text=I can give you the answers you seek. I can tell you why you have lived so long, why you have these unexplained powers, why you have been having those visions.
colour=0x000000

