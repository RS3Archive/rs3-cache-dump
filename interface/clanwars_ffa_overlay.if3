// 789:0
[bg]
type=layer
widthmode=minus
heightmode=minus
layer=buffer
onload=script10896(event_com, null, rs3tli_content_panel_black)

// 789:1
[rules]
type=layer
x=5
width=64
height=72
xmode=abs_right
ymode=abs_centre
onload=clanwars_ffa(event_com, clanwars_ffa_overlay:rules_background, clanwars_ffa_overlay:rules_icon, clanwars_ffa_overlay:rules_header, clanwars_ffa_overlay:rules_text, clanwars_ffa_overlay:buffer, 1)
ontimer=clanwars_ffa(event_com, clanwars_ffa_overlay:rules_background, clanwars_ffa_overlay:rules_icon, clanwars_ffa_overlay:rules_header, clanwars_ffa_overlay:rules_text, clanwars_ffa_overlay:buffer, 0)

// 789:2
[rules_background]
type=graphic
widthmode=minus
heightmode=minus
layer=rules
tiling=yes
trans=125

// 789:3
[rules_icon]
type=graphic
y=15
width=32
height=32
xmode=abs_centre
layer=rules
graphic="options_icons,18"

// 789:4
[rules_header]
type=text
y=3
height=13
widthmode=minus
layer=rules
textfont=museo_sans_11pt_regular
fontmono=no
text=On death:
textalignh=centre
textshadow=yes
colour=0x000000

// 789:5
[rules_text]
type=text
y=46
height=23
widthmode=minus
layer=rules
textfont=museo_sans_11pt_regular
fontmono=no
textalignh=centre
textshadow=yes
colour=0x000000

// 789:6
[buffer]
type=layer
y=5
width=300
height=40
xmode=abs_centre

// 789:7
[com_7]
type=text
width=8
height=8
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=buffer
textfont=cinzel_18pt_bold
fontmono=no
text=Go north to fight...
textalignh=centre
textalignv=centre
textshadow=yes
colour=0xffcb05
onload=script10496(event_com, event_comsubid, 1)

// 789:8
[caller_layer]
type=layer
x=5
y=-728
width=75
height=50
widthmode=minus
ymode=proportion_centre
transmitop=10
op10= 
onload=script1807(event_com, clanwars_ffa_overlay:caller_name, clanwars_ffa_overlay:caller_text)

// 789:9
[caller_icon]
type=graphic
y=1
width=13
height=13
layer=caller_layer
graphic="coppa_mouth_button,2"
transmitop=1,2,10
opbase=<ff9040>Caller</col>
op1=Set
op2=Clear
op10= 
onop=meslayer_mode12(event_op)

// 789:10
[caller_name]
type=text
x=15
width=100
height=15
layer=caller_layer
textfont=b12_full
fontmono=no
textshadow=yes
colour=0x00ffff
transmitop=1,2,10
opbase=<ff9040>Caller</col>
op1=Set
op2=Clear
op10= 
onop=meslayer_mode12(event_op)

// 789:11
[caller_text]
type=text
height=15
widthmode=minus
heightmode=minus
ymode=abs_bottom
layer=caller_layer
textfont=p12_full
fontmono=no
textalignv=centre
textshadow=yes
colour=0x00ffff
transmitop=10
op10= 

