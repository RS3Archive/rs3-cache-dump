// 1603:3
[content]
type=layer
width=16
height=16
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
onload=script11144(event_com)

// 1603:4
[text_input_clickout]
type=layer
x=-1
y=-1
layer=content
hide=yes
noclickthrough=yes

// 1603:5
[text_input_listener]
type=layer
y=24
width=110
height=22
xmode=abs_centre
ymode=abs_bottom
layer=content
noclickthrough=yes
onvarctransmit=script7202(event_com, chat_input:text_input_listen, chat_input:text_input_caret, chat_input:text_input_display, chat_input:text_input_clickout)
onvarctransmitlist=p_dialog_listener,p_dialog_mode

// 1603:6
[com_6]
type=rectangle
widthmode=minus
heightmode=minus
layer=text_input_listener
colour=0xead5b4
fill=yes

// 1603:7
[com_7]
type=rectangle
widthmode=minus
heightmode=minus
layer=text_input_listener
colour=0xd29e4b

// 1603:8
[text_input_listen]
