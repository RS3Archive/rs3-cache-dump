// 94:0
[background_layer]
type=layer
widthmode=minus
heightmode=minus
layer=universe

// 94:1
[background]
type=rectangle
widthmode=minus
heightmode=minus
layer=background_layer
colour=0x000000
fill=yes

// 94:2
[content_layer]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=universe

// 94:3
[universe]
type=layer
widthmode=minus
heightmode=minus
noclickthrough=yes
ontimer=script6525(0, 0, 0, 0, 0, 0, null, "null", null, true, true, true, true)

// 94:4
[graphic]
type=graphic
width=1024
height=500
xmode=abs_centre
ymode=abs_centre
layer=content_layer
graphic=tut5_introscreen_1
trans=255
colour=0xffffff
clickmask=no

// 94:5
[text]
type=text
height=160
widthmode=minus
xmode=abs_centre
ymode=abs_bottom
layer=content_layer
textfont=notosans_bold_18
textalignh=1
textalignv=1
textshadow=yes

// 94:6
[skip_layer]
type=layer
x=-42
y=294
width=146
height=41
ymode=proportion_top
layer=content_layer
transmitop1=yes
opkey1=0,13,0
op1=Skip

// 94:7
[com_7]
type=rectangle
widthmode=minus
heightmode=minus
layer=skip_layer
colour=0x000000
trans=193

// 94:8
[skip_layer_graphic]
type=graphic
width=42
height=42
layer=skip_layer
graphic=aif_esc_btn_1
colour=0xffffff
clickmask=no

// 94:9
[skip_layer_text]
type=text
width=42
widthmode=minus
heightmode=minus
xmode=abs_right
layer=skip_layer
textfont=museo_sans_13pt_regular
