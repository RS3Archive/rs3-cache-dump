// 1803:0
[bg_graphic]
type=graphic
width=480
height=300
layer=bespoke_window_content
graphic=nxt_beta_popup_en
colour=0xffffff
clickmask=no

// 1803:1
[bespoke_window]
type=layer
width=488
height=308
xmode=abs_centre
ymode=abs_centre
