[info_text]
type=text
x=327
y=283
width=198
height=82
layer=main_layer
textfont=museo_sans_11pt_regular_multiline
text=Get the requested drink from each of the Inns before the 6th November to win 2 large prismatic lamps. You will receive a small prismatic lamp for each task on the list you complete.
