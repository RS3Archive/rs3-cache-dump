heightmode=minus
layer=text_layer
textfont=museo_sans_15pt_regular
text=We've noticed activity on your account that is inappropriate for our game, and is offensive to others.<br><br><br> Any activity of this type may result in a mute, or even a permanent ban.<br><br><br> To find out more, please click on the read button below. 
