// 24:0
[barrows_control_layer]
type=layer
width=16391
height=16391
widthmode=proportion
heightmode=proportion
onvartransmit=barrows_killcount_update{barrows_kills}
onvarctransmit=barrows_show_head{barrows_overlay_head}

// 24:1
[kills_layer]
type=layer
width=328
height=100
layer=barrows_control_layer

// 24:2
[info_holder_active]
type=layer
widthmode=minus
heightmode=minus
ymode=abs_centre
layer=kills_layer
onload=rs3_background_panel(event_com, 21361)

// 24:3
[main_content]
type=panel
width=10
height=10
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=kills_layer
noclickthrough=yes
isvertical=yes
childspacing=0

// 24:4
[grid_builder]
type=layer
widthmode=minus
heightmode=minus
layer=main_content
onload=barrows_grid_onload(event_com)

// 24:5
[creatures_slain]
type=panel
height=14
widthmode=minus
layer=main_content
noclickthrough=yes
isvertical=no
childspacing=0

// 24:6
[brothers_slain_panel]
type=panel
widthmode=minus
heightmode=minus
layer=creatures_slain
noclickthrough=yes
isvertical=no
childspacing=0

// 24:7
[brothers_slain_title]
type=text
width=13926
widthmode=proportion
heightmode=minus
layer=brothers_slain_panel
textfont=notosans_bold_12
fontmono=no
text=Brothers slain:
textalignv=centre
textshadow=yes
transmitop=10
op10=  
onload=script10496(event_com, event_comsubid, 3)

// 24:8
[brothers_killed]
type=text
width=4587
widthmode=proportion
heightmode=minus
xmode=abs_right
layer=brothers_slain_panel
noclickthrough=yes
textfont=notosans_12
fontmono=no
text=4/8
textalignv=centre
onvartransmit=barrows_brothers_killcount_update{barrows_kills}

// 24:9
[creature_panel]
type=panel
widthmode=minus
heightmode=minus
layer=creatures_slain
noclickthrough=yes
isvertical=no
childspacing=0

// 24:10
[creatures_slain_title]
type=text
width=13107
widthmode=proportion
heightmode=minus
ymode=abs_bottom
layer=creature_panel
textfont=notosans_bold_12
fontmono=no
text=Creatures slain:
textalignv=centre
textshadow=yes
transmitop=10
op10= 
onload=script10496(event_com, event_comsubid, 3)

// 24:11
[creature_kills]
type=text
width=3276
widthmode=proportion
heightmode=minus
xmode=abs_right
ymode=abs_bottom
layer=creature_panel
textfont=notosans_13
fontmono=no
text=9999
textalignv=centre
textshadow=yes
onvartransmit=barrows_killcount_update{barrows_kills}

