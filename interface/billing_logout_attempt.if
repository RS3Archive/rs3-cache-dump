// 1255:0
[mainmodal_window]
type=layer
width=270
height=164
xmode=abs_centre
ymode=abs_centre
onload=script8420(billing_logout_attempt:mainmodal_window_background, billing_logout_attempt:mainmodal_window_border, billing_logout_attempt:mainmodal_window_content, billing_logout_attempt:mainmodal_window_close_button, "Please wait", 21218, string_1007)

// 1255:1
[mainmodal_window_background]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=mainmodal_window

// 1255:2
[mainmodal_window_content]
type=layer
y=32
width=16
height=40
widthmode=minus
heightmode=minus
xmode=abs_centre
layer=mainmodal_window

// 1255:3
[loading_spinner_layer]
type=layer
width=72
height=72
xmode=abs_centre
ymode=abs_centre
layer=mainmodal_window_content
onload=spinner_create(event_com, 1, -1)

// 1255:4
[logout_text]
type=text
y=5
width=10
height=50
widthmode=minus
xmode=abs_centre
layer=mainmodal_window_content
hide=yes
textfont=museo_sans_11pt_regular_multiline
text=Solomon's General Store will open in a new tab.
textalignh=1
textshadow=yes
colour=0xebe0bc
onload=script10496(event_com, event_comsubid, 3)

// 1255:5
[mainmodal_window_border]
type=layer
widthmode=minus
heightmode=minus
layer=mainmodal_window

// 1255:6
[mainmodal_window_close_button]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_right
layer=mainmodal_window
hide=yes
transmitop1=yes
op1=Close
onop=closebutton_click

