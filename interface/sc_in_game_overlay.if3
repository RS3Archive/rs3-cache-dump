// 809:0
[score_container]
type=layer
x=10
y=10
width=180
height=40
onvarcstrtransmit=script1939{varclientstring_558}

// 809:1
[time_container]
type=layer
x=10
y=10
width=100
height=40
xmode=abs_right
onload=sc_game_start
ontimer=sc_overlay_timer
onvarctransmit=script1940{sc_client_minutes_remaining}

// 809:2
[time_bg]
type=layer
widthmode=minus
heightmode=minus
layer=time_container
onload=script10896(event_com, null, rs3tli_content_panel_black)

// 809:3
[time_remaining]
type=text
width=16
height=16
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=time_container
textfont=museo_sans_11pt_regular
fontmono=no
text=%1 min
textalignh=centre
textalignv=centre
colour=0xffcb05
onload=script10496(event_com, event_comsubid, 1)

// 809:4
[score_bg]
type=layer
widthmode=minus
heightmode=minus
layer=score_container
onload=script10896(event_com, null, rs3tli_content_panel_black)

// 809:5
[score]
type=text
width=16
height=16
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=score_container
textfont=museo_sans_11pt_regular
fontmono=no
text=Personal score: 
textalignh=centre
textalignv=centre
colour=0xffcd03
transmitop=10
op10= 
onload=script10496(event_com, event_comsubid, 1)

// 809:6
[panic_highlight_rect]
type=rectangle
x=18
y=16
width=82
height=27
xmode=abs_right
colour=0x990000
fill=yes
trans=255

// 809:7
[panic_text]
type=text
width=470
height=33
xmode=abs_centre
ymode=abs_centre
hide=yes
textfont=cinzel_25pt_bold_multiline
fontmono=no
text=One Minute Remaining
textalignh=centre
textalignv=centre
textshadow=yes
colour=0xffcb05
onload=script10496(event_com, event_comsubid, 1)

