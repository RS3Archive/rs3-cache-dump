// 1131:0
[background]
type=layer
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre

// 1131:1
[border]
type=layer
widthmode=minus
heightmode=minus
onload=script8420(chat_v2_right_overlay:background, chat_v2_right_overlay:border, null, null, "", 23001, string_1006)

// 1131:2
[layer_1]
type=layer
width=16
height=16
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre

// 1131:3
[title_layer]
type=layer
width=230
height=30
widthmode=minus
xmode=abs_centre
layer=layer_1

// 1131:4
[title_text]
type=text
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre
layer=title_layer
textfont=cinzel_12pt_bold
text=Name
textlineheight=10
textalignh=1
textalignv=1
textshadow=yes
colour=0xffcb05
onload=script2732(event_com, -1, 0)

// 1131:5
[chathead_holder]
type=layer
y=-5
width=176
height=134
xmode=abs_right
ymode=abs_bottom
layer=layer_1
onload=script10007(event_com, chat_v2_right_overlay:ring_background, chat_v2_right_overlay:ring_foreground, chat_v2_right_overlay:chat_mask_right, chatv2_chathead_holder_right)

// 1131:6
[ring_background]
type=graphic
width=67
height=134
xmode=abs_right
ymode=abs_centre
layer=chathead_holder
graphic=rs3_ui_dialogue_chathead_background
hflip=yes
colour=0xffffff
clickmask=no

// 1131:7
[ring_foreground]
type=graphic
x=67
width=67
height=134
xmode=abs_right
ymode=abs_centre
layer=chathead_holder
graphic=rs3_ui_dialogue_chathead_foreground
hflip=yes
colour=0xffffff
clickmask=no

// 1131:8
[chathead_1]
type=model
x=55
y=45
width=32
height=32
xmode=abs_right
ymode=abs_bottom
layer=chathead_holder
model=null
modelorigin_x=0
modelorigin_y=0
modelangle_x=40
modelangle_y=166
modelangle_z=0
modelzoom=2150
onvartransmit=script2619(event_com)
onvartransmitlist=mtx_modular_pet_chat_data

// 1131:9
[chat_mask_right]
type=graphic
x=-5
width=138
height=109
xmode=abs_right
ymode=abs_bottom
layer=chathead_holder
graphic=rs3_ui_dialogue_chathead_foreground_overlay
hflip=yes
colour=0xffffff
clickmask=no

// 1131:10
[chat_text]
type=text
x=20
y=20
width=156
height=60
widthmode=minus
heightmode=minus
ymode=abs_bottom
layer=layer_1
textfont=museo_sans_11pt_regular
textlineheight=15
textalignh=1
textalignv=1
colour=0x000000

// 1131:11
[click_continue_button]
type=layer
width=80
height=20
xmode=abs_centre
ymode=abs_bottom
layer=layer_1
hide=yes
pausebutton=yes

// 1131:12
[click_continue_button_on]
type=layer
widthmode=minus
heightmode=minus
layer=click_continue_button
onload=script11645(event_com, chatv2_continue_button, 1)

// 1131:13
[click_continue_button_over]
type=layer
widthmode=minus
heightmode=minus
layer=click_continue_button
onload=script11645(event_com, chatv2_continue_button, 2)

// 1131:14
[click_continue_button_hit]
type=layer
widthmode=minus
heightmode=minus
layer=click_continue_button
onload=script11645(event_com, chatv2_continue_button, 3)

// 1131:15
[click_continue]
type=layer
widthmode=minus
heightmode=minus
layer=layer_1
pausebutton=yes
pausetext=Continue
onload=script5584(chat_v2_right_overlay:click_continue_button, event_com)

