// 548:0
[background_layer]
type=layer
widthmode=minus
heightmode=minus
layer=universe

// 548:1
[background]
type=rectangle
widthmode=minus
heightmode=minus
layer=background_layer
colour=0x000000
fill=yes

// 548:2
[content_layer]
type=layer
width=800
height=600
xmode=abs_centre
ymode=abs_centre
layer=universe

// 548:3
[universe]
type=layer
widthmode=minus
heightmode=minus
noclickthrough=yes
ontimer=script9294(0, 0)

// 548:4
[skip_layer]
type=layer
x=10
y=10
width=140
height=42
xmode=abs_right
ymode=abs_bottom
layer=universe
transmitop=1
op1=Skip
opkey1=13,0

// 548:5
[graphic]
type=graphic
width=800
height=520
xmode=abs_centre
layer=content_layer
graphic=tut5_introscreen_1
trans=255

// 548:6
[text]
type=text
width=135
height=80
widthmode=minus
ymode=abs_bottom
layer=content_layer
textfont=cinzel_25pt_bold_multiline
fontmono=no
textlineheight=25
textalignh=centre
textalignv=centre
textshadow=yes

// 548:7
[com_7]
type=graphic
width=42
height=42
layer=skip_layer
graphic=aif_esc_btn_1

// 548:8
[com_8]
type=text
width=42
widthmode=minus
heightmode=minus
xmode=abs_right
layer=skip_layer
textfont=museo_sans_13pt_regular
fontmono=no
text=Skip Cutscene
textalignh=centre
textalignv=centre
textshadow=yes
colour=0xede3bc

