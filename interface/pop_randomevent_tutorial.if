// 675:11
[seasinger_layer]
type=layer
widthmode=minus
heightmode=minus
layer=content
hide=yes

// 675:12
[seasinger_tutorialinfo]
type=text
x=5
y=5
width=335
heightmode=minus
layer=seasinger_layer
textfont=museo_sans_11pt_regular_multiline
text=Help Seasinger Umi earn her keep in Port.<br><br>Some mischievous person has messed up the storage room above the lodgings, and has scrambled the list of items needed for use round the port today! Speak to the <col=ffcc00>Warehouse Worker</col> to get your clue, then search the <col=ffcc00>barrels</col> and <col=ffcc00>crates</col> to find the item it describes. Present the item to the <col=ffcc00>Warehouse Worker</col> if you think it is the right one.<br><br>You have to locate 3 items in total.
textshadow=yes

