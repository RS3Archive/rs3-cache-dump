// 675:2
[assassin_layer]
type=layer
widthmode=minus
heightmode=minus
layer=content
hide=yes

// 675:3
[assassin_tutorialinfo]
type=text
x=5
y=5
width=362
heightmode=minus
layer=assassin_layer
textfont=museo_sans_11pt_regular_multiline
text=Help the Black Marketeer work off his debt to the Death Lotus Assassins.<br><br>Find the assassins hidden in barrels around the port, each assassin will give you clues as to who their victim is. The victim is one of the <col=ffcc00>Wandering Strangers</col>. When you think you have found their victim, <col=ffcc00>Identify</col> the victim. <br><br>If you have selected the right person, the assassin will turn up to "remove" them from the port, otherwise the assassin will give you additional information to help you narrow down your search. <br><br>Help 3 assassins. There are 5 assassins in total.
textshadow=yes

