textalignh=1
textalignv=1
textshadow=yes
onload=script10496(event_com, -1, 0)

// 240:7
[options_control_layer]
type=layer
y=32
height=68
widthmode=minus
heightmode=minus
layer=options_window_content

// 240:8
[options_control_build]
type=layer
widthmode=minus
heightmode=minus
