// 240:0
[vartrans_layer]
type=layer
width=512
height=334
onload=script9397

// 240:1
[options_layer]
type=layer
widthmode=minus
heightmode=minus
noclickthrough=yes

// 240:2
[com_2]
type=rectangle
widthmode=minus
heightmode=minus
layer=options_layer
colour=0x000000
fill=yes
trans=150

// 240:3
[options_window]
type=layer
width=13107
height=10321
widthmode=proportion
heightmode=proportion
xmode=abs_centre
ymode=abs_centre
layer=options_layer
onload=script8420(activity_tracker_embedded_options:options_window_background, activity_tracker_embedded_options:options_window_border, activity_tracker_embedded_options:options_window_content, null, "", 21259, null)

// 240:4
[options_window_background]
type=layer
x=4
y=4
width=8
height=8
widthmode=minus
heightmode=minus
layer=options_window

// 240:5
[options_window_content]
type=layer
x=4
y=4
width=8
height=8
widthmode=minus
heightmode=minus
layer=options_window

// 240:6
[options_title]
type=text
height=32
widthmode=minus
layer=options_window_content
