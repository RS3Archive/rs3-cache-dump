param=param_1322,1

// 15373
[struct_15373]
param=param_3044,(Advanced) Adrenaline, Threshold Abilities and Ultimate Abilities
param=param_3045,Introduces the use of adrenaline and how to use more powerful abilities.<br><br>Demonstration:<br>Kill a skeletal juggernaut using powerful abilities.<br><br>Hover over the rank icons to see completion requirements.
param=param_3046,#1 Legend Rank<br><br>Kill the skeletal juggernaut and use a threshold and an ultimate ability.
param=param_3047,#2 Hero Rank<br><br>Kill the skeletal juggernaut and use a threshold or an ultimate ability.
param=param_3048,#3 Champion Rank<br><br>Kill the skeletal juggernaut.
