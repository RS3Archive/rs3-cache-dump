// 36857
[cheevo_atelf_easy_reward]
param=cheevo_name,Tirannwn Set Tasks - Easy
param=cheevo_details,Given by the elf tracker near the Tirannwn lodestone for completing all Easy Tasks in Tirannwn.
param=cheevo_rewards,Tirannwn quiver 1 and a magic lamp worth 10,000 XP in a skill of your choice.<br>Permanent, passive benefits:<br>- Access to an elf to whom you can sell your limestone near the limestone rocks; 5% damage boost against Mourners; 15 free swamp tar per day from the Lletya General Store.<br>While wearing the quiver:<br>- Allows you to always pass through leaf traps succesfully, and acts as a chime for the warped creatures in the Poison Waste Dungeon.<br>- Grants access to a shortcut deeper into the Poison Waste Dungeon; 5% chance of tortoise shells being noted.<br>- Ability to teleport to Lletya, and to Eluned, wherever she is in the forest, or Islwyn if Eluned is unavailable.
param=cheevo_icon,"shields,92"
param=cheevo_meta_list,cheevo_tirannwn_easy
param=cheevo_meta_list_type,0
param=cheevo_is_meta,1
param=cheevo_unique_id,1321
param=cheevo_meta_id,1702
param=cheevo_runescore,5

// 36858
[cheevo_atelf_medium_reward]
param=cheevo_name,Tirannwn Set Tasks - Medium
param=cheevo_details,Given by Gwir in Lletya for completing all Medium Tasks in Tirannwn.
param=cheevo_rewards,Tirannwn quiver 2 and a magic lamp worth 30,000 XP in a skill of your choice.<br>Permanent, passive benefits:<br>- Access to a new mushroom patch near Tyras Camp; an increase to 30 swamp tar per day from the Lletya General Store; 5% damage boost against shadow creatures.<br>- 5% chance of not using a charge on your crystal bow and wards and the ability to catch grenwalls without baiting traps.<br>While wearing the quiver:<br>- Prevents poison from traps in the forest.<br>- Tyras Camp and Poison Waste Slayer Dungeon teleports are available.
param=cheevo_icon,"shields,93"
param=cheevo_meta_list,cheevo_tirannwn_medium
param=cheevo_meta_list_type,0
param=cheevo_is_meta,1
param=cheevo_unique_id,1322
param=cheevo_meta_id,1702
param=cheevo_runescore,10

// 36859
[cheevo_atelf_hard_reward]
param=cheevo_name,Tirannwn Set Tasks - Hard
param=cheevo_details,Given by Arianwyn in the Cadarn district for completing all Hard Tasks in Tirannwn.
param=cheevo_rewards,Tirannwn quiver 3 and a magic lamp worth 40,000 XP in a skill of your choice.<br>Permanent, passive benefits:<br>- Lord Amlodd grants 10% more shards back when exchanging pouches; Eilwynn will exchange your divination chronicles.<br>- Lunet has a daily stash of battlestaves; 5% damage boost against elves.<br>While wearing the quiver:<br>- The Corrupted Seren Stone is easier to cleanse.<br>- Death Altar, Elf Camp and Tirannwn Mushroom Patch teleports are available.<br>- Allows you to always pass through stick traps succesfully.
param=cheevo_icon,"shields,94"
param=cheevo_meta_list,cheevo_tirannwn_hard
param=cheevo_meta_list_type,0
param=cheevo_is_meta,1
param=cheevo_unique_id,1323
param=cheevo_meta_id,1702
param=cheevo_runescore,15

