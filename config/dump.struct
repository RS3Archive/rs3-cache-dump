// 25640
[6awe2_weekly_choice_1]
param=6awe2_weekly_choice_desc,Choose who we should focus on recruiting:
param=6awe2_weekly_choice_option_text_1,A mix of fighters and supporters.<br>Balanced recruiting.
param=6awe2_weekly_choice_option_bodyguards_1,1
param=6awe2_weekly_choice_option_ambushers_1,1
param=6awe2_weekly_choice_option_followers_1,1
param=6awe2_weekly_choice_option_morale_1,1
param=6awe2_weekly_choice_option_text_2,Fanatics and sympathisers.<br>Focus on ambushers and battle-mages.
param=6awe2_weekly_choice_option_bodyguards_2,0
param=6awe2_weekly_choice_option_ambushers_2,2
param=6awe2_weekly_choice_option_followers_2,2
param=6awe2_weekly_choice_option_morale_2,0
param=6awe2_weekly_choice_option_text_3,All we can get, regardless of skill.<br>Greater recruitment at a cost to morale.
param=6awe2_weekly_choice_option_bodyguards_3,2
param=6awe2_weekly_choice_option_ambushers_3,2
param=6awe2_weekly_choice_option_followers_3,2
param=6awe2_weekly_choice_option_morale_3,-2
param=6awe2_weekly_choice_option_text_4,Cooks, workers, healers, etc.<br>Large increase in morale.
param=6awe2_weekly_choice_option_bodyguards_4,0
param=6awe2_weekly_choice_option_ambushers_4,0
param=6awe2_weekly_choice_option_followers_4,0
param=6awe2_weekly_choice_option_morale_4,4

// 25641
[6awe2_weekly_choice_2]
param=6awe2_weekly_choice_desc,Where should we send our recruiters?
param=6awe2_weekly_choice_option_text_1,The city of Falador.<br>More bodyguards but no ambushers.
param=6awe2_weekly_choice_option_bodyguards_1,2
param=6awe2_weekly_choice_option_ambushers_1,0
param=6awe2_weekly_choice_option_followers_1,1
param=6awe2_weekly_choice_option_morale_1,1
param=6awe2_weekly_choice_option_text_2,Varrock's slums.<br>More ambushers but no morale gain.
param=6awe2_weekly_choice_option_bodyguards_2,1
param=6awe2_weekly_choice_option_ambushers_2,2
param=6awe2_weekly_choice_option_followers_2,1
param=6awe2_weekly_choice_option_morale_2,0
param=6awe2_weekly_choice_option_text_3,Villages such as Catherby.<br>More battle-mages but no ambushers.
param=6awe2_weekly_choice_option_bodyguards_3,1
param=6awe2_weekly_choice_option_ambushers_3,0
param=6awe2_weekly_choice_option_followers_3,2
param=6awe2_weekly_choice_option_morale_3,1
param=6awe2_weekly_choice_option_text_4,Ardougne and its marketplace.<br>More morale but no battle-mages.
param=6awe2_weekly_choice_option_bodyguards_4,1
param=6awe2_weekly_choice_option_ambushers_4,1
param=6awe2_weekly_choice_option_followers_4,0
param=6awe2_weekly_choice_option_morale_4,2

// 25642
[6awe2_weekly_choice_3]
param=6awe2_weekly_choice_desc,What recruitment tactics should we employ this week?
param=6awe2_weekly_choice_option_text_1,Hire mercenaries.<br>Focus on ambushers and bodyguards at a cost to morale.
param=6awe2_weekly_choice_option_bodyguards_1,2
param=6awe2_weekly_choice_option_ambushers_1,3
param=6awe2_weekly_choice_option_followers_1,0
param=6awe2_weekly_choice_option_morale_1,-1
param=6awe2_weekly_choice_option_text_2,Appeal to the people's fervour.<br>Battle-mages and a morale boost.
param=6awe2_weekly_choice_option_bodyguards_2,0
param=6awe2_weekly_choice_option_ambushers_2,0
param=6awe2_weekly_choice_option_followers_2,2
param=6awe2_weekly_choice_option_morale_2,2
param=6awe2_weekly_choice_option_text_3,Offer a sign-up bounty to volunteers.<br>Bodyguards and ambushers with a small morale boost.
param=6awe2_weekly_choice_option_bodyguards_3,2
param=6awe2_weekly_choice_option_ambushers_3,1
param=6awe2_weekly_choice_option_followers_3,0
param=6awe2_weekly_choice_option_morale_3,1
param=6awe2_weekly_choice_option_text_4,Send out press gangs.<br>Even recruitment at a high cost to morale.
param=6awe2_weekly_choice_option_bodyguards_4,2
param=6awe2_weekly_choice_option_ambushers_4,2
param=6awe2_weekly_choice_option_followers_4,2
param=6awe2_weekly_choice_option_morale_4,-2

// 25643
[6awe2_weekly_choice_4]
param=6awe2_weekly_choice_desc,What institutions are ripe for recruiting from?
param=6awe2_weekly_choice_option_text_1,Prisons - bail out inmates.<br>Many bodyguards and other recruits at a cost to morale.
param=6awe2_weekly_choice_option_bodyguards_1,4
param=6awe2_weekly_choice_option_ambushers_1,1
param=6awe2_weekly_choice_option_followers_1,1
param=6awe2_weekly_choice_option_morale_1,-2
param=6awe2_weekly_choice_option_text_2,The Wizards' Guild - recruit wizards.<br>A high number of battle-mages.
param=6awe2_weekly_choice_option_bodyguards_2,0
param=6awe2_weekly_choice_option_ambushers_2,0
param=6awe2_weekly_choice_option_followers_2,4
param=6awe2_weekly_choice_option_morale_2,0
param=6awe2_weekly_choice_option_text_3,Workshops - entice apprentices away.<br>A broad range of recruits.
param=6awe2_weekly_choice_option_bodyguards_3,2
param=6awe2_weekly_choice_option_ambushers_3,1
param=6awe2_weekly_choice_option_followers_3,1
param=6awe2_weekly_choice_option_morale_3,0
param=6awe2_weekly_choice_option_text_4,The Duel Arena - pick the best.<br>A smaller number of ambushers with high morale.
param=6awe2_weekly_choice_option_bodyguards_4,0
param=6awe2_weekly_choice_option_ambushers_4,2
param=6awe2_weekly_choice_option_followers_4,0
param=6awe2_weekly_choice_option_morale_4,2

// 25644
[6awe2_weekly_choice_5]
param=6awe2_weekly_choice_desc,How should we focus on training those raw recruits not yet given a task?
param=6awe2_weekly_choice_option_text_1,Attack and offence.<br>Large numbers of ambushers with some bodyguards.
param=6awe2_weekly_choice_option_bodyguards_1,1
param=6awe2_weekly_choice_option_ambushers_1,3
param=6awe2_weekly_choice_option_followers_1,0
param=6awe2_weekly_choice_option_morale_1,0
param=6awe2_weekly_choice_option_text_2,Defence and protection.<br>Large numbers of bodyguards with a small morale boost.
param=6awe2_weekly_choice_option_bodyguards_2,3
param=6awe2_weekly_choice_option_ambushers_2,0
param=6awe2_weekly_choice_option_followers_2,0
param=6awe2_weekly_choice_option_morale_2,1
param=6awe2_weekly_choice_option_text_3,Logistics and provision.<br>Large numbers of battle-mages with some ambushers.
param=6awe2_weekly_choice_option_bodyguards_3,0
param=6awe2_weekly_choice_option_ambushers_3,1
param=6awe2_weekly_choice_option_followers_3,3
