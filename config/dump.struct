// 20344
[struct_20344]
param=param_3418,Two crafters, each with a wife and child, have lost their homes in the destruction. There is a damaged house in Lumbridge which could be restored.
param=param_3419,Restore the house, moving the Zamorakian herbalist in.
param=param_3420,Restore the house, moving the Saradominist summoner in.
param=param_3421,Restore the house as a refugee shelter, moving both families in.
param=param_3422,Leave the house alone.
param=param_3423,20000
param=param_3424,20000
param=param_3425,40000
param=param_3426,0

// 20345
[struct_20345]
param=param_3418,We could expand our private army to help in the defence of Lumbridge, in case the fighting spills from the crater.
param=param_3419,Recruit more guardsmen.
param=param_3420,Form a people's militia.
param=param_3421,Legitimise the Thieves' Guild in exchange for aid in battle.
param=param_3422,Do not take any action.
param=param_3423,30000
param=param_3424,15000
param=param_3425,15000
param=param_3426,0

// 20346
[struct_20346]
param=param_3418,We could request aid from our political allies in other cities.
param=param_3419,Ask assistance from the White Knights in Falador.
param=param_3420,Ask assistance from the politically neutral Varrock.
param=param_3421,Send a delegation to Al Kharid.
param=param_3422,Do not ask for anyone's help.
param=param_3423,10000
param=param_3424,10000
param=param_3425,25000
param=param_3426,0

// 20347
[struct_20347]
param=param_3418,Our guardsmen are not currently up to the task of facing the knights and beasts if they leave the battlefield.
param=param_3419,Improve their weapons.
param=param_3420,Train them at the Combat Academy.
param=param_3421,Do both of these.
param=param_3422,Do not take any action.
param=param_3423,20000
param=param_3424,25000
param=param_3425,45000
param=param_3426,0

// 20348
[struct_20348]
param=param_3418,Should we request magical protection for the town and castle?
param=param_3419,Bring in ZMI mages.
param=param_3420,Ask the druids for wardsmen.
param=param_3421,Ask Papa Mambo for help.
param=param_3422,Do not get anyone involved.
param=param_3423,10000
param=param_3424,10000
param=param_3425,20000
param=param_3426,0

// 20349
[struct_20349]
param=param_3418,A famous trainer offers us his services to train war beasts to guard Lumbridge.
param=param_3419,Train guard dogs.
param=param_3420,Train guard rats.
param=param_3421,Train guard spiders.
param=param_3422,Refuse his services.
param=param_3423,20000
param=param_3424,15000
param=param_3425,25000
param=param_3426,0

// 20350
[struct_20350]
param=param_3418,The graveyard south of Lumbridge is becoming overfull due to the carnage on the battlefield.
param=param_3419,Expand with additional grave plots.
param=param_3420,Expand with a mass grave.
param=param_3421,Expand with a mass grave, and bring in a priest to bless it.
param=param_3422,Inter the bodies in the catacombs.
param=param_3423,25000
param=param_3424,5000
param=param_3425,15000
param=param_3426,0

// 20351
[struct_20351]
param=param_3418,The battle is coming to a head. If we have any spare money, we could consider aiding one or other side.
param=param_3419,Send aid to Saradomin.
param=param_3420,Send aid to Zamorak.
param=param_3421,Send aid to both sides equally.
param=param_3422,Spend the money on food aid for Lumbridge.
param=param_3423,1
param=param_3424,1
param=param_3425,1
param=param_3426,1

