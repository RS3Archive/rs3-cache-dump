param=dom_boss_npc_combat_1,dom_bouncer_combat
param=dom_npc_spawn_npc1_x,37
param=dom_npc_spawn_npc1_z,31
param=dom_arena_type,3
param=dom_boss_desc,The most brutal guard dog of all time. If his red eyes and horns wouldn't worry a burglar, not much else probably could!<br><br><col=F5B241>Quest</col>: Fight Arena<br><br><col=F5B241>Combat</col>: Woof! Attacks with melee combat, close range. You could get up close and kill him quickly, or stay a safe distance to conserve health.
param=dom_boss_1_taunt,Grrr
param=dom_boss_taunt_sound_english,wolf_attack_mik_7
param=dom_boss_taunt_sound_german,wolf_attack_mik_7
param=dom_boss_taunt_sound_french,wolf_attack_mik_7
param=dom_boss_taunt_sound_portuguese,wolf_attack_mik_7
param=dom_battle_total_lifepoints,11000
param=dom_boss_spline_size,0
param=dom_boss_thumbnail,aif_dom_bouncer

// 2781
[dom_boss_koschei_the_deathless]
param=dom_boss_name,Koschei the Deathless
