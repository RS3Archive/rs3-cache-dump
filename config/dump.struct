// 45781
[struct_45781]
param=param_4832,TzKal-Zuk
param=param_4833,Fighting as Ful's champion, TzKal-Zuk awaits a challenger worthy to take him on.
param=param_4835,seq_34491

// 45782
[struct_45782]
param=param_4832,Quake
param=param_4833,TzKal-Zuk's connection to the earth around him causes a series of small-scale earthquakes. Remaining close to a quake's location will apply the <col=FFFFFF>Armour Break</col> debuff and cause a <col=FFFFFF>Geothermal Burn</col>.
param=param_4835,seq_34496
param=param_4836,seq_34541

// 45783
[struct_45783]
param=param_4832,Dismember
param=param_4833,TzKal-Zuk will thrust his sword into the player, causing a <col=FFFFFF>Geothermal Burn</col>.
param=param_4835,seq_34497
param=param_4836,seq_34540

// 45784
[struct_45784]
param=param_4832,Sear
param=param_4833,TzKal-Zuk inflicts a searing pain that starts to reduce the target player's maximum life points.
param=param_4835,seq_34498
param=param_4836,seq_34539

// 45785
[struct_45785]
param=param_4832,Empowered Magic
param=param_4833,TzKal-Zuk slams his target with an empowered hit for typeless damage.
param=param_4835,seq_34499

// 45786
[struct_45786]
param=param_4832,Hard Mode - Wall of Flames
param=param_4833,TzKal-Zuk splits the room in two with a massive wall of flames.

// 45787
[struct_45787]
param=param_4832,Hard Mode - Igneous Bomb
param=param_4833,TzKal-Zuk will cast a powerful magic attack and launch it toward his target for large damage upon impact. The target area will be engulfed in flames for a short period of time.
param=param_4835,seq_34499

// 45788
[struct_45788]
param=param_4832,Hard Mode - Conduit of Ful
param=param_4833,TzKal-Zuk draws forth a Conduit of Ful which begins to heat up the room. Using this heat source, TzKal-Zuk will cast <col=FFFFFF>Igneous Bomb</col> at the target player. Severing TzKal-Zuk's connection with the Conduit will cause him to stagger and take <col=FFFFFF>20,000</col> damage. In retaliation, TzKal-Zuk will send a massive attack back toward the target player.<br>Each time the target player severs the connection, TzKal-Zuk will become more enraged, casting <col=FFFFFF>Igneous Bomb</col> at a faster rate.

// 45789
[struct_45789]
param=param_4832,Igneous Rain
param=param_4833,TzKal-Zuk locks down sections of the arena and summons forth igneous creature as he channels.<br><br>Dealing with each igneous creature will charge the player, allowing them to stagger TzKal-Zuk as he charges his explosion.
param=param_4835,seq_34501
param=param_4836,seq_34533

