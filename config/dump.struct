param=slayer_description,You can find the creatures of the lost grove within the lost grove, south of the poison waste.
param=slayer_sl_req,104
param=slayer_example_npc,nature_beings_dummy_creature

// 50968
[slayer_morvran_list_entry_49]
param=slayer_name,stalker creatures
param=slayer_type,160
param=slayer_description,You can find stalker creatures within Zamorak's hideout.
param=slayer_sl_req,71
param=slayer_example_npc,stalker_soulgazer

// 50969
[slayer_morvran_list_entry_50]
param=slayer_name,Nodon dragonkin
param=slayer_type,179
param=slayer_description,Nodon dragonkin are deeply intelligent creatures, armed with advanced siege weaponry. However, they are weak to dragonbane weapons. You can find them fighting for Jas in Senntisten.
param=slayer_sl_req,92
param=slayer_example_npc,egwd_jas_slayer_nodon_melee

// 50970
[slayer_morvran_list_entry_51]
param=slayer_name,Profane Scabarites
param=slayer_type,192
param=slayer_description,Profane scabarites are insect-like creatures that have abandoned their beliefs. They are causing issues for people of the desert. You will find them near the river Elid.
param=slayer_sl_req,87
param=slayer_example_npc,profane_scabarite

// 50971
[slayer_mandrith_list_entry_1]
param=slayer_name,Abyssal demons
param=slayer_type,180
param=slayer_description,Abyssal demons are nasty creatures to deal with. They aren't really part of this realm and are able to move very quickly to trap their prey. They can be found south of the Lava Maze.
param=slayer_sl_req,85
param=slayer_example_npc,slayer_abyssal

// 50972
[slayer_mandrith_list_entry_2]
param=slayer_name,gargoyles
param=slayer_type,46
param=slayer_description,Gargoyles are winged creatures of stone. You'll need to fight them until they are close to death before breaking them apart with a rock hammer. They can be found in the eastern ruins, north of the Graveyard of Shadows.
param=slayer_sl_req,75
param=slayer_example_npc,slayer_gargoyle_1

// 50973
