param=dom_arena_type,2
param=dom_boss_desc,Wouldn't it be great if you were in an arena full of bosses and your best route to victory was to blow them to smithereens with a load of power-ups? That'd show them who was boss!<br><br><col=F5B241>Combat</col>: You aren't allowed to go into this fight with any weapons or armour. The arena floor will be littered with the bomb power ups.<br><br>You will then be surrounded by various lower level boss monsters: Solus Dellagar, Delrith, Count Draynor, Melzar the Mad, Sigmund, Tarn Razorlor, Draugen, The Kendal, Tumeken's Shadow, Culinaromancer, Elvarg, Treus Dayth.<br><br>You have to kill them all ONLY using the powerups (and perhaps your fists if you're so inclined). The bombs will deal more damage than normal whilst in this match! If you wish, you can use Silverlight, the ancient mace, the hammer and stake to finish off Delrith, Sigmund and Count Draynor respectively (weapons supplied in the arena).<br><br>These are the only weapons you can wield in the battle. There are no other handicaps applied in this battle.<br><br><col=F5B241>Quests required to play</col>: Wanted, Demon Slayer, Vampyre Slayer, Dragon Slayer, Chosen Commander, Lair of Tarn Razorlor, Fremennik Trials, Mountain Daughter, Recipe for Disaster and Missing My Mummy.
param=dom_boss_1_taunt,You're fish food, mate
param=dom_boss_2_taunt,Grrr.
param=dom_boss_3_taunt,You can never defeat me.
param=dom_boss_4_taunt,Let me drink my tea in peace!
param=dom_boss_5_taunt,You're as good as dead already.
param=dom_boss_6_taunt,Kill, destroy!
param=dom_boss_7_taunt,Face your death.
param=dom_boss_8_taunt,Growl!
param=dom_boss_9_taunt,I hate the living. Die!
param=dom_boss_10_taunt,I'm hungry.
param=dom_boss_11_taunt,Roar.
param=dom_boss_12_taunt,Break his legs.
param=dom_boss_taunt_sound_english,eat_powerup_taunt
param=dom_boss_taunt_sound_german,eat_powerup_taunt
param=dom_boss_taunt_sound_french,eat_powerup_taunt
param=dom_boss_taunt_sound_portuguese,eat_powerup_taunt
param=dom_battle_total_lifepoints,64720
param=dom_boss_spline_size,1

