// 36728
[cheevo_atdes_easy_reward]
param=cheevo_name,Desert Set Tasks - Easy
param=cheevo_details,Given by Grand Vizier Hassan in either Al Kharid Palace or Menaphos Merchant District for completing all Easy Tasks in the Kharidian desert.
param=cheevo_icon,"shields,60"
param=cheevo_meta_list,cheevo_desert_list_easy
param=cheevo_meta_list_type,0
param=cheevo_rewards,Desert amulet 1 and a magic lamp worth 2,000 XP in a skill of your choice.<br>A daily bag of lost & found items from a rug merchant.<br>Sparkly dung kalphites drop double loot.<br>2% cheaper prices in the pizazz store.<br>Double water from cacti.
param=cheevo_is_meta,1
param=cheevo_unique_id,1313
param=cheevo_meta_id,1702
param=cheevo_runescore,5

// 36729
[cheevo_atdes_medium_reward]
param=cheevo_name,Desert Set Tasks - Medium
param=cheevo_details,Given by Zahur in Nardah for completing all Medium Tasks in the Kharidian desert.
param=cheevo_icon,"shields,61"
param=cheevo_meta_list,cheevo_desert_list_medium
param=cheevo_meta_list_type,0
param=cheevo_rewards,Desert amulet 2 and a magic lamp worth 8,000 XP in a skill of your choice. 140 noted potato cacti per week, claimed from the Weird Old Man.<br>The amulet gains the following benefits:<br>- Goats have chance to drop noted goat horn.<br>- Unlimited teleport to Nardah.<br>- Ability to create 50 molten glass with only pot ash while outside in the desert.<br>- Reduced failure rate on the Agility Pyramid.<br>- 5% cheaper prices in the pizazz store and a second teak tree near Uzer.
param=cheevo_is_meta,1
param=cheevo_unique_id,1314
param=cheevo_meta_id,1702
param=cheevo_runescore,10

// 36730
[cheevo_atdes_hard_reward]
param=cheevo_name,Desert Set Tasks - Hard
param=cheevo_details,Given by Hakeem the Mayor in Pollnivneach for completing all Hard Tasks in the Kharidian desert.
param=cheevo_icon,"shields,62"
param=cheevo_meta_list,cheevo_desert_list_hard
param=cheevo_meta_list_type,0
param=cheevo_rewards,Desert amulet 3 and a magic lamp worth 20,000 XP in a skill of your choice. 210 noted potato cacti per week, claimed from the Weird Old Man.<br>10% cheaper prices in the pizazz store.<br>Double charges from artefacts when recharging the Sceptre of the Gods.<br>Cactus patches in the desert will be protected from disease and you'll get double the spines.<br>Half the chance of mummies and scarabs spawning in Pyramid Plunder.<br>The Keris has a greater chance to score a vicious blow.<br>The amulet can now produce a total of 100 molten glass per day.
param=cheevo_is_meta,1
param=cheevo_unique_id,1315
param=cheevo_meta_id,1702
param=cheevo_runescore,15

// 36731
[cheevo_atdes_elite_reward]
param=cheevo_name,Desert Set Tasks - Elite
param=cheevo_details,Given by the Golem in Uzer for completing all Elite Tasks in the Kharidian desert.
param=cheevo_icon,"shields,63"
param=cheevo_meta_list,cheevo_desert_list_elite
param=cheevo_meta_list_type,0
param=cheevo_rewards,Desert amulet 4 and 4 magic lamps, worth a total of 160,000 XP in skills of your choice. 280 noted potato cacti per week, claimed from the Weird Old Man.<br>Opportunity to reroll your Dominion Tower chest rewards.<br>20% Chance of making 4-dose super antifire pots.<br>Two feathers at once from the Phoenix.<br>Boosted stats on the ancient staff.<br>Granite buyer at the quarry and a new sandstone rock on the coast near Sophanem.<br>The amulet can now produce a total of 150 molten glass per day.
param=cheevo_is_meta,1
param=cheevo_unique_id,1316
param=cheevo_meta_id,1702
param=cheevo_runescore,25

