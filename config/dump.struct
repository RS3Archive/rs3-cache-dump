[cbtv2va_course_ability_effects]
param=cbtv2ca_course_name,(Advanced) Ability Effects
param=cbtv2ca_course_description,Learn how abilities can affect your opponent in more ways than just damage.<br><br>Demonstration:<br>Kill waves of skeletons.<br><br>Hover over the rank icons to see completion requirements.
param=cbtv2ca_course_gold,#1 Legend Rank<br><br>Kill all the skeletons using multiple ability effects.
param=cbtv2ca_course_silver,#2 Hero Rank<br><br>Kill all the skeletons using an ability effect.
param=cbtv2ca_course_bronze,#3 Champion Rank<br><br>Kill all the skeletons.
param=cbtv2ca_course_label,storablelabel_1
