// 44071
[cheevo_path_lumbridge_catacombs_enter]
param=cheevo_name,Lumbridge Catacombs
param=cheevo_icon,"quest_icons_large,15"
param=cheevo_unique_id,2601
param=cheevo_details,Delve into Dragith Nurn's tomb beneath the Lumbridge cemetery.
param=task_step_1_arrow,0_62_86_4_49
param=task_step_1,<col=0xF0BE79>Enter</col> the <col=0xF0BE79>catacombs</col> in the <col=0xF0BE79>Lumbridge cemetery</col>.
param=task_step_2,<col=0xF0BE79>Climb down</col> the <col=0xF0BE79>stairs</col> in the entryway.
param=task_step_3,<col=0xF0BE79>Climb down</col> the <col=0xF0BE79>stairs</col> in Dragith Nurn's tomb, and descend into the lower catacombs.
param=task_information,The catacombs are filled with all kinds of critters for you to increase your combat proficiency and get loot.<br>Collect the <col=0xF0BE79>6 demon statuettes</col> and sell them to <col=0xF0BE79>Xenia</col>/Ilona.<br>Defeat the necromancer <col=0xF0BE79>Dragith Nurn</col> and reunite the <col=0xF0BE79>5 lost pieces of his broken mask</col>.
param=task_requirement_1_type,61
param=task_requirement_1_value,170
param=cheevo_game,1
param=task_optional,1
param=cheevo_popup,false

// 44072
[cheevo_path_lumbridge_catacombs_mask_1]
param=cheevo_name,Mask Part 1
param=cheevo_icon,"quest_icons_large,15"
param=cheevo_unique_id,4083
param=cheevo_details,Defeat warped cockroaches in Lumbridge Catacombs.
param=task_step_1_arrow,0_62_86_4_49
param=task_step_1,They can drop the first part of the Mask of Dragith Nurn.
param=task_step_2,Monsters usually drop items which you can sell, use or craft.
param=task_information,When your backpack is full, you can bank what you want to keep at the Lumbridge Combat Academy or sell them to the Lumbridge General Store, north of the Lumbridge lodestone.
param=task_requirement_1_type,61
param=task_requirement_1_value,170
param=cheevo_game,1
param=task_optional,1
param=cheevo_popup,false

// 44073
[cheevo_path_lumbridge_catacombs_mask_2]
param=cheevo_name,Mask Part 2
param=cheevo_icon,"quest_icons_large,15"
param=cheevo_unique_id,4084
param=cheevo_details,Defeat corpse spiders (room 2) or warped flies (room 3) in Lumbridge Catacombs.
param=task_step_1_arrow,0_62_86_21_44
param=task_step_1,They can drop the second part of the Mask of Dragith Nurn.
param=task_step_2,If your combat level is too low to target an enemy, practice on lower-level enemies like warped cockroaches.
param=task_information,Right-click an enemy to see their combat level. If it's green their combat level is close to yours. If their combat level is orange or red, the monster's combat level is higher than yours, and could be a difficult fight.
param=task_information_mobile,Long-press an enemy to see their combat level. If it's green their combat level is close to yours. If their combat level is orange or red, the monster's combat level is higher than yours, and could be a difficult fight.
param=task_requirement_1_type,61
param=task_requirement_1_value,170
param=cheevo_game,1
param=task_optional,1
param=cheevo_popup,false

