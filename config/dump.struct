// 38107
[cheevo_path_equip_staff]
param=cheevo_name,Just Can't Get the Staff
param=cheevo_details,Equip a staff while wearing magic armour, with air runes in your backpack.
param=cheevo_icon,"staticons_high_res_clean,5"
param=cheevo_unique_id,371
param=task_step_1_arrow,0_45_55_8_4
param=task_step_1,Get <col=0xF0BE79>air runes</col> by <col=0xF0BE79>runecrafting</col> at the <col=0xF0BE79>air altar</col>, or <col=0xF0BE79>trade with Apprentice Clara</col> in the <col=0xF0BE79>Burthorpe</col> Runecrafting shop.
param=task_step_2,Get a <col=0xF0BE79>staff</col>. (Defeating Caitlin during the <col=0xF0BE79>Blood Pact quest</col> will drop her staff for you.)
param=task_step_3,Get magic armour, such as a <col=0xF0BE79>wizard hat</col>, <col=0xF0BE79>wizard robes</col> or <col=0xF0BE79>spellstorm drape</col>. (You can defeat enemies (such as <col=0xF0BE79>white wolves</col> and <col=0xF0BE79>trolls</col> in <col=0xF0BE79>Burthorpe</col>, or <col=0xF0BE79>spellwisps</col> outside the <col=0xF0BE79>Wizards' Tower</col>, or purchase it from the <col=0xF0BE79>Grand Exchange</col> or <col=0xF0BE79>Thessalia's Fine Clothes</col> in <col=0xF0BE79>Varrock</col>.)
param=task_step_4,Open your <col=0xF0BE79>backpack</col> by left-clicking the helmet/satchel icon on your ribbon menu.
param=task_step_4_mobile,Open your <col=0xF0BE79>backpack</col> by tapping the helmet/satchel icon on your ribbon menu.
param=task_step_5,Left-click any <col=0xF0BE79>magic armour</col> in your <col=0xF0BE79>backpack</col> to wear it.
param=task_step_5_mobile,Tap any <col=0xF0BE79>magic armour</col> in your <col=0xF0BE79>backpack</col> to wear it.
param=task_step_6,Left-click the <col=0xF0BE79>staff</col> in your <col=0xF0BE79>backpack</col> to wield it.
param=task_step_6_mobile,Tap the <col=0xF0BE79>staff</col> in your <col=0xF0BE79>backpack</col> to wield it.
param=task_information,Some staves provide an infinite supply of a rune needed to cast certain spells.<br>eg Caitlyn's staff gives you unlimited air runes, and a mindspike or staff of fire gives unlimited fire runes.
param=cheevo_game,1
param=task_optional,1
param=cheevo_popup,false

// 38108
[cheevo_path_cast_airstrike]
param=cheevo_name,Death From Above
param=cheevo_details,Cast Air Strike at a dummy or a hostile target.
param=cheevo_icon,"staticons_high_res_clean,5"
param=cheevo_unique_id,376
param=task_step_1_arrow,0_45_55_49_35
param=task_step_1,To cast <col=0xF0BE79>Air Strike</col>, you will need to wield a magic weapon and <col=0xF0BE79>air runes</col>. (You can <col=0xF0BE79>trade with Apprentice Clara</col> in the <col=0xF0BE79>Burthorpe</col> Runecrafting shop to get limited free runes, or runecraft them yourself.)
param=task_step_2,Open your <col=0xF0BE79>(Combat) Magic Spellbook</col> and left-click the <col=0xF0BE79>Air Strike</col> icon to set it as your auto-cast spell.
param=task_step_2_mobile,Open your <col=0xF0BE79>(Combat) Magic Spellbook</col> and tap the <col=0xF0BE79>Air Strike</col> icon to set it as your auto-cast spell.
param=task_step_3,<col=0xF0BE79>Attack</col> a suitable target to cast the spell at it.
param=task_step_4,You can keep using the spell as your attack as long as you have runes.
param=task_information,Air Strike is your first attack spell; as you gain levels in Magic you can unlock more powerful variants.<br>As you increase your Magic level, you will unlock access to new spells and abilities, such as Confuse, enchanting, teleports, and alchemy.
param=cheevo_game,1
param=task_optional,1
param=cheevo_popup,false

