param=param_6411,Build a plant in the garden of your house.
param=param_6412,"staticons_high_res2_clean,6"
param=param_6413,3431
param=param_1282,0_46_50_8_25
param=param_1274,Buy at least one <col=0xFFCB05>bagged plant 1</col> from <col=0xFFCB05>Alfred Stonemason's Construction Shop</col>.
param=param_1275,You will also need a <col=0xFFCB05>watering can</col> with water in it.
param=param_1276,Visit your house in <col=0xFFCB05>Building Mode</col> via the <col=0xFFCB05>house portal</col>.
param=param_1277,<col=0xFFCB05>Right-click</col> a <col=0xFFCB05>plant hotspot</col> in your <col=0xFFCB05>garden</col> and choose to <col=0xFFCB05>build</col> it.
param=param_8085,<col=0xFFCB05>Long-press</col> a <col=0xFFCB05>plant hotspot</col> in your <col=0xFFCB05>garden</col> and choose to <col=0xFFCB05>build</col> it.
param=param_1278,If you have 5 Construction or more, you can also buy <col=0xFFCB05>bagged dead tree</col> and plant it at a <col=0xFFCB05>tree hotspot</col>.
param=param_2225,The Garden Centre in Falador Park sells more impressive plants for you to add to your house, if your Construction level is high enough.
param=param_6415,1
param=param_1322,1
param=param_8169,true

