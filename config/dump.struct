// 24412
[hlm_wyvern_crossbow_effect]
param=combatv2_ability_info,50% chance to deal 6 hits of 10-24 poison damage over 7.2 seconds. Each additional activation within this timeframe restarts the effect and increases its damage, capping at 125-249 damage per hit.
param=combatv2_ability_info_onhit_activation,1

