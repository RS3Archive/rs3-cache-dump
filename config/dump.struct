// 40923
[skillcape_perks_info_slayer_master]
param=combatv2_ability_info,Provides the ability to teleport to available Slayer masters.<br>Provides a chance to select your next task from Slayer masters.

// 40924
[skillcape_perks_info_invention_master]
param=combatv2_ability_info,Provides bonus charge drain rate reduction.<br>Provides an increased chance of receiving components when disassembling.

// 40925
[skillcape_perks_info_dungeoneering_master]
param=combatv2_ability_info,Provides teleports to available resource dungeons and the cape can be equipped within Daemonheim.<br>Provides a chance to choose the next boss you face and increases the chance of receiving lore related drops.

// 40926
[skillcape_perks_info_qp_master]
param=combatv2_ability_info,Extended duration in the Tears of Guthix minigame.<br>Provides teleports to locations around Gielinor.

// 40927
[cheevo_path_saw_planks]
param=cheevo_name,A Cunning Plank
param=cheevo_details,Get the plank maker in Rimmington to saw logs into planks.
param=cheevo_icon,"staticons_high_res2_clean,6"
param=cheevo_unique_id,3428
param=task_step_1_arrow,0_46_50_10_31
param=task_step_1,Get some <col=0xF0BE79>logs</col> by chopping down a <col=0xF0BE79>tree</col> and <col=0xF0BE79>100 coins</col> per plank.
param=task_step_2,<col=0xF0BE79>Buy planks</col> from the <col=0xF0BE79>plank maker</col>.
param=task_information,You need planks to construct furniture in your house.
param=cheevo_game,1
param=task_optional,1
param=cheevo_popup,true

// 40928
[cheevo_path_enter_house]
param=cheevo_name,Under Construction
param=cheevo_details,Visit your house in Building Mode.
param=cheevo_icon,"staticons_high_res2_clean,6"
param=cheevo_unique_id,3429
param=task_step_1_arrow,0_46_50_8_25
param=task_step_1,Buy a house (see the <col=0xF0BE79>Unreal Estate, Man</col> achievement).
param=task_step_2,It's recommended you bring <col=0xF0BE79>at least 8 planks</col>, <col=0xF0BE79>at least 2 bolt of cloth</col> and <col=0xF0BE79>at least 30 nails</col>.
param=task_step_3,Visit your house in <col=0xF0BE79>Building Mode</col> via the <col=0xF0BE79>house portal</col>. (If your house is in Burthorpe, follow this guidance arrow.)
param=task_information,<col=0xF0BE79>Bronze nails</col> and can be smithed from a single <col=0xF0BE79>bronze bar</col> with at least <col=0xF0BE79>4 Smithing</col> or purchased (along with <col=0xF0BE79>bolts of cloth</col>) from <col=0xF0BE79>Alfred Stonemason's Construction Shop</col>. <col=0xF0BE79>Bring extra nails</col> in case some are wasted.
param=cheevo_game,1
param=task_optional,1
param=cheevo_popup,true

// 40929
[cheevo_path_remove_furniture]
param=cheevo_name,Furniture Removal
param=cheevo_details,Remove an item of furniture that you have built in your house.
param=cheevo_icon,"staticons_high_res2_clean,6"
param=cheevo_unique_id,3432
param=task_step_1_arrow,0_46_50_8_25
param=task_step_1,Visit your house in <col=0xF0BE79>Building Mode</col> via the <col=0xF0BE79>house portal</col>.
param=task_step_2,<col=0xF0BE79>Right-click</col> furniture you've built in your house, such as a <col=0xF0BE79>crude wooden chair</col> in your <col=0xF0BE79>parlour</col>, and choose to <col=0xF0BE79>remove</col> it.
param=task_step_2_mobile,<col=0xF0BE79>Long-press</col> furniture you've built in your house, such as a <col=0xF0BE79>crude wooden chair</col> in your <col=0xF0BE79>parlour</col>, and choose to <col=0xF0BE79>remove</col> it.
param=task_information,It's a good idea to remove furniture and replace it with superior items as your Construction level increases.
param=cheevo_game,1
param=task_optional,1
param=cheevo_popup,true

// 40930
[cheevo_path_build_cloth]
param=cheevo_name,It's Curtains For You
param=cheevo_details,Build a rug or curtain in the parlour of your house.
param=cheevo_icon,"staticons_high_res2_clean,6"
param=cheevo_unique_id,3430
param=task_step_1_arrow,0_46_50_8_25
param=task_step_1,If you don't yet have <col=0xF0BE79>level 2 Construction</col>, build furniture in your house to earn Construction XP.
param=task_step_2,Buy at least <col=0xF0BE79>2 bolt of cloth</col> from <col=0xF0BE79>Alfred Stonemason's Construction Shop</col>.
param=task_step_3,Visit your house in <col=0xF0BE79>Building Mode</col> via the <col=0xF0BE79>house portal</col>.
param=task_step_4,<col=0xF0BE79>Left-click</col> a <col=0xF0BE79>rug</col> or <col=0xF0BE79>curtain</col> hotspot in your <col=0xF0BE79>parlour</col> and choose to <col=0xF0BE79>build</col> it.
param=task_step_4_mobile,<col=0xF0BE79>Tap</col> a <col=0xF0BE79>rug</col> or <col=0xF0BE79>curtain</col> hotspot in your <col=0xF0BE79>parlour</col> and choose to <col=0xF0BE79>build</col> it.
param=task_information,You need <col=0xF0BE79>5 bolt of cloth</col>, <col=0xF0BE79>3 planks</col>, and <col=0xF0BE79>at least 3 nails</col> to build all the cloth furnishings in your parlour.
param=task_requirement_1_type,22
param=task_requirement_1_value,2
param=cheevo_game,1
param=task_optional,1
param=cheevo_popup,true

// 40931
[cheevo_path_build_plant]
param=cheevo_name,Home and Garden
param=cheevo_details,Build a plant in the garden of your house.
param=cheevo_icon,"staticons_high_res2_clean,6"
param=cheevo_unique_id,3431
param=task_step_1_arrow,0_46_50_8_25
param=task_step_1,Buy at least one <col=0xF0BE79>bagged plant 1</col> from <col=0xF0BE79>Alfred Stonemason's Construction Shop</col>.
param=task_step_2,You will also need a <col=0xF0BE79>watering can</col> with water in it.
param=task_step_3,Visit your house in <col=0xF0BE79>Building Mode</col> via the <col=0xF0BE79>house portal</col>.
param=task_step_4,<col=0xF0BE79>Right-click</col> a <col=0xF0BE79>plant hotspot</col> in your <col=0xF0BE79>garden</col> and choose to <col=0xF0BE79>build</col> it.
param=task_step_4_mobile,<col=0xF0BE79>Long-press</col> a <col=0xF0BE79>plant hotspot</col> in your <col=0xF0BE79>garden</col> and choose to <col=0xF0BE79>build</col> it.
param=task_step_5,If you have 5 Construction or more, you can also buy <col=0xF0BE79>bagged dead tree</col> and plant it at a <col=0xF0BE79>tree hotspot</col>.
param=task_information,The Garden Centre in Falador Park sells more impressive plants for you to add to your house, if your Construction level is high enough.
param=cheevo_game,1
param=task_optional,1
param=cheevo_popup,true

