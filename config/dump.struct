param=side_tab_1_icon_highlight,timed_event5_ribbon_icon
param=side_tab_1_icon_selected,timed_event5_ribbon_icon
param=side_tab_1_layer,timed_event:summary_layer
param=side_tab_1_tooltip,Summary
param=timed_event_name,Spring Festival
param=timed_event_long_desc,Guthixian butterflies have returned to Gielinor! Capture them to unlock community benefits including: Spring Tokens, event area XP buffs, and daily butterfly catch limit increases. The total number of butterflies collected by the community is displayed on the progress bar below.<br><br>The druids have been growing a garden in Guthix's honour to the south of the Archaeology Guild, head there to lend a helping hand. You'll find plenty of activities to get involved with, which will earn you XP, and Spring Tokens to spend in Thaerisk's 'Surplus Spring Supplies' shop.
param=timed_event_bg_graphic,easter_2021_background
param=timed_event_transmit_global_var_trh,1
param=timed_event_requires_login_cleanup,false
param=ribbon_override_icon,easter_2021_ribbon_icon

