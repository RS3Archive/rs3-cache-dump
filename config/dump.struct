param=bslay_tactic_new_npc,godwars_bandos_avatar

// 30630
[bslay_graardor_tactics_minions]
param=bslay_tactic_title,Bandosian bodyguards
param=bslay_tactic_text,General Graardor has backup with him in the form of <col=FFFFFF>Sergeant Strongstack, Steelwill</col>, and <col=FFFFFF>Grimspike</col>. Each uses a different combat style, and General Graardor will respawn any dead bodyguards every <col=FFFFFF>30 seconds.
param=bslay_tactic_animation,slice_surface_goblin_squat_ready
param=bslay_tactic_new_npc,godwars_sergeant_goblin1

// 30631
[bslay_graardor_tactics_heal_hm]
param=bslay_tactic_title,Protection stance: <col=DC7800>Hard mode only
param=bslay_tactic_text,The general goes into a defensive stance for <col=FFFFFF>10 seconds</col>. During this stance, the general reflects some of the damage he takes if inflicted from the front.
param=bslay_tactic_animation,tsd_graardor_defend_stance
param=bslay_tactic_new_npc,godwars_bandos_avatar

// 30632
[bslay_graardor_tactics_smash_hm]
param=bslay_tactic_title,Graardor smash: <col=DC7800>Hard mode only
param=bslay_tactic_text,The general smashes his fists into the ground hitting anyone caught for heavy damage. Shortly after the ceiling crumbles down on the targets' locations. Those who can see the collapse risk taking damage from the debris if they are in the vicinity of its fall.
param=bslay_tactic_animation,tsd_graardor_double_ground_punch
param=bslay_tactic_new_npc,godwars_bandos_avatar

// 30633
[bslay_mole_tactics_melee]
param=bslay_tactic_title,Phase 1: Melee attack
param=bslay_tactic_text,The Giant Mole slashes her main target for melee damage.
param=bslay_tactic_animation,mole2_giant_mole_attack
param=bslay_tactic_new_npc,mole2_giant

// 30634
[bslay_mole_tactics_dig]
param=bslay_tactic_title,Burrow
param=bslay_tactic_text,The Giant Mole will burrow into the ground and relocate herself to another area in the environment where she'll re-emerge and continue attacking when found.
param=bslay_tactic_animation,mole2_giant_mole_burrowing
param=bslay_tactic_spotanim,mole2_giant_mole_burrowing_spotanim
param=bslay_tactic_spotanim_model,mtx_demon_teleport_spotanim
param=bslay_tactic_new_npc,mole2_giant

// 30635
[bslay_mole_tactics_floor_aoe]
param=bslay_tactic_title,Phase 2B: Rockfall
param=bslay_tactic_text,The Giant Mole stomps the ground, loosening some of the ceiling. This attack will stun a main target and the mud from above will begin falling on them until they are freed, either by a team-mate or the mole herself.
param=bslay_tactic_animation,mole2_giant_mole_stomp
param=bslay_tactic_spotanim,mole2_giant_mole_stomp_spotanim
param=bslay_tactic_spotanim_model,mole2_giant_mole_stomp_spotanim
param=bslay_tactic_new_npc,mole2_giant

// 30636
[bslay_mole_tactics_berserk]
param=bslay_tactic_title,Phase 2C: Berserk
param=bslay_tactic_text,The Giant Mole goes berserk for <col=FFFFFF>15 seconds</col>. During this time, the mole can be stunned and deals increased damage with increased accuracy.
param=bslay_tactic_animation,mole2_giant_mole_berserk
param=bslay_tactic_spotanim,mole2_giant_mole_berserk_spotanim
param=bslay_tactic_spotanim_model,mole2_giant_mole_berserk_spotanim
param=bslay_tactic_new_npc,mole2_giant_berserk

// 30637
[bslay_mole_tactics_adds]
param=bslay_tactic_title,Phase 2D: Mini-moles!
param=bslay_tactic_text,When the Giant Mole is in the north-western room, she will summon smaller moles to aid her. The Giant Mole gains damage reduction if small moles are alive.
param=bslay_tactic_animation,mole2_baby_mole_idle
param=bslay_tactic_new_npc,mole2_small

// 30638
[bslay_haraken_tactics_standard]
param=bslay_tactic_title,Har-Aken
param=bslay_tactic_text,Har-Aken will emerge from the lava every <col=FFFFFF>30 seconds</col>. While it is visible, it can be attacked. After <col=FFFFFF>30 seconds</col> it will submerge once again.
param=bslay_tactic_animation,tzhaar2_tokhaar_squid_boss_ready
param=bslay_tactic_new_npc,tzkiln_squid_head

// 30639
[bslay_haraken_tactics_tentacles]
param=bslay_tactic_title,Tentacles
param=bslay_tactic_text,While Har-Aken lives, its tentacles will spawn around the platform. These can spawn in <col=FFFFFF>magic</col> or <col=FFFFFF>ranged</col> forms, getting too close will allow them to <col=FFFFFF>melee</col> the target. These should be defeated to keep incoming damage as low as possible.
param=bslay_tactic_animation,tzhaar2_tokhaar_squid_boss_magic_tentacle_melee_attack
param=bslay_tactic_new_npc,tzkiln_tentacle_magic

// 30640
[bslay_kk_tactics_standard_attack]
param=bslay_tactic_title,Standard attacks
param=bslay_tactic_text,The Kalphite King will use abilities in between his special attacks.<br><br>If the Kalphite King is in melee form, he will use: <col=E6DCB4>Dismember, Hurricane Punish, Quake, and <col=E6DCB4>Slaughter.</col><br><br>If the Kalphite King is in Ranged form, he will use: <col=E6DCB4>Binding Shot, Ricochet, Bombardment, Fragmentation Shot, </col> and <col=E6DCB4>Incendiary Shot.</col><br><br>If the Kalphite King is in magic form, he will use: <col=E6DCB4>Wrack, Impact, Combust, Chain</col> and <col=E6DCB4>Wild Magic.</col>
param=bslay_tactic_animation,kk_kalphite_king_attack_melee
param=bslay_tactic_new_npc,kk_king_melee

// 30641
[bslay_kk_tactics_charge]
param=bslay_tactic_title,Charge
param=bslay_tactic_text,The Kalphite King charges forwards in his current direction, hitting all targets caught in his path for heavy damage, or higher damage if he slams them into a wall.
param=bslay_tactic_animation,kk_kalphite_king_charge_a
param=bslay_tactic_new_npc,kk_king_melee

// 30642
[bslay_kk_tactics_beetlejuice]
param=bslay_tactic_title,Beetlejuice
param=bslay_tactic_text,The Kalphite King prepares to kill his main target outright, putting all of their defensive abilities on hold. Another combatant is required to <col=E6DCB4>Provoke</col> the king off of his target and then prepare to soak/avoid the incoming damage themselves through use of <col=E6DCB4>defensive abilities</col>.
param=bslay_tactic_animation,kk_kalphite_king_beetlejuice
param=bslay_tactic_spotanim,kk_kalphite_king_beetlejuice_spotanim
param=bslay_tactic_spotanim_model,kk_kalphite_king_beetlejuice_spotanim
param=bslay_tactic_new_npc,kk_king_melee

// 30643
[bslay_kk_tactics_knockback]
param=bslay_tactic_title,Knockback
param=bslay_tactic_text,The Kalphite King attacks all targets directly in front of him for melee damage and knocks back those who are hit.
param=bslay_tactic_animation,kk_kalphite_king_attack_melee
param=bslay_tactic_new_npc,kk_king_melee

// 30644
[bslay_kk_tactics_burrow]
param=bslay_tactic_title,Burrow
param=bslay_tactic_text,The Kalphite King burrows into the ground and disappears! Shortly after, he'll emerge from the ground where his current target is standing. Any person who is caught when he re-emerges will take large amounts of damage.
param=bslay_tactic_animation,kk_kalphite_king_area_slam_appear
param=bslay_tactic_spotanim,kk_kalphite_king_area_slam_appear_spotanim
param=bslay_tactic_spotanim_model,kk_kalphite_king_area_slam_appear_spotanim
param=bslay_tactic_new_npc,kk_king_melee

// 30645
[bslay_kk_tactics_healingonhit]
param=bslay_tactic_title,Heal & Defensive Tactics
param=bslay_tactic_text,If the Kalphite King is hit with a stunning attack, he will use <col=E6DCB4>Freedom.</col> Having to use freedom will also distract the king, delaying his next attack.<br><br>If the Kalphite King is hit with <col=E6DCB4>Tsunami</col>,<col=E6DCB4>Pulverise</col>, or <col=E6DCB4>Bombardment</col> he may use <col=E6DCB4>Barricade, Immortality,</col> or <col=E6DCB4>Rejuvenate</col>.<br><br>:If the Kalphite King activates a red aura, he will heal himself for all damage he deals.<br><br>If the Kalphite King activates a green aura, he will heal himself for all damage he takes.
param=bslay_tactic_animation,kk_kalphite_king_barricade
param=bslay_tactic_spotanim,kk_kalphite_king_barricade_spotanim
param=bslay_tactic_spotanim_model,kk_kalphite_king_barricade_spotanim
param=bslay_tactic_new_npc,kk_king_melee

// 30646
[bslay_kk_tactics_adds]
param=bslay_tactic_title,Kalphite Guardians
param=bslay_tactic_text,At certain points during the fight, as the Kalphite King lowers in health, he will summon swarms of kalphite guardians, strong magic users that will defend the king with magical attacks. Players standing on the ground where a guardian has burrowed will take melee damage when they surface.
param=bslay_tactic_new_npc,kk_king_guardian_magic
param=bslay_tactic_animation,kk_kalphite_guardian_ready

// 30647
[arch_site_icon_guild_on]
param=rs3tli_button_layer_master_struct,arch_site_icon_guild
param=rs3tli_button_layer_type,1
param=rs3tli_button_graphic,"arch_icon_digsite_guild,0"
param=rs3tli_button_graphic_width,40
param=rs3tli_button_graphic_height,40

// 30648
[bslay_kq_tactics_grounded]
param=bslay_tactic_title,Grounded Stage
param=bslay_tactic_text,At the start of the fight, the Kalphite Queen is grounded and will protect from all ranged and magical attacks.  During her grounded stage she will use the <col=FFFFFF>Bite, Claw, Lightning</col>, and <col=FFFFFF>Spines</col> special attacks.
param=bslay_tactic_animation,kalphite_queen_2014_ready
param=bslay_tactic_new_npc,kalphite_queen

// 30649
[bslay_kq_tactics_flying]
param=bslay_tactic_title,Flying Stage
param=bslay_tactic_text,After the Kalphite Queen is defeated she will hatch and begin her flying stage - in which she is immune to melee attacks.  During her flying stage she will continue to use <col=FFFFFF>Bite, Claw, Lightning</col>, and <col=FFFFFF>Spines</col> special attacks.
param=bslay_tactic_animation,kalphite_queen_2_2014_ready
param=bslay_tactic_new_npc,kalphite_flyingqueen

// 30650
[bslay_kq_tactics_melee]
param=bslay_tactic_title,Bite
param=bslay_tactic_text,The Kalphite Queen bites her main target for melee damage.
param=bslay_tactic_animation,kalphite_queen_2014_melee
param=bslay_tactic_new_npc,kalphite_queen

// 30651
[bslay_kq_tactics_magic]
param=bslay_tactic_title,Lightning
param=bslay_tactic_text,The Kalphite Queen unleashes a barrage of lightning on all surround targets, hitting them for magical damage.
param=bslay_tactic_animation,kalphite_queen_2014_magic
param=bslay_tactic_spotanim,kalphite_queen_2014_magic_spotanim
param=bslay_tactic_spotanim_model,kalphite_queen_2014_magic_spotanim
param=bslay_tactic_new_npc,kalphite_queen

// 30652
[bslay_kq_tactics_ranged]
param=bslay_tactic_title,Spines
param=bslay_tactic_text,The Kalphite Queen launches a spine at every player nearby, hurting them with ranged damage.
param=bslay_tactic_animation,kalphite_queen_2014_ranged
param=bslay_tactic_spotanim,kalphite_queen_2014_ranged_spotanim
param=bslay_tactic_spotanim_model,kalphite_queen_2014_ranged_spotanim
param=bslay_tactic_new_npc,kalphite_queen

// 30653
[bslay_kbd_tactics_melee]
param=bslay_tactic_title,Melee Attacks
param=bslay_tactic_text,The King Black Dragon will swipe or bite anyone who stands close to him during the fight.
param=bslay_tactic_animation,dragon_update_2012_kbd_attack

// 30654
[bslay_kbd_tactics_firebreath]
param=bslay_tactic_title,Fire Breath
param=bslay_tactic_text,Being a dragon, the King Black Dragon can use extremely powerful fire breath that will destroy anyone who does not bring the appropriate anti-fire protection.
param=bslay_tactic_animation,dragon_update_2012_kbd_attack_firebreath
param=bslay_tactic_spotanim,dragon_update_2012_kbd_firebreath_spotanim
param=bslay_tactic_spotanim_model,dragon_update_2012_kbd_firebreath_spotanim

// 30655
[bslay_kbd_tactics_icebreath]
param=bslay_tactic_title,Frostfire Breath
param=bslay_tactic_text,The King Black Dragon can use a combined attack that hits with massive fire damage while freezing his opponent in place.
param=bslay_tactic_animation,dragon_update_2012_kbd_attack_icebreath
param=bslay_tactic_spotanim,dragon_update_2012_kbd_icebreath_spotanim
param=bslay_tactic_spotanim_model,dragon_update_2012_kbd_icebreath_spotanim

// 30656
[bslay_kbd_tactics_toxicbreath]
param=bslay_tactic_title,Toxic Breath
param=bslay_tactic_text,The King Black Dragon can use a combined attack that hits with massive fire damage and poisons his opponent.
param=bslay_tactic_animation,dragon_update_2012_kbd_attack_toxicbreath
param=bslay_tactic_spotanim,dragon_update_2012_kbd_toxicbreath_spotanim
param=bslay_tactic_spotanim_model,dragon_update_2012_kbd_toxicbreath_spotanim

// 30657
[bslay_kbd_tactics_lightningbreath]
param=bslay_tactic_title,Charged Breath
param=bslay_tactic_text,The King Black Dragon can use a combined attack that hits massive fire damage and shocks his opponent, draining their skills and prayer points slightly.
param=bslay_tactic_animation,dragon_update_2012_kbd_attack_lightningbreath
param=bslay_tactic_spotanim,dragon_update_2012_kbd_lightningbreath_spotanim
param=bslay_tactic_spotanim_model,dragon_update_2012_kbd_lightningbreath_spotanim

// 30658
[bslay_kreearra_tactics_ranged]
param=bslay_tactic_title,Ranged Tornado
param=bslay_tactic_text,Kree'arra fires tornadoes at nearby targets for heavy ranged damage with a chance to knockback any targets they hit. You can prevent the knockback by using the <col=E6DCB4>Anticipation</col> ability.
param=bslay_tactic_animation,godwars_kree_arra_2012_wind_attack
param=bslay_tactic_new_npc,godwars_armadyl_avatar
param=bslay_tactic_spotanim,godwars_kree_arra_2012_wind_attack_spotanim
param=bslay_tactic_spotanim_model,godwars_kree_arra_wave_spot_v1_2012

// 30659
[bslay_kreearra_tactics_magic]
param=bslay_tactic_title,Magic Tornado
param=bslay_tactic_text,Kree'arra fires tornadoes at nearby targets for heavy Magic damage with a chance to knock back any targets they hit. You can prevent the knockback by using the <col=E6DCB4>Anticipation</col> ability.
param=bslay_tactic_animation,godwars_kree_arra_2012_wind_attack
param=bslay_tactic_new_npc,godwars_armadyl_avatar

// 30660
[bslay_kreearra_tactics_melee]
param=bslay_tactic_title,Swipe
param=bslay_tactic_text,Any targets who stand close to Kree'arra risk being hit by his heavy swipe attack.
param=bslay_tactic_animation,godwars_kree_arra_2012_claw_attack
param=bslay_tactic_new_npc,godwars_armadyl_avatar

// 30661
[bslay_kreearra_tactics_minions]
param=bslay_tactic_title,Armadylean Bodyguards
param=bslay_tactic_text,Kree'arra has backup with him in the form of <col=FFFFFF>Wingman Skree, Flockleader Geerin</col>, and <col=FFFFFF>Flight Kilisa</col>. Each uses a different combat style and Kree'arra will respawn any dead bodyguards every <col=FFFFFF>30 seconds.
param=bslay_tactic_animation,godwars_aviansie_2012_ready
param=bslay_tactic_new_npc,godwars_armadyl_male_armor03_blue

// 30662
[bslay_kreearra_tactics_torandoes_hm]
param=bslay_tactic_title,Vortex: <col=DC7800>Hard Mode Only
param=bslay_tactic_text,In Hard mode, Kree'arra calls on the power of his tornadoes in full, having vortexes appear in the room. Anyone caught in a vortex will take massive magic or ranged damage dependent on the type of vortex.
param=bslay_tactic_animation,tsd_tornado_spin
param=bslay_tactic_new_npc,godwars_armadyl_avatar_tornado_magic

// 30663
[bslay_kreearra_tactics_summon_tornadoes_hm]
param=bslay_tactic_title,Alignment: <col=DC7800>Hard Mode Only
param=bslay_tactic_text,During Hard mode, Kree'arra will walk to the centre of the area and summon all vortexes to him. Anyone caught in the path of the tornado will take heavy damage. After Kree'arra has summoned them all to him he will disperse them again into the encounter.
param=bslay_tactic_animation,tsd_kreearra_special_attack
param=bslay_tactic_new_npc,godwars_armadyl_avatar
param=bslay_tactic_spotanim,tsd_kreearra_special_attack_spotanim
param=bslay_tactic_spotanim_model,tsd_kreearra_special_attack_spotanim

// 30664
[bslay_kril_tactics_melee]
param=bslay_tactic_title,Slash
param=bslay_tactic_text,K'ril uses his massive weapons to melee his primary target and inflict poisonous damage. If the target is protecting against melee attacks or he continues to miss he will start to get enraged.
param=bslay_tactic_animation,rand_boss_demon_ghan_ko_slash
param=bslay_tactic_new_npc,godwars_zamorak_avatar

// 30665
[bslay_kril_tactics_magic]
param=bslay_tactic_title,Magic Slam
param=bslay_tactic_text,K'ril uses his massive weapons to slam into the floor and unleash Magic damage on nearby targets. If the target is protecting against Magic attacks or he continues to miss he will start to get enraged.
param=bslay_tactic_animation,rand_boss_demon_war_ground_strike
param=bslay_tactic_spotanim,godwars_zamorak_magic_attack
param=bslay_tactic_spotanim_model,godwars_zamorak_magic_attack
param=bslay_tactic_new_npc,godwars_zamorak_avatar

// 30666
[bslay_kril_tactics_prayerslam]
param=bslay_tactic_title,Prayer Destruction
param=bslay_tactic_text,After K'ril has had enough of his target defending or protecting against his attacks he'll leap into the air and smash down, hitting the main target for massive damage, hitting through prayers and draining prayer points.
param=bslay_tactic_animation,rand_boss_demon_yklagor_dark_eruption
param=bslay_tactic_spotanim,rand_demon_yklagor_dark_eruption_spotanim
param=bslay_tactic_spotanim_model,rand_demon_yklagor_dark_eruption_spotanim
param=bslay_tactic_new_npc,godwars_zamorak_avatar

// 30667
[bslay_kril_tactics_minions]
param=bslay_tactic_title,Zamorakian Bodyguards
param=bslay_tactic_text,K'ril has backup with him in the form of <col=FFFFFF>Tstanon Karlak, Zakl'n Gritch</col>, and <col=FFFFFF>Balfrug Kreeyath</col>. Each uses a different point of the combat triangle and K'ril will respawn any dead bodyguards every <col=FFFFFF>30 seconds.
param=bslay_tactic_animation,red_demon_2011_ready
param=bslay_tactic_new_npc,godwars_ancient_greater_demon

// 30668
[bslay_kril_tactics_charge_hm]
param=bslay_tactic_title,Charge: <col=DC7800>Hard Mode only
param=bslay_tactic_text,K'ril looks at his main opponent and begins charging. Anyone caught in his charge takes massive damage until he hits a wall, stopping him in his tracks.
param=bslay_tactic_animation,tsd_kril_charging_at_player
param=bslay_tactic_new_npc,godwars_zamorak_avatar

// 30669
[bslay_kril_tactics_smash_hm]
param=bslay_tactic_title,Smash: <col=DC7800>Hard Mode only
param=bslay_tactic_text,K'ril smashes his blade into the ground, which bursts into spikes from the impact. Standing in the spikes inflicts constant damage until the time out or you move off of them.
param=bslay_tactic_animation,tsd_kril_special_attack
param=bslay_tactic_spotanim,tsd_kril_special_attack_spotanim
param=bslay_tactic_spotanim_model,combat_2012_ability_strength_threshold_quake_spotanim
param=bslay_tactic_new_npc,godwars_zamorak_avatar

// 30670
[bslay_kril_tactics_enrage_hm]
param=bslay_tactic_title,Enrage: <col=DC7800>Hard Mode only
param=bslay_tactic_text,K'ril will enrage against his opponent and go into a crazed frenzy, swinging and chasing his target wildly. Anyone caught in his wild weapons will take double damage.
param=bslay_tactic_animation,tsd_kril_enraged_chase
param=bslay_tactic_new_npc,godwars_zamorak_avatar

// 30671
[bslay_legio_tactics_1]
param=bslay_tactic_title,Legio Primus
param=bslay_tactic_text,Legios use strong magic attacks, firing lightning at the floor at any targets who aren't moving.<br><br>Legio Primus will <col=FFFFFF>get stronger</col> as his life points decrease.
param=bslay_tactic_animation,asc_legio_idle
param=bslay_tactic_new_npc,asc_legio_1

// 30672
[bslay_legio_tactics_2]
param=bslay_tactic_title,Legio Secundus
param=bslay_tactic_text,Legios use strong magic attacks, firing lightning at the floor at any targets who aren't moving.<br><br>Legio Secundus will fire his lightning attack more often than his regular attacks as his life points get lower.
param=bslay_tactic_animation,asc_legio_idle
param=bslay_tactic_new_npc,asc_legio_2

// 30673
[bslay_legio_tactics_3]
param=bslay_tactic_title,Legio Tertius
param=bslay_tactic_text,Legios use strong magic attacks, firing lightning at the floor at any targets who aren't moving.<br><br>Legio Tertius will summon <col=FFFFFF>rorarii, gladii</col>, and <col=FFFFFF>capsarii</col> as his life points lower to aid him.
param=bslay_tactic_animation,asc_legio_idle
param=bslay_tactic_new_npc,asc_legio_3

// 30674
[bslay_legio_tactics_4]
param=bslay_tactic_title,Legio Quartus
param=bslay_tactic_text,Legios use strong magic attacks, firing lightning at the floor at any targets who aren't moving.<br><br>As his life points are lowered, Legio Quartus will <col=FFFFFF>teleport</col> all targets straight towards him and fire an extra blast of lightning.
param=bslay_tactic_animation,asc_legio_idle
param=bslay_tactic_new_npc,asc_legio_4

// 30675
[bslay_legio_tactics_5]
param=bslay_tactic_title,Legio Quintus
param=bslay_tactic_text,Legios use strong magic attacks, firing lightning at the floor at any targets who aren't moving.<br><br>As his lifepoints are lowered, Legio Quintus can create <col=FFFFFF>Lines of Ascension</col> that draw across the arena and hurt anyone who dares cross them.
param=bslay_tactic_animation,asc_legio_idle
param=bslay_tactic_new_npc,asc_legio_5

// 30676
[bslay_legio_tactics_6]
param=bslay_tactic_title,Legio Sextus
param=bslay_tactic_text,Legios use strong magic attacks, firing lightning at the floor at any targets who aren't moving.<br><br>Legio Sextus's lightning attack is far larger and lasts longer, making him a very potent legio.
param=bslay_tactic_animation,asc_legio_idle
param=bslay_tactic_new_npc,asc_legio_6

// 30677
[bslay_nex_tactics_melee]
param=bslay_tactic_title,Melee Swipe
param=bslay_tactic_text,Throughout the encounter, Nex will use a powerful sweeping melee attack against any targets within melee distance to her. <br><br>On her Zaros phase, Nex's melee attack will be expanded to a frontal cone.
param=bslay_tactic_animation,godwars_nex_2012_attack
param=bslay_tactic_new_npc,godwars2_zaros_avatar

// 30678
[bslay_nex_tactics_smoke_magic]
param=bslay_tactic_title,Smoke Magic
param=bslay_tactic_text,During smoke phase, Nex will fire a barrage of smoky projectiles to all surrounding targets, hitting magical damage. There is also a chance Nex will use this attack to poison you, or pull you towards her if you haven't anticipated the attack.
param=bslay_tactic_animation,godwars_nex_2012_cast_attack
param=bslay_tactic_new_npc,godwars2_zaros_avatar

// 30679
[bslay_nex_tactics_choke]
param=bslay_tactic_title,Choke
param=bslay_tactic_text,Nex will infect one target with a virus. As that target coughs the virus away, they will infect any other targets adjacent to them. Every cough of the virus lowers combat stats.
param=bslay_tactic_animation,godwars_nex_2012_alternate_cast_attack
param=bslay_tactic_new_npc,godwars2_zaros_avatar

// 30680
[bslay_nex_tactics_smoke_bullet]
param=bslay_tactic_title,Smoke bullet
param=bslay_tactic_text,Nex will align with Zaros, picking a path in the chamber to teleport to and firing herself forward to the centre. Any targets caught in the path or centre will be forced forward by her attack, taking massive damage.
param=bslay_tactic_animation,godwars_nex_2012_dash_attack
param=bslay_tactic_new_npc,godwars2_zaros_avatar

// 30681
[bslay_nex_tactics_fumus]
param=bslay_tactic_title,Fumus
param=bslay_tactic_text,When Nex drops below <col=FFFFFF>80% life points</col> she will call on Fumus to aid her. Until this point, Fumus is invulnerable. If Fumus is killed, Nex will move onto the next stage, calling on the power of Shadow.
param=bslay_tactic_animation,godwars_nex_mage_2012_ready
param=bslay_tactic_new_npc,godwars2_smokemage

// 30682
[bslay_nex_tactics_shadow_shot]
param=bslay_tactic_title,Shadow Shot
param=bslay_tactic_text,During the Shadow phase, Nex will use the power of shadow to fling ranged projectiles at all surrounding targets.
param=bslay_tactic_animation,godwars_nex_2012_cast_attack
param=bslay_tactic_new_npc,godwars2_zaros_avatar

// 30683
[bslay_nex_tactics_shadow_smash]
param=bslay_tactic_title,Shadow Smash
param=bslay_tactic_text,Nex will find all nearby victims and put a deadly shadow below them. Shortly after placing the shadows, they will erupt, hitting heavy damage on anyone caught in the dark.
param=bslay_tactic_animation,godwars_nex_2012_smash_attack
param=bslay_tactic_spotanim,godwars_nex_2012_smash_attack_spotanim
param=bslay_tactic_spotanim_model,godwars_nex_2012_smash_attack_spotanim
param=bslay_tactic_new_npc,godwars2_zaros_avatar

// 30684
[bslay_nex_tactics_enter_darkness]
param=bslay_tactic_title,Embrace Darkness
param=bslay_tactic_text,Nex will plunge her targets into darkness, making it darker the closer targets are to her. If any targets are too close to Nex for too long they will become engulfed in shadow, taking constant damage from the pure shadow.
param=bslay_tactic_animation,godwars_nex_2012_blast_away
param=bslay_tactic_new_npc,godwars2_zaros_avatar

// 30685
[bslay_nex_tactics_umbra]
param=bslay_tactic_title,Umbra
param=bslay_tactic_text,When Nex drops below <col=FFFFFF>60% life points</col> she will call on Umbra to aid her. Until this point, Umbra is invulnerable. If Umbra is killed, Nex will move onto the next stage, calling on the power of blood.
param=bslay_tactic_animation,godwars_nex_mage_2012_ready
param=bslay_tactic_new_npc,godwars2_shadowmage

// 30686
[bslay_nex_tactics_blood_siphon]
param=bslay_tactic_title,Blood Siphon
param=bslay_tactic_text,Nex will use her wings to shield her from damage and siphon it to heal her. Any damage over time effects placed on Nex during blood phase will also heal her.<br><br>Any <col=FFFFFF>Blood reavers</col> that are alive when Blood siphon starts will die and transfer their life points to Nex.
param=bslay_tactic_animation,godwars_nex_2012_blood_siphon
param=bslay_tactic_spotanim,godwars_nex_2012_blood_siphon_spotanim
param=bslay_tactic_spotanim_model,godwars_nex_2012_blood_siphon_spotanim
param=bslay_tactic_new_npc,godwars2_zaros_avatar

// 30687
[bslay_nex_tactics_blood_reaver]
param=bslay_tactic_title,Blood Reavers
param=bslay_tactic_text,When Nex begins <col=FFFFFF>Blood Siphon</col>, she will also summon blood reavers to the arena. Any blood reavers that survive until the next <col=FFFFFF>Blood Siphon</col> will transfer their life points to Nex.
param=bslay_tactic_animation,vaultraider_guardian_ready
param=bslay_tactic_new_npc,godwars2_zaros_magic_fighter

// 30688
[bslay_nex_tactics_blood_barrage]
param=bslay_tactic_title,Blood Barrage
param=bslay_tactic_text,During the Blood phase, Nex will shoot Blood Barrage on her targets, healing a percentage of any damage it inflicts on them.
param=bslay_tactic_animation,godwars_nex_2012_alternate_cast_attack
param=bslay_tactic_spotanim,godwars_nex_2012_alternate_cast_attack_spotanim
param=bslay_tactic_spotanim_model,godwars_nex_2012_alternate_cast_attack_spotanim
param=bslay_tactic_new_npc,godwars2_zaros_avatar

// 30689
[bslay_nex_tactics_blood_sacrifice]
param=bslay_tactic_title,Blood Sacrifice
param=bslay_tactic_text,Nex will mark a target for sacrifice. This target has <col=FFFFFF>4 seconds</col> to get as far away from Nex as possible. If they do not manage to get far enough, Nex heals dramatically and instantly fires another <col=FFFFFF>Blood Barrage.</col>
param=bslay_tactic_animation,godwars_nex_2012_alternate_cast_attack
param=bslay_tactic_new_npc,godwars2_zaros_avatar

// 30690
[bslay_nex_tactics_cruor]
param=bslay_tactic_title,Cruor
param=bslay_tactic_text,When Nex drops below <col=FFFFFF>40% life points</col> she will call on Cruor to aid her. Until this point, Cruor is invulnerable. If Cruor is killed, Nex will move onto the next stage, calling on the power of ice.
param=bslay_tactic_animation,godwars_nex_mage_2012_ready
param=bslay_tactic_new_npc,godwars2_bloodmage

// 30691
[bslay_nex_tactics_ice_prison]
param=bslay_tactic_title,Ice Prison
param=bslay_tactic_text,Nex will put her target in a prison of ice. Other players have <col=FFFFFF>6 seconds</col> to free her prisoner before the ice shatters for massive damage. Other combatants can free the imprisoned player by destroying the icicles surrounding them.
param=bslay_tactic_animation,godwars_nex_2012_alternate_cast_attack
param=bslay_tactic_new_npc,godwars2_zaros_avatar

// 30692
[bslay_nex_tactics_ice_barrage]
param=bslay_tactic_title,Ice Barrage
param=bslay_tactic_text,During the Ice phase, Nex will use Ice Barrage against her targets, freezing them in place. Protection from Magic will help reduce damage and freezing effects, but will also increase prayer drain.
param=bslay_tactic_animation,godwars_nex_2012_alternate_cast_attack
param=bslay_tactic_new_npc,godwars2_zaros_avatar

// 30693
[bslay_nex_tactics_containment]
param=bslay_tactic_title,Containment
param=bslay_tactic_text,Nex smashes the floor, creating surround icicles that damage anyone caught next to her. Half of the icicles then being moving towards their assigned targets, hitting anyone caught in their way until the stop.
param=bslay_tactic_animation,godwars_nex_2012_smash_attack
param=bslay_tactic_spotanim,godwars_nex_2012_smash_attack_spotanim
param=bslay_tactic_spotanim_model,godwars_nex_2012_smash_attack_spotanim
param=bslay_tactic_new_npc,godwars2_zaros_avatar

// 30694
[bslay_nex_tactics_glacies]
param=bslay_tactic_title,Glacies
param=bslay_tactic_text,When Nex drops below <col=FFFFFF>20% life points</col> she will call on Glacies to aid her. Until this point, Glacies is invulnerable. If Glacies is killed, Nex will move onto the next stage, calling on the power of Zaros himself.
param=bslay_tactic_animation,godwars_nex_mage_2012_ready
param=bslay_tactic_new_npc,godwars2_icemage

// 30695
[bslay_nex_tactics_zaros_phase]
param=bslay_tactic_title,Power of Zaros
param=bslay_tactic_text,Nex calls on Zaros himself to empower her, This heals her, and increases her damage and accuracy for the remainder of her life. She will then cycle between using <col=FFFFFF>Soulsplit, Deflect Melee,</col> and <col=FFFFFF>Leech</col> curses against her opponents.<br><br>During the Zaros phase, Nex's melee attacks become area-of-effect, hitting anyone within <col=FFFFFF>1 metre</col> of her primary target.
param=bslay_tactic_animation,godwars_nex_2012_turmoil
param=bslay_tactic_spotanim,godwars_nex_2012_turmoil_spotanim
param=bslay_tactic_spotanim_model,godwars_nex_2012_turmoil_spotanim
param=bslay_tactic_new_npc,godwars2_zaros_avatar

// 30696
[bslay_nex_tactics_wrath]
param=bslay_tactic_title,Wrath
param=bslay_tactic_text,When Nex is defeated, she'll activate the <col=FFFFFF>Wrath</col> curse, hitting anyone with an explosion who is nearby where she perishes.
param=bslay_tactic_animation,godwars_nex_2012_death
param=bslay_tactic_new_npc,godwars2_zaros_avatar

// 30697
[bslay_nex_tactics_deflection]
param=bslay_tactic_title,Deflection
param=bslay_tactic_text,During the fight, Nex can randomly decide to use a deflection curse <col=FFFFFF>(ranged or magic)</col> for <col=FFFFFF>2 minutes</col>. This becomes more probable as the phases carry on. She will only use one type per kill and will alternate between the two as kills go on.

// 30698
[bslay_qbd_tactics_artifacts]
param=bslay_tactic_title,Artefacts
param=bslay_tactic_text,The Queen Black Dragon cannot be defeated, only returned to slumber. To do this, you must activate <col=FFFFFF>four artefacts</col> that become enabled when the Queen Black Dragon reaches <col=FFFFFF>0 life points</col>.
param=bslay_tactic_new_npc,qbd2_boss

// 30699
[bslay_qbd_tactics_melee]
param=bslay_tactic_title,Melee/Range Attack
param=bslay_tactic_text,The Queen Black Dragon will use a powerful swipe to any targets found at the front of her platform causing <col=FFFFFF>ranged</col> damage, if the target stands melee distance she will resort to biting them if they are completely adjacent.
param=bslay_tactic_animation,qbd2_qbd_swipe_attack_variant_b
param=bslay_tactic_new_npc,qbd2_boss

// 30700
[bslay_qbd_tactics_magic]
param=bslay_tactic_title,Fire Breath
param=bslay_tactic_text,The Queen Black Dragon can unleash massive fire breath at any point throughout the fight. Those who do not bring appropriate anti-fire protection will burn for incredible damage.
param=bslay_tactic_animation,qbd2_qbd_breath_attack
param=bslay_tactic_new_npc,qbd2_boss

// 30701
[bslay_qbd_tactics_firewall]
param=bslay_tactic_title,Wall of Fire
param=bslay_tactic_text,The Queen Black Dragon summons a massive wall of fire which passes over the platform inflicting fire damage. Keep an eye out for a weak point in the wall that you can pass through unharmed.<br><br>Based on the fights duration, the Queen Black Dragon may summon up to <col=FFFFFF>three walls of fire</col> at the same time.
param=bslay_tactic_animation,qbd2_qbd_fire_wave_attack_start
param=bslay_tactic_spotanim,qbd2_qbd_fire_wave_attack_start_spotanim
param=bslay_tactic_spotanim_model,qbd2_qbd_fire_wave_attack_spotanim
param=bslay_tactic_new_npc,qbd2_boss

// 30702
[bslay_qbd_tactics_convulsion]
param=bslay_tactic_title,Convulsion
param=bslay_tactic_text,After the Queen Black Dragon has been defeated, you need to activate the next appropriate <col=FFFFFF>artefact</col>. While vulnerable, the queen will fire out <col=FFFFFF>grotworms</col> until the <col=FFFFFF>artefact</col> is enabled. These grotworms attack the player with magic, and they will stay until the rest of the fight.
param=bslay_tactic_animation,qbd2_qbd_convulsion_start
param=bslay_tactic_new_npc,qbd2_boss

// 30703
[bslay_qbd_tactics_nameless]
param=bslay_tactic_title,Tortured souls
param=bslay_tactic_text,From <col=FFFFFF>Stage two</col> onwards, the Queen Black Dragon will spawn increasing amounts of <col=FFFFFF>Tortured souls</col>. Tortured souls will fire <col=FFFFFF>arcane waves</col> along the floor towards their target. <br><br>If they hit a different target on the way, they will disperse - otherwise they hit their target for unblockable damage.
param=bslay_tactic_animation,cruc_soul_ready
param=bslay_tactic_new_npc,qbd2_namelessone

// 30704
[bslay_qbd_tactics_timestop]
param=bslay_tactic_title,Time Stop
param=bslay_tactic_text,A <col=FFFFFF>Tortured souls</col> may start chanting a ritual that will result in time stopping temporarily. If the spell completes, the target cannot move or act, but will suffer time stopping for <col=FFFFFF>10 seconds</col>, after which everything the Queen Black Dragon has done will be instantly applied.
param=bslay_tactic_new_npc,qbd2_boss

// 30705
[bslay_qbd_tactics_forging]
param=bslay_tactic_title,Forging Fire
param=bslay_tactic_text,Forging Fire is the ultimate fire breath attack the Queen Black Dragon will unleash in stage four. Any target standing in the centre of the fire will take massive fire damage. Note that this is enough heat to forge the <col=FFFFFF>royal crossbow</col>. <br><br>Targets on the outskirts of the fire take less damage.
param=bslay_tactic_animation,qbd2_qbd_forging_fire_attack
param=bslay_tactic_spotanim,qbd2_qbd_forging_fire_attack_spotanim
param=bslay_tactic_spotanim_model,qbd2_qbd_forging_fire_attack_spotanim
param=bslay_tactic_new_npc,qbd2_boss

// 30706
[bslay_qbd_tactics_crystal]
param=bslay_tactic_title,Crystal Form
param=bslay_tactic_text,The Queen Black Dragon takes on the consistency of crystal. She is more resistant to magic, but weaker to physical damage for <col=FFFFFF>50 seconds, or until the next artefact is enabled.
param=bslay_tactic_animation,qbd2_qbd_ready
param=bslay_tactic_new_npc,qbd2_boss_crystal

// 30707
[bslay_qbd_tactics_spirit]
param=bslay_tactic_title,Hardened Carapace
param=bslay_tactic_text,The Queen Black Dragon hardens her carapace. She is more resistant to physical damage, but more vulnerable to magic for <col=FFFFFF>50 seconds, or until the next artefact is enabled.
param=bslay_tactic_animation,qbd2_qbd_ready
param=bslay_tactic_new_npc,qbd2_boss_spirit

// 30708
[bslay_tztokjad_tactics_melee]
param=bslay_tactic_title,Melee Swipe
param=bslay_tactic_text,TzTok-Jad has only one focus: killing his target. Expect to die if you do not protect against his massive melee attack. TzTok-Jad will only use melee swipe when the target gets within melee distance.
param=bslay_tactic_animation,tzhaar_2011_tor_jad_melee
param=bslay_tactic_new_npc,tzhaar_fightcave_swarm_boss

// 30709
[bslay_tztokjad_tactics_ranged]
param=bslay_tactic_title,Ranged Smash
param=bslay_tactic_text,TzTok-Jad has only one focus: killing his target. Expect to die if you do not protect against his massive ranged attack.
param=bslay_tactic_animation,tzhaar_2011_tor_jad_ranged_attack
param=bslay_tactic_spotanim,tzhaar_2011_tor_jad_ranged_attack_spotanim
param=bslay_tactic_spotanim_model,tzhaar_2011_tor_jad_ranged_attack_spotanim
param=bslay_tactic_new_npc,tzhaar_fightcave_swarm_boss

// 30710
[bslay_tztokjad_tactics_magic]
param=bslay_tactic_title,Magic Death
param=bslay_tactic_text,TzTok-Jad has only one focus: killing his target. Expect to die if you do not protect against his massive magic attack.
param=bslay_tactic_animation,tzhaar_2011_tor_jad_magic_attack
param=bslay_tactic_spotanim,tzhaar_2011_tor_jad_fire_spotanim
param=bslay_tactic_spotanim_model,tzhaar_2011_tor_jad_fire_spotanim
param=bslay_tactic_new_npc,tzhaar_fightcave_swarm_boss

// 30711
[bslay_tztokjad_tactics_healers]
param=bslay_tactic_title,Medic!
param=bslay_tactic_text,When TzTok-Jad passes <col=FFFFFF>50% life points</col> he calls multiple Yt-HurKot's towards him, all with the aim of healing him. If kept unchecked, they will continually heal him for the duration of the encounter.
param=bslay_tactic_animation,tzhaar_2011_yt_hurkot_ready
param=bslay_tactic_new_npc,tzhaar_fightcave_swarm_boss_cleric

// 30712
[bslay_vorago_tactics_maulofomens]
param=bslay_tactic_title,Maul of Omens
param=bslay_tactic_text,Vorago can only be defeated via use of the <col=FFFFFF>Maul of Omens</col>. This weapon can be assembled during the fight. Parts are found in <col=FFFFFF>stages 1, 2, and 4</col>.

// 30713
[bslay_vorago_tactics_melee]
param=bslay_tactic_title,Melee Swipe
param=bslay_tactic_text,Vorago hits his main target and swipes them for heavy melee damage. Having another tank in the vicinity can help lower the damage. Anyone adjacent to Vorago will also be hit.
param=bslay_tactic_animation,boss2_boss_attack_melee
param=bslay_tactic_new_npc,lrc2_boss

// 30714
[bslay_vorago_tactics_bluebomb]
param=bslay_tactic_title,Magic Bomb
param=bslay_tactic_text,The Magic Bomb is a magic attack that will attempt to target the furthest player away, multiple magic bombs will be fired at once should there be a large number of players fighting Vorago.
param=bslay_tactic_animation,boss2_boss_attack_magic
param=bslay_tactic_spotanim,boss2_boss_attack_magic_spotanim
param=bslay_tactic_spotanim_model,boss2_boss_attack_magic_spotanim
param=bslay_tactic_new_npc,lrc2_boss

// 30715
[bslay_vorago_tactics_redbomb]
param=bslay_tactic_title,Explosive bomb
param=bslay_tactic_text,Vorago picks a target (preferring the farthest player away) and fires an explosive bomb towards them. On impact it detonates for significant damage - more so if multiple targets are in the explosive area.
param=bslay_tactic_animation,boss2_boss_attack_magic_special
param=bslay_tactic_spotanim,boss2_boss_attack_magic_special_spotanim
param=bslay_tactic_spotanim_model,boss2_boss_attack_magic_special_spotanim
param=bslay_tactic_new_npc,lrc2_boss

// 30716
[arch_site_icon_guild_over]
param=rs3tli_button_layer_master_struct,arch_site_icon_guild
param=rs3tli_button_layer_type,2
param=rs3tli_button_graphic,"arch_icon_digsite_guild,1"
param=rs3tli_button_graphic_width,40
param=rs3tli_button_graphic_height,40

// 30717
[bslay_vorago_tactics_jumpsmash]
param=bslay_tactic_title,Jump-Smash
param=bslay_tactic_text,At the end of each stage, Vorago will jump up and smash down in another location. Anyone caught in proximity to him landing risks taking heavy damage. After <col=FFFFFF>three smashes</col> the floor will give way and everyone will fall deeper into the encounter.
param=bslay_tactic_animation,boss2_boss_jump_offscreen
param=bslay_tactic_spotanim,boss2_boss_jump_offscreen_spotanim
param=bslay_tactic_spotanim_model,boss2_boss_jump_offscreen_spotanim
param=bslay_tactic_new_npc,lrc2_boss

// 30718
[bslay_vorago_tactics_dotmelee]
param=bslay_tactic_title,Destroy Tank
param=bslay_tactic_text,Vorago performs a strong melee attack against his main target <col=FFFFFF>five times</col> in a row. Each attack will place a damage-over-time effect on the target, which persists if they are close to Vorago.<br><br>If the damage-over-time effect exists on Vorago's target when he attacks them again, the target will suffer a massive melee hit.<br><br>Using abilities such as <col=FFFFFF>Provoke</col> and <col=FFFFFF>Freedom</col> should be considered to deal with this attack.
param=bslay_tactic_animation,boss2_boss_attack_melee_special
param=bslay_tactic_spotanim,boss2_boss_attack_melee_special_spotanim
param=bslay_tactic_spotanim_model,boss2_boss_attack_melee_special_spotanim
param=bslay_tactic_new_npc,lrc2_boss

// 30719
[bslay_vorago_tactics_playerlink]
param=bslay_tactic_title,Target Link
param=bslay_tactic_text,Vorago picks a target and links himself to them for <col=FFFFFF>10 seconds</col>. During this time, any damage done to Vorago is instead applied to the linked target.
param=bslay_tactic_animation,boss2_boss_playerlink
param=bslay_tactic_spotanim,boss2_boss_playerlink_spotanim
param=bslay_tactic_spotanim_model,boss2_boss_playerlink_spotanim
param=bslay_tactic_new_npc,lrc2_boss

// 30720
[bslay_vorago_tactics_gravity_field]
param=bslay_tactic_title,Gravity Fields
param=bslay_tactic_text,Vorago will spawn gravity fields in stage two. If a gravity field is activated and Vorago is nearby, it'll fly towards him. After Vorago has absorbed <col=FFFFFF>4 gravity fields (2 if players fail the next stage)</col> he will be destabilised and can be brought down.

// 30721
[bslay_vorago_tactics_bringhimdown]
param=bslay_tactic_title,Bring Him Down!
param=bslay_tactic_text,After Vorago has absorbed <col=FFFFFF>4 gravity fields</col> all targets will become linked to Vorago and gravity itself. Opponents are then required to attack Vorago repeatedly to pull him into the floor, leaving him vulnerable.
param=bslay_tactic_animation,null
param=bslay_tactic_new_npc,lrc2_boss

// 30722
[bslay_vorago_tactics_dpsrace]
param=bslay_tactic_title,Destroy Phase
param=bslay_tactic_text,After Vorago has been pulled into the floor, he will be idle and vulnerable for <col=FFFFFF>10 seconds</col>. During this time his opponents have to deal massive damage to obtain the piece of the <col=FFFFFF>Maul of Omens.</col><br><br>If this is failed, you are required to repeat the <col=FFFFFF>gravity fields</col> once again.
param=bslay_tactic_animation,boss2_boss_falling_loop
param=bslay_tactic_new_npc,lrc2_boss

// 30723
[bslay_vorago_tactics_p3_explanation]
param=bslay_tactic_title,Stage 3
param=bslay_tactic_text,Stage 3 is a special case. The chasm Vorago falls into may change week on week. Be prepared for any of the following!

// 30724
[bslay_vorago_tactics_p3_ceilings]
param=bslay_tactic_title,Stage 3.1 : Ceiling rotation
param=bslay_tactic_text,Vorago will fire a projectile at the sky and follow it up. Shortly after a shadow will appear on the floor and the section of ceiling will fall down and smash anyone found underneath it. Slowly the entire arena may become blocked off if left unchecked.
param=bslay_tactic_animation,boss2_boss_fire_at_sky
param=bslay_tactic_spotanim,boss2_boss_fire_at_sky_spotanim
param=bslay_tactic_spotanim_model,boss2_boss_attack_magic_spotanim
param=bslay_tactic_new_npc,lrc2_boss

// 30725
[bslay_vorago_tactics_p3_ceiling_detonation]
param=bslay_tactic_title,Stage 3.1 : Ceiling detonation
param=bslay_tactic_text,If the arena is becoming locked down due to the <col=FFFFFF>ceiling collapse</col>, Vorago's opponents can choose to destroy the debris, but will take heavy damage in the process. Any leftover debris will also fall through into the next stage.

// 30726
[bslay_vorago_tactics_p3_scopulus]
param=bslay_tactic_title,Stage 3.2 : Scopulus
param=bslay_tactic_text,Scopuli are all tied to each other in spirit. The closer these creatures are to each other, the more accuracy and damage they will do, as well as increasing the distance they will inflict damage on their targets.
param=bslay_tactic_animation,boss2_stoneadd_idle
param=bslay_tactic_new_npc,lrc2_stone_add

// 30727
[bslay_vorago_tactics_p3_scopulus_enrage]
param=bslay_tactic_title,Stage 3.2 : Scopulus Enrage
param=bslay_tactic_text,When a scopulus dies, it will heal its linked scopulus for <col=FFFFFF>10% of its life points</col> as well as enrage it - increasing its damage, accuracy, attack speed and attack spread.
param=bslay_tactic_animation,boss2_stoneadd_enrage
param=bslay_tactic_new_npc,lrc2_stone_add

// 30728
[bslay_vorago_tactics_p3_vitalis_attack]
param=bslay_tactic_title,Stage 3.3 : Summon Vitalii
param=bslay_tactic_text,Vorago will pick an area in the arena and fire a shockwave towards it. When the shockwave arrives, multiple <col=FFFFFF>vitalii</col> may spawn. To counteract this, you can have a person stand in the shockwave to prevent a <col=FFFFFF>vitalis</col> spawning, taking some damage instead.
param=bslay_tactic_animation,boss2_boss_attack_shockwave
param=bslay_tactic_spotanim,boss2_boss_attack_shockwave_spotanim
param=bslay_tactic_spotanim_model,boss2_boss_attack_shockwave_proj
param=bslay_tactic_new_npc,lrc2_boss

// 30729
[bslay_vorago_tactics_p3_vitalis]
param=bslay_tactic_title,Stage 3.3 : Vitalii
param=bslay_tactic_text,Vitalii will attack anyone near to themselves or Vorago, hitting quickly for melee damage.
param=bslay_tactic_animation,boss2_normaladd_idle
param=bslay_tactic_new_npc,lrc2_normal_add

// 30730
[bslay_vorago_tactics_p3_gasbomb]
param=bslay_tactic_title,Stage 3.4 : Gas Bomb
param=bslay_tactic_text,Vorago fires a green bomb at a random area in the encounter. On impact it will create a <col=FFFFFF>Gas cloud</col> as well as bouncing towards a target. When it hits this target it will look to bounce again to another target.<br>Each unique target will take damage when it bounces to them.<br><br>If no targets are found, the bomb will explode immediately for massive damage.<br><br>If the bomb hits the same target twice it will detonate for heavy damage.
param=bslay_tactic_animation,boss2_boss_attack_magic
param=bslay_tactic_spotanim,boss2_boss_attack_magic_spotanim
param=bslay_tactic_spotanim_model,boss2_boss_attack_magic_spotanim_green
param=bslay_tactic_new_npc,lrc2_boss

// 30731
[bslay_vorago_tactics_p3_gas_area]
param=bslay_tactic_title,Stage 3.4 : Gas cloud
param=bslay_tactic_text,Standing in a gas cloud will drain run energy, <col=FFFFFF>adrenaline</col> and life points consistently.

// 30732
[bslay_vorago_tactics_p3_teamsplit]
param=bslay_tactic_title,Stage 3.5 : Teamsplit
param=bslay_tactic_text,Vorago will try to split the team in two. Half of the team will be marked as green and the other half red. Vorago also places coloured zones in the room and begins charging for <col=FFFFFF>8 seconds</col>.After this time, anyone not standing in the matching zone will explode for massive damage.
param=bslay_tactic_animation,boss2_boss_charging
param=bslay_tactic_new_npc,lrc2_boss

// 30733
[bslay_vorago_tactics_waterfall]
param=bslay_tactic_title,Stage 4 : Waterfall
param=bslay_tactic_text,Vorago will open a waterfall from above and teleport to the centre of the encounter to begin charging. <col=FFFFFF>10 seconds later</col>, he will explode for massive fire damage. Anyone not hiding behind a waterfall will suffer massive damage from the fire.
param=bslay_tactic_animation,boss2_boss_explode
param=bslay_tactic_spotanim,boss2_boss_explode_spotanim
param=bslay_tactic_spotanim_model,boss2_boss_explode_spotanim
param=bslay_tactic_new_npc,lrc2_boss

// 30734
[bslay_vorago_tactics_stoneclones]
param=bslay_tactic_title,Stage 4 : Stone clones
param=bslay_tactic_text,Vorago will show some of his opponents stone versions of themselves. Each will have to defeat their stone clone, which will use a full suite of <col=FFFFFF>combat abilities</col>. If you defeat a clone, you may help team mates who also have stone clones.
param=bslay_tactic_animation,combat_2012_casual_armed_idle
param=bslay_tactic_new_npc,lrc2_boss_player_melee

// 30735
[bslay_vorago_tactics_finale]
param=bslay_tactic_title,Stage 5 : Finale
param=bslay_tactic_text,In the final stage of the fight, opponents must face off against Vorago in a race of damage.<br><br>As Vorago inflicts damage, he will push his opponents <col=FFFFFF>west</col>. If the team is pushed off of the platform, they all suffer <col=FFFFFF>instant death.</col>.<br><br>As the team damages Vorago, he will be pushed. <col=FFFFFF>east.</col> If the team gets Vorago to the far end of the platform, he will be vulnerable to the <col=FFFFFF>Maul of Omens</col> which can be used to finish him off.
param=bslay_tactic_animation,null
param=bslay_tactic_new_npc,lrc2_boss

