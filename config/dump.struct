param=bslay_tactic_animation,dungeon_wilderness_astellarn_jump_and_land

// 28244
[bslay_dungeon_ulthven1_regen]
param=bslay_tactic_title,Regeneration
param=bslay_tactic_text,The Crassian Leviathan has impressive regenerative capabilities, constantly healing over time. If it is poisoned, however, its ability to heal is greatly reduced.

// 28245
