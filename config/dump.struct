param=slayer_example_npc,hotm_slayer_creature_melee

// 50945
[slayer_morvran_list_entry_26]
param=slayer_name,Elves
param=slayer_type,56
param=slayer_description,I'm not advocating the killing of my kind, you understand - we enjoy being tested in combat. You'll find melee fighters in Clan Iorwerth's segment of Prifddinas; mages and rangers in Clan Cadarn's segment.
param=slayer_sl_req,0
param=slayer_example_npc,regicide_darkelf

