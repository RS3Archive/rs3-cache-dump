// 28039
[bslay_dungeon_dragonfort1_pulsar]
param=bslay_tactic_title,Pulsar
param=bslay_tactic_text,Astellarn will occasionally summon a Pulsar, which will continuously pulse for damage until destroyed.
param=bslay_tactic_new_npc,dungeon_dragonfort_boss1_pulsar_star

// 28040
[bslay_dungeon_dragonfort1_neutron]
param=bslay_tactic_title,Neutron Star
param=bslay_tactic_text,A Neutron Star will appear and gravitate towards a player in Astellarn's arena. If it comes into contact with the player it will explode for significant damage. Neutron Stars may be dragged into <col=FFFFFF>Wyrmholes</col> in order to stabilise them. Once stabilised, Wyrmholes will significantly increase the damage of anyone standing in them instead of dealing damage.
param=bslay_tactic_new_npc,dungeon_dragonfort_boss1_neutron_star

// 28041
[bslay_dungeon_dragonfort1_wyrmhole]
param=bslay_tactic_title,Wyrmhole
param=bslay_tactic_text,Astellarn will select a player on which to anchor a Wyrmhole. The player has a short period of time to position themselves before a Wyrmhole spawns on top of them. The Wyrmhole will deal small amounts of damage to anyone stood in or near it.

// 28042
[bslay_dungeon_dragonfort2_spires]
param=bslay_tactic_title,Magma Spires
param=bslay_tactic_text,Verak Lith summons spires that rise up from the ground beneath his opponents. These deal immediate damage and they grant Verak Lith <col=FFFFFF>invulnerability</col> while they are present.
param=bslay_tactic_new_npc,dungeon_dragonfort_boss2_spire

// 28043
[bslay_dungeon_dragonfort2_bombs]
param=bslay_tactic_title,Elements of the King Black Dragon
param=bslay_tactic_text,Verak Lith will launch elemental energy projectiles into the air of either poison, ice or electrical energy. If these energies hit the ground, they will cause significant damage to any players in the arena. It is therefore recommended to catch the projectiles and use nearby dragon eggs of the respective elemental type to disperse the energy instead. Clever use of defensive abilities will also work.

// 28044
[bslay_dungeon_dragonfort2_dive]
param=bslay_tactic_title,Black Dragon Dive Bomb
param=bslay_tactic_text,Throughout the encounter, black dragons will dive bomb your location, leaving a trail of dangerous ice, shock or poison energy that deals large amount of damage.

// 28045
[bslay_dungeon_dragonfort2_fire]
param=bslay_tactic_title,Summon Flame Vortex
param=bslay_tactic_text,Verak Lith summons a patch of unstable fire, which explodes outwards into multiple flame vortices. These deal significant damage to anyone near them.

// 28046
[bslay_dungeon_dragonfort3_breath]
param=bslay_tactic_title,Black Stone Dragonbreath
param=bslay_tactic_text,A shadowy breath attack that deals <col=FFFFFF>magic</col> damage to anyone caught in it.
param=bslay_tactic_animation,dungeon_wilderness_astellarn_breath_attack
param=bslay_tactic_spotanim,dungeon_wilderness_astellarn_breath_attack_spotanim
param=bslay_tactic_spotanim_model,dungeon_wilderness_bsdragon_breath_attack_spotanim

// 28047
[bslay_dungeon_dragonfort3_gem]
param=bslay_tactic_title,Gemstone Shards
param=bslay_tactic_text,The Black Stone Dragon sends out gemstone shards at all opponents, puncturing her targets for <col=FFFFFF>melee</col> damage, stealing their lifepoints, and completely draining their adrenaline.
param=bslay_tactic_animation,dungeon_wilderness_astellarn_summoning

// 28048
[bslay_dungeon_dragonfort3_hands]
param=bslay_tactic_title,Black Hands
param=bslay_tactic_text,Once she has taken some damage, the Black Stone Dragon will become shackled by four Black Hands in the centre of the arena. These Black Hands will launch <col=FFFFFF>magic</col> projectiles at the player, and occasionally slam the ground, causing shadowy grasping hands to move towards the location of their target.
param=bslay_tactic_new_npc,dungeon_ulthven_boss3_xautak

// 28049
[task_world_event_3]
param=task_game,1
param=dndtracker_is_members,0
param=task_name,Cabbage Facepunch Bonanza
param=task_details,Compete and collaborate with other players to survive an arena built by gods.
param=task_rewards,Gives <col=ffffff>renown points</col>, which can be exchanged for <col=ffffff>Farming bonus XP</col>, <col=ffffff>Mining bonus XP</col>, <col=ffffff>Slayer bonus XP</col>, <col=ffffff>in-game abilities</col> and <col=ffffff>cosmetic items</col>.
param=task_step_1,You can find the game in the north-east of the <col=ffffff>Gamers' Grotto</col>, just north of <col=ffffff>Falador</col>.
param=task_step_2,Talk to the <col=ffffff>quartermaster</col> to choose a faction.
param=task_step_3,You may play Cabbage Facepunch Bonanza <col=ffffff>as often as you wish</col>.
param=task_step_1_arrow,0_99_99_2_52
param=task_step_2_arrow,0_99_99_2_52
param=task_step_3_arrow,0_99_99_2_52
param=task_auto_arrow,1
param=task_icon,"task_icons_48_60,8"
param=task_set,63
param=task_unique_id,3062
param=task_area,0
param=task_next_id,3013
param=task_optional,1
param=challenge_nearest_lodestone,0_46_53_23_12
param=dndtracker_full_description,Compete and collaborate with other players to survive. Cross the arena within the time limit to gain points, attacking enemies and harvesting from gathering nodes to increase your overall score.
param=group_reward_skill_1,mining
param=group_reward_skill_2,farming
param=group_reward_skill_3,slayer
param=bslay_boss_spec_drops,group_we3_rewards
param=group_reward_bespoke,You can also purchase abilities which give unique effects within the Cabbage Facepunch Bonanza arena.
param=group_min_players,6
param=group_max_players,10
param=group_rec_players,10
param=group_tele_coord,0_46_151_50_36

