// 2776
[dom_boss_chronozon]
param=dom_boss_name,Chronozon
param=dom_boss_id,21
param=dom_boss_npc_safe_1,dom_chronozon_safe
param=dom_boss_npc_combat_1,dom_chronozon_combat
param=dom_npc_spawn_npc1_x,37
param=dom_npc_spawn_npc1_z,30
param=dom_arena_type,1
param=dom_boss_desc,This demon doesn't seem to mind living in a cave not too far from the Wilderness, so understandably he's not very friendly. Big, red, clawed, spiked - he is a fearsome creature.<br><br><col=F5B241>Quest</col>: Family Crest<br><br><col=F5B241>Combat</col>: Chronozon will simply punch you, but in order to defeat him you need to cast one of each of the 4 elemental blast spells (runes provided in the arena - don't waste them!).<br><br>If you don't have the normal spellbook active, it will become active when you start this battle, and will revert afterwards.
param=dom_boss_1_taunt,I am everlasting!
param=dom_boss_taunt_sound_english,chronozon_i_am_everlasting
param=dom_boss_taunt_sound_german,chronozon_i_am_everlasting
param=dom_boss_taunt_sound_french,chronozon_i_am_everlasting
param=dom_boss_taunt_sound_portuguese,chronozon_i_am_everlasting
param=dom_battle_total_lifepoints,12000
param=dom_boss_spline_size,0
