// 38537
[cheevo_div_experience]
param=cheevo_name,What an Experience
param=cheevo_details,Convert a memory, or an enriched memory, into experience.
param=cheevo_icon,"aif_omge_quest_icons_01,20"
param=cheevo_unique_id,1138
param=task_step_1,Take a memory, or an enriched memory, to one of the craters located near wisp colonies.
param=task_step_1_arrow,0_48_50_48_15
param=task_auto_arrow,1
param=task_step_2,Click on the crater and your memories will be turned into experience.
param=task_step_2_mobile,Tap the crater and your memories will be turned into experience.
param=task_information,Memories can be collected from the wisps in each colony. Multiple memories of any tier can be converted at the same time, and higher tier memories will give a larger amount of experience when converted.
param=cheevo_game,1
param=cheevo_meta_id,1989
param=cheevo_meta_id_2,1700
param=cheevo_runescore,5

// 38538
[cheevo_div_energy]
param=cheevo_name,Energy Generator
param=cheevo_details,Convert a memory, or an enriched memory, into energy.
param=cheevo_icon,"aif_omge_quest_icons_01,20"
param=cheevo_unique_id,1139
param=task_step_1,Take a memory, or an enriched memory, to one of the craters located near wisp colonies.
param=task_step_1_arrow,0_48_50_48_15
param=task_auto_arrow,1
param=task_step_2,Right-click on the crater and configure,then choose to convert your memory into energy. Now whenever you click on the crater, it will turn any memories into energy instead of experience.
param=task_step_2_mobile,Long-press the crater and configure,then choose to convert your memory into energy. Now whenever you tap the crater, it will turn any memories into energy instead of experience.
param=task_information,Memories can be collected from the wisps in each colony. Multiple memories of any tier can be converted at the same time, and higher tier memories will give a larger amount of energy when converted.
param=cheevo_game,1
param=cheevo_meta_id,1989
param=cheevo_meta_id_2,1700
param=cheevo_runescore,5

// 38539
[cheevo_div_enhanced]
param=cheevo_name,Let's Enhance
param=cheevo_details,Convert a memory, or an enriched memory, into enhanced experience.
param=cheevo_icon,"aif_omge_quest_icons_01,20"
param=cheevo_unique_id,1140
param=task_step_1,You will need a memory, or an enriched memory, along with some energy of the same tier.
param=task_step_2,Take your memory and energy to one of the craters located near wisp colonies. 
param=task_step_1_arrow,0_48_50_48_15
param=task_auto_arrow,1
param=task_information,Converting memories into enhanced experience gives a greater amount of experience. However, it also uses up some energy. Converting normal memories requires 5 energy of the same tier per conversion, while enriched memories require 10 energy. Multiple memories of any tier can be converted at the same time, and higher tier memories will give a larger amount of experience when converted.
param=cheevo_game,1
param=cheevo_meta_id,1989
param=cheevo_meta_id_2,1700
param=cheevo_runescore,5

// 38540
[cheevo_div_portent]
param=cheevo_name,Portentially Hazardous
param=cheevo_details,Create a portent.
param=cheevo_icon,"aif_omge_quest_icons_01,20"
param=cheevo_unique_id,1142
param=task_step_1,Get some energy of the appropriate tier and additional materials as described in the Divination section of the skill guide.
param=task_step_2,Click on the energy and choose a portent to create.
param=task_step_2_mobile,Tap the energy and choose a portent to create.
param=task_step_3,Creating portents has various requirements. As you get more proficient, you can create higher-level items.
param=task_information,Most portents will sit passively in your inventory until they are required. For example, portents of restoration will only activate when you fall below half health. Experiment with different types of portent to discover their uses.
param=task_requirement_1_type,26
param=task_requirement_1_value,2
param=cheevo_game,1
param=cheevo_meta_id,1989
param=cheevo_meta_id_2,1700
param=cheevo_runescore,5

// 38541
[cheevo_div_divine]
param=cheevo_name,Simply Divine
param=cheevo_details,Create a divine location.
param=cheevo_icon,"aif_omge_quest_icons_01,20"
param=cheevo_unique_id,1143
param=task_step_1,Get some energy of the appropriate tier and additional materials as described in the Divination section of the skill guide.
param=task_step_2,Click on the energy and choose a divine location to create.
param=task_step_2_mobile,Tap the energy and choose a divine location to create.
param=task_step_3,Creating divine locations has various requirements. As you become more proficient, you can create higher-level items.
param=task_information,You may only craft one divine location per day. When you have crafted a location, you can place it on the ground and - if you have the required skills - gather from it. Any other player with the required skills can also interact with the location. When other players interact with a location you placed, you have a chance to gain noted versions of the items they collect.
param=task_requirement_1_type,26
param=task_requirement_1_value,3
param=cheevo_game,1
param=cheevo_meta_id,1989
param=cheevo_meta_id_2,1700
param=cheevo_runescore,5

