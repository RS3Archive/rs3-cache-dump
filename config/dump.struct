// 15372
[cbtv2va_course_hotbar_basics]
param=cbtv2ca_course_name,Using the Action Bar and Abilities
param=cbtv2ca_course_description,Teaches you how to use the action bar. Introduces abilities and ability based combat.<br><br>Demonstration:<br>Kill waves of skeletons using abilities.<br><br>Hover over the rank icons to see completion requirements.
param=cbtv2ca_course_gold,#1 Legend Rank<br><br>Kill all the skeletons while using multiple abilities from the action bar.
param=cbtv2ca_course_silver,#2 Hero Rank<br><br>Kill all the skeletons and use an ability.
param=cbtv2ca_course_bronze,#3 Champion Rank<br><br>Kill all the skeletons.
param=cbtv2ca_course_label,storablelabel_4
param=cheevo_name,Combat Academy #5 - Action Bar & Abilities
param=cheevo_icon,rs3_icon_path_combat
param=cheevo_unique_id,4076
param=cheevo_details,Complete the fifth course at the Lumbridge Combat Academy.
param=task_step_1_arrow,0_50_50_10_56
param=task_step_1,Talk to <col=0xF0BE79>Lady Deathknell</col> at the <col=0xF0BE79>Lumbridge Combat Academy</col>.
param=cheevo_game,1
param=task_optional,1

// 15373
[cbtv2va_course_adrenaline_thresh_ulti]
param=cbtv2ca_course_name,(Advanced) Adrenaline, Threshold Abilities and Ultimate Abilities
param=cbtv2ca_course_description,Introduces the use of adrenaline and how to use more powerful abilities.<br><br>Demonstration:<br>Kill a skeletal juggernaut using powerful abilities.<br><br>Hover over the rank icons to see completion requirements.
param=cbtv2ca_course_gold,#1 Legend Rank<br><br>Kill the skeletal juggernaut and use a threshold and an ultimate ability.
param=cbtv2ca_course_silver,#2 Hero Rank<br><br>Kill the skeletal juggernaut and use a threshold or an ultimate ability.
param=cbtv2ca_course_bronze,#3 Champion Rank<br><br>Kill the skeletal juggernaut.
param=cbtv2ca_course_label,storablelabel_5
param=cheevo_name,Combat Academy #6 - Adrenaline, Thresholds, Ultimates
param=cheevo_icon,rs3_icon_path_combat
param=cheevo_unique_id,4077
param=cheevo_details,Complete the sixth course at the Lumbridge Combat Academy.
param=task_step_1_arrow,0_50_50_10_56
param=task_step_1,Talk to <col=0xF0BE79>Lady Deathknell</col> at the <col=0xF0BE79>Lumbridge Combat Academy</col>.
param=cheevo_game,1
param=task_optional,1

