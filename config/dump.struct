// 38112
[cheevo_path_rand_tele]
param=cheevo_name,Heimward Bound
param=cheevo_details,Teleport to Daemonheim with a Ring of Kinship.
param=cheevo_icon,"staticons_high_res2_clean,13"
param=cheevo_unique_id,577
param=task_step_1_arrow,0_44_53_42_14
param=task_step_1,<col=0xF0BE79>Talk to Bryll Thoksdottir</col> at the <col=0xF0BE79>Taverley pier</col> to sail to the <col=0xF0BE79>Daemonheim</col> peninsula.
param=task_step_2,Head north-west to the entrance to Daemonheim, and claim a <col=0xF0BE79>Ring of Kinship</col> from the <col=0xF0BE79>Dungeoneering tutor</col>.
param=task_step_3,<col=0xF0BE79>Right-click</col> the <col=0xF0BE79>Ring of Kinship</col> in your <col=0xF0BE79>backpack</col> and choose <col=0xF0BE79>Teleport to Daemonheim</col>.
param=task_step_3_mobile,<col=0xF0BE79>Long-press</col> the <col=0xF0BE79>Ring of Kinship</col> in your <col=0xF0BE79>backpack</col> and choose <col=0xF0BE79>Teleport to Daemonheim</col>.
param=task_information,Delve into the depths of the dungeon of Daemonheim. Fight monsters, collect keys, unlock doors, solve puzzles, defeat bosses, and use all the skills at your disposal, either alone or with your friends.<br>You gain experience in the <col=0xF0BE79>Dungeoneering</col> skill each time you complete a Daemonheim floor.
param=cheevo_game,1
param=task_optional,1
param=cheevo_popup,false

// 38113
[cheevo_path_rand_party]
param=cheevo_name,Party On, Dudes
param=cheevo_details,Form a Dungeoneering party.
param=cheevo_icon,"staticons_high_res2_clean,13"
param=cheevo_unique_id,578
param=task_step_1_arrow,0_53_58_60_8
param=task_step_1,Claim a Ring of Kinship if you have not already.
param=task_step_2,Ensure you're near the entrance to Daemonheim.
param=task_step_3,<col=0xF0BE79>Right-click</col> the <col=0xF0BE79>Ring of Kinship</col> and choose <col=0xF0BE79>Open Party Interface</col>.
param=task_step_3_mobile,<col=0xF0BE79>Long-press</col> the <col=0xF0BE79>Ring of Kinship</col> and choose <col=0xF0BE79>Open Party Interface</col>.
param=task_step_4,On the party interface, left-click <col=0xF0BE79>Form Party</col> to start a Dungeoneering group.
param=task_step_4_mobile,On the party interface, tap <col=0xF0BE79>Form Party</col> to start a Dungeoneering group.
param=task_information,Once you have a party, you can raid floors of the Daemonheim dungeons to earn Dungeoneering experience and tokens.<br>You can invite up to four additional players to join your party, or delve into Daemonheim alone.
param=cheevo_game,1
param=task_optional,1
param=cheevo_popup,false

// 38114
[cheevo_path_rand_floor]
param=cheevo_name,Raiders of the Frost Dark
param=cheevo_details,Complete a Dungeoneering floor.
param=cheevo_icon,"staticons_high_res2_clean,13"
param=cheevo_unique_id,579
param=task_step_1_arrow,0_53_58_53_11
param=task_step_1,Form a Dungeoneering party (see the <col=0xF0BE79>Party On, Dudes</col> achievement).
param=task_step_2,Daemonheim provides its own equipment. If you are carrying items that cannot be taken into Daemonheim, deposit them at the Fremennik banker.
param=task_step_3,Left-click the <col=0xF0BE79>dungeon entrance</col>, choose the level and complexity to raid, and <col=0xF0BE79>enter the dungeon</col>!
param=task_step_3_mobile,Tap the <col=0xF0BE79>dungeon entrance</col>, choose the level and complexity to raid, and <col=0xF0BE79>enter the dungeon</col>!
param=task_step_4,Navigate the dungeon using all your skills, defeat the boss, and proceed to the next floor.
param=task_information,Increasing your Dungeoneering level opens more floors of Daemonheim and allows access to secret resource dungeons in the rest of Gielinor.<br>Dungeoneering tokens can be traded for powerful items and abilities.
param=cheevo_game,1
param=task_optional,1
param=cheevo_popup,false

// 38115
[cheevo_path_buy_house]
param=cheevo_name,Unreal Estate, Man
param=cheevo_details,Buy a house of your own.
param=cheevo_icon,"staticons_high_res2_clean,6"
param=cheevo_unique_id,580
param=task_step_1_arrow,0_46_50_9_29
param=task_step_1,Obtain <col=0xF0BE79>1,000 coins</col> by any means necessary.
param=task_step_2,Visit <col=0xF0BE79>Alfred Stonemason</col>, the Construction tutor in <col=0xF0BE79>Rimmington</col> (or the estate agent in Ardougne, Varrock or Falador).
param=task_step_3,Ask the estate agent how you can get your very own house, and buy it.
param=task_information,Once you have a plot of your own, you can start building a customised house on it.
param=cheevo_game,1
param=task_optional,1
param=cheevo_popup,true

// 38116
[cheevo_path_build_room]
param=cheevo_name,Room to Manoeuvre
param=cheevo_details,Build a room in your house (such as a kitchen).
param=cheevo_icon,"staticons_high_res2_clean,6"
param=cheevo_unique_id,581
param=task_step_1_arrow,0_46_50_8_25
param=task_step_1,You need at least <col=0xF0BE79>5,000 coins</col> to build a kitchen.
param=task_step_2,A kitchen requires <col=0xF0BE79>level 5 Construction</col>. You can increase your Construction level by building furniture in your parlour and garden.
param=task_step_3,Visit your house in <col=0xF0BE79>Building Mode</col> via the <col=0xF0BE79>house portal</col>.
param=task_step_4,<col=0xF0BE79>Right-click</col> any <col=0xF0BE79>door hotspot</col> and choose to <col=0xF0BE79>build</col> a <col=0xF0BE79>kitchen</col>.
param=task_step_4_mobile,<col=0xF0BE79>Long-press</col> any <col=0xF0BE79>door hotspot</col> and choose to <col=0xF0BE79>build</col> a <col=0xF0BE79>kitchen</col>.
param=task_step_5,Rotate the room to your satisfaction and confirm your purchase to build it.
param=task_information,You can personalise a room you have built with furniture and fixtures.
param=task_requirement_1_type,22
param=task_requirement_1_value,5
param=cheevo_game,1
param=task_optional,1
param=cheevo_popup,true

// 38117
[cheevo_path_build_chair]
param=cheevo_name,About to Drop the Hammer
param=cheevo_details,Build an item of furniture in your house (such as a crude chair in the parlour).
param=cheevo_icon,"staticons_high_res2_clean,6"
param=cheevo_unique_id,582
param=task_step_1_arrow,0_46_50_8_25
param=task_step_1,You will need <col=0xF0BE79>at least 2 planks</col> and <col=0xF0BE79>at least 2 nails</col>. (You start with a hammer and saw in your tool belt.)
param=task_step_2,Visit your house in <col=0xF0BE79>Building Mode</col> via the <col=0xF0BE79>house portal</col>.
param=task_step_3,<col=0xF0BE79>Left-click</col> the <col=0xF0BE79>chair space</col> hotspot in your <col=0xF0BE79>parlour</col> and choose to <col=0xF0BE79>build</col> a <col=0xF0BE79>crude wooden chair</col>.
param=task_step_3_mobile,<col=0xF0BE79>Tap</col> the <col=0xF0BE79>chair space</col> hotspot in your <col=0xF0BE79>parlour</col> and choose to <col=0xF0BE79>build</col> a <col=0xF0BE79>crude wooden chair</col>.
param=task_step_4,If your skill is higher, you may build in any hotspot you wish to complete this achievement.
param=task_information,Building furniture is the primary way to improve your Construction skill and increase the rooms and furnishings you have access to. You need <col=0xF0BE79>14 planks</col> and <col=0xF0BE79>at least 40 nails</col> to build all the wood furniture in your parlour.
param=cheevo_game,1
param=task_optional,1
param=cheevo_popup,true

