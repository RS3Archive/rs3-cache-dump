// 29799
[dom_boss_rotm_waves]
param=dom_boss_name,Khazard and Lucien
param=dom_boss_id,52
param=dom_boss_npc_safe_1,dom_wave_khazard_safe
param=dom_boss_npc_combat_1,dom_wave_khazard
param=dom_boss_npc_safe_2,dom_wave_lucien_safe
param=dom_boss_npc_combat_2,dom_wave_lucien
param=dom_npc_spawn_npc1_x,37
param=dom_npc_spawn_npc1_z,30
param=dom_npc_spawn_npc2_x,37
param=dom_npc_spawn_npc2_z,32
param=dom_arena_type,2
param=dom_boss_desc,A snapshot of the epic battle with Lucien over the Mahjarrat ritual site. Face Khazard, followed by Lucien's minions.<br><br><col=F5B241>Quest</col>: Ritual of the Mahjarrat<br><br><col=F5B241>Combat</col>: First, you must face Khazard. While using magic attacks, he will unleash his dog, Bouncer on you. Luckily Wahisietel will join you to destroy Bouncer if you're in his range. With Khazard down, you must face Lucien's ice titans. When encased in ice, struggle to free yourself quickly! Finally, take down Lucien's ice demons while avoiding being trapped by their ice spikes to finish the battle.
param=dom_boss_2_taunt,You dare attack a god?
param=dom_boss_taunt_sound_english,mah5_lucien_you_dare
param=dom_boss_taunt_sound_german,mah5_lucien_you_dare
param=dom_boss_taunt_sound_french,mah5_lucien_you_dare
param=dom_boss_taunt_sound_portuguese,mah5_lucien_you_dare
param=dom_battle_total_lifepoints,159000
param=dom_boss_spline_size,0
param=dom_boss_thumbnail,domtower_icon_khazard_lucien

// 29800
[dom_boss_dawn]
param=dom_boss_name,Dawn
param=dom_boss_id,53
param=dom_boss_npc_safe_1,dom_dawn_safe
param=dom_boss_npc_combat_1,dom_dawn_combat
param=dom_npc_spawn_npc1_x,37
param=dom_npc_spawn_npc1_z,31
param=dom_arena_type,2
param=dom_boss_desc,A Zamorakian mage who attempted to steal the Wand of Resurrection, but was pursued and defeated before she could get away with it.<br><br><col=F5B241>Quest</col>: The Death of Chivalry<br><br><col=F5B241>Combat</col>: Dawn uses her magical abilities to her advantage, casting spells that can knock her opponents away and summoning the dead to assist her in battle. Take down these skeletal warriors first then focus on defeating her.
param=dom_boss_1_taunt,Suffer!
param=dom_boss_taunt_sound_english,dom_rework_owen1_brk_hex_dwn_002
param=dom_boss_taunt_sound_german,dom_rework_owen1_brk_hex_dwn_002
param=dom_boss_taunt_sound_french,dom_rework_owen1_brk_hex_dwn_002
param=dom_boss_taunt_sound_portuguese,dom_rework_owen1_brk_hex_dwn_002
param=dom_battle_total_lifepoints,8000
param=dom_boss_spline_size,0
param=dom_boss_thumbnail,domtower_icon_dawn

// 29801
[dom_boss_enak_zemo]
param=dom_boss_name,Zemouregal and Enakhra
param=dom_boss_id,54
param=dom_boss_npc_safe_1,dom_zemouregal_safe
param=dom_boss_npc_safe_2,dom_enakhra_safe
param=dom_boss_npc_combat_1,dom_zemouregal_combat
param=dom_boss_npc_combat_2,dom_enakhra_combat
param=dom_npc_spawn_npc1_x,37
param=dom_npc_spawn_npc1_z,30
param=dom_npc_spawn_npc2_x,37
param=dom_npc_spawn_npc2_z,32
param=dom_arena_type,4
param=dom_boss_desc,Faithful servants of Zamorak, Enakhra and Zemouregal fight with burning passion and hatred.<br><br><col=F5B241>Quest</col>: The World Wakes<br><br><col=F5B241>Combat</col>: Consider your priorities when taking on both Mahjarrat at the same time. Enakhra uses magic attacks, and has two special moves in her repertoire. If she begins to drain health, you must hide or interrupt her. If she pins you, you must struggle to be freed. Zemouregal also fights with magic, and he will summon decaying portals. Beware of these as they will drain life from you if you are nearby. They can be avoided or destroyed.
param=dom_boss_1_taunt,Begone human. You have no place here.
param=dom_boss_taunt_sound_english,mpd_ent_zem_121
param=dom_boss_taunt_sound_german,mpd_ent_zem_121
param=dom_boss_taunt_sound_french,mpd_ent_zem_121
param=dom_boss_taunt_sound_portuguese,mpd_ent_zem_121
param=dom_battle_total_lifepoints,60000
param=dom_boss_spline_size,0
param=dom_boss_thumbnail,domtower_icon_zemouregal_enakhra

// 29802
[dom_boss_yelps]
param=dom_boss_name,Yelps
param=dom_boss_id,55
param=dom_boss_npc_safe_1,dom_yelps_safe
param=dom_boss_npc_combat_1,dom_yelps_combat
param=dom_npc_spawn_npc1_x,37
param=dom_npc_spawn_npc1_z,31
param=dom_boss_npc_safe_2,dom_mercenary_safe
param=dom_boss_npc_combat_2,dom_mercenary_fight
