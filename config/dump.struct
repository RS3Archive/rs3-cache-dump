// 36985
[cheevo_atfrem_easy_reward]
param=cheevo_name,Fremennik Set Tasks - Easy
param=cheevo_details,Given by the council workman on the bridge south of Rellekka for completing all Easy Tasks in the Fremennik Province.
param=cheevo_rewards,Fremennik sea boots 1 and a magic lamp worth 5,000xp in a skill of your choice.<br>The boots confer the following benefits:<br>- Contact the Fossegrimmen at a distance to recharge your lyre with one fewer charge.<br>Peer the Seer will deposit items into your bank for you.<br>When charging your lyre at the Fossegrimmen's altar you will receive one extra charge.
param=cheevo_icon,"shields,12"
param=cheevo_meta_list,cheevo_fremennik_easy
param=cheevo_meta_list_type,0
param=cheevo_is_meta,1
param=cheevo_unique_id,1329
param=cheevo_meta_id,1702
param=cheevo_runescore,5

// 36986
[cheevo_atfrem_medium_reward]
param=cheevo_name,Fremennik Set Tasks - Medium
param=cheevo_details,Given by Yrsa in Rellekka for completing all Medium Tasks in the Fremennik Province.
param=cheevo_rewards,Fremennik sea boots 2 and a magic lamp worth 10,000xp in a skill of your choice.<br>The boots gain the following extra benefits:<br>- One chargeless teleport with the lyre per day.<br>- Shortcut between the piers of Etceteria and Miscellania.<br>Your kingdom's approval rating will increase faster.
param=cheevo_icon,"shields,13"
param=cheevo_meta_list,cheevo_fremennik_medium
param=cheevo_meta_list_type,0
param=cheevo_is_meta,1
param=cheevo_unique_id,1330
param=cheevo_meta_id,1702
param=cheevo_runescore,10

// 36987
[cheevo_atfrem_hard_reward]
param=cheevo_name,Fremennik Set Tasks - Hard
param=cheevo_details,Given by Advisor Ghrim in Miscellania for completing all Hard Tasks in the Fremennik Province.
param=cheevo_rewards,Fremennik sea boots 3 and a magic lamp worth 15,000xp in a skill of your choice.<br>You will gain the following extra benefits:<br>Talk to the bard in Rellekka to toggle your lyre teleport destination to Waterbirth Island or Rellekka market.<br>Ability to change to Lunar spellbook in Prifddinas.
param=cheevo_icon,"shields,14"
param=cheevo_meta_list,cheevo_fremennik_hard
param=cheevo_meta_list_type,0
param=cheevo_is_meta,1
param=cheevo_unique_id,1331
param=cheevo_meta_id,1702
param=cheevo_runescore,15

// 36988
[cheevo_atfrem_elite_reward]
param=cheevo_name,Fremennik Set Tasks - Elite
param=cheevo_details,Given by Advisor Ghrim in Miscellania for completing all Elite Tasks in the Fremennik Province.
param=cheevo_rewards,Fremennik sea boots 4 and a set of magic lamps worth a total of 160,000xp in five skills of your choice.<br>The boots gain the following extra benefits:<br>- The Dagannoth Kings will drop some items noted.<br>- Unlimited teleports to the centre of Rellekka market.<br>- I will also deal more damage to the Dagannoth Kings.<br>- I can access a new section of Jatizso's mine.<br>Talk to Rimae Sirsalis to exchange Suqah hide and teeth for rune essence. Use the seal of passage to teleport to Lunar Isle. Use the NPC contact spell to change your Lunar spellbook to the standard spellbook.<br>Talk to Olaf the Bard in Rellekka to toggle your lyre teleport to Jatizso, Neitiznot, Miscellania or Etceteria.
param=cheevo_icon,"shields,15"
param=cheevo_meta_list,cheevo_fremennik_elite
param=cheevo_meta_list_type,0
param=cheevo_is_meta,1
param=cheevo_unique_id,1332
param=cheevo_meta_id,1702
param=cheevo_runescore,25

