[task_familiarisation]
param=task_name,Familiarisation
param=task_details,Project yourself into the spirit plane and help collect spirit shards.
param=task_rewards,Gives <col=ffffff>Summoning</col> experience and a <col=ffffff>Summoning boost</col> or <col=ffffff>Summoning supplies</col>.
param=task_step_1,To play you will need to find <col=ffffff>Pikkenmix</col>. Speak to <col=ffffff>Pikkupstix</col> in <col=ffffff>Taverley</col> for more information on where he could be.
param=task_step_2,Summoning obelisks are only active for <col=ffffff>20 minutes</col> but there is always a new one <col=ffffff>every 2 hours</col> or so.
param=task_step_3,You can collect the reward for this task <col=ffffff>once per week</col>.
param=task_step_1_arrow,0_45_53_47_56
param=task_step_2_arrow,0_45_53_47_56
param=task_step_3_arrow,0_45_53_47_56
param=task_step_4_arrow,0_45_53_47_56
param=task_auto_arrow,1
param=task_icon,"task_icons_48_60,7"
param=task_set,63
param=task_unique_id,3049
param=task_area,0
param=task_requirement_1_type,62
param=task_next_id,3050
param=task_optional,1
