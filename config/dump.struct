// 35874
[cheevo_atwild_easy_reward]
param=cheevo_name,Wilderness Set Tasks - Easy
param=cheevo_details,Given by Mr Ex, north of Edgeville bank, for completing all Easy Tasks in the Wilderness.
param=cheevo_icon,"shields,80"
param=cheevo_unique_id,1353
param=cheevo_meta_list,cheevo_wilderness_easy
param=cheevo_meta_list_type,0
param=cheevo_is_meta,1
param=cheevo_rewards,Permanent benefits:<br>- Free teleports to the Wilderness Farming patch, using the Wilderness sword<br>- Free teleports to Edgeville, using the Wilderness sword.<br>- Ability to locate the WildyWyrm with the Wilderness sword if there is one spawned on the world.<br>- +100% Prayer XP when offering bones or ashes at the Wilderness Chaos Altar.
param=cheevo_meta_id,1702
param=cheevo_runescore,5

// 35875
[cheevo_atwild_medium_reward]
param=cheevo_name,Wilderness Set Tasks - Medium
param=cheevo_details,Given by Mandrith, in Edgeville, for completing all Medium Tasks in the Wilderness.
param=cheevo_icon,"shields,81"
param=cheevo_unique_id,1354
param=cheevo_meta_list,cheevo_wilderness_medium
param=cheevo_meta_list_type,0
param=cheevo_is_meta,1
param=cheevo_rewards,Permanent benefits:<br>- All of the benefits from the easy task set.<br>- +5% XP per lap completion at the Wilderness Agility course with the Wilderness sword equipped or in your inventory.<br>- Improved pickpocketing rates against Rogues in the Wilderness.<br>- Free teleports to the Forinthry dungeon, using the Wilderness sword.<br>- +150% Prayer XP when offering bones or ashes at the Wilderness Chaos Altar.
param=cheevo_meta_id,1702
param=cheevo_runescore,10

// 35876
[cheevo_atwild_hard_reward]
param=cheevo_name,Wilderness Set Tasks - Hard
param=cheevo_details,Given by Quercus, at the ditch north of the Grand Exchange, for completing all Hard Tasks in the Wilderness.
param=cheevo_icon,"shields,82"
param=cheevo_unique_id,1355
param=cheevo_meta_list,cheevo_wilderness_hard
param=cheevo_meta_list_type,0
param=cheevo_is_meta,1
param=cheevo_rewards,Permanent benefits:<br>- All of the benefits from the easy & medium task set.<br>- The ability to un-note items with Harrison near the Chaos altar.<br>- A new shortcut to the Air Obelisk north of Edgeville.<br>- Teleporting to the Wilderness lodestone will always be a quick teleport.<br>- The Wilderness herb patch will never become diseased.<br>- Ability to choose your arrival destination at the Ancient Obelisks in the Wilderness.<br>- Chance to teleport to the center of the Abyss when teleporting via the Mage of Zamorak with the Wilderness sword equipped.<br>- +200% Prayer XP when offering bones or ashes at the Wilderness Chaos Altar.
param=cheevo_meta_id,1702
param=cheevo_runescore,15

// 35877
[cheevo_atwild_elite_reward]
param=cheevo_name,Wilderness Set Tasks - Elite
param=cheevo_details,Given by Kolodion, in the Mage Arena bank, for completing all Elite Tasks in the Wilderness.
param=cheevo_icon,"shields,83"
param=cheevo_unique_id,1356
param=cheevo_meta_list,cheevo_wilderness_elite
param=cheevo_meta_list_type,0
param=cheevo_is_meta,1
param=cheevo_rewards,Permanent benefits:<br>- All of the benefits from the easy, medium & hard task set.<br>- Searing ashes will always drop noted when carrying the Wilderness sword.<br>- Free teleports to the Wilderness Agility course with the Wilderness sword.<br>- Teleports with the Wilderness sword will work from level 30 Wilderness up from level 20.<br>- Improved Ancient warrior equipment drop rates when defeating revenants in the Forinthry dungeon.<br>- When in the Wilderness, completion of the Animal Magnetism quest will allow team capes to provide the effects of the Ava's device.<br>- +250% Prayer XP when offering bones or ashes at the Wilderness Chaos Altar.
param=cheevo_meta_id,1702
param=cheevo_runescore,25

