// 29801
[struct_29801]
param=param_2095,Zemouregal and Enakhra
param=param_2096,54
param=param_2153,npc_17262
param=param_2154,npc_17260
param=param_2168,npc_17263
param=param_2169,npc_17261
param=param_2123,37
param=param_2124,30
param=param_2125,37
param=param_2126,32
param=param_2097,4
param=param_2184,Faithful servants of Zamorak, Enakhra and Zemouregal fight with burning passion and hatred.<br><br><col=F5B241>Quest</col>: The World Wakes<br><br><col=F5B241>Combat</col>: Consider your priorities when taking on both Mahjarrat at the same time. Enakhra uses magic attacks, and has two special moves in her repertoire. If she begins to drain health, you must hide or interrupt her. If she pins you, you must struggle to be freed. Zemouregal also fights with magic, and he will summon decaying portals. Beware of these as they will drain life from you if you are nearby. They can be avoided or destroyed.
param=param_2102,Begone human. You have no place here.
param=param_2118,sound_40705
param=param_2119,sound_40705
param=param_2120,sound_40705
param=param_2121,sound_40705
param=param_2122,60000
param=param_2099,0
param=param_2101,domtower_icon_zemouregal_enakhra

// 29802
[struct_29802]
param=param_2095,Yelps
param=param_2096,55
param=param_2153,npc_20453
param=param_2168,npc_20454
param=param_2123,37
param=param_2124,31
param=param_2154,npc_20455
param=param_2169,npc_20456
param=param_2125,37
param=param_2126,30
param=param_2155,npc_20455
param=param_2170,npc_20456
param=param_2127,37
param=param_2128,32
param=param_2097,2
param=param_2184,Yelps is back for another beating. He will use his wealth and sneaky cunning to protect himself in battle.<br><br><col=F5B241>Quest</col>: The Mighty Fall<br><br><col=F5B241>Combat</col>: Yelps has the ability to perform his 'extra spin for the win' attack, which can inflict high damage. Unlike his previous version of this attack, this one will track you around the arena instead of randomly moving, so keep running!  He can also call on hired goons to help beat you up when it looks like things will go badly for him.  While they are active, he will take less damage.
param=param_2102,Extra spin for the win!
param=param_2118,sound_614
param=param_2119,sound_614
param=param_2120,sound_614
param=param_2121,sound_614
param=param_2122,200000
param=param_2099,0
param=param_2101,domtower_icon_yelps

