// 50237
[timed_event_variety_task_events_sanctum]
param=timed_event_start,8244
param=timed_event_end,8257
param=timed_event_cleanup,8265
param=timed_event_name,Gate of Elidinis Hunt
param=timed_event_desc,Talk to a <col=00FFFF>Priestess of Elidinis</col>, outside the <col=00FFFF>Sanctum of Rebirth</col> or in the <col=00FFFF>Grand Exchange</col>, to take part in the Gate of Elidinis Hunt!<br><br>Members can complete 8 tasks to earn <col=00FFFF>Moonstone shards</col> which can be combined into these rewards:<br><br>- <col=00FFFF>Divine Moon Guard and Lantern overrides</col>: A tradeable token used to unlock new Necromancy weapon overrides.<br>- <col=00FFFF>Gate of Elidinis rare drop enhancer</col>: Increases the chance of getting a rare drop from the Gate of Elidinis by 10%. Lasts 14 days.<br>- <col=00FFFF>Infinite Porter</col>: Transports specific items to the bank automatically. Lasts 14 days.<br>- <col=00FFFF>Skilling Potion Cauldrons</col>: Provides Agility, Crafting, Super mining, and Extreme divination potion effects for 60 minutes. Located in War's Retreat. Lasts 14 days.<col=0xEB2F2F>*</col><br><br>Additionally, gain a <col=00FFFF>big event mystery box</col> for each shard found.<br><br><col=0xEB2F2F>* Not available for Ironmen.</col>
param=timed_event_id,36
param=timed_event_type,3
param=side_tab_1_layer,timed_event:additional_interface_layer
param=side_tab_1_tooltip,Summary
param=ribbon_override_icon,event_sanctum_shard_icon_main
param=timed_event_btn_bg,rs3_btn_menu_0
param=timed_event_banner_en,event_sanctum_shard_ui_banner_en
param=timed_event_banner_de,event_sanctum_shard_ui_banner_de
param=timed_event_banner_fr,event_sanctum_shard_ui_banner_fr
param=timed_event_banner_pt,event_sanctum_shard_ui_banner_pt
param=variety_task_events_tasks_total,12
param=variety_task_events_progress_items_required,8
param=variety_task_events_reward_claim_info,Talk to a Priestess of Elidinis, outside the Sanctum of Rebirth or in the Grand Exchange, to claim your reward.
param=variety_task_events_reclaim_info,You can reclaim this from a Priestess of Elidinis, outside the Sanctum of Rebirth or in the Grand Exchange.
param=variety_task_events_rewards_gameplay_buffs,true
