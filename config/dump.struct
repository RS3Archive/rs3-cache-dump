param=dom_boss_id,14
param=dom_boss_npc_safe_1,dom_jungle_demon_safe
param=dom_boss_npc_combat_1,dom_jungle_demon_combat
param=dom_npc_spawn_npc1_x,37
param=dom_npc_spawn_npc1_z,30
param=dom_arena_type,1
param=dom_boss_desc,This big, lean, green killing machine is hardly friendly. Like all demons this one exists to slice its enemies to pieces with its claws or damage them with its magic powers.<br><br><col=F5B241>Quest</col>: Monkey Madness<br><br><col=F5B241>Combat</col>: The demon attacks with a mixture of melee and magic and will alter its attacks based on any protection prayers you use. There are no gnomes to help you out this time!
param=dom_boss_1_taunt,Rarrrr
param=dom_boss_taunt_sound_english,greater_demon_attack_2
param=dom_boss_taunt_sound_german,greater_demon_attack_2
param=dom_boss_taunt_sound_french,greater_demon_attack_2
param=dom_boss_taunt_sound_portuguese,greater_demon_attack_2
param=dom_battle_total_lifepoints,15000
param=dom_boss_spline_size,0
