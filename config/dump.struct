// 4095
[struct_4095]
param=param_463,Abyssal demons
param=param_460,180
param=param_462,Abyssal demons are nasty creatures to deal with. They aren't really part of this realm and are able to move very quickly to trap their prey. They can be found south of the Lava Maze.
param=param_466,85
param=param_659,npc_1615

// 4096
[struct_4096]
param=param_463,gargoyles
param=param_460,46
param=param_462,Gargoyles are winged creatures of stone. You'll need to fight them until they are close to death before breaking them apart with a rock hammer. They can be found in the eastern ruins, north of the Graveyard of Shadows.
param=param_466,75
param=param_659,npc_1610

// 4097
[struct_4097]
param=param_463,acheron mammoths
param=param_460,133
param=param_462,Acheron mammoths are honourable yet powerful beasts from the frozen north. When they charge you, get out of the way! They can be found in the snow to the west of here.
param=param_465,100
param=param_466,96
param=param_659,npc_22007

// 4098
[struct_4098]
param=param_463,black demons
param=param_460,30
param=param_462,Black demons are weak to ranged attacks. They're still the strongest demon and very dangerous, however. They can be found near the Demonic Ruins.
param=param_659,npc_84

// 4099
[struct_4099]
param=param_463,ripper demons
param=param_460,131
param=param_462,Ripper Demons are driven crazy by the scent of blood. They will hit you harder the worse your injuries are. And watch out - they can sometimes drop on you from above, which is lethal.  They can be found north of Red Dragon Isle.
param=param_465,100
param=param_466,96
param=param_659,npc_21994

// 4100
[struct_4100]
param=param_463,ice strykewyrms
param=param_460,105
param=param_462,The coldest of their kind, they are found on the Frozen Waste Plateau. As they are beings of ice, I've found that fire spells inflict far more damage against them.
param=param_466,93
param=param_659,npc_9463

// 4101
[struct_4101]
param=param_463,Kal'gerion demons
param=param_460,121
param=param_462,Kal'gerion demons are powerful creatures that use both magic and melee. They reside near the Demonic Ruins. I would recommend you take cover when they smash the ground, or when they use magic to pull you towards them.
param=param_659,npc_14977
param=param_466,90

// 4102
[struct_4102]
param=param_463,lava strykewyrms
param=param_460,126
param=param_462,Lava strykewyrms are the most powerful of their kind. They attack with all combat styles and are weak to nothing. They can be found deep within the Wilderness to the south-west of the Lava Maze. I would watch your back while slaying them.
param=param_466,94
param=param_659,npc_20630

// 4103
[struct_4103]
param=param_463,dark beasts
param=param_460,66
param=param_462,Dark beasts are large, dog-like predators with massively muscled bodies that protect them from crushing weapons. They can be found south of the Lava Maze.
param=param_466,90
param=param_659,npc_2783

