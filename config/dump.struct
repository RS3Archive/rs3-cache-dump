param=rewardshop_buy_option_1,1
param=rewardshop_members,1
param=rewardshop_tooltip,Grants 1% bonus Runecrafting XP while worn. A full set grants an additional 1% bonus.
param=rewardshop_usetooltip,1

// 35476
[bslay_gwd2_solo_boss_phase_two]
param=bslay_tactic_title,Phase two - Corruption
param=bslay_tactic_text,Upon entering phase two, Telos gains the ability to use onslaught. Alongside this, the beam is now corrupt.

// 35477
[bslay_gwd2_solo_boss_beam_black]
param=bslay_tactic_title,Beam of corrupt anima
param=bslay_tactic_text,A black beam of anima will appear across the platform. Standing inside the beam will reduce all damage taken & damage dealt. This has the same effect on Telos if stood inside the beam.

// 35478
[bslay_gwd2_solo_boss_onslaught]
param=bslay_tactic_title,Onslaught
param=bslay_tactic_text,Telos begins channelling onslaught,which is a magic attack with each consecutive hit becoming stronger. This ability continues until Telos is drained of anima.
param=bslay_tactic_animation,gwd2_solo_boss_ranged

// 35479
[bslay_gwd2_solo_boss_phase_three]
param=bslay_tactic_title,Phase three - Volcanic
param=bslay_tactic_text,Telos attacks primarily with <col=FFFFFF>magic</col>, and gains two additional abilities depending on its anima. Minions will also be charging Telos with anima.

// 35480
[bslay_gwd2_solo_boss_phase_three_minions]
param=bslay_tactic_title,Charging golems
param=bslay_tactic_text,Three charging minions will be active, charging Telos with anima. They can be brought to 0 health to prevent them from charging Telos, however will regenerate after a short period of time.

// 35481
[bslay_gwd2_solo_boss_drain_adrenaline]
param=bslay_tactic_title,Adrenaline drain
param=bslay_tactic_text,If Telos' anima is in the lower red section of the bar, It will periodically drain your adrenaline.

// 35482
[bslay_gwd2_solo_boss_explosion]
param=bslay_tactic_title,Explosion
param=bslay_tactic_text,If Telos' anima is in the higher red section of the bar, it periodically causes explosions, dealing high amounts of damage.

// 35483
[bslay_gwd2_solo_boss_phase_four]
param=bslay_tactic_title,Phase four - Overwhelmed
param=bslay_tactic_text,Telos attacks primarily with <col=FFFFFF>melee</col>, however will begin to use <col=FFFFFF>magic</col> if out of range.

// 35484
[bslay_gwd2_solo_boss_summon_minions]
param=bslay_tactic_title,Golems of anima
param=bslay_tactic_text,Telos gains the ability to summon three minions when reaching a certain percentage of health remaining. All of the summoned minions will deal <col=FFFFFF>melee</col> damage.

// 35485
[bslay_gwd2_solo_boss_minion_green]
param=bslay_tactic_title,Pure golem
param=bslay_tactic_text,Pure golems deal significantly more damage than the others.
param=bslay_tactic_new_npc,gwd2_solo_tank_add_damage

// 35486
[bslay_gwd2_solo_boss_minion_black]
param=bslay_tactic_title,Corrupt golem
param=bslay_tactic_text,Corrupt golems add the break armour stacking debuff, reducing the targets armour by 1% per stack.
param=bslay_tactic_new_npc,gwd2_solo_tank_add_armour

// 35487
[bslay_gwd2_solo_boss_minion_red]
param=bslay_tactic_title,Volcanic golem
param=bslay_tactic_text,Volcanic golems have the ability to stun and bind their target.
param=bslay_tactic_new_npc,gwd2_solo_tank_add_stun

// 35488
[bslay_gwd2_solo_boss_draw_power]
param=bslay_tactic_title,Draw power
param=bslay_tactic_text,Telos begins to draw power from an active font, until reaching enough power to launch an instant-kill attack. Standing beside the fonts for long enough will provide a shield from this attack.
param=bslay_tactic_animation,gwd2_solo_boss_font_siphon

// 35489
[bslay_gwd2_solo_boss_phase_five]
param=bslay_tactic_title,Phase five - It's not over yet! (100% enrage)
param=bslay_tactic_text,Telos rises from the pool of anima, gaining new abilities.

// 35490
[bslay_gwd2_solo_boss_phase_five_beams]
param=bslay_tactic_title,All of the beams
param=bslay_tactic_text,All beams seen in phases one, two & three will be active during this phase. They will periodically switch positions with other active beams.

// 35491
[bslay_gwd2_solo_boss_phase_five_minions]
param=bslay_tactic_title,All of the minions
param=bslay_tactic_text,Telos summons six minions of one specific type. These minions must be killed beside their respective font to charge it. Once charged it can be used to interrupt Telos's devastating attack.

// 35492
[bslay_gwd2_solo_boss_phase_five_rocks]
param=bslay_tactic_title,Rockfall
param=bslay_tactic_text,High damage dealing rocks begin to fall at the current location, dealing high damage on hit.

// 35493
[bslay_gwd2_solo_boss_phase_five_instakill]
param=bslay_tactic_title,The end
param=bslay_tactic_text,Telos begins charging an instant-kill attack, which can only be prevented by using an active font against it.
param=bslay_tactic_animation,gwd2_solo_boss_large_charge

// 35494
[bslay_gwd2_solo_boss_phase_five_no_immortality]
param=bslay_tactic_title,I don't think so (1000%+ enrage)
param=bslay_tactic_text,Immortality no longer works against "The end" attack.

// 35495
[bslay_gwd2_solo_boss_phase_five_increased_rockfall]
param=bslay_tactic_title,Shake the roof (1000%+ enrage)
param=bslay_tactic_text,Five rocks will now fall instead of one.

