// 16735
[pop_voyage_story_assassin_1]
param=pop_voyage_id,32748
param=pop_voyage_name,Meet the Assassin
param=pop_voyage_type,6
param=pop_voyage_text,Investigate the deaths of several westerners in Waiko. Locals claim it to be the work of Incha, the sea harpy.
param=pop_voyage_success_text,Sea harpies had nothing to do with the murders. An assassin named Ling was caught running from a gutted merchant in Waiko. She has been brought to you for interrogation.
param=pop_voyage_duration,2500
param=pop_voyage_combatdiff,1200
param=pop_voyage_seafaringdiff,0
param=pop_voyage_graftdiff,0
