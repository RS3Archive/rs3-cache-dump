// 50697
[struct_50697]

// 50698
[slayer_raptor_list_entry_15]
param=slayer_name,greater demons
param=slayer_type,29
param=slayer_description,Greater demons are relatively weak, however, you should still be careful as they can be dangerous. They can be found in Brimhaven Dungeon. Using crossbows would be advantageous.
param=slayer_sl_req,1
param=slayer_example_npc,greater_demon

// 50699
[slayer_raptor_list_entry_16]
param=slayer_name,lesser demons
param=slayer_type,28
param=slayer_description,Lesser demons are some of the weakest of all Avernic demons. They can be found inhabiting the Karamja Dungeon. Using crossbows would be advantageous.
param=slayer_sl_req,1
param=slayer_example_npc,lesser_demon

// 50700
[slayer_raptor_list_entry_17]
param=slayer_name,black demons
param=slayer_type,30
param=slayer_description,Black demons are among the strongest of the Avernic demons. They can be found within the Brimhaven and Taverley dungeons. Using crossbows would be advantageous.
param=slayer_cl_req,75
param=slayer_sl_req,1
param=slayer_example_npc,black_demon

// 50701
[slayer_raptor_list_entry_18]
param=slayer_name,fire giants
param=slayer_type,16
param=slayer_description,Like other giants, fire giants often wield large weapons. Learn to recognise what kind of weapon it is and act accordingly. They can be found in Brimhaven Dungeon. Using water spells would be advantageous.
param=slayer_cl_req,60
param=slayer_sl_req,1
param=slayer_example_npc,firegiant

// 50702
[slayer_raptor_list_entry_19]
param=slayer_name,grotworms
param=slayer_type,112
param=slayer_description,Grotworms have been spotted in a cave near Rimmington. They will bite and attack with some sort of acid spit.
param=slayer_sl_req,1
param=slayer_example_npc,qbd2_worm1

// 50703
[slayer_raptor_list_entry_20]
param=slayer_name,dagannoth
param=slayer_type,35
param=slayer_description,Dagannoth are large, sea-dwelling creatures that are very aggressive. You'll often find them in caves near seawater.
param=slayer_cl_req,60
param=slayer_sl_req,1
param=slayer_example_npc,horror_dagannoth_medium

// 50704
[slayer_raptor_list_entry_21]
param=slayer_name,aviansies
param=slayer_type,114
param=slayer_description,Aviansies can be found within the God Wars Dungeon north of Trollheim. As they fly, you'll find it difficult to reach them with melee weapons, so try using ranged or magic weapons instead.
param=slayer_sl_req,1
param=slayer_example_npc,godwars_armadyl_female_armor01_blue

// 50705
[slayer_raptor_list_entry_22]
param=slayer_name,kalphites
param=slayer_type,53
param=slayer_description,Kalphites are large insectoids that live in hives under the Kharidian desert. You can find them southwest of Shantay Pass.
param=slayer_sl_req,1
param=slayer_example_npc,kalphite_soldier

// 50706
[slayer_raptor_list_entry_23]
param=slayer_name,hellhounds
param=slayer_type,31
param=slayer_description,Hellhounds are Shakroth class Avernic demons, the lowest class of demons from Infernus. You can find them in Taverley Dungeon and will find slash weapons effective against them.
param=slayer_cl_req,70
param=slayer_sl_req,1
param=slayer_example_npc,hellhound

// 50707
[slayer_raptor_list_entry_24]
param=slayer_name,aberrant spectres
param=slayer_type,41
param=slayer_description,Aberrant spectres are fetid, vile ghosts. The very smell of them will paralyze and harm you. I would advise using a nose peg to avoid their stink. You would do well using a ranged weapon against them.
param=slayer_sl_req,60
param=slayer_example_npc,slayer_abberant_spectre_1

// 50708
[slayer_raptor_list_entry_25]
param=slayer_name,ripper demons
param=slayer_type,131
param=slayer_description,Ripper demons enjoy the bloodlust of battle, a sentiment I can agree with. They will expose your weaknesses, hitting you harder the worse your injuries are. They can be found in a fissure east of Al Kharid.
param=slayer_sl_req,96
param=slayer_example_npc,hlm_ripper

// 50709
[slayer_raptor_list_entry_26]
param=slayer_name,camel warriors
param=slayer_type,132
param=slayer_description,Camel Warriors use ancient magics to attack you. They can use cowardly disorientation magic to confuse you. You can find them in the deep desert, teach them a lesson in humility.
param=slayer_sl_req,96
param=slayer_example_npc,hlm_camel

// 50710
[slayer_raptor_list_entry_27]
param=slayer_name,acheron mammoths
param=slayer_type,133
param=slayer_description,Acheron mammoths are honourable and proud beasts from the frozen north that know the true worth of battle. When they charge you, ensure you get out of the way. They can be found on an iceberg that is accessible from a dock east of Rellekka.
param=slayer_sl_req,96
param=slayer_example_npc,hlm_mammoth

// 50711
[slayer_raptor_list_entry_28]
param=slayer_name,living wyverns
param=slayer_type,130
param=slayer_description,Living wyverns breathe a poison that will rapidly kill you unless you can freeze your blood using the glacial temperature of their home. But watch out; the colder you are, the harder their regular attacks will hit you. They can be found within the Asgarnia Ice Dungeon.
param=slayer_sl_req,96
param=slayer_example_npc,hlm_wyvern

// 50712
[slayer_raptor_list_entry_29]
param=slayer_name,dark beasts
param=slayer_type,66
param=slayer_description,Dark beasts are large, dog-like predators with massively muscled bodies that protect them from crushing weapons. They can be found within the Mourner tunnels.
param=slayer_sl_req,90
param=slayer_example_npc,mourning_dark_beast

// 50713
[slayer_raptor_list_entry_30]
param=slayer_name,ankou
param=slayer_type,79
param=slayer_description,Ankou are undead beings that can be described as neither ghost nor skeleton, but a combination of both. Not much is known about these creatures, however, they make their home in the Stronghold of Security.
param=slayer_sl_req,1
param=slayer_example_npc,sos_death_ankou

// 50714
[slayer_vannaka_list_entry_1]
param=slayer_name,skeletons
param=slayer_type,11
param=slayer_description,Skeletons are undead, so Magic is your best bet against them. Skeletons can be found in Edgeville Dungeon or Varrock sewers.
param=slayer_cl_req,15
param=slayer_sl_req,0
param=slayer_example_npc,skeleton_unarmed

// 50715
[slayer_vannaka_list_entry_2]
param=slayer_name,wolves
param=slayer_type,9
param=slayer_description,Wolves are pack animals, so you'll always find them in groups. Watch out for their bite, it can be nasty. There are plenty to kill on White Wolf Mountain.
param=slayer_cl_req,8
param=slayer_sl_req,0
param=slayer_example_npc,wolf

// 50716
[slayer_vannaka_list_entry_3]
param=slayer_name,kalphites
param=slayer_type,53
param=slayer_description,Kalphite are large insects that live in hives under the desert sands. You can best enter their hive south-west of Shantay Pass, but try not to go too deep.
param=slayer_cl_req,20
param=slayer_sl_req,0
param=slayer_example_npc,kalphite_worker

// 50717
[slayer_vannaka_list_entry_4]
param=slayer_name,mogres
param=slayer_type,67
param=slayer_description,Mogres are a type of aquatic ogre that is often mistaken for a giant mudskipper. You have to force them out of the water with a fishing explosive. You can find them on the peninsula to the south of Port Sarim.
param=slayer_cl_req,35
param=slayer_sl_req,32
param=slayer_example_npc,mudskipper_ogre

// 50718
[slayer_vannaka_list_entry_5]
param=slayer_name,ghosts
param=slayer_type,12
param=slayer_description,Ghosts play tricks and japes upon those entering Taverley Dungeon, so put them to rest. If you are after a bigger challenge you can find some stronger ghosts in the Stronghold of Security.
param=slayer_cl_req,25
param=slayer_sl_req,0
param=slayer_example_npc,ghost

// 50719
[slayer_vannaka_list_entry_6]
param=slayer_name,bears
param=slayer_type,13
param=slayer_description,Bears are tough creatures and fierce fighters, so watch out for their powerful claws. Bears have been spotted west of Gunnarsgrunn near the mysterious ruins. I heard a rumour of a stronger type of bear down a rift to the east of Varrock.
param=slayer_cl_req,20
param=slayer_sl_req,0
param=slayer_example_npc,darkbear

// 50720
[slayer_vannaka_list_entry_7]
param=slayer_name,zombies
param=slayer_type,10
param=slayer_description,Zombies are undead, so using magic against them is preferred. You should be able to find them roaming in the tunnels beneath Edgeville.
param=slayer_cl_req,10
param=slayer_sl_req,0
param=slayer_example_npc,zombie_unarmed_sewer1

// 50721
[slayer_vannaka_list_entry_8]
param=slayer_name,hill giants
param=slayer_type,14
param=slayer_description,Hill giants use crude weapons or tools so prepare accordingly. There is a colony of them, deep inside the Edgeville tunnels; all good folk will approve if you clean it out.
param=slayer_cl_req,40
param=slayer_sl_req,0
param=slayer_example_npc,giant

// 50722
[slayer_vannaka_list_entry_9]
param=slayer_name,cave slime
param=slayer_type,62
param=slayer_description,Cave slimes are the lesser cousins of jellies. Don't be fooled, though: they can still be dangerous as they're often poisonous. You'll do Lumbridge a favour if you kill the slimes in Lumbridge Swamp caves.
param=slayer_cl_req,25
param=slayer_sl_req,17
param=slayer_example_npc,swamp_cave_slime

// 50723
[slayer_vannaka_list_entry_10]
param=slayer_name,hobgoblins
param=slayer_type,21
param=slayer_description,Hobgoblins are larger and stronger then their brethren. There is a peninsula, south-west of Falador, where these creatures have a hideout.
param=slayer_cl_req,30
param=slayer_sl_req,0
param=slayer_example_npc,hobgoblin_armed

// 50724
[slayer_vannaka_list_entry_11]
param=slayer_name,flesh crawlers
param=slayer_type,77
param=slayer_description,Flesh crawlers are scavengers and will eat you and anyone else, given the chance. Save the weak by killing these creatures in the Stronghold of Security.
param=slayer_cl_req,38
param=slayer_sl_req,0
param=slayer_example_npc,sos_fam_fleshcrawler

// 50725
[slayer_vannaka_list_entry_12]
param=slayer_name,catablepon
param=slayer_type,78
param=slayer_description,Catablepon are cow-like, magical creatures that mainly live in the Stronghold of Security. Beware their weakening glare; cutting off their head could help.
param=slayer_cl_req,50
param=slayer_sl_req,0
param=slayer_example_npc,sos_pest_catablepon

// 50726
[slayer_vannaka_list_entry_13]
param=slayer_name,wall beasts
param=slayer_type,61
param=slayer_description,Wall beasts are really much larger creatures, but you'll only see their arms. You'll want something sharp on your head to stop them grabbing you. The geology of the caves beneath Lumbridge Swamp favours these creatures.
param=slayer_cl_req,45
param=slayer_sl_req,35
param=slayer_example_npc,swamp_wallbeast_combat

// 50727
[slayer_vannaka_list_entry_14]
param=slayer_name,ice warriors
param=slayer_type,19
param=slayer_description,Ice warriors are a kind of ice elemental. Thurgo the dwarf recently spotted some in the caves south of Port Sarim.
param=slayer_cl_req,50
param=slayer_sl_req,0
param=slayer_example_npc,icewarrior

// 50728
[slayer_vannaka_list_entry_15]
param=slayer_name,grotworms
param=slayer_type,112
param=slayer_description,Grotworms have recently been spotted in a cave near Rimmington. They will bite and attack with some sort of acid spit. Be careful - they are very aggressive.
param=slayer_cl_req,25
param=slayer_sl_req,0
param=slayer_example_npc,qbd2_worm1

// 50729
[slayer_vannaka_list_entry_16]
param=slayer_name,frogs
param=slayer_type,162
param=slayer_description,Frogs will attack and move faster than the average human. You can find frogs in the Lumbridge swamp and if you venture into the swamp caves you can find giant frogs.
param=slayer_sl_req,0
param=slayer_example_npc,giant_frog

// 50730
[slayer_vannaka_list_entry_17]
param=slayer_name,minotaurs
param=slayer_type,76
param=slayer_description,Minotaurs are large, man-like creatures, but you'll want to be careful of their horns. I hear they have set up camp under in the Stronghold of Security.
param=slayer_sl_req,0
param=slayer_example_npc,sos_war_minotaur

// 50731
[slayer_vannaka_list_entry_18]
param=slayer_name,spiders
param=slayer_type,4
param=slayer_description,Spiders are often venomous and many varieties are camouflaged, too. I've seen plenty to the south-west of Lumbridge. If you are up for a challenge you can find stronger spiders down in the Stronghold of Security.
param=slayer_sl_req,0
param=slayer_example_npc,giantspider1

// 50732
[slayer_vannaka_list_entry_19]
param=slayer_name,scorpions
param=slayer_type,7
param=slayer_description,Scorpions are almost always venomous and usually found in groups. Last I heard you can find some scorpions in the Stronghold of Security.
param=slayer_sl_req,0
param=slayer_example_npc,scorpion

// 50733
[slayer_vannaka_list_entry_20]
param=slayer_name,cockroaches
param=slayer_type,178
param=slayer_description,Cockroaches are resilient creatures often found in dark and damp places. They have been spotted in the Stronghold of Player Safety to the south.
param=slayer_cl_req,10
param=slayer_example_npc,sops_cockroach_large

// 50734
[slayer_vannaka_list_entry_21]
param=slayer_name,bats
param=slayer_type,8
param=slayer_description,Bats are rarely found on the ground, so you'll have to fight them while they're airborne, which won't be easy with melee. They have been spotted in the Taverley dungeon.
param=slayer_cl_req,40
param=slayer_example_npc,bat

// 50735
[slayer_vannaka_list_entry_22]
param=slayer_name,ice giants
param=slayer_type,15
param=slayer_description,Like other giants, ice giants often wield large weapons. Try using fire spells to melt them before they can hit you. Ice giants can be found underground to the south of Port Sarim.
param=slayer_cl_req,50
param=slayer_example_npc,icegiant

// 50736
[slayer_vannaka_list_entry_23]
param=slayer_name,moss giants
param=slayer_type,17
param=slayer_description,Like other giants, moss giants often wield large weapons. Use fire spells to burn them to cinders before they can damage you. Strangely for giants, some have been seen at the end of the Varrock sewers.
param=slayer_cl_req,50
param=slayer_example_npc,mossgiant

// 50737
[slayer_vannaka_list_entry_24]
param=slayer_name,icefiends
param=slayer_type,75
param=slayer_description,Icefiends are beings of ice and freezing rock. They're quick and agile, so you'll want to be careful when getting close to them. Ice Mountain is infested with these pesky creatures.
param=slayer_cl_req,35
param=slayer_example_npc,icemt_icefiend

// 50738
[slayer_chaeldar_list_entry_1]
param=slayer_name,kurasks
param=slayer_type,45
param=slayer_description,Kurasks are large, brutal creatures with very thick hides. You'll need a leaf-bladed weapon, broad arrows or a magic dart to harm them. Kurask may be found in the caverns east of Rellekka. As they are so large, you may be able to kill them when they cannot reach you.
param=slayer_cl_req,55
param=slayer_sl_req,70
param=slayer_example_npc,slayer_kursk_1

// 50739
[slayer_chaeldar_list_entry_2]
param=slayer_name,fire giants
param=slayer_type,16
param=slayer_description,Like other giants, Fire giants often wield large weapons. Learn to recognise what kind of weapon it is and act accordingly. The smoke dungeon to the west of Pollnivneach has a population of these large and irritating creatures, so go smite them.
param=slayer_cl_req,50
param=slayer_sl_req,0
param=slayer_example_npc,firegiant

// 50740
[slayer_chaeldar_list_entry_3]
param=slayer_name,gargoyles
param=slayer_type,46
param=slayer_description,Gargoyles are winged creatures of stone. You'll need to fight them until they are close to death before breaking them apart with a rock hammer. There is a thriving population of Gargoyles in the Slayer Tower near Canifis.
param=slayer_cl_req,55
param=slayer_sl_req,75
param=slayer_example_npc,slayer_gargoyle_1

// 50741
[slayer_chaeldar_list_entry_4]
param=slayer_name,kalphites
param=slayer_type,53
param=slayer_description,Kalphites are large insects that live in hives under the desert sands. South-west of Shantay Pass they swarm and make themselves a nuisance. Enter deeper into the lair if you are looking for a suitable challenge.
param=slayer_sl_req,0
param=slayer_example_npc,kalphite_soldier

// 50742
[slayer_chaeldar_list_entry_5]
param=slayer_name,dagannoth
param=slayer_type,35
param=slayer_description,Dagannoth are large, sea-dwelling creatures that are very aggressive. You'll often find them in caves near sea water. I can tell that you've seen the vile creatures, so you know where to go. Remember: they attack with missiles, so protect yourself accordingly.
param=slayer_sl_req,0
param=slayer_example_npc,horror_dagganoth_jr_darker

// 50743
[slayer_chaeldar_list_entry_6]
param=slayer_name,warped tortoises
param=slayer_type,92
param=slayer_description,Warped tortoises are creatures tainted by magical waste. They are vulnerable to an elven chime.
param=slayer_sl_req,56
param=slayer_example_npc,pog_mutated_tortoise_vulnerable

// 50744
[slayer_chaeldar_list_entry_7]
param=slayer_name,trolls
param=slayer_type,18
param=slayer_description,Trolls regenerate quickly but are still vulnerable to poisons. They usually use crushing weapons. Perhaps you should head to the snowy islands where these creatures are both fierce and aggressive.
param=slayer_sl_req,0
param=slayer_example_npc,death_troll_melee1

// 50745
[slayer_chaeldar_list_entry_8]
param=slayer_name,jungle horrors
param=slayer_type,81
param=slayer_description,Jungle horrors can be found all over Mos Le'Harmless. They are strong and aggressive, but you should be heroic enough to make short work of them.
param=slayer_sl_req,0
param=slayer_example_npc,harmless_island_jungle_horror_guard

// 50746
[slayer_chaeldar_list_entry_9]
param=slayer_name,turoths
param=slayer_type,36
param=slayer_description,Turoths are large, vicious creatures with thick hides. You'll need a leaf-bladed weapon, broad arrows, or a magic dart to harm them. Seek them out in the Rellekka Slayer Caves.
param=slayer_sl_req,55
param=slayer_example_npc,slayer_turoth_child

// 50747
[slayer_chaeldar_list_entry_10]
param=slayer_name,cave horrors
param=slayer_type,80
param=slayer_description,Cave horrors can be found in the caves under Mos Le'Harmless which favour the use of missiles or Magic. You will need a witchwood icon to fight them effectively. They drop the famous black Slayer mask, so the trip may be worth it.
param=slayer_sl_req,58
param=slayer_example_npc,harmless_island_cave_horror_guard

// 50748
[slayer_chaeldar_list_entry_11]
param=slayer_name,jellies
param=slayer_type,50
param=slayer_description,Jellies are nasty, cube-like, gelatinous creatures which absorb everything they come across. Rellekka's caves are known to harbour these unnatural abominations. You can consider their attacks to be a form of Ranged and protect yourself with this in mind.
param=slayer_sl_req,52
param=slayer_example_npc,slayer_jelly_1

// 50749
[slayer_chaeldar_list_entry_12]
param=slayer_name,lesser demons
param=slayer_type,28
param=slayer_description,Lesser demons are weak to ranged attacks. Although they're relatively weak, they are still dangerous. Taverley's underworld is infested with these hellish pests.
param=slayer_sl_req,0
param=slayer_example_npc,lesser_demon

// 50750
[slayer_chaeldar_list_entry_13]
param=slayer_name,dust devils
param=slayer_type,49
param=slayer_description,Dust devils use clouds of dust, sand, ash and whatever else they can inhale to blind and disorientate their victims. They typically lurk in the smoky dungeon west of Pollnivneach.
param=slayer_sl_req,65
param=slayer_example_npc,slayer_dustdevil

// 50751
[slayer_chaeldar_list_entry_14]
param=slayer_name,blue dragons
param=slayer_type,25
param=slayer_description,Blue dragons aren't as strong as other dragons, but they're still very powerful. Watch out for their fiery breath. Taverley Dungeon has a clutch of these creatures, which it can be profitable to slay.
param=slayer_sl_req,0
param=slayer_example_npc,blue_dragon

// 50752
[slayer_chaeldar_list_entry_15]
param=slayer_name,elves
param=slayer_type,56
param=slayer_description,Elves are quick, agile, and vicious fighters who often favour bows and polearms. They also irritate me intensely, so slaughtering them is definitely a good thing. They live in the forests far, far to the west of human lands.
param=slayer_sl_req,0
param=slayer_example_npc,regicide_darkelf

// 50753
[slayer_chaeldar_list_entry_16]
param=slayer_name,aberrant spectres
param=slayer_type,41
param=slayer_description,Aberrant spectres are fetid, vile ghosts. The very smell of them will paralyse and harm you. A nosepeg will help negate their stink and their attacks are most definitely magical in nature. You'll be able to make the world more fragrant if you kill the ones lurking in the Slayer Tower near Canifis.
param=slayer_sl_req,60
param=slayer_example_npc,slayer_abberant_spectre_1

// 50754
[slayer_chaeldar_list_entry_17]
param=slayer_name,shadow warriors
param=slayer_type,32
param=slayer_description,Shadow warriors are dark and mysterious. They hide in the shadows, so be wary of ambushes. Apparently, a large number may be found lurking beneath the Legends' Guild.
param=slayer_sl_req,0
param=slayer_example_npc,shadow_warrior

// 50755
[slayer_chaeldar_list_entry_18]
param=slayer_name,bloodveld
param=slayer_type,48
param=slayer_description,Bloodveld are strange, demonic creatures. They use their long, rasping tongue to feed on just about anything they can find. Their tongue assaults physically, so using magic attacks might be the best choice. If you can stand being licked by a half-ton demon, you should take a trip to the Slayer Tower near Canifis.
param=slayer_sl_req,50
param=slayer_example_npc,slayer_bloodveld

// 50756
[slayer_chaeldar_list_entry_19]
param=slayer_name,mutated zygomites
param=slayer_type,74
param=slayer_description,Mutated zygomites are hard to destroy and attack with mainly magical damage. They regenerate quickly, so you will need to finish them off with fungicide. We have a bit of a problem with them here in Zanaris.
param=slayer_sl_req,57
param=slayer_example_npc,slayer_mutated_zygomite_adolescent

// 50757
[slayer_chaeldar_list_entry_20]
param=slayer_name,infernal mages
param=slayer_type,40
param=slayer_description,Infernal mages are dangerous spell users. Beware of their magic spells and go properly prepared to the Slayer Tower near Canifis.
param=slayer_sl_req,45
param=slayer_example_npc,slayer_infernal_mage_1

// 50758
[slayer_chaeldar_list_entry_21]
param=slayer_name,brine rats
param=slayer_type,84
param=slayer_description,Brine rats can be found in caves that are near the sea. They are hairless, bad-tempered and generally unfriendly. You may have spotted them while looking for pirate treasures.
param=slayer_sl_req,47
param=slayer_example_npc,olaf2_brine_rats

// 50759
[slayer_chaeldar_list_entry_22]
param=slayer_name,fever spiders
param=slayer_type,69
param=slayer_description,Fever spiders are giant spiders that carry the deadly spider fever. If you don't want to catch it, I suggest you wear Slayer gloves to fight them. I've heard they cause problems in breweries, if you want to find some.
param=slayer_sl_req,42
param=slayer_example_npc,deal_fever_spiders1

// 50760
[slayer_chaeldar_list_entry_23]
param=slayer_name,basilisks
param=slayer_type,43
param=slayer_description,Basilisks, like cockatrices, have a gaze that will paralyse and harm their prey. You'll need a mirror shield to protect you. I am sure you know that there is a Basilisk colony in the Rellekka Slayer Caves.
param=slayer_sl_req,40
param=slayer_example_npc,slayer_basilisk

// 50761
[slayer_chaeldar_list_entry_24]
param=slayer_name,harpie bug swarms
param=slayer_type,70
param=slayer_description,Harpie bugs are pesky critters that are hard to hit. You need a lit bug lantern to distract them with its hypnotic light. They live on Karamja, near the coast, and just south-east of the narrow stretch of land which joins the two halves of the island.
param=slayer_sl_req,33
param=slayer_example_npc,slayer_harpiebugswarm

// 50762
[slayer_chaeldar_list_entry_25]
param=slayer_name,banshees
param=slayer_type,38
param=slayer_description,Banshees use a piercing scream to shock their enemies. You'll need some earmuffs to protect yourself from them. Head to the Slayer Tower near Canifis to slay them, although I have heard rumours of tougher banshees in Pollnivneach.
param=slayer_sl_req,15
param=slayer_example_npc,slayer_banshee_1

// 50763
[slayer_chaeldar_list_entry_26]
param=slayer_name,cave crawlers
param=slayer_type,37
param=slayer_description,Cave crawlers are small and fast, often hiding in ambush. Avoid their barbed tongue or you'll get poisoned. Squish them in droves at the Rellekka Slayer Dungeon near the golden tree.
param=slayer_sl_req,10
param=slayer_example_npc,slayer_cave_crawler_1

// 50764
[slayer_chaeldar_list_entry_27]
param=slayer_name,crawling hands
param=slayer_type,39
param=slayer_description,Crawling hands are undead severed hands; fast and dexterous they claw their victims. Massacre these unnatural creations at the Slayer Tower near Canifis.
param=slayer_sl_req,5
param=slayer_example_npc,slayer_crawling_hand_1

// 50765
[slayer_chaeldar_list_entry_28]
param=slayer_name,bronze dragons
param=slayer_type,58
param=slayer_description,Bronze dragons are the weakest of the metallic dragons, but their bronze scales are far thicker than normal bronze armour. They lay in wait for you in Brimhaven Dungeon and the Chaos Tunnels. You'll be well served by taking a defence against their breath.
param=slayer_cl_req,80
param=slayer_sl_req,0
param=slayer_example_npc,bronze_dragon

// 50766
[slayer_chaeldar_list_entry_29]
param=slayer_name,jungle strykewyrms
param=slayer_type,103
param=slayer_description,These tricky creatures burrow beneath the jungle north west of Oo'glog. Be careful, as these poisonous jungle wyrms like to use magical attacks from a distance, while they should be weak to stab attacks.
param=slayer_cl_req,80
param=slayer_sl_req,73
param=slayer_example_npc,strykewyrm

// 50767
[slayer_chaeldar_list_entry_30]
param=slayer_name,vyrewatch
param=slayer_type,110
param=slayer_description,These foul creatures can be found throughout Meiyerditch and Darkmeyer in Morytania. They have a telepathic ability which enables them to dodge incoming attacks, so you'll need a weapon specially created to harm them.
param=slayer_sl_req,0
param=slayer_example_npc,sang_myq3_female_walk_ns_vyrewatch_1

// 50768
[slayer_chaeldar_list_entry_31]
param=slayer_name,grifolapines
param=slayer_type,97
param=slayer_description,Grifolapines live in a cave north-east of the Mage Training Arena. The creatures of that dungeon are coated in toxic fungus, so you should fight them from a distance, and dodge when they charge at you. The fungus helps them repair physical damage, so you might prefer using magical attacks.
param=slayer_cl_req,75
param=slayer_sl_req,88
param=slayer_example_npc,grifolapine_1

// 50769
[slayer_chaeldar_list_entry_32]
param=slayer_name,grifolaroos
param=slayer_type,98
param=slayer_description,Grifolaroos live in a cave north-east of the Mage Training Arena. The creatures of that dungeon are coated in toxic fungus, so you should fight them from a distance, although they'll try to hop over obstacles towards you. The fungus helps them repair physical damage, so you might prefer using magical attacks.
param=slayer_cl_req,75
param=slayer_sl_req,82
param=slayer_example_npc,grifolaroo_1

// 50770
[slayer_chaeldar_list_entry_33]
param=slayer_name,fungal magi
param=slayer_type,99
param=slayer_description,Fungal magi live in the upper levels of a cave north-east of the Mage Training Arena. The creatures of that dungeon are coated in toxic fungus, so you should fight them from a distance, and be prepared for their magical attacks. The fungus helps them repair physical damage, so you might prefer using magical attacks too.
param=slayer_sl_req,0
param=slayer_example_npc,fungal_mage_1

// 50771
[slayer_chaeldar_list_entry_34]
param=slayer_name,grotworms
param=slayer_type,112
param=slayer_description,Grotworms have recently been spotted in a cave near Rimmington. They will bite and attack with some sort of acid spit. Be careful - they are very aggressive.
param=slayer_sl_req,0
param=slayer_example_npc,qbd2_worm2

// 50772
[slayer_sumona_list_entry_1]
param=slayer_name,black demons
param=slayer_type,30
param=slayer_description,Black demons are creatures that are weak to ranged attacks. They're the strongest type of demon and are therefore very dangerous. Prove yourself more dangerous by slaying these demons in their lairs beneath Taverley or Edgeville.
param=slayer_cl_req,100
param=slayer_sl_req,0
param=slayer_example_npc,black_demon

// 50773
[slayer_sumona_list_entry_2]
param=slayer_name,spiritual warriors
param=slayer_type,89
param=slayer_description,Spiritual warriors are fighters that have dedicated their souls to their deity; however, they still retain a fighter's weakness to Magic. They can be found fighting for the god whose cause they support. Kill them all and let their gods lament.
param=slayer_sl_req,68
param=slayer_example_npc,godwars_spiritual_bandos_warrior

// 50774
[slayer_sumona_list_entry_3]
param=slayer_name,scabarites
param=slayer_type,85
param=slayer_description,Scabarites are the followers of Scabaras and consist of anything from the lowliest dung beetle to the vilest scarab mage. They are most commonly found near and under Sophanem. They are traitorous creatures in the main, so commit genocide upon them.
param=slayer_sl_req,0
param=slayer_example_npc,scab_insectoid_lancer

// 50775
[slayer_sumona_list_entry_4]
param=slayer_name,elves
param=slayer_type,56
param=slayer_description,Elves are quick, agile and vicious fighters that often favour bows, polearms and snide remarks. Their dedication to trees, bushes and music is an affront to me, so go and cause havoc in their vile villages. You'll need to travel far to the west.
param=slayer_sl_req,0
param=slayer_example_npc,regicide_darkelf

// 50776
[slayer_sumona_list_entry_5]
param=slayer_name,blue dragons
param=slayer_type,25
param=slayer_description,Blue dragons aren't as strong as other dragons, but they're still very powerful. Watch out for their fiery breath! Taverley is home to these pests - I'm sure you'll enjoy murdering a few.
param=slayer_sl_req,0
param=slayer_example_npc,blue_dragon

// 50777
[slayer_sumona_list_entry_6]
param=slayer_name,kalphites
param=slayer_type,53
param=slayer_description,Kalphites are large insects that live in hives under the desert sands. Their Queen is rumoured to be quite powerful. Show people that you are a force to be feared by slaying her brood in the hive to the north-west.
param=slayer_sl_req,0
param=slayer_example_npc,kalphite_soldier

// 50778
[slayer_sumona_list_entry_7]
param=slayer_name,abyssal demons
param=slayer_type,180
param=slayer_description,Abyssal demons are nasty creatures to deal with. They aren't really part of this realm and are able to move very quickly to trap their prey. I'm sure you'd love a nice abyssal whip or two, so cull these demons in the Slayer Tower near Canifis.
param=slayer_sl_req,85
param=slayer_example_npc,slayer_abyssal

// 50779
[slayer_sumona_list_entry_8]
param=slayer_name,spiritual mages
param=slayer_type,91
param=slayer_description,Spiritual mages are the strongest of the spiritual guardians. They are devastating against warriors, but a smart ranger can often defeat them. They can be found in the icy God Wars Dungeon near Trollheim, supporting the cause of their chosen god. All these gods must be caused to lament; go slay their followers for me.
param=slayer_sl_req,83
param=slayer_example_npc,godwars_spiritual_saradomin_mage

// 50780
[slayer_sumona_list_entry_9]
param=slayer_name,nechryael
param=slayer_type,52
param=slayer_description,Nechryael are demons of decay that summon small-winged beings to help them fight their victims. I don't like them much, so kill a few as a personal favour. You can find them up to no good in the Slayer Tower near Canifis.
param=slayer_sl_req,80
param=slayer_example_npc,slayer_nechryael

// 50781
[slayer_sumona_list_entry_10]
param=slayer_name,aberrant spectres
param=slayer_type,41
param=slayer_description,Aberrant spectres are fetid, vile ghosts. The very smell of them will paralyse and harm you, while a nosepeg will help ignore their stink. If you sniff carefully, you may be able to detect their aroma beneath the town's well. Kill a few of them, as they offend my nose.
param=slayer_sl_req,60
param=slayer_example_npc,slayer_abberant_spectre_1

// 50782
[slayer_sumona_list_entry_11]
param=slayer_name,iron dragons
param=slayer_type,59
param=slayer_description,Iron dragons are some of the weaker metallic dragons, but their iron scales are far thicker than normal iron armour. Brimhaven Dungeon has a few of these creatures in residence; I think they should be exterminated because they bore me.
param=slayer_sl_req,0
param=slayer_example_npc,iron_dragon

// 50783
[slayer_sumona_list_entry_12]
param=slayer_name,gargoyles
param=slayer_type,46
param=slayer_description,Gargoyles are winged creatures of stone. You'll need to fight them until they are close to death, before breaking them apart with a rock hammer. They refuse to serve me, so smite them in my name. They are hiding out in the Slayer Tower near Canifis.
param=slayer_sl_req,75
param=slayer_example_npc,slayer_gargoyle_1

// 50784
[slayer_sumona_list_entry_13]
param=slayer_name,bloodveld
param=slayer_type,48
param=slayer_description,Bloodveld are strange, demonic creatures that use their long rasping tongue to feed on just about anything. They are rather robust but frankly feeble and have been seen in the Slayer Tower near Canifis, among other places. I never liked the look of them, so off you go and wipe them out.
param=slayer_sl_req,50
param=slayer_example_npc,slayer_bloodveld

// 50785
[slayer_sumona_list_entry_14]
param=slayer_name,trolls
param=slayer_type,18
param=slayer_description,Trolls regenerate quickly but are still vulnerable to poisons and usually use crushing weapons. I've nothing much against them but their ridiculous names. Unluckily for them, that's enough of a reason to put a few in their graves.
param=slayer_sl_req,0
param=slayer_example_npc,death_troll_melee1

// 50786
[slayer_sumona_list_entry_15]
param=slayer_name,greater demons
param=slayer_type,29
param=slayer_description,Greater demons are creatures that are weak to ranged attacks. Though not the strongest of demons, they are still dangerous. Prove yourself by doing away with them. If you don't know, a large number live in the Brimhaven Dungeon.
param=slayer_sl_req,0
param=slayer_example_npc,greater_demon

// 50787
[slayer_sumona_list_entry_16]
param=slayer_name,fire giants
param=slayer_type,16
param=slayer_description,Like other giants, Fire giants often wield large weapons. Learn to recognise what kind of weapon it is and act accordingly. Prove that bigger isn't always better by defeating some. They lurk in the smoke dungeon, west of here, telling tales of your weakness.
param=slayer_sl_req,0
param=slayer_example_npc,firegiant

// 50788
[slayer_sumona_list_entry_17]
param=slayer_name,dagannoth
param=slayer_type,35
param=slayer_description,Dagannoth are large, sea-dwelling creatures that are very aggressive. You'll often find them in caves near sea water. You'll cackle with glee if you set up a cannon and massacre them.
param=slayer_sl_req,0
param=slayer_example_npc,horror_dagganoth_jr_darker

// 50789
[slayer_sumona_list_entry_18]
param=slayer_name,hellhounds
param=slayer_type,31
param=slayer_description,Hellhounds are a cross between dogs and demons, and are dangerous with a fierce bite. Although they are not cats, they deserve to die anyway. You'll be doing Gielinor a favour if you slay Hellhounds beneath Taverley.
param=slayer_sl_req,0
param=slayer_example_npc,hellhound

// 50790
[slayer_sumona_list_entry_19]
param=slayer_name,kurasks
param=slayer_type,45
param=slayer_description,Kurasks are large, brutal creatures with very thick hides. You'll need a leaf-bladed weapon, broad arrows, or a magic dart to harm them. Unluckily for kurasks, I am sending you to kill them. Luckily for you, kurasks thrive in the dungeons below Pollnivneach.
param=slayer_sl_req,70
param=slayer_example_npc,slayer_kursk_2

// 50791
[slayer_sumona_list_entry_20]
param=slayer_name,dust devils
param=slayer_type,49
param=slayer_description,Dust devils use clouds of dust, sand, ash and whatever else they can inhale to blind and disorientate their victims. You'll be able to test your skills on them in the smoky dungeon to the west. Get going!
param=slayer_sl_req,65
param=slayer_example_npc,slayer_dustdevil

// 50792
[slayer_sumona_list_entry_21]
param=slayer_name,turoths
param=slayer_type,36
param=slayer_description,Turoths are large vicious creatures with thick hides. You'll need a leaf-bladed weapon, broad arrows, or a magic dart to harm them. I am sure you'll make yourself useful by killing the ones beneath our feet.
param=slayer_sl_req,55
param=slayer_example_npc,slayer_turoth_dad

// 50793
[slayer_sumona_list_entry_22]
param=slayer_name,cave horrors
param=slayer_type,80
param=slayer_description,Cave horrors can be found under Mos Le'Harmless. You will need a witchwood icon to fight them effectively. If you want to make a nice Slayer helmet, you'll need the black mask they drop.
param=slayer_sl_req,58
param=slayer_example_npc,harmless_island_cave_horror_guard

// 50794
[slayer_sumona_list_entry_23]
param=slayer_name,basilisks
param=slayer_type,43
param=slayer_description,Basilisks, like Cockatrices, have a gaze which will paralyse and harm their prey. You'll need a mirror shield to protect you. Conveniently, you can have some combat fun with these brutes in the dungeon beneath the town well.
param=slayer_sl_req,40
param=slayer_example_npc,slayer_basilisk

// 50795
[slayer_sumona_list_entry_24]
param=slayer_name,warped tortoises
param=slayer_type,92
param=slayer_description,Warped tortoises are creatures tainted by magical waste. They are vulnerable to an elven chime. I know you have seen them in your adventures, so go crack some carapace.
param=slayer_sl_req,56
param=slayer_example_npc,pog_mutated_tortoise_vulnerable

// 50796
[slayer_sumona_list_entry_25]
param=slayer_name,cave crawlers
param=slayer_type,37
param=slayer_description,Cave crawlers are small and fast, often hiding in ambush. Avoid their barbed tongue or you'll get poisoned. The ones in the caves below here have grown large and fat in blissful isolation - go and be a force of natural selection.
param=slayer_cl_req,10
param=slayer_sl_req,10
param=slayer_example_npc,smki_new_crawler

// 50797
[slayer_sumona_list_entry_26]
param=slayer_name,banshees
param=slayer_type,38
param=slayer_description,Banshees use a piercing scream to shock their enemies, so you'll need some earmuffs to protect yourself. I am sometimes disturbed in my sleep by their wails, so do me a favour and thin out those beneath us.
param=slayer_cl_req,20
param=slayer_sl_req,15
param=slayer_example_npc,smki_new_banshee

// 50798
[slayer_sumona_list_entry_27]
param=slayer_name,red dragons
param=slayer_type,26
param=slayer_description,Red dragons are fearsome firebreathers, stronger than green or blue. I'm sure that you'll have fun pitting your skills against their claws in either Brimhaven's depths or the ravaged lands far to the north. 
param=slayer_sl_req,0
param=slayer_example_npc,red_dragon

// 50799
[slayer_sumona_list_entry_28]
param=slayer_name,terror dogs
param=slayer_type,86
param=slayer_description,Terror dogs are, unsurprisingly, dogs that terrorise the weak. They are the servants of Tarn, who annoyed me when he was young. Be a force of vengeance for me by cleaning his lair of these pathetic servitors.
param=slayer_sl_req,40
param=slayer_example_npc,lotr_terror_dog_large

// 50800
[slayer_sumona_list_entry_29]
param=slayer_name,aquanites
param=slayer_type,95
param=slayer_description,Aquanites are amphibious creatures that attract prey using the glowing lures on their heads. They attack stronger opponents from a distance with water magic, and dislike those who pray against it. You'll find these despicable, slimy creatures in the Fremennik Slayer Dungeon, in a chamber past the kurasks.
param=slayer_sl_req,78
param=slayer_example_npc,slayer_aquanite

// 50801
[slayer_sumona_list_entry_30]
param=slayer_name,jungle strykewyrms
param=slayer_type,103
param=slayer_description,These tricky creatures burrow beneath the jungle north west of Oo'glog. Be careful, as these poisonous jungle wyrms like to use magical attacks from a distance, while they should be weak to stab attacks.
param=slayer_cl_req,80
param=slayer_sl_req,73
param=slayer_example_npc,strykewyrm

// 50802
[slayer_sumona_list_entry_31]
param=slayer_name,desert strykewyrms
param=slayer_type,104
param=slayer_description,These things are the curse of the desert! Head north to find them on the hills above the Shantay Pass. Watch out for their vicious ranged attacks.
param=slayer_cl_req,90
param=slayer_sl_req,77
param=slayer_example_npc,strykewyrm_desert

// 50803
[slayer_sumona_list_entry_32]
param=slayer_name,mutated jadinkos
param=slayer_type,109
param=slayer_description,These warped jade vine creatures will not hesitate to use their environment to help them in combat if they cannot retaliate otherwise. The baby jadinkos are easiest to kill, but the males offer the greatest rewards. Ranged weapons made from vines are best against them.
param=slayer_cl_req,90
param=slayer_sl_req,80
param=slayer_example_npc,jaro_mutated_jadinko_guard

// 50804
[slayer_sumona_list_entry_33]
param=slayer_name,vyrewatch
param=slayer_type,110
param=slayer_description,These foul creatures can be found throughout Meiyerditch and Darkmeyer in Morytania. They have a telepathic ability which enables them to dodge incoming attacks, so you'll need a weapon specially created to harm them.
param=slayer_sl_req,0
param=slayer_example_npc,sang_myq3_female_walk_ns_vyrewatch_1

// 50805
[slayer_sumona_list_entry_34]
param=slayer_name,grifolapines
param=slayer_type,97
param=slayer_description,Grifolapines live in a cave north-east of the Mage Training Arena. The creatures of that dungeon are coated in toxic fungus, so you should fight them from a distance, and dodge when they charge at you. The fungus helps them repair physical damage, so you might prefer using magical attacks.
param=slayer_cl_req,75
param=slayer_sl_req,88
param=slayer_example_npc,grifolapine_1

// 50806
[slayer_sumona_list_entry_35]
param=slayer_name,grifolaroos
param=slayer_type,98
param=slayer_description,Grifolaroos live in a cave north-east of the Mage Training Arena. The creatures of that dungeon are coated in toxic fungus, so you should fight them from a distance, although they'll try to hop over obstacles towards you. The fungus helps them repair physical damage, so you might prefer using magical attacks.
param=slayer_cl_req,75
param=slayer_sl_req,82
param=slayer_example_npc,grifolaroo_1

// 50807
[slayer_sumona_list_entry_36]
param=slayer_name,fungal magi
param=slayer_type,99
param=slayer_description,Fungal magi live in the upper levels of a cave north-east of the Mage Training Arena. The creatures of that dungeon are coated in toxic fungus, so you should fight them from a distance, and be prepared for their magical attacks. The fungus helps them repair physical damage, so you might prefer using magical attacks too.
param=slayer_sl_req,0
param=slayer_example_npc,fungal_mage_1

// 50808
[slayer_sumona_list_entry_37]
param=slayer_name,grotworms
param=slayer_type,112
param=slayer_description,Grotworms have recently been spotted in a cave near Rimmington. They will bite and attack with some sort of acid spit. Be careful - they are very aggressive.
param=slayer_sl_req,0
param=slayer_example_npc,qbd2_worm2

// 50809
[slayer_sumona_list_entry_38]
param=slayer_name,Cres's automatons
param=slayer_type,113
param=slayer_description,Without their master, Cres's automatons roam Guthix's chambers, attacking any who enter. They are programmed to use magic, melee or ranged and do a violent area-of-effect attack. Guthix's chambers may be reached via his shrine, or the excavation west of the Legends' Guild.
param=slayer_cl_req,100
param=slayer_sl_req,67
param=slayer_example_npc,tsd_slayer_automaton_lookup

// 50810
[slayer_sumona_list_entry_39]
param=slayer_name,aviansies
param=slayer_type,114
param=slayer_description,Aviansies can be found in the Godwars Dungeon north of Trollheim. As they are flying, you'll find melee attacks are not going to cut it.
param=slayer_cl_req,70
param=slayer_sl_req,0

// 50811
[slayer_sumona_list_entry_40]
param=slayer_name,scorpions
param=slayer_type,7
param=slayer_description,Scorpions are almost always venomous and usually found in groups. Last I heard there was a large group near the mine north of Al Kharid.
param=slayer_cl_req,10
param=slayer_sl_req,88
param=slayer_example_npc,scorpion

// 50812
[slayer_sumona_list_entry_41]
param=slayer_name,desert lizards
param=slayer_type,68
param=slayer_description,Desert lizards are large reptiles with tough skin. They're cold-blooded, so dousing them with freezing water will finish them off after a tough battle.
param=slayer_cl_req,20
param=slayer_sl_req,94
param=slayer_example_npc,slayer_lizard_large1_green

// 50813
[slayer_sumona_list_entry_42]
param=slayer_name,crocodiles
param=slayer_type,65
param=slayer_description,Crocodiles are large reptiles that live near water. You'll want to have a stabbing weapon handy for puncturing their thick, scaly hides. These are desert beasts, so seek them there.
param=slayer_cl_req,40
param=slayer_sl_req,105
param=slayer_example_npc,ics_little_croc

// 50814
[slayer_sumona_list_entry_43]
param=slayer_name,corrupted creatures
param=slayer_type,152
param=slayer_description,You can find corrupted creatures in the Sophanem Slayer Dungeon.
param=slayer_sl_req,88
param=slayer_example_npc,menaphos_slayer_corrupted_creature_dummy

// 50815
[slayer_sumona_list_entry_44]
param=slayer_name,soul devourers
param=slayer_type,153
param=slayer_description,You can find soul devourers in the Sophanem Slayer Dungeon.
param=slayer_sl_req,105
param=slayer_example_npc,menaphos_slayer_ammit

// 50816
[slayer_sumona_list_entry_45]
param=slayer_name,Profane Scabarites
param=slayer_type,192
param=slayer_description,Profane scabarites are insect-like creatures that have abandoned their beliefs. They are causing issues for people of the desert. You will find them near the river Elid.
param=slayer_sl_req,87
param=slayer_example_npc,profane_scabarite

// 50817
[slayer_duradel_list_entry_1]
param=slayer_name,scabarites
param=slayer_type,85
param=slayer_description,Scabarites are the followers of Scabaras and consist of anything from the lowliest dung beetle to the mightiest scarab mage. They are most commonly found near Sophanem, and under it.
param=slayer_sl_req,0
param=slayer_example_npc,scab_insectoid_lancer

// 50818
[slayer_duradel_list_entry_2]
param=slayer_name,dark beasts
param=slayer_type,66
param=slayer_description,Dark beasts are large, dog-like predators with massively muscled bodies that protect them from crushing weapons. You'll find them near the Temple of Light, attracted to the power of the Death Altar.
param=slayer_sl_req,90
param=slayer_example_npc,mourning_dark_beast

// 50819
[slayer_duradel_list_entry_3]
param=slayer_name,abyssal demons
param=slayer_type,180
param=slayer_description,Abyssal demons are nasty creatures to deal with. They aren't really part of this realm and are able to move very quickly to trap their prey. The Slayer Tower is home to a number of these creatures.
param=slayer_sl_req,85
param=slayer_example_npc,slayer_abyssal

// 50820
[slayer_duradel_list_entry_4]
param=slayer_name,kalphites
param=slayer_type,53
param=slayer_description,Kalphites are large insects that live in hives under the desert sands. I am sure that, by now, you have seen them to the south-west of Shantay Pass.
param=slayer_sl_req,0
param=slayer_example_npc,kalphite_soldier

// 50821
[slayer_duradel_list_entry_5]
param=slayer_name,spiritual mages
param=slayer_type,91
param=slayer_description,Spiritual mages are the strongest of the spiritual guardians. They are devastating against warriors, but a smart ranger can sometimes defeat them. Of course, Prayer might serve you well, too. They can be found in the icy caverns near Trollheim, supporting the cause of their chosen god.
param=slayer_sl_req,83
param=slayer_example_npc,godwars_spiritual_saradomin_mage

// 50822
[slayer_duradel_list_entry_6]
param=slayer_name,nechryael
param=slayer_type,52
param=slayer_description,Nechryael are demons of decay that summon small winged beings to help them fight their victims. They can be found in the  Slayer Tower near Canifis.
param=slayer_sl_req,80
param=slayer_example_npc,slayer_nechryael

// 50823
[slayer_duradel_list_entry_7]
param=slayer_name,aberrant spectres
param=slayer_type,41
param=slayer_description,Aberrant spectres are fetid, vile ghosts. The very smell of them will paralyse and harm you. A nosepeg will help ignore their stink and weak slayers might decide to pray when fighting them. They can be found in the Slayer Tower near Canifis and I have heard rumours that they also live beneath Pollnivneach in the desert.
param=slayer_sl_req,60
param=slayer_example_npc,slayer_abberant_spectre_1

// 50824
[slayer_duradel_list_entry_8]
param=slayer_name,iron dragons
param=slayer_type,59
param=slayer_description,Iron dragons are some of the weaker metallic dragons; their iron scales are far thicker than normal iron armour. Their fiery breath and sharp claws can be negated by a number of means. If you haven't visited Brimhaven Dungeon's depths then I advise you do - if only for the interesting creatures like these to kill there.
param=slayer_sl_req,0
param=slayer_example_npc,iron_dragon

// 50825
[slayer_duradel_list_entry_9]
param=slayer_name,gargoyles
param=slayer_type,46
param=slayer_description,Gargoyles are winged creatures of stone. You'll need to fight them until they are close to death before breaking them apart with a rock hammer. Exterminate those in the Slayer Tower.
param=slayer_sl_req,75
param=slayer_example_npc,slayer_gargoyle_1

// 50826
[slayer_duradel_list_entry_10]
param=slayer_name,black demons
param=slayer_type,30
param=slayer_description,Black demons are weak to ranged attacks. They're still the strongest demon and very dangerous, however. Seek them out in the Edgeville or Brimhaven dungeons.
param=slayer_sl_req,0
param=slayer_example_npc,black_demon

// 50827
[slayer_duradel_list_entry_11]
param=slayer_name,steel dragons
param=slayer_type,60
param=slayer_description,Steel dragons are dangerous and metallic, with steel scales that are far thicker than normal steel armour. As you are an accomplished slayer, I am sure you'll be able to deal with them easily.
param=slayer_sl_req,0
param=slayer_example_npc,steel_dragon

// 50828
[slayer_duradel_list_entry_12]
param=slayer_name,bloodveld
param=slayer_type,48
param=slayer_description,Bloodveld are strange, demonic creatures. They use their long, rasping tongue to feed on just about anything they can find. Remember that their tongues are magical in nature but, moreso, they deserve to die.
param=slayer_sl_req,50
param=slayer_example_npc,myq4_mutated_bloodveld

// 50829
[slayer_duradel_list_entry_13]
param=slayer_name,black dragons
param=slayer_type,27
param=slayer_description,Black dragons are among the strongest dragons and are very fierce. Watch out for their fiery breath. I am sure you will have seen them in your travels and have honed your techniques on lesser dragons.
param=slayer_sl_req,0
param=slayer_example_npc,black_dragon

// 50830
[slayer_duradel_list_entry_14]
param=slayer_name,greater demons
param=slayer_type,29
param=slayer_description,Greater demons are weak to ranged attacks. Though not the strongest of the demons, they are still dangerous. Slaughter them easily in Brimhaven's depths, and revel in your power.
param=slayer_sl_req,0
param=slayer_example_npc,greater_demon

// 50831
[slayer_duradel_list_entry_15]
param=slayer_name,suqahs
param=slayer_type,83
param=slayer_description,Suqahs can only be found on the mystical Lunar Isle. They use melee and magical attacks, and they often drop hide, teeth and herbs.
param=slayer_sl_req,0
param=slayer_example_npc,lunar_suqka

// 50832
[slayer_duradel_list_entry_16]
param=slayer_name,fire giants
param=slayer_type,16
param=slayer_description,Like other giants, Fire giants often wield large weapons. Learn to recognise what kind of weapon it is and act accordingly. Remember the days when these were a challenge to you, and laugh.
param=slayer_sl_req,0
param=slayer_example_npc,firegiant

// 50833
[slayer_duradel_list_entry_17]
param=slayer_name,dagannoth
param=slayer_type,35
param=slayer_description,Dagannoth are large, sea-dwelling creatures that are very aggressive. You'll often find them in caves near sea water. There is no joy so great as to cleanse these from the face of Gielinor.
param=slayer_sl_req,0
param=slayer_example_npc,horror_dagganoth_jr_darker

// 50834
[slayer_duradel_list_entry_18]
param=slayer_name,hellhounds
param=slayer_type,31
param=slayer_description,Hellhounds are a cross between dogs and demons; they are also dangerous with a fierce bite. Make them know fear.
param=slayer_sl_req,0
param=slayer_example_npc,hellhound

// 50835
[slayer_duradel_list_entry_19]
param=slayer_name,dust devils
param=slayer_type,49
param=slayer_description,Dust devils use clouds of dust, sand, ash and whatever else they can inhale to blind and disorientate their victims. Good luck on obtaining a dragon chainmail from their dusty remains.
param=slayer_sl_req,65
param=slayer_example_npc,slayer_dustdevil

// 50836
[slayer_duradel_list_entry_20]
param=slayer_name,warped terrorbirds
param=slayer_type,93
param=slayer_description,Warped terrorbirds are creatures tainted by magical waste and are vulnerable to an elven chime and may only be damaged when a chime has been used; look carefully to work out which. Their sonic attack is a Ranged attack but may be affected by ear defences.
param=slayer_sl_req,56
param=slayer_example_npc,pog_mutated_terror_bird2

// 50837
[slayer_duradel_list_entry_21]
param=slayer_name,waterfiends
param=slayer_type,88
param=slayer_description,Waterfiends are creatures of water that live under the Baxtorian Lake. Those followed by familiars are keen to slay these elemental forces.
param=slayer_sl_req,0
param=slayer_example_npc,brut_waterfiend

// 50838
[slayer_duradel_list_entry_22]
param=slayer_name,goraks
param=slayer_type,82
param=slayer_description,Goraks are extremely aggressive creatures. They have been imprisoned on an alternate plane, which is only accessible by using the fairy rings. Be extremely careful: their touch drains life points as well as skills!
param=slayer_sl_req,0
param=slayer_example_npc,fairytale2_gorak

// 50839
[slayer_duradel_list_entry_23]
param=slayer_name,skeletal wyverns
param=slayer_type,72
param=slayer_description,Skeletal wyverns are extremely dangerous and they are hard to hit with arrows, as they slip right through. To stand a good chance of surviving, you'll need some elemental shielding from their icy breath.
param=slayer_cl_req,100
param=slayer_sl_req,72
param=slayer_example_npc,skeletal_wyvern1

// 50840
[slayer_duradel_list_entry_24]
param=slayer_name,mithril dragons
param=slayer_type,94
param=slayer_description,Mithril dragons are very dangerous opponents. They live beneath the Baxtorian Falls and devour most of those who seek to slay them. You are a battlemaster; test your skills.
param=slayer_cl_req,100
param=slayer_sl_req,0
param=slayer_example_npc,brut_mithril_dragon

// 50841
[slayer_duradel_list_entry_25]
param=slayer_name,aquanites
param=slayer_type,95
param=slayer_description,Aquanites are amphibious creatures that attract prey using the glowing lures on their heads. They attack stronger opponents from a distance with water magic, and dislike those who pray against it. They dwell in the Fremennik Slayer Dungeon, in a chamber past the kurasks.
param=slayer_sl_req,78
param=slayer_example_npc,slayer_aquanite

// 50842
[slayer_duradel_list_entry_26]
param=slayer_name,jungle strykewyrms
param=slayer_type,103
param=slayer_description,These tricky creatures burrow beneath the jungle north west of Oo'glog. Be careful, as these poisonous jungle wyrms like to use magical attacks from a distance, while they should be weak to stab attacks.
param=slayer_cl_req,80
param=slayer_sl_req,73
param=slayer_example_npc,strykewyrm

// 50843
[slayer_duradel_list_entry_27]
param=slayer_name,desert strykewyrms
param=slayer_type,104
param=slayer_description,Head east of Al Kharid to find them on the hills above the Shantay Pass. Watch out for their vicious ranged attacks.
param=slayer_cl_req,90
param=slayer_sl_req,79
param=slayer_example_npc,strykewyrm_desert

// 50844
[slayer_duradel_list_entry_28]
param=slayer_name,ice strykewyrms
param=slayer_type,105
param=slayer_description,The strongest and coldest of their kind, they are found beneath the Fremennik mountains. Be careful of all their attacks; but, as they are beings of ice, I've found my fire spells inflict far more damage against them.
param=slayer_sl_req,93
param=slayer_example_npc,strykewyrm_ice

// 50845
[slayer_duradel_list_entry_29]
param=slayer_name,mutated jadinkos
param=slayer_type,109
param=slayer_description,These warped jade vine creatures will not hesitate to use their environment to help them in combat if they cannot retaliate otherwise. The baby jadinkos are easiest to kill, but the males offer the greatest rewards. Ranged weapons made from vines are best against them.
param=slayer_cl_req,90
param=slayer_sl_req,80
param=slayer_example_npc,jaro_mutated_jadinko_guard

// 50846
[slayer_duradel_list_entry_30]
param=slayer_name,vyrewatch
param=slayer_type,110
param=slayer_description,These foul creatures can be found throughout Meiyerditch and Darkmeyer in Morytania. They have a telepathic ability which enables them to dodge incoming attacks, so you'll need a weapon specially created to harm them.
param=slayer_sl_req,0
param=slayer_example_npc,sang_myq3_female_walk_ns_vyrewatch_1

// 50847
[slayer_duradel_list_entry_31]
param=slayer_name,ganodermic creatures
param=slayer_type,96
param=slayer_description,Ganodermic beasts and runts live in the depths of a cave north-east of the Mage Training Arena. The creatures of that dungeon are coated in toxic fungus, so you should fight them from a distance. The fungus helps them repair physical damage, so you might prefer using magical attacks.
param=slayer_sl_req,95
param=slayer_example_npc,ganodermic_beast_1

// 50848
[slayer_duradel_list_entry_32]
param=slayer_name,grifolapines
param=slayer_type,97
param=slayer_description,Grifolapines live in a cave north-east of the Mage Training Arena. The creatures of that dungeon are coated in toxic fungus, so you should fight them from a distance, and dodge when they charge at you. The fungus helps them repair physical damage, so you might prefer using magical attacks.
param=slayer_sl_req,88
param=slayer_example_npc,grifolapine_1

// 50849
[slayer_duradel_list_entry_33]
param=slayer_name,grifolaroos
param=slayer_type,98
param=slayer_description,Grifolaroos live in a cave north-east of the Mage Training Arena. The creatures of that dungeon are coated in toxic fungus, so you should fight them from a distance, although they'll try to hop over obstacles towards you. The fungus helps them repair physical damage, so you might prefer using magical attacks.
param=slayer_sl_req,82
param=slayer_example_npc,grifolaroo_1

// 50850
[slayer_duradel_list_entry_34]
param=slayer_name,fungal magi
param=slayer_type,99
param=slayer_description,Fungal magi live in the upper levels of a cave north-east of the Mage Training Arena. The creatures of that dungeon are coated in toxic fungus, so you should fight them from a distance, and be prepared for their magical attacks. The fungus helps them repair physical damage, so you might prefer using magical attacks too.
param=slayer_sl_req,0
param=slayer_example_npc,fungal_mage_1

// 50851
[slayer_duradel_list_entry_35]
param=slayer_name,grotworms
param=slayer_type,112
param=slayer_description,Grotworms have recently been spotted in a cave near Rimmington. They will bite and attack with some sort of acid spit. Be careful - they are very aggressive.
param=slayer_sl_req,0
param=slayer_example_npc,qbd2_worm3

// 50852
[slayer_duradel_list_entry_36]
param=slayer_name,Cres's automatons
param=slayer_type,113
param=slayer_description,Without their master, Cres' automatons roam Guthix's chambers, attacking any who enter. They are programmed to use magic, melee or ranged and do a violent area-of-effect attack. Guthix's chambers may be reached via his shrine, or the excavation west of the Legends' Guild.
param=slayer_cl_req,100
param=slayer_sl_req,67

// 50853
[slayer_duradel_list_entry_37]
param=slayer_name,aviansies
param=slayer_type,114
param=slayer_description,Aviansies can be found in the Godwars Dungeon north of Trollheim. As they are flying, you'll find melee attacks are not going to cut it.
param=slayer_cl_req,70
param=slayer_sl_req,0
param=slayer_example_npc,godwars_armadyl_female_armor01_blue

// 50854
[slayer_duradel_list_entry_38]
param=slayer_name,Order of Ascension members
param=slayer_type,115
param=slayer_description,The Order of Ascension are magic users. It is strongly suggested you use ranged attacks. Their tactics can make them tough one-on-one, so bringing a friend along would be beneficial.
param=slayer_cl_req,105
param=slayer_sl_req,81
param=slayer_example_npc,asc_gladius

// 50855
[slayer_duradel_list_entry_39]
param=slayer_name,Airut
param=slayer_type,117
param=slayer_description,The Airut are aggressive creatures from another world. They have powerful arms and attack with great vigour, certain abilities are able to counter and stun the Airut.
param=slayer_cl_req,110
param=slayer_sl_req,92
param=slayer_example_npc,hotm_slayer_creature_melee

// 50856
[slayer_duradel_list_entry_40]
param=slayer_name,Celestial dragons
param=slayer_type,118
param=slayer_description,Celestial dragons are one of the strangest dragons I assign. They use melee but have a powerful dragonfire as well as a fascinating ability to momentarily stop time. You can find them in the depths of Dragontooth Island.
param=slayer_example_npc,ooak_celestial_dragon

// 50857
[slayer_duradel_list_entry_41]
param=slayer_name,edimmu
param=slayer_type,124
param=slayer_description,Edimmu are ghosts which failed to escape their body. They're ghosts and zombies, yet somehow different altogether. They use ranged attacks and are highly aggressive. You can find them in a resource dungeon, which the Meilyr clan in Prifddinas has access to.
param=slayer_example_npc,edimmu
param=slayer_sl_req,90
param=slayer_cl_req,110

// 50858
[slayer_kuradal_list_entry_1]
param=slayer_name,dark beasts
param=slayer_type,66
param=slayer_description,Dark beasts are large, dog-like predators with massively muscled bodies that protect them from crushing weapons. I've managed to trap a few in the dungeon I'm guarding.
param=slayer_sl_req,90
param=slayer_example_npc,mourning_dark_beast

// 50859
[slayer_kuradal_list_entry_2]
param=slayer_name,abyssal demons
param=slayer_type,180
param=slayer_description,Abyssal demons are nasty creatures to deal with. They aren't really part of this realm and are able to move very quickly to trap their prey. I've managed to trap a few in the dungeon I'm guarding.
param=slayer_sl_req,85
param=slayer_example_npc,slayer_abyssal

// 50860
[slayer_kuradal_list_entry_3]
param=slayer_name,nechryael
param=slayer_type,52
param=slayer_description,Nechryael are demons of decay that summon small winged beings to help them fight their victims. They can be found in the Chaos Tunnels or in Canifis Slayer Tower.
param=slayer_sl_req,80
param=slayer_example_npc,slayer_nechryael

// 50861
[slayer_kuradal_list_entry_4]
param=slayer_name,hellhounds
param=slayer_type,31
param=slayer_description,Hellhounds are a cross between dogs and demons; they are also dangerous with a fierce bite. I've managed to trap a few in the dungeon I'm guarding.
param=slayer_sl_req,0
param=slayer_example_npc,hellhound

// 50862
[slayer_kuradal_list_entry_5]
param=slayer_name,gargoyles
param=slayer_type,46
param=slayer_description,Gargoyles are winged creatures of stone. You'll need to fight them until they are close to death before breaking them apart with a rock hammer. I've managed to trap a few in the dungeon I'm guarding.
param=slayer_sl_req,75
param=slayer_example_npc,slayer_gargoyle_1

// 50863
[slayer_kuradal_list_entry_6]
param=slayer_name,dust devils
param=slayer_type,49
param=slayer_description,Dust devils use clouds of dust, sand, ash and whatever else they can inhale to blind and disorientate their victims. Good luck on obtaining a dragon chainmail from their dusty remains.
param=slayer_sl_req,65
param=slayer_example_npc,slayer_dustdevil

// 50864
[slayer_kuradal_list_entry_7]
param=slayer_name,aberrant spectres
param=slayer_type,41
param=slayer_description,Aberrant spectres are fetid, vile ghosts. The very smell of them will paralyse and harm you. A nosepeg will help ignore their stink when fighting them. They can be found in the Slayer Tower near Canifis and I have heard rumours that they also live beneath Pollnivneach in the desert.
param=slayer_sl_req,60
param=slayer_example_npc,slayer_abberant_spectre_1

// 50865
[slayer_kuradal_list_entry_8]
param=slayer_name,TzHaar
param=slayer_type,101
param=slayer_description,The TzHaar contains some mighty warriors, prove yourself against them. You'll find them deep within the Karamja volcano.
param=slayer_sl_req,0
param=slayer_example_npc,null

// 50866
[slayer_kuradal_list_entry_9]
param=slayer_name,warped tortoises
param=slayer_type,92
param=slayer_description,Warped tortoises are creatures tainted by magical waste. They are vulnerable to an elven chime. I know you have seen them in your adventures, so go crack some carapace.
param=slayer_sl_req,56
param=slayer_example_npc,pog_mutated_tortoise_vulnerable

// 50867
[slayer_kuradal_list_entry_10]
param=slayer_name,iron dragons
param=slayer_type,59
param=slayer_description,Iron dragons are some of the weaker metallic dragons, with iron scales that are far thicker than normal iron armour. Their fiery breath and sharp claws can be negated by a number of means. I've managed to trap a few in the dungeon I'm guarding.
param=slayer_sl_req,0
param=slayer_example_npc,iron_dragon

// 50868
[slayer_kuradal_list_entry_11]
param=slayer_name,steel dragons
param=slayer_type,60
param=slayer_description,Steel dragons are dangerous and metallic, with steel scales that are far thicker than normal steel armour. I've managed to trap a few in the dungeon I'm guarding.
param=slayer_sl_req,0
param=slayer_example_npc,steel_dragon

// 50869
[slayer_kuradal_list_entry_12]
param=slayer_name,blue dragons
param=slayer_type,25
param=slayer_description,Blue dragons aren't as strong as other dragons, but they're still very powerful. I've managed to trap a few in the dungeon I'm guarding.
param=slayer_sl_req,0
param=slayer_example_npc,blue_dragon

// 50870
[slayer_kuradal_list_entry_13]
param=slayer_name,black dragons
param=slayer_type,27
param=slayer_description,Black dragons are among the strongest dragons and are very fierce. Watch out for their fiery breath. I am sure you will have seen them in your travels and have honed your techniques on lesser dragons.
param=slayer_sl_req,0
param=slayer_example_npc,black_dragon

// 50871
[slayer_kuradal_list_entry_14]
param=slayer_name,skeletal wyverns
param=slayer_type,72
param=slayer_description,Skeletal wyverns are extremely dangerous, and they are hard to hit with arrows as they slip right through. To stand a good chance of surviving, you'll need some elemental shielding from their icy breath.
param=slayer_sl_req,72
param=slayer_example_npc,skeletal_wyvern1

// 50872
[slayer_kuradal_list_entry_15]
param=slayer_name,terror dogs
param=slayer_type,86
param=slayer_description,Terror dogs are, unsurprisingly, dogs that terrorise the weak. You'll find them in the Haunted Mine, near Tarn's lair.
param=slayer_sl_req,40
param=slayer_example_npc,lotr_terror_dog_large

// 50873
[slayer_kuradal_list_entry_16]
param=slayer_name,living rock creatures
param=slayer_type,106
param=slayer_description,Found beneath the Dwarven mines, these are tough beings of rock. They can use ranged or melee attacks against you, so plan accordingly!
param=slayer_cl_req,80
param=slayer_sl_req,0
param=slayer_example_npc,lrc_rock_creature_melee

// 50874
[slayer_kuradal_list_entry_17]
param=slayer_name,greater demons
param=slayer_type,29
param=slayer_description,Greater demons are weak to ranged attacks. Though not the strongest of demons, they are still dangerous. I've managed to trap a few in the dungeon I'm guarding.
param=slayer_sl_req,0
param=slayer_example_npc,greater_demon

// 50875
[slayer_kuradal_list_entry_18]
param=slayer_name,black demons
param=slayer_type,30
param=slayer_description,Black demons are weak to ranged attacks. They're still the strongest demon and very dangerous, however. Seek them out in the Edgeville or Brimhaven dungeons.
param=slayer_sl_req,0
param=slayer_example_npc,black_demon

// 50876
[slayer_kuradal_list_entry_19]
param=slayer_name,suqahs
param=slayer_type,83
