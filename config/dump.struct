// 32233
[seren_helm_basic]
param=rewardshop_item_name,Crystal helm
param=rewardshop_cost,150
param=rewardshop_obj,seren_crystal_armour_helm_new_basic
param=rewardshop_icon,null
param=rewardshop_buy_option_1,1
param=rewardshop_buy_option_2,5
param=rewardshop_buy_option_3,10
param=rewardshop_buy_option_4,^min_32bit_int
param=rewardshop_tooltip,Tier 70 hybrid armour created from tarddian crystal. Increases the amount of crystal shards and crystal fragments gathered on Tarddiad.<br><br>Set effect:-<br>(2) - Increases damage against crystal shapeshifters by 5%. Increases chance to activate the attuned crystal weapon's effect by 3%.<br>(3) - On hit have a chance to cause <col=ffcc00>Tarddian Fury</col> which deals <col=ffffff>Agility %</col> of basic weapon damage as AoE Damage around you.<br>(4) - <col=ffcc00>Tarddian Fury</col> will now free you from stuns and bleeds.
param=rewardshop_usetooltip,1
