// 1647
[task_evil_tree]
param=task_game,1
param=dndtracker_is_members,0
param=task_name,Evil Tree
param=task_details,Nurture an evil sapling to full growth, then chop and burn it down.
param=task_rewards,Gives <col=ffffff>Farming</col>, <col=ffffff>Woodcutting</col> and <col=ffffff>Firemaking</col> experience, material rewards and a boost to <col=ffffff>Woodcutting</col>.
param=task_step_1,Evil trees sprout around common <col=ffffff>woodcutting</col> areas and <col=ffffff>close to major paths</col>.
param=task_step_2,Talk to <col=ffffff>spirit trees</col> to discover where the evil trees are and to learn about them. You will need to complete the <col=ffffff>Tree Gnome Village</col> quest before they will speak to you.
param=task_step_1_arrow,0_49_54_51_52
param=task_step_2_arrow,0_49_54_51_52
param=task_step_3_arrow,0_49_54_51_52
param=task_auto_arrow,1
param=task_icon,"task_icons_48_60,7"
param=task_set,63
param=task_unique_id,3003
param=task_area,0
param=task_requirement_1_type,62
param=task_next_id,3004
param=task_optional,1
param=dndtracker_full_description,Nurture evil trees using your Farming skill until they're fully grown. Then, use Woodcutting and Firemaking to attack the trees and destroy them.
param=dndtracker_is_dnd,1
param=dndtracker_priority,4
param=challenge_nearest_lodestone,0_50_52_14_49

// 1648
[task_shooting_star]
param=task_game,1
param=dndtracker_is_members,0
param=task_name,Shooting Star
param=task_details,Locate crashed stars across Gielinor and mine them to free their occupants.
param=task_rewards,Can yield <col=ffffff>experience</col>, material rewards and a <col=ffffff>mining-related buff</col>.
