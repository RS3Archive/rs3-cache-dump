// 44957
[tortle_combat_ninja_hood_struct]
param=mtxmgt_parent_id,995
param=mtxmgt_category,2
param=mtxmgt_subcat,0
param=mtxmgt_name,Ninja Tortle Hood
param=mtxmgt_source,5
param=mtxmgt_source_custom,Unlocked after completing the 'Tortle Combat' miniquest.

// 44958
[tortle_combat_weapon_cutlery]
param=tortle_combat_weapon_name,Mismatched set of cutlery
param=tortle_combat_weapon_id,1
param=tortle_combat_wolfgang_reaction,These are marvelous! Their smoothness and shine is perfect for me. Thank you kindly!
param=tortle_combat_gustav_reaction,I am afraid that these might not be sufficiently structurally sound to withstand prolonged combat.
param=tortle_combat_johann_reaction,I am sorry, friend. These knives and forks are not ideal as they will not allow me to fight enemies from a safe distance.
param=tortle_combat_alfred_reaction,Alfred has been chewing on one slice of pizza ever since you arrived, which has since turned to mush. He really doesn't seem to need cutlery.

// 44959
[tortle_combat_weapon_rake]
param=tortle_combat_weapon_name,Old rake handle
param=tortle_combat_weapon_id,4
param=tortle_combat_wolfgang_reaction,Please don't leave this thing around me for too long. Someone could get hurt.
param=tortle_combat_gustav_reaction,If this were to break during fighting, my defensive capabilities would be compromised.
param=tortle_combat_johann_reaction,The length of this instrument is excellent for engaging foes from far away. I shall take it!
param=tortle_combat_alfred_reaction,After a painful minute of uncertainty, the rake handle falls to the ground. Alfred seems unimpressed.

// 44960
[tortle_combat_weapon_axe]
param=tortle_combat_weapon_name,Dwarven army axe
param=tortle_combat_weapon_id,5
param=tortle_combat_wolfgang_reaction,This may be too rough of an implement for my fine sensibilities I am afraid.
param=tortle_combat_gustav_reaction,Now this axe looks both durable and effective. I am sure that I will be able to depend on it. Great work!
param=tortle_combat_johann_reaction,An axe such as this is more of a tool than a martial weapon, do you not think?
param=tortle_combat_alfred_reaction,Alfred isn't paying attention. He drops the axe to the ground, where almost separates a rat from its tail.

// 44961
[tortle_combat_weapon_chinchompa]
param=tortle_combat_weapon_name,Rabid chinchompa
param=tortle_combat_weapon_id,8
param=tortle_combat_wolfgang_reaction,How on earth would I fight with this? It is a creature with an independed mind. I surely could not force it to do my bidding.
param=tortle_combat_gustav_reaction,If this is another animal you have brought to calibrate our teleportation device, I must say it looks even less appropriate than the rabbit.
param=tortle_combat_johann_reaction,If I threw this at my enemies, perhaps it would be effective? No, that seems outlandish.
param=tortle_combat_alfred_reaction,The chinchompa hops up to Alfred's shoulder. He seems content with this new friend.

// 44962
[tortle_combat_weapon_lyre]
param=tortle_combat_weapon_name,Broken lyre
param=tortle_combat_weapon_id,6
param=tortle_combat_wolfgang_reaction,Ever since gaining consciousness, I have been oddly obsessed with music. I would rather conduct others than play myself, though.
param=tortle_combat_gustav_reaction,The planets would really need to align for this to win me any combat.
param=tortle_combat_johann_reaction,Ah the lyre, instrument of choice of the modern bardic tortle. I myself favour the pipe organ. Neither are effective weapons.
param=tortle_combat_alfred_reaction,Alfred accidentally snaps the last remaining string on the lyre as he steps on it.

// 44963
[tortle_combat_weapon_jellyfish]
param=tortle_combat_weapon_name,Half-suffocated jellyfish
param=tortle_combat_weapon_id,3
param=tortle_combat_wolfgang_reaction,This is very smooth. So smooth in fact that I conclude that no living creature could be hurt by it.
param=tortle_combat_gustav_reaction,With this in my hands, I worry more for the safety of the creature than that of my enemies.
param=tortle_combat_johann_reaction,Could I teach this animal to grab my foes and draw them in close with its appendages to get them over here? Perhaps, but ultimately unlikely.
param=tortle_combat_alfred_reaction,Alfred doesn't even blink as the jellyfish rolls off his shell and leaves behind a thick layer of slime.

// 44964
[tortle_combat_weapon_snowball]
param=tortle_combat_weapon_name,Melting snowball
param=tortle_combat_weapon_id,2
param=tortle_combat_wolfgang_reaction,Now this is truly the least dangerous object you have brought to me. I do enjoy its touch though, somewhat.
param=tortle_combat_gustav_reaction,This could indeed cause some damage, but how do I continue fighting once I have thrown it?
param=tortle_combat_johann_reaction,A thrown weapon! I had not considered this. On second thought, it is rather uncomfortable to hold.
param=tortle_combat_alfred_reaction,Alfred stares into the void as the snowball continues to melt.

// 44965
[tortle_combat_weapon_pan]
param=tortle_combat_weapon_name,Frying pan
param=tortle_combat_weapon_id,7
param=tortle_combat_wolfgang_reaction,You have thought of everything! We will not have to rely on ordering pizza going forward. Now where is that weapon you wanted to show me?
param=tortle_combat_gustav_reaction,This could be used as a shield or a blunt weapon, depending on the situation. If only it had a cutting edge as well...
param=tortle_combat_johann_reaction,Since starting a fire down here seems nigh impossible, this cooking implement seems to be but marginally useful.
param=tortle_combat_alfred_reaction,You place the pan over Alfred's head to stop a leaky pipe from continuing to drop water on it. He stays as still as a rock.

