// 37210
[cheevo_atmo_medium_reward]
param=cheevo_name,Morytania Set Tasks - Medium
param=cheevo_details,Given by Robin, in Port Phasmatys, for completing all Medium Tasks in Morytania.
param=cheevo_rewards,Morytania legs 2 and a magic lamp worth 10,000XP in a skill of your choice. Robin offers 13 lots of bonemeal in exchange for bones, and 13 free buckets of slime per day. Razmire offers a weekly choice of free planks, upgrades all olive oil vials being bought from his shop to 4 doses for free and lets you use the pyre log storage chests in Mort'ton.<br>The legs gain the following additional benefits:<br>- Ability to teleport to the slime pit under the Ectofuntus 5 times daily.<br>- Cannonball-smithing time is halved in Port Phasmatys.<br>- The mushroom patch near Canifis will no longer become diseased.<br>- Haunted tools will no longer attack you in the Abandoned Mine.
param=cheevo_icon,"shields,33"
param=cheevo_meta_list,cheevo_morytania_medium
param=cheevo_meta_list_type,0
param=cheevo_is_meta,1
param=cheevo_unique_id,1342
param=cheevo_meta_id,1702
param=cheevo_runescore,10

// 37211
[cheevo_atmo_hard_reward]
param=cheevo_name,Morytania Set Tasks - Hard
param=cheevo_details,Given by the Strange Old Man, at the Barrows, for completing all Hard Tasks in Morytania.
param=cheevo_rewards,Morytania legs 3 and a magic lamp worth 20,000XP in a skill of your choice. Robin offers 26 lots of bonemeal in exchange for bones, and 26 free buckets of slime per day.<br>The legs gain the following additional benefits:<br>- Increased chance of gaining better keys from burning shades.<br>- 50% more Prayer XP by burning shades.<br>- All ghosts will now talk to you as if you were wearing the Amulet of Ghostspeak.<br>- Prayer drain in the Barrows is reduced by 50%.<br>- Receive double runes from Barrows chests.<br>- 10% more Temple Trekking rewards.<br>- 50% chance that Blood Altar teletabs don't break on use.<br>- Access to a shortcut that leads to the Abandoned mine crystal outcrops.
param=cheevo_icon,"shields,34"
param=cheevo_meta_list,cheevo_morytania_hard
param=cheevo_meta_list_type,0
param=cheevo_is_meta,1
param=cheevo_unique_id,1343
param=cheevo_meta_id,1702
param=cheevo_runescore,15

// 37212
[cheevo_atmo_elite_reward]
param=cheevo_name,Morytania Set Tasks - Elite
param=cheevo_details,Given by Old Man Ral, in Meiyerditch, for completing all Elite Tasks in Morytania.
param=cheevo_rewards,Morytania legs 4 and magic lamps worth a total of 140,000XP in a skill of your choice. Robin offers 39 lots of bonemeal in exchange for bones, and 39 free buckets of slime per day.<br>The legs gain the following additional benefits:<br>- Each essence has a 10% chance of gaining a second blood rune at the Blood altar.<br>- 50% more Prayer XP from burning vyrewatch.<br>- 20% chance of creating a 4-dose prayer renewal potion when making it in Morytania.<br>- 10% additional Slayer XP for kills in the Slayer Tower when on a task.<br>- Double mushroom yield on the patch near Canifis.
param=cheevo_icon,"shields,35"
param=cheevo_meta_list,cheevo_morytania_elite
param=cheevo_meta_list_type,0
param=cheevo_is_meta,1
param=cheevo_unique_id,1344
param=cheevo_meta_id,1702
param=cheevo_runescore,25

