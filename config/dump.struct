// 1704
[struct_1704]
param=param_1266,Assist Sir Vant
param=param_1273,Sir Vant needs your help - talk to him to find out more.<br><br>For more information on this Task, click on the Hints tab above.
param=param_1292,Completing this Task will help you escape from the cellar in which you find yourself.
param=param_1271,"task_tutorial_icons1,1"
param=param_1293,63
param=param_1268,3501
param=param_1274,The Hints tab offers further information that will help you complete many Tasks.
param=param_1275,Some Hints have a button next to them which you can click to point you to a useful place, thing or person.
param=param_1276,For now, simply click on Sir Vant to find out what he needs from you.
param=param_1267,60
