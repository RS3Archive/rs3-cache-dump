param=task_step_1,Go and talk to <col=ffffff>Querci</col> in <col=ffffff>Kanatah</col> on <col=ffffff>Mazcab</col>.
param=task_step_2,Supply runs happen every <col=ffffff>12</col> hours at <col=ffffff>00:00</col> and <col=ffffff>12:00</col> every day.
