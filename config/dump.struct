param=pop_voyage_id,32760
param=pop_voyage_name,Meet the Biologist
param=pop_voyage_type,6
param=pop_voyage_text,A biologist from Varrock Museum is interested in the East. Bring her some samples of plant and animal life to see if there is value in sending an expedition.
param=pop_voyage_success_text,Your crew has brought a number of samples back from the Arc region, along with rumours of where more can be found.
param=pop_voyage_duration,2500
param=pop_voyage_combatdiff,0
