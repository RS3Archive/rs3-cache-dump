// 28037
[struct_28037]
param=param_463,celestial dragons
param=param_460,118
param=param_462,Celestial dragons are one of the strangest dragons I assign. They use melee but have a powerful dragonfire as well as a fascinating ability to momentarily stop time. You can find them in the depths of Dragontooth Island.
param=param_659,npc_19109

// 28038
[struct_28038]
param=param_463,Celestial dragons
param=param_460,118
param=param_462,Celestial dragons are one of the strangest dragons I assign. They use melee but have a powerful dragonfire as well as a fascinating ability to momentarily stop time. You can find them in the depths of Dragontooth Island.
param=param_659,npc_19109

// 28039
[struct_28039]
param=param_4832,Pulsar
param=param_4833,Astellarn will occasionally summon a Pulsar, which will continuously pulse for damage until destroyed.
param=param_4834,npc_25655

// 28040
[struct_28040]
param=param_4832,Neutron Star
param=param_4833,A Neutron Star will appear and gravitate towards a player in Astellarn's arena. If it comes into contact with the player it will explode for significant damage. Neutron Stars may be dragged into <col=FFFFFF>Wyrmholes</col> in order to stabilise them. Once stabilised, Wyrmholes will significantly increase the damage of anyone standing in them instead of dealing damage.
param=param_4834,npc_25654

// 28041
[struct_28041]
param=param_4832,Wyrmhole
param=param_4833,Astellarn will select a player on which to anchor a Wyrmhole. The player has a short period of time to position themselves before a Wyrmhole spawns on top of them. The Wyrmhole will deal small amounts of damage to anyone stood in or near it.

// 28042
[struct_28042]
param=param_4832,Magma Spires
param=param_4833,Verak Lith summons spires that rise up from the ground beneath his opponents. These deal immediate damage and they grant Verak Lith <col=FFFFFF>invulnerability</col> while they are present.
param=param_4834,npc_25657

// 28043
[struct_28043]
param=param_4832,Elements of the King Black Dragon
param=param_4833,Verak Lith will launch elemental energy projectiles into the air of either poison, ice or electrical energy. If these energies hit the ground, they will cause significant damage to any players in the arena. It is therefore recommended to catch the projectiles and use nearby dragon eggs of the respective elemental type to disperse the energy instead. Clever use of defensive abilities will also work.

// 28044
[struct_28044]
param=param_4832,Black Dragon Dive Bomb
param=param_4833,Throughout the encounter, black dragons will dive bomb your location, leaving a trail of dangerous ice, shock or poison energy that deals large amount of damage.

// 28045
[struct_28045]
param=param_4832,Summon Flame Vortex
param=param_4833,Verak Lith summons a patch of unstable fire, which explodes outwards into multiple flame vortices. These deal significant damage to anyone near them.

// 28046
[struct_28046]
param=param_4832,Black Stone Dragonbreath
param=param_4833,A shadowy breath attack that deals <col=FFFFFF>magic</col> damage to anyone caught in it.
param=param_4835,seq_32100
param=param_4836,seq_32101
param=param_4837,model_62283

// 28047
[struct_28047]
param=param_4832,Gemstone Shards
param=param_4833,The Black Stone Dragon sends out gemstone shards at all opponents, puncturing her targets for <col=FFFFFF>melee</col> damage, stealing their lifepoints, and completely draining their adrenaline.
param=param_4835,seq_32161

// 28048
[struct_28048]
param=param_4832,Black Hands
param=param_4833,Once she has taken some damage, the Black Stone Dragon will become shackled by four Black Hands in the centre of the arena. These Black Hands will launch <col=FFFFFF>magic</col> projectiles at the player, and occasionally slam the ground, causing shadowy grasping hands to move towards the location of their target.
param=param_4834,npc_26069

// 28049
[struct_28049]
param=param_1290,1
param=param_3630,0
param=param_1266,Cabbage Facepunch Bonanza
param=param_1273,Compete and collaborate with other players to survive an arena built by gods.
param=param_1292,Gives <col=ffffff>renown points</col>, which can be exchanged for <col=ffffff>Farming bonus XP</col>, <col=ffffff>Mining bonus XP</col>, <col=ffffff>Slayer bonus XP</col>, <col=ffffff>in-game abilities</col> and <col=ffffff>cosmetic items</col>.
param=param_1274,You can find the game in the north-east of the <col=ffffff>Gamers' Grotto</col>, just north of <col=ffffff>Falador</col>.
param=param_1275,Talk to the <col=ffffff>quartermaster</col> to choose a faction.
param=param_1276,You may play Cabbage Facepunch Bonanza <col=ffffff>as often as you wish</col>.
param=param_1282,0_99_99_2_52
param=param_1283,0_99_99_2_52
param=param_1284,0_99_99_2_52
param=param_2226,1
param=param_1271,"task_icons_48_60,8"
param=param_1293,63
param=param_1268,3062
param=param_1267,0
param=param_1269,3013
param=param_1322,1
param=param_2700,0_46_53_23_12
param=param_3631,Compete and collaborate with other players to survive. Cross the arena within the time limit to gain points, attacking enemies and harvesting from gathering nodes to increase your overall score.
param=param_6523,mining
param=param_6524,farming
param=param_6591,slayer
