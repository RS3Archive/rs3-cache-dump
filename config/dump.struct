// 41601
[settings_combat_players]
param=settings_vis,1
param=settings_label,Player attack option
param=settings_desc,This setting controls where 'Attack' appears on another a player in the 'Choose Option' menu in a player vs. player situation.<br><br><col=ffffff>Left Click:</col> First option, left click to select.<br><col=ffffff>Combat Level:</col> First option if their combat level is equal to or below your own.<br><col=ffffff>Right Click:</col> Always a secondary option.<br><col=ffffff>Hidden:</col> Always hidden.
param=control_type,5
