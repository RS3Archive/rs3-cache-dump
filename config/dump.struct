// 2799
[struct_2799]
param=param_2095,Sigmund
param=param_2096,44
param=param_2153,npc_14530
param=param_2168,npc_14531
param=param_2123,38
param=param_2124,32
param=param_2097,1
param=param_2184,This balding man is a senior member of H.A.M. and has a vicious hatred for goblins, particularly those living near his place of work at Lumbridge Castle: the Dorgeshuun. If anyone can earn the title of a 'bad guy', Sigmund can.<br><br><col=F5B241>Quest</col>: Chosen Commander<br><br><col=F5B241>Combat</col>: Seemingly to spite you as well as protect himself, Sigmund uses protection prayers against melee, ranged and magic based on how you attack him. To make things easier, you'll need to use the special attack of the ancient mace (provided in the arena) to reduce his prayer points. With the 'no ultimate abilities' handicap, you'll only have a brief time to injure him before he replenishes his prayer points.
param=param_2102,We meet again!
param=param_2118,sound_8051
param=param_2119,sound_8051
