param=param_6410,Tirannwn Set Tasks - Easy
param=param_6411,Given by the elf tracker near the Tirannwn lodestone for completing all Easy Tasks in Tirannwn.
param=param_6414,Tirannwn quiver 1 and a magic lamp worth 10,000 XP in a skill of your choice.<br>Permanent, passive benefits:<br>- Access to an elf to whom you can sell your limestone near the limestone rocks; 5% damage boost against Mourners; 15 free swamp tar per day from the Lletya General Store.<br>While wearing the quiver:<br>- Allows you to always pass through leaf traps succesfully, and acts as a chime for the warped creatures in the Poison Waste Dungeon.<br>- Grants access to a shortcut deeper into the Poison Waste Dungeon; 5% chance of tortoise shells being noted.<br>- Ability to teleport to Lletya, and to Eluned, wherever she is in the forest, or Islwyn if Eluned is unavailable.
param=param_6412,"shields,92"
param=param_6426,enum_12362
param=param_6427,0
param=param_6416,1
param=param_6413,1321
param=param_6417,1702
param=param_6755,5

// 36858
[struct_36858]
param=param_6410,Tirannwn Set Tasks - Medium
param=param_6411,Given by Gwir in Lletya for completing all Medium Tasks in Tirannwn.
param=param_6414,Tirannwn quiver 2 and a magic lamp worth 30,000 XP in a skill of your choice.<br>Permanent, passive benefits:<br>- Access to a new mushroom patch near Tyras Camp; an increase to 30 swamp tar per day from the Lletya General Store; 5% damage boost against shadow creatures.<br>- 5% chance of not using a charge on your crystal bow and wards and the ability to catch grenwalls without baiting traps.<br>While wearing the quiver:<br>- Prevents poison from traps in the forest.<br>- Tyras Camp and Poison Waste Slayer Dungeon teleports are available.
param=param_6412,"shields,93"
param=param_6426,enum_12363
param=param_6427,0
param=param_6416,1
param=param_6413,1322
param=param_6417,1702
param=param_6755,10

// 36859
[struct_36859]
param=param_6410,Tirannwn Set Tasks - Hard
param=param_6411,Given by Arianwyn in the Cadarn district for completing all Hard Tasks in Tirannwn.
param=param_6414,Tirannwn quiver 3 and a magic lamp worth 40,000 XP in a skill of your choice.<br>Permanent, passive benefits:<br>- Lord Amlodd grants 10% more shards back when exchanging pouches; Eilwynn will exchange your divination chronicles.<br>- Lunet has a daily stash of battlestaves; 5% damage boost against elves.<br>While wearing the quiver:<br>- The Corrupted Seren Stone is easier to cleanse.<br>- Death Altar, Elf Camp and Tirannwn Mushroom Patch teleports are available.<br>- Allows you to always pass through stick traps succesfully.
param=param_6412,"shields,94"
param=param_6426,enum_12364
param=param_6427,0
param=param_6416,1
param=param_6413,1323
param=param_6417,1702
param=param_6755,15

// 36860
[struct_36860]
