[pop_voyage_story_occultist_1]
param=pop_voyage_id,32754
param=pop_voyage_name,Meet the Occultist
param=pop_voyage_type,6
param=pop_voyage_text,Gongdung, a farming village, has requested help. They've captured a witch who had been killing their oxen, and they need help dealing with her.
param=pop_voyage_success_text,Your crew took the supposed 'witch' from the villagers. She killed a single ox for food, and the villagers decided to put her to death with no trial. Strange thing is, the villagers weren't able to kill her...
param=pop_voyage_duration,2500
param=pop_voyage_combatdiff,1200
param=pop_voyage_seafaringdiff,0
param=pop_voyage_graftdiff,0
param=pop_voyage_speeddiff,400
param=pop_voyage_explored_modifier,0
