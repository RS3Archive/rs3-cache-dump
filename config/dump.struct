param=cheevo_unique_id,378
param=task_step_1_arrow,0_50_50_8_15
param=task_step_1,You will need a <col=0xF0BE79>pot of flour</col>, and a sink (or container of water).
param=task_step_2,Left-click the <col=0xF0BE79>sink</col> and mix water to make <col=0xF0BE79>bread dough</col>.
param=task_step_2_mobile,Tap the <col=0xF0BE79>sink</col> and mix water to make <col=0xF0BE79>bread dough</col>.
param=task_step_3,Use the <col=0xF0BE79>dough</col> on a range or <col=0xF0BE79>oven</col> to bake the <col=0xF0BE79>bread</col>.
param=task_information,Successfully baking bread gives you Cooking experience; the bread can be eaten to heal you in combat.
param=cheevo_game,1
param=task_optional,1
param=cheevo_popup,false

