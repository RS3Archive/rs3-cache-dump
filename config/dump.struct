// 43082
[mqc_req_blood_pact_mask]
param=cheevo_name,Mask of Dragith Nurn
param=cheevo_details,Assemble the five parts of the Mask of Dragith Nurn from the Lumbridge Catacombs.
param=cheevo_unique_id,4082
param=cheevo_meta_id,1825
param=cheevo_check_type,1
param=cheevo_meta_list,mqc_req_blood_pact_mask_list
param=cheevo_meta_list_type,1
param=cheevo_game,1
param=task_requirement_1_type,61
param=task_requirement_1_value,170
param=cheevo_runescore,10
param=task_step_1,<col=0xF0BE79>Mask part 1</col> is dropped by <col=0xF0BE79>warped cockroach</col> (room 1).
param=task_step_2,<col=0xF0BE79>Mask part 2</col> is dropped by <col=0xF0BE79>corpse spider</col> (room 2) and <col=0xF0BE79>warped fly</col> (room 3).
param=task_step_3,<col=0xF0BE79>Mask part 3</col> is dropped by <col=0xF0BE79>crawling corpse torso</col> (room 4), <col=0xF0BE79>warped rat</col> (room 5) and <col=0xF0BE79>skeleton</col> (room 6).
param=task_step_4,<col=0xF0BE79>Mask part 4</col> is dropped by <col=0xF0BE79>warped bat</col> (room 7), <col=0xF0BE79>corpse archer</col> (room 8), <col=0xF0BE79>skoblin</col> (room 9) and <col=0xF0BE79>corpse mage</col> (room 10).
param=task_step_5,<col=0xF0BE79>Mask part 5</col> is dropped by <col=0xF0BE79>Dragith Nurn</col> (room 11).
param=task_information,When you have all 5 mask parts, use a mask part on a mask part in your backpack to assemble the mask of Dragith Nurn.
param=cheevo_rewards,Mask of Dragith Nurn cosmetic helmet override in Wardrobe interface.

