param=param_4834,npc_26064

// 28866
[struct_28866]
param=param_4832,Pulse of Erebus
param=param_4833,The Ambassador will cause massive shockwaves after finishing his Tri Beam attack. He is able of unleashing one shockwave for every Sinister Fragment that was reabsorbed.

