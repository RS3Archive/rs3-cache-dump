// 40354
[bslay_menaphos_slayer_boss_intro]
param=bslay_tactic_title,The Magister
param=bslay_tactic_text,A mysterious figure, he is located at the Crossing between life and death. He uses an obelisk to harness the power of souls and has a particular interest in the World Guardian's soul.

// 40355
[bslay_menaphos_slayer_boss_power_blast]
param=bslay_tactic_title,Power blast
param=bslay_tactic_text,The Magister launches a highly accurate, powerful ranged attack at his opponent.
param=bslay_tactic_animation,menaphos_oreb_power_blast_attack
param=bslay_tactic_spotanim,menaphos_oreb_power_blast_attack_spotanim

// 40356
[bslay_menaphos_slayer_boss_shadow_step]
param=bslay_tactic_title,Shadow step
param=bslay_tactic_text,If the Magister is close to his target, he will strike them with his staff, stunning them, before teleporting away. Alternatively, if he is at a distance, he will close the gap and strike his target; if they are not praying melee, their prayers will drop.
param=bslay_tactic_animation,menaphos_oreb_shadow_step_forward_start
param=bslay_tactic_spotanim,menaphos_oreb_shadow_step_forward_start_spotanim

// 40357
[bslay_menaphos_slayer_boss_grenade]
param=bslay_tactic_title,Unstable mixture
param=bslay_tactic_text,The Magister throws an unstable mixture at his target. After between 2.4 - 4.8 seconds the mixture explodes, dealing damage to all within range. The mixture can be kicked back at the Magister, dealing damage if it hits him.
param=bslay_tactic_animation,menaphos_oreb_throw_grenade

// 40358
[bslay_menaphos_slayer_boss_adds]
param=bslay_tactic_title,Those who fall...
param=bslay_tactic_text,Two imperial akh are summoned from the grave to assist the Magister in defeating his target - these may be either a warrior, mage or ranger.

// 40359
[bslay_menaphos_slayer_boss_life_drain]
param=bslay_tactic_title,Life drain
param=bslay_tactic_text,The Magister begins to drain his target's health, healing for the same amount. This attack can be interrupted by running out of range or using a melee threshold or ultimate ability against him.
param=bslay_tactic_animation,menaphos_oreb_ability_magic_threshold_choke

// 40360
[bslay_menaphos_slayer_boss_phase2]
param=bslay_tactic_title,Soul obelisk
param=bslay_tactic_text,The Magister activates the soul obelisk which then begins to drain your soul, which lowers your Constitution level. This means that your maximum health reduces the longer the fight goes on. Attacking the soul obelisk releases the energy allowing you to restore your Constitution level.

// 40361
[bslay_menaphos_slayer_boss_megaheal]
param=bslay_tactic_title,Restoration
param=bslay_tactic_text,The Magister draws energy from the soul obelisk, restoring his lifepoints.

// 40362
[bslay_menaphos_slayer_boss_phase3]
param=bslay_tactic_title,Corrupted obelisk
param=bslay_tactic_text,A corrupted obelisk appears that deals damage to the player. The obelisk can be attacked and destroyed to remove it.

