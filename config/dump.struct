// 48881
[timed_event_buff_select_event_jan24]
param=timed_event_start,7985
param=timed_event_end,7998
param=timed_event_cleanup,8000
param=timed_event_name,Birthday Buff Bonanza
param=timed_event_desc,It's <col=FFDF00>RuneScape's anniversary</col> and we wanted to celebrate in style! Welcome to the <col=FFDF00>Birthday Buff Bonanza</col>!<br><br>Each day you will be able to choose between <col=FFDF00>three unique buffs</col>. There are three types to choose from:<br>- Combat<br>- Skilling<br>- Miscellaneous<br><br>Only one buff can be activated each day. The effects of each buff will apply for 2 hours or until you log out after the day ends.<br><br>Activate <col=FFDF00>8 buffs</col> in total to earn the fabulous new <col=FFDF00>Fancy Hat</col> override, including a <col=FFDF00>retro version</col> to match your Fancy Boots!
param=timed_event_reward_desc,<br><br>Activate 8 buffs in total to unlock the <col=FFDF00>Fancy Hat</col> override, including a <col=FFDF00>retro version</col>!
param=timed_event_reward_desc_ironman,<br><br>Login for 8 days while the event is active to unlock the <col=FFDF00>Fancy Hat</col> override, including a <col=FFDF00>retro version</col>!
param=timed_event_reward_desc_f2p,<br><br>Login for 8 days while the event is active to unlock the <col=FFDF00>Fancy Hat</col> override, including a <col=FFDF00>retro version</col>!
param=timed_event_id,34
param=timed_event_type,4
param=timed_event_interface_override,buff_select_event
param=ribbon_override_icon,event_bonanza_icon_menu_takeover
param=toplevel_v2_window_icon,event_bonanza_icon_parent_takeover
param=buff_select_event_schedule,buff_select_event_schedule_jan24
param=buff_select_event_is_members_only,true
param=buff_select_event_reward_unlock_var,buff_select_event_fancy_hat

