// 33684
[struct_33684]
param=param_4832,Subdued
param=param_4833,The spirits of the heroes whose statues have been restored will provide a short window where the core fungus of Croesus is vulnerable. Run underneath Croesus and use your skills to remove the fungus. Pay attention to the spores from the fungus, as extra damage can be dealt. Successfully removing the fungus will defeat Croesus, forcing it back into a dormant state.

// 33685
[struct_33685]
param=param_4832,Croesus Attacks

// 33686
[struct_33686]
param=param_4832,Spore Bombs
param=param_4833,Croesus fires <col=FFFFFF>spore bombs</col> that leave a cloud of toxic spores on the ground for a short time. While standing in these spores, encounter skills will be drained by <col=FFFFFF>15 levels</col>.
param=param_4835,seq_34425

// 33687
[struct_33687]
param=param_4832,Fairy Rings
param=param_4833,Croesus grows a <col=FFFFFF>fairy ring</col> under players. After a short time, this will teleport them to a random location in the graveyard. Move away from fairy rings to avoid being teleported.
param=param_4835,seq_34427

// 33688
[struct_33688]
param=param_4832,Slime Mould
param=param_4833,Croesus fires a <col=FFFFFF>fungal slime mould</col> that moves towards a player. You must move to avoid the slime mould or encounter skills will be drained by <col=FFFFFF>25%</col>.
param=param_4835,seq_34424

