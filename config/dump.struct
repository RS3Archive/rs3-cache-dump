// 39141
[struct_39141]
param=param_2795,Lucky Lightning - 5% chance to perform 10% more damage.

// 39142
[struct_39142]
param=param_2795,Earth's Fury - 5% chance to stun opponent for 4.8 seconds. Only Binds in PvP.

// 39143
[struct_39143]
param=param_2795,Down to Earth - 5% chance to reduce opponent's magic level by 2 and damage by 1%. Caps at 10 levels and 5% damage.

// 39144
[struct_39144]
param=param_2795,Sea Curse - 5% chance to perform +15% damage to enemies weak to water. Performs 15% less damage on enemies weak to fire. Turns off opponent's run in PvP.

// 39145
[struct_39145]
param=param_2795,Clear Mind - 5% chance to steal 5% of your maximum prayer points from your opponent.

// 39146
[struct_39146]
param=param_2795,Magical Poison - 55% chance to inflict a single poison hit against your enemy for 2-4% of weapon damage (scaling with poison modifiers).

// 39147
[struct_39147]
param=param_2795,Blood Forfeit - 5% chance (lower on high HP targets) to hit your opponent for 20% (This percentage will scale down vs NPCs as the NPC loses health) of their lifepoints and hit yourself for 10% of your lifepoints. Caps at 10k damage (scales down from half the NPCs lifepoints) and has a 6 second cooldown vs NPCs and 3k damage vs players.

// 39148
[struct_39148]
param=param_2795,Armour Piercing - 5% chance to hit with 100% accuracy and deal up to 15% more damage.

// 39149
[struct_39149]
param=param_2795,Dragon's breath - 5% chance to hit your opponent a 2nd time for 25% of your current attack as dragonfire. Dragons and those under dragonfire protection are immune.

// 39150
[struct_39150]
param=param_2795,Life leech - 10% chance to heal up to 25% of damage potential (capping at 2.5k) and dealing 25% more damage.

// 39151
[struct_39151]
param=param_2795,Deathmark - 10% chance to instantly provide 10% adrenaline and an additional 1% adrenaline from basic abilities for 15 seconds.

