param=param_6412,"shields,61"
param=param_6426,enum_11708
param=param_6427,0
param=param_6414,Desert amulet 2 and a magic lamp worth 8,000 XP in a skill of your choice. 20 noted potato cacti per day, claimed from the Weird Old Man.<br>The amulet gains the following benefits:<br>- Goats have chance to drop noted goat horn.<br>- Unlimited teleport to Nardah.<br>- Ability to create 50 molten glass with only pot ash while outside in the desert.<br>- Reduced failure rate on the Agility Pyramid.<br>- 5% cheaper prices in the pizazz store and a second teak tree near Uzer.
param=param_6416,1
param=param_6413,1314
param=param_6417,1702
param=param_6755,10

