param=slayer_description,Acheron mammoths are honourable yet powerful beasts from the frozen north. When they charge you, get out of the way! They can be found in the snow to the west of here.
param=slayer_cl_req,100
param=slayer_sl_req,96
param=slayer_example_npc,hlm_mammoth

