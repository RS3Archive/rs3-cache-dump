// 45781
[bslay_egwd_ful_boss_intro]
param=bslay_tactic_title,TzKal-Zuk
param=bslay_tactic_text,Fighting as Ful's champion, TzKal-Zuk awaits a challenger worthy to take him on.
param=bslay_tactic_animation,egwd_ful_boss_idle

// 45782
[bslay_egwd_ful_boss_quake]
param=bslay_tactic_title,Quake
param=bslay_tactic_text,TzKal-Zuk's connection to the earth around him causes a series of small-scale earthquakes. Remaining close to a quake's location will apply the <col=FFFFFF>Armour Break</col> debuff and cause a <col=FFFFFF>Geothermal Burn</col>.
param=bslay_tactic_animation,egwd_ful_boss_attack_crush
param=bslay_tactic_spotanim,egwd_ful_boss_attack_crush_spotanim

// 45783
[bslay_egwd_ful_boss_dismember]
param=bslay_tactic_title,Dismember
param=bslay_tactic_text,TzKal-Zuk will thrust his sword into the player, causing a <col=FFFFFF>Geothermal Burn</col>.
param=bslay_tactic_animation,egwd_ful_boss_attack_stab
param=bslay_tactic_spotanim,egwd_ful_boss_attack_stab_spotanim

// 45784
[bslay_egwd_ful_boss_sear]
param=bslay_tactic_title,Sear
param=bslay_tactic_text,TzKal-Zuk inflicts a searing pain that starts to reduce the target player's maximum life points.
param=bslay_tactic_animation,egwd_ful_boss_attack_slash
param=bslay_tactic_spotanim,egwd_ful_boss_attack_slash_spotanim

// 45785
[bslay_egwd_ful_boss_empowered_magic]
param=bslay_tactic_title,Empowered Magic
param=bslay_tactic_text,TzKal-Zuk slams his target with an empowered hit for typeless damage.
param=bslay_tactic_animation,egwd_ful_boss_attack_magic

// 45786
[bslay_egwd_ful_boss_split_room]
param=bslay_tactic_title,Hard Mode - Wall of Flames
param=bslay_tactic_text,TzKal-Zuk splits the room in two with a massive wall of flames.

// 45787
[bslay_egwd_ful_boss_infernal_bomb]
param=bslay_tactic_title,Hard Mode - Igneous Bomb
param=bslay_tactic_text,TzKal-Zuk will cast a powerful magic attack and launch it toward his target for large damage upon impact. The target area will be engulfed in flames for a short period of time.
param=bslay_tactic_animation,egwd_ful_boss_attack_magic

// 45788
[bslay_egwd_ful_boss_spire]
param=bslay_tactic_title,Hard Mode - Conduit of Ful
param=bslay_tactic_text,TzKal-Zuk draws forth a Conduit of Ful which begins to heat up the room. Using this heat source, TzKal-Zuk will cast <col=FFFFFF>Igneous Bomb</col> at the target player. Severing TzKal-Zuk's connection with the Conduit will cause him to stagger and take <col=FFFFFF>20,000</col> damage. In retaliation, TzKal-Zuk will send a massive attack back toward the target player.<br>Each time the target player severs the connection, TzKal-Zuk will become more enraged, casting <col=FFFFFF>Igneous Bomb</col> at a faster rate.

// 45789
[bslay_egwd_ful_boss_infernal_adds]
param=bslay_tactic_title,Igneous Rain
param=bslay_tactic_text,TzKal-Zuk locks down sections of the arena and summons forth igneous creature as he channels.<br><br>Dealing with each igneous creature will charge the player, allowing them to stagger TzKal-Zuk as he charges his explosion.
param=bslay_tactic_animation,egwd_ful_boss_attack_infernal_rain_start
param=bslay_tactic_spotanim,egwd_ful_boss_attack_infernal_rain_start_spotanim

