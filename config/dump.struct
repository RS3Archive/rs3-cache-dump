// 15368
[cbtv2va_course_intro]
param=cbtv2ca_course_name,Introduction to Combat
param=cbtv2ca_course_description,Learn the basics of combat: attacking, lifepoints, and eating.<br><br>Demonstration:<br>Kill a lowly skeleton with your bare hands.<br><br>Hover over the rank icons to see completion requirements.
param=cbtv2ca_course_gold,#1 Legend Rank<br><br>Kill the skeleton with few or no prompts from Lady Deathknell.
param=cbtv2ca_course_silver,#2 Hero Rank<br><br>Kill the skeleton without too many prompts from Lady Deathknell.
param=cbtv2ca_course_bronze,#3 Champion Rank<br><br>Kill the skeleton.
param=cbtv2ca_course_label,storablelabel_6
param=cheevo_name,Combat Academy #1 - Introduction
param=cheevo_icon,rs3_icon_path_combat
param=cheevo_unique_id,4072
param=cheevo_details,Complete the first course at the Lumbridge Combat Academy.
param=task_step_1_arrow,0_50_50_10_56
param=task_step_1,Talk to <col=0xF0BE79>Lady Deathknell</col> at the <col=0xF0BE79>Lumbridge Combat Academy</col>.
param=cheevo_game,1
param=task_optional,1

// 15369
[cbtv2va_course_combat_styles]
param=cbtv2ca_course_name,Combat Styles
param=cbtv2ca_course_description,Learn how to attack with melee and ranged weapons and cast spells.<br><br>Demonstration:<br>Attack a training dummy with all three styles.<br><br>Hover over the rank icons to see completion requirements.
param=cbtv2ca_course_gold,#1 Legend Rank<br><br>Attack the training dummy, choosing the correct style all of the time.
param=cbtv2ca_course_silver,#2 Hero Rank<br><br>Attack the training dummy, choosing the correct style most of the time.
param=cbtv2ca_course_bronze,#3 Champion Rank<br><br>Attack the training dummy, rarely or never choosing the correct style.
param=cbtv2ca_course_label,storablelabel_3
param=cheevo_name,Combat Academy #2 - Combat Styles
param=cheevo_icon,rs3_icon_path_combat
param=cheevo_unique_id,4073
param=cheevo_details,Complete the second course at the Lumbridge Combat Academy.
param=task_step_1_arrow,0_50_50_10_56
param=task_step_1,Talk to <col=0xF0BE79>Lady Deathknell</col> at the <col=0xF0BE79>Lumbridge Combat Academy</col>.
param=cheevo_game,1
param=task_optional,1

// 15370
[cbtv2va_course_combat_triangle]
param=cbtv2ca_course_name,The Combat Triangle
param=cbtv2ca_course_description,Learn about the relationship between combat styles.<br><br>Demonstration:<br>From a selection of three skeletons, attack the skeleton that is weakest against a given weapon.<br><br>Hover over the rank icons to see completion requirements.
param=cbtv2ca_course_gold,#1 Legend Rank<br><br>Attack the weakest skeleton first time most of the time.
param=cbtv2ca_course_silver,#2 Hero Rank<br><br>Attack the weakest skeleton most of the time.
param=cbtv2ca_course_bronze,#3 Champion Rank<br><br>Attack the skeletons, rarely or never choosing the weakest skeleton.
param=cbtv2ca_course_label,storablelabel_2
param=cheevo_name,Combat Academy #3 - Combat Triangle
param=cheevo_icon,rs3_icon_path_combat
param=cheevo_unique_id,4074
param=cheevo_details,Complete the third course at the Lumbridge Combat Academy.
param=task_step_1_arrow,0_50_50_10_56
param=task_step_1,Talk to <col=0xF0BE79>Lady Deathknell</col> at the <col=0xF0BE79>Lumbridge Combat Academy</col>.
param=cheevo_game,1
param=task_optional,1

