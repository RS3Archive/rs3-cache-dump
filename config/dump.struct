[event_cs_thedrop_hard_q1]
param=thedrop_question,How do you reclaim lost holiday/seasonal items?
param=thedrop_answer_1,You can't.
param=thedrop_answer_2,Speak to Diango in-game.
param=thedrop_answer_3,Contact Customer Support.
param=thedrop_correct_answer,2
param=thedrop_question_answers,3

// 24403
[event_cs_thedrop_hard_q2]
param=thedrop_question,How do you access the RuneScape Support Centre?
param=thedrop_answer_1,Speak to a town crier.
param=thedrop_answer_2,Hit 'Support' on the website.
param=thedrop_answer_3,Speak to a player moderator.
param=thedrop_correct_answer,2
param=thedrop_question_answers,3

// 24404
[event_cs_thedrop_hard_q3]
param=thedrop_question,What times of the day do Customer Support work?
param=thedrop_answer_1,Day and night – 24/7.
param=thedrop_answer_2,Between 9AM-9PM (US time).
param=thedrop_answer_3,Between 9AM-5PM (UK time).
param=thedrop_correct_answer,1
param=thedrop_question_answers,3

// 24405
[event_cs_thedrop_hard_q4]
param=thedrop_question,If a player is annoying me in-game, what should I do?
param=thedrop_answer_1,Screenshot the chat.
param=thedrop_answer_2,Add them to your ignore list.
param=thedrop_answer_3,Annoy them back!
param=thedrop_correct_answer,2
param=thedrop_question_answers,3

