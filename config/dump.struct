// 35874
[struct_35874]
param=param_6410,Wilderness Set Tasks - Easy
param=param_6411,Given by Mr Ex, north of Edgeville bank, for completing all Easy Tasks in the Wilderness.
param=param_6412,"shields,80"
param=param_6413,1353
param=param_6426,enum_12398
param=param_6427,0
param=param_6416,1
param=param_6414,Permanent benefits:<br>- Free teleports to the Wilderness Farming patch, using the Wilderness sword<br>- Free teleports to Edgeville, using the Wilderness sword.<br>- Ability to locate the WildyWyrm with the Wilderness sword if there is one spawned on the world.
param=param_6417,1702
param=param_6755,5

// 35875
[struct_35875]
param=param_6410,Wilderness Set Tasks - Medium
param=param_6411,Given by Mandrith, in Edgeville, for completing all Medium Tasks in the Wilderness.
param=param_6412,"shields,81"
param=param_6413,1354
param=param_6426,enum_12399
param=param_6427,0
param=param_6416,1
param=param_6414,Permanent benefits:<br>- All of the benefits from the easy task set.<br>- +5% XP per lap completion at the Wilderness Agility course with the Wilderness sword equipped or in your inventory.<br>- Improved pickpocketing rates against Rogues in the Wilderness.<br>- Free teleports to the Forinthry dungeon, using the Wilderness sword.
param=param_6417,1702
param=param_6755,10

// 35876
[struct_35876]
param=param_6410,Wilderness Set Tasks - Hard
param=param_6411,Given by Quercus, at the ditch north of the Grand Exchange, for completing all Hard Tasks in the Wilderness.
param=param_6412,"shields,82"
param=param_6413,1355
param=param_6426,enum_12400
param=param_6427,0
param=param_6416,1
param=param_6414,Permanent benefits:<br>- All of the benefits from the easy & medium task set.<br>- The ability to un-note items with Harrison near the Chaos altar.<br>- A new shortcut to the Air Obelisk north of Edgeville.<br>- Teleporting to the Wilderness lodestone will always be a quick teleport.<br>- The Wilderness herb patch will never become diseased.<br>- Ability to choose your arrival destination at the Ancient Obelisks in the Wilderness.<br>- Chance to teleport to the center of the Abyss when teleporting via the Mage of Zamorak with the Wilderness sword equipped.
param=param_6417,1702
param=param_6755,15

// 35877
[struct_35877]
param=param_6410,Wilderness Set Tasks - Elite
param=param_6411,Given by Kolodion, in the Mage Arena bank, for completing all Elite Tasks in the Wilderness.
param=param_6412,"shields,83"
param=param_6413,1356
param=param_6426,enum_12401
param=param_6427,0
param=param_6416,1
param=param_6414,Permanent benefits:<br>- All of the benefits from the easy, medium & hard task set.<br>- Searing ashes will always drop noted when carrying the Wilderness sword.<br>- One free teleport per day to a Wilderness Warband camp, using the Wilderness sword.<br>- Free teleports to the Wilderness Agility course with the Wilderness sword.<br>- Teleports with the Wilderness sword will work from level 30 Wilderness up from level 20.<br>- Improved Ancient warrior equipment drop rates when defeating revenants in the Forinthry dungeon.<br>- When in the Wilderness, completion of the Animal Magnetism quest will allow team capes to provide the effects of the Ava's device.
param=param_6417,1702
param=param_6755,25

