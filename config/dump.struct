[struct_50428]

// 50429
[slayer_turael_list_entry_1]
param=slayer_name,crawling hands
param=slayer_type,39
param=slayer_description,Crawling hands are undead severed hands; fast and dexterous, they claw their victims. They can be found in the Slayer Tower, north-east of the entrance to Morytania.
param=slayer_cl_req,10
param=slayer_sl_req,5
param=slayer_example_npc,slayer_crawling_hand_1

// 50430
[slayer_turael_list_entry_2]
param=slayer_name,wolves
param=slayer_type,9
param=slayer_description,Wolves are pack animals, so you'll always find them in groups. Watch out for their bite, it can be nasty. There are plenty to kill on White Wolf Mountain.
param=slayer_cl_req,8
param=slayer_sl_req,0
param=slayer_example_npc,wolf

// 50431
[slayer_turael_list_entry_3]
param=slayer_name,cave bugs
param=slayer_type,63
param=slayer_description,Cave bugs are like cave crawlers, except smaller and easier to squish; although, they still have a fondness for plants. They lurk in the dark beneath Lumbridge Swamp.
param=slayer_cl_req,8
param=slayer_sl_req,7
param=slayer_example_npc,molanisk_giant_cave_bug

// 50432
[slayer_turael_list_entry_4]
param=slayer_name,cows
param=slayer_type,6
param=slayer_description,Cows are bigger than you, and they'll often hit hard but react fairly slowly. You can slaughter the ones in Lumbridge - I bet they are up to no good.
param=slayer_sl_req,0
param=slayer_example_npc,cow

// 50433
[slayer_turael_list_entry_5]
param=slayer_name,birds
param=slayer_type,5
param=slayer_description,Birds aren't the most intelligent of creatures, but watch out for their sharp, stabbing beaks. Even the chickens in Lumbridge are after your blood, so get them before they get you.
param=slayer_sl_req,0
param=slayer_example_npc,null

// 50434
[slayer_turael_list_entry_6]
param=slayer_name,gelatinous abominations
param=slayer_type,111
param=slayer_description,These mindless creatures attack relentlessly once provoked. There is a core floating in their chest, and they can only be beaten by bursting this core wearing spiked gauntlets, once you have damaged them enough.
param=slayer_sl_req,0
param=slayer_example_npc,omge_skill_hubs_slayer_amoeba

// 50435
[slayer_turael_list_entry_7]
param=slayer_name,trolls
param=slayer_type,18
param=slayer_description,There are plenty of trolls not far from here. Head up to the cave between the Wall and Burthorpe castle if you want to find them. There are three sub-caves in there, one with shamans, another with warriors and another with rangers. Take your pick of how to take them down!
param=slayer_sl_req,0
param=slayer_example_npc,null

// 50436
[slayer_jacquelyn_list_entry_1]
param=slayer_name,goblins
param=slayer_type,2
param=slayer_description,Goblins are mostly just annoying, but they can be vicious. Watch out for the weapons they sometimes carry. You can find them on the east side of the river here in Lumbridge.
param=slayer_sl_req,0
param=slayer_example_npc,goblin

// 50437
[slayer_jacquelyn_list_entry_2]
param=slayer_name,ghosts
param=slayer_type,12
param=slayer_description,Ghosts are undead, so not the easiest thing to find in populated areas. Try looking in the abandoned Draynor Manor.
param=slayer_cl_req,20
param=slayer_sl_req,0
param=slayer_example_npc,ghost

// 50438
[slayer_jacquelyn_list_entry_3]
param=slayer_name,skeletons
param=slayer_type,11
param=slayer_description,Skeletons are undead, so Magic is your best bet against them. Skeletons can be found in the Lumbridge Catacombs.
param=slayer_cl_req,15
param=slayer_sl_req,0
param=slayer_example_npc,skeleton_unarmed

// 50439
[slayer_jacquelyn_list_entry_4]
param=slayer_name,bats
param=slayer_type,8
param=slayer_description,Bats are rarely found on the ground, so you'll have to fight them while they're airborne. You can find some flying around in the Lumbridge Catacombs.
param=slayer_cl_req,15
param=slayer_sl_req,0
param=slayer_example_npc,bat

// 50440
[slayer_jacquelyn_list_entry_5]
param=slayer_name,zombies
param=slayer_type,10
param=slayer_description,Zombies are undead, so be careful. You can find a variety of corpse fighters in the Lumbridge Catacombs or zombies in the sewers under Draynor village.
param=slayer_cl_req,9
param=slayer_sl_req,0
param=slayer_example_npc,zombie_unarmed_sewer1

// 50441
[slayer_jacquelyn_list_entry_6]
param=slayer_name,spiders
param=slayer_type,4
param=slayer_description,Spiders are often venomous and many varieties are camouflaged, too. I've seen plenty to the south-west of Lumbridge.
param=slayer_sl_req,0
param=slayer_example_npc,giantspider1

// 50442
[slayer_jacquelyn_list_entry_7]
param=slayer_name,birds
param=slayer_type,5
param=slayer_description,Birds aren't the most intelligent of creatures, but watch out for their sharp, stabbing beaks. Even the chickens in Lumbridge are after your blood, so get them before they get you.
param=slayer_sl_req,0
param=slayer_example_npc,chicken

// 50443
[slayer_jacquelyn_list_entry_8]
param=slayer_name,frogs
param=slayer_type,162
param=slayer_description,Frogs will attack and move faster than the average human, but on the whole an experienced warrior can deal with a lot of them quite quickly. You can find them in the swamp to the south.
param=slayer_sl_req,0
param=slayer_example_npc,giant_frog

// 50444
[slayer_jacquelyn_list_entry_9]
param=slayer_name,cave slime
param=slayer_type,62
param=slayer_description,Cave slimes are the lesser cousins of jellies. Don't be fooled, though: they can still be dangerous, as they're often poisonous. Killing the ones beneath Lumbridge Swamp might be a good start. 
param=slayer_cl_req,25
param=slayer_sl_req,17
param=slayer_example_npc,swamp_cave_slime

// 50445
[slayer_jacquelyn_list_entry_10]
param=slayer_name,cave bugs
param=slayer_type,63
param=slayer_description,Cave bugs are like cave crawlers, except smaller and easier to squish; although, they still have a fondness for plants. They lurk in the dark beneath Lumbridge Swamp.
param=slayer_cl_req,15
param=slayer_sl_req,7
param=slayer_example_npc,molanisk_giant_cave_bug

// 50446
[slayer_jacquelyn_list_entry_11]
param=slayer_name,cows
param=slayer_type,6
param=slayer_description,Cows are bigger than you, and they'll often hit hard but react fairly slowly. You can slaughter the ones in Lumbridge - I bet they are up to no good.
param=slayer_sl_req,0
param=slayer_example_npc,cow

// 50447
[slayer_jacquelyn_list_entry_12]
param=slayer_name,rats
param=slayer_type,3
param=slayer_description,Rats come in different sizes if you want a challenge or not. You can find the normal variety lurking around the castle grounds or head south into the swamp for giant rats.
param=slayer_sl_req,0
param=slayer_example_npc,giantrat1_2_passive

// 50448
[slayer_mazchna_list_entry_1]
param=slayer_name,shadow warriors
param=slayer_type,32
param=slayer_description,Shadow warriors are dark and mysterious. They hide in the shadows, so be wary of ambushes. The basement of the Legends' Guild harbours these menaces.
param=slayer_cl_req,65
param=slayer_sl_req,0
param=slayer_example_npc,shadow_warrior

// 50449
[slayer_mazchna_list_entry_2]
param=slayer_name,werewolves
param=slayer_type,33
param=slayer_description,Werewolves are feral creatures; strong and tough with sharp claws and teeth. The village of Canifis is home to many of them.
param=slayer_cl_req,60
param=slayer_sl_req,0
param=slayer_example_npc,canafis_werewolf_woman1

// 50450
[slayer_mazchna_list_entry_3]
param=slayer_name,bloodvelds
param=slayer_type,48
param=slayer_description,Bloodveld are strange, demonic creatures that use their long, rasping tongue to feed on just about anything they can find. If you wish to slay some, they live in the Slayer Tower to the north-west of Canifis.
param=slayer_cl_req,65
param=slayer_sl_req,50
param=slayer_example_npc,slayer_bloodveld

// 50451
[slayer_mazchna_list_entry_4]
param=slayer_name,killerwatts
param=slayer_type,73
param=slayer_description,Killerwatts store huge amounts of energy in their bodies, which is released if they are touched. You'll need to wear heavily insulated boots to counter this shocking effect, plus they can attack speedily with both magic and missiles. To access their cloudy plane, you'll need to explore Draynor Manor.
param=slayer_cl_req,60
param=slayer_sl_req,37
param=slayer_example_npc,slayer_killerwatt

// 50452
[slayer_mazchna_list_entry_5]
param=slayer_name,crocodiles
param=slayer_type,65
param=slayer_description,Crocodiles are large reptiles that live in the Kharidian Desert near water. River crocodiles are a bigger challenge than the ones found next to the ocean in the south east.
param=slayer_cl_req,40
param=slayer_sl_req,0
param=slayer_example_npc,ics_little_croc

// 50453
[slayer_mazchna_list_entry_6]
param=slayer_name,ogres
param=slayer_type,20
param=slayer_description,Ogres are brutal creatures, favouring large blunt maces and clubs. They often attack without warning. South of Yanille is an area ruled by these man-devourers.
param=slayer_cl_req,65
param=slayer_sl_req,0
param=slayer_example_npc,ogre

// 50454
[slayer_mazchna_list_entry_7]
param=slayer_name,sea snakes
param=slayer_type,71
param=slayer_description,Sea snakes are long and slithery, with a venomous bite. The larger ones are more dangerous, so keep an eye on your health. They live on isles far to the north-west, or, rather, in the sea caves of those isles.
param=slayer_cl_req,60
param=slayer_sl_req,0
param=slayer_example_npc,royal_sea_snake_medium

// 50455
[slayer_mazchna_list_entry_8]
param=slayer_name,moss giants
param=slayer_type,17
param=slayer_description,Like other giants, moss giants often wield large weapons. Use fire spells to burn them to cinders before they can damage you. Strangely for giants, some have been seen at the end of the Varrock sewers.
param=slayer_sl_req,0
param=slayer_example_npc,mossgiant

// 50456
[slayer_mazchna_list_entry_9]
param=slayer_name,aberrant spectres
param=slayer_type,41
param=slayer_description,Aberrant spectres are fetid, vile ghosts. The very smell of them will paralyse and harm you. A nosepeg will help you ignore their stink and make you fight at full capacity. Sniff them out in the Slayer Tower in Morytania.
param=slayer_cl_req,70
param=slayer_sl_req,60
param=slayer_example_npc,slayer_abberant_spectre_1

// 50457
[slayer_mazchna_list_entry_10]
param=slayer_name,lesser demons
param=slayer_type,28
param=slayer_description,Lesser demons are magic creatures, so they are weak to ranged attacks. Although they're relatively weak, they are still dangerous. Taverley Dungeon is home to these foul creatures.
param=slayer_cl_req,65
param=slayer_sl_req,0
param=slayer_example_npc,lesser_demon

// 50458
[slayer_mazchna_list_entry_11]
param=slayer_name,jungle horrors
param=slayer_type,81
param=slayer_description,Jungle horrors can be found all over Mos Le'Harmless. They are strong, aggressive and fight in packs, so watch out!
param=slayer_cl_req,65
param=slayer_sl_req,0
param=slayer_example_npc,harmless_island_jungle_horror_guard

// 50459
[slayer_mazchna_list_entry_12]
param=slayer_name,turoths
param=slayer_type,36
param=slayer_description,Turoths are large, vicious creatures with thick hides. You'll need a leaf-bladed weapon, broad arrows or a magic dart to harm them. You can find a nest of them in the Rellekka Slayer Caves.
param=slayer_cl_req,60
param=slayer_sl_req,55
param=slayer_example_npc,slayer_turoth_child

// 50460
[slayer_mazchna_list_entry_13]
param=slayer_name,ankous
param=slayer_type,79
param=slayer_description,Ankous are neither ghost nor skeleton, but a combination of both. Not much is known of these creatures. Perform some research in the depths of the Stronghold of Security.
param=slayer_cl_req,55
param=slayer_sl_req,0
param=slayer_example_npc,sos_death_ankou

// 50461
[slayer_mazchna_list_entry_14]
param=slayer_name,ice giants
param=slayer_type,15
param=slayer_description,Like other giants, ice giants often wield large weapons. Try using fire spells to melt them before they can hit you. Ice giants can be found underground to the south of Port Sarim.
param=slayer_example_npc,icegiant

// 50462
[slayer_mazchna_list_entry_15]
param=slayer_name,green dragons
param=slayer_type,24
param=slayer_description,Green dragons are the weakest dragons but they are still very powerful. Watch out for their fiery breath. These brutes live out in the Wilderness.
param=slayer_cl_req,60
param=slayer_sl_req,0
param=slayer_example_npc,green_dragon

// 50463
[slayer_mazchna_list_entry_16]
param=slayer_name,jellies
param=slayer_type,50
param=slayer_description,Jellies are nasty, cube-like gelatinous creatures that absorb everything they come across. Their acidic touch attacks in the same fashion as many magics, so prepare your armour beforehand. They keep parts of Rellekka Slayer Caves clean.
param=slayer_cl_req,65
param=slayer_sl_req,52
param=slayer_example_npc,slayer_jelly_1

// 50464
[slayer_mazchna_list_entry_17]
param=slayer_name,infernal mages
param=slayer_type,40
param=slayer_description,Infernal mages are dangerous spell users; beware of their Magic spells and go properly prepared. They have taken over an area upstairs in the Slayer Tower, plotting your doom.
param=slayer_cl_req,70
param=slayer_sl_req,45
param=slayer_example_npc,slayer_infernal_mage_1

// 50465
[slayer_mazchna_list_entry_18]
param=slayer_name,brine rats
param=slayer_type,84
param=slayer_description,Brine rats can be found in caves near to the sea. They are hairless, bad-tempered and generally unfriendly. If you have found Olaf's pirate treasure, you'll know where to find these targets.
param=slayer_sl_req,47
param=slayer_example_npc,olaf2_brine_rats

// 50466
[slayer_mazchna_list_entry_19]
param=slayer_name,basilisks
param=slayer_type,43
param=slayer_description,Basilisks, like cockatrices, have a gaze which will paralyse and harm their prey. You'll need a mirror shield to protect you. Basilisks live in the Rellekka Slayer Caves, along with their cockatrice relatives.
param=slayer_cl_req,70
param=slayer_sl_req,40
param=slayer_example_npc,slayer_basilisk

// 50467
[slayer_mazchna_list_entry_20]
param=slayer_name,vampyres
param=slayer_type,34
param=slayer_description,Vampyres are extremely powerful beings. They feed on the blood of the living, so watch that you don't get bitten. Look in the woods of Morytania.
param=slayer_cl_req,55
param=slayer_sl_req,0
param=slayer_example_npc,vampire_flyer

// 50468
[slayer_mazchna_list_entry_21]
param=slayer_name,molanisks
param=slayer_type,87
param=slayer_description,Molanisks are subterranean creatures. You can find them in caves deep below the ground. I heard that the goblins have recently had trouble with some, but they use a bell to lure them from the cave wall.
param=slayer_sl_req,39
param=slayer_example_npc,molanisk

// 50469
[slayer_mazchna_list_entry_22]
param=slayer_name,pyrefiends
param=slayer_type,47
param=slayer_description,Pyrefiends are magical beings of fire and molten rock. They're quick and agile so try attacking them with a crossbow and bolts. You can find some fiends in the Rellekka Slayer Caves.
param=slayer_cl_req,55
param=slayer_sl_req,30
param=slayer_example_npc,slayer_pyrefiend_1

// 50470
[slayer_mazchna_list_entry_23]
param=slayer_name,shades
param=slayer_type,64
param=slayer_description,Shades are undead - The town of Mort'ton in Morytania is plagued by these creatures, so help if you can. There are some shades in the Stronghold of Security too, but you won't learn much from fighting those; stick to Mort'ton.
param=slayer_sl_req,0
param=slayer_example_npc,shade_level1

// 50471
[slayer_mazchna_list_entry_24]
param=slayer_name,earth warriors
param=slayer_type,54
param=slayer_description,Earth warriors are an elemental warrior pieced together by rocks. Water washes them away easily so use spells of that type. They form from the rocks beneath Edgeville.
param=slayer_cl_req,70
param=slayer_sl_req,0
param=slayer_example_npc,earthwarrior

// 50472
[slayer_mazchna_list_entry_25]
param=slayer_name,cockatrices
param=slayer_type,44
param=slayer_description,Cockatrices, like basilisks, have a gaze which will paralyse and harm their prey. You'll need a mirror shield to protect you. If you are brave enough, head to Slayer Caves east of Rellekka.
param=slayer_sl_req,25
param=slayer_example_npc,slayer_cockatrice

// 50473
[slayer_mazchna_list_entry_26]
param=slayer_name,otherworldly beings
param=slayer_type,55
param=slayer_description,Otherworldly beings are ethereal creatures, making them weak to ranged attacks. They can be found haunting Zanaris.
param=slayer_cl_req,60
param=slayer_sl_req,0
param=slayer_example_npc,otherworldly_being

// 50474
[slayer_mazchna_list_entry_27]
param=slayer_name,ice warriors
param=slayer_type,19
param=slayer_description,Ice warriors are a kind of ice elemental. Thurgo the dwarf recently spotted some in the caves south of Port Sarim.
param=slayer_sl_req,0
param=slayer_example_npc,icewarrior

// 50475
[slayer_mazchna_list_entry_28]
param=slayer_name,ghouls
param=slayer_type,23
param=slayer_description,Ghouls aren't undead, but they are stronger and tougher than they look. They're also very cowardly and will run if they're losing a fight. They wait to ambush those entering the graveyard to the  North of Canifis.
param=slayer_cl_req,60
param=slayer_sl_req,0
param=slayer_example_npc,ghoul

// 50476
[slayer_mazchna_list_entry_29]
param=slayer_name,banshees
param=slayer_type,38
param=slayer_description,Banshees use a piercing scream to shock their enemies; you'll need some earmuffs to protect yourself from them. Their cries echo throughout the Slayer Tower in Morytania.
param=slayer_sl_req,15
param=slayer_example_npc,slayer_banshee_1

// 50477
[slayer_mazchna_list_entry_30]
param=slayer_name,cyclopes
param=slayer_type,108
param=slayer_description,Cyclopes are tricky giants, originally from the far-eastern lands. The brave warriors in the guild near Burthorpe have a collection of them; however, they are immune to anything other than melee attacks. Other specimens aren't so tough, and can be found in the God Wars Dungeon.
param=slayer_sl_req,0
param=slayer_example_npc,warguild_cyclops1

// 50478
[slayer_mazchna_list_entry_31]
param=slayer_name,grotworms
param=slayer_type,112
param=slayer_description,Grotworms have recently been spotted in a cave near Rimmington. The younger specimens haven't fully developed their mandibles yet, and will attack with some sort of acid spit.
param=slayer_sl_req,0
param=slayer_example_npc,qbd2_worm1

// 50479
[slayer_mazchna_list_entry_32]
param=slayer_name,dogs
param=slayer_type,22
param=slayer_description,Dogs are much like wolves; they are pack creatures that will hunt in groups. I've heard there are fearsome wild dogs beneath Karamja, or near Ardougne if you are less adventurous.
param=slayer_sl_req,0
param=slayer_example_npc,dog_wild

// 50480
[slayer_mazchna_list_entry_33]
param=slayer_name,cave crawlers
param=slayer_type,37
param=slayer_description,Cave crawlers are small and fast, often seen creeping around in the Rellekka Slayer Dungeon. Avoid their barbed tongue or you'll get poisoned.
param=slayer_sl_req,10
param=slayer_example_npc,slayer_cave_crawler_1

// 50481
[slayer_mazchna_list_entry_34]
param=slayer_name,desert lizards
param=slayer_type,68
param=slayer_description,Desert lizards are large reptiles with tough skin. They're cold-blooded, so dousing them with freezing water will finish them off after a tough battle. You can find them to the east of Sophanem.
param=slayer_cl_req,60
param=slayer_sl_req,22
param=slayer_example_npc,slayer_lizard_large1_green

// 50482
[slayer_mazchna_list_entry_35]
param=slayer_name,rock slugs
param=slayer_type,51
param=slayer_description,Rock slugs are strange, stoney slugs, many of which have been seen in Rellekka Slayer Cave. You'll need to fight them until they are close to death, before finishing them off with salt.
param=slayer_sl_req,20
param=slayer_example_npc,slayer_rockslug

// 50483
[slayer_raptor_list_entry_1]
param=slayer_name,bound skeletons
param=slayer_type,186
param=slayer_description,Animated by Zemouregal, you can find bound skeletons swarming inside the crypts north of Fort Forinthry. You'll find earth magic effective at breaking down their ancient bones.
param=slayer_sl_req,50
param=slayer_example_npc,fort_slayer_skeleton_mid_1

// 50484
[slayer_raptor_list_entry_2]
param=slayer_name,fetid zombies
param=slayer_type,185
param=slayer_description,These pitiful creatures have no mind of their own and seek only the flesh of their enemies. You can find fetid zombies inside the crypts north of Fort Forinthry. You'll find using magic effective against them.
param=slayer_sl_req,1
param=slayer_example_npc,fort_slayer_zombie_easy_1

// 50485
[slayer_raptor_list_entry_3]
param=slayer_name,armoured phantoms
param=slayer_type,188
param=slayer_description,You can find armoured phantoms swarming inside the crypts north of Fort Forinthry. Their hateful spirits seek only violence. You'll find crush weapons effective at breaking down their ability to move.
param=slayer_sl_req,113
param=slayer_example_npc,fort_slayer_phantom_high_1

// 50486
[slayer_raptor_list_entry_4]
param=slayer_name,risen ghosts
param=slayer_type,187
param=slayer_description,These tortured spirits have been risen from the dead by Zemouregal and are bound to his will. You can find risen ghosts inhabiting the depths within the crypts north of Fort Forinthry, waiting for Zemouregal's command. You'll find bows effective against this target.
param=slayer_sl_req,85
param=slayer_example_npc,fort_slayer_ghost_hard_1

// 50487
[slayer_raptor_list_entry_5]
param=slayer_name,Zemouregal's undead
param=slayer_type,189
param=slayer_description,Undead raised by the necromancer Zemouregal. They lurk in the crypt north of Fort Forinthry.
param=slayer_sl_req,50
param=slayer_example_npc,fort_slayer_skeleton_mid_1

// 50488
[slayer_raptor_list_entry_6]
param=slayer_name,undead
param=slayer_type,191
param=slayer_description,You can find many types of undead around Gielinor, notably those festering inside the crypts north of Fort Forinthry.
param=slayer_sl_req,1
param=slayer_example_npc,fort_slayer_skeleton_mid_1

// 50489
[slayer_raptor_list_entry_7]
param=slayer_name,demons
param=slayer_type,174
param=slayer_description,You can find many types of demons around Gielinor, notably the abyssal demons infesting the Canifis Slayer Tower.
param=slayer_sl_req,1
param=slayer_example_npc,slayer_abyssal

// 50490
[slayer_raptor_list_entry_8]
param=slayer_name,ghosts
param=slayer_type,12
param=slayer_description,You can find many types of ghosts around Gielinor, notably those flooding the crypts north of Fort Forinthry.
param=slayer_sl_req,1
param=slayer_example_npc,fort_slayer_ghost_hard_1

// 50491
[slayer_raptor_list_entry_9]
param=slayer_name,zombies
param=slayer_type,10
param=slayer_description,You can find many types of zombies around Gielinor, notably those flooding the crypts north of Fort Forinthry.
param=slayer_sl_req,1
param=slayer_example_npc,fort_slayer_zombie_easy_1

// 50492
[slayer_raptor_list_entry_10]
param=slayer_name,skeletons
param=slayer_type,11
param=slayer_description,You can find many types of skeletons around Gielinor, notably those flooding the crypts north of Fort Forinthry.
param=slayer_sl_req,1
param=slayer_example_npc,fort_slayer_skeleton_mid_1

// 50493
[slayer_raptor_list_entry_11]
param=slayer_name,abyssal demons
param=slayer_type,180
param=slayer_description,Abyssal demons are nasty creatures to deal with. They teleport around to confuse and trap their prey. They can be found within the Canifis Slayer Tower or inhabiting the Senntisten Asylum.
param=slayer_sl_req,85
param=slayer_example_npc,slayer_abyssal

// 50494
[slayer_raptor_list_entry_12]
param=slayer_name,dragons
param=slayer_type,173
param=slayer_description,You can find dragons through Gielinor. Many types of them can be found within Brimhaven Dungeon.
param=slayer_sl_req,1
param=slayer_example_npc,green_dragon

// 50495
[slayer_raptor_list_entry_13]
param=slayer_name,black dragons
param=slayer_type,27
param=slayer_description,Black dragons are the strongest of the chromatic dragons. They can be found resting within Taverley Dungeon. Using crossbows would be advantageous.
param=slayer_cl_req,75
param=slayer_sl_req,1
param=slayer_example_npc,black_dragon

// 50496
[slayer_raptor_list_entry_14]
param=slayer_name,green dragons
param=slayer_type,24
param=slayer_description,Green dragons are the weakest of the chromatic dragons and can be found west of the Dark Warriors Fortress. Using crossbows would be advantageous.
param=slayer_sl_req,1
param=slayer_example_npc,green_dragon

