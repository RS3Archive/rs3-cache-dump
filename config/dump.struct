// 33555
[gower_cabbage_pet_info]
param=mtxmgt_pet_adult_npc,gower_cabbage_pet

// 33556
[struct_33556]

// 33557
[bslay_arraxi_tactics_p2_cowardice]
param=bslay_tactic_title,Cowardice
param=bslay_tactic_text,If Araxxor cannot attack his target for too long, the spiders above will hurt them for him, draining their run energy.

// 33558
[bslay_zilyana_tactics_stomp_hm]
param=bslay_tactic_title,Stomp: <col=DC7800>Hard mode only
param=bslay_tactic_text,Players who stand under Commander Zilyana risk being stomped and briefly stunned.
param=bslay_tactic_animation,mah5_cutscene_zilyana_lie_on_ground_pose
param=bslay_tactic_new_npc,godwars_saradomin_avatar_hard_dead

// 33559
[bslay_graardor_tactics_stomp_hm]
param=bslay_tactic_title,Graardor mad: <col=DC7800>Hard mode only
param=bslay_tactic_text,General Graardor is mad! During this attack he will remain stationary and deal <col=FFFFFF>melee</col> damage to players in front of him.

// 33560
[bslay_mole_tactics_rubble]
param=bslay_tactic_title,Rubble!
param=bslay_tactic_text,If the Giant Mole cannot reach her target, she will shake the ground beneath their feet, creating rubble that damages the player where they stand.

// 33561
[bslay_mole_tactics_upheaval]
param=bslay_tactic_title,Phase 2A: Upheaval
param=bslay_tactic_text,The Giant Mole will burrow into the ground and resurface near one of her targets. As she resurfaces, the ground around her will shake, damaging anyone caught on the debris.
param=bslay_tactic_animation,mole2_giant_mole_burrowing
param=bslay_tactic_spotanim,mole2_giant_mole_burrowing_spotanim
param=bslay_tactic_spotanim_model,mtx_demon_teleport_spotanim
param=bslay_tactic_new_npc,mole2_giant

// 33562
[bslay_mole_tactics_last_resort]
param=bslay_tactic_title,Phase 3 Last Resort
param=bslay_tactic_text,Once the Giant Mole has been significantly weakened, she will return to the central chamber, where she will use every attack available in an attempt to defeat her targets.

// 33563
[bslay_kk_tactics_wallslam]
param=bslay_tactic_title,Wall Slam
param=bslay_tactic_text,Players who stand between the king and the perimeter of his room risk being slammed into the wall for massive damage.

// 33564
[bslay_kreearra_tactics_stomp_hm]
param=bslay_tactic_title,Stomp: <col=DC7800>Hard Mode Only
param=bslay_tactic_text,Players who stand under Kree'arra risk being stomped and briefly stunned.

// 33565
[bslay_kril_tactics_stomp_hm]
param=bslay_tactic_title,Stomp: <col=DC7800>Hard Mode only
param=bslay_tactic_text,Players who stand under K'ril Tsutsaroth risk being stomped and briefly stunned.

// 33566
[bslay_nex_tactics_drag]
param=bslay_tactic_title,Drag
param=bslay_tactic_text,Nex will drag random players towards her, stunning them and temporarily disabling their protection prayers.

// 33567
[bslay_nex_tactics_teleport]
param=bslay_tactic_title,Teleport
param=bslay_tactic_text,If Nex is unable to attack her target for too long, she will teleport to elsewhere in the room and begin looking for them again. Depending on where she lands, she may also inflict players with a stun.

// 33568
[bslay_vorago_tactics_cowardice]
param=bslay_tactic_title,Cowardice
param=bslay_tactic_text,If Vorago cannot attack his targets for too long, they will take an unavoidable hit.

// 33569
[bslay_beastmaster_ambush]
param=bslay_tactic_title,Ambush
param=bslay_tactic_text,Before you can fight the Beastmaster, you must first endure several waves of aggressive foot soldiers.

// 33570
[bslay_beastmaster_airut]
param=bslay_tactic_title,Airut
param=bslay_tactic_text,The airut that enter the Pit of Trials are much more powerful than those you'll find anywhere else. They will attack with either <col=FFFFFF>ranged</col> or <col=FFFFFF>melee</col>, and have the potential to deal massive damage rapidly.<br><br>Unlike their brethren elsewhere, these airut require <col=FFFFFF>no Slayer knowledge</col> to harm.
param=bslay_tactic_animation,hotm_tuska_harbinger_standing_attack
param=bslay_tactic_new_npc,raid1_beastmaster_airut_melee

// 33571
[bslay_beastmaster_chargers]
param=bslay_tactic_title,Chargers
param=bslay_tactic_text,Chargers are vicious, dog-like creatures that are equipped with a spiked helmet. They will charge at their target and begin biting them with <col=FFFFFF>melee</col> attacks.
param=bslay_tactic_animation,mtx_pets_wolfdragon_adult_attack_tuska_raid
param=bslay_tactic_new_npc,raid1_beastmaster_charger

// 33572
[bslay_beastmaster_cormes]
param=bslay_tactic_title,Cormes
param=bslay_tactic_text,Midway through the ambush, Cormes will emerge from the <col=FFFFFF>western</col> entrance of the arena. Cormes can attack from all three sides of the combat triangle. He will attack his target with either <col=FFFFFF>magic</col> or <col=FFFFFF>ranged</col> based on his target's defences.<br><br>Cormes' magic attack can inflict a burn; his ranged attack will drain run energy. Both attacks will hit any targets near his main target.<br><br>Cormes may also charge at a player, stunning them and hitting them for <col=FFFFFF>melee</col> damage.
param=bslay_tactic_animation,tuska_raids_beastmaster_dog_attack
param=bslay_tactic_new_npc,raid1_horde_pet

// 33573
[bslay_beastmaster_bmenters]
param=bslay_tactic_title,Beastmaster Durzag
param=bslay_tactic_text,After surviving the initial onslaught, Beastmaster Durzag himself will enter the arena from the north. Along with him will be one of his pets, either <col=FFFFFF>Krar</col> or <col=FFFFFF>Tuz</col>.<br><br>The beastmaster will attack with <col=FFFFFF>melee</col> and <col=FFFFFF>ranged</col>. He will also have <col=FFFFFF>bombs, chargers,</col> and <col=FFFFFF>cages</col> at his disposal.
param=bslay_tactic_animation,tuska_raids_beastmaster_intro_spawn
param=bslay_tactic_new_npc,raid1_beastmaster

// 33574
[bslay_beastmaster_bmcage]
param=bslay_tactic_title,Cage
param=bslay_tactic_text,Durzag picks a target and throws a cage at them, preventing them from moving.
param=bslay_tactic_animation,tuska_raids_beastmaster_call_cages
param=bslay_tactic_new_npc,raid1_beastmaster

// 33575
[bslay_beastmaster_bmmeleep]
param=bslay_tactic_title,Melee Punch
param=bslay_tactic_text,The beastmaster punches his target directly, dealing heavy <col=FFFFFF>melee</col> damage.
param=bslay_tactic_animation,tuska_raids_beastmaster_attack_melee
param=bslay_tactic_new_npc,raid1_beastmaster

// 33576
[bslay_beastmaster_bmmelees]
param=bslay_tactic_title,Melee Slam
param=bslay_tactic_text,The beastmaster will slam his main target with a powerful punch. The smash is so powerful, it will deal melee damage to both players and monsters within <col=FFFFFF>2 squares</col> of himself or his target.
param=bslay_tactic_animation,tuska_raids_beastmaster_attack_smash
param=bslay_tactic_new_npc,raid1_beastmaster

// 33577
[bslay_beastmaster_bmranged]
param=bslay_tactic_title,Ranged Attack
param=bslay_tactic_text,As the beastmaster attacks his main target, he will also launch spines that target those who are not under the attention of one of his pets, dealing ranged damage.
param=bslay_tactic_animation,tuska_raids_beastmaster_attack_ranged
param=bslay_tactic_new_npc,raid1_beastmaster

// 33578
[bslay_beastmaster_bmenrage]
param=bslay_tactic_title,Enrage
param=bslay_tactic_text,As the fight progresses, Durzag will grow enraged at his target. As his rage grows stronger, he will deal more damage and reset defensive abilities more often. The effect of his enrage can be countered with the <col=FFFFFF>Freedom</col> ability. Durzag also has a short attention span, and he will forget about his anger after some time if not focused on that target.
param=bslay_tactic_animation,tuska_raids_beastmaster_roar
param=bslay_tactic_new_npc,raid1_beastmaster

// 33579
[bslay_beastmaster_bmflurry]
param=bslay_tactic_title,Flurry
param=bslay_tactic_text,Durzag flails his arms wildly, dragging other targets in front of him and dealing melee damage to anyone caught in the attack.
param=bslay_tactic_animation,tuska_raids_beastmaster_flurry
param=bslay_tactic_new_npc,raid1_beastmaster

// 33580
[bslay_beastmaster_bmbombs]
param=bslay_tactic_title,Bombs
param=bslay_tactic_text,Durzag will throw a bomb at a random target, these bombs will follow a player but can be avoided or disarmed. If not defused, it will explode for <col=FFFFFF>magic</col> damage and reset the defensive abilities of anyone caught in the blast. The explosion is powerful, and it will hurt Durzag's beasts just as much as it hurts his targets.<br><br>Once one of his pets has been killed, Durzag will throw a bomb for every target.
param=bslay_tactic_animation,tuska_raids_beastmaster_throw_bomb_player
param=bslay_tactic_new_npc,raid1_beastmaster

// 33581
[bslay_beastmaster_bmchargers]
param=bslay_tactic_title,Chargers
param=bslay_tactic_text,Durzag drops several cages nearby, each containing a trapped <col=FFFFFF>charger</col>. The cage containing the chargers can be opened by a teammate, otherwise they will all open at once on their own at 70%, attacking whoever set them free. If left imprisoned, they will break free themselves, and attack whomever they please.<br><br>When the fight begins, the cages that line the perimeter of the arena will also hold chargers. It is advised to <col=FFFFFF>free them yourself</col> to have full control over whom they can attack.
param=bslay_tactic_animation,mtx_pets_wolfdragon_adult_attack_tuska_raid
param=bslay_tactic_new_npc,raid1_beastmaster_charger

// 33582
[struct_33582]

// 33583
[bslay_beastmaster_pets]
param=bslay_tactic_title,Pets
param=bslay_tactic_text,Beastmaster Durzag has two pets that will help him in the fight. Both of Durzag's beasts have some shared attacks, but they still have their own methods of killing their target.<br><br>Durzag's first pet will enter the arena with him. His second pet will arrive when called, after his first beast is around <col=FFFFFF>70%</col> life points.
param=bslay_tactic_animation,tuska_raids_beastmaster_dog_pet_run
param=bslay_tactic_new_npc,raid1_beastmaster_pet2

// 33584
[bslay_beastmaster_petsmelee]
param=bslay_tactic_title,Melee attack
param=bslay_tactic_text,The beast will bite at their target, hitting anyone in the front of them for <col=FFFFFF>melee</col> damage. If their target is up close, then the beasts will focus on biting them.<br><br>The bite can also open a flesh wound, increasing the damage that target takes from attacks. The wound can be partially healed with the <col=FFFFFF>Freedom</col> ability, and it will slowly close itself over time; however, the beast may not let up, and continue to open the wound to prevent it from healing.
param=bslay_tactic_animation,tuska_raids_beastmaster_dog_attack
param=bslay_tactic_new_npc,raid1_beastmaster_pet2

// 33585
[bslay_beastmaster_petspounce]
param=bslay_tactic_title,Pounce
param=bslay_tactic_text,The beast will pounce at a target and begin to attack them with melee. When they pounce, they will also briefly stun the target.
param=bslay_tactic_animation,tuska_raids_beastmaster_dog_attack_ranged
param=bslay_tactic_new_npc,raid1_beastmaster_pet2

// 33586
[bslay_beastmaster_petskrar]
param=bslay_tactic_title,Krar
param=bslay_tactic_text,If his target is out of biting distance, Krar will fling spines at them and anyone nearby.<br><br>These spines deal heavy <col=FFFFFF>ranged</col> damage and will also <col=FFFFFF>drain the target's run energy</col>. If his target is out of energy, his attacks will <col=FFFFFF>stun</col> them instead.
param=bslay_tactic_animation,tuska_raids_beastmaster_dog_attack
param=bslay_tactic_new_npc,raid1_beastmaster_pet2

// 33587
[bslay_beastmaster_petstuz]
param=bslay_tactic_title,Tuz
param=bslay_tactic_text,If his target is out of biting distance, Tuz will blast <col=FFFFFF>magic</col> at them and anyone nearby.<br><br>The attack also inflicts a <col=FFFFFF>magical burn</col> that deals further damage regularly.<br><br>The burn can be removed with the <col=FFFFFF>Freedom</col> ability, but Tuz will quickly attempt to apply another.
param=bslay_tactic_animation,tuska_raids_beastmaster_dog_attack
param=bslay_tactic_new_npc,raid1_beastmaster_pet1

// 33588
[bslay_beastmaster_petshelp]
param=bslay_tactic_title,Helping hand
param=bslay_tactic_text,The closer his beasts are to him, the more accurate Durzag's attacks are. Keep his pets at a distance to minimise the damage you take.<br><br>Should the pets die he Durzag will inherit the on-hit ability of his pets (except Cormes).
param=bslay_tactic_animation,tuska_raids_beastmaster_command_dogs
param=bslay_tactic_new_npc,raid1_beastmaster

// 33589
[bslay_beastmaster_enough]
param=bslay_tactic_title,Enough!
param=bslay_tactic_text,Once the beastmaster has been lowered to <col=FFFFFF>50%</col> of his life points, he will become significantly enraged, increasing the strength and frequency of his attacks.<br><br>If either of his pets are still alive, Durzag will take significantly less damage until they are defeated.
param=bslay_tactic_animation,tuska_raids_beastmaster_roar
param=bslay_tactic_new_npc,raid1_beastmaster

// 33590
[bslay_beastmaster_gongs]
param=bslay_tactic_title,Gongs
param=bslay_tactic_text,Gongs are hung at the centre of each of the four walls. The loud ring of the gong will disrupt Durzag's only reliable sense: his hearing.<br><br>Ringing a gong will cost some prayer points, but the result will be effective in confusing Durzag.<br><br>If successful, the gong will completely drain the prayer points of whoever rang it, but the noise will halve the beastmaster's attack speed. The gongs are heavy and fragile, so each one can only be used to discombobulate Durzag once.

// 33591
[bslay_beastmaster_goebie]
param=bslay_tactic_title,Goebie prisoners
param=bslay_tactic_text,Goebies are cute, rocky creatures that have been held captive by the Beastmaster. Goebies will attempt to assist you in the fight, but they have been left in a weakened state from their imprisonment.<br><br>The evil beasts that held them captive will target the goebies just as much as they target you.<br><br>It is best if they are focused on you, so <col=FFFFFF>provoke</col> any charger or airut that plans to harm one of the little fellows. Remember that freeing the goebies is the goal of this raid; their safety is second to none!
param=bslay_tactic_animation,tuska_raids_goebie_death
param=bslay_tactic_new_npc,raid1_goebie_var1

// 33592
[bslay_yakamaru_water]
param=bslay_tactic_title,Water power
param=bslay_tactic_text,Yakamaru's attacks are fuelled by the power of water. As he attacks his main target, he will slowly soak them with water, increasing the power of his attacks. Any one close to his main target will also experience the effects of his drench. The only way to counter this is by using <col=FFFFFF>Freedom</col> to shake some of the water off.
param=bslay_tactic_animation,tuska_raids_waterboss_water_pump
param=bslay_tactic_new_npc,raid1_waterboss

// 33593
[bslay_yakamaru_cowardice]
param=bslay_tactic_title,Cowardice
param=bslay_tactic_text,Players who completely avoid all combat with Yakamaru will enrage him, prompting him to fling projectiles at those he considers cowards in an attempt to lure them into combat.

// 33594
[bslay_yakamaru_magic]
param=bslay_tactic_title,Magic splash
param=bslay_tactic_text,Yakamaru splashes the floor, damaging anyone within <col=FFFFFF>2 squares</col> of him with a powerful <col=FFFFFF>magic</col> attack.
param=bslay_tactic_new_npc,raid1_waterboss_magic

// 33595
[bslay_yakamaru_ranged]
param=bslay_tactic_title,Ranged Tendrils
param=bslay_tactic_text,Yakamaru summons small tendrils to pierce anyone outside of his splash distance. These tendrils will always hit his main target and those nearby, but they will not target anyone else preoccupied with another fight.
param=bslay_tactic_animation,tuska_raids_waterboss_ranged_start
param=bslay_tactic_new_npc,raid1_waterboss_ranged

// 33596
[bslay_yakamaru_soak]
param=bslay_tactic_title,Soak
param=bslay_tactic_text,Yakamaru picks a target and soaks them to the fullest extent, turning them into an entity of pure water. Whoever has this form will gradually take increased damage from it. The effect can be passed between teammates by standing together to avoid damage. After a few passes, the soaked form will dissipate completely.
param=bslay_tactic_animation,tuska_raids_waterboss_fountain
param=bslay_tactic_new_npc,raid1_waterboss

// 33597
[bslay_yakamaru_jellyspawn]
param=bslay_tactic_title,Jelly spawn
param=bslay_tactic_text,Yakamaru spits a <col=FFFFFF>jellyfish</col> out at the team. When it lands, it will create <col=FFFFFF>5 geysers</col> linked to it. Each geyser can be stood on to remove <col=FFFFFF>20%</col> of the jellyfish's life points, but they will also deal <col=FFFFFF>magic</col> damage to anyone on top when they erupt.
param=bslay_tactic_animation,tuska_raids_jellyfish_walk
param=bslay_tactic_new_npc,raid1_waterboss_jellyfish_geyser

// 33598
[bslay_yakamaru_jellyfish]
param=bslay_tactic_title,Jellyfish
param=bslay_tactic_text,Jellyfish are powerful creatures that choose a target and barrage them with attacks. Their attack deals melee damage to anyone in a <col=FFFFFF>3x3</col> area of their main target.
param=bslay_tactic_new_npc,raid1_waterboss_jellyfish_geyser
param=bslay_tactic_animation,tuska_raids_jellyfish_attack

// 33599
[bslay_yakamaru_centralpool]
param=bslay_tactic_title,Central pool
param=bslay_tactic_text,The fight will begin in the central pool. In this pool, Yakamaru can use his <col=FFFFFF>Soak</col> and <col=FFFFFF>Jelly spawn</col> special attacks.
param=bslay_tactic_new_npc,raid1_waterboss
param=bslay_tactic_animation,tuska_raids_waterboss_drag_player_underwater

// 33600
[bslay_yakamaru_outerpool]
param=bslay_tactic_title,Outer pool
param=bslay_tactic_text,As the fight progresses, Yakamaru will swap pools, giving him new techniques in combat. Yakamaru will choose the first outside pool at <col=FFFFFF>random</col> and will continue from there <col=FFFFFF>clockwise</col> as the fight goes on.
param=bslay_tactic_new_npc,raid1_waterboss
param=bslay_tactic_animation,tuska_raids_waterboss_drag_player_underwater

// 33601
[bslay_yakamaru_southernpool]
param=bslay_tactic_title,Southern pool
param=bslay_tactic_text,In the southernmost pool, Yakamaru has access to much more powerful tendrils. In this pool, he can use his <col=FFFFFF>Soak, Jelly spawn,</col> and <col=FFFFFF>Tendril assault</col> special attacks.
param=bslay_tactic_new_npc,raid1_waterboss
param=bslay_tactic_animation,tuska_raids_waterboss_drag_player_underwater

// 33602
[bslay_yakamaru_tendril]
param=bslay_tactic_title,Tendril assault
param=bslay_tactic_text,Yakamaru assaults the team with two different tendril attacks simultaneously — <col=FFFFFF>Strangling tendrils</col> and <col=FFFFFF>Whipping tendrils.</col>
param=bslay_tactic_new_npc,raid1_waterboss

// 33603
[bslay_yakamaru_strangtendril]
param=bslay_tactic_title,Strangling tendrils
param=bslay_tactic_text,Strangling tendrils target the players whom Yakamaru considers the most dangerous. These tendrils latch onto the <col=FFFFFF>top five damage dealers</col>, preventing movement and resetting all defensive abilities. They asphyxiate their target, dealing gradually increased damage. The only way to escape is to fight back; you must deal enough damage back at Yakamaru for the choking to stop.
param=bslay_tactic_new_npc,raid1_waterboss
param=bslay_tactic_animation,tuska_raids_waterboss_strangle_player

// 33604
[bslay_yakamaru_whiptendril]
param=bslay_tactic_title,Whipping tendrils
param=bslay_tactic_text,Yakamaru goes full assault against his current target, summoning a large tendril growth that whips around wildly. Anyone caught inside this growth will take massive damage rapidly, unless they are being asphyxiated by the <col=FFFFFF>strangling tendrils</col>.
param=bslay_tactic_animation,tuska_raids_waterboss_tentacle_spike
param=bslay_tactic_new_npc,raid1_waterboss

// 33605
[bslay_yakamaru_southwestpool]
param=bslay_tactic_title,South-west pool
param=bslay_tactic_text,In the south-west pool, Yakamaru calls on creatures of the sea to assist in the fight. In this pool, he can use his <col=FFFFFF>Soak, Jelly spawn,</col> and <col=FFFFFF>Sharknado</col> special attacks.
param=bslay_tactic_new_npc,raid1_waterboss
param=bslay_tactic_animation,tuska_raids_waterboss_drag_player_underwater

// 33606
[bslay_yakamaru_cyclone]
param=bslay_tactic_title,Sharknado
param=bslay_tactic_text,Yakamaru begins whirling a cyclone, pulling up dangerous <col=FFFFFF>explosive fish</col>. While the cyclone is still charging, the sharks can be fished out, removing one explosive charge from the attack.<br><br>Any charges remaining will be launched at the team. Yakamaru will attempt to home one fish to each combatant, randomly scattering any spares. When the fish land, they will explode after a few seconds. <col=FFFFFF>Fish</col> them away or just run to avoid taking heavy damage.
param=bslay_tactic_animation,tuska_raids_waterboss_attack_fish_fire
param=bslay_tactic_new_npc,raid1_waterboss

// 33607
[bslay_yakamaru_northwestpool]
param=bslay_tactic_title,North-west pool
param=bslay_tactic_text,In the north-west pool, Yakamaru will make use of his environment to attack his targets. In this pool, he can use his <col=FFFFFF>Soak, Jelly spawn,</col> and <col=FFFFFF>Quicksand</col> special attacks.
param=bslay_tactic_new_npc,raid1_waterboss
param=bslay_tactic_animation,tuska_raids_waterboss_drag_player_underwater

// 33608
[bslay_yakamaru_quicksand]
param=bslay_tactic_title,Quicksand
param=bslay_tactic_text,Yakamaru dampens the ground, leaving <col=FFFFFF>two</col> targets standing. Everyone else will be trapped in quicksand, and slowly sink to the bottom. Anyone with mobility will need to <col=FFFFFF>free</col> their teammates. Anyone who sinks below the ground will suffer <col=FFFFFF>instant death</col>.
param=bslay_tactic_new_npc,raid1_waterboss

// 33609
[bslay_yakamaru_northpool]
param=bslay_tactic_title,Northern pool
param=bslay_tactic_text,In the northernmost pool Yakamaru can use his <col=FFFFFF>Soak</col> and <col=FFFFFF>Jelly spawn</col> special attacks.<br><br>The longer Yakamaru sits in this pool, the harder his body becomes. In his weakest state, Yakamaru will take increased damage, but as his body hardens, he will take less and less damage. To reset his defences, he must be <col=FFFFFF>stunned</col> with an ability. When stunned, Yakamaru will immediately retaliate, damaging every target; the weaker Yakamaru is when he is stunned, the more damage he will deal when he retaliates.
param=bslay_tactic_new_npc,raid1_waterboss
param=bslay_tactic_animation,tuska_raids_waterboss_drag_player_underwater

// 33610
[bslay_yakamaru_poison]
param=bslay_tactic_title,Poison
param=bslay_tactic_text,Near the end of each pool, Yakamaru will purge a poison from his body. To properly defeat the pool, someone will need to <col=FFFFFF>absorb the poison</col> and bring it to Yakamaru. If a poisoned player is within <col=FFFFFF>splash distance</col>, Yakamaru will be enticed by the scent of the poison and swallow the player whole when defeated.<br><br>When the poison transfers to Yakamaru, he will return to the central pool, regurgitating the player he swallowed. The regurgitated player will <col=FFFFFF>drown and wash ashore</col>, along with <col=FFFFFF>5 planks</col> that will be needed for later. When Yakamaru returns to the central pool, he will also spawn a <col=FFFFFF>Jelly group</col> to come to his aid.
param=bslay_tactic_new_npc,raid1_waterboss

// 33611
[bslay_yakamaru_revive]
param=bslay_tactic_title,Resuscitation
param=bslay_tactic_text,The player who was swallowed and regurgitated by Yakamaru will wash ashore incapacitated. One of their teammates will need to perform CPR before the drowning victim loses breath. If not saved, drowning will cause <col=FFFFFF>instant death.</col>
param=bslay_tactic_new_npc,raid1_waterboss

// 33612
[bslay_yakamaru_poisonskin]
param=bslay_tactic_title,Poisoned
param=bslay_tactic_text,When Yakamaru is still inflicted with the poison he absorbed, he will take increased damage from all attacks.
param=bslay_tactic_new_npc,raid1_waterboss_sick
param=bslay_tactic_animation,tuska_raids_waterboss_weakened_idle

// 33613
[bslay_yakamaru_jellygroup]
param=bslay_tactic_title,Jelly group
param=bslay_tactic_text,As Yakamaru returns to the central pool, <col=FFFFFF>four jellyfish</col> will spawn and begin moving towards Yakamaru. There is one jellyfish for each side of the combat triangle - <col=FFFFFF>meleefish, magical jellyfish, piercing jellyfish</col> - and one support jellyfish. If any of these jellyfish reach Yakamaru, they will absorb the poison from his body, curing him. If either of the support jellyfish dies, their death will cure Yakamaru.
param=bslay_tactic_animation,tuska_raids_jellyfish_walk
param=bslay_tactic_new_npc,raid1_waterboss_jellyfish_geyser

// 33614
[bslay_yakamaru_durablejelly]
param=bslay_tactic_title,Durable jellyfish
param=bslay_tactic_text,Durable jellyfish can attack with magic, but their main focus will be <col=FFFFFF>healing</col> Yakamaru and other jelly fish.
param=bslay_tactic_animation,tuska_raids_jellyfish_walk
param=bslay_tactic_new_npc,raid1_waterboss_jellyfish_healer

// 33615
[bslay_yakamaru_reflectjelly]
param=bslay_tactic_title,Reflecting jellyfish
param=bslay_tactic_text,While the reflecting jellyfish is alive, the three jellyfish in its group will take decreased damage, with <col=FFFFFF>1/4</col> of that damage being dealt back to players. Reflecting jellyfish are also immune to regular attacks. Each jellyfish under the reflecting jellyfish's protection will damage the reflecting jellyfish for <col=FFFFFF>1/3</col> of its maximum life points when it dies.
param=bslay_tactic_animation,tuska_raids_jellyfish_walk
param=bslay_tactic_new_npc,raid1_waterboss_jellyfish_reflect

// 33616
[bslay_yakamaru_mirage]
param=bslay_tactic_title,Mirage phase
param=bslay_tactic_text,Once Yakamaru has been defeated in every pool, he will hide away and create four images of himself, one in each outer pool. These images do not have as many life points as the real Yakamaru, but they are just as powerful offensively. All four images will need to be fought at once; any image that is not in combat will <col=FFFFFF>fling projectiles</col> at the team for increasingly heavy damage.
param=bslay_tactic_new_npc,raid1_waterboss_mirage
param=bslay_tactic_animation,tuska_raids_waterboss_weakened_idle

// 33617
[bslay_yakamaru_blocking]
param=bslay_tactic_title,Blocking
param=bslay_tactic_text,Unlike the real Yakamaru, mirage images will not return to the central pool when defeated. Instead, they will leap into the air to regenerate their life points. While this is happening, the team will have <col=FFFFFF>5 seconds</col> to block the pool. If not blocked, the image will respawn with full life points and continue attacking. The <col=FFFFFF>southernmost</col> and <col=FFFFFF>north-west</col> pools require <col=FFFFFF>10 piles of sand</col> from the area to be blocked. The <col=FFFFFF>south-west</col> and <col=FFFFFF>northernmost</col> pools require <col=FFFFFF>10 reclaimed planks</col> to be blocked.
param=bslay_tactic_new_npc,raid1_waterboss_mirage

// 33618
[bslay_yakamaru_laststand]
param=bslay_tactic_title,Last stand
param=bslay_tactic_text,After the final image has been defeated, Yakamaru will emerge from the central pool one final time. Once the last bits of his health are taken away, Yakamaru will collapse, defeated.
param=bslay_tactic_new_npc,raid1_waterboss_mirage

