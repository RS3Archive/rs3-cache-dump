param=trh_promo_end,5255
param=trh_promo_first_run,5251
param=trh_promo_clearup,5264
param=trh_event_name,Boat to the Arc
param=trh_event_desc,It's time to start on the journey to the Arc. Help Umi to create a boat for the voyage as well as prepare resources for the trip. Each day you will receive 100 basic tools and by using your skills you can help to unlock the skilling backpack. Golden tools can be won from Treasure Hunter to advance your progress further or buy basic tools from Umi for Loyalty Points.<br><br>Working together as a community you can unlock mystery boxes and increase the overall XP boost of the skilling backpack, as well as add additional charges.
param=trh_promo_banner_de,rs3_thbanner_th_boattoarc_de
param=trh_promo_banner_en,rs3_thbanner_th_boattoarc_en
param=trh_promo_banner_fr,rs3_thbanner_th_boattoarc_fr
param=trh_promo_banner_pt,rs3_thbanner_th_boattoarc_pt

