[skillguide_construction_player_fort_grove_tier1]
param=skillguide_item,player_fort_grove_tier1
param=skillguide_name,Fort Forinthry: Woodcutters' Grove (Tier 1)
param=skillguide_info,- Access to normal trees and oak trees in the Woodcutters' Grove.<br>- Ability to store log spirits in the wood box.<br>- Log piles in the Woodcutters' Grove can be used to deposit logs directly to the bank.<br>- Bird's nests found whilst woodcutting are automatically stored in the backpack.
param=skillguide_level,50
param=skillguide_skill,22
param=skillguide_filter,14
param=skillguide_members,true

// 47951
[skillguide_construction_player_fort_grove_tier2]
param=skillguide_item,player_fort_grove_tier2
param=skillguide_name,Fort Forinthry: Woodcutters' Grove (Tier 2)
param=skillguide_info,- Access to willow trees, yew trees and choking ivy in the Woodcutters' Grove.<br>- Access to a fairy ring in the Woodcutters' Grove.<br>- Access to a Farming tree patch in the Woodcutters' Grove.<br>- Bird's nests can be stored in the wood box.<br>- Bird's nests found whilst woodcutting are automatically stored in the woodbox.
param=skillguide_level,50
param=skillguide_skill,22
param=skillguide_filter,14
param=skillguide_members,true

// 47952
[skillguide_construction_player_fort_grove_tier3]
param=skillguide_item,player_fort_grove_tier3
param=skillguide_name,Fort Forinthry: Woodcutters' Grove (Tier 3)
param=skillguide_info,- Access to an elder tree in the Woodcutters' Grove.<br>- Bird's nests obtained from woodcutting after completing this upgrade have improved rewards.<br>- Ability to obtain Imcando Hatchet pieces from bird's nests.<br>- Thurgo can create an Imcando Hatchet with all four Imcando Hatchet pieces and additional materials.
param=skillguide_level,60
param=skillguide_skill,22
param=skillguide_filter,14
param=skillguide_members,true

