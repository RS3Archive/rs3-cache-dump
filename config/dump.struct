// 45586
[bslay_egwd_wen_boss_intro]
param=bslay_tactic_title,Arch-Glacor
param=bslay_tactic_text,A large, icy monster from the barren planet, Leng. Wen has summoned this titan terror to attack Senntisten from the south in hopes of reclaiming her kin, the elder eggs.

// 45587
[bslay_egwd_wen_boss_creeping_ice]
param=bslay_tactic_title,Creeping Ice
param=bslay_tactic_text,Shards of ice will slowly creep in from either side of the aqueduct, decreasing the size of the arena the further they creep. If they reach the players position, they will cause large amounts of damage and push the player in the direction they're creeping in.

// 45588
[bslay_egwd_wen_boss_minions]
param=bslay_tactic_title,Glacor Minions
param=bslay_tactic_text,A set of Glacyte will spawn on the aqueduct. Whilst unkilled, the Glacyte will shield the Arch-Glacor who will be immune to all damage.
param=bslay_tactic_animation,egwd_wen_boss_glacor_spawn_minions
param=bslay_tactic_spotanim,egwd_wen_boss_glacor_spawn_minions_spotanim

// 45589
[bslay_egwd_wen_boss_flurry]
param=bslay_tactic_title,Flurry
param=bslay_tactic_text,The Arch-Glacor will send out a series of attacks that will strike the player with either <col=FFFFFF>melee, magic or ranged</col> damage. Each attack's damage will be reduced by the player using the correct protection prayer.
param=bslay_tactic_animation,egwd_wen_boss_glacor_attack_magic_left
param=bslay_tactic_spotanim,egwd_wen_boss_glacor_attack_magic_left_spotanim

// 45590
[bslay_egwd_wen_boss_pillars]
param=bslay_tactic_title,Pillars of Ice
param=bslay_tactic_text,The player will be pushed to a small section of the arena by <col=FFFFFF>Creeping ice</col>. Once within this reduced area, an elemental beam will fire down from the sky and move constantly towards the players current location. After a period of time, the beam will split into two. Upon contact with the beam the player will take rapid damage. 
param=bslay_tactic_animation,egwd_wen_boss_glacor_attack_beam

// 45591
[bslay_egwd_wen_boss_cannon]
param=bslay_tactic_title,Frost Cannon
param=bslay_tactic_text,The player will be pushed to a small section of the arena by <col=FFFFFF>Creeping ice</col>. The Arch-Glacor morphs into a giant frost cannon that targets the player and hit them for a massive amount of damage.
param=bslay_tactic_animation,egwd_wen_boss_glacor_attack_empowered
param=bslay_tactic_spotanim,egwd_wen_boss_glacor_attack_empowered_spotanim

// 45592
[bslay_egwd_wen_boss_core]
param=bslay_tactic_title,Exposed core
param=bslay_tactic_text,The player will be pushed to a small section of the arena by <col=FFFFFF>Creeping ice</col>. The Arch-Glacor will smash it's arms down either side of the players current position and unleash it's <col=FFFFFF>core</col>. This core will do rapid increasing damage to the player. Whilst the <col=FFFFFF>core</col> is active, the player must attack and break the arm in order to escape the damage from the <col=FFFFFF>core</col>.

// 45593
[struct_45593]

