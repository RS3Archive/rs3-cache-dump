// 28886
[bslay_dungeon_ulthven3_onslaught]
param=bslay_tactic_title,Shadow Onslaught
param=bslay_tactic_text,The Ambassador will target a random player and open the portal in his chest towards them. This unleashes a barrage of extremely deadly <col=FFFFFF>magic</col> attacks at his target.
param=bslay_tactic_animation,dungeon_ulthven_ambassador_portal_open
param=bslay_tactic_spotanim,dungeon_ulthven_ambassador_portal_open_spotanim
param=bslay_tactic_spotanim_model,dungeon_ulthven_ambassador_portal_spotanim

// 28887
[bslay_dino_boss_shadow]
param=bslay_tactic_title,Shadow Anima
param=bslay_tactic_text,During the encounter, Raksha will become further empowered by Shadow Anima and this will alter the strength and execution of his attacks.

// 28888
[bslay_dino_boss_sweep]
param=bslay_tactic_title,Tail Sweep
param=bslay_tactic_text,If the player is within melee range, Raksha will perform a dangerous tail swipe. Being struck by this attack will disable protection prayers and stun the player.
param=bslay_tactic_animation,dino_boss_attack_special_tail_whip
param=bslay_tactic_spotanim,dino_boss_attack_special_tail_whip_spotanim
param=bslay_tactic_spotanim_model,dino_boss_attack_special_tail_whip_spotanim

// 28889
[bslay_dino_boss_charge]
param=bslay_tactic_title,Trampling Charge
param=bslay_tactic_text,If the player is stood at a distance, Raksha will charge menacingly at the them. Being struck by this attack will disable protection prayers and stun the player.
param=bslay_tactic_animation,dino_boss_attack_special_charge_end

// 28890
[bslay_dino_boss_bomb]
param=bslay_tactic_title,Shadow Bomb
param=bslay_tactic_text,Raksha launches a singular orb of shadow at a target. If hit by this orb, the player will take large <col=FFFFFF>magic</col> damage and become <col=FFFFFF>stunned</col>.
param=bslay_tactic_animation,dino_boss_attack_special_shadow_bombard_quick
param=bslay_tactic_spotanim,dino_boss_attack_special_shadow_bombard_quick_spotanim
param=bslay_tactic_spotanim_model,dino_boss_attack_magic_spotanim

// 28891
[bslay_dino_boss_bombard]
param=bslay_tactic_title,Shadow Bombardment
param=bslay_tactic_text,Raksha launches a bombardment of Shadow Bombs, the number of which is based upon his current shadow anima levels.
param=bslay_tactic_animation,dino_boss_attack_special_shadow_bombard_start
param=bslay_tactic_spotanim,dino_boss_attack_special_shadow_bombard_spotanim
param=bslay_tactic_spotanim_model,dino_boss_attack_magic_spotanim

// 28892
[bslay_dino_boss_anchor]
param=bslay_tactic_title,Shadow Anchor
param=bslay_tactic_text,Raksha roots you in shadow, draining your stats. This attack can spawn a physical manifestation of fear.

