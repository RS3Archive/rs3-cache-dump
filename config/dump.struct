// 0
[struct_0]
param=param_130,"rs3_icon_worldmap_locators,6"
param=param_131,"rs3_icon_worldmap_locators_glow,2"
param=param_134,"rs3_icon_worldmap_locators,7"
param=param_135,"rs3_icon_worldmap_locators,8"

// 1
[struct_1]
param=param_463,skeletons
param=param_460,11
param=param_462,Skeletons are undead, so Magic is your best bet against them. Skeletons can be found in Edgeville Dungeon or Varrock sewers.
param=param_465,15
param=param_466,0
param=param_659,npc_90

// 2
[struct_2]
param=param_463,wolves
param=param_460,9
param=param_462,Wolves are pack animals, so you'll always find them in groups. Watch out for their bite, it can be nasty. There are plenty to kill on White Wolf Mountain.
param=param_465,8
param=param_466,0
param=param_659,npc_95

// 3
[struct_3]
param=param_463,kalphites
param=param_460,53
param=param_462,Kalphite are large insects that live in hives under the desert sands. You can best enter their hive south-west of Shantay Pass, but try not to go too deep.
param=param_465,20
param=param_466,0
param=param_659,npc_1153

// 4
[struct_4]
param=param_463,mogres
param=param_460,67
param=param_462,Mogres are a type of aquatic ogre that is often mistaken for a giant mudskipper. You have to force them out of the water with a fishing explosive. You can find them on the peninsula to the south of Port Sarim.
param=param_465,35
param=param_466,32
param=param_659,npc_114

// 5
[struct_5]
param=param_463,ghosts
param=param_460,12
param=param_462,Ghosts play tricks and japes upon those entering Taverley Dungeon, so put them to rest. If you are after a bigger challenge you can find some stronger ghosts in the Stronghold of Security.
param=param_465,25
param=param_466,0
param=param_659,npc_103

// 6
[struct_6]
param=param_463,bears
param=param_460,13
param=param_462,Bears are tough creatures and fierce fighters, so watch out for their powerful claws. Bears have been spotted west of Gunnarsgrunn near the mysterious ruins. I heard a rumour of a stronger type of bear down a rift to the east of Varrock.
param=param_465,20
param=param_466,0
param=param_659,npc_106

// 7
[struct_7]
param=param_463,zombies
param=param_460,10
param=param_462,Zombies are undead, so using magic against them is preferred. You should be able to find them roaming in the tunnels beneath Edgeville.
param=param_465,10
param=param_466,0
param=param_659,npc_5304

// 8
[struct_8]
param=param_463,hill giants
param=param_460,14
param=param_462,Hill giants use crude weapons or tools so prepare accordingly. There is a colony of them, deep inside the Edgeville tunnels; all good folk will approve if you clean it out.
param=param_465,40
param=param_466,0
param=param_659,npc_117

// 9
[struct_9]
param=param_463,cave slime
param=param_460,62
param=param_462,Cave slimes are the lesser cousins of jellies. Don't be fooled, though: they can still be dangerous as they're often poisonous. You'll do Lumbridge a favour if you kill the slimes in Lumbridge Swamp caves.
param=param_465,25
param=param_466,17
param=param_659,npc_1831

// 10
[struct_10]
param=param_463,hobgoblins
param=param_460,21
param=param_462,Hobgoblins are larger and stronger then their brethren. There is a peninsula, south-west of Falador, where these creatures have a hideout.
param=param_465,30
param=param_466,0
param=param_659,npc_13246

// 11
[struct_11]
param=param_463,flesh crawlers
param=param_460,77
param=param_462,Flesh crawlers are scavengers and will eat you and anyone else, given the chance. Save the weak by killing these creatures in the Stronghold of Security.
param=param_465,38
param=param_466,0
param=param_659,npc_4389

// 12
[struct_12]
param=param_463,catablepon
param=param_460,78
param=param_462,Catablepon are cow-like, magical creatures that mainly live in the Stronghold of Security. Beware their weakening glare; cutting off their head could help.
param=param_465,50
param=param_466,0
param=param_659,npc_4397

// 13
[struct_13]
param=param_463,wall beasts
param=param_460,61
param=param_462,Wall beasts are really much larger creatures, but you'll only see their arms. You'll want something sharp on your head to stop them grabbing you. The geology of the caves beneath Lumbridge Swamp favours these creatures.
param=param_465,45
param=param_466,35
param=param_659,npc_7823

// 14
[struct_14]
param=param_463,ice warriors
param=param_460,19
param=param_462,Ice warriors are a kind of ice elemental. Thurgo the dwarf recently spotted some in the caves south of Port Sarim.
param=param_465,50
param=param_466,0
param=param_659,npc_125

// 15
[struct_15]
param=param_463,grotworms
param=param_460,112
param=param_462,Grotworms have recently been spotted in a cave near Rimmington. They will bite and attack with some sort of acid spit. Be careful - they are very aggressive.
param=param_465,25
param=param_466,0
param=param_659,npc_15461

// 16
[struct_16]
param=param_463,frogs
param=param_460,162
param=param_462,Frogs will attack and move faster than the average human. You can find frogs in the Lumbridge swamp and if you venture into the swamp caves you can find giant frogs.
param=param_466,0
param=param_659,npc_1828

// 17
[struct_17]
param=param_463,minotaurs
param=param_460,76
param=param_462,Minotaurs are large, man-like creatures, but you'll want to be careful of their horns. I hear they have set up camp under in the Stronghold of Security.
param=param_466,0
param=param_659,npc_4404

// 18
[struct_18]
param=param_463,spiders
param=param_460,4
param=param_462,Spiders are often venomous and many varieties are camouflaged, too. I've seen plenty to the south-west of Lumbridge. If you are up for a challenge you can find stronger spiders down in the Stronghold of Security.
param=param_466,0
param=param_659,npc_59

// 19
[struct_19]
param=param_463,scorpions
param=param_460,7
param=param_462,Scorpions are almost always venomous and usually found in groups. Last I heard you can find some scorpions in the Stronghold of Security.
param=param_466,0
param=param_659,npc_107

// 20
[struct_20]
param=param_463,Cockroaches
param=param_460,178
param=param_462,Cockroaches are resilient creatures often found in dark and damp places. They have been spotted in the Stronghold of Player Safety to the south.
param=param_465,10
param=param_659,npc_7160

// 21
[struct_21]
param=param_463,bats
param=param_460,8
param=param_462,Bats are rarely found on the ground, so you'll have to fight them while they're airborne, which won't be easy with melee. They have been spotted in the Taverley dungeon.
param=param_465,40
param=param_659,npc_78

// 22
[struct_22]
param=param_463,ice giants
param=param_460,15
param=param_462,Like other giants, ice giants often wield large weapons. Try using fire spells to melt them before they can hit you. Ice giants can be found underground to the south of Port Sarim.
param=param_465,50
param=param_659,npc_111

// 23
[struct_23]
param=param_463,moss giants
param=param_460,17
param=param_462,Like other giants, moss giants often wield large weapons. Use fire spells to burn them to cinders before they can damage you. Strangely for giants, some have been seen at the end of the Varrock sewers.
param=param_465,50
param=param_659,npc_112

// 24
[struct_24]
param=param_463,icefiends
param=param_460,75
param=param_462,Icefiends are beings of ice and freezing rock. They're quick and agile, so you'll want to be careful when getting close to them. Ice Mountain is infested with these pesky creatures.
param=param_465,35
param=param_659,npc_7714

// 25
[struct_25]
param=param_6391,Key Package
param=param_6388,7412
param=param_6389,7425
param=param_6381,rs3_lobby_mtx_store_vakp_jun22
param=param_6385,rs3_lobby_mtx_store_vakp_jun22
param=param_6386,rs3_lobby_mtx_store_vakp_jun22
param=param_6387,rs3_lobby_mtx_store_vakp_jun22
param=param_6392,15
param=param_8702,false

// 26
[struct_26]
param=param_4832,Rune of Destruction
param=param_4833,Zamorak conjures a huge rune and channels power through its markings. Standing on the rune's markings will cause the target to take damage. Within the safe space, black flames will rotate around, alternating directions periodically. If the black smoke catches targets, after two hits of damage the target will be stunned.<br><br>Damage from this attack is scaled with Enrage %.
param=param_4835,seq_34903

