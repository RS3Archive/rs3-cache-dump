// 24414
[luck_tier_1_effect]
param=combatv2_ability_info,Grants tier 1 luck, which improves your chances to receive rare rewards from various activities.

// 24415
[luck_tier_2_effect]
param=combatv2_ability_info,Grants tier 2 luck, which improves your chances to receive rare rewards from various activities.

// 24416
[luck_tier_3_effect]
