[pop_voyage_story_whaler_1]
param=pop_voyage_id,32766
param=pop_voyage_name,Meet the Whaler
param=pop_voyage_type,6
param=pop_voyage_text,A sequence of fireworks has been spotted out to sea. Gather a crew to find out who (or what) set them off.
param=pop_voyage_success_text,The fireworks were a distress call from a whaler named Hubbub. He was castaway on the shell of a giant turtle.
