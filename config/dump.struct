// 36647
[cheevo_atar_easy_reward]
param=cheevo_name,Ardougne Set Tasks - Easy
param=cheevo_details,Given by Doctor Orbon in Ardougne Church for completing all Easy Tasks in Ardougne.
param=cheevo_icon,"shields,16"
param=cheevo_meta_list,cheevo_ardougne_easy
param=cheevo_meta_list_type,0
param=cheevo_rewards,Ardougne cloak 1 and a magic lamp worth 1,000xp in a skill of your choice.<br>The cloak confers the following benefits:<br>- Unlimited teleports to the monastery south of Ardougne.<br>- 40% of items dropped in the Tower of Life will be noted.<br>- Improved rate of success when stealing from stalls in East Ardougne's market.<br>You will be able to sell cats to citizens for double the normal number of death runes.<br>On entering a game of Castle Wars your Prayer points will be boosted by 10%. <br>- 25% chance of two chompy birds appearing when chompy hunting.
param=cheevo_is_meta,1
param=cheevo_unique_id,1309
param=cheevo_meta_id,1702
param=cheevo_runescore,5

// 36648
[cheevo_atar_medium_reward]
param=cheevo_name,Ardougne Set Tasks - Medium
param=cheevo_details,Given by the town crier in East Ardougne's market for completing all Medium Tasks in Ardougne.
param=cheevo_icon,"shields,17"
param=cheevo_meta_list,cheevo_ardougne_medium
param=cheevo_meta_list_type,0
param=cheevo_rewards,Ardougne cloak 2 and a magic lamp worth 7,500xp in a skill of your choice. Wizard Cromperty will offer you 100 noted essence per week.<br>The cloak gains the following extra benefits:<br>- Teleport to the Farming patch north of Ardougne once per day.<br>- Improved rate of success when picking pockets in Ardougne.<br>- Double length PvP immunity after pulling the Wilderness teleport lever.<br>- 60% of items dropped in the Tower of Life will be noted.<br>- Improved yield from crafting runes at Ourania Altar.<br>Talk to the town crier to toggle your ring of life teleport destination to Ardougne. <br>- 50% chance of two chompy birds appearing when chompy hunting.
param=cheevo_is_meta,1
param=cheevo_unique_id,1310
param=cheevo_meta_id,1702
param=cheevo_runescore,10

