// 1703
[task_tut3_talk_to_sir_vant_1]
param=task_name,Talk to Sir Vant
param=task_details,The knight, Sir Vant, has information for you.<br><br>To talk to him and find out more, click on him (or click on him and select 'Talk To' if you have a one-button mouse).
param=task_rewards,Completing this Task will help you escape from the cellar in which you find yourself.
param=task_icon,"task_tutorial_icons1,0"
param=task_set,63
param=task_unique_id,3500
param=task_area,60
param=task_next_id,3501
param=task_game,1
param=task_optional,1

// 1704
[task_tut3_talk_to_sir_vant_2]
param=task_name,Assist Sir Vant
param=task_details,Sir Vant needs your help - talk to him to find out more.<br><br>For more information on this Task, click on the Hints tab above.
param=task_rewards,Completing this Task will help you escape from the cellar in which you find yourself.
param=task_icon,"task_tutorial_icons1,1"
param=task_set,63
param=task_unique_id,3501
param=task_step_1,The Hints tab offers further information that will help you complete many Tasks.
param=task_step_2,Some Hints have a button next to them which you can click to point you to a useful place, thing or person.
param=task_step_3,For now, simply click on Sir Vant to find out what he needs from you.
param=task_area,60
param=task_next_id,3502
param=task_game,1
param=task_optional,1

// 1705
[task_tut3_gather_gear]
param=task_name,Gather the Squire's Gear
param=task_details,Pick up the bronze armour and weapon from the spot where Sir Vant's squire was incinerated.<br><br>For more information on this Task, click on the Hints tab above.
param=task_rewards,Completing this Task will help you escape from the cellar in which you find yourself.
param=task_icon,"task_tutorial_icons1,9"
param=task_set,63
param=task_unique_id,3502
param=task_area,60
param=task_step_1,To pick up an object, you may right-click on it where it lies and choose 'Take', or simply left-click on it.
param=task_step_2,Items you pick up go into your inventory.
param=task_next_id,3503
param=task_game,1
param=task_optional,1

// 1706
[task_tut3_equip_gear]
param=task_name,Equip Yourself
param=task_details,Wield the bronze armour and weapon you have acquired.<br><br>For more information on this Task, click on the Hints tab above.
param=task_rewards,Completing this Task will help you escape from the cellar in which you find yourself.
param=task_icon,"task_tutorial_icons1,10"
param=task_set,63
param=task_unique_id,3503
param=task_area,60
param=task_step_1,To wear an object, right-click on it in your inventory and choose 'Wear' or 'Wield'.
param=task_step_2,Most weapons and armour can be equipped by simply left-clicking on them in your inventory.
param=task_step_3,You can see what you are currently wearing, and what effect it has on your character, via the Worn Equipment tab on the side bar.
param=task_next_id,3504
param=task_game,1
param=task_optional,1

// 1707
[task_tut3_kill_goblin]
param=task_name,Kill the Goblin
param=task_details,Engage and kill the goblin currently looting Sir Vant's supplies.<br><br>For more information on this Task, click on the Hints tab above.
param=task_rewards,Completing this Task will help you escape from the cellar in which you find yourself.
param=task_icon,"task_tutorial_icons2,5"
param=task_set,63
param=task_unique_id,3504
param=task_area,60
param=task_step_1,You must have gathered and equipped all three pieces of the squire's gear to engage this goblin.
param=task_step_2,Right-click on the goblin and choose 'Attack' to begin combat. You may also left-click the enemy to attack it.
param=task_step_3,Once combat begins, you will continue to attack your opponent until one of you dies or flees.
param=task_step_4,This goblin poses little threat, but other enemies will be considerably tougher. You can get a rough estimate of an enemy's strength by looking at the level displayed next to their name when you right-click on them.
param=task_next_id,3505
param=task_game,1
param=task_optional,1

