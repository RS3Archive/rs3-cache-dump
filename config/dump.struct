param=dom_boss_npc_safe_3,dom_terror_dog_large_safe
param=dom_boss_npc_combat_3,dom_terror_dog_large_combat
param=dom_boss_npc_safe_4,dom_terror_dog_large_safe
param=dom_boss_npc_combat_4,dom_terror_dog_large_combat
param=dom_boss_npc_safe_5,dom_terror_dog_large_safe
param=dom_boss_npc_combat_5,dom_terror_dog_large_combat
param=dom_npc_spawn_npc1_x,37
param=dom_npc_spawn_npc1_z,30
param=dom_npc_spawn_npc2_x,37
param=dom_npc_spawn_npc2_z,33
param=dom_npc_spawn_npc3_x,39
param=dom_npc_spawn_npc3_z,33
param=dom_npc_spawn_npc4_x,37
param=dom_npc_spawn_npc4_z,28
param=dom_npc_spawn_npc5_x,39
param=dom_npc_spawn_npc5_z,28
param=dom_arena_type,2
param=dom_boss_victory_alternative,dom_tran_razorlor_ghost_safe
param=dom_boss_desc,Tarn ventured through Morytania in the quest for the power to control the undead but, instead, came across Treus Dayth guarding this power who proceeded to see him off. This is a man with altogether sinister intentions and is best avoided.<br><br><col=F5B241>Quest</col>: Haunted Mines<br><br><col=F5B241>Combat</col>: He'll start as a horrific mutant but in killing his first form will change to a ghost. The ghost is melee but as a mutant he will perform ranged and melee alongside summoning suits of armour to attack. How rude!
param=dom_boss_1_taunt,Rraaaa! Pain!
param=dom_boss_taunt_sound_english,tarn_razorlor_raa_pain
param=dom_boss_taunt_sound_german,tarn_razorlor_raa_pain
param=dom_boss_taunt_sound_french,tarn_razorlor_raa_pain
param=dom_boss_taunt_sound_portuguese,tarn_razorlor_raa_pain
param=dom_battle_total_lifepoints,14820
