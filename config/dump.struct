[bslay_rexkings_necro_tactics]
param=bslay_tactic_title,Osseous
param=bslay_tactic_text,Osseous is a terrifying undead dinosaur infused with the power of the underworld. Its name means 'consisting of or turned into bone'.
param=bslay_tactic_animation,rex_kings_tyrannosaur_attack_special_shadowrang
param=bslay_tactic_new_npc,rexkings_necro_boss

// 49821
[bslay_rexkings_necro_call]
param=bslay_tactic_title,Minion summon
param=bslay_tactic_text,Osseous turns around and slams its tail into the ground summoning six baby dinosaur skeletons that walk towards Osseous. If they reach Osseous, they'll <col=FFFFFF>heal her</col> for <col=FFFFFF>5-10%</col> of their current lifepoints.
param=bslay_tactic_animation,rex_kings_tyrannosaur_skeleton_attack_special
param=bslay_tactic_new_npc,rexkings_necro_boss

// 49822
[bslay_rexkings_necro_whip]
param=bslay_tactic_title,Minion launch
param=bslay_tactic_text,Osseous will quickly spin around and launch a minion towards each player in the arena and the rest to the back of the platform, sending them into an attacking frenzy of <col=FFFFFF>melee damage</col>. Players caught in Osseous' tail whip will also take damage.
param=bslay_tactic_animation,rexkings_necro_boss_attack_tail_whip
param=bslay_tactic_new_npc,rexkings_necro_boss

// 49823
[bslay_rexkings_necro_roar]
param=bslay_tactic_title,Osseous' roar
param=bslay_tactic_text,Osseous lets out a terrifying roar, which draws all players in and binds them in place. Baby dinosaur skeletons shatter into pieces dealing <col=FFFFFF>50% of their current lifepoints</col> as damage to those nearby.
param=bslay_tactic_animation,big_game_tyrannosaur_roar
param=bslay_tactic_new_npc,rexkings_necro_boss

// 49824
[bslay_rexkings_necro_fear]
param=bslay_tactic_title,Munch
param=bslay_tactic_text,Osseous lets out a terrifying roar which draws all players in and binding them in place. Players will need to deal a total of <col=FFFFFF>5000 per player</col> as damage and then move out the way to avoid Osseous' mighty jaws.
param=bslay_tactic_animation,rexkings_necro_boss_melee_attack
param=bslay_tactic_new_npc,rexkings_necro_boss

