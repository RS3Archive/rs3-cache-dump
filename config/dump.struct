// 34469
[event_cs_week_2016_thedrop_easy_q1]
param=thedrop_question,Where can players read messages sent from Jagex?
param=thedrop_answer_1,Hit 'Support' on the main site.
param=thedrop_answer_2,Visit a fan site.
param=thedrop_answer_3,In a JMods friends chat.
param=thedrop_correct_answer,1
param=thedrop_question_answers,3

// 34470
[event_cs_week_2016_thedrop_easy_q2]
param=thedrop_question,Which of the following is a clear sign that I have received a fake email claiming to be from Jagex?
param=thedrop_answer_1,It includes my display name.
param=thedrop_answer_2,It's about a ban.
param=thedrop_answer_3,It's about new content.
param=thedrop_correct_answer,2
param=thedrop_question_answers,3

// 34471
[event_cs_week_2016_thedrop_easy_q3]
param=thedrop_question,Which of these Authenticator statements are true?
param=thedrop_answer_1,It only works on a phone.
param=thedrop_answer_2,You can use it on a phone or PC.
param=thedrop_answer_3,Only available to members.
param=thedrop_correct_answer,2
param=thedrop_question_answers,3

// 34472
[event_cs_week_2016_thedrop_easy_q4]
param=thedrop_question,Should you let your friend use your account to complete a difficult quest?
param=thedrop_answer_1,Yes, he's my friend!
param=thedrop_answer_2,Only if I change my password.
param=thedrop_answer_3,No! It's risky.
param=thedrop_correct_answer,3
param=thedrop_question_answers,3

// 34473
[event_cs_week_2016_thedrop_medium_q1]
param=thedrop_question,What are Jagex Community Helpers?
param=thedrop_answer_1,Jagex staff personal accounts.
param=thedrop_answer_2,Helpful volunteer players.
param=thedrop_answer_3,Ex-player moderators.
param=thedrop_correct_answer,2
param=thedrop_question_answers,3

// 34474
[event_cs_week_2016_thedrop_medium_q2]
param=thedrop_question,How long does it typically take Customer Support to respond to customers?
param=thedrop_answer_1,Within 24 hours.
param=thedrop_answer_2,77 hours.
param=thedrop_answer_3,At least 5 working days.
param=thedrop_correct_answer,1
param=thedrop_question_answers,3

// 34475
[event_cs_week_2016_thedrop_medium_q3]
param=thedrop_question,On average, how many account recovery appeals does Customer Support process per month?
param=thedrop_answer_1,2,200.
param=thedrop_answer_2,200,000.
param=thedrop_answer_3,22,000.
param=thedrop_correct_answer,3
param=thedrop_question_answers,3

// 34476
[event_cs_week_2016_thedrop_medium_q4]
param=thedrop_question,On average, how many customers are satisfied with the service they receive?
param=thedrop_answer_1,4 out of 10.
param=thedrop_answer_2,7 out of 10.
param=thedrop_answer_3,9 out of 10.
param=thedrop_correct_answer,3
param=thedrop_question_answers,3

// 34477
[event_cs_week_2016_thedrop_hard_q1]
param=thedrop_question,On average, how many bots does our specialist team remove from the game per month?
