// 38107
[struct_38107]
param=param_6410,Just Can't Get the Staff
param=param_6411,Equip a staff while wearing magic armour, with air runes in your backpack.
param=param_6412,"staticons_high_res_clean,5"
param=param_6413,371
param=param_1282,0_45_55_8_4
param=param_1274,Get <col=0xFFCB05>air runes</col> by <col=0xFFCB05>runecrafting</col> at the <col=0xFFCB05>air altar</col>, or <col=0xFFCB05>trade with Apprentice Clara</col> in the <col=0xFFCB05>Burthorpe</col> Runecrafting shop.
param=param_1275,Get a <col=0xFFCB05>staff</col>. (Defeating Caitlin during the <col=0xFFCB05>Blood Pact quest</col> will drop her staff for you.)
param=param_1276,Get magic armour, such as a <col=0xFFCB05>wizard hat</col>, <col=0xFFCB05>wizard robes</col> or <col=0xFFCB05>spellstorm drape</col>. (You can defeat enemies (such as <col=0xFFCB05>white wolves</col> and <col=0xFFCB05>trolls</col> in <col=0xFFCB05>Burthorpe</col>, or <col=0xFFCB05>spellwisps</col> outside the <col=0xFFCB05>Wizards' Tower</col>, or purchase it from the <col=0xFFCB05>Grand Exchange</col> or <col=0xFFCB05>Thessalia's Fine Clothes</col> in <col=0xFFCB05>Varrock</col>.)
param=param_1277,Open your <col=0xFFCB05>backpack</col> by left-clicking the helmet/satchel icon on your ribbon menu.
param=param_8085,Open your <col=0xFFCB05>backpack</col> by tapping the helmet/satchel icon on your ribbon menu.
param=param_1278,Left-click any <col=0xFFCB05>magic armour</col> in your <col=0xFFCB05>backpack</col> to wear it.
param=param_8086,Tap any <col=0xFFCB05>magic armour</col> in your <col=0xFFCB05>backpack</col> to wear it.
param=param_1279,Left-click the <col=0xFFCB05>staff</col> in your <col=0xFFCB05>backpack</col> to wield it.
param=param_8087,Tap the <col=0xFFCB05>staff</col> in your <col=0xFFCB05>backpack</col> to wield it.
param=param_2225,Some staves provide an infinite supply of a rune needed to cast certain spells.<br>eg Caitlyn's staff gives you unlimited air runes, and a mindspike or staff of fire gives unlimited fire runes.
param=param_6415,1
param=param_1322,1
param=param_8169,false

// 38108
[struct_38108]
param=param_6410,Death From Above
param=param_6411,Cast Air Strike at a dummy or a hostile target.
param=param_6412,"staticons_high_res_clean,5"
param=param_6413,376
param=param_1282,0_45_55_49_35
param=param_1274,To cast <col=0xFFCB05>Air Strike</col>, you will need to wield a magic weapon and <col=0xFFCB05>air runes</col>. (You can <col=0xFFCB05>trade with Apprentice Clara</col> in the <col=0xFFCB05>Burthorpe</col> Runecrafting shop to get limited free runes, or runecraft them yourself.)
param=param_1275,Open your <col=0xFFCB05>(Combat) Magic Spellbook</col> and left-click the <col=0xFFCB05>Air Strike</col> icon to set it as your auto-cast spell.
param=param_8083,Open your <col=0xFFCB05>(Combat) Magic Spellbook</col> and tap the <col=0xFFCB05>Air Strike</col> icon to set it as your auto-cast spell.
param=param_1276,<col=0xFFCB05>Attack</col> a suitable target to cast the spell at it.
param=param_1277,You can keep using the spell as your attack as long as you have runes.
param=param_2225,Air Strike is your first attack spell; as you gain levels in Magic you can unlock more powerful variants.<br>As you increase your Magic level, you will unlock access to new spells and abilities, such as Confuse, enchanting, teleports, and alchemy.
param=param_6415,1
param=param_1322,1
param=param_8169,false

