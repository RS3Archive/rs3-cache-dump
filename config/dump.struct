param=slayer_sl_req,0
param=slayer_example_npc,brut_waterfiend

// 50883
[slayer_kuradal_list_entry_26]
param=slayer_name,volcanic creatures
param=slayer_type,102
param=slayer_description,These are the creatures that live within the TzHaar fightcaves. You'll have to venture down into the cave in the Karamja volcano to take them on.
param=slayer_sl_req,0
param=slayer_example_npc,null

// 50884
