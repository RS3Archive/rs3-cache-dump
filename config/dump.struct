// 24119
[task_sinkholes]
param=task_name,Sinkholes
param=task_details,Fight through random dungeons with a party of adventurers to seek out hidden treasure.
param=task_rewards,Gives <col=ffffff>XP</col>, <col=ffffff>Dungeoneering tokens</col> and cosmetic armour.
param=task_step_1,For more information, and to be teleported to the currently active sinkhole, speak to <col=ffffff>Talsar</col> in <col=ffffff>Daemonheim</col>.
param=task_step_2,You must form a party of <col=ffffff>2 to 5</col> adventurers to enter these dungeons and raid their wealth.
param=task_step_3,You can enter a sinkhole <col=ffffff>twice per day</col>.
param=task_step_1_arrow,0_99_99_2_9
param=task_step_2_arrow,0_99_99_2_9
param=task_step_3_arrow,0_99_99_2_9
param=task_auto_arrow,1
param=task_icon,"task_icons_48_60,7"
param=task_set,63
param=task_unique_id,3055
param=task_area,0
param=task_requirement_1_type,62
param=task_next_id,3004
param=task_optional,1
param=dndtracker_full_description,Sinkholes filled with treasure are appearing all over Gielinor. Battle through them with a party of adventurers, then compete against these adventurers in a card game to claim the best treasure.
param=dndtracker_is_dnd,1
param=dndtracker_priority,3
param=dndtracker_is_members,1
param=challenge_theme_world,134
param=challenge_nearest_lodestone,0_44_53_62_51

// 24120
[task_treasure_trails]
param=task_name,Treasure Trails
param=task_details,Follow clues to find buried treasure.
param=task_rewards,Varies depending on the tier of clue scroll, but includes <col=ffffff>armour</col>, <col=ffffff>equipment</col> and <col=ffffff>potions</col>.
param=task_step_1,When certain creatures die, there is a chance that they will drop a <col=ffffff>sealed clue scroll</col>. 
param=task_step_2,You can own up to 25 clue scrolls of each tier at any one time.
param=task_icon,"task_icons_48_60,7"
param=task_set,63
param=task_unique_id,3052
param=task_area,0
param=task_requirement_1_type,62
param=task_next_id,3053
param=task_optional,1
param=dndtracker_is_dnd,1
param=dndtracker_full_description,Sealed clue scrolls are dropped by various creatures in the world. These clues will lead you to hidden treasure if you can work out their meaning.
param=dndtracker_priority,1

// 24121
[task_troll_invasion]
param=task_name,Troll Invasion
param=task_details,Help defend Burthorpe from the Troll Invasion by fighting or repairing the gatehouse.
param=task_rewards,Gives combat or non-combat skill <col=ffffff>experience</col> depending on the type of defence performed.
param=task_step_1,To play, travel to <col=ffffff>Burthorpe</col> and speak with <col=ffffff>Captain Jute</col> outside the castle's west wall.
param=task_step_5,You can practice this activity as often as you like, but can only claim the reward <col=ffffff>once per month</col>.
param=task_step_1_arrow,0_44_55_58_45
param=task_step_2_arrow,0_44_55_58_45
param=task_step_3_arrow,0_44_55_58_45
param=task_step_4_arrow,0_44_55_58_45
param=task_step_5_arrow,0_44_55_58_45
param=task_auto_arrow,1
param=task_icon,"task_icons_48_60,7"
param=task_set,63
param=task_unique_id,3053
param=task_area,0
param=task_requirement_1_type,62
param=task_next_id,3054
param=task_optional,1
param=dndtracker_is_dnd,1
param=dndtracker_full_description,Help defend Burthorpe from the Troll Invasion! In this timed game, you can fend off the trolls in direct combat - fighting waves of trolls - or man the gatehouse, keeping it in top condition using non-combat skills.
param=dndtracker_priority,7
param=challenge_nearest_lodestone,0_45_55_19_25

// 24122
[task_wilderness_warbands]
param=task_name,Wilderness Warbands
param=task_details,Raid heavily guarded camps in the Wilderness to thin their forces and plunder supplies.
param=task_rewards,<col=ffffff>Coins</col>, XP in <col=ffffff>Construction</col>, <col=ffffff>Farming</col>, <col=ffffff>Herblore</col>, <col=ffffff>Mining</col> and <col=ffffff>Smithing</col> and the chance to find a <col=ffffff>level 70 wand of treachery</col>.
param=task_step_1,Camps of dedicated followers to the four main gods occasionally appear in the <col=ffffff>Wilderness</col>.
param=task_step_2,You can speak to <col=ffffff>Quercus</col> in <col=ffffff>Edgeville</col> for more information on where the current camp is.
param=task_step_3,You can take part in <col=ffffff>3</col> raids per day.
param=task_step_1_arrow,0_49_54_0_63
param=task_step_2_arrow,0_49_54_0_63
param=task_step_3_arrow,0_49_54_0_63
param=task_auto_arrow,1
param=task_icon,"task_icons_48_60,7"
param=task_set,63
param=task_unique_id,3054
param=task_area,0
param=task_requirement_1_type,62
param=task_next_id,3063
param=task_optional,1
param=dndtracker_full_description,Heavily guarded camps are appearing in the Wilderness. Find these camps with Quercus's help and raid their supplies. Sneak through, avoiding the guards and other players to destroy their central command beam.
param=dndtracker_is_dnd,1
param=dndtracker_priority,5
param=challenge_nearest_lodestone,0_47_54_59_50

// 24123
[task_crucible]
param=task_name,Deathmatch
param=task_details,Fight fellow adventurers in battles to the death in huge underground caverns.
param=task_rewards,Deathmatch reward points which can be traded for <col=ffffff>taunts</col>, <col=ffffff>titles</col> and <col=ffffff>untradeable PvP supplies</col>
param=task_step_1,The entrance to <col=ffffff>Deathmatch</col> is within <col=ffffff>Edgeville</col>.
param=task_step_2,This is a <col=ffffff>safe area</col>. If you die in this location, you will <col=ffffff>not</col> lose your items.
param=task_step_3,You may play deathmatch <col=ffffff>as often as you wish</col>.
