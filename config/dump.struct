// 38089
[cheevo_path_obtain_flour]
param=cheevo_name,Flour Power
param=cheevo_details,Obtain a pot of flour.
param=cheevo_icon,"staticons_high_res_clean,15"
param=cheevo_unique_id,377
param=task_step_1,Pick <col=0xF0BE79>wheat</col> from a field, such as the <col=0xF0BE79>wheat field south of the Taverley mill</col>.
param=task_step_1_arrow,0_49_51_30_41
param=task_step_2,Climb the <col=0xF0BE79>stairs</col> to the upper flour of the mill, and put the <col=0xF0BE79>wheat</col> in the <col=0xF0BE79>hopper</col>.
param=task_step_3,<col=0xF0BE79>Operate</col> the <col=0xF0BE79>hopper controls</col> next to the hopper to grind the wheat. It'll drop into the flour bin on the ground floor.
param=task_step_4,Take an <col=0xF0BE79>empty pot</col> from the table on the ground floor of the mill, and fill the pot from the <col=0xF0BE79>flour bin</col>.
param=task_information,Flour is the basis of bread, pies, cakes and pizzas, all of which can be made with the Cooking skill.
param=cheevo_game,1
param=task_optional,1
param=cheevo_popup,false

