// 29806
[dom_boss_lol]
param=dom_boss_name,Lol
param=dom_boss_id,59
param=dom_boss_npc_safe_1,dom_troll_champion_safe
param=dom_boss_npc_combat_1,dom_troll_champion_combat
param=dom_npc_spawn_npc1_x,37
param=dom_npc_spawn_npc1_z,31
param=dom_arena_type,2
param=dom_boss_desc,Lol is the brother to Morningstar, the troll that tried to crush Burthorpe. He is back for vengeance, having been beaten in his quest to win the Bandosian Kyzaj Tournament.<br><br><col=F5B241>Quest</col>: The Mighty Fall<br><br><col=F5B241>Combat</col>: Lol attacks with the highest-tech troll weaponry available: thrown rocks! These rocks are big and heavy enough that they will remain and block your movement. Lol can also make them explode for massive damage.
param=dom_boss_1_taunt,Die, humans!
param=dom_boss_taunt_sound_english,omge_troll_die_humans
param=dom_boss_taunt_sound_german,omge_troll_die_humans
param=dom_boss_taunt_sound_french,omge_troll_die_humans
param=dom_boss_taunt_sound_portuguese,omge_troll_die_humans
param=dom_battle_total_lifepoints,50000
param=dom_boss_spline_size,0
param=dom_boss_thumbnail,domtower_icon_lol

