param=rewardshop_cost,20000
param=rewardshop_buy_option_1,1
param=rewardshop_usetooltip,1
param=rewardshop_tooltip,Reading this scroll permanently unlocks the Wasteless Herblore trait: when concocting a potion, there is a chance you will complete the potion slightly quicker, and that you will save the secondary item completely.
param=rewardshop_requirements,You need level 49 in Dungeoneering and Herblore to buy this.
param=rewardshop_is_reward_obj,1
param=rewardshop_members,1

