param=param_3044,Introduction to Combat
param=param_3045,Learn the basics of combat: attacking, lifepoints, and eating.<br><br>Demonstration:<br>Kill a lowly skeleton with your bare hands.<br><br>Hover over the rank icons to see completion requirements.
param=param_3046,#1 Legend Rank<br><br>Kill the skeleton with few or no prompts from Lady Deathknell.
param=param_3047,#2 Hero Rank<br><br>Kill the skeleton without too many prompts from Lady Deathknell.
param=param_3048,#3 Champion Rank<br><br>Kill the skeleton.
param=param_3049,storablelabel_6
param=param_6410,Combat Academy #1 - Introduction
param=param_6412,rs3_icon_path_combat
param=param_6413,4072
param=param_6411,Complete the first course at the Lumbridge Combat Academy.
param=param_1282,0_50_50_10_56
param=param_1274,Talk to <col=0xFFCB05>Lady Deathknell</col> at the <col=0xFFCB05>Lumbridge Combat Academy</col>.
param=param_6415,1
param=param_1322,1

// 15369
[struct_15369]
param=param_3044,Combat Styles
param=param_3045,Learn how to attack with melee and ranged weapons and cast spells.<br><br>Demonstration:<br>Attack a training dummy with all three styles.<br><br>Hover over the rank icons to see completion requirements.
param=param_3046,#1 Legend Rank<br><br>Attack the training dummy, choosing the correct style all of the time.
param=param_3047,#2 Hero Rank<br><br>Attack the training dummy, choosing the correct style most of the time.
param=param_3048,#3 Champion Rank<br><br>Attack the training dummy, rarely or never choosing the correct style.
param=param_3049,storablelabel_3
param=param_6410,Combat Academy #2 - Combat Styles
param=param_6412,rs3_icon_path_combat
param=param_6413,4073
param=param_6411,Complete the second course at the Lumbridge Combat Academy.
param=param_1282,0_50_50_10_56
param=param_1274,Talk to <col=0xFFCB05>Lady Deathknell</col> at the <col=0xFFCB05>Lumbridge Combat Academy</col>.
param=param_6415,1
param=param_1322,1

// 15370
[struct_15370]
param=param_3044,The Combat Triangle
param=param_3045,Learn about the relationship between combat styles.<br><br>Demonstration:<br>From a selection of three skeletons, attack the skeleton that is weakest against a given weapon.<br><br>Hover over the rank icons to see completion requirements.
param=param_3046,#1 Legend Rank<br><br>Attack the weakest skeleton first time most of the time.
param=param_3047,#2 Hero Rank<br><br>Attack the weakest skeleton most of the time.
param=param_3048,#3 Champion Rank<br><br>Attack the skeletons, rarely or never choosing the weakest skeleton.
param=param_3049,storablelabel_2
param=param_6410,Combat Academy #3 - Combat Triangle
param=param_6412,rs3_icon_path_combat
param=param_6413,4074
param=param_6411,Complete the third course at the Lumbridge Combat Academy.
param=param_1282,0_50_50_10_56
param=param_1274,Talk to <col=0xFFCB05>Lady Deathknell</col> at the <col=0xFFCB05>Lumbridge Combat Academy</col>.
param=param_6415,1
param=param_1322,1

