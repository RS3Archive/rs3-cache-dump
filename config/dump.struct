param=worldmap_upsell_content_caption_2_text,Pyramid Plunder
param=worldmap_upsell_content_text,For those venturing into the desert, discover the story of the desert gods including Icthlarin, the god of the Underworld, and Amascut, the Devourer. To the south is the golden city of Menaphos, a city of wonder and opportunity... for those who can enter.
param=worldmap_upsell_content_bp0_text,Explore Menaphos
param=worldmap_upsell_content_bp1_text,Plunder pyramids
param=worldmap_upsell_content_bp2_text,Fight the Kalphite Queen

