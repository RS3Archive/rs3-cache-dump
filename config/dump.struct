// 37582
[menaphos_collections_insect1]
param=elrc_objective_id,0
param=elrc_objective_category,0
param=elrc_objective_graphic_locked,"menaphos_journal_icon_insect_04,1"
param=elrc_objective_graphic_unlocked,"menaphos_journal_icon_insect_04,0"
param=elrc_objective_title,Menaphite honey bee in amber
param=collection_unlock_name,a Menaphite honey bee in amber
param=collection_unlock_obj,menaphos_collections_insect1
param=elrc_objective_desc,Amusingly, it looks like it's stuck in a blob of honey.
param=elrc_objective_hint,Among the rocks, old treasure can be found.

// 37583
[menaphos_collections_insect2]
param=elrc_objective_id,1
param=elrc_objective_category,0
param=elrc_objective_graphic_locked,"menaphos_journal_icon_insect_08,1"
param=elrc_objective_graphic_unlocked,"menaphos_journal_icon_insect_08,0"
param=elrc_objective_title,Pygmy giant scarab in amber
param=collection_unlock_name,a pygmy giant scarab in amber
param=collection_unlock_obj,menaphos_collections_insect2
param=elrc_objective_desc,Holding it up to the light, it looks like it is in a small shadow play.
param=elrc_objective_hint,Leave no sandstone unturned.

// 37584
[menaphos_collections_insect3]
param=elrc_objective_id,2
param=elrc_objective_category,0
param=elrc_objective_graphic_locked,"menaphos_journal_icon_insect_06,1"
param=elrc_objective_graphic_unlocked,"menaphos_journal_icon_insect_06,0"
param=elrc_objective_title,Clicker kalphite in amber
param=collection_unlock_name,a clicker kalphite in amber
param=collection_unlock_obj,menaphos_collections_insect3
param=elrc_objective_desc,Hold it close to your ear, and you can almost hear the sandstorms.
param=elrc_objective_hint,Subotai said a sample had been kept safe by a sympathetic sailor, Unfortunately, he drowned at sea.

// 37585
[menaphos_collections_insect4]
param=elrc_objective_id,3
param=elrc_objective_category,0
param=elrc_objective_graphic_locked,"menaphos_journal_icon_insect_01,1"
param=elrc_objective_graphic_unlocked,"menaphos_journal_icon_insect_01,0"
param=elrc_objective_title,Desert locust in amber
param=collection_unlock_name,a desert locust in amber
param=collection_unlock_obj,menaphos_collections_insect4
param=elrc_objective_desc,Let's see it eat its way out of there.
param=elrc_objective_hint,Lost beneath the waves.

// 37586
[menaphos_collections_insect5]
param=elrc_objective_id,4
param=elrc_objective_category,0
param=elrc_objective_graphic_locked,"menaphos_journal_icon_insect_07,1"
param=elrc_objective_graphic_unlocked,"menaphos_journal_icon_insect_07,0"
param=elrc_objective_title,Kalphite wanderer in amber
param=collection_unlock_name,a kalphite wanderer in amber
param=collection_unlock_obj,menaphos_collections_insect5
param=elrc_objective_desc,These preserved remains suggest that kalphites have existed in the desert for a very long time.
param=elrc_objective_hint,Menaphite merchants prize these preserved insects as a symbol of luck.

// 37587
[menaphos_collections_insect6]
param=elrc_objective_id,5
param=elrc_objective_category,0
param=elrc_objective_graphic_locked,"menaphos_journal_icon_insect_05,1"
param=elrc_objective_graphic_unlocked,"menaphos_journal_icon_insect_05,0"
param=elrc_objective_title,Hornless unicornfly in amber
param=collection_unlock_name,a hornless unicornfly in amber
param=collection_unlock_obj,menaphos_collections_insect6
param=elrc_objective_desc,Does this suggest that long ago hornless unicorns might have existed? Who knows.
param=elrc_objective_hint,Used as jewellery by the wealthy.

// 37588
[menaphos_collections_insect7]
param=elrc_objective_id,6
param=elrc_objective_category,0
param=elrc_objective_graphic_locked,"menaphos_journal_icon_insect_02,1"
param=elrc_objective_graphic_unlocked,"menaphos_journal_icon_insect_02,0"
param=elrc_objective_title,Fly dragon in amber
param=collection_unlock_name,a fly dragon in amber
param=collection_unlock_obj,menaphos_collections_insect7
param=elrc_objective_desc,Caught forever in an astonished pose.
param=elrc_objective_hint,The lamp seller sometimes has amber on display.

// 37589
[menaphos_collections_insect8]
param=elrc_objective_id,7
param=elrc_objective_category,0
param=elrc_objective_graphic_locked,"menaphos_journal_icon_insect_03,1"
param=elrc_objective_graphic_unlocked,"menaphos_journal_icon_insect_03,0"
param=elrc_objective_title,Fruit fly in amber
param=collection_unlock_name,a fruit fly in amber
param=collection_unlock_obj,menaphos_collections_insect8
param=elrc_objective_desc,The amber magnifies the appearance of the fly, making it look quite intimidating.
param=elrc_objective_hint,The acadia tree is known to attract fruit flies.

// 37590
[menaphos_collections_insect9]
param=elrc_objective_id,8
param=elrc_objective_category,0
param=elrc_objective_graphic_locked,"menaphos_journal_icon_insect_honey_bee,1"
param=elrc_objective_graphic_unlocked,"menaphos_journal_icon_insect_honey_bee,0"
param=elrc_objective_title,Menaphite honey bee
param=collection_unlock_name,a Menaphite honey bee
param=collection_unlock_obj,menaphos_collections_insect9
param=elrc_objective_desc,These industrious insects do much of the work pollinating the few green areas of the Kharidian Desert.
param=elrc_objective_hint,Acadia trees have sometimes been known to form amber.

// 37591
[menaphos_collections_insect10]
param=elrc_objective_id,9
param=elrc_objective_category,0
param=elrc_objective_graphic_locked,"menaphos_journal_icon_insect_pigmy_giant_scarab,1"
param=elrc_objective_graphic_unlocked,"menaphos_journal_icon_insect_pigmy_giant_scarab,0"
param=elrc_objective_title,Pygmy giant scarab
param=collection_unlock_name,a pygmy giant scarab
param=collection_unlock_obj,menaphos_collections_insect10
param=elrc_objective_desc,Or is it a giant pygmy scarab?
param=elrc_objective_hint,These scarabs seem to gather on the surface, rather than living in the tombs below Sophanem.

// 37592
[menaphos_collections_insect11]
param=elrc_objective_id,10
param=elrc_objective_category,0
param=elrc_objective_graphic_locked,"menaphos_journal_icon_insect_kalphite_clicker,1"
param=elrc_objective_graphic_unlocked,"menaphos_journal_icon_insect_kalphite_clicker,0"
param=elrc_objective_title,Clicker kalphite
param=collection_unlock_name,a clicker kalphite
param=collection_unlock_obj,menaphos_collections_insect11
param=elrc_objective_desc,This nomadic type of Kalphite taps its mandibles to communicate unexpectedly loudly.
param=elrc_objective_hint,Plover birds love eating these.

// 37593
[menaphos_collections_insect12]
param=elrc_objective_id,11
param=elrc_objective_category,0
param=elrc_objective_graphic_locked,"menaphos_journal_icon_insect_desert_locust,1"
param=elrc_objective_graphic_unlocked,"menaphos_journal_icon_insect_desert_locust,0"
param=elrc_objective_title,Desert locust
param=collection_unlock_name,a desert locust
param=collection_unlock_obj,menaphos_collections_insect12
param=elrc_objective_desc,They are rumoured to devour anything left out in the desert sun.
param=elrc_objective_hint,They are a blight on the few trees found in the desert.

// 37594
[menaphos_collections_insect13]
param=elrc_objective_id,12
param=elrc_objective_category,0
param=elrc_objective_graphic_locked,"menaphos_journal_icon_insect_kalphite_wanderer,1"
param=elrc_objective_graphic_unlocked,"menaphos_journal_icon_insect_kalphite_wanderer,0"
param=elrc_objective_title,Kalphite wanderer
param=collection_unlock_name,a kalphite wanderer
param=collection_unlock_obj,menaphos_collections_insect13
param=elrc_objective_desc,Outside of a hive structure, these types of kalphite have regressed to minute sizes.
param=elrc_objective_hint,They make their homes burrowing underneath the roots of trees.

// 37595
[menaphos_collections_insect14]
param=elrc_objective_id,13
param=elrc_objective_category,0
param=elrc_objective_graphic_locked,"menaphos_journal_icon_insect_horse_fly,1"
param=elrc_objective_graphic_unlocked,"menaphos_journal_icon_insect_horse_fly,0"
param=elrc_objective_title,Hornless unicornfly
param=collection_unlock_name,a hornless unicornfly
param=collection_unlock_obj,menaphos_collections_insect14
param=elrc_objective_desc,Unlike a regular unicornfly, this type is not attracted to rainbows.
param=elrc_objective_hint,Found fairly rarely, but sometimes they infest lone acadia trees.

// 37596
[menaphos_collections_insect15]
param=elrc_objective_id,14
param=elrc_objective_category,0
param=elrc_objective_graphic_locked,"menaphos_journal_icon_insect_fly_dragon,1"
param=elrc_objective_graphic_unlocked,"menaphos_journal_icon_insect_fly_dragon,0"
param=elrc_objective_title,Fly dragon
param=collection_unlock_name,a fly dragon
param=collection_unlock_obj,menaphos_collections_insect15
param=elrc_objective_desc,Named for its ability to expel very small flames.
param=elrc_objective_hint,Hardly anyone alive remembers that these exist.

// 37597
