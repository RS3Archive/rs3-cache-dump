param=bslay_tactic_spotanim_model,sum1_beast_devour_spot
param=bslay_tactic_new_npc,sum2_spirit_beast_corporeal

// 30622
[bslay_corp_tactics_stomp]
param=bslay_tactic_title,Stomp
param=bslay_tactic_text,Anyone caught standing up the Corporeal Beast will feel his wrath as he violently stomps on them, hitting heavy damage until they move away.
param=bslay_tactic_animation,sum2_spirit_beast_ground_stomp
param=bslay_tactic_spotanim,sum2_spirit_beast_ground_stomp_spot
param=bslay_tactic_spotanim_model,sum2_spirit_beast_ground_stomp_spot
param=bslay_tactic_new_npc,sum2_spirit_beast_corporeal

// 30623
[bslay_corp_tactics_dark_core]
param=bslay_tactic_title,Dark core
param=bslay_tactic_text,As the Corporeal Beast's life points drop, there is a greater chance he will spawn a dark core if one is not present.<br><br>A dark core will lock on to its target and fling itself towards it. Anyone caught on the dark core will take consistent damage that helps heal the Corporeal Beast.
param=bslay_tactic_animation,sum1_dark_core_update_ready
param=bslay_tactic_new_npc,sum2_dark_energy_core_corp

// 30624
[bslay_dks_tactics_rex]
param=bslay_tactic_title,Dagannoth Rex
param=bslay_tactic_text,Dagannoth Rex is the melee-based dagannoth king. He can only be hurt by <col=FFFFFF>magic</col> attacks.
param=bslay_tactic_animation,dagannoth_kings_2016_update_melee_attack
