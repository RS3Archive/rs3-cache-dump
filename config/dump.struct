// 29804
[dom_boss_echo_of_jas]
param=dom_boss_name,Echo of Jas
param=dom_boss_id,57
param=dom_boss_npc_safe_1,dom_shade_of_jas_safe
param=dom_boss_npc_combat_1,dom_shade_of_jas_combat
param=dom_npc_spawn_npc1_x,37
param=dom_npc_spawn_npc1_z,31
param=dom_arena_type,2
param=dom_boss_desc,As a manifestation of the elder god Jas, this enemy is a formidible opponent. Encountered in a twisted mindscape, she will do her best to destroy you.<br><br><col=F5B241>Quest</col>: One of a Kind<br><br><col=F5B241>Combat</col>: As a fragment of an elder god, Jas will attack with powerful magic.  She has access to magical spells and abilities like Asphixiate which will make fighting her tricky.  In addition she will summon 'false users,' who each have powerful abilities.
param=dom_boss_1_taunt,
param=dom_boss_taunt_sound_english,silence
param=dom_boss_taunt_sound_german,silence
param=dom_boss_taunt_sound_french,silence
param=dom_boss_taunt_sound_portuguese,silence
param=dom_battle_total_lifepoints,23750
param=dom_boss_spline_size,0
param=dom_boss_thumbnail,domtower_icon_echo_of_jas

// 29805
[dom_boss_grimson]
param=dom_boss_name,Chaos Grimsson and Hreidmar
param=dom_boss_id,58
param=dom_boss_npc_safe_1,dom_grimsson_chaos_safe
param=dom_boss_npc_combat_1,dom_grimsson_chaos_combat
