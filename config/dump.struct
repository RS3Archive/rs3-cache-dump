param=dom_npc_spawn_npc1_x,33
param=dom_npc_spawn_npc1_z,32
param=dom_npc_spawn_npc2_x,33
param=dom_npc_spawn_npc2_z,29
param=dom_npc_spawn_npc3_x,36
param=dom_npc_spawn_npc3_z,32
param=dom_npc_spawn_npc4_x,36
param=dom_npc_spawn_npc4_z,29
param=dom_npc_spawn_npc5_x,39
param=dom_npc_spawn_npc5_z,32
param=dom_npc_spawn_npc6_x,39
param=dom_npc_spawn_npc6_z,29
param=dom_arena_type,2
param=dom_boss_desc,Many living creatures have utilised the benefits of sticking together in groups. As the phrase goes: 'safety in numbers'. The dagannoth sentinels work together, rejuvenating each other to survive any threat, but evidently in the past grouping into pairs was not enough. Perhaps a group of six helping each other is enough to provide enough protection for the survival of the species. <br><br><col=F5B241>Combat</col>: You will be placed in a multi-way combat arena against six dagannoth sentinels. The sentinels use their mechanic of healing each other so you'll need to attack them all from time to time. They still work in pairs, each healing whichever sentinel is standing to its side.<br><br><col=F5B241>Quests required to play</col>: Blood Runs Deep.
param=dom_boss_1_taunt,Rrrr
param=dom_boss_2_taunt,
param=dom_boss_3_taunt,
param=dom_boss_4_taunt,
param=dom_boss_5_taunt,Grrr
param=dom_boss_6_taunt,
param=dom_boss_taunt_sound_english,golems_taunt
param=dom_boss_taunt_sound_german,golems_taunt
param=dom_boss_taunt_sound_french,golems_taunt
param=dom_boss_taunt_sound_portuguese,golems_taunt
param=dom_battle_total_lifepoints,72000
param=dom_boss_spline_size,1

// 2807
[dom_boss_special_nomad]
param=dom_boss_name,Special: No More Nomad... No More!
param=dom_boss_npc_safe_1,dom_nomad_safe
param=dom_boss_npc_combat_1,dom_nomad_combat
param=dom_npc_spawn_npc1_x,37
param=dom_npc_spawn_npc1_z,31
param=dom_arena_type,4
param=dom_boss_desc,For most warriors, fighting Nomad was difficult enough once, so this is one of the most difficult (one-off) battles. It's a real test of skill to beat him twice in a row without a chance to recuperate.<br><br><col=F5B241>Combat</col>: You will be pitched against Nomad twice in a row without the option of replenishing your inventory for food or for taking a breather. The rules will be the same as in a normal battle with no handicaps.<br><br><col=F5B241>Quests required to play</col>: Nomad's Requiem.
param=dom_boss_1_taunt,You don't stand a chance!
param=dom_boss_taunt_sound_english,nomad_dont_stand_a_chance
param=dom_boss_taunt_sound_german,nomad_dont_stand_a_chance
param=dom_boss_taunt_sound_french,nomad_dont_stand_a_chance
param=dom_boss_taunt_sound_portuguese,nomad_dont_stand_a_chance
param=dom_battle_total_lifepoints,180000
param=dom_boss_spline_size,0

