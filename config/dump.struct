param=bslay_tactic_new_npc,barrows2_torag
param=bslay_tactic_animation,barrows2_brother_wall_run

// 30603
[bslay_rots_tactics_torag_whack]
param=bslay_tactic_title,Torag: Whack
param=bslay_tactic_text,Torag will jump into air and smash his opponent from above, pushing them right through the ground! While stuck in the ground, Torag will constantly hit them - until someone else has hurt Torag enough that he stops!<br>
param=bslay_tactic_new_npc,barrows2_torag
param=bslay_tactic_animation,barrows2_torag_attack_b

// 30604
[bslay_rots_tactics_verac]
param=bslay_tactic_title,Verac
param=bslay_tactic_text,Verac is back with his warmace. He will use standard attacks against you, with a 1/8 chance he'll ignore your armour when hitting.<br><br>Verac can also use the <col=FFFFFF>Wall Slam, Throw, Deathcopter</col>, and <col=FFFFFF>Soulspot</col> special attacks.

// 30605
[bslay_rots_tactics_verac_wallslam]
param=bslay_tactic_title,Verac: Wall Slam
param=bslay_tactic_text,Verac runs to a nearby wall, runs up it and then flings himself towards his original target, slamming down for massive damage.
param=bslay_tactic_new_npc,barrows2_verac
param=bslay_tactic_animation,barrows2_brother_wall_run

// 30606
[bslay_rots_tactics_verac_throw]
param=bslay_tactic_title,Verac: Throw
param=bslay_tactic_text,Verac will try to locate Ahrim or Karil to throw them. If successful, he'll <col=E6DCB4>Surge</col> over to them and throw them to a random nearby location, inflicting damage to anyone near where they land.<br>
param=bslay_tactic_new_npc,barrows2_verac
param=bslay_tactic_animation,barrows2_throw

// 30607
[bslay_rots_tactics_verac_copter]
param=bslay_tactic_title,Verac: Deathcopter
param=bslay_tactic_text,Verac will signal to any of his brothers than he can launch in the next <col=FFFFFF>20 seconds</col>. If another brother tries to <col=FFFFFF>Throw</col> Verac in this time he will instead take to the air and track his opponent. Should he get to them he'll smash down for incredible damage.
param=bslay_tactic_new_npc,barrows2_verac
param=bslay_tactic_animation,barrows2_verac_helicopter

// 30608
[bslay_rots_tactics_verac_soulspot]
param=bslay_tactic_title,Verac: Soulspot
param=bslay_tactic_text,Verac will tie his opponent's soul to a random point in the environment, marked by green arrows. Until his opponent stands on this spot, Verac will constantly sap their prayer points.<br><br>

// 30609
[bslay_rots_tactics_escape]
param=bslay_tactic_title,The Escape
param=bslay_tactic_text,After the brothers have been defeated, you have to leave to claim any malevolent energy. As you leave the encounter area, it will begin to collapse, you and your team have <col=FFFFFF>30 seconds</col> to escape before it implodes.

// 30610
[bslay_chaose_tactics_confusion]
param=bslay_tactic_title,Confusion
param=bslay_tactic_text,The Chaos Elemental confuses his opponents, teleporting them to a random area around him unless they are more than 20m away.
param=bslay_tactic_animation,elemental_update_chaos_attack

// 30611
[bslay_chaose_tactics_discord]
param=bslay_tactic_title,Discord
param=bslay_tactic_text,The Chaos Elemental lets chaos decide when discord hits. When it meets its target, it will randomly act as a melee, ranged, or magic attack and hit as such.
param=bslay_tactic_animation,elemental_update_chaos_attack

// 30612
[bslay_chaose_tactics_madness]
param=bslay_tactic_title,Madness
param=bslay_tactic_text,If you have space in your inventory, the Chaos Elemental may use Madness against you. Madness aims to remove your main-hand weapon and up to three items in random slots.
param=bslay_tactic_animation,elemental_update_chaos_attack

// 30613
[bslay_zilyana_tactics_melee]
param=bslay_tactic_title,Melee attack
param=bslay_tactic_text,Commander Zilyana smashes her sword against her target for heavy damage. There is a <col=FFFFFF>50%</col> chance when Zilyana attacks in melee that she instead performs her magical attack.
param=bslay_tactic_animation,godwars_saradomin_attack
param=bslay_tactic_new_npc,godwars_saradomin_avatar

// 30614
[bslay_zilyana_tactics_magic]
param=bslay_tactic_title,Magic attack
param=bslay_tactic_text,Commander Zilyana finds all nearby targets and calls upon Saradomin's lightning to deal heavy magic damage to all it hits.
param=bslay_tactic_animation,godwars_saradomin_magic_attack
param=bslay_tactic_new_npc,godwars_saradomin_avatar

// 30615
[bslay_zilyana_tactics_minions]
param=bslay_tactic_title,Saradomin bodyguards
param=bslay_tactic_text,Commander Zilyana has backup with her in the form of <col=FFFFFF>Bree, Starlight</col>, and <col=FFFFFF>Growler</col>. Each uses a different point of the combat triangle and Commander Zilyana will respawn any dead bodyguards every <col=FFFFFF>30 seconds.
param=bslay_tactic_animation,unicorn_2012_ready
param=bslay_tactic_new_npc,godwars_saradomin_unicorn

// 30616
[bslay_zilyana_tactics_lightning_hm]
param=bslay_tactic_title,Lightning: <col=DC7800>Hard mode only
param=bslay_tactic_text,Commander Zilyana summons a lightning storm on up to five opponents at a time. A lightning storm will move a small amount at random, hitting heavy magical damage to anyone caught in it.
param=bslay_tactic_animation,tsd_tornado_spin_lightning_spotanim
param=bslay_tactic_new_npc,godwars_saradomin_lightning

// 30617
[bslay_zilyana_tactics_death_hm]
param=bslay_tactic_title,Ultimate death: <col=DC7800>Hard mode only
param=bslay_tactic_text,When Commander Zilyana has been defeated for the second time, she can only be killed via use of an <col=FFFFFF>Ultimate ability.</col>. If this does not happen after <col=FFFFFF>6 seconds</col>, she will heal up and continue fighting.
param=bslay_tactic_animation,mah5_cutscene_zilyana_lie_on_ground_pose
param=bslay_tactic_new_npc,godwars_saradomin_avatar_hard_dead

// 30618
[bslay_corp_tactics_melee]
param=bslay_tactic_title,Melee attack
param=bslay_tactic_text,The Corporeal Beast will violently swing his feet or stamp them at his target, hitting them for heavy damage with a chance to drain prayer points.
param=bslay_tactic_animation,sum1_spirit_beast_swipe
param=bslay_tactic_new_npc,sum2_spirit_beast_corporeal

// 30619
[bslay_corp_tactics_magic]
param=bslay_tactic_title,Magic (single target)
param=bslay_tactic_text,The Corporeal Beast hit its main target for heavy magic damage, also draining their prayer points, and degrading their summoning and magic levels. (If the targets summoning points are fully drained it will deal extra damage instead)
param=bslay_tactic_animation,sum1_spirit_beast_launch
param=bslay_tactic_new_npc,sum2_spirit_beast_corporeal

// 30620
[bslay_corp_tactics_magic_aoe]
param=bslay_tactic_title,Magic (area target)
param=bslay_tactic_text,The Corporeal Beast fires a magical attack at his current target's position. On impact, it explodes and splits into multiple smaller projectiles - all hitting heavy magical damage to those get caught in the blast.
param=bslay_tactic_animation,sum1_spirit_beast_launch
param=bslay_tactic_new_npc,sum2_spirit_beast_corporeal

// 30621
[bslay_corp_tactics_familar_devour]
param=bslay_tactic_title,Devour
param=bslay_tactic_text,If the Corporeal Beast senses the presence of a familiar, he will devour it, destroying it completely.
