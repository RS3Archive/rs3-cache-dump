// 28863
[bslay_dungeon_ulthven3_hole]
param=bslay_tactic_title,Unstable Black Hole
param=bslay_tactic_text,The Ambassador will occasionally conjure unstable energy portals from Erebus. These Unstable black holes increase in energy over time and explode for huge <col=FFFFFF>typeless</col> damage if not interrupted by a stun ability.

// 28864
[bslay_dungeon_ulthven3_beam]
param=bslay_tactic_title,Tri Beam
param=bslay_tactic_text,Kranon will unleash a huge and continuous burst of energy that will disintegrate anything it hits with huge typeless damage. He will channel and rotate three large beams around the room in an attempt to annihilate any players in the arena.
param=bslay_tactic_new_npc,dungeon_ulthven_boss3_tri_beam_dummy
param=bslay_tactic_spotanim,dungeon_ulthven_ambassador_beam_rotate_attack_spotanim
param=bslay_tactic_spotanim_model,dungeon_ulthven_ambassador_beam_rotate_attack_spotanim

// 28865
[bslay_dungeon_ulthven3_fragments]
param=bslay_tactic_title,Sinister Fragments
param=bslay_tactic_text,Upon channelling his Tri Beam, <col=FFFFFF>6</col> Sinister Fragments of the Ambassador's power fly out of him and are exposed and vulnerable. Destroying as many of these as possible is recommended to prevent him from reabsorbing them.
param=bslay_tactic_new_npc,dungeon_ulthven_boss3_orb

// 28866
[bslay_dungeon_ulthven3_explode]
param=bslay_tactic_title,Pulse of Erebus
param=bslay_tactic_text,The Ambassador will cause massive shockwaves after finishing his Tri Beam attack. He is able of unleashing one shockwave for every Sinister Fragment that was reabsorbed.

// 28867
[bslay_dungeon_ulthven3_crassians]
param=bslay_tactic_title,Crassian Ritual Keepers
param=bslay_tactic_text,Kranon will start to summon <col=FFFFFF>invulnerable</col> Crassians to assist him.
param=bslay_tactic_new_npc,dungeon_ulthven_boss3_crassian

