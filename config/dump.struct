[pop_voyage_story_convict_1]
param=pop_voyage_id,32742
param=pop_voyage_name,Meet the Convict
param=pop_voyage_type,6
param=pop_voyage_text,You've received an anonymous message, requesting passage from the Arc region. The correspondent seeks sanctuary, and can pay in goods or cash.
param=pop_voyage_success_text,The mysterious correspondent is a man called Horatio Waxenwing, a convict wanted in the west for a variety of crimes. He seeks to make a new life in the east.
param=pop_voyage_duration,2500
param=pop_voyage_combatdiff,0
