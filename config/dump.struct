param=trh_promo_banner_fr,rs3_thbanner_th_agihuntdummies_fr
param=trh_promo_banner_pt,rs3_thbanner_th_agihuntdummies_pt

// 33684
[bslay_egwd_bik_boss_subdued]
param=bslay_tactic_title,Subdued
param=bslay_tactic_text,The spirits of the heroes whose statues have been restored will provide a short window where the core fungus of Croesus is vulnerable. Run underneath Croesus and use your skills to remove the fungus. Pay attention to the spores from the fungus, as extra damage can be dealt. Successfully removing the fungus will defeat Croesus, forcing it back into a dormant state.

// 33685
[bslay_egwd_bik_boss_attacks_title]
param=bslay_tactic_title,Croesus Attacks

// 33686
[bslay_egwd_bik_boss_spore_bombs]
param=bslay_tactic_title,Spore Bombs
param=bslay_tactic_text,Croesus fires <col=FFFFFF>spore bombs</col> that leave a cloud of toxic spores on the ground for a short time. While standing in these spores, encounter skills will be drained by <col=FFFFFF>15 levels</col>.
param=bslay_tactic_animation,egwd_bik_boss_croesus_attack_spores

// 33687
[bslay_egwd_bik_boss_fairy_ring]
param=bslay_tactic_title,Fairy Rings
param=bslay_tactic_text,Croesus grows a <col=FFFFFF>fairy ring</col> under players. After a short time, this will teleport them to a random location in the graveyard. Move away from fairy rings to avoid being teleported.
param=bslay_tactic_animation,egwd_bik_boss_croesus_attack_slime_trap

// 33688
[bslay_egwd_bik_boss_slime_mould]
param=bslay_tactic_title,Slime Mould
param=bslay_tactic_text,Croesus fires a <col=FFFFFF>fungal slime mould</col> that moves towards a player. You must move to avoid the slime mould or encounter skills will be drained by <col=FFFFFF>25%</col>.
param=bslay_tactic_animation,egwd_bik_boss_croesus_attack_fungus

