param=thedrop_answer_2,185,000.
param=thedrop_answer_3,360,000.
param=thedrop_correct_answer,3
param=thedrop_question_answers,3

// 34478
[event_cs_week_2016_thedrop_hard_q2]
param=thedrop_question,If a player messages me telling me I can easily earn loads of money, I should...
param=thedrop_answer_1,Assume it's a scam.
param=thedrop_answer_2,Do what they ask.
param=thedrop_answer_3,Screenshot it for evidence.
