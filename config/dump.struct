param=rewardshop_cost,3500
param=rewardshop_obj,trh_combat_dummy
param=rewardshop_buy_option_1,1
param=rewardshop_is_claimable,1
param=rewardshop_tooltip,Provides a collection of items that can help you level your skills. This includes:<br>- 10 tiny portable skilling packs, which hold portable skilling stations that let you train certain skills more efficiently until consumed.<br>- 10 combat dummies, which let you train your combat skills until consumed.<br>- 5 medium skill training dummy crates, which hold dummies that let you train certain skills until consumed.
param=rewardshop_usetooltip,1
param=rewardshop_owned_button_label,Claimed
param=rewardshop_owned_button_tooltip,You have claimed this.
