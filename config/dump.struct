// 33232
[struct_33232]
param=param_4832,Enrage abilities
param=param_4833,Telos gains the following abilities at certain enrages.

// 33233
[struct_33233]
param=param_4832,Virus
param=param_4833,At 50% enrage, an anima-specific virus effect will be applied in phases two & three. This must be cleared before it detonates by standing in the corresponding beam. The black & red virus are applied at 50% enrage, and the green virus is applied in phase five at 100% enrage.

// 33234
[struct_33234]
param=param_4832,Stat restore
param=param_4833,At 50% enrage, Telos begins to regenerate stats. This effect increases every 50% enrage up to 250%.

// 33235
[struct_33235]
param=param_4832,Freedom
param=param_4833,At 150% enrage, Telos gains the ability to use freedom. The cooldown of freedom is then reduced at 250% & 1000% enrage

