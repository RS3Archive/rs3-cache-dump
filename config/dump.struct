[task_sworlds]
param=task_name,Shattered Worlds Weekly Challenges
param=task_details,Help the Abyssal Knights hold the threat of the Shattered Worlds at bay by killing specific targets or completing specific worlds.
param=task_rewards,Each challenge awards a large sum of <col=ffffff>anima</col> which can be spent on <col=ffffff>abilities</col>, <col=ffffff>cosmetics</col> and <col=ffffff>slayer masks.</col> Shattered Worlds has something for everyone.
param=task_step_1,The Shattered Worlds portal is in the north-east <col=ffffff>Void Knight Outpost</col>. Get there from the <col=ffffff>Port Sarim lodestone</col>.
param=task_step_1_arrow,0_41_41_53_51
