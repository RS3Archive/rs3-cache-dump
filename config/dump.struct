// 40923
[struct_40923]
param=param_2795,Provides the ability to teleport to available Slayer masters.<br>Provides a chance to select your next task from Slayer masters.

// 40924
[struct_40924]
param=param_2795,Provides bonus charge drain rate reduction.<br>Provides an increased chance of receiving components when disassembling.

// 40925
[struct_40925]
param=param_2795,Provides teleports to available resource dungeons and the cape can be equipped within Daemonheim.<br>Provides a chance to choose the next boss you face and increases the chance of receiving lore related drops.

// 40926
[struct_40926]
param=param_2795,Extended duration in the Tears of Guthix minigame.<br>Provides teleports to locations around Gielinor.

// 40927
[struct_40927]
param=param_6410,A Cunning Plank
param=param_6411,Get the plank maker in Rimmington to saw logs into planks.
param=param_6412,"staticons_high_res2_clean,6"
param=param_6413,3428
param=param_1282,0_46_50_10_31
param=param_1274,Get some <col=0xFFCB05>logs</col> by chopping down a <col=0xFFCB05>tree</col> and <col=0xFFCB05>100 coins</col> per plank.
param=param_1275,<col=0xFFCB05>Buy planks</col> from the <col=0xFFCB05>plank maker</col>.
param=param_2225,You need planks to construct furniture in your house.
param=param_6415,1
param=param_1322,1
param=param_8169,true

// 40928
[struct_40928]
param=param_6410,Under Construction
param=param_6411,Visit your house in Building Mode.
param=param_6412,"staticons_high_res2_clean,6"
param=param_6413,3429
param=param_1282,0_46_50_8_25
param=param_1274,Buy a house (see the <col=0xFFCB05>Unreal Estate, Man</col> achievement).
param=param_1275,It's recommended you bring <col=0xFFCB05>at least 8 planks</col>, <col=0xFFCB05>at least 2 bolt of cloth</col> and <col=0xFFCB05>at least 30 nails</col>.
param=param_1276,Visit your house in <col=0xFFCB05>Building Mode</col> via the <col=0xFFCB05>house portal</col>. (If your house is in Burthorpe, follow this guidance arrow.)
param=param_2225,<col=0xFFCB05>Bronze nails</col> and can be smithed from a single <col=0xFFCB05>bronze bar</col> with at least <col=0xFFCB05>4 Smithing</col> or purchased (along with <col=0xFFCB05>bolts of cloth</col>) from <col=0xFFCB05>Alfred Stonemason's Construction Shop</col>. <col=0xFFCB05>Bring extra nails</col> in case some are wasted.
param=param_6415,1
param=param_1322,1
param=param_8169,true

// 40929
[struct_40929]
param=param_6410,Furniture Removal
param=param_6411,Remove an item of furniture that you have built in your house.
param=param_6412,"staticons_high_res2_clean,6"
param=param_6413,3432
param=param_1282,0_46_50_8_25
param=param_1274,Visit your house in <col=0xFFCB05>Building Mode</col> via the <col=0xFFCB05>house portal</col>.
param=param_1275,<col=0xFFCB05>Right-click</col> furniture you've built in your house, such as a <col=0xFFCB05>crude wooden chair</col> in your <col=0xFFCB05>parlour</col>, and choose to <col=0xFFCB05>remove</col> it.
param=param_8083,<col=0xFFCB05>Long-press</col> furniture you've built in your house, such as a <col=0xFFCB05>crude wooden chair</col> in your <col=0xFFCB05>parlour</col>, and choose to <col=0xFFCB05>remove</col> it.
param=param_2225,It's a good idea to remove furniture and replace it with superior items as your Construction level increases.
param=param_6415,1
param=param_1322,1
param=param_8169,true

// 40930
[struct_40930]
param=param_6410,It's Curtains For You
param=param_6411,Build a rug or curtain in the parlour of your house.
param=param_6412,"staticons_high_res2_clean,6"
param=param_6413,3430
param=param_1282,0_46_50_8_25
param=param_1274,If you don't yet have <col=0xFFCB05>level 2 Construction</col>, build furniture in your house to earn Construction XP.
param=param_1275,Buy at least <col=0xFFCB05>2 bolt of cloth</col> from <col=0xFFCB05>Alfred Stonemason's Construction Shop</col>.
param=param_1276,Visit your house in <col=0xFFCB05>Building Mode</col> via the <col=0xFFCB05>house portal</col>.
param=param_1277,<col=0xFFCB05>Left-click</col> a <col=0xFFCB05>rug</col> or <col=0xFFCB05>curtain</col> hotspot in your <col=0xFFCB05>parlour</col> and choose to <col=0xFFCB05>build</col> it.
param=param_8085,<col=0xFFCB05>Tap</col> a <col=0xFFCB05>rug</col> or <col=0xFFCB05>curtain</col> hotspot in your <col=0xFFCB05>parlour</col> and choose to <col=0xFFCB05>build</col> it.
param=param_2225,You need <col=0xFFCB05>5 bolt of cloth</col>, <col=0xFFCB05>3 planks</col>, and <col=0xFFCB05>at least 3 nails</col> to build all the cloth furnishings in your parlour.
param=param_1294,22
param=param_1295,2
param=param_6415,1
param=param_1322,1
param=param_8169,true

// 40931
