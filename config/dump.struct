param=dom_boss_name,Special: I Eat Dagannoths For Breakfast
param=dom_boss_npc_safe_1,dom_original_dagganoth_mother_melee_safe
param=dom_boss_npc_safe_2,dom_second_dagannoth_mother_grey_safe
