// 2778
[dom_boss_flambeed_agrithnana_dessourt]
param=dom_boss_name,Flambeed, Agrith-Na-Na and Dessourt
param=dom_boss_id,23
param=dom_boss_npc_safe_1,dom_flambeed_safe
param=dom_boss_npc_safe_2,dom_agrith_nana_safe
param=dom_boss_npc_safe_3,dom_dessourt_safe
param=dom_boss_npc_combat_1,dom_flambeed_combat
param=dom_boss_npc_combat_2,dom_agrith_nana_combat
param=dom_boss_npc_combat_3,dom_dessourt_combat
param=dom_npc_spawn_npc1_x,35
param=dom_npc_spawn_npc1_z,31
param=dom_npc_spawn_npc2_x,37
param=dom_npc_spawn_npc2_z,28
param=dom_npc_spawn_npc3_x,36
param=dom_npc_spawn_npc3_z,30
param=dom_arena_type,2
param=dom_boss_desc,These evil machinations of the Culinaromancer could only be created by someone obsessed with food. Three 'things' are made from loads of hot cakes, bananas and sweets. Beyond not dying, most people struggle not to take a sneaky bite of one of them.<br><br><col=F5B241>Quest</col>: Recipe for Disaster<br><br><col=F5B241>Combat</col>: A deadly trio. Flambeed is a fiery foe and you'll need to be wearing ice gloves when attacking to hold on to your weapons. He attacks with melee and magic. Agrith-Na-Na fights with magic and will occasionally teleport you face-to-face. Dessourt deals a mixture of melee, ranged and magic attacks and will occasionally teleport straight to you if you wander (or flee) too far away.
param=dom_boss_1_taunt,Yummy!
param=dom_boss_2_taunt,Let's eat him
param=dom_boss_3_taunt,A tasty morsel
param=dom_boss_taunt_sound_english,flambeed_nana_dessourt_taunt
param=dom_boss_taunt_sound_german,flambeed_nana_dessourt_taunt
param=dom_boss_taunt_sound_french,flambeed_nana_dessourt_taunt
param=dom_boss_taunt_sound_portuguese,flambeed_nana_dessourt_taunt
param=dom_battle_total_lifepoints,25900
param=dom_boss_spline_size,0
param=dom_boss_thumbnail,aif_dom_flambeed_agrith_dessourt

// 2779
[dom_boss_giant_scarab]
param=dom_boss_name,Giant Scarab
param=dom_boss_id,24
param=dom_boss_npc_safe_1,dom_giant_scarab_safe
param=dom_boss_npc_combat_1,dom_giant_scarab_combat
param=dom_npc_spawn_npc1_x,37
param=dom_npc_spawn_npc1_z,31
param=dom_arena_type,2
param=dom_boss_desc,It's giant. It's scaraby. What else does anyone need to know? If one looks closely enough they'll spy Kaleef's Keris dagger - a weapon crafted to destroy any one who should worship Scabaras.<br><br><col=F5B241>Quest</col>: Contact!<br><br><col=F5B241>Combat</col>: The scarab is a mighty foe by himself, but he'll also summon locust riders, mages and rangers to fight by his side. The giant scarab himself attacks with a mixture of melee and ranged while his helpers will set upon you with a mixture of all corners of the combat triangle. The giant scarab will also poison you if you're fighting from a distance.
param=dom_boss_1_taunt,Rrrrr
param=dom_boss_taunt_sound_english,scorpion_death_all_2
param=dom_boss_taunt_sound_german,scorpion_death_all_2
param=dom_boss_taunt_sound_french,scorpion_death_all_2
param=dom_boss_taunt_sound_portuguese,scorpion_death_all_2
param=dom_battle_total_lifepoints,30000
param=dom_boss_spline_size,0
param=dom_boss_thumbnail,aif_dom_scarab_riders

