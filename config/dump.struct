param=cheevo_icon,"task_icons_36_48,6"
param=cheevo_unique_id,401
param=cheevo_game,1
param=task_step_1_arrow,0_50_49_43_15
param=task_step_1,You will need level <col=0xF0BE79>5 Fishing</col> and <col=0xF0BE79>fishing bait</col> to catch sardines. The fishing shop in Lumbridge sells these.
param=task_step_2,Go to a saltwater fishing spot, such as the shore east of Lumbridge swamp.
param=task_step_3,<col=0xF0BE79>Right-click</col> a net <col=0xF0BE79>fishing spot</col>, and choose <col=0xF0BE79>Bait</col>. You'll start using the fishing rod on your tool belt.
param=task_step_3_mobile,<col=0xF0BE79>Long-press</col> a net <col=0xF0BE79>fishing spot</col>, and choose <col=0xF0BE79>Bait</col>. You'll start using the fishing rod on your tool belt.
param=task_information,Fish are the staple of an adventurer's diet.<br>If you're planning to catch a lot of fish, be sure to bring plenty of fishing bait. Each fish you catch will consume bait.<br>At level 10 Fishing, you are able to fish herring when fishing with bait.
param=task_requirement_1_type,15
param=task_requirement_1_value,5
param=task_optional,1
param=cheevo_popup,false

