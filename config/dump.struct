// 24418
[item_protect_effect]
param=combatv2_ability_info,Protects 1 item. Stacks with other item protection effects (max 5 items). Does not work in PvP areas.
param=combatv2_ability_info_ondeath_activation,1

// 24419
[div_life_effect]
param=combatv2_ability_info,Revives you with 25% of your maximum life points. Does not work in PvP areas. Signs and portents of life and death share a 1-hour cooldown.
param=combatv2_ability_info_ondeath_activation,1

// 24420
[div_death_effect]
param=combatv2_ability_info,Revives you with 15% of your maximum life points and deals that much damage to the opponent that killed you. Does not work in PvP areas. Signs and portents of life and death share a 1-hour cooldown.
param=combatv2_ability_info_ondeath_activation,1

