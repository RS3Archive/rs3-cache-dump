[combatv2_elidinis_boss_corruption]
param=combatv2_ability_name,Corruption
param=combatv2_ability_info,- Deals <col=0xff0000>10</col> damage per stack whilst behind the moonlight barrier.<br>- Deals <col=0xff0000>20</col> damage per stack whilst beyond the moonlight barrier.<br>- Striking the Gate using <col=0x00ffff>Icthlarin's Aid</col> clears <col=0x00ff00>2 </col>stacks per <col=0x00ffff>Cleansed statue shard</col> used.
param=combatv2_ability_icon,elidinis_boss_corruption
