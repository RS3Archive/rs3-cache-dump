// 34298
[task_hard_nomad]
param=task_name,Memory of Nomad
param=task_details,Test your might against a scorned memory of <col=ffffff>Nomad</col> after the events of <col=ffffff>Nomad's Elegy</col>.
param=task_rewards,Once per week you can loot one of two chests for an assortment of high-value loot and combat supplies. There are also stylish and functional capes available to those who can best Nomad in a timely fashion.
param=task_step_1,Pass through Death's door in <col=ffffff>Death's office</col> to enter the Underworld. Head towards the large fortress doors at the far end of the bridge over the <col=ffffff>River Noumenon</col> in order to start the encounter.
param=task_step_2,Nomad can be fought as many times as you wish but you can only claim loot once per week.
param=task_step_3,<col=ffffff>Warning:</col> Death is not safe here.
param=task_icon,"task_icons_48_60,7"
param=task_set,63
param=task_unique_id,3076
param=task_area,0
param=task_requirement_1_type,61
param=task_requirement_1_value,219
param=task_optional,1
param=dndtracker_full_description,Test your might against a scorned memory of <col=ffffff>Nomad</col> after the events of <col=ffffff>Nomad's Elegy</col>. If victorious you can claim a weekly set of rewards from one of two bounty chests.
param=dndtracker_is_dnd,1
param=dndtracker_is_members,1
param=dndtracker_priority,6
param=challenge_nearest_lodestone,0_48_51_33_35

