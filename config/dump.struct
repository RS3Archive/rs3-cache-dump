param=dom_boss_taunt_sound_german,never_defeat_me_taunt
param=dom_boss_taunt_sound_french,never_defeat_me_taunt
param=dom_boss_taunt_sound_portuguese,never_defeat_me_taunt
param=dom_battle_total_lifepoints,27400
param=dom_boss_spline_size,1

