param=worldmap_upsell_content_caption_2_text,Zogre Flesh Eaters
param=worldmap_upsell_content_text,If you're heading to the Feldip Hills, bring your biggest sword. This is ogre country, and few - if any - have survived to reach the centre of Gu'Tanoth, where the ogre shamans rule.
