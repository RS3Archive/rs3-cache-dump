param=slayer_sl_req,101
param=slayer_example_npc,gemstone_dragon_hydrix

// 50982
[slayer_mandrith_list_entry_12]
param=slayer_name,revenant ghosts
param=slayer_type,161
param=slayer_description,Revenant ghosts range from ghostly imps to dragons, they are all very powerful. They have the ability to heal themselves, so make sure you're prepared! These ghosts reside in the Forinthry Dungeon.
param=slayer_example_npc,wildyghost_dragon

// 50983
