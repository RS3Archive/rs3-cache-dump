// 2796
[dom_boss_kendel]
param=dom_boss_name,The Kendal
param=dom_boss_id,41
param=dom_boss_npc_safe_1,dom_kendal_safe
param=dom_boss_npc_combat_1,dom_kendal_combat
param=dom_npc_spawn_npc1_x,37
param=dom_npc_spawn_npc1_z,31
param=dom_arena_type,1
param=dom_boss_desc,Many have heard of the phrase 'a wolf in sheep's clothing'. However, this is a man in a bear costume.<br><br><col=F5B241>Quest</col>: Mountain Daughter<br><br><col=F5B241>Combat</col>: Grrrr! Still dressed in his stinky costume, he will attack you with melee combat, trying his best to slice you up with his claws.
param=dom_boss_1_taunt,Die! *ahem* Roar!
param=dom_boss_taunt_sound_english,kendal_die
param=dom_boss_taunt_sound_german,kendal_die
param=dom_boss_taunt_sound_french,kendal_die
param=dom_boss_taunt_sound_portuguese,kendal_die
param=dom_battle_total_lifepoints,6000
param=dom_boss_spline_size,0
param=dom_boss_thumbnail,aif_dom_kendal

// 2797
[dom_boss_draugen]
param=dom_boss_name,Draugen
param=dom_boss_id,42
param=dom_boss_npc_safe_1,dom_draugen_safe
param=dom_boss_npc_combat_1,dom_draugen_combat
param=dom_npc_spawn_npc1_x,38
param=dom_npc_spawn_npc1_z,32
param=dom_arena_type,3
param=dom_boss_desc,Is he a ghost? Is he the living dead? A bit of both, in fact. He lingers around the place of his death and preys upon weak travellers. He left his humanity behind in his former life so no-one should expect any favours.<br><br><col=F5B241>Quest</col>: Fremennik Trials<br><br><col=F5B241>Combat</col>: The angry viking with issues is out for your blood. Last time you had to try and hunt him down, but now he's here waiting for you! He'll attack with basic melee.
param=dom_boss_1_taunt,Taste the wrath of the deadliest ghost in the world!
param=dom_boss_taunt_sound_english,draughen_taste_the_wrath
param=dom_boss_taunt_sound_german,draughen_taste_the_wrath
param=dom_boss_taunt_sound_french,draughen_taste_the_wrath
param=dom_boss_taunt_sound_portuguese,draughen_taste_the_wrath
param=dom_battle_total_lifepoints,4000
param=dom_boss_spline_size,0
param=dom_boss_thumbnail,aif_dom_draugen

// 2798
[dom_boss_tarn_razalor]
param=dom_boss_name,Tarn Razorlor
param=dom_boss_id,43
param=dom_boss_npc_safe_1,dom_tran_razorlor_mutant_safe
param=dom_boss_npc_combat_1,dom_tran_razorlor_mutant_combat
