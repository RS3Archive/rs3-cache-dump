// 3705
[bslay_egwd_zamorak_boss_chaos_blast]
param=bslay_tactic_title,Chaos blast
param=bslay_tactic_text,Zamorak will let out a burst of energy, removing all active overhead prayers. Zamorak's main target's position will be targeted with a barrage of chaos damage dealing <col=FFFFFF>magic damage</col> split between targets who remain at the chosen position, or <col=FFFFFF>typeless damage</col> to all targets if no one stands in the targeted area, as well as having <col=FFFFFF>10%</col> of their adrenaline drained and a adrenaline gain debuff applied.<br><br>Damage from this attack is scaled with Enrage %.
param=bslay_tactic_animation,zamorak_attack_special_chaos_blast

// 3706
[bslay_egwd_zamorak_boss_chaos_witch_channel]
param=bslay_tactic_title,Chaos witch
param=bslay_tactic_text,Once Zamorak hits his lifepoint cap for his current phase, he'll call forth and channel from a <col=FFFFFF>Chaos witch</col> from within <col=FFFFFF>Infernus</col>, also preventing any Edict pad from being charged up. Whilst channeling from this witch, Zamorak will progressivly gain more power for his <col=FFFFFF>Berserk phase</col>.<br><br>Once the witch is killed, Zamorak's targets will once again have the ability to charge up an Edict by stepping on the pads.

// 3707
[trh183_promo]
param=trh_promo_id,183
param=trh_promo_dates,trh183_promo_dates
param=trh_promo_info_dbrow,trh183_promo_info
param=trh_promo_chest_struct,trh_generic_0_chest_setup
param=trh_promo_floaterchest,mtx_chest_basic
param=trh_promo_floateranim_idle,trh_floating_chest_closed
param=trh_promo_floateranim_selected,trh_floating_chest_open
param=trh_promo_banner_rotate,false
param=trh_promo_banner_en,rs3_thbanner_foresight_to_train_default_en
param=trh_promo_banner_de,rs3_thbanner_foresight_to_train_default_de
param=trh_promo_banner_fr,rs3_thbanner_foresight_to_train_default_fr
param=trh_promo_banner_pt,rs3_thbanner_foresight_to_train_default_pt
param=trh_paintover_id,69
param=trh_mark_tutorial_seen,1
param=trh_uses_generic_multiplier,true
param=trh_droptable,trh_promo_categories_trh183
param=motw_banner_en,rs3_lobby_secondary_foresight_plus_en
param=motw_banner_de,rs3_lobby_secondary_foresight_plus_de
param=motw_banner_fr,rs3_lobby_secondary_foresight_plus_fr
param=motw_banner_pt,rs3_lobby_secondary_foresight_plus_pt
param=motw_onclick,1
param=trh_has_bonus_prizes,true
param=trh_banner_reward_track,trh_banner_rewards_dxp_1

// 3708
[bslay_egwd_zamorak_boss_finale]
param=bslay_tactic_title,Zamorak's last stand
param=bslay_tactic_text,In encounters of <col=FFFFFF>100% enrage</col> or higher, Zamorak will make a last ditch attempt to kill the player by pulling them into <col=FFFFFF>Infernus</col>.<br><br>Zamorak will draw from each hexed edict symbol in a random order, building up <col=FFFFFF>Chaos damage</col> whilst channelling from them. Targets can disrupt and stagger Zamorak by attacking the correct order of symbols shown in order to open up Zamorak for attack.<br><br>As Zamorak's damage window is opened up, he'll slam the floor, dealing <col=FFFFFF>melee damage</col>, dealing increased damage the closer the targets are to him.<br><br>After this strike, Zamorak will deal the total amount of <col=FFFFFF>Chaos damage</col> as one big hit with <col=FFFFFF>50%</col> of this damage penetrating through defensives and shielding effects, stacking with the <col=E80404>Disintegration</col> hex, to every target on <col=FFFFFF>Infernus</col>, which will deal further <col=FFFFFF>AoE damage</col> if targets are standing close to each other.<br><br>Once Zamorak's damage window is closed, he'll repeat the melee slam and Chaos Damage hit before beginning to channel from the symbols once more.<br><br>Damage from this attack is scaled with Enrage %.
param=bslay_tactic_animation,zamorak_attack_special_flames_of_zamorak

