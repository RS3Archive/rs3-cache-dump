param=dom_boss_npc_combat_1,dom_nezikchened_combat
param=dom_npc_spawn_npc1_x,37
param=dom_npc_spawn_npc1_z,31
param=dom_arena_type,1
param=dom_boss_desc,An enormous black demon, a creature of the underworld and altogether evil being. If he doesn't slash his enemies to pieces with his claws, they're likely to succumb to his vicious magic.<br><br><col=F5B241>Quest</col>: Legend's Quest<br><br><col=F5B241>Combat</col>: The huge black demon will attack with magic unless you run in and attack close range, at which he will switch to attack with his claws.
param=dom_boss_1_taunt,Graaarrr!
param=dom_boss_taunt_sound_english,greater_demon_attack_1
param=dom_boss_taunt_sound_german,greater_demon_attack_1
param=dom_boss_taunt_sound_french,greater_demon_attack_1
param=dom_boss_taunt_sound_portuguese,greater_demon_attack_1
param=dom_battle_total_lifepoints,9000
param=dom_boss_spline_size,0
