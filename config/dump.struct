param=rewardshop_cost,4500
param=rewardshop_obj,trh18_spring_cleaner
param=rewardshop_buy_option_1,1
param=rewardshop_is_claimable,1
param=rewardshop_tooltip,Provides a collection of items that can help you level your skills. This includes:<br>- The spring cleaner, which can convert selected enemy drops into various helpful resources while charged with springs or tight springs.<br>- 100 tight springs, which can charge or upgrade the spring cleaner.<br>- The silverhawk boots, which periodically grant Agility XP while running or skilling, if charged with silverhawk feathers or down.<br>- 100 silverhawk down, which can charge the silverhawk boots.<br>- 100 magic notepaper, which can note items to make them stackable.<br>If you already own the spring cleaner or silverhawk boots, you will not receive them from this collection.
param=rewardshop_usetooltip,1
param=rewardshop_owned_button_label,Claimed
param=rewardshop_owned_button_tooltip,You have claimed this.
param=rewardshop_buy_button_label,Claim
param=rewardshop_unaffordable_button_tooltip,You need to gain more progress points to claim this.

