// 29739
[dom_boss_vanstrom]
param=dom_boss_name,Vanstrom
param=dom_boss_id,49
param=dom_boss_npc_safe_1,dom_vanstrom_safe
param=dom_boss_npc_combat_1,dom_vanstrom_human
param=dom_npc_spawn_npc1_x,37
param=dom_npc_spawn_npc1_z,31
param=dom_arena_type,4
param=dom_boss_desc,One of the highest ranking and most powerful Vyres, Vanstrom hated humans with an extraordinary passion and was intent on destroying the Myreque.<br><br><col=F5B241>Quest</col>: The Branches of Darkmeyer<br><br><col=F5B241>Combat</col>: As an ancient vampyre, Vanstrom provides a suitably challenging fight for the final boss of a high-level quest. To damage him, you'll need a blisterwood weapon and - later on - holy water. Vanstrom uses melee and magic attacks, as well as some more complex tactics. When Vanstrom plunges the room into darkness, avoid damage by facing fully away from him. If he summons bloodvelds, you must kill them before they reach him, or Vanstrom will be healed. You should also keep an eye out for an explosion of shadow in the centre of the arena. Occasionally, Vanstrom will take off to gain an advantage. Keep moving! Finally, Vanstrom will resort to his vapour form. Flood the area with holy water to take him down.
param=dom_boss_1_taunt,
param=dom_boss_taunt_sound_english,vanstrom_defend_1
param=dom_boss_taunt_sound_german,vanstrom_defend_1
param=dom_boss_taunt_sound_french,vanstrom_defend_1
param=dom_boss_taunt_sound_portuguese,vanstrom_defend_1
param=dom_battle_total_lifepoints,40000
param=dom_boss_spline_size,0
param=dom_boss_thumbnail,domtower_icon_vanstrom

// 29740
[dom_boss_char]
param=dom_boss_name,Char
param=dom_boss_id,50
param=dom_boss_npc_safe_1,dom_char_safe
param=dom_boss_npc_combat_1,dom_char_giant
param=dom_npc_spawn_npc1_x,37
param=dom_npc_spawn_npc1_z,31
param=dom_arena_type,2
param=dom_boss_desc,Trapped in a cave for centuries, Char's anger at Zamorak fuels her to fight. Being a member of the long-lost auspah race, Char commands great power over fire, bending it to her will.<br><br><col=F5B241>Quest</col>: The Firemaker's Curse<br><br><col=F5B241>Combat</col>: To take down Char you must fight fire with fire. The damage you inflict relies on how many fires you have lit, so use the pitch can often to ensure your numbers don't fall too low and keep an eye out for Char stamping them out. In her rage, Char will emit sparks which you can lure over your fires for bonuses. When Char becomes furious, avoid being hit! In the later stages of the fight, watch out for her summoned fire walls.
param=dom_boss_1_taunt,
param=dom_boss_taunt_sound_english,fmc_char_giant_level_down_vox
param=dom_boss_taunt_sound_german,fmc_char_giant_level_down_vox
param=dom_boss_taunt_sound_french,fmc_char_giant_level_down_vox
param=dom_boss_taunt_sound_portuguese,fmc_char_giant_level_down_vox
param=dom_battle_total_lifepoints,45000
param=dom_boss_spline_size,0
param=dom_boss_thumbnail,domtower_icon_char

// 29741
[dom_boss_apep_heru]
param=dom_boss_name,Apep and Heru
param=dom_boss_id,51
param=dom_boss_npc_safe_1,dom_apep_safe
param=dom_boss_npc_safe_2,dom_heru_safe
param=dom_boss_npc_combat_1,dom_apep_combat
param=dom_boss_npc_combat_2,dom_heru_special
param=dom_npc_spawn_npc1_x,37
param=dom_npc_spawn_npc1_z,30
param=dom_npc_spawn_npc2_x,37
param=dom_npc_spawn_npc2_z,32
param=dom_arena_type,2
param=dom_boss_desc,The bodyguards of Lady Keli, Apep and Heru are deadly desert mercenaries.<br><br><col=F5B241>Quest</col>: Diamond in the Rough<br><br><col=F5B241>Combat</col>: Apep and Heru must be taken on together, with Apep's presence boosting Heru's power. Avoid being hit by Apep's 'whirling dervish' and run away from Heru when he positions his shield towards you to avoid being blinded.
param=dom_boss_1_taunt,Looks like the Lady wants you dead!
param=dom_boss_2_taunt,Yer! Dead!
param=dom_boss_taunt_sound_english,dom_rework_taunt_vo_apep_and_heru_v2
param=dom_boss_taunt_sound_german,dom_rework_taunt_vo_apep_and_heru_v2
param=dom_boss_taunt_sound_french,dom_rework_taunt_vo_apep_and_heru_v2
param=dom_boss_taunt_sound_portuguese,dom_rework_taunt_vo_apep_and_heru_v2
param=dom_battle_total_lifepoints,10000
param=dom_boss_spline_size,0
param=dom_boss_thumbnail,domtower_icon_apep_heru

