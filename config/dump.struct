param=skillguide_name,Geodes when mining
param=skillguide_info,When mining core rocks, you now have a chance to find geodes, which stack in your backpack. Crack open a geode for a random reward (such as gems and spirit shards)!<br>Level 50 free-to-play core mining nodes and below yield sedimentary geodes.<br>Member core mining nodes yield igneous geodes, and rare metamorphic geodes.
param=skillguide_level,5
param=skillguide_skill,13
param=skillguide_filter,2
param=skillguide_members,false
param=skillguide_is_milestone,true

