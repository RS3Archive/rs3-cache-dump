// 14878
[tns_room2_box19_text]
inputtype=int
outputtype=string
val=0,<col=ff0000> Primrose:</col> Hannibus was the first of my friends to appear from the books.
val=1,<col=ff0000> Primrose:</col> Scared the anima right out of me! One minute I was reading, the next there was a lizardman, leaning over to get a better look at the book.
val=2,<col=ff0000> Primrose:</col> I screamed of course. Mum came in and told me it was a fever, that I was seeing things. Pffrt. Even I couldn't make up a five-foot lizard reading books about himself.
val=3,<col=ff0000> Primrose:</col> I wished Megan could see them. Baba, Thok, Gilly, Hannibus. Perhaps they would have made her happy, just as much as they made me.
default=null

// 14879
[tns_room2_box19_text_npc]
inputtype=int
outputtype=string
val=0,<p=2>Hannibus was the first of my friends to appear from the books.
