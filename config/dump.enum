// 5489
[mtxfair17_chinchompa_prize_mystery_desc]
inputtype=int
outputtype=string
val=1,Rub this lamp to get XP in a skill of your choice.
val=2,This star can be drained of energy to give you bonus XP.
val=3,Used to charge Silverhawk boots. Cannot be traded.
val=4,Use on a spring cleaner to recharge it.
val=5,
val=6,This is a stackable plank that can be worked for Construction XP based on your Construction level.
val=7,This is a stackable bar that can be worked for Smithing XP based on your Smithing level.
val=8,A stackable item that acts like a hunting bird snare, box trap, and marasamaw plant. It has a higher capture rate and doesn't require smoking or baiting.
val=9,A stackable hide that can be used to train your Crafting.
val=10,This is a stackable log that can be used for Firemaking and/or Fletching XP based on your level in the skill(s).
val=11,A stackable memory that can be used to train your Divination.
val=12,A stackable cog that can be used to train your Invention.
default=

