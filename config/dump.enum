// 11215
[mm16_ports_skills_details]
inputtype=int
outputtype=string
val=0,Increased node spawns and double reward points at Runespan.
val=1,Double chance for relics, sceptre and Black Ibis at Pyramid Plunder.
val=2,Enriched Divination nodes spawn every 10 minutes.
val=3,Fishing spots stay in place twice as long.
val=4,Divination Wisps last twice as long.
val=5,+50% base Big Chinchompa XP.
val=6,+50% XP for completing Agility Courses.
val=7,Flatpacks created are noted.
val=8,5% reduced chance at burning your food.
val=9,2% chance to save the secondary whilst making a potion (stacks with existing effects).
default=

// 11216
[mm16_ports_dg_details]
inputtype=int
outputtype=string
val=0,50% extra base Dungeoneering XP from completing dungeons.
val=1,Deaths don't cause an XP penalty.
val=2,Double reputation from the Nemi forest and Trinks' tasks.
val=3,Ability to loot raids once per day.
default=

// 11217
[mm16_ports_bossslayer_details]
inputtype=int
outputtype=string
val=0,Charm drops give one more charm than normal.
val=1,50% increased base slayer experience.
val=2,Double points from regular and group slayer assignments.
val=3,Over the period of the weekend, all assigned Slayer tasks are treated as using a Slayer VIP ticket.
val=4,10% cheaper instance fees.
val=5,Extra training points from Boss Training.
val=6,You get to choose your Boss Slayer assignments over the weekend.
default=

