// 3063
[castlewars_item_descriptions]
inputtype=component
outputtype=string
val=castlewars_trade:lvl1_helm_layer,Basic decorative helm: Not required for the set bonus.
val=castlewars_trade:lvl1_torso_layer,Basic decorative body: Wearing the platebody, platelegs and shield together gives +10% damage against players in the arena.
val=castlewars_trade:lvl1_legs_layer,Basic decorative legs: Wearing platebody, platelegs and shield together gives +10% damage against players in the arena.
val=castlewars_trade:lvl1_shield_layer,Basic decorative shield: Wearing platebody, platelegs and shield together gives +10% damage against players in the arena.
val=castlewars_trade:lvl1_sword_layer,Basic decorative sword: Not required for the set bonus.
val=castlewars_trade:lvl2_helm_layer,Detailed decorative helm: Not required for the set bonus.
val=castlewars_trade:lvl2_torso_layer,Detailed decorative body: Wearing platebody, platelegs and shield together gives +15% damage against players and +10% damage against barricades and ballistas.
val=castlewars_trade:lvl2_legs_layer,Detailed decorative legs: Wearing platebody, platelegs and shield together gives +15% damage against players and +10% damage against barricades and ballistas.
val=castlewars_trade:lvl2_shield_layer,Detailed decorative shield: Wearing platebody, platelegs and shield together gives +15% damage against players and +10% damage against barricades and ballistas.
val=castlewars_trade:lvl2_sword_layer,Detailed decorative sword: Not required for the set bonus.
val=castlewars_trade:lvl3_helm_layer,Intricate decorative helm: Not required for the set bonus.
val=castlewars_trade:lvl3_torso_layer,Intricate decorative body: Wearing platebody, platelegs and shield together gives +20% damage against players, +10% damage against barricades and ballistas, and immunity to catapult damage.
val=castlewars_trade:lvl3_legs_layer,Intricate decorative legs: Wearing platebody, platelegs and shield together gives +20% damage against players, +10% damage against barricades and ballistas, and immunity to catapult damage.
val=castlewars_trade:lvl3_shield_layer,Intricate decorative shield: Wearing platebody, platelegs and shield together gives +20% damage against players, +10% damage against barricades and ballistas, and immunity to catapult damage.
val=castlewars_trade:lvl3_sword_layer,Intricate decorative sword: Not required for the set bonus.
val=castlewars_trade:lvl4_helm_layer,Profound decorative helm: Not required for the set bonus.
val=castlewars_trade:lvl4_torso_layer,Profound decorative body: Wearing platebody, platelegs and shield together gives +25% damage against players, +10% damage against barricades and ballistas, and immunity to catapult and ballista damage.
val=castlewars_trade:lvl4_legs_layer,Profound decorative legs: Wearing platebody, platelegs and shield together gives +25% damage against players, +10% damage against barricades and ballistas, and immunity to catapult and ballista damage.
val=castlewars_trade:lvl4_shield_layer,Profound decorative shield: Wearing platebody, platelegs and shield together gives +25% damage against players, +10% damage against barricades and ballistas, and immunity to catapult and ballista damage.
val=castlewars_trade:lvl4_sword_layer,Profound decorative sword: Not required for the set bonus.
val=castlewars_trade:ballista_base_layer,Ballista base: One of four parts needed to set up a ballista inside the arena.<br>The ballista fires projectiles at enemy players.
val=castlewars_trade:ballista_bolt_stack_layer,Ballista bolt stack: One of four parts needed to set up the ballista inside the arena.<br>The ballista fires projectiles at enemy players.
val=castlewars_trade:ballista_bow_layer,Ballista bow: One of four parts needed to set up the ballista inside the arena.<br>The ballista fires projectiles at enemy players.
val=castlewars_trade:ballista_chamber_layer,Ballista chamber: One of four parts needed to set up the ballista inside the arena.<br>The ballista fires projectiles at enemy players.
val=castlewars_trade:ballista_ammo_layer,Ballista ammo: Ammo fired by the ballista inside the arena.
val=castlewars_trade:potion_set_1_layer,Melee potion set: Set containing boosts to Attack, Strength, Defence and run energy. Can only be used inside the arena.
val=castlewars_trade:potion_set_2_layer,Ranged potion set: Set containing boosts to Ranged, Defence and run energy. Can only be used inside the arena.
val=castlewars_trade:potion_set_3_layer,Magic potion set: Set containing boosts to Magic, Defence and run energy. Can only be used inside the arena.
val=castlewars_trade:sara_cape_layer,Saradomin team cape: A basic Saradomin team cape.
val=castlewars_trade:zam_cape_layer,Zamorak team cape: A basic Zamorak team cape.
val=castlewars_trade:sara_hood_layer,Saradomin team hood: A basic Saradomin team hood.
val=castlewars_trade:zam_hood_layer,Zamorak team hood: A basic Zamorak team hood.
val=castlewars_trade:flag_cape_layer,Castle Wars flag cape: For showing off achievement of most flag captures in a match.
val=castlewars_trade:kills_cape_layer,Castle Wars kills cape: For showing off achievement of most kills in a match.
val=castlewars_trade:500_cape_layer,Castle Wars hobbyist cape: For showing off achievement of 500 games of Castle Wars.
val=castlewars_trade:1000_cape_layer,Castle Wars enthusiast cape: For showing off achievement of 1,000 games of Castle Wars.
val=castlewars_trade:5000_cape_layer,Castle Wars professional cape: For showing off achievement of 5,000 games of Castle Wars.
val=castlewars_trade:halo_guthix_layer,Guthix halo: Reduces the drain rate of various prayers. 
val=castlewars_trade:halo_sara_layer,Saradomin halo: Reduces the drain rate of various prayers.
val=castlewars_trade:halo_zam_layer,Zamorak halo: Reduces the drain rate of various prayers.
val=castlewars_trade:shield_layer,Faithful shield: A shield with a great Prayer bonus.
val=castlewars_trade:book_layer,Manual: details the rules of Castle Wars.
val=castlewars_trade:chinchompa_layer,Castle Wars chinchompas: Place these on the ground in proximity mode and they'll explode if the enemy gets too near. Use timer mode and they will run forwards, exploding after a few seconds. Can only be used on the ground floor of the arena, outside the fortress walls. You get three per ticket.
default=Items can be bought either with win tickets, or a combination of win and loss tickets.

