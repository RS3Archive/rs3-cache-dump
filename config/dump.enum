// 603
[pop_unlockable_scroll_discriptions]
inputtype=int
outputtype=string
val=1,Log-splitting<br><br>Chance to split a log as you chop it, converting the log into additional woodcutting experience.
val=2,Rock-crushing<br><br>+2% or +3% critical chance when mining.
val=3,Tree-shaking<br><br>Additional birds' nests drop from trees; occasionally implings too.
val=4,Gem-finding<br><br>+2% or +3% geode chance when mining.
val=5,Vampyrism<br><br>Steal life from enemies with every melee hit.
val=6,Attack<br><br>+2/4% hit chance with melee attacks.
val=7,Elements<br><br>Adds extra elemental damage to every magic hit.
val=8,Magic<br><br>+2/4% hit chance with magic attacks.
val=9,Cruelty<br><br>Adds extra damage to every ranged hit.
val=10,Ranging<br><br>+2/4% hit chance with ranged attacks.
val=11,Shark Soup<br><br>Heals 2300 Life Points.
val=12,Eastern soups<br><br>Heals for more life points than their base ingredient, up to 115% of maximum.
val=13,Tetsu helm<br><br>Level 85 melee helm.
val=14,Tetsu body<br><br>Level 85 melee body.
val=15,Tetsu platelegs<br><br>Level 85 melee legs.
val=16,Tetsu gauntlets<br><br>Level 84/85 melee gloves.
val=17,Tetsu dabatons<br><br>Level 84/85 melee boots.
val=18,Death Lotus hood<br><br>Level 85 ranged helm.
val=19,Death Lotus chestplate<br><br>Level 85 ranged body.
val=20,Death Lotus chaps<br><br>Level 85 ranged legs.
val=21,Death Lotus gloves<br><br>Level 84/85 ranged gloves.
val=22,Death Lotus boots<br><br>Level 84/85 ranged boots.
val=23,Seasinger's hood<br><br>Level 85 magic helm.
val=24,Seasinger's robe top<br><br>Level 85 magic body.
val=25,Seasinger's robe bottom<br><br>Level 85 magic legs.
val=26,Seasinger's gloves<br><br>Level 84/85 magic gloves.
val=27,Seasinger's shoes<br><br>Level 84/85 magic boots.
val=28,Leviathan ring<br><br>Level 85 defensive ring.
val=29,Reefwalker's cape<br><br>Level 85 defensive cape.
val=30,Death Lotus darts<br><br>Level 85 ranged weapons.
val=31,Tetsu swords<br><br>Level 85 melee weapons.
val=32,Seasinger wand/orb<br><br>Level 85 magic weapons.
val=33,Whopper-baiting<br><br>Imparts a chance to throwback a fish as you catch it, converting the fish into additional Fishing experience.
val=34,Casket-salvaging<br><br>Imparts a chance to salvage various caskets from the depth while fishing.
default=

