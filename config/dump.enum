// 11548
[enum_11548]
inputtype=int
outputtype=string
val=0,Warrior Bundle - This gives XP for the following skills:<br>Attack<br>Strength<br>Defence<br>Constitution
val=1,Ward Bundle - This gives XP for the following skills:<br>Magic<br>Constitution<br>Defence<br>Ranged
val=2,Ironborn Bundle - This gives XP for the following skills:<br>Mining<br>Hunter<br>Smithing
val=3,Quartermaster Bundle - This gives XP for the following skills:<br>Fishing<br>Farming<br>Cooking
val=4,Timber Bundle - This gives XP for the following skills:<br>Firemaking<br>Fletching<br>Woodcutting
val=5,Mystic Bundle - This gives XP for the following skills:<br>Runecrafting<br>Prayer<br>Summoning
val=6,Rogue Bundle - This gives XP for the following skills:<br>Dungeoneering<br>Thieving<br>Slayer
val=7,Knowledge Bundle - This gives XP for the following skills:<br>Divination<br>Invention
