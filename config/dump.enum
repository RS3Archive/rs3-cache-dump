// 1280
[trh169_tutorial_slot_to_instructions]
inputtype=int
outputtype=string
val=0,Your goal is to SLAY the slime to win prizes.
val=1,Firstly, feed your slime Hearts of Ice to increase the rarity probabilities for ALL prizes.
val=2,Secondly, spend keys to win a prize AND increase your slay multiplier.
val=3,Finally, slay the slime to apply your multiplier.
default=Your goal is to SLAY the slime to win prizes.

