// 15794
[farming_rep_unlock_desc]
inputtype=component
outputtype=string
val=farming_rep:reward_unlocked_1,Increased chance to receive animals as drops.
val=farming_rep:reward_unlocked_2,Weekly farmers in need at the Farming Guild will now request your assistance.<br>Limpwurt root yield is doubled.
val=farming_rep:reward_unlocked_3,Ability to build the Remote Farm Machine.<br>Shiny animals sell for 10% more beans.
val=farming_rep:reward_unlocked_4,Animals have less chance of becoming diseased.<br>Buyers on farms will buy twice as many small animals.
val=farming_rep:reward_unlocked_5,A bloodwood tree can be grown on Manor Farm.<br>Buyers on farms will buy twice as many medium animals.
val=farming_rep:reward_unlocked_6,5% increased chance of a shiny animal being born.<br>Buyers on farms will buy twice as many large animals.
val=farming_rep:reward_unlocked_7,All animals sell for 10% more beans.
default=

