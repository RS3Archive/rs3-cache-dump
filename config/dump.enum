// 11777
[elr2_minq_cyclosis_bird_watcher_say]
inputtype=int
outputtype=string
val=0,Aww, it's just another awah guan.
val=1,Is that a great pecker? On Cyclosis? Oh, no, just a cloud.
val=2,Could you cyclopes party quieter? You're scaring the birds.
val=3,Where are you, Ace? You should be home by now.
val=4,I can see my house from here! *snort* I make my own fun.
val=5,Skreeeeeeee! A dusky wigglebill! Oh, wait, no it isn't.
val=6,I wonder what bird watches the bird watcher. Ooh, that's deep.
val=7,I'm finally doing it tomorrow, Ember. I'm asking you out!
default=null

