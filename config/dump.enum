// 7156
[enum_7156]
inputtype=int
outputtype=string
val=0,The West
val=1,The Arc
val=2,The Skull
val=3,The Hook
val=4,The Scythe
val=5,The Bowl
val=6,The Pincers
val=7,The Loop
val=8,The Shield
