[enum_6202]
inputtype=int
outputtype=string
val=1,To select the Bork tree focus requires completion of the Hunt for Surok.
val=2,To select the Glacor focus requires completion of the Ritual of the Mahjarrat quest.
val=3,To select the Tormented demons focus requires completion of the While Guthix Sleeps quest.
val=6,To select the Barrows focus requires access to Morytania.
val=8,To select the Corporeal Beast focus requires completion of the Summer's End quest.
val=10,To select the Queen Black Dragon focus requires completion of the Songs From the Depths quest.
val=13,This focus requires 70 Agility, completion of the Troll Stronghold quest, and a talk with the paladin by the entrance.
val=14,This focus requires 70 Strength, completion of the Troll Stronghold quest, and a talk with the paladin by the entrance.
val=15,This focus requires 70 Ranged, and either 60 Agility or 60 Strength, completion of the Troll Stronghold quest, and a talk with the paladin by the entrance.
val=16,This focus requires 70 Constitution, and either 60 Agility or 60 Strength, completion of the Troll Stronghold quest, and a talk with the paladin by the entrance.
val=17,This focus requires 70 Agility, 70 Strength, 70 Ranged and 70 Constitution, completion of the Troll Stronghold quest, and a talk with the paladin by the entrance.
val=28,To select the Temple of Aminishi focus requires completion of the 'Impressing the Locals' quest
val=19,To select the Araxyte hive focus requires access to Morytania.
val=34,This focus requires completion of the 'Raksha, the Shadow Colossus' miniquest.
val=35,This focus requires access to Anachronia.
val=41,This focus requires completion of the 'The Spirit of War' quest.
default=null

