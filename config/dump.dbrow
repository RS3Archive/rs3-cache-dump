// 6360
[egwd_zamorak_boss_opening_cutscene]
table=image_sequence
data=col0,45
data=col1,240
data=col3,egwd_zamorak_boss_opening_cutscene_01,I am Zamorak.,egwd_zamboss_cs_vo_zam_01_alt2,150,false,false,true,true
data=col3,egwd_zamorak_boss_opening_cutscene_01,My life has been long, and throughout it I have lived by one maxim:,egwd_zamboss_cs_vo_zam_02_alt1,330,false,false,true,true
data=col3,egwd_zamorak_boss_opening_cutscene_01,Liberty or death.,egwd_zamboss_cs_vo_zam_03,150,false,false,true,true
data=col3,egwd_zamorak_boss_opening_cutscene_01,Freneskae was the perfect world.,egwd_zamboss_cs_vo_zam_04,170,false,false,true,true
data=col3,egwd_zamorak_boss_opening_cutscene_01,Harsh, but fair.,egwd_zamboss_cs_vo_zam_05,120,false,false,true,true
data=col3,egwd_zamorak_boss_opening_cutscene_01,Survival forced my people to become the greatest of warriors.,egwd_zamboss_cs_vo_zam_06_alt2,250,false,false,true,true
data=col3,egwd_zamorak_boss_opening_cutscene_01,When the stranger promised us conquest and plenty, we followed him.,egwd_zamboss_cs_vo_zam_07_alt2,290,false,false,true,true
data=col3,egwd_zamorak_boss_opening_cutscene_01,It was a mistake.,egwd_zamboss_cs_vo_zam_08_alt1,100,false,true,true,true
data=col3,egwd_zamorak_boss_opening_cutscene_02,On Gielinor, I built a mighty empire in the name of the dark god Zaros.,egwd_zamboss_cs_vo_zam_09_alt1,320,true,false,true,true
data=col3,egwd_zamorak_boss_opening_cutscene_02,But he and I did not share the same vision for the future.,egwd_zamboss_cs_vo_zam_010_alt3,210,false,false,true,true
data=col3,egwd_zamorak_boss_opening_cutscene_02,Where I saw freedom, he saw only control.,egwd_zamboss_cs_vo_zam_011_alt2,230,false,false,true,true
data=col3,egwd_zamorak_boss_opening_cutscene_02,My people, once warriors, became priests.,egwd_zamboss_cs_vo_zam_012,250,false,false,true,true
data=col3,egwd_zamorak_boss_opening_cutscene_02,Bureaucrats.,egwd_zamboss_cs_vo_zam_013_alt1,100,false,false,true,true
data=col3,egwd_zamorak_boss_opening_cutscene_02,Sanitation engineers.,egwd_zamboss_cs_vo_zam_014_alt1,170,false,false,true,true
data=col3,egwd_zamorak_boss_opening_cutscene_02,To win their freedom, I struck down a god.,egwd_zamboss_cs_vo_zam_016_alt1,220,false,false,true,true
data=col3,egwd_zamorak_boss_opening_cutscene_02,To safeguard it, I became one.,egwd_zamboss_cs_vo_zam_017_alt3,200,false,true,true,true
data=col3,egwd_zamorak_boss_opening_cutscene_03,On Infernus, I led a downtrodden people to victory.,egwd_zamboss_cs_vo_zam_018_alt1,250,true,false,true,true
data=col3,egwd_zamorak_boss_opening_cutscene_03,Hostilius, a corpulent monster grown fat and indolent, maintained order through rules and laws.,egwd_zamboss_cs_vo_zam_019_alt1,460,false,false,true,true
data=col3,egwd_zamorak_boss_opening_cutscene_03,His laws did as little to protect him as his skin did.,egwd_zamboss_cs_vo_zam_020_alt4,270,false,false,true,true
data=col3,egwd_zamorak_boss_opening_cutscene_03,I strung up his corpse as a message for all to see. Such is the fate of all tyrants.,egwd_zamboss_cs_vo_zam_021,370,false,false,true,true
data=col3,egwd_zamorak_boss_opening_cutscene_03,The Avernic demons, now free, serve me willingly.,egwd_zamboss_cs_vo_zam_022,280,false,true,true,true
data=col3,egwd_zamorak_boss_opening_cutscene_04,Back on Gielinor, pretenders picked over the remains of my empire.,egwd_zamboss_cs_vo_zam_023_alt1,335,true,false,true,true
data=col3,egwd_zamorak_boss_opening_cutscene_04,For an age I battled them.,egwd_zamboss_cs_vo_zam_024_alt1,150,false,false,true,true
data=col3,egwd_zamorak_boss_opening_cutscene_04,An age of strife, of progress, of glory.,egwd_zamboss_cs_vo_zam_025_alt1,240,false,false,true,true
data=col3,egwd_zamorak_boss_opening_cutscene_04,While I fought on, none could establish the safety, the security, that they so craved.,egwd_zamboss_cs_vo_zam_026_alt3,410,false,false,true,true
data=col3,egwd_zamorak_boss_opening_cutscene_04,For an age, Gielinor was truly free.,egwd_zamboss_cs_vo_zam_027_alt2,210,false,false,true,true
data=col3,egwd_zamorak_boss_opening_cutscene_04,But they conspired against me, and I was banished.,egwd_zamboss_cs_vo_zam_028_alt4,265,false,true,true,true
data=col3,egwd_zamorak_boss_opening_cutscene_05,In my long absence, this world has become weak.,egwd_zamboss_cs_vo_zam_029_alt3,230,true,false,true,true
data=col3,egwd_zamorak_boss_opening_cutscene_05,Saradomin's fingers are wrapped tightly around its throat, suffocating it.,egwd_zamboss_cs_vo_zam_030_alt2,320,false,false,true,true
data=col3,egwd_zamorak_boss_opening_cutscene_05,My demon army will make short work of its farmers, woodcutters and fishermen.,egwd_zamboss_cs_vo_zam_031_alt8,390,false,false,true,true
data=col3,egwd_zamorak_boss_opening_cutscene_05,The survivors will be stronger. They will have no choice.,egwd_zamboss_cs_vo_zam_032_alt4,300,false,false,true,true
data=col3,egwd_zamorak_boss_opening_cutscene_05,Gielinor's people will be free, or they will die.,egwd_zamboss_cs_vo_zam_033_alt1,310,false,false,true,true
data=col3,egwd_zamorak_boss_opening_cutscene_05,Liberty or death.,egwd_zamboss_cs_vo_zam_034_alt8,300,false,true,true,true

