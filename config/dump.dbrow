data=col1,Aster Dunnet
data=col2,Butler
data=col3,They/Them
data=col5,quest_fort_aster
data=col7,5000
data=col11,Aster is my steward and the building manager of my town hall.
data=col11,They are professional, approachable, and a big fan of detective stories and murder mysteries.
data=col15,false

// 7248
[quest_fort_casefile_suspect_bianca]
table=quest_fort_casefile_entry
data=col1,Bianca Dunnet
data=col2,Housekeeper
data=col3,She/Her
data=col5,quest_fort_bianca
data=col7,6000
data=col9,20
data=col11,Bianca is Aster's sister, and the building manager of my kitchen.
data=col11,She is quiet and soft spoken, but friendly.
data=col11,Her clumsiness often detracts from her impressive cooking skills.
data=col15,false

// 7249
[quest_fort_casefile_suspect_duke]
table=quest_fort_casefile_entry
data=col1,Duke Cole Hoarse
data=col2,Duke of Edgeville
data=col3,He/Him
data=col5,quest_fort_duke_hoarse
data=col6,85
data=col7,6000
data=col11,He is rude, perpetually grumpy, and generally unpleasant to be around.
data=col11,You'd be hard pressed to find someone who doesn't want him dead.
data=col15,false

// 7250
[quest_fort_casefile_suspect_rodney]
