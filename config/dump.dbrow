// 6644
[dbrow_6644]
table=dbtable_72
data=col3,This is the Fresh Start Worlds Reward Shop!<br>Here, you can unlock <col=0xFFCB05>powerful boosts</col> and claim <col=0xFFCB05>helpful items</col> with your <col=0xFFCB05>progress points</col>.<br>These points are earned by <col=0xFFCB05>leveling up</col>, completing <col=0xFFCB05>quests</col> and earning <col=0xFFCB05>achievements</col>.<br>Whenever your progress points reach a <col=0xFFCB05>milestone</col>, you can claim a boost or item.<br>Your progress points <col=0xFFCB05>aren't spent</col> when you claim something, so feel free to unlock everything as soon as you have enough points.

