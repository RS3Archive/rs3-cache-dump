[buff_select_event_buff_slayer_counter_freeze]
table=buff_select_event_buff
data=col0,26
data=col1,Thrillseeker
data=col2,The <col=0x00ffff>Slayer counter</col> doesn't decrease.
data=col3,Killing a monster on a Slayer assignment will no longer decrease the <col=0x00ffff>Slayer counter</col>.
data=col4,We recommend <col=0x00ffff>setting up your desired assignment before activating</col> this buff.
data=col6,event_bonanza_icon_buff_slayer_counter_freeze

// 13082
