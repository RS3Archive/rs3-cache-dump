table=dbtable_40
data=col0,44
data=col1,239
data=col3,zamorak_cutscene_1,O Saradomin, unholy despot.,sound_54459,250,true,false,true,true
data=col3,zamorak_cutscene_1,I bring a message from Zamorak, Lord of Chaos, Imperator of Gielinor, Dictator of Infernus and the Lower Planes, et cetera.,sound_54460,550,false,false,true,true
data=col3,zamorak_cutscene_1,The Empire of Chaos has returned. This world is ours.,sound_54461,350,false,true,true,true
data=col3,zamorak_cutscene_2,Your armies are spent, O Saradomin, while our demons outnumber the stars.,sound_54462,350,true,false,true,true
data=col3,zamorak_cutscene_2,You sit in crumbling fortresses while our forces attack at their leisure.,sound_54463,350,false,false,true,true
data=col3,zamorak_cutscene_2,Your people are starving, while we burn your crops as offerings.,sound_54464,350,false,true,true,true
data=col3,zamorak_cutscene_3,Even now, all-powerful Zamorak summons legions to this world from behind an impregnable shield.,sound_54465,400,true,false,true,true
data=col3,zamorak_cutscene_3,Supplicate yourself before him and he will spare the lives of your few misguided followers.,sound_54466,420,false,false,true,true
data=col3,zamorak_cutscene_3,Refuse, and his wrath shall consume all lands.,sound_54467,320,false,true,true,true

