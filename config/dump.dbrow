[trh176_promo_info]
table=trh_promo_info
data=col0,<str>Santa's</str> Snow Imp's Grotto
data=col1,Snow Imps have hijacked Santa's Grotto!
data=col3,11
data=col5,Open present bundles and win rewards!<br>Every present you open will fill the <col=FFDF00>Festive Bonus</col> bar, offering you bonus options when filled.
data=col6,Mayhem Unleashed!
data=col7,In Snow Imp's Grotto, you have greatly <col=FFDF00>imp-roved</col> chances to get your hands on <col=8d52e5>Rare Prizes</col>. This version of the Grotto will feature the <col=3366FF>Blue Santa Hat</col> and <col=FFFF00>Yellow Santa Hat</col>! Along with different <col=8d52e5>Festive Cosmetics</col> throughout the promotion!
data=col9,Promotion Information
data=col10,trh176_promo_info_rewards
data=col10,trh176_promo_info_bonuses
data=col10,trh176_promo_info_chests

