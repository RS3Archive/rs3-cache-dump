data=col7,3
data=col8,5
data=col9,4
data=col11,true

// 5403
[dbrow_5403]
table=dbtable_72
data=col3,The Favourites tab allows you to save items you buy frequently, avoiding the need to search each time you wish to buy them.

// 5404
[dbrow_5404]
table=dbtable_71
data=col0,History Help Button
data=col2,dbrow_5405
data=col2,dbrow_5406
data=col2,dbrow_5408
