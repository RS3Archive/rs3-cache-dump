// 6096
[trh179_promo_info]
table=trh_promo_info
data=col0,Time Crash
data=col1,Time has fractured! Rewards and modifiers are falling through time. Use them quickly, as they won't stay for long.
data=col3,12
data=col5,Every 2 hours, the active modifier changes. Make use of them while they last.<br>If you don't like the active modifier, you can reroll a random alternative for Oddments.
data=col9,Promotion Information
data=col10,trh179_promo_info_modifiers

// 6097
[trh184_promo_info]
table=trh_promo_info
data=col0,Rainbow Trail
data=col1,Rainbow Dust, bonuses and multipliers up to x7!
data=col3,5
data=col5,Open the Rainbow Chest to receive a prize with a <col=FF00>multiplier</col> up to <col=FF00>x7</col>!<br><col=FFFF00>Rainbow Dust</col> is earned each time you use a key.<br>Use it to buy additional <col=FFFF00>Rainbow Bonuses</col>!
data=col6,Rainbow Bonus
data=col7,Trigger a <col=FFFF00>Rainbow Bonus</col> on your next key by getting the <col=FFFF00>BONUS</col> modifier to the front of the trail.<br>Choose between a <col=FFFF00>Rainbow Modifier</col> that will increase your upcoming <col=FF00>multipliers</col> or a <col=FFFF00>reward item</col>.
data=col9,Promotion Information
data=col10,trh184_promo_info_rewards
data=col10,trh184_promo_info_modifiers

