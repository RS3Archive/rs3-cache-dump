// 7015
[quest_daughter2_act1_adrasteia_speech]
table=image_sequence
data=col0,47
data=col1,241
data=col3,quest_daughter_adrasteia_speech_frame1,,silence,100,true,false,false,false
data=col3,quest_daughter_adrasteia_speech_frame1,I am soon to be crowned. It is a burden that I do not take lightly.,q4_winterquest_cs1_i_am_soon_01,310,false,false,true,true
data=col3,quest_daughter_adrasteia_speech_frame1,As Basilissa, it is my duty to see that the kingdoms are protected.,q4_winterquest_cs1_as_basilissa,275,false,false,true,true
data=col3,quest_daughter_adrasteia_speech_frame1,Right now, there is one looming threat that haunts me; that threatens us all.,q4_winterquest_cs1_right_now_there_is_one,490,false,false,true,true
data=col3,quest_daughter_adrasteia_speech_frame2,The Civil War is over. Bilrach won.,q4_winterquest_cs1_the_civil_war_is_over,230,false,false,true,true
data=col3,quest_daughter_adrasteia_speech_frame2,The demons, defeated, fell in line and joined the ranks of his army.,q4_winterquest_cs1_the_demons_defeated_01,400,false,false,true,true
data=col3,quest_daughter_adrasteia_speech_frame2,Bilrach is in a position to launch a full-scale invasion.,q4_winterquest_cs1_bilrach_is_in_a_position,245,false,false,true,true
data=col3,quest_daughter_adrasteia_speech_frame2,But it is not enough. The powerful always crave more power.,q4_winterquest_cs1_but_it_is_not_enough,320,false,false,true,true
data=col3,quest_daughter_adrasteia_speech_frame2,He greedily seeks more ways to expand his influence and cement his dominance.,q4_winterquest_cs1_he_greedly_seeks,400,false,false,true,true
data=col3,quest_daughter_adrasteia_speech_frame2,Even now, he gathers his forces and spreads out across the world in search of something.,q4_winterquest_cs1_even_now,400,false,false,true,true
data=col3,quest_daughter_adrasteia_speech_frame2,Lost magic? An artefact?,q4_winterquest_cs1_lost_magic,155,false,false,true,true
data=col3,quest_daughter_adrasteia_speech_frame2,Whatever he is trying to do, it represents a terrible threat to the rest of the world.,q4_winterquest_cs1_whatever_he_is_trying_to_01,315,false,false,true,true
data=col3,quest_daughter_adrasteia_speech_frame1,We must stop him. We must put an end to his reign, before it begins.,q4_winterquest_cs1_we_must_stop,545,false,false,true,true
data=col3,quest_daughter_adrasteia_speech_frame1,,silence,100,false,true,false,false

