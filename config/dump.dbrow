data=col2,<col=0x00ff00>+200%</col> Artisans' Workshop respect.
data=col4,You can spend respect at <col=0x00ffff>Egil</col> in the <col=0x00ffff>Artisan's Workshop</col>.
data=col6,event_bonanza_icon_buff_artisans_workshop_respect_boost

// 13064
[buff_select_event_buff_healing_boost]
table=buff_select_event_buff
data=col0,9
data=col1,High Metabolism
