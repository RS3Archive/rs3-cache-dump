data=col11,true

// 5383
[dbrow_5383]
table=dbtable_72
data=col3,This tab allows you to change the style and colour of your character's hair and facial hair.

// 5384
[dbrow_5384]
table=dbtable_72
data=col3,These buttons can be used to explore the different types of hairstyles and beards.<br><br>Those you have access to will be shown in the area to the right.
data=col5,interface_1311:com_146
data=col6,-1
data=col7,4

// 5385
[dbrow_5385]
table=dbtable_72
data=col3,Selecting a hairstyle or beard will show you how it will appear on your character.
data=col5,interface_1311:com_344
data=col6,-1

// 5386
[dbrow_5386]
table=dbtable_72
data=col3,The <col=FFcb05>apply</col> button will apply the hairstyle or beard to your character.<br><br>If you don't have access to the hairstyle or beard, this button will allow you to <col=FFcb05>buy</col> it.
data=col5,interface_1311:com_474
data=col6,-1

