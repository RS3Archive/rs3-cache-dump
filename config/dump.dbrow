// 4866
[trh32_promo_info]
table=trh_promo_info
data=col0,Smouldering Lamps
data=col1,Get ready to burn up your Bonus XP!
data=col3,1
data=col5,Use Treasure Hunter keys to open chests and win rewards!<br>Treasure Hunter Keys can be purchased or earned through completing quests and playing the game.<br>You will also be given free daily keys every day, but make sure to use them up as they will not carry over.
data=col10,trh_promo_info_smouldering_lamps

// 4867
[trh47_promo_info]
table=trh_promo_info
data=col0,Time to Train
data=col1,It's time for Double XP, and that means it's Time to Train!
data=col3,4
data=col5,Use Treasure Hunter keys to open chests and win rewards! Keys can be purchased or earned through completing quests and playing the game. You will also be given free daily keys every day!
data=col6,NEW Bonus Feature!
data=col7,Earn <col=0xF0BE79>progress</col> with every key you use.<br>Fill the progress bar to trigger the <col=0xF0BE79>Bonus Feature</col>.<br>Choose between <col=0xF0BE79>3</col> sets of dummies. One of your options will always either be the new <col=0xF0BE79>Dungeoneering</col> or <col=0xF0BE79>Archaeology</col> skill training dummies.
data=col10,trh47_promo_info_new_dummies
data=col10,trh_promo_info_skilling_rewards

