// 7244
[dbrow_7244]
table=dbtable_220
data=col1,King Roald Remanis III
data=col2,King of Misthalin
data=col3,He/Him
data=col5,npc_29918
data=col7,5000
data=col11,He is reserved, diplomatic and mild mannered.
data=col11,This can lead to his vassals and the diplomats of other nations walking over him.
data=col15,false

// 7245
[dbrow_7245]
table=dbtable_220
data=col1,Queen Ellamaria
data=col2,Queen of Misthalin
data=col3,She/Her
data=col5,npc_29916
data=col7,5000
data=col11,A former commoner and renowned warrior, she is loud, brash, and dramatic.
data=col11,She lacks the tact required for diplomacy, but is good at getting things done.
data=col15,false

// 7246
[dbrow_7246]
table=dbtable_220
data=col1,Simon Bullace
data=col2,King Roald's Alchemist
data=col3,He/Him
data=col5,npc_29921
data=col6,125
data=col7,5000
data=col11,An alchemist under the service of King Roald.
data=col11,He is highly intelligent but was relegated to being the royal wine tester.
data=col11,He seems to be incredibly bitter about this.
data=col15,false

// 7247
[dbrow_7247]
table=dbtable_220
data=col1,Aster Dunnet
data=col2,Butler
data=col3,They/Them
data=col5,npc_29915
data=col7,5000
data=col11,Aster is my steward and the building manager of my town hall.
data=col11,They are professional, approachable, and a big fan of detective stories and murder mysteries.
data=col15,false

// 7248
[dbrow_7248]
table=dbtable_220
data=col1,Bianca Dunnet
data=col2,Housekeeper
data=col3,She/Her
data=col5,npc_29929
data=col7,6000
data=col9,20
data=col11,Bianca is Aster's sister, and the building manager of my kitchen.
data=col11,She is quiet and soft spoken, but friendly.
data=col11,Her clumsiness often detracts from her impressive cooking skills.
data=col15,false

// 7249
[dbrow_7249]
table=dbtable_220
data=col1,Duke Cole Hoarse
data=col2,Duke of Edgeville
data=col3,He/Him
data=col5,npc_29930
data=col6,85
data=col7,6000
data=col11,He is rude, perpetually grumpy, and generally unpleasant to be around.
data=col11,You'd be hard pressed to find someone who doesn't want him dead.
data=col15,false

// 7250
[dbrow_7250]
table=dbtable_220
data=col1,Rodney Midas
data=col2,Duke Hoarse's Fiance
data=col3,He/Him/They
data=col5,npc_29936
data=col7,5000
data=col11,Rodney is a flamboyant socialite who has had numerous spouses throughout the years.
data=col11,Rodney insists he is marrying the Duke for love.
data=col15,false

// 7251
[dbrow_7251]
table=dbtable_220
data=col1,Princess
data=col2,Duke Hoarse's Dog
data=col3,
data=col5,npc_29941
data=col7,3000
data=col8,-50
data=col11,The Duke's precious spaniel, and possibly the only being besides Rodney to whom he shows any affection.
data=col11,She seems to be a good girl, but is there evil hidden inside?
data=col15,false

// 7252
[dbrow_7252]
table=dbtable_220
data=col1,Iris Ruthven
data=col2,Lumbridge Ambassador
data=col3,She/Her
data=col5,npc_29926
data=col7,5000
data=col11,Duke Horacio's cousin, attending on behalf of the duchy of Lumbridge.
data=col11,A social butterfly with a seeming lack of social awareness, and a proclivity for stirring up drama.
data=col11,While she isn't the sharpest tool in the shed, she has a kind heart.
data=col15,false

// 7253
[dbrow_7253]
table=dbtable_220
data=col1,Duchess Alba Hyett
data=col2,Duchess of Lumford
data=col3,She/Her
data=col5,npc_29939
data=col7,5000
data=col8,50
data=col11,A retired knight, who served King Roald II before being granted the duchy of Lumford for her service.
data=col11,The Duchess is asocial, stoic and holds a grudge against the royal family.
data=col15,false

