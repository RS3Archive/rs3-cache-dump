data=col4,dbrow_8324
data=col11,false

// 8324
[dbrow_8324]
table=dbtable_72
data=col3,This title comes in <col=0x2EF8FF>4</col> different colours: <col=0xD5DCDC>Hero Grey</col>, <col=0x0075B8>Hero Blue</col>, <col=0x823BE4>Hero Purple</col> and <col=0xC61228>Hero Red</col>.<br>You'll earn these throughout the pass, starting with <col=0xD5DCDC>Hero Grey</col> and ending with the most prestigious <col=0xC61228>Hero Red</col>.
data=col5,interface_1227:com_36
data=col6,-1
