// 7028
[quest_daughter2_act3_bilrach_fails]
table=image_sequence
data=col0,48
data=col1,320
data=col3,quest_daughter2_bilrach_fails_frame1,,silence,100,true,false,false,false
data=col3,quest_daughter2_bilrach_fails_frame1,Bilrach didn't think to inspect the marker before his ritual, and it cost him dearly.,q4_winterquest_cs2_bilrach_didnt_think,400,false,false,true,true
data=col3,quest_daughter2_bilrach_fails_frame1,He sought the power he felt was owed to him.,q4_winterquest_cs2_he_sought_the_power,250,false,false,true,true
data=col3,quest_daughter2_bilrach_fails_frame2a,He dreamed of draining souls from across the world, becoming unrivalled in his power.,q4_winterquest_cs2_he_dreamed,400,false,false,true,true
data=col3,quest_daughter2_bilrach_fails_frame2a,In a world without gods, he would rule without opposition.,q4_winterquest_cs2_in_a_world_without,350,false,false,true,true
data=col3,quest_daughter2_bilrach_fails_frame2a,Unrivalled. Untouchable. But it was not to be.,q4_winterquest_cs2_unrivalled_untouchable_01,360,false,false,true,true
data=col3,quest_daughter2_bilrach_fails_frame2b,Your sabotage turned the power Bilrach summoned into the marker against itself.,q4_winterquest_cs2_your_sabotage,300,false,false,true,true
data=col3,quest_daughter2_bilrach_fails_frame2b,Magic surged until the structure could contain it no longer.,q4_winterquest_cs2_magic_surged,300,false,false,true,true
data=col3,quest_daughter2_bilrach_fails_frame3,In a great thunderclap, the marker exploded, shattering across the Wilderness like a bad dream.,q4_winterquest_cs2_in_a_great_thunderclap,600,false,false,true,true
data=col3,quest_daughter2_bilrach_fails_frame3,The power contained returned to the dirt and the soil. The shards of soul it harnessed returned to the underworld to await their afterlife.,q4_winterquest_cs2_the_power_contained,550,false,false,true,true
data=col3,quest_daughter2_bilrach_fails_frame4,Bilrach had failed. His plan ruined. His dreams of glory shattered like the marker.,q4_winterquest_cs2_bilrach_had,450,false,false,true,true
data=col3,quest_daughter2_bilrach_fails_frame4,In one act of sabotage, the world was safe once more. None even knew they'd been at risk.,q4_winterquest_cs2_in_one_act,500,false,false,true,true
data=col3,quest_daughter2_bilrach_fails_frame4,Bilrach's army remained. It was still a threat. Still a terrible danger.,q4_winterquest_cs2_bilrachs_army,500,false,false,true,true
data=col3,quest_daughter2_bilrach_fails_frame4,But the infallibility of his leadership was gone; his authority lost, like his dreams of dominion.,q4_winterquest_cs2_but_the_infallibility,500,false,false,true,true
data=col3,quest_daughter2_bilrach_fails_frame4,,silence,150,false,true,false,false

