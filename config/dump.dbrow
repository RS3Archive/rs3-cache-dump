data=col1,Soul Catcher
data=col2,<col=0x00ff00>+200% chance</col> to catch Slayer monsters using <col=0x00ffff>Ushabti</col>.
data=col4,You can use <col=0x00ffff>Ushabti</col> to catch Slayer monsters and add them to your <col=0x00ffff>personal Slayer dungeon near Menaphos</col>.
data=col4,You can buy <col=0x00ffff>Ushabti</col> from most <col=0x00ffff>Slayer masters</col>.
data=col6,event_bonanza_icon_buff_ushabti_catch_boost

