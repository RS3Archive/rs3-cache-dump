// 4659
[egwd_ful_opening_cutscene]
table=image_sequence
data=col0,38
data=col1,30
data=col3,black_placeholder,I am Zuk.,egwd_cutscene_vo_ful_zuk_i_am_zuk_alt2,200,false,false,true,true
data=col3,black_placeholder,I have been a chieftain, a gladiator, a warlord, a demigod.,egwd_cutscene_vo_ful_zuk_i_have_been_a_chieftain_alt1,400,false,false,true,true
data=col3,egwd_tzekhaar_front_cutscene_01,I was born into a world where all were free. Then, the Empire came.,egwd_cutscene_vo_ful_zuk_i_was_born_into_a_world,350,false,false,true,true
data=col3,egwd_tzekhaar_front_cutscene_01,Conquered my people. Threw me into the pits. I was to die there.,egwd_cutscene_vo_ful_zuk_conquered_my_people_alt2,350,false,false,true,true
data=col3,egwd_tzekhaar_front_cutscene_01,Nothing could challenge me. Demons, dragons and vampyres fell to my blade.,egwd_cutscene_vo_ful_zuk_nothing_could_challenge_me,390,false,false,true,true
data=col3,egwd_tzekhaar_front_cutscene_01,From the great Tribune Torva, I won back my freedom.,egwd_cutscene_vo_ful_zuk_from_the_great_tribune_torva,350,false,true,true,true
data=col3,egwd_tzekhaar_front_cutscene_02,I went in search of worthier foes.,egwd_cutscene_vo_i_went_in_search_of_worthier_foes_alt3,220,true,false,true,true
data=col3,egwd_tzekhaar_front_cutscene_02,Beneath a distant volcano, I found the ultimate arena.,egwd_cutscene_vo_ful_zuk_beneath_a_distant_volcano_alt1,280,false,false,true,true
data=col3,egwd_tzekhaar_front_cutscene_02,The TokHaar - who shaped the mountains at the dawn of time - battled endlessly.,egwd_cutscene_vo_ful_zuk_the_tokhaar_who_shaped_alt4,380,false,false,true,true
data=col3,egwd_tzekhaar_front_cutscene_02,They fell all the same.,egwd_cutscene_vo_ful_zuk_they_fell_all_the_same_alt4,290,false,true,true,true
data=col3,egwd_tzekhaar_front_cutscene_03,They called me TzKal - Champion of the Fire. The first outsider to defeat them all.,egwd_cutscene_vo_ful_zuk_they_called_me_tzkal,420,true,false,true,true
data=col3,egwd_tzekhaar_front_cutscene_03,For my prize, I claimed the Elder Kiln itself.,egwd_cutscene_vo_ful_zuk_for_my_prize_alt2,350,false,false,true,true
data=col3,egwd_tzekhaar_front_cutscene_03,For centuries it changed me. I became undying.,egwd_cutscene_vo_ful_zuk_for_centuries_it_changed_alt1,345,false,false,true,true
data=col3,egwd_tzekhaar_front_cutscene_03,Like TokHaar, I am born again within the Kiln. Unlike TokHaar, my mind is my own.,egwd_cutscene_vo_ful_zuk_like_tokhaar_i_am_alt3,540,false,true,true,true
data=col3,egwd_tzekhaar_front_cutscene_04,The God Wars called to me. The TokHaar would not follow, but the lava beasts would.,egwd_cutscene_vo_ful_zuk_the_god_wars_called_alt2,350,true,false,true,true
data=col3,egwd_tzekhaar_front_cutscene_04,We carved through the weak surface dwellers effortlessly. It was only Bandos himself who stopped me.,egwd_cutscene_vo_ful_zuk_we_carved_through_the_weak_alt1,410,false,false,true,true
data=col3,egwd_tzekhaar_front_cutscene_04,Coward. He chained me within the Kiln.,egwd_cutscene_vo_ful_zuk_coward_he_chained_me_alt1,320,false,true,true,true
data=col3,egwd_tzekhaar_front_cutscene_05,When Ful needed an army, she had no use for the failed TokHaar.,egwd_cutscene_vo_ful_zuk_when_ful_needed,315,true,false,true,true
data=col3,egwd_tzekhaar_front_cutscene_05,They were remade. Artisans reforged into soldiers.,egwd_cutscene_vo_ful_zuk_they_were_remade,320,false,false,true,true
data=col3,egwd_tzekhaar_front_cutscene_05,Now they are the TzekHaar, united in purpose.,egwd_cutscene_vo_ful_zuk_now_they_are_the_tzekhaar_alt7,280,false,false,true,true
data=col3,egwd_tzekhaar_front_cutscene_05,They serve without question. Mine to command.,egwd_cutscene_vo_ful_zuk_they_serve_without_question_alt1,320,false,true,true,true
data=col3,egwd_tzekhaar_front_cutscene_06,Ful wants the eggs, but I pay no heed to her desires.,egwd_cutscene_vo_ful_zuk_ful_wants_the_eggs_alt1,320,true,false,true,true
data=col3,egwd_tzekhaar_front_cutscene_06,I seek only the glory of combat. Is anyone in this alliance worthy?,egwd_cutscene_vo_ful_zuk_i_seek_only_the_glory_alt3,370,false,false,true,true
data=col3,egwd_tzekhaar_front_cutscene_06,Refuse me, and your world will end.,egwd_cutscene_vo_ful_zuk_refuse_me_and_your_world,350,false,true,true,true

