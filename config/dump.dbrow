// 4659
[dbrow_4659]
table=dbtable_40
data=col0,38
data=col1,30
data=col3,black_placeholder,I am Zuk.,sound_51884,200,false,false,true,true
data=col3,black_placeholder,I have been a chieftain, a gladiator, a warlord, a demigod.,sound_51885,400,false,false,true,true
data=col3,egwd_tzekhaar_front_cutscene_01,I was born into a world where all were free. Then, the Empire came.,sound_51887,350,false,false,true,true
data=col3,egwd_tzekhaar_front_cutscene_01,Conquered my people. Threw me into the pits. I was to die there.,sound_51878,350,false,false,true,true
data=col3,egwd_tzekhaar_front_cutscene_01,Nothing could challenge me. Demons, dragons and vampyres fell to my blade.,sound_51889,390,false,false,true,true
data=col3,egwd_tzekhaar_front_cutscene_01,From the great Tribune Torva, I won back my freedom.,sound_51882,350,false,true,true,true
data=col3,egwd_tzekhaar_front_cutscene_02,I went in search of worthier foes.,sound_51900,220,true,false,true,true
data=col3,egwd_tzekhaar_front_cutscene_02,Beneath a distant volcano, I found the ultimate arena.,sound_51877,280,false,false,true,true
data=col3,egwd_tzekhaar_front_cutscene_02,The TokHaar - who shaped the mountains at the dawn of time - battled endlessly.,sound_51893,380,false,false,true,true
data=col3,egwd_tzekhaar_front_cutscene_02,They fell all the same.,sound_51895,290,false,true,true,true
data=col3,egwd_tzekhaar_front_cutscene_03,They called me TzKal - Champion of the Fire. The first outsider to defeat them all.,sound_51894,420,true,false,true,true
data=col3,egwd_tzekhaar_front_cutscene_03,For my prize, I claimed the Elder Kiln itself.,sound_51881,350,false,false,true,true
data=col3,egwd_tzekhaar_front_cutscene_03,For centuries it changed me. I became undying.,sound_51880,345,false,false,true,true
data=col3,egwd_tzekhaar_front_cutscene_03,Like TokHaar, I am born again within the Kiln. Unlike TokHaar, my mind is my own.,sound_51888,540,false,true,true,true
data=col3,egwd_tzekhaar_front_cutscene_04,The God Wars called to me. The TokHaar would not follow, but the lava beasts would.,sound_51892,350,true,false,true,true
data=col3,egwd_tzekhaar_front_cutscene_04,We carved through the weak surface dwellers effortlessly. It was only Bandos himself who stopped me.,sound_51898,410,false,false,true,true
data=col3,egwd_tzekhaar_front_cutscene_04,Coward. He chained me within the Kiln.,sound_51879,320,false,true,true,true
data=col3,egwd_tzekhaar_front_cutscene_05,When Ful needed an army, she had no use for the failed TokHaar.,sound_51899,315,true,false,true,true
data=col3,egwd_tzekhaar_front_cutscene_05,They were remade. Artisans reforged into soldiers.,sound_51897,320,false,false,true,true
data=col3,egwd_tzekhaar_front_cutscene_05,Now they are the TzekHaar, united in purpose.,sound_51890,280,false,false,true,true
data=col3,egwd_tzekhaar_front_cutscene_05,They serve without question. Mine to command.,sound_51896,320,false,true,true,true
data=col3,egwd_tzekhaar_front_cutscene_06,Ful wants the eggs, but I pay no heed to her desires.,sound_51883,320,true,false,true,true
data=col3,egwd_tzekhaar_front_cutscene_06,I seek only the glory of combat. Is anyone in this alliance worthy?,sound_51886,370,false,false,true,true
data=col3,egwd_tzekhaar_front_cutscene_06,Refuse me, and your world will end.,sound_51891,350,false,true,true,true

