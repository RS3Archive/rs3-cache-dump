data=col11,true

// 5393
[dbrow_5393]
table=dbtable_72
data=col3,Legendary pets are a special type of pet.

// 5394
[dbrow_5394]
table=dbtable_72
data=col3,They have 3 different growth states.<br><br>Pets grow over time or by being fed special food available from Solomon's General Store.
data=col5,interface_1311:com_562
data=col6,-1

// 5395
[dbrow_5395]
table=dbtable_72
data=col3,They have abilities that are unlocked as they grow.
