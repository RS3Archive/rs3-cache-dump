// 6549
[quest_daughter_adrasteia_speech]
table=image_sequence
data=col0,46
data=col1,241
data=col3,quest_daughter_adrasteia_speech_frame1,,silence,100,true,false,false,false
data=col3,quest_daughter_adrasteia_speech_frame1,Everything changed when the gods were banished from this world.,doc_quest_vo_cs_adra_01_alt2,200,false,false,true,true
data=col3,quest_daughter_adrasteia_speech_frame1,As Basilissa, it is my responsibility to safeguard the human kingdoms and maintain their alliance.,doc_quest_vo_cs_adra_02_alt3,400,false,false,true,true
data=col3,quest_daughter_adrasteia_speech_frame1,But our unity is already under threat.,doc_quest_vo_cs_adra_03_alt3,200,false,false,true,true
data=col3,quest_daughter_adrasteia_speech_frame2,Without a clear leader, the Zamorakians have descended into civil war.,doc_quest_vo_cs_adra_04_alt3,250,false,false,true,true
data=col3,quest_daughter_adrasteia_speech_frame2,Even as we speak, they battle for control of the Wilderness.,doc_quest_vo_cs_adra_05_alt3,250,false,false,true,true
data=col3,quest_daughter_adrasteia_speech_frame2,Better that they're killing each other than our people, but the conflict isn't contained.,doc_quest_vo_cs_adra_06_alt3,300,false,false,true,true
data=col3,quest_daughter_adrasteia_speech_frame2,A Mahjarrat lieutenant has been slaughtering Varrock's patrols near the border.,doc_quest_vo_cs_adra_07_alt1,250,false,false,true,true
data=col3,quest_daughter_adrasteia_speech_frame3,Moia.,doc_quest_vo_cs_adra_08_alt1,90,false,false,true,true
data=col3,quest_daughter_adrasteia_speech_frame3,Though she serves Bilrach, I believe she poses the bigger threat.,doc_quest_vo_cs_adra_09_alt1,250,false,false,true,true
data=col3,quest_daughter_adrasteia_speech_frame3,We must prove to the kingdoms that I can protect them.,doc_quest_vo_cs_adra_10_alt1,200,false,false,true,true
data=col3,quest_daughter_adrasteia_speech_frame3,Travel into the Wilderness, find Moia, and stop her.,doc_quest_vo_cs_adra_11,250,false,false,true,true
data=col3,quest_daughter_adrasteia_speech_frame3,,silence,200,false,true,false,false

