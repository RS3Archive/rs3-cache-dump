// 6207
[egwd_zamorak_boss_pre_release_world_voice]
table=audio_sequence
data=col0,1
data=col3,human_update_chathead_angry_extreme_len1,<col=E80404>Zamorak: </col>,Zamorak,egwd_cathedral_zamorak_vis,Hear me, citizens of Gielinor. I am Zamorak - rightful ruler of this world.,egwd_zamboss_prerelease_vo_zam_01,400,true,true
data=col3,human_update_chathead_angry_extreme_len1,<col=E80404>Zamorak: </col>,Zamorak,egwd_cathedral_zamorak_vis,Take heed, and hear me with an open mind and a stalwart heart.,egwd_zamboss_prerelease_vo_zam_02,400,true,true
data=col3,human_update_chathead_angry_extreme_len1,<col=E80404>Zamorak: </col>,Zamorak,egwd_cathedral_zamorak_vis,Your whole lives, you have been told to forgo your needs and ambitions. That you must serve the 'greater good'.,egwd_zamboss_prerelease_vo_zam_03,480,true,true
data=col3,human_update_chathead_angry_extreme_len1,<col=E80404>Zamorak: </col>,Zamorak,egwd_cathedral_zamorak_vis,This is a lie. The last stand of false gods, who fear what you might become. ,egwd_zamboss_prerelease_vo_zam_04,400,true,true
data=col3,human_update_chathead_angry_extreme_len1,<col=E80404>Zamorak: </col>,Zamorak,egwd_cathedral_zamorak_vis,I offer you more. A world where strength and ingenuity are rewarded. Where you are master of your own destiny.,egwd_zamboss_prerelease_vo_zam_05,490,true,true
data=col3,human_update_chathead_angry_extreme_len1,<col=E80404>Zamorak: </col>,Zamorak,egwd_cathedral_zamorak_vis,We are coming. My forces will tear down the old world, and from the ashes shall arise something glorious. ,egwd_zamboss_prerelease_vo_zam_06,470,true,true
data=col3,human_update_chathead_angry_extreme_len1,<col=E80404>Zamorak: </col>,Zamorak,egwd_cathedral_zamorak_vis,Join me. Build a world without limits. And cast aside any who stand in your way. ,egwd_zamboss_prerelease_vo_zam_07,420,true,true
data=col3,human_update_chathead_angry_extreme_len1,<col=E80404>Zamorak: </col>,Zamorak,egwd_cathedral_zamorak_vis,As for you, World Guardian... Your attempts to thwart our plans are futile.,egwd_zamboss_prerelease_vo_zam_08,370,true,true
data=col3,human_update_chathead_angry_extreme_len1,<col=E80404>Zamorak: </col>,Zamorak,egwd_cathedral_zamorak_vis,You are unworthy. Interfere further, and yours will be the swift death of a diseased cur.,egwd_zamboss_prerelease_vo_zam_09,420,true,true
data=col3,human_update_chathead_angry_extreme_len1,<col=E80404>Zamorak: </col>,Zamorak,egwd_cathedral_zamorak_vis,Stay cowering behind Guthix's crumbling wards. Rot with the decrepit world you claim to defend.,egwd_zamboss_prerelease_vo_zam_010,450,true,true
data=col3,human_update_chathead_angry_extreme_len1,<col=E80404>Zamorak: </col>,Zamorak,egwd_cathedral_zamorak_vis,This world will burn.,egwd_zamboss_prerelease_vo_zam_010_v2,120,true,true

