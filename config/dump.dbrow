[trh193_promo_info]
table=trh_promo_info
data=col0,Christmas Trail
data=col1,Collect Curios for modified multipliers!
data=col3,5
data=col5,Open chests to receive a prize with a <col=FF00>multiplier</col> up to <col=FF00>x8</col>!<br>Your upcoming multipliers can be seen moving down the Christmas Trail.
data=col6,Curio Bonus
data=col7,Gather <col=FFFF00>Curios</col> by opening chests.<br>Spend the <col=FFFF00>Curios</col> for a choice of <col=FF00>Curio Bonuses</col>.<br>You will always have a choice of an <col=FF00>Increased Multiplier</col> bonus and a <col=FF00>Minimum Multiplier</col> bonus while not having all maximum multipliers (x8).
data=col9,Promotion Information
data=col10,trh_promo_info_promo_prizes_trh193
data=col10,trh193_promo_info_currency
data=col10,trh193_promo_info_bonuses

