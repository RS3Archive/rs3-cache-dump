// 6108
[trh180_easter24_basket_options]
table=modal_p_choice_details
data=col1,1,true,Overview,Pluck a flower from the basket and receive a collection of farming items!<br><br>Taking a flower uses one charge from the basket.<br><br><col=FFFFFF>Seed-filled Sanguinaria:</col> Pick this flower to receive a random selection of seeds!<br><br><col=FFFFFF>Honey-glazed Hibiscus:</col> Pick this flower to receive a random selection of honeycombs!<br><br><col=FFFFFF>Mushy Magnolia:</col> Pick this flower to receive some of each type of mush!
data=col1,2,false,Seed-filled Sanguinaria,<br>Receive a <col=FFFFFF>random selection</col> of the following seeds:<br>
data=col1,3,false,Honey-glazed Hibiscus,<br>Receive a <col=FFFFFF>random selection</col> of the following honeycombs:<br><br> - Delicious honeycomb<br> - Dense honeycomb<br> - Medicinal honeycomb<br> - Runny honeycomb<br> - Sweet honeycomb<br> - Fertile honeycomb<br> - Candied honeycomb<br> - Nutritious honeycomb<br> - Moreish honeycomb
data=col1,4,false,Mushy Magnolia,<br>Receive <col=FFFFFF>500</col> of the following types of mush:<br><br> - Seedy mush<br> - Veggie mush<br> - Fruity mush<br> - Flowery mush<br> - Mushy mush<br> - Meaty mush<br> - Fishy mush<br> - Variety mush<br> - Buggy mush

