data=col11,true

// 5368
[dbrow_5368]
table=dbtable_72
data=col3,The Adventures interface contains details of RuneScape's different quests, challenges and minigames.<br><br>The <col=FFcb05>Featured</col> tab shows a selection of content suitable for your level.

// 5369
[dbrow_5369]
table=dbtable_72
data=col3,If you like the look of one of the recommendations, simply select it to get started.
data=col5,interface_1345:com_5
data=col6,-1

