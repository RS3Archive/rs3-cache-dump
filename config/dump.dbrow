// 7230
[dbrow_7230]
table=dbtable_220
data=col0,9
data=col1,Assassin's Letter
data=col4,obj_54580
data=col10,It's stained with blood, but still legible.
data=col12,Found on the body of the assassin who ambushed me and Aster at the top of the townhall.

// 7231
[dbrow_7231]
table=dbtable_220
data=col0,10
data=col1,Strange Seal
data=col4,obj_54577
data=col10,A grey wax seal with a black ribbon. When I hold it against light, it casts a peculiar silhouette.
data=col12,I found this behind the chapel.
data=col13,dbrow_7232

// 7232
[dbrow_7232]
table=dbtable_220
data=col0,11
data=col1,Amulet of Spanielspeak
data=col4,obj_54578
data=col10,An amulet that allows the wearer to talk to spaniels. How strangely specific.
data=col12,Iris gave this amulet to me after I showed her the strange seal.
data=col13,dbrow_7233

// 7233
[dbrow_7233]
table=dbtable_220
data=col0,13
data=col1,Mysterious Letter
data=col4,obj_54580
data=col10,A mysterious letter signed by '-Z', and stamped with a wax Zamorakian sigil.
data=col12,Princess found a cache containing this letter after I talked to her using an Amulet of Spanielspeak.
data=col14,true

// 7234
[dbrow_7234]
table=dbtable_220
data=col0,12
data=col1,Scorched Will
data=col4,obj_54579
data=col10,You can just about make out the letter 'P' in various locations, as well as Duke Hoarse's signature.
data=col12,I found this partially burnt will near the fireplace of my town hall.
data=col13,dbrow_7236

// 7235
[dbrow_7235]
table=dbtable_220
data=col0,14
data=col1,Duchess Alba's Testimony (II)
data=col4,obj_54575
data=col10,Duchess Alba spoke about the death of her son.
data=col12,I asked Duchess Alba about her distaste for the Remanis family.
data=col16,true

// 7236
[dbrow_7236]
table=dbtable_220
data=col0,16
data=col1,Rodney's Testimony
data=col4,obj_54574
data=col10,Rodney admitted that he burned the will in my town hall's fireplace.
data=col12,I showed Rodney the scorched will.
data=col14,true
data=col16,true

// 7237
[dbrow_7237]
table=dbtable_220
data=col0,15
data=col1,Ellamaria's Testimony
data=col4,obj_54571
data=col10,Ellamaria claims that Bianca was a friend of hers before she became queen, but their friendship fell apart.
data=col12,I asked Ellamaria about her history with Bianca.
data=col16,true

