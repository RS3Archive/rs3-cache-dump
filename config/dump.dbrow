// 2111
[dbrow_2111]
table=dbtable_72
data=col3,When built up, adrenaline can be spent on powerful attacks called abilities.

// 2112
[dbrow_2112]
table=dbtable_72
data=col3,When built up, adrenaline can be spent on powerful attacks called abilities.

// 2113
[dbrow_2113]
table=dbtable_72
data=col3,Threshold abilities require 50% adrenaline to activate and spend 15% adrenaline when activated.<br><br>Ultimate abilities require and spend 100% adrenaline.

// 2114
[dbrow_2114]
table=dbtable_72
data=col3,Thresholds abilities require 50% adrenaline to activate and spend 15% adrenaline when activated.<br><br>Ultimate abilities require and spend 100% adrenaline.

