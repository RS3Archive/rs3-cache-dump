[buff_select_event_buff_ritual_output_boost]
table=buff_select_event_buff
data=col0,5
data=col1,Ritualistic
data=col2,<col=0x00ff00>+50%</col> Necromancy ritual output.
data=col4,To perform rituals, you need to have completed the <col=0x00ffff>Necromancy! quest</col>.
data=col6,event_bonanza_icon_buff_ritual_output_boost

