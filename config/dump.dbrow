// 1843
[dino_island_2d_opening_cutscene]
table=image_sequence
data=col0,9
data=col1,221
data=col3,dino_cutscene_approach_01,The dragon told me the voyage would be treacherous<br>but I have never seen a storm like this one.,area_dino_vo_lani_cutscene_01,400,true,true,true,true
data=col3,dino_cutscene_approach_02,The sea is primordial. It is ancient, and vast, like a thing from another time.<br>The sky is angry. I can feel it.,area_dino_vo_lani_cutscene_02,450,true,false,true,false
data=col3,dino_cutscene_approach_03,The sea is primordial. It is ancient, and vast, like a thing from another time.<br>The sky is angry. I can feel it.,silence,10,false,false,false,false
data=col3,dino_cutscene_approach_02,The sea is primordial. It is ancient, and vast, like a thing from another time.<br>The sky is angry. I can feel it.,silence,10,false,false,false,false
data=col3,dino_cutscene_approach_03,The sea is primordial. It is ancient, and vast, like a thing from another time.<br>The sky is angry. I can feel it.,silence,5,false,false,false,false
data=col3,dino_cutscene_approach_02,The sea is primordial. It is ancient, and vast, like a thing from another time.<br>The sky is angry. I can feel it.,silence,20,false,false,false,false
data=col3,dino_cutscene_approach_03,The sea is primordial. It is ancient, and vast, like a thing from another time.<br>The sky is angry. I can feel it.,silence,5,false,false,false,false
data=col3,dino_cutscene_approach_02,The sea is primordial. It is ancient, and vast, like a thing from another time.<br>The sky is angry. I can feel it.,silence,60,false,false,false,true
data=col3,dino_cutscene_approach_02,If not for the Stormbreaker's powerful magical wards, we would be torn apart.,area_dino_vo_lani_cutscene_03,360,false,true,true,true
data=col3,dino_cutscene_approach_04,From the deck I hear the island calling to me.,area_dino_vo_lani_cutscene_04,300,true,true,true,true
data=col3,dino_cutscene_approach_05,'Turn back. Turn back. I do not want to be found.<br>I should not be found. Turn back.',area_dino_vo_lani_cutscene_05,25,true,false,true,false
data=col3,dino_cutscene_approach_05_lightning,'Turn back. Turn back. I do not want to be found.<br>I should not be found. Turn back.',silence,2,false,false,false,false
data=col3,dino_cutscene_approach_05,'Turn back. Turn back. I do not want to be found.<br>I should not be found. Turn back.',silence,10,false,false,false,false
data=col3,dino_cutscene_approach_05_lightning,'Turn back. Turn back. I do not want to be found.<br>I should not be found. Turn back.',silence,6,false,false,false,false
data=col3,dino_cutscene_approach_05,'Turn back. Turn back. I do not want to be found.<br>I should not be found. Turn back.',silence,250,false,false,false,false
data=col3,dino_cutscene_approach_05_lightning,'Turn back. Turn back. I do not want to be found.<br>I should not be found. Turn back.',silence,6,false,false,false,false
data=col3,dino_cutscene_approach_05,'Turn back. Turn back. I do not want to be found.<br>I should not be found. Turn back.',silence,28,false,false,false,false
data=col3,dino_cutscene_approach_05_lightning,'Turn back. Turn back. I do not want to be found.<br>I should not be found. Turn back.',silence,4,false,false,false,false
data=col3,dino_cutscene_approach_05,'Turn back. Turn back. I do not want to be found.<br>I should not be found. Turn back.',silence,8,false,false,false,false
data=col3,dino_cutscene_approach_05_lightning,'Turn back. Turn back. I do not want to be found.<br>I should not be found. Turn back.',silence,4,false,false,false,false
data=col3,dino_cutscene_approach_05,'Turn back. Turn back. I do not want to be found.<br>I should not be found. Turn back.',silence,120,false,true,false,true
data=col3,dino_cutscene_approach_06,This must truly be the very end of the world.<br>Cut off from everything.,area_dino_vo_lani_cutscene_06,400,true,true,true,true
data=col3,dino_cutscene_approach_07,The sort of place I have been seeking all my life.,area_dino_vo_lani_cutscene_07,270,true,true,true,true
data=col3,dino_cutscene_approach_08,A place of solace.,area_dino_vo_lani_cutscene_08,250,true,true,true,true
data=col3,dino_cutscene_approach_09,I think the storm is finally breaking.,area_dino_vo_lani_cutscene_09,280,true,true,true,true
data=col3,dino_cutscene_approach_10,At last we can catch a glimpse of this barren rock...,area_dino_vo_lani_cutscene_10,400,true,true,true,true
