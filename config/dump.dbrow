// 3130
[arch_everlight_opening_cutscene]
table=image_sequence
data=col0,12
data=col1,30
data=col3,arch_cutscene_everlight_01,The monolith has given me information on the icyene structure known as Everlight,<br>a lighthouse on Morytania's east coast.,arch_opening_cutscene_everlight_01,500,true,false,true,true
data=col3,arch_cutscene_everlight_01,More than just a lighthouse, though,<br>it served as a beacon of hope for the icyene race, newly migrated to Gielinor.,arch_opening_cutscene_everlight_02,450,false,true,true,true
data=col3,arch_cutscene_everlight_02a,But what could power such a beacon, to shine<br>so brightly day and night across the surrounding 'Hallowed' lands?,arch_opening_cutscene_everlight_03,400,true,false,true,true
data=col3,arch_cutscene_everlight_02a,And what opposing force of darkness could have snuffed out the Everlight<br>and sunk it beneath the waves?,arch_opening_cutscene_everlight_04,450,false,true,true,true

// 3131
[arch_everlight_closing_cutscene]
table=image_sequence
data=col0,13
data=col1,30
data=col3,arch_cutscene_everlight_01,The sacking of Everlight was an atrocity, to be sure, but it was just a place, a thing.,arch_closing_cutscene_everlight_01,500,true,false,true,true
data=col3,arch_cutscene_everlight_01,The loss of not only many icyene people, but also their way of life, was the true tragedy here.,arch_closing_cutscene_everlight_02,400,false,true,true,true
data=col3,arch_cutscene_everlight_02b,Lord Drakan and his vampyres took such offence at this beacon<br>that they could not abide its existence.,arch_closing_cutscene_everlight_03,450,true,false,true,true
data=col3,arch_cutscene_everlight_02b,Yet the surviving icyene, to this day, carry Everlight's<br>warmth and hope within them, an example to us all.,arch_closing_cutscene_everlight_04,500,false,true,true,true

