data=col3,You can break out of a stun with the <col=FFCB05>Freedom</col> ability.<br>You can protect yourself from being stunned with the <col=FFCB05>Anticipation</col> ability.<br>You can find these in your <col=FFCB05>Defence Abilities</col> book.
data=col12,1
data=col16,"aif_attrib_defence_icons_1,1"
data=col17,"aif_attrib_defence_icons_1,0"
data=col21,interface_1430:com_72,-1

// 1966
[dbrow_1966]
table=dbtable_72
data=col3,You can break out of a stun with the <col=FFCB05>Freedom</col> ability.<br>You can protect yourself from being stunned with the <col=FFCB05>Anticipation</col> ability.<br>You can find these in your <col=FFCB05>Defence Abilities</col> book.
data=col12,1
data=col16,"aif_attrib_defence_icons_1,1"
data=col17,"aif_attrib_defence_icons_1,0"
data=col21,interface_1924:com_93,-1

// 1967
[dbrow_1967]
table=dbtable_72
data=col3,Dummy text - Player should not see.
data=col12,1

// 1968
[dbrow_1968]
table=dbtable_72
data=col3,A stun ability has been placed on your action bar.<br>Attack Lady Deathknell and use the ability.
data=col9,1
data=col12,1

// 1969
[dbrow_1969]
table=dbtable_72
data=col3,Damage-over-time abilities damage your opponent multiple times over a short period.<br>Once the initial attack is performed, you can carry on attacking while the rest of the damage is dealt.<br>The <col=FFCB05>Freedom</col> ability will remove damage-over-time effects on you.
data=col12,1

// 1970
[dbrow_1970]
