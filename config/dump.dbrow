// 3628
[event_crafting_tutorial_2]
table=event_crafting_tutorial
data=col0,2
data=col1,event_crafting_tutorial_2
data=col2,You can only work on one recipe at a time. If you swap to a new recipe any deposited ingredients will be refunded.

// 3629
[event_crafting_tutorial_3]
table=event_crafting_tutorial
data=col0,3
data=col1,event_crafting_tutorial_3
data=col2,Crafting items will level up the Master Artisan. As they level up, their skills improve. This unlocks new recipes!

// 3630
