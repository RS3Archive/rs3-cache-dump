data=col11,true

// 7783
[dbrow_7783]
table=dbtable_72
data=col3,The <col=FFCB05>Rasial, the First Necromancer</col> boss encounter can now be accessed.<br><br>Speak to <col=FFCB05>Kharen</col> to travel to <col=FFCB05>Rasial's citadel</col>.
data=col16,rs3_icon_worldmap_demon_raid_site

