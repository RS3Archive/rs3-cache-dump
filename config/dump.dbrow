// 7127
[quest_fort_intro_kings_speech]
table=image_sequence
data=col0,49
data=col1,250
data=col3,quest_fort_intro_speech_frame1,A threat looms over the three Saradominist kingdoms.,player_fort_vo_cs_roa_01,203,false,false,true,true
data=col3,quest_fort_intro_speech_frame1,We have suffered through famine and war. We need time to recover and rebuild.,player_fort_vo_cs_roa_02,365,false,false,true,true
data=col3,quest_fort_intro_speech_frame1,But in the Wilderness beyond the northern border, Zamorakian forces ready for the attack.,player_fort_vo_cs_roa_03,303,false,true,true,true
data=col3,quest_fort_intro_speech_frame2,The Kingdom of Misthalin stands at the forefront. The other kingdoms can offer little aid.,player_fort_vo_cs_roa_04,367,true,false,true,true
data=col3,quest_fort_intro_speech_frame2,We are not prepared to fight another war. Even the city of Varrock is vulnerable.,player_fort_vo_cs_roa_05,310,false,false,true,true
data=col3,quest_fort_intro_speech_frame2,We must do what we can to protect the undefended lands to the south.,player_fort_vo_cs_roa_06,267,false,true,true,true
data=col3,quest_fort_intro_speech_frame3,In the near Wilderness is a site of strategic importance, a vale that has seen countless battles..,player_fort_vo_cs_roa_07,347,true,false,true,true
data=col3,quest_fort_intro_speech_frame3,Claim this place. Establish a fortification there and be ready for the retaliation when it comes.,player_fort_vo_cs_roa_08,371,false,false,true,true
data=col3,quest_fort_intro_speech_frame3,Do this, and we will declare your domain a new duchy of the Kingdom. You will rule over it in our name as a peer of the realm.,player_fort_vo_cs_roa_09,503,false,false,true,true

