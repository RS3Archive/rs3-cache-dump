table=dbtable_40
data=col0,46
data=col1,241
data=col3,quest_daughter_adrasteia_speech_frame1,,sound_2901,100,true,false,false,false
data=col3,quest_daughter_adrasteia_speech_frame1,Everything changed when the gods were banished from this world.,sound_55380,200,false,false,true,true
data=col3,quest_daughter_adrasteia_speech_frame1,As Basilissa, it is my responsibility to safeguard the human kingdoms and maintain their alliance.,sound_55381,400,false,false,true,true
data=col3,quest_daughter_adrasteia_speech_frame1,But our unity is already under threat.,sound_55382,200,false,false,true,true
data=col3,quest_daughter_adrasteia_speech_frame2,Without a clear leader, the Zamorakians have descended into civil war.,sound_55383,250,false,false,true,true
data=col3,quest_daughter_adrasteia_speech_frame2,Even as we speak, they battle for control of the Wilderness.,sound_55384,250,false,false,true,true
data=col3,quest_daughter_adrasteia_speech_frame2,Better that they're killing each other than our people, but the conflict isn't contained.,sound_55385,300,false,false,true,true
data=col3,quest_daughter_adrasteia_speech_frame2,A Mahjarrat lieutenant has been slaughtering Varrock's patrols near the border.,sound_55386,250,false,false,true,true
data=col3,quest_daughter_adrasteia_speech_frame3,Moia.,sound_55387,90,false,false,true,true
data=col3,quest_daughter_adrasteia_speech_frame3,Though she serves Bilrach, I believe she poses the bigger threat.,sound_55388,250,false,false,true,true
data=col3,quest_daughter_adrasteia_speech_frame3,We must prove to the kingdoms that I can protect them.,sound_55389,200,false,false,true,true
data=col3,quest_daughter_adrasteia_speech_frame3,Travel into the Wilderness, find Moia, and stop her.,sound_55390,250,false,false,true,true
data=col3,quest_daughter_adrasteia_speech_frame3,,sound_2901,200,false,true,false,false

