data=col8,5
data=col9,1
data=col11,true

// 5411
[dbrow_5411]
table=dbtable_72
data=col3,This is the Summary screen. It contains a list of all your offers. You can make several offers simultaneously, one in each box.

// 5412
[dbrow_5412]
table=dbtable_72
data=col3,An empty offer will have two buttons. The left button is to search for an item to buy, the right button is to sell something from your Backpack.
data=col5,interface_105:com_7
data=col6,-1
data=col7,4
data=col16,"grand_exchange_buy_sell_icon,2"
data=col17,"grand_exchange_buy_sell_icon,0"

// 5413
[dbrow_5413]
table=dbtable_72
data=col3,Selecting the Buy icon will bring up a search bar. Enter the name of an item you wish to buy, and select it from the list.<br><br>The price will default to the current market price, but you can adjust how much you wish to pay.
data=col16,"grand_exchange_buy_sell_icon,2"

// 5414
[dbrow_5414]
table=dbtable_72
data=col3,Selecting the Sell icon will bring up the Offer menu. You can select an item to sell from your Backpack.<br><br>The price will default to the current market price, but you can adjust how much you wish to sell for.
data=col17,"grand_exchange_buy_sell_icon,0"

// 5415
[dbrow_5415]
