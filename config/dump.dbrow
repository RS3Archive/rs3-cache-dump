// 4376
[egwd_jas_opening_cutscene]
table=image_sequence
data=col0,35
data=col1,30
data=col3,egwd_nodon_front_cutscene_01,My home, my civilisation, destroyed.,nod_front_kerapac_cutscene_vo_my_home_my_civilisation,350,false,false,true,true
data=col3,egwd_nodon_front_cutscene_01,My people, cursed, bound, in pain. United in our suffering.,nod_front_kerapac_cutscene_vo_my_people_cursed_bound_in_pain,440,false,false,true,true
data=col3,egwd_nodon_front_cutscene_01,I could not imagine a worse fate.,nod_front_kerapac_cutscene_vo_i_could_not_imagine,300,false,true,true,true
data=col3,egwd_nodon_front_cutscene_02,My imagination was lacking.,nod_front_kerapac_cutscene_vo_my_imagination_was_lacking,260,true,false,true,true
data=col3,egwd_nodon_front_cutscene_02,Bound once more to Her service, now I suffer alone.,nod_front_kerapac_cutscene_vo_bound_once_more_to_her_service,350,false,false,true,true
data=col3,egwd_nodon_front_cutscene_02,I am commanded to secure the eggs.,nod_front_kerapac_cutscene_vo_i_am_commanded_to_secure_the_eggs,300,false,false,true,true
data=col3,egwd_nodon_front_cutscene_02,For this I require an army.,nod_front_kerapac_cutscene_vo_for_this_require_an_army,300,false,true,true,true
data=col3,egwd_nodon_front_cutscene_03,The Nodon dragonkin. Cowards.,nod_front_kerapac_cutscene_vo_the_nodon_dragon_cowards,300,false,false,true,true
data=col3,egwd_nodon_front_cutscene_03,Rather than lift a finger they slept through the curse.,nod_front_kerapac_cutscene_vo_rather_than_lift_a_finger_they_slept_through_the_curse,300,false,false,true,true
data=col3,egwd_nodon_front_cutscene_03,They will serve me dutifully.,nod_front_kerapac_cutscene_vo_they_will_serve_me_dutifully,300,false,true,true,true
data=col3,egwd_nodon_front_cutscene_04,The Needle. The Conduit. The very tools of my oppressor.,nod_front_kerapac_cutscene_vo_the_needle_the_conduit_the_very_tools_oppressor,330,false,false,true,true
data=col3,egwd_nodon_front_cutscene_04,The source of my power. The walls of my prison.,nod_front_kerapac_cutscene_vo_the_source_of_my_power,300,false,false,true,true
data=col3,egwd_nodon_front_cutscene_04,As long as I wield them I can never be free, but she will not let me give them up.,nod_front_kerapac_cutscene_vo_as_long_as_i_weild_them_i_can_never_be_free,460,false,true,true,true
data=col3,egwd_nodon_front_cutscene_05,Jas seeks only to preserve what is left of her kind. For that she would trade the universe.,nod_front_kerapac_cutscene_vo_jas_seeks_only_to_preserve_what_is_left_of_her_kind,500,false,false,true,true
data=col3,egwd_nodon_front_cutscene_05,Once I would have made the same trade.,nod_front_kerapac_cutscene_vo_once_i_would_have_made_the_same_trade,350,false,false,true,true
data=col3,egwd_nodon_front_cutscene_05,The only thing that matters to me now is my freedom. Let everything else wither.,nod_front_kerapac_cutscene_vo_the_only_thing_that_matters_to_me_now_is_my_freedom,430,false,true,true,true

