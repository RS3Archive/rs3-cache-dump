// 6189
[quest_zamorak_bilrach_speech]
table=image_sequence
data=col0,44
data=col1,239
data=col3,zamorak_cutscene_1,O Saradomin, unholy despot.,quest_zam_vo_cs_bil_01,250,true,false,true,true
data=col3,zamorak_cutscene_1,I bring a message from Zamorak, Lord of Chaos, Imperator of Gielinor, Dictator of Infernus and the Lower Planes, et cetera.,quest_zam_vo_cs_bil_02,550,false,false,true,true
data=col3,zamorak_cutscene_1,The Empire of Chaos has returned. This world is ours.,quest_zam_vo_cs_bil_03,350,false,true,true,true
data=col3,zamorak_cutscene_2,Your armies are spent, O Saradomin, while our demons outnumber the stars.,quest_zam_vo_cs_bil_04,350,true,false,true,true
data=col3,zamorak_cutscene_2,You sit in crumbling fortresses while our forces attack at their leisure.,quest_zam_vo_cs_bil_05,350,false,false,true,true
data=col3,zamorak_cutscene_2,Your people are starving, while we burn your crops as offerings.,quest_zam_vo_cs_bil_06,350,false,true,true,true
data=col3,zamorak_cutscene_3,Even now, all-powerful Zamorak summons legions to this world from behind an impregnable shield.,quest_zam_vo_cs_bil_07,400,true,false,true,true
data=col3,zamorak_cutscene_3,Supplicate yourself before him and he will spare the lives of your few misguided followers.,quest_zam_vo_cs_bil_08,420,false,false,true,true
data=col3,zamorak_cutscene_3,Refuse, and his wrath shall consume all lands.,quest_zam_vo_cs_bil_09,320,false,true,true,true

