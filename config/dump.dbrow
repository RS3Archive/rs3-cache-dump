// 13079
[buff_select_event_buff_roll_on_rare_drop_table]
table=buff_select_event_buff
data=col0,24
data=col1,Windfall
data=col2,You will periodically <col=0x00ff00>gain rare items</col> while training <col=0x00ffff>non-combat skills</col>.
data=col4,Any items received this way will be sent to your <col=0x00ffff>bank</col>.
data=col6,event_bonanza_icon_buff_roll_on_rare_drop_table

// 13080
[buff_select_event_buff_ushabti_catch_boost]
table=buff_select_event_buff
