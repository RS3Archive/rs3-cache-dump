// 1663
[quest_charos_opening_cutscene]
table=image_sequence
data=col0,7
data=col2,1484
data=col3,cutscene_quest_chaos_1,Good people of Gielinor, thank you for coming.,vo_seren_quest_charos_opening_cutscene_01,300,true,false,true,true
data=col3,cutscene_quest_chaos_1,For those of you who do not know me, my name is Seren.<br>Some call me the goddess of the elves.,vo_seren_quest_charos_opening_cutscene_02,500,false,true,true,true
data=col3,cutscene_quest_chaos_2,I have called you here because you represent every race of people and every god on Gielinor.,vo_seren_quest_charos_opening_cutscene_03,500,true,false,true,true
data=col3,cutscene_quest_chaos_2,There is a threat, a threat which faces every one of us.<br>One you may be unaware of.,vo_seren_quest_charos_opening_cutscene_04,450,false,false,true,true
data=col3,cutscene_quest_chaos_2,The elder gods.,vo_seren_quest_charos_opening_cutscene_05,200,false,false,true,true
data=col3,cutscene_quest_chaos_2,They are beings, older than our world.<br>Indeed, they created this world, and indirectly everything on it.,vo_seren_quest_charos_opening_cutscene_06,550,false,true,true,true
data=col3,cutscene_quest_chaos_1,Great artefacts, like the Stone of Jas, which have brought us<br>war and woe for millennia, are merely their discarded tools.,vo_seren_quest_charos_opening_cutscene_07,500,true,false,true,true
data=col3,cutscene_quest_chaos_1,They are so powerful, so far beyond all of us,<br>that even we gods are nothing more than ants to them.,vo_seren_quest_charos_opening_cutscene_08,500,false,false,true,true
data=col3,cutscene_quest_chaos_1,For the entire lifetime of this planet they have slept,<br>but now they are waking up.,vo_seren_quest_charos_opening_cutscene_09,500,false,true,true,true
data=col3,cutscene_quest_chaos_3,To them, this planet and all of its people are nothing more than food for their children.,vo_seren_quest_charos_opening_cutscene_10,450,true,false,true,true
data=col3,cutscene_quest_chaos_3,They laid their eggs in the heart of the planet, and when they hatch,<br>they will consume Gielinor and all life on it.,vo_seren_quest_charos_opening_cutscene_11,550,false,false,true,true
data=col3,cutscene_quest_chaos_3,Then they will move on to the rest of the universe, destroying world after world,<br>until their work is finished and there is nothing but darkness.,vo_seren_quest_charos_opening_cutscene_12,700,false,true,true,true
data=col3,cutscene_quest_chaos_4,How can I know this?,vo_seren_quest_charos_opening_cutscene_13,200,true,false,true,true
data=col3,cutscene_quest_chaos_4,Because I too am their child.,vo_seren_quest_charos_opening_cutscene_14,175,false,false,true,true
data=col3,cutscene_quest_chaos_4,It fills my heart with pride to be considered the goddess of my people,<br>but that is not my true identity.,vo_seren_quest_charos_opening_cutscene_15,500,false,false,true,true
data=col3,cutscene_quest_chaos_4,My mother was an elder god. Though weak, deformed, abandoned.<br>No Threat to Gielinor.,vo_seren_quest_charos_opening_cutscene_16,550,false,false,true,true
data=col3,cutscene_quest_chaos_4,She created me, millions of years ago, along with- with... another.,vo_seren_quest_charos_opening_cutscene_17,450,false,true,true,true
data=col3,cutscene_quest_chaos_1,I went out into the universe, discovered mortal life, and though it took time,<br>I learned to appreciate the joy and wonder that your kind brings to existence.,vo_seren_quest_charos_opening_cutscene_18,800,true,false,true,true
data=col3,cutscene_quest_chaos_1,I do not share the goal of my kin. I would not see life on this planet, in this universe, ended.,vo_seren_quest_charos_opening_cutscene_19,500,false,true,true,true
data=col3,cutscene_quest_chaos_4,We have only one chance to avoid this fate.,vo_seren_quest_charos_opening_cutscene_20,300,true,false,true,true
data=col3,cutscene_quest_chaos_4,You must meet with the elder gods.<br>You must go before them, prove to them that you are more than merely food to be consumed.,vo_seren_quest_charos_opening_cutscene_22a,550,false,true,true,true
data=col3,cutscene_quest_chaos_2,I am sure that they will come to see your value as I have.,vo_seren_quest_charos_opening_cutscene_22b,400,true,false,true,true
data=col3,cutscene_quest_chaos_2,That is why I have brought you here. To warn you.<br>To plead with you to make this case.,vo_seren_quest_charos_opening_cutscene_22,500,false,false,true,true
data=col3,cutscene_quest_chaos_2,It is only by working together that you can do this.<br>Only united can you show the elder gods that you are worthy.,vo_seren_quest_charos_opening_cutscene_23,600,false,true,true,true

// 1664
[quest_charos_closing_cutscene]
table=image_sequence
data=col0,8
data=col2,1484
data=col3,cutscene_quest_chaos_5,The world guardian arrived just too late.<br>Kerapac's plan had worked flawlessly.,vo_seren_quest_charos_closing_cutscene_01,400,true,false,true,true
data=col3,cutscene_quest_chaos_5,With a triumphant shout he plunged the staff into the Needle to absorb its power. ,vo_seren_quest_charos_closing_cutscene_02,350,false,false,true,true
data=col3,cutscene_quest_chaos_5,Gail watched in horror as control of the Needle was torn from her and given to the dragonkin. ,vo_seren_quest_charos_closing_cutscene_03,400,false,true,true,true
data=col3,cutscene_quest_chaos_6,In an instant, she was Gail no more.<br>Primrose stood, staring at the monster before her.,vo_seren_quest_charos_closing_cutscene_04,500,true,false,true,true
data=col3,cutscene_quest_chaos_6,Kerapac roared in triumph, the power of the Needle now his to command.,vo_seren_quest_charos_closing_cutscene_05,350,false,true,true,true
data=col3,cutscene_quest_chaos_7,He took to the air, and the Needle vanished from sight at the whim of its new master.,vo_seren_quest_charos_closing_cutscene_06,350,true,false,true,true
data=col3,cutscene_quest_chaos_7,He flew east to the coast and out across the sea, vanishing into a great storm.,vo_seren_quest_charos_closing_cutscene_07,400,false,false,true,true
data=col3,cutscene_quest_chaos_7,And there he set to work on the next stage of his endeavour...,vo_seren_quest_charos_closing_cutscene_08,350,false,true,true,true

