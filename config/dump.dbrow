// 8378
[dbrow_8378]
table=dbtable_130
data=col1,1,true,Event information,<col=FFFFFF>Active:</col> 25/09/2023 (00:00 game time) - 08/10/2023 (23:59 game time)<br><br>During Thok's Smashing Buffs, a variety of <col=00FFFF>combat-related buffs</col> are active! Select the options to see more information on each buff.<br><br>Throughout the event, <col=00FFFF>free elder overload boosts</col> are also available from the <col=00FFFF>elder overload cauldrons</col> in <col=00FFFF>War's Retreat</col>.<br>If you have the ability to craft overload salve potions, you will instead gain the effects of an <col=00FFFF>elder overload salve</col> from the cauldrons.<br><col=FF0000>This buff is not available for Ironmen.</col><br><br>The event will run for <col=00FFFF>two weeks</col> in total.
data=col1,0,true,Free deaths,<col=00FFFF>If you die</col>, you will <col=00FFFF>not have to pay to reclaim your items</col> throughout the duration of the event. <br><br><col=00FFFF>Members</col> will also <col=00FFFF>respawn at the nearest hub</col>, instead of Death's Office.
data=col1,0,true,Sign of life,Entering a <col=00FFFF>bank area</col> with a <col=00FFFF>sign of life</col> on cooldown will <col=00FFFF>reset the cooldown</col> throughout the duration of the event.
data=col1,0,true,Tier 4 luck,You will have <col=00FFFF>Tier 4 luck</col> active throughout the duration of the event.<br><br><col=FF0000>This buff is not available for Ironmen.</col>
data=col1,0,true,Soul Reaper tasks,When getting assigned a <col=00FFFF>Soul Reaper task</col> from Death during the event, you will be able to <col=00FFFF>choose which task</col> you want.<br><br>Completing a Soul Reaper task during the event will grant <col=00FFFF>double the expected reaper points</col>.<br><col=FF0000>This buff is not available for Ironmen.</col>
data=col1,0,true,Slayer tasks,When getting assigned a <col=00FFFF>Slayer task</col> from any Slayer master during the event, you will be able to <col=00FFFF>choose between two tasks</col>.
data=col1,0,true,Combat auras,When using a <col=00FFFF>combat aura</col> during the event, it will have <col=00FFFF>no cooldown</col> once it ends.

