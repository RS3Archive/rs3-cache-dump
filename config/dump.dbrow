// 13395
[uitutorial_necromancy_ritual_site_ungael_0]
table=uitutorial_step
data=col3,<col=FFCB05>The Ungael ritual site is a more economical, laid-back Necromancy training method.</col><br><br>Ritual components are <col=FFCB05>more durable</col>, ritual disturbances have <col=FFCB05>increased duration</col>, there's a convenient <col=FFCB05>bank chest</col>, and if you wear Zorgoth's ring, it has a chance to <col=FFCB05>upgrade</col> each time you complete a ritual.<br><br>However, Ungael experience rates are slightly lower than Um, and communion rituals cannot be performed here.
data=col17,skill_icon_necromancy_35px

