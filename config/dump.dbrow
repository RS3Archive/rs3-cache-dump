// 7028
[dbrow_7028]
table=dbtable_40
data=col0,48
data=col1,320
data=col3,quest_daughter2_bilrach_fails_frame1,,sound_2901,100,true,false,false,false
data=col3,quest_daughter2_bilrach_fails_frame1,Bilrach didn't think to inspect the marker before his ritual, and it cost him dearly.,sound_55700,400,false,false,true,true
data=col3,quest_daughter2_bilrach_fails_frame1,He sought the power he felt was owed to him.,sound_55705,250,false,false,true,true
data=col3,quest_daughter2_bilrach_fails_frame2a,He dreamed of draining souls from across the world, becoming unrivalled in his power.,sound_55704,400,false,false,true,true
data=col3,quest_daughter2_bilrach_fails_frame2a,In a world without gods, he would rule without opposition.,sound_55707,350,false,false,true,true
data=col3,quest_daughter2_bilrach_fails_frame2a,Unrivalled. Untouchable. But it was not to be.,sound_55711,360,false,false,true,true
data=col3,quest_daughter2_bilrach_fails_frame2b,Your sabotage turned the power Bilrach summoned into the marker against itself.,sound_55712,300,false,false,true,true
data=col3,quest_daughter2_bilrach_fails_frame2b,Magic surged until the structure could contain it no longer.,sound_55709,300,false,false,true,true
data=col3,quest_daughter2_bilrach_fails_frame3,In a great thunderclap, the marker exploded, shattering across the Wilderness like a bad dream.,sound_55706,600,false,false,true,true
data=col3,quest_daughter2_bilrach_fails_frame3,The power contained returned to the dirt and the soil. The shards of soul it harnessed returned to the underworld to await their afterlife.,sound_55710,550,false,false,true,true
data=col3,quest_daughter2_bilrach_fails_frame4,Bilrach had failed. His plan ruined. His dreams of glory shattered like the marker.,sound_55701,450,false,false,true,true
data=col3,quest_daughter2_bilrach_fails_frame4,In one act of sabotage, the world was safe once more. None even knew they'd been at risk.,sound_55708,500,false,false,true,true
data=col3,quest_daughter2_bilrach_fails_frame4,Bilrach's army remained. It was still a threat. Still a terrible danger.,sound_55702,500,false,false,true,true
data=col3,quest_daughter2_bilrach_fails_frame4,But the infallibility of his leadership was gone; his authority lost, like his dreams of dominion.,sound_55703,500,false,false,true,true
data=col3,quest_daughter2_bilrach_fails_frame4,,sound_2901,150,false,true,false,false

