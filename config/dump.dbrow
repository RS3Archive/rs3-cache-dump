[dbrow_3712]
table=dbtable_90
data=col0,47
data=col1,1
data=col2,dbrow_3703
data=col3,Orthen Dig Site
data=col6,Orthen was the first city built by the dragonkin upon their arrival on Gielinor, razed by the elder gods...
data=col7,Your research team has discovered lots of materials from Orthen.
data=col8,6000
data=col10,2
