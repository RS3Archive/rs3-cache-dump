// 7785
[uitutorial_necromancy_ritual_selection_tutorial_0]
table=uitutorial_step
data=col3,The <col=FFCB05>ritual selection interface</col> allows you to choose a ritual to perform.
data=col6,necro_ritual_recipe_selection:content_layer
data=col7,-1

// 7786
[uitutorial_necromancy_ritual_selection_tutorial_1]
table=uitutorial_step
data=col3,Each ritual has different requirements. Here you can <col=FFCB05>view the requirements</col> needed to select the ritual, as well as the ritual components you'll need to <col=FFCB05>set up on your ritual site</col>.
data=col6,necro_ritual_recipe_selection:requirements_layer
data=col7,-1
data=col23,necro_ritual_recipe_selection:requirements_layer,-1

// 7787
[uitutorial_necromancy_ritual_selection_tutorial_2]
table=uitutorial_step
data=col3,Rituals also require a <col=FFCB05>focus object</col>, which is consumed upon completing the ritual. Some rituals may have a choice of <col=FFCB05>multiple focus objects</col>.
data=col6,necro_ritual_recipe_selection:input_layer
data=col7,-1
data=col23,necro_ritual_recipe_selection:input_layer,-1

// 7788
[uitutorial_necromancy_ritual_selection_tutorial_3]
table=uitutorial_step
