data=col3,black_placeholder,In times long dead, this place was sacred to my brother Het.,sound_52202,380,false,false,true,true
data=col3,duel_arena_removal_cutscene_01a,It was a training ground, a place for his warriors to sanctify themselves through glorious combat.,sound_52203,470,true,false,true,true
data=col3,duel_arena_removal_cutscene_01a,Those times are gone. The duellists who fight here now do so not for honour, but merely wealth.,sound_52204,503,false,false,true,true
data=col3,duel_arena_removal_cutscene_01a,I came here in search of the Eye of Het, a relic of incredible power.,sound_52205,319,false,false,true,true
data=col3,duel_arena_removal_cutscene_01b,Before we could begin our excavation, a terrible earthquake struck the area.,sound_52206,8,false,false,true,false
