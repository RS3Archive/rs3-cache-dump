// 4343
[quest_senntisten_opening_cutscene]
table=image_sequence
data=col0,34
data=col1,30
data=col3,quest_senntisten_cutscene_1,The elder gods must touch the eggs to hatch them correctly.,cos_azz_vo_the_elder_gods_must_touch,400,true,false,true,true
data=col3,quest_senntisten_cutscene_1,If they make a direct assault, their young could be destroyed.,cos_azz_vo_they_make_a_direct_assault,400,false,true,true,true
data=col3,quest_senntisten_cutscene_2,If they cannot attack themselves, they will send forces both martial and magical.,cos_azz_vo_if_they_cannot_attack_themselves,450,true,false,true,true
data=col3,quest_senntisten_cutscene_2,We cannot know who, but they will be powerful. We need a defensible location.,cos_azz_vo_we_cannot_know_who,450,false,true,true,true
data=col3,quest_senntisten_cutscene_3,We must gather the gods. They can drain the eggs to keep them from hatching.,cos_azz_vo_we_must_gather_the_gods,500,true,false,true,true
data=col3,quest_senntisten_cutscene_3,It falls to their followers to hold off whatever is coming.,cos_azz_vo_it_falls_to_their_followers,400,false,true,true,true
data=col3,quest_senntisten_cutscene_4,The battle to come will be apocalyptic. The world is at stake.,cos_azz_vo_the_battle_to_come,450,true,false,true,true
data=col3,quest_senntisten_cutscene_4,We must keep the fight away from the common people.,cos_azz_vo_we_must_keep_the_fight_away,400,false,true,true,true
data=col3,quest_senntisten_cutscene_5,My agents recently uncovered a location which is both fortified and remote.,cos_azz_vo_my_agents_recently_uncovered,450,true,false,true,true
data=col3,quest_senntisten_cutscene_5,A place I know well.,cos_azz_vo_a_place_i_know_well,200,false,false,true,true
data=col3,quest_senntisten_cutscene_5,The City of Senntisten...,cos_azz_vo_the_city_of_senntisten,200,false,true,true,true

