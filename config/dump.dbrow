table=dbtable_40
data=col0,45
data=col1,240
data=col3,egwd_zamorak_boss_opening_cutscene_01,I am Zamorak.,sound_54926,150,false,false,true,true
data=col3,egwd_zamorak_boss_opening_cutscene_01,My life has been long, and throughout it I have lived by one maxim:,sound_54937,330,false,false,true,true
data=col3,egwd_zamorak_boss_opening_cutscene_01,Liberty or death.,sound_54938,150,false,false,true,true
data=col3,egwd_zamorak_boss_opening_cutscene_01,Freneskae was the perfect world.,sound_54944,170,false,false,true,true
data=col3,egwd_zamorak_boss_opening_cutscene_01,Harsh, but fair.,sound_54945,120,false,false,true,true
data=col3,egwd_zamorak_boss_opening_cutscene_01,Survival forced my people to become the greatest of warriors.,sound_54946,250,false,false,true,true
data=col3,egwd_zamorak_boss_opening_cutscene_01,When the stranger promised us conquest and plenty, we followed him.,sound_54947,290,false,false,true,true
data=col3,egwd_zamorak_boss_opening_cutscene_01,It was a mistake.,sound_54948,100,false,true,true,true
data=col3,egwd_zamorak_boss_opening_cutscene_02,On Gielinor, I built a mighty empire in the name of the dark god Zaros.,sound_54949,320,true,false,true,true
data=col3,egwd_zamorak_boss_opening_cutscene_02,But he and I did not share the same vision for the future.,sound_54916,210,false,false,true,true
data=col3,egwd_zamorak_boss_opening_cutscene_02,Where I saw freedom, he saw only control.,sound_54917,230,false,false,true,true
data=col3,egwd_zamorak_boss_opening_cutscene_02,My people, once warriors, became priests.,sound_54918,250,false,false,true,true
data=col3,egwd_zamorak_boss_opening_cutscene_02,Bureaucrats.,sound_54919,100,false,false,true,true
data=col3,egwd_zamorak_boss_opening_cutscene_02,Sanitation engineers.,sound_54920,170,false,false,true,true
data=col3,egwd_zamorak_boss_opening_cutscene_02,To win their freedom, I struck down a god.,sound_54922,220,false,false,true,true
data=col3,egwd_zamorak_boss_opening_cutscene_02,To safeguard it, I became one.,sound_54923,200,false,true,true,true
data=col3,egwd_zamorak_boss_opening_cutscene_03,On Infernus, I led a downtrodden people to victory.,sound_54924,250,true,false,true,true
data=col3,egwd_zamorak_boss_opening_cutscene_03,Hostilius, a corpulent monster grown fat and indolent, maintained order through rules and laws.,sound_54925,460,false,false,true,true
data=col3,egwd_zamorak_boss_opening_cutscene_03,His laws did as little to protect him as his skin did.,sound_54927,270,false,false,true,true
data=col3,egwd_zamorak_boss_opening_cutscene_03,I strung up his corpse as a message for all to see. Such is the fate of all tyrants.,sound_54928,370,false,false,true,true
data=col3,egwd_zamorak_boss_opening_cutscene_03,The Avernic demons, now free, serve me willingly.,sound_54929,280,false,true,true,true
data=col3,egwd_zamorak_boss_opening_cutscene_04,Back on Gielinor, pretenders picked over the remains of my empire.,sound_54930,335,true,false,true,true
data=col3,egwd_zamorak_boss_opening_cutscene_04,For an age I battled them.,sound_54931,150,false,false,true,true
data=col3,egwd_zamorak_boss_opening_cutscene_04,An age of strife, of progress, of glory.,sound_54932,240,false,false,true,true
data=col3,egwd_zamorak_boss_opening_cutscene_04,While I fought on, none could establish the safety, the security, that they so craved.,sound_54933,410,false,false,true,true
data=col3,egwd_zamorak_boss_opening_cutscene_04,For an age, Gielinor was truly free.,sound_54934,210,false,false,true,true
data=col3,egwd_zamorak_boss_opening_cutscene_04,But they conspired against me, and I was banished.,sound_54935,265,false,true,true,true
data=col3,egwd_zamorak_boss_opening_cutscene_05,In my long absence, this world has become weak.,sound_54936,230,true,false,true,true
data=col3,egwd_zamorak_boss_opening_cutscene_05,Saradomin's fingers are wrapped tightly around its throat, suffocating it.,sound_54939,320,false,false,true,true
data=col3,egwd_zamorak_boss_opening_cutscene_05,My demon army will make short work of its farmers, woodcutters and fishermen.,sound_54940,390,false,false,true,true
data=col3,egwd_zamorak_boss_opening_cutscene_05,The survivors will be stronger. They will have no choice.,sound_54941,300,false,false,true,true
data=col3,egwd_zamorak_boss_opening_cutscene_05,Gielinor's people will be free, or they will die.,sound_54942,310,false,false,true,true
data=col3,egwd_zamorak_boss_opening_cutscene_05,Liberty or death.,sound_54943,300,false,true,true,true

