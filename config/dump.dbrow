// 4069
[miniquest_egwd_prerelease_part1_cutscene]
table=image_sequence
data=col0,29
data=col1,125
data=col3,egwd_prerelease_cutscene_1_1,At the time, none of us realised the significance of the events that were about to unfold.,pre_release_week_01_at_the_time_none_of_us,456,true,true,true,true
data=col3,egwd_prerelease_cutscene_1_2,The followers of Zaros came first, descending on the Monolith to seize it for the dark lord.,pre_release_week_01_the_followers_of_zaros,450,true,true,true,true
data=col3,egwd_prerelease_cutscene_1_3,My fellow ancients, awoken from their tombs,<br> commanded traitor knights to begin their assault.,pre_release_week_01_my_fellow_ancients,505,true,false,true,true
data=col3,egwd_prerelease_cutscene_1_3,But the worst was still to come.,pre_release_week_01_but_the_worst_is_still,300,false,true,true,true

// 4070
[miniquest_egwd_prerelease_part2_cutscene]
table=image_sequence
data=col0,30
data=col1,125
data=col3,egwd_prerelease_cutscene_2_1,At last his plans had come to fruition.,pre_release_week_02_at_last_his_plans_had_come,350,true,true,true,true
data=col3,egwd_prerelease_cutscene_2_2,The Monolith lay undefended.,pre_release_week_02_the_monolith_lay_undefended,200,true,true,true,true
data=col3,egwd_prerelease_cutscene_2_3,With implacable will he forced it open, revealing the truth<br>that lay at its heart - a tear in the fabric of our reality.,pre_release_week_02_with_implacable_will_he_forced,620,true,true,true,true
data=col3,egwd_prerelease_cutscene_2_4,Then he departed from this world, heedless of the devastation that would follow in his wake.,pre_release_week_02_then_he_departed_from_this_world_heedless,500,true,true,true,true
data=col3,egwd_prerelease_cutscene_2_5,From that same gateway came beings of pure shadow, and with them a torrent of dark energy.,pre_release_week_02_from_that_same_gateway_came_beings_of_pure_shadow,540,true,false,true,true
data=col3,egwd_prerelease_cutscene_2_5,Left unchecked, it would choke our world.,pre_release_week_02_left_unchecked_it_would_choke_our_world,300,false,false,true,true
data=col3,egwd_prerelease_cutscene_2_5,But the worst was still to come.,pre_release_week_02_but_the_worst_was_still_to_come,350,false,true,true,true

// 4071
[miniquest_egwd_prerelease_part3_cutscene]
table=image_sequence
data=col0,31
data=col1,125
data=col3,egwd_prerelease_cutscene_3_1,The invaders from beyond proved too much for the brave allies.,pre_release_week_03_the_invaders_from_beyond,335,true,true,true,true
data=col3,egwd_prerelease_cutscene_3_2,Yet hope was not lost - Gielinor had defenders still.,pre_release_week_03_yet_hope_was_not_lost,350,true,true,true,true
data=col3,egwd_prerelease_cutscene_3_3,The TokHaar, the hands who created this world, the servants of<br>the Elder Gods themselves, stood with us.,pre_release_week_03_the_tokhaar_the_hands_who_created_this_world,400,true,false,true,true
data=col3,egwd_prerelease_cutscene_3_3,But the worst was still to come.,pre_release_week_03_but_the_worst_was_still_to_come,250,false,true,true,true

// 4072
[miniquest_egwd_prerelease_part4_cutscene]
table=image_sequence
data=col0,32
data=col1,125
data=col3,egwd_prerelease_cutscene_4_1,The priest, my friend, his heart filled with shame and confusion,<br>stood before the doom his efforts had wrought.,pre_release_week_04_the_preist_my_friend_filled_with_shame,550,true,true,true,true
data=col3,egwd_prerelease_cutscene_4_2,He grappled with the gateway, forcing it closed as it sought to consume him.,pre_release_week_04_he_grappled_with_the_gatewayg,390,true,true,true,true
data=col3,egwd_prerelease_cutscene_4_3,The Monolith snapped shut, but the backlash had nowhere else to go.,pre_release_week_04_the_monolith_snapped_shut,380,true,true,true,true
data=col3,egwd_prerelease_cutscene_4_4,Pain cut through him as the corrupting energies tore into his body.,pre_release_week_04_pain_cut_through_him,350,true,true,true,true
data=col3,black_placeholder,Silence enveloped him...but there would be no peace for the most faithful.,pre_release_week_04_silence_enveloped_him,550,true,true,true,true
data=col3,egwd_prerelease_cutscene_4_5,The desolate scream of the new god filled the air.,pre_release_week_04_the_desolate_scream_of_the_new_god,250,true,true,true,true
data=col3,egwd_prerelease_cutscene_4_6,In the aftermath of the devastation, the TokHaar looked at what the<br>witless surface dwellers had done to their world.,pre_release_week_04_in_the_aftermath,500,true,false,true,true
data=col3,egwd_prerelease_cutscene_4_6,Everything would have to be dismantled, starting with their former allies.,pre_release_week_04_everything_would_have_to_be_dismantled,430,false,false,true,true
data=col3,egwd_prerelease_cutscene_4_6,But the worst was still to come.,pre_release_week_04_but_the_worst_was_still_to_come,300,false,true,true,true

// 4073
[miniquest_egwd_prerelease_part5_cutscene]
table=image_sequence
data=col0,33
data=col1,125
data=col3,egwd_prerelease_cutscene_5_1,It is too late.,pre_release_week_05_it_is_too_late,160,true,false,true,true
data=col3,egwd_prerelease_cutscene_5_1,The invaders may have been defeated but the foul power<br>that seeped from the gateway has already done its work.,pre_release_week_05_the_invaders_may_have,432,false,false,true,true
data=col3,egwd_prerelease_cutscene_5_1,The Elder God eggs, imperiled by the poison, are hatching.,pre_release_week_05_the_elder_god_eggs_imperiled,360,false,false,true,true
data=col3,egwd_prerelease_cutscene_5_1,The young within will feast on our world.,pre_release_week_05_the_young_within_will_feast_upon_on_our_world,350,false,false,true,true
data=col3,egwd_prerelease_cutscene_5_1,Now the worst is upon us.,pre_release_week_05_now_the_worst_is_upon_us,350,false,true,true,true

