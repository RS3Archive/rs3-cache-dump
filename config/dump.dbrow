data=col0,39
data=col1,30
data=col3,black_placeholder,In times long dead, this place was sacred to my brother Het.,dar_cs_vo_icth_01_alt2,380,false,false,true,true
data=col3,duel_arena_removal_cutscene_01a,It was a training ground, a place for his warriors to sanctify themselves through glorious combat.,dar_cs_vo_icth_02_alt1,470,true,false,true,true
data=col3,duel_arena_removal_cutscene_01a,Those times are gone. The duellists who fight here now do so not for honour, but merely wealth.,dar_cs_vo_icth_03_alt3,503,false,false,true,true
data=col3,duel_arena_removal_cutscene_01a,I came here in search of the Eye of Het, a relic of incredible power.,dar_cs_vo_icth_04_alt5,319,false,false,true,true
data=col3,duel_arena_removal_cutscene_01b,Before we could begin our excavation, a terrible earthquake struck the area.,dar_cs_vo_icth_05_alt2,8,false,false,true,false
