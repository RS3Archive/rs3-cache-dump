data=col2,dbrow_7805
data=col3,dbrow_7805
data=col4,dbrow_7805

// 7805
[dbrow_7805]
table=dbtable_72
data=col3,<col=FFCB05>One of your ritual components has depleted!</col><br>Depleted ritual components must be <col=FFCB05>repaired</col> before they can be used again.

