data=col0,Necromancy
data=col2,dbrow_7807
data=col3,dbrow_7807
data=col4,dbrow_7807

// 7807
[dbrow_7807]
table=dbtable_72
data=col3,Once a ritual has been selected, your <col=FFCB05>ritual components</col> that are used in that ritual are <col=FFCB05>highlighted</col>. This can be configured in the <col=FFCB05>'Necromancy' menu</col> under the <col=FFCB05>Skills & Experience section</col> of the <col=FFCB05>Gameplay Settings</col>.

