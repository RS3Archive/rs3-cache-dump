// 13057
[buff_select_event_buff_double_yield_chance]
table=buff_select_event_buff
data=col0,2
data=col1,Efficient Gatherer
data=col2,<col=0x00ff00>20% chance</col> to receive an additional item when gathering resources with <col=0x00ffff>gathering skills</col>.
data=col4,Any additional items received this way will be sent to your <col=0x00ffff>bank</col>, except for Divination memories, which are sent to your backpack.
data=col6,event_bonanza_icon_buff_double_yield_chance

// 13058
[buff_select_event_buff_infinite_ammo_cannon]
table=buff_select_event_buff
data=col0,3
data=col1,Infinite Ammunition
data=col2,<col=0x00ffff>Cannons</col> don't require or consume cannonballs.
data=col4,You can buy a cannon from <col=0x00ffff>Nulodion</col> at the north entrance to the Dwarven mines, <col=0x00ffff>south of Ice Mountain</col>.
data=col4,To buy a cannon, you need to have completed the <col=0x00ffff>Dwarf Cannon quest</col>.
data=col6,event_bonanza_icon_buff_infinite_ammo_cannon

// 13059
[buff_select_event_buff_runeless_casting]
table=buff_select_event_buff
data=col0,4
data=col1,Runic Focus
data=col2,<col=0x00ffff>Combat spells</col>, <col=0x00ffff>teleports</col> and <col=0x00ffff>Necromancy incantations</col> don't require runes.<br><col=FA3232>-90% XP</col> from casting these spells and incantations.
data=col3,<col=0x00ffff>Combat spells</col>, <col=0x00ffff>teleports</col> and <col=0x00ffff>Necromancy incantations</col> don't require runes.
data=col4,<col=0x00ffff>XP</col> received from casting these spells and incantations is <col=FA3232>reduced by 90%</col>.
data=col6,event_bonanza_icon_buff_runeless_casting

