// 14734
[trh204_promo_info]
table=trh_promo_info
data=col0,Tarot Trove
data=col1,Pick a revealed Tarot Card or leave it to chance and pick the Mystery Card!
data=col2,trh204_card_back,63,82
data=col3,0
data=col5,Select a card to use a Treasure Hunter Key. Select a revealed card to receive the visible prize, or select the mystery card to receive a random prize of the displayed rarity!<br>Each type of tarot card offers different prizes! They can give anything from standard Treasure Hunter prizes, to <col=0xffcb05>special lamps</col>, or even <col=0xffcb05>cash prizes up to</col> <col=FF00>100M</col>!
data=col6,Special Cards
data=col7,Find the <col=0xffcb05>Death Card</col> to win combat rewards including a <col=0xffcb05>Box of Deathtouched Darts</col>!<br>Find the <col=0xffcb05>Fortune Card</col> to win a <col=0xffcb05>cash prize up to</col> <col=FF00>100M</col>!
data=col8,true
data=col9,Promotion Information
data=col10,trh204_promo_info_cards
