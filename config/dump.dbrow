data=col6,event_bonanza_icon_buff_healing_boost

// 13065
[buff_select_event_buff_arch_excavation_boost]
table=buff_select_event_buff
data=col0,10
data=col1,Meticulous
data=col2,<col=0x00ff00>+100%</col> Archaeology <col=0x00ffff>precision</col>. <col=0x00ff00>+50% chance</col> of finding <col=0x00ffff>materials</col> while excavating.
data=col4,<col=0x00ffff>Precision</col> increases the speed at which <col=0x00ffff>artefacts</col> are excavated.
data=col6,event_bonanza_icon_buff_arch_excavation_boost

// 13066
[buff_select_event_buff_livid_farm_boost]
table=buff_select_event_buff
data=col0,11
data=col1,Lunar Prodigy
data=col2,<col=0x00ff00>+300% produce points</col> at the <col=0x00ffff>Livid Farm</col>.
data=col4,<col=0x00ffff>Produce points</col> allow you to unlock various spells from <col=0x00ffff>Pauline</col> at the <col=0x00ffff>Livid Farm</col>.
data=col4,To gain <col=0x00ffff>produce points</col>, you need to have completed the <col=0x00ffff>Lunar Diplomacy quest</col>.
data=col6,event_bonanza_icon_buff_livid_farm_boost

// 13067
[buff_select_event_buff_basics_adren_boost]
table=buff_select_event_buff
data=col0,12
data=col1,Energetic
data=col2,<col=0x00ff00>+1% adrenaline</col> gained from <col=0x00ffff>basic abilities</col> that generate adrenaline.
data=col4,This effect does <col=FA3232>not</col> stack with the <col=0x00ffff>Fury of the Small relic power</col>.
data=col6,event_bonanza_icon_buff_basics_adren_boost

// 13068
[buff_select_event_buff_afk_mining_smithing]
table=buff_select_event_buff
data=col0,13
data=col1,Metalwork Mastery
data=col2,<col=0x00ffff>Stamina</col> doesn't decrease when <col=0x00ffff>mining</col>. <col=0x00ffff>Heat</col> doesn't decrease while <col=0x00ffff>smithing</col>.
data=col6,event_bonanza_icon_buff_afk_mining_smithing

// 13069
[buff_select_event_buff_triple_charms]
table=buff_select_event_buff
data=col0,14
data=col1,Three Times the Charm
data=col2,<col=0x00ffff>Charm</col> drops are <col=0x00ff00>tripled</col>.
data=col3,<col=0x00ffff>Summoning charms</col> that are dropped on death by enemies, except for the Arch-Glacor, are <col=0x00ff00>tripled</col>.
data=col6,event_bonanza_icon_buff_triple_charms

// 13070
[buff_select_event_buff_safe_deaths]
table=buff_select_event_buff
data=col0,15
data=col1,Death's Favour
data=col2,<col=0x00ffff>Deaths</col> are <col=0x00ff00>safe</col>.
data=col3,Upon <col=0x00ffff>death</col>, you respawn in a safe area with all of your items and equipment.
data=col4,This effect does <col=FA3232>not</col> work in <col=0x00ffff>PVP combat</col>.
data=col6,event_bonanza_icon_buff_safe_deaths

// 13071
[buff_select_event_buff_slayer_double_points_vip]
table=buff_select_event_buff
data=col0,16
data=col1,Killer Contracts
data=col2,<col=0x00ff00>+100%</col> <col=0x00ffff>Slayer points</col> and <col=0x00ffff>Reaper points</col>.<br>Free <col=0x00ffff>Slayer VIP</col> choices.<br>Free <col=0x00ffff>Soul Reaper</col> assignment choices.
data=col3,Any <col=0x00ffff>Slayer points</col> and <col=0x00ffff>Reaper points</col> you receive are <col=0x00ff00>doubled</col>.
data=col4,When getting assigned a <col=0x00ffff>Slayer task</col> from any Slayer master, you will be able to <col=0x00ffff>choose between two tasks</col>.
data=col4,When getting assigned a <col=0x00ffff>Soul Reaper task</col> from Death, you will be able to <col=0x00ffff>choose which task</col> you want.
data=col6,event_bonanza_icon_buff_slayer_double_points_vip

// 13072
[buff_select_event_buff_double_clue_points]
table=buff_select_event_buff
data=col0,17
data=col1,Trailblazer
data=col2,<col=0x00ff00>+100% Treasure Trail Points</col> from completing <col=0x00ffff>Treasure Trails</col>.
data=col4,You can spend <col=0x00ffff>Treasure Trail Points</col> at <col=0x00ffff>Zaida</col>, south of the <col=0x00ffff>Varrock Grand Exchange</col>.
data=col6,event_bonanza_icon_buff_double_clue_points

// 13073
[buff_select_event_buff_double_drop_chance]
table=buff_select_event_buff
data=col0,18
data=col1,Hazelmere's Blessing
data=col2,<col=0x00ff00>5% chance</col> per dropped item to <col=0x00ff00>double</col> enemy drops.
data=col6,event_bonanza_icon_buff_double_drop_chance

// 13074
[buff_select_event_buff_boon_artisan]
table=buff_select_event_buff
data=col0,19
data=col1,Boon of The Artisan
data=col2,<col=0x00ff00>20% chance</col> to save resources, produce double items or gain double progress when training <col=0x00ffff>artisan skills</col>.
data=col3,<col=0x00ff00>20% chance</col> to save resources when training <col=0x00ffff>Construction</col>, <col=0x00ffff>Crafting</col>, <col=0x00ffff>Firemaking</col> and <col=0x00ffff>Fletching</col>.
data=col4,<col=0x00ff00>20% chance</col> to produce double items when training <col=0x00ffff>Cooking</col>, <col=0x00ffff>Herblore</col> and <col=0x00ffff>Runecrafting</col>.
data=col4,<col=0x00ff00>20% chance</col> to gain double progress when training <col=0x00ffff>Smithing</col>.
data=col6,event_bonanza_icon_buff_artisan_efficiency_package

// 13075
[buff_select_event_buff_regen_boost]
table=buff_select_event_buff
data=col0,20
data=col1,Passive Regeneration
data=col2,<col=0x00ffff>Life points</col>, <col=0x00ffff>prayer points</col> and <col=0x00ffff>summoning points</col> regenerate by <col=0x00ff00>10% every 6 seconds</col> outside of combat.
data=col6,event_bonanza_icon_buff_regen_boost

// 13076
[buff_select_event_buff_div_energy_boost]
table=buff_select_event_buff
data=col0,21
data=col1,Oracle
data=col2,<col=0x00ff00>+100% divine energy</col> when harvesting from a <col=0x00ffff>Divination</col> spring and <col=0x00ff00>+100% energy</col> when converting memories to energy.
data=col6,event_bonanza_icon_buff_div_energy_boost

// 13077
[buff_select_event_buff_global_ash_drops]
table=buff_select_event_buff
data=col0,22
data=col1,Ashes to Ashes
data=col2,All enemies drop <col=0x00ffff>noted ashes</col> on death.
data=col4,<col=0x00ffff>Ashes</col> can be used to create <col=0x00ffff>ghostly ink</col>, which is used in <col=0x00ffff>Necromancy rituals</col>.
data=col6,event_bonanza_icon_buff_global_ash_drops

