// 3557
[calendar_entry_newspost_180526]
table=calendar_entry
data=col0,4
data=col1,0
data=col2,8846
data=col3,8852
data=col7,Dungeoneering Speedrunning & Crystalline Court Marketplace Drop
data=col9,Gotta go fast. Kick down doors, find keys, clear the entire floor at mach 3, you know the drill. Today we launch a brand new Dungeoneering Speedrunning system that challenges players to complete the Large Dungeon floors on High complexity while opening all the bonus rooms as quickly as they can! Jump in now to take your shot at the hiscores!<br><br>Also, a wealth of Elf and Prifddinas themed cosmetics have made their way to the Marketplace! From fanciful armour to elegant weapons, you can don these whimsical wares today!
data=col32,newsitem.ws?id=19359
data=col33,newsitem.ws?id=19361
data=col34,newsitem.ws?id=19362
