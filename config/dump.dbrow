// 8167
[bp3_content_buff_clue_scroll_steps]
table=bp3_buff
data=col0,Trailblazer
data=col1,Decreases the amount of steps for all clue scrolls by one.
data=col2,One charge is consumed upon completing the first step of a clue scroll.
data=col5,Your Hero Pass Trailblazer Buff reduces the total number of steps remaining on this clue scroll by 1.

// 8168
[bp3_content_buff_woodcutting_perks]
table=bp3_buff
data=col0,Lumberjack's Ingenuity
data=col1,Doubles the chance of all woodcutting tool invention perks activating for 10 minutes.
data=col2,One charge is consumed upon activation.
data=col3,This buff does not stack with the bottled Woodcutting Perk Enhancer buff.
data=col4,1000

// 8169
[bp3_content_buff_slayer_task_selection]
table=bp3_buff
data=col0,Headhunter
data=col1,Allows you to select your next slayer task at any slayer master.
data=col2,One charge is consumed upon task selection.

// 8170
[bp3_content_buff_fort_resources]
table=bp3_buff
data=col0,Fort Artisan
data=col1,20% chance to save one resource when making refined planks, frames and stone wall segments.
data=col2,One charge is consumed when a resource is saved.
data=col5,Your Hero Pass Fort Artisan Buff saved you a resource.

// 8171
[bp3_content_buff_zamorakian_damage_protection]
table=bp3_buff
data=col0,Chaos Ward
data=col1,Reduces incoming damage in the Zamorakian Undercity elite dungeon by 20% for a full run.
data=col2,One charge is consumed upon first dungeon entry.
data=col3,This buff applies to all enemies within the dungeon, including Zamorak.<br><br>This buff will be lost if your dungeon progress is reset.<br><br>Record boss kill times, permanent enrage increases and boss HiScores will not be updated for anyone in the dungeon.
data=col5,A charge of your Hero Pass Chaos Ward Buff has been used. You will now take 20% less damage throughout the entire dungeon. This will be lost if the dungeon is reset.

