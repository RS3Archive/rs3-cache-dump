data=col3,dino_cutscene_approach_02,If not for the Stormbreaker's powerful magical wards, we would be torn apart.,sound_46519,360,false,true,true,true
data=col3,dino_cutscene_approach_04,From the deck I hear the island calling to me.,sound_46520,300,true,true,true,true
data=col3,dino_cutscene_approach_05,'Turn back. Turn back. I do not want to be found.<br>I should not be found. Turn back.',sound_46521,25,true,false,true,false
