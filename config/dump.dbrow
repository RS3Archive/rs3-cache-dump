data=col3,dino_cutscene_approach_06,This must truly be the very end of the world.<br>Cut off from everything.,sound_46522,400,true,true,true,true
data=col3,dino_cutscene_approach_07,The sort of place I have been seeking all my life.,sound_46523,270,true,true,true,true
