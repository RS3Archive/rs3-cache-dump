data=col0,6
data=col1,Acrobatic
data=col2,The <col=0x00ffff>cooldown</col> of Escape, Surge, Dive and Bladed Dive is <col=0x00ff00>reduced from 20.4 seconds to 4.8 seconds</col>.
data=col6,event_bonanza_icon_buff_movement_ability_cooldown_reduction

