data=col3,dino_boss_miniquest_cutscene_01,Only plants and animals lived there, untroubled by language or industry.,silence,10,false,false,false,false
data=col3,dino_boss_miniquest_cutscene_02,Only plants and animals lived there, untroubled by language or industry.,silence,20,false,false,false,false
data=col3,dino_boss_miniquest_cutscene_03,Only plants and animals lived there, untroubled by language or industry.,silence,70,false,false,false,false
data=col3,dino_boss_miniquest_cutscene_04,Only plants and animals lived there, untroubled by language or industry.,silence,245,false,false,false,true
data=col3,dino_boss_miniquest_cutscene_05,A handful of elder artefacts had been discarded by the Elder Gods.,vo_dino_boss_zaros_cutscene_scene_1c_line_1,295,false,true,true,true
data=col3,dino_boss_miniquest_cutscene_06,One of these was the Codex, a repository of both knowledge and power.,vo_dino_boss_zaros_cutscene_scene_1c_line_2,375,true,true,true,true
data=col3,dino_boss_miniquest_cutscene_07,When a great beast came across the strange monolith, it couldn't know what awaited.,vo_dino_boss_zaros_cutscene_scene_1c_line_3,415,true,true,true,true
data=col3,dino_boss_miniquest_cutscene_08,It emerged from the Codex fundamentally changed.,vo_dino_boss_zaros_cutscene_scene_2a_line_1,245,true,false,true,true
data=col3,dino_boss_miniquest_cutscene_08,It was a colossus - an animal demigod. The ultimate apex predator. Unchallenged.,vo_dino_boss_zaros_cutscene_scene_2a_line_2,565,false,false,true,true
data=col3,dino_boss_miniquest_cutscene_08,When the dragonkin arrived, they were fascinated by the creature.,vo_dino_boss_zaros_cutscene_scene_2b_line_1,285,false,true,true,true
data=col3,dino_boss_miniquest_cutscene_09,They found it, captured it, and imprisoned it in their city.,vo_dino_boss_zaros_cutscene_scene_2b_line_2,285,true,false,true,true
data=col3,dino_boss_miniquest_cutscene_09,They called it Raksha. Nothing quite like it has been seen before, or since.,vo_dino_boss_zaros_cutscene_scene_3a_line_1,405,false,true,true,true
data=col3,dino_boss_miniquest_cutscene_10,It was not just a colossus, but a shadow colossus.,vo_dino_boss_zaros_cutscene_scene_4a_line_1,315,true,false,true,true
data=col3,dino_boss_miniquest_cutscene_10,Its power came not from the elder gods but from somewhere... else.,vo_dino_boss_zaros_cutscene_scene_4a_line_2,455,false,true,true,true
data=col3,dino_boss_miniquest_cutscene_11,To the priest Kranon, it was a religious inspiration, the source of his heresy.,vo_dino_boss_zaros_cutscene_scene_4a_line_3,425,true,false,true,true
data=col3,dino_boss_miniquest_cutscene_11,The scientist Kerapac took a very different line of inquiry.,vo_dino_boss_zaros_cutscene_scene_4a_line_4,325,false,false,true,true
data=col3,dino_boss_miniquest_cutscene_11,He experimented until the beast was of no more use to him.,vo_dino_boss_zaros_cutscene_scene_4a_line_5,305,false,true,true,true
data=col3,dino_boss_miniquest_cutscene_12,I recommend that you do not allow it to leave the complex.,vo_dino_boss_zaros_cutscene_scene_4a_line_6,265,true,false,true,true
data=col3,dino_boss_miniquest_cutscene_12,The damage it could inflict is considerable.,vo_dino_boss_zaros_cutscene_scene_4a_line_7,305,false,true,true,true

