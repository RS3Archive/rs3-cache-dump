data=col3,To deposit an item in the Bank, simply tap it.
data=col4,The Bank can be used to store any items you don't want to carry.,16763653

// 5332
[dbrow_5332]
table=dbtable_72
data=col3,This menu can be used to set a <col=FFcb05>Bank PIN</col> to keep your items safe.
