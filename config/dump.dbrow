// 5326
[dbrow_5326]
table=dbtable_72
data=col3,You can safely deposit your items in any bank in Gielinor.<br><br>Banks are marked on both the World Map and the Minimap.<br><br>Alternatively, you can drop or destroy items by dragging them out of your Backpack.
data=col4,Your backpack is almost full!,16711680
data=col5,interface_1473:com_4
data=col6,-1
data=col16,rs3_icon_worldmap_bank

