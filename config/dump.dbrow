// 17204
[trh175_promo_info_v2]
table=trh_promo_info
data=col0,Grim Harvest
data=col1,The harvest is upon us! Smash Pumpkins for H'oddments and more!
data=col3,11
data=col5,Smash pumpkins to receive <col=89CFF0>H'oddments</col> and more whilst filling the <col=FF00>Harvest Bonus bar</col>. When the bar is filled, choose between a <col=FF6600>pumpkin modifier</col> or <col=FF6600>reward item</col>.<br><col=89CFF0>H'oddments</col> can be exchanged for <col=8d52e5>unique rewards</col> in the <col=89CFF0>H'oddments store</col> for the duration of the promotion and 7 days afterwards.
data=col8,false
data=col9,Harvest Rewards
data=col10,trh175_promo_info_major_rewards_v2
data=col10,trh175_promo_info_rewards
data=col10,trh175_promo_info_modifiers

