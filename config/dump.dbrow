// 5924
[dbrow_5924]
table=dbtable_40
data=col0,42
data=col1,30
data=col3,black_placeholder,When you failed, I had no choice.,sound_53141,585,false,false,true,true
data=col3,black_placeholder,I needed the children to survive.,sound_53140,302,true,false,true,true

// 5925
[dbrow_5925]
table=dbtable_40
data=col0,43
data=col1,30
data=col3,egw_finale_act2_frame1,,sound_53179,250,true,true,false,false
data=col3,egw_finale_act2_frame2,,sound_53180,250,true,true,false,false
data=col3,egw_finale_act2_frame3,BE NO MORE!,sound_53181,352,true,true,true,true

// 5926
[dbrow_5926]
table=dbtable_40
data=col0,41
data=col2,1561
data=col3,egw_finale_act2_frame1,I took them to Freneskae. I thought we would be safe there.,sound_53146,345,true,true,true,true
data=col3,egw_finale_act2_frame2,Jas found us. There was nothing we could to do stop her reclaiming the eggs.,sound_53150,450,true,true,true,true
data=col3,egw_finale_act2_frame3,She could kill us all with merely a word.,sound_53153,332,true,false,true,true
data=col3,egw_finale_act2_frame3,No power in this universe could stand in her way.<br>I did not expect you to find it in another.,sound_53152,590,false,true,true,true
data=col3,egw_finale_act2_frame4,The shadow leviathan struck without warning.,sound_53155,292,true,false,true,true
data=col3,egw_finale_act2_frame4,I felt its presence tear into our reality.,sound_53145,292,false,true,true,true
data=col3,egw_finale_act2_frame5,It was Kerapac that broke the balance.,sound_53147,292,true,false,true,true
data=col3,egw_finale_act2_frame5,Heedless of the terrible pain his defiance earned him,<br>he directed the full force of his artefacts towards their creator.,sound_53143,560,false,false,true,true
data=col3,egw_finale_act2_frame5,Its power spent, the Needle broke.,sound_53149,292,false,false,true,true
data=col3,egw_finale_act2_frame5,Distracted, Jas was overwhelmed.,sound_53142,322,false,true,true,true
data=col3,egw_finale_act2_frame6,The monstrous intruder dragged its prey back into its own realm.,sound_53154,382,true,false,true,true
data=col3,egw_finale_act2_frame6,Without the Needle, Kerapac was powerless to avoid the same fate.,sound_53156,382,false,true,true,true
data=col3,egw_finale_act2_frame7,Its hunger satisfied, the breach snapped shut, leaving in its place a terrible silence.,sound_53148,620,true,false,true,true
data=col3,egw_finale_act2_frame7,Jas was the greatest of us all. Irreplaceable.,sound_53151,382,false,false,true,true
data=col3,egw_finale_act2_frame7,Her loss forced me to accept something.,sound_53144,352,false,false,true,true
data=col3,egw_finale_act2_frame7,Your survival depends on our deaths. ,sound_53157,600,false,true,true,true

// 5927
[dbrow_5927]
table=dbtable_40
data=col0,40
data=col1,30
data=col3,black_placeholder,So you see, I had no choice.,sound_53163,375,false,false,true,true
data=col3,black_placeholder,For my family to survive, a world had to die.,sound_53161,375,false,false,true,true
data=col3,egw_finale_act3_frame1,They reached down from the sky, the hands of creation itself, to birth their waiting children.,sound_53169,460,true,false,true,true
data=col3,egw_finale_act3_frame1,As they touched the eggs, memories passed from one generation to the next.<br>Aeons of identity, stretching back through time.,sound_53159,562,false,true,true,true
data=col3,egw_finale_act3_frame2,The eggs burst open.,sound_53165,405,true,true,true,true
data=col3,egw_finale_act3_frame3,As the lifeless bodies of the adults fell, the power of the newborn children drained all life from the planet.<br>All life.,sound_53158,715,true,true,true,true
data=col3,egw_finale_act3_frame4,The children. My family. At last, they live.,sound_53164,525,true,false,true,true
data=col3,egw_finale_act3_frame4,They know me. They love me. They spared me.,sound_53168,500,false,false,true,true
