// 8327
[uitutorial_bp3_missions_intro_1]
table=uitutorial_step
data=col3,This is your mission list, where you will find your <col=0x2EF8FF>basic</col>, <col=0x2EF8FF>general</col>, and <col=0x2EF8FF>special</col> missions.
