table=dbtable_189
data=col0,1
data=col3,seq_9789,<col=E80404>Zamorak: </col>,Zamorak,npc_28756,Hear me, citizens of Gielinor. I am Zamorak - rightful ruler of this world.,sound_54448,400,true,true
data=col3,seq_9789,<col=E80404>Zamorak: </col>,Zamorak,npc_28756,Take heed, and hear me with an open mind and a stalwart heart.,sound_54451,400,true,true
data=col3,seq_9789,<col=E80404>Zamorak: </col>,Zamorak,npc_28756,Your whole lives, you have been told to forgo your needs and ambitions. That you must serve the 'greater good'.,sound_54452,480,true,true
data=col3,seq_9789,<col=E80404>Zamorak: </col>,Zamorak,npc_28756,This is a lie. The last stand of false gods, who fear what you might become. ,sound_54453,400,true,true
data=col3,seq_9789,<col=E80404>Zamorak: </col>,Zamorak,npc_28756,I offer you more. A world where strength and ingenuity are rewarded. Where you are master of your own destiny.,sound_54454,490,true,true
data=col3,seq_9789,<col=E80404>Zamorak: </col>,Zamorak,npc_28756,We are coming. My forces will tear down the old world, and from the ashes shall arise something glorious. ,sound_54455,470,true,true
data=col3,seq_9789,<col=E80404>Zamorak: </col>,Zamorak,npc_28756,Join me. Build a world without limits. And cast aside any who stand in your way. ,sound_54456,420,true,true
data=col3,seq_9789,<col=E80404>Zamorak: </col>,Zamorak,npc_28756,As for you, World Guardian... Your attempts to thwart our plans are futile.,sound_54457,370,true,true
data=col3,seq_9789,<col=E80404>Zamorak: </col>,Zamorak,npc_28756,You are unworthy. Interfere further, and yours will be the swift death of a diseased cur.,sound_54458,420,true,true
data=col3,seq_9789,<col=E80404>Zamorak: </col>,Zamorak,npc_28756,Stay cowering behind Guthix's crumbling wards. Rot with the decrepit world you claim to defend.,sound_54449,450,true,true
data=col3,seq_9789,<col=E80404>Zamorak: </col>,Zamorak,npc_28756,This world will burn.,sound_54450,120,true,true

