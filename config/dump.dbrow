// 5371
[dbrow_5371]
table=dbtable_72
data=col3,This part of the interface contains details of various RuneScape minigames.

// 5372
[dbrow_5372]
table=dbtable_72
data=col3,Selecting a minigame will bring up details of the minigame in the area on the right.
data=col5,interface_1344:com_19
data=col6,-1
data=col7,4

// 5373
[dbrow_5373]
table=dbtable_72
data=col3,Here you will see an overview of your chosen minigame, including a brief summary and details of the rewards it offers, and in some cases a button to teleport to the nearest lodestone.
data=col5,interface_1344:com_32
data=col6,-1
