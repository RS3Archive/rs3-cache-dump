// 18136
[uitutorial_rand_party_setup]
table=uitutorial
data=col0,Dungeoneering - Party forming
data=col2,uitutorial_rand_party_setup_0
data=col2,uitutorial_rand_party_setup_1
data=col3,uitutorial_rand_party_setup_0
data=col3,uitutorial_rand_party_setup_1
data=col4,uitutorial_rand_party_setup_0
data=col4,uitutorial_rand_party_setup_1

// 18137
[uitutorial_rand_party_setup_0]
table=uitutorial_step
data=col3,You must be in a <col=FFCB05>party</col> to start Dungeoneering. You can be in a party by <col=FFCB05>yourself</col>, or with up to <col=FFCB05>four other players</col>.
data=col6,rand_party_side_new:party_layer
data=col7,-1
data=col17,"staticons_high_res2_clean,13"
data=col21,true

// 18138
[uitutorial_rand_party_setup_1]
table=uitutorial_step
data=col3,The player who created the party is the <col=FFCB05>party leader</col>. The party leader can <col=FFCB05>choose which dungeon floor</col> to do next, as well as the <col=FFCB05>complexity</col> and <col=FFCB05>size</col> of the dungeon.
data=col6,rand_party_side_new:misc_layer
data=col7,-1
data=col17,"staticons_high_res2_clean,13"
data=col21,true

// 18139
[uitutorial_rand_floor_select]
table=uitutorial
data=col0,Dungeoneering - Floor select
data=col2,uitutorial_rand_floor_select_0
data=col2,uitutorial_rand_floor_select_1
data=col2,uitutorial_rand_floor_select_2
data=col2,uitutorial_rand_floor_select_3
data=col3,uitutorial_rand_floor_select_0
data=col3,uitutorial_rand_floor_select_1
data=col3,uitutorial_rand_floor_select_2
data=col3,uitutorial_rand_floor_select_3
data=col4,uitutorial_rand_floor_select_0
data=col4,uitutorial_rand_floor_select_1
data=col4,uitutorial_rand_floor_select_2
data=col4,uitutorial_rand_floor_select_3

// 18140
[uitutorial_rand_floor_select_0]
table=uitutorial_step
data=col3,When you first start Dungeoneering, only <col=FFCB05>floor 1</col> will be unlocked. You must <col=FFCB05>complete a floor</col> before you can unlock the next one, and you may only <col=FFCB05>access a floor</col> if you have the <col=FFCB05>necessary Dungeoneering level</col>.
data=col6,rand_floor_select:mainmodal_window
data=col7,-1
data=col17,"staticons_high_res2_clean,13"
data=col21,true

// 18141
[uitutorial_rand_floor_select_1]
table=uitutorial_step
data=col3,All members of your party must have the <col=FFCB05>floor unlocked</col> for you to delve into it. To see which floors are unlocked by all players, look at the columns that run vertically down the screen to the left - there's a <col=FFCB05>column for each member of your group</col>.
data=col6,rand_floor_select:floor_select_layer
data=col7,-1
data=col17,"staticons_high_res2_clean,13"
data=col21,true

// 18142
[uitutorial_rand_floor_select_2]
table=uitutorial_step
data=col3,Upon completing a floor for the first time each run, you'll receive a <col=FFCB05>floor buff</col> that will <col=FFCB05>boost various aspects of Daemonheim</col>.
data=col6,rand_floor_select:buff_details_layer
data=col7,-1
data=col17,"staticons_high_res2_clean,13"
data=col21,true

// 18143
[uitutorial_rand_floor_select_3]
table=uitutorial_step
data=col3,The buff you receive <col=FFCB05>cycles through the listed buffs in order</col> - the <col=FFCB05>next buff you'll receive is highlighted</col>. These buffs will <col=FFCB05>automatically reset</col> once you've <col=FFCB05>completed the number of floors available to you</col>.
data=col6,rand_floor_select:buff_details_layer
data=col7,-1
data=col17,"staticons_high_res2_clean,13"
data=col21,true

// 18144
[uitutorial_rand_complexity]
table=uitutorial
data=col0,Dungeoneering - Complexity
data=col2,uitutorial_rand_complexity_0
data=col2,uitutorial_rand_complexity_1
data=col3,uitutorial_rand_complexity_0
data=col3,uitutorial_rand_complexity_1
data=col4,uitutorial_rand_complexity_0
data=col4,uitutorial_rand_complexity_1

// 18145
[uitutorial_rand_complexity_0]
table=uitutorial_step
data=col3,The <col=FFCB05>complexity</col> of a dungeon determines <col=FFCB05>how many of your skills and abilities</col> will be tested. Choosing <col=FFCB05>low complexity</col> will make the dungeon more <col=FFCB05>straightforward</col> to complete, but it will also <col=FFCB05>lower the Dungeoneering XP</col> you receive at the end.
data=col6,rand_complexity_select:mainmodal_window
data=col7,-1
data=col17,"staticons_high_res2_clean,13"
data=col21,true

// 18146
[uitutorial_rand_complexity_1]
table=uitutorial_step
data=col3,When you first start Dungeoneering, only low complexity will be unlocked. You must <col=FFCB05>complete at least one dungeon</col> on low complexity before you can <col=FFCB05>unlock high complexity</col>.
data=col6,rand_complexity_select:mainmodal_window
data=col7,-1
data=col17,"staticons_high_res2_clean,13"
data=col21,true

// 18147
[uitutorial_rand_bind_setup]
table=uitutorial
data=col0,Dungeoneering - Bound items
data=col2,uitutorial_rand_bind_setup_0
data=col2,uitutorial_rand_bind_setup_1
data=col2,uitutorial_rand_bind_setup_2
data=col3,uitutorial_rand_bind_setup_0
data=col3,uitutorial_rand_bind_setup_1
data=col3,uitutorial_rand_bind_setup_2
data=col4,uitutorial_rand_bind_setup_0
data=col4,uitutorial_rand_bind_setup_1
data=col4,uitutorial_rand_bind_setup_2

// 18148
[uitutorial_rand_bind_setup_0]
table=uitutorial_step
data=col3,<col=FFCB05>Equipment</col> and <col=FFCB05>potions</col> you find or make in the dungeon can be <col=FFCB05>bound to you</col> by <col=FFCB05>right-clicking 'Bind'</col> on them.
data=col6,rand_bound_interface:mainmodal_window
data=col7,-1
data=col17,"staticons_high_res2_clean,13"
data=col21,true

// 18149
[uitutorial_rand_bind_setup_1]
table=uitutorial_step
data=col3,Binding an item to yourself means the <col=FFCB05>item is available to use on any floor</col>. You can <col=FFCB05>unbind items by destroying them</col>.
data=col6,rand_bound_interface:mainmodal_window
data=col7,-1
data=col17,"staticons_high_res2_clean,13"
data=col21,true

// 18150
[uitutorial_rand_bind_setup_2]
table=uitutorial_step
data=col3,You can view and manage your bound items here. Loadouts allow you to <col=FFCB05>decide which equipment you start a dungeon with</col>, and can be set up by <col=FFCB05>dragging a bound item over to a loadout slot</col>. As you level up Dungeoneering, you'll <col=FFCB05>unlock more loadout slots</col>.
data=col6,rand_bound_interface:mainmodal_window
data=col7,-1
data=col17,"staticons_high_res2_clean,13"
data=col21,true

// 18151
[uitutorial_rand_storage]
table=uitutorial
data=col0,Dungeoneering - Smuggler's storage
data=col2,uitutorial_rand_storage_0
data=col3,uitutorial_rand_storage_0
data=col4,uitutorial_rand_storage_0

// 18152
[uitutorial_rand_storage_0]
table=uitutorial_step
data=col3,You can <col=FFCB05>store items</col> you find in the dungeon here, and access them on any floor. As you level up Dungeoneering, you'll <col=FFCB05>unlock more storage slots</col>.
data=col6,rand_storage:mainmodal_window
data=col7,-1
data=col17,"staticons_high_res2_clean,13"
data=col21,true

