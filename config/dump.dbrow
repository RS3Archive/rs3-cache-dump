data=col0,9
data=col1,221
data=col3,dino_cutscene_approach_01,The dragon told me the voyage would be treacherous<br>but I have never seen a storm like this one.,sound_46517,400,true,true,true,true
data=col3,dino_cutscene_approach_02,The sea is primordial. It is ancient, and vast, like a thing from another time.<br>The sky is angry. I can feel it.,sound_46518,450,true,false,true,false
data=col3,dino_cutscene_approach_03,The sea is primordial. It is ancient, and vast, like a thing from another time.<br>The sky is angry. I can feel it.,sound_2901,10,false,false,false,false
