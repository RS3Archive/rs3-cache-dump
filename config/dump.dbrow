// 4867
[dbrow_4867]
table=dbtable_156
data=col0,Time to Train
data=col1,It's time for Double XP Live, and that means it's Time to Train!
data=col3,4
data=col5,Use Treasure Hunter keys to open chests and win rewards! Keys can be purchased or earned through completing quests and playing the game. You will also be given free daily keys every day!
data=col6,NEW Bonus Feature!
data=col7,Earn <col=0xFFCB05>progress</col> with every key you use.<br>Fill the progress bar to trigger the <col=0xFFCB05>Bonus Feature</col>.<br>Choose between <col=0xFFCB05>3</col> sets of dummies. One of your options will always either be the new <col=0xFFCB05>Dungeoneering</col> or <col=0xFFCB05>Archaeology</col> skill training dummies.
data=col9,dbrow_6960
data=col9,dbrow_4906

