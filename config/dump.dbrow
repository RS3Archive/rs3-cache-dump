data=col7,1

// 2117
[dbrow_2117]
table=dbtable_72
data=col3,An action-bar is a set of customisable shortcuts to many actions in RuneScape. You can left-click or keybind a slot to perform the action.
data=col5,interface_1670:com_0
data=col6,-1
data=col7,1
data=col21,interface_1670:com_0,-1

// 2118
