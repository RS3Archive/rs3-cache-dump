data=col1,obj_36200
data=col4,0
data=col5,Skill Training Dummy Crates
data=col6,Skill training dummy crates contain dummies which can be placed down to train skills by interacting with them.<br>The skills you can choose from are: Agility, Slayer, Thieving and Hunter.

// 4914
[dbrow_4914]
table=dbtable_158
data=col1,obj_43414
data=col4,0
data=col5,Variety Packs
data=col6,Variety packs contain a selection of protean items and training dummies.<br>Each pack contains a small protean pack, 2 protean powerups and either 3 combat training dummies or a medium skill training dummy crate.

