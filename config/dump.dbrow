// 5363
[dbrow_5363]
table=dbtable_72
data=col3,This tab is designed to introduce you to some of RuneScape's deadliest bosses.<br><br>You can compare the combat level and group size requirements to find something suitable for you and your friends to face!<br><br>It can also be used to view your boss and Slayer monster kills.

// 5364
[dbrow_5364]
table=dbtable_72
data=col3,The drop down switches between boss information, boss kill counts, and Slayer kill counts.
data=col5,interface_753:com_114
data=col6,-1
data=col7,2

// 5365
[dbrow_5365]
table=dbtable_72
data=col3,This will show you your fastest kill time for each boss. It will also show you how many times you have killed the boss.
data=col5,interface_753:com_49
data=col6,-1
data=col7,3

// 5366
[dbrow_5366]
table=dbtable_72
data=col3,The special rewards are the unique drops for each boss.<br><br>Usually, defeating the boss is the only way to get these items as drops.
data=col5,interface_753:com_89
data=col6,-1
data=col7,1

// 5367
[dbrow_5367]
table=dbtable_71
data=col0,Featured Help Button
