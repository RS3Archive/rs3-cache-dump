[trh196_promo_info]
table=trh_promo_info
data=col0,Gifts from the Harvest
data=col1,Stacking bonuses or Hedge Teleport could be available from any Crate Bonus!
data=col3,5
data=col5,Open crates to earn <col=FFCD37>Fallen Leaves</col>, which can be exchanged for Seasonal themed cosmetics from previous years, or to help rack up bonuses to your prizes.
data=col6,Crate Bonuses
data=col7,Crate bonuses are buffs affecting the prizes you receive. You can have several active at once, including: Instant Rewards, Boosted Rarity, Prize Multipliers or Bonus Rewards.
