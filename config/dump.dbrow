// 5063
[dbrow_5063]
table=dbtable_156
data=col0,Rainbow's End
data=col1,Win powerful multipliers and rainbow cosmetics!
data=col2,"trh109_icons,14",75,75
data=col3,5
data=col5,Use Treasure Hunter keys to open chests and win rewards!<br>Treasure Hunter Keys can be purchased or earned through completing quests and playing the game.<br>You will also be given free daily keys every day, but make sure to use them up as they will not carry over.
data=col8,Promotion Information
data=col9,dbrow_5068
data=col9,dbrow_5077

// 5064
[dbrow_5064]
table=dbtable_156
data=col0,Smouldering vs Supernova
data=col1,Choose between smouldering lamps and supreme stars!
data=col3,3
data=col5,Use Treasure Hunter keys to open chests and win rewards!<br>Treasure Hunter Keys can be purchased or earned through completing quests and playing the game.<br>You will also be given free daily keys every day, but make sure to use them up as they will not carry over.
data=col6,Choose Your Chest
data=col7,Choose between a <col=FF0000>Smouldering Chest</col> or <col=3366FF>Supernova Chest</col> with each key for your chance at <col=FF0000>Smouldering Lamps</col> or <col=3366FF>Supreme Stars</col> respectively. Either choice progresses the <col=FFFFFF>Reward Track</col> for even more rewards!
data=col9,dbrow_5682
data=col9,dbrow_5092
data=col9,dbrow_5100

// 5065
[dbrow_5065]
table=dbtable_156
data=col0,Genie's Gift
data=col1,Win a variety of powerful lamps!
data=col3,1
data=col5,Use Treasure Hunter keys to open chests and win rewards!<br>Treasure Hunter Keys can be purchased or earned through completing quests and playing the game.<br>You will also be given free daily keys every day, but make sure to use them up as they will not carry over.
data=col9,dbrow_5108

// 5066
[dbrow_5066]
table=dbtable_156
data=col0,Dragon's Dozen
data=col1,Create your own reward selection!
data=col3,6
data=col5,Select the prizes you want to win from each rarity. After confirming your prizes, open the chest using a Treasure Hunter key for a 100% chance to get one of the rewards you chose! If you happen upon a special chest, your reward will also be multiplied!
data=col6,Black Gem Rewards
data=col7,Small knowledge bombs offer up 50% extra XP for an hour each! Clue scroll boxes contain 2 random clue scrolls. Or you can opt for a random Lucky item for your black gem slot!
data=col8,Promotion Information
data=col9,dbrow_5117
data=col9,dbrow_5125

// 5067
[dbrow_5067]
table=dbtable_156
data=col0,Phoenix Rising
data=col1,Get ready to burn up your Bonus XP with lamps that rise from the ashes!
data=col3,1
data=col5,Use Treasure Hunter keys to open chests and win rewards! Keys can be purchased or earned through completing quests and playing the game. You will also be given free daily keys every day!
data=col6,Phoenix Bonus
data=col7,With every key used, make progress towards your next Phoenix Bonus. When this bonus is active, every key you use will award you with a <col=0xFF6600>phoenix lamp</col>!
data=col9,dbrow_5148

