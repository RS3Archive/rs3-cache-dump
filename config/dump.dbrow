data=col9,2

// 5625
[dbrow_5625]
table=dbtable_72
data=col3,Active prayers will drain your <col=FFCB05>Prayer Points</col>.<br><br>You recharge your <col=FFCB05>Prayer Points</col> by praying at an <col=FFCB05>altar</col>, usually found in a church.
