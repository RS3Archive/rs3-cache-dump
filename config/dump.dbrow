// 7780
[dbrow_7780]
table=dbtable_72
data=col3,The <col=FFCB05>Hermod, the Spirit of War</col> boss encounter can now be accessed.<br><br>Speak to <col=FFCB05>Kharen</col> to travel to <col=FFCB05>Rasial's citadel</col>.
data=col16,rs3_icon_worldmap_demon_raid_site

// 7781
[dbrow_7781]
table=dbtable_72
data=col3,<col=FFCB05>Hermodic plates</col> can be used to upgrade <col=FFCB05>Deathwarden</col> equipment into <col=FFCB05>Deathdealer</col> equipment, the power variant (requires completion of <col=FFCB05>Kili Row</col>).<br><br>You can earn additional <col=FFCB05>Hermodic plates</col> by defeating <col=FFCB05>Hermod, the Spirit of War</col>.
data=col20,obj_55191

// 7782
[dbrow_7782]
