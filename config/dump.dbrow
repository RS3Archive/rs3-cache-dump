// 7245
[quest_fort_casefile_suspect_ellamaria]
table=quest_fort_casefile_entry
data=col1,Queen Ellamaria
data=col2,Queen of Misthalin
data=col3,She/Her
data=col5,quest_fort_ellamaria
data=col7,5000
data=col11,A former commoner and renowned warrior, she is loud, brash, and dramatic.
data=col11,She lacks the tact required for diplomacy, but is good at getting things done.
data=col15,false

// 7246
[quest_fort_casefile_suspect_simon]
table=quest_fort_casefile_entry
data=col1,Simon Bullace
data=col2,King Roald's Alchemist
data=col3,He/Him
data=col5,quest_fort_simon_hatless
data=col6,125
data=col7,5000
data=col11,An alchemist under the service of King Roald.
data=col11,He is highly intelligent but was relegated to being the royal wine tester.
data=col11,He seems to be incredibly bitter about this.
data=col15,false

