[uitutorial_necromancy_overview_end_0]
table=uitutorial_step
data=col3,As you <col=FFCB05>level up Necromancy</col>, more souls will <col=FFCB05>return to the City of Um</col>.<br><br>Come back and check in occasionally, as you never know who might show up!
data=col17,"rs3_icon_lodestone_insignia,29"

