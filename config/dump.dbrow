// 2530
[dbrow_2530]
table=dbtable_72
data=col3,A quest's name is red if you have <col=FFCB05>not started</col> it.<br>When you have started a quest, it will change colour to yellow to show it's <col=FFCB05>in progress</col>, and to green when you've <col=FFCB05>completed</col> the quest.
