// 3304
[dbrow_3304]
table=dbtable_40
data=col0,16
data=col1,30
data=col3,arch_cutscene_stormguard_01,The aviansie's use of floating citadels is already well known now,<br>thanks to the resurgence of their use as clan citadels.,sound_47953,450,true,false,true,true
data=col3,arch_cutscene_stormguard_01,Yet Stormguard, it seems, was an incredibly<br>well-kept secret for it to be rediscovered only now, many ages on.,sound_47954,450,false,true,true,true
data=col3,arch_cutscene_stormguard_02a,What secrets has it held for all this time, floating above our very heads?<br>What wonders might it hold?,sound_47955,400,true,false,true,true
data=col3,arch_cutscene_stormguard_02a,The monolith has no further information to share here.<br>Stormguard is a mystery even to it...and it wants to learn.,sound_47956,550,false,true,true,true

// 3305
[dbrow_3305]
table=dbtable_40
data=col0,17
data=col1,30
data=col3,arch_cutscene_stormguard_01,Stormguard was Armadyl's secret research, development and<br>weapons testing facility, within which the Godsword was forged.,sound_47933,450,true,false,true,true
data=col3,arch_cutscene_stormguard_01,Its presence shrouded in secrecy, along with a cloaking storm cloud,<br>and forever moving across the skies to protect its existence.,sound_47934,550,false,true,true,true
data=col3,arch_cutscene_stormguard_02b,Its many secrets lost to time, as the citadel was<br>sundered by the Forinthry explosion and its remnants set adrift.,sound_47935,500,true,false,true,true
data=col3,arch_cutscene_stormguard_02b,Yet now, a chance to recover the ahead-of-their-time designs<br>of the aviansie alchemist and inventor 'Howl'.,sound_47936,500,false,true,true,true

