// 5924
[egwd_finale_quest_post_cathedral_defence_cutscene]
table=image_sequence
data=col0,42
data=col1,30
data=col3,black_placeholder,When you failed, I had no choice.,egw_quest_end_of_act1_when_you_failed_alt1,585,false,false,true,true
data=col3,black_placeholder,I needed the children to survive.,egw_quest_end_of_act1_i_needed_the_children_to_survive,302,true,false,true,true

// 5925
[egwd_finale_quest_jas_arrival_cutscene]
table=image_sequence
data=col0,43
data=col1,30
data=col3,egw_finale_act2_frame1,,egw_quest_jas_arrival_rumble_01,250,true,true,false,false
data=col3,egw_finale_act2_frame2,,egw_quest_jas_arrival_rumble_02,250,true,true,false,false
data=col3,egw_finale_act2_frame3,BE NO MORE!,egw_quest_jas_be_no_more_v2,352,true,true,true,true

// 5926
[egwd_finale_quest_post_erebus_cutscene]
table=image_sequence
data=col0,41
data=col2,1561
data=col3,egw_finale_act2_frame1,I took them to Freneskae. I thought we would be safe there.,egw_quest_end_of_act2_i_took_them_to_freneskae_alt3,345,true,true,true,true
data=col3,egw_finale_act2_frame2,Jas found us. There was nothing we could to do stop her reclaiming the eggs.,egw_quest_end_of_act2_jas_found_us_alt5,450,true,true,true,true
data=col3,egw_finale_act2_frame3,She could kill us all with merely a word.,egw_quest_end_of_act2_she_could_kill_us_all,332,true,false,true,true
data=col3,egw_finale_act2_frame3,No power in this universe could stand in her way.<br>I did not expect you to find it in another.,egw_quest_end_of_act2_no_power_in_this_universe_could_stand_in_her_way,590,false,true,true,true
data=col3,egw_finale_act2_frame4,The shadow leviathan struck without warning.,egw_quest_end_of_act2_the_shadow_leviathan_struck_alt4,292,true,false,true,true
data=col3,egw_finale_act2_frame4,I felt its presence tear into our reality.,egw_quest_end_of_act2_i_felt_its_presence_tear_into_our_reality_alt1,292,false,true,true,true
data=col3,egw_finale_act2_frame5,It was Kerapac that broke the balance.,egw_quest_end_of_act2_it_was_kerapac_that_broke_the_balance,292,true,false,true,true
data=col3,egw_finale_act2_frame5,Heedless of the terrible pain his defiance earned him,<br>he directed the full force of his artefacts towards their creator.,egw_quest_end_of_act2_heedless_of_the_terrible_pain,560,false,false,true,true
data=col3,egw_finale_act2_frame5,Its power spent, the Needle broke.,egw_quest_end_of_act2_its_power_spent,292,false,false,true,true
data=col3,egw_finale_act2_frame5,Distracted, Jas was overwhelmed.,egw_quest_end_of_act2_distracted_jas_was_alt1,322,false,true,true,true
data=col3,egw_finale_act2_frame6,The monstrous intruder dragged its prey back into its own realm.,egw_quest_end_of_act2_the_monstrous_intruder,382,true,false,true,true
data=col3,egw_finale_act2_frame6,Without the Needle, Kerapac was powerless to avoid the same fate.,egw_quest_end_of_act2_without_the_needle,382,false,true,true,true
data=col3,egw_finale_act2_frame7,Its hunger satisfied, the breach snapped shut, leaving in its place a terrible silence.,egw_quest_end_of_act2_its_hunger_satisfied_the_breach_alt1,620,true,false,true,true
data=col3,egw_finale_act2_frame7,Jas was the greatest of us all. Irreplaceable.,egw_quest_end_of_act2_jas_was_the_greatest_of_us_all,382,false,false,true,true
data=col3,egw_finale_act2_frame7,Her loss forced me to accept something.,egw_quest_end_of_act2_her_loss_forced_me_to_accept_something_alt2,352,false,false,true,true
data=col3,egw_finale_act2_frame7,Your survival depends on our deaths. ,egw_quest_end_of_act2_your_survival_depends_on_our_deaths,600,false,true,true,true

// 5927
[egwd_finale_quest_post_seren_fight_cutscene]
table=image_sequence
data=col0,40
data=col1,30
data=col3,black_placeholder,So you see, I had no choice.,egw_quest_end_of_act3_so_you_see_alt1,375,false,false,true,true
data=col3,black_placeholder,For my family to survive, a world had to die.,egw_quest_end_of_act3_for_my_family_alt2,375,false,false,true,true
data=col3,egw_finale_act3_frame1,They reached down from the sky, the hands of creation itself, to birth their waiting children.,egw_quest_end_of_act3_they_reached_down_alt2,460,true,false,true,true
data=col3,egw_finale_act3_frame1,As they touched the eggs, memories passed from one generation to the next.<br>Aeons of identity, stretching back through time.,egw_quest_end_of_act3_as_they_touched_the_eggs_alt2,562,false,true,true,true
data=col3,egw_finale_act3_frame2,The eggs burst open.,egw_quest_end_of_act3_the_eggs_burst_open_alt5,405,true,true,true,true
data=col3,egw_finale_act3_frame3,As the lifeless bodies of the adults fell, the power of the newborn children drained all life from the planet.<br>All life.,egw_quest_end_of_act3_as_thelifeless_bodies_of_the_adults_fell_alt1,715,true,true,true,true
data=col3,egw_finale_act3_frame4,The children. My family. At last, they live.,egw_quest_end_of_act3_the_children_my_family,525,true,false,true,true
data=col3,egw_finale_act3_frame4,They know me. They love me. They spared me.,egw_quest_end_of_act3_they_know,500,false,false,true,true
data=col3,egw_finale_act3_frame4,They have fulfilled their birthright. All other life on Iaia is gone.,egw_quest_end_of_act3_they_have_fulfilled_their_brithright_alt1,495,false,false,true,true
data=col3,egw_finale_act3_frame4,But you...survived.,egw_quest_end_of_act3_but_you_world_guardian_survived_alt1,345,false,false,true,true
data=col3,egw_finale_act3_frame4,How?,egw_quest_end_of_act3_how_alt1,315,false,true,true,true

