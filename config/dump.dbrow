// 4364
[egwd_wen_opening_cutscene]
table=image_sequence
data=col0,36
data=col1,30
data=col3,egwd_glacor_front_cutscene_01,Leng was one of the first planets created by the Elder Gods.,egwd_wen_vo_cs_001,350,false,false,true,true
data=col3,egwd_glacor_front_cutscene_01,It was no paradise, but it birthed an industrious civilisation whose name is now long forgotten.,egwd_wen_vo_cs_002,380,false,true,true,true
data=col3,egwd_glacor_front_cutscene_02,When the icy comets appeared in the sky, the people of Leng had no idea what awaited them.,egwd_wen_vo_cs_003,350,false,true,true,true
data=col3,egwd_glacor_front_cutscene_03,The crashing comets wrought devastation as they landed, but something worse rose out of the craters..,egwd_wen_vo_cs_004,375,true,false,true,true
data=col3,egwd_glacor_front_cutscene_03,The incorporeal invaders formed towering suits of armour from the ice they brought with them.,egwd_wen_vo_cs_005,350,false,true,true,true
data=col3,egwd_glacor_front_cutscene_04,That same ice spread across the whole world, covering the cities and freezing their people.,egwd_wen_vo_cs_006,370,true,false,true,true
data=col3,egwd_glacor_front_cutscene_04,Their work done, the glacors stood vigil over a silent, dead world for countless aeons.,egwd_wen_vo_cs_007,390,false,true,true,true
data=col3,egwd_glacor_front_cutscene_05,When the Elder God Wen needed powerful servants, she found them waiting in this inhospitable place.,egwd_wen_vo_cs_008,390,true,false,true,true
data=col3,egwd_glacor_front_cutscene_05,Anathema suffused the planet and its denizens. Could she really unleash them against Gielinor - the hatchery for her precious egg?,egwd_wen_vo_cs_009,450,false,false,true,true
data=col3,egwd_glacor_front_cutscene_05,Unwilling to approach such tainted beings, she opened portals for them, and turned her face from the destruction to come.,egwd_wen_vo_cs_010,450,false,false,true,true

