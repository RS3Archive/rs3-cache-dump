[uitutorial_necromancy_overview_0]
table=uitutorial_step
data=col3,On your journey, <col=FFCB05>perform rituals</col> and <col=FFCB05>defeat monsters in combat</col> to level the skill.<br>As you grow, <col=FFCB05>learn new abilities</col>, <col=FFCB05>upgrade your equipment</col> and <col=FFCB05>complete quests</col> that tell the story of <col=FFCB05>Rasial, the First Necromancer</col>.
data=col5,Your Necromancy adventure has begun!,15777401
data=col17,skill_icon_necromancy_35px

