// 4409
[dbrow_4409]
table=dbtable_94
data=col0,30
data=col1,Shadow's Grace
data=col2,Reduces cooldown of Surge, Escape, Bladed Dive and Barge by 50%, but these abilities no longer generate adrenaline.
data=col5,50
data=col6,arch_icon_relic_64px_shadows_grace
data=col7,arch_icon_relic_64px_shadows_grace
