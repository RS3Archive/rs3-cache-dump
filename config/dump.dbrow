// 7015
[dbrow_7015]
table=dbtable_40
data=col0,47
data=col1,241
data=col3,quest_daughter_adrasteia_speech_frame1,,sound_2901,100,true,false,false,false
data=col3,quest_daughter_adrasteia_speech_frame1,I am soon to be crowned. It is a burden that I do not take lightly.,sound_55690,310,false,false,true,true
data=col3,quest_daughter_adrasteia_speech_frame1,As Basilissa, it is my duty to see that the kingdoms are protected.,sound_55684,275,false,false,true,true
data=col3,quest_daughter_adrasteia_speech_frame1,Right now, there is one looming threat that haunts me; that threatens us all.,sound_55692,490,false,false,true,true
data=col3,quest_daughter_adrasteia_speech_frame2,The Civil War is over. Bilrach won.,sound_55693,230,false,false,true,true
data=col3,quest_daughter_adrasteia_speech_frame2,The demons, defeated, fell in line and joined the ranks of his army.,sound_55695,400,false,false,true,true
data=col3,quest_daughter_adrasteia_speech_frame2,Bilrach is in a position to launch a full-scale invasion.,sound_55685,245,false,false,true,true
data=col3,quest_daughter_adrasteia_speech_frame2,But it is not enough. The powerful always crave more power.,sound_55686,320,false,false,true,true
data=col3,quest_daughter_adrasteia_speech_frame2,He greedily seeks more ways to expand his influence and cement his dominance.,sound_55689,400,false,false,true,true
data=col3,quest_daughter_adrasteia_speech_frame2,Even now, he gathers his forces and spreads out across the world in search of something.,sound_55688,400,false,false,true,true
data=col3,quest_daughter_adrasteia_speech_frame2,Lost magic? An artefact?,sound_55691,155,false,false,true,true
data=col3,quest_daughter_adrasteia_speech_frame2,Whatever he is trying to do, it represents a terrible threat to the rest of the world.,sound_55697,315,false,false,true,true
data=col3,quest_daughter_adrasteia_speech_frame1,We must stop him. We must put an end to his reign, before it begins.,sound_55696,545,false,false,true,true
data=col3,quest_daughter_adrasteia_speech_frame1,,sound_2901,100,false,true,false,false

