table=dbtable_40
data=col0,35
data=col1,30
data=col3,egwd_nodon_front_cutscene_01,My home, my civilisation, destroyed.,sound_50501,350,false,false,true,true
data=col3,egwd_nodon_front_cutscene_01,My people, cursed, bound, in pain. United in our suffering.,sound_50503,440,false,false,true,true
data=col3,egwd_nodon_front_cutscene_01,I could not imagine a worse fate.,sound_50495,300,false,true,true,true
data=col3,egwd_nodon_front_cutscene_02,My imagination was lacking.,sound_50502,260,true,false,true,true
data=col3,egwd_nodon_front_cutscene_02,Bound once more to Her service, now I suffer alone.,sound_50497,350,false,false,true,true
data=col3,egwd_nodon_front_cutscene_02,I am commanded to secure the eggs.,sound_50499,300,false,false,true,true
data=col3,egwd_nodon_front_cutscene_02,For this I require an army.,sound_50498,300,false,true,true,true
data=col3,egwd_nodon_front_cutscene_03,The Nodon dragonkin. Cowards.,sound_50508,300,false,false,true,true
data=col3,egwd_nodon_front_cutscene_03,Rather than lift a finger they slept through the curse.,sound_50505,300,false,false,true,true
data=col3,egwd_nodon_front_cutscene_03,They will serve me dutifully.,sound_50511,300,false,true,true,true
data=col3,egwd_nodon_front_cutscene_04,The Needle. The Conduit. The very tools of my oppressor.,sound_50507,330,false,false,true,true
data=col3,egwd_nodon_front_cutscene_04,The source of my power. The walls of my prison.,sound_50510,300,false,false,true,true
data=col3,egwd_nodon_front_cutscene_04,As long as I wield them I can never be free, but she will not let me give them up.,sound_50496,460,false,true,true,true
data=col3,egwd_nodon_front_cutscene_05,Jas seeks only to preserve what is left of her kind. For that she would trade the universe.,sound_50500,500,false,false,true,true
data=col3,egwd_nodon_front_cutscene_05,Once I would have made the same trade.,sound_50504,350,false,false,true,true
data=col3,egwd_nodon_front_cutscene_05,The only thing that matters to me now is my freedom. Let everything else wither.,sound_50509,430,false,true,true,true

