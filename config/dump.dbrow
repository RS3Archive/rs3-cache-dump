data=col1,Rodney Midas
data=col2,Duke Hoarse's Fiance
data=col3,He/Him/They
data=col5,quest_fort_rodney_hatless
data=col7,5000
data=col11,Rodney is a flamboyant socialite who has had numerous spouses throughout the years.
data=col11,Rodney insists he is marrying the Duke for love.
data=col15,false

// 7251
[quest_fort_casefile_suspect_princess]
