// 6096
[dbrow_6096]
table=dbtable_156
data=col0,Time Crash
data=col1,Time has fractured! Rewards and modifiers are falling through time. Use them quickly, as they won't stay for long.
data=col3,12
data=col5,Every 2 hours, the active modifier changes. Make use of them while they last.<br>If you don't like the active modifier, you can reroll a random alternative for Oddments.
data=col8,Promotion Information
data=col9,dbrow_6098

// 6097
[dbrow_6097]
table=dbtable_156
data=col0,Rainbow Trail
data=col1,Rainbow Dust, modifiers and multipliers up to x7!
data=col3,5
data=col5,Open the Rainbow Chest to receive a prize with a <col=F7F7F7>multiplier</col> up to <col=F7F7F7>x7</col>!
data=col6,Rainbow Modifier
data=col7,Gain more <col=F7F7F7>Rainbow Dust</col> by getting the <col=F7F7F7>Rainbow Dust</col> modifier to the front of the trail.<br>Spend the <col=F7F7F7>Rainbow Dust</col> to get a <col=F7F7F7>Rainbow Modifier</col> that will increase your upcoming multipliers!
data=col8,Promotion Information
