// 5405
[dbrow_5405]
table=dbtable_72
data=col3,This tab displays your most recent buy and sell offers, letting you see what you paid or sold for in recent transactions.

// 5406
[dbrow_5406]
table=dbtable_72
data=col3,<col=00FF99>Left-click</col> to repeat an offer in the list, with the option to change quantity and price settings.

// 5407
[dbrow_5407]
table=dbtable_72
data=col3,<col=00FF99>Tap</col> to repeat an offer in the list, with the option to change quantity and price settings.

// 5408
[dbrow_5408]
table=dbtable_72
data=col3,<col=00FF99>Right-click</col> to repeat an offer in the list, with identical quantity and price settings.

// 5409
[dbrow_5409]
table=dbtable_72
data=col3,<col=00FF99>Long-press</col> to repeat an offer in the list, with identical quantity and price settings.

