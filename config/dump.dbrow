// 3563
[quest_dm_lab_destroy_cutscene]
table=image_sequence
data=col0,20
data=col2,1484
data=col3,quest_dm_lab_escape1,Kerapac's life was spent fighting to free his people from the elder gods' chains.<br>But in his hubris, he succeeded only in chaining himself and the unwitting Nodon.,vo_dm_seren_cutscene_2_slide_1_line_1,700,true,false,true,true
data=col3,quest_dm_lab_escape1,From below, a great shudder rose. The walls of the chamber began to buckle and crumble.<br>A mountain fell on Kerapac's device, annihilating it.,vo_dm_seren_cutscene_2_slide_1_line_2,600,false,false,true,true
data=col3,quest_dm_lab_escape1,Kerapac and the World Guardian fled the ruins to avoid the same fate.,vo_dm_seren_cutscene_2_slide_1_line_3,320,false,true,true,true
data=col3,quest_dm_lab_escape2,The island of Anachronia was calm and still, blissfully unaware of the rising menace.,vo_dm_seren_cutscene_2_slide_2_line_1,360,true,false,true,true
data=col3,quest_dm_lab_escape2,Then, a gentle rumbling. Slowly it grew and grew until it felt<br>as if the ground beneath their feet would tear itself apart.,vo_dm_seren_cutscene_2_slide_2_line_2,550,false,true,true,true
data=col3,quest_dm_lab_escape3,The elder god Ful cleaved through the earth, and in her rage tore the volcano asunder.,vo_dm_seren_cutscene_2_slide_3_line_1,520,true,false,true,true
data=col3,quest_dm_lab_escape3,The elder gods were awake, and they were not pleased.,vo_dm_seren_cutscene_2_slide_3_line_2,550,false,false,true,true

// 3564
[quest_dm_dragonkin_cutscene]
table=image_sequence
data=col0,21
data=col2,1484
data=col3,quest_dm_dragonkin1,The dragonkin of the Dactyl were well regarded for their scientific prowess,<br> and none were as renowned as Kerapac.,vo_dm_seren_cutscene_1_slide_1_line_1,540,true,false,true,true
data=col3,quest_dm_dragonkin1,It was to riotous applause that Kerapac unveiled his latest invention.<br> A device he promised would spark a new dawn of dragonkin science. ,vo_dm_seren_cutscene_1_slide_1_line_2,520,false,false,true,true
data=col3,quest_dm_dragonkin1,A machine capable of generating limitless power by flooding the world with corruption.,vo_dm_seren_cutscene_1_slide_1_line_3,400,false,false,true,true
data=col3,quest_dm_dragonkin1,The possibilities were endless.<br>He believed that with power of this scale, the dragonkin would<br>rival the creators themselves.,vo_dm_seren_cutscene_1_slide_1_line_4,580,false,false,true,true
data=col3,quest_dm_dragonkin1,Pride precedes a fall. ,vo_dm_seren_cutscene_1_slide_1_line_5,190,false,true,true,true
data=col3,quest_dm_dragonkin2,Before Kerapac could celebrate his creation,<br>the Elder Gods' displeasure was made known. ,vo_dm_seren_cutscene_1_slide_2_line_1,380,true,false,true,true
data=col3,quest_dm_dragonkin2,Jas, the eldest of them, laid waste to the dragonkin cities.,vo_dm_seren_cutscene_1_slide_2_line_2,270,false,false,true,true
data=col3,quest_dm_dragonkin2,In moments, the work of centuries was undone<br> and the dragonkin fled in terror. ,vo_dm_seren_cutscene_1_slide_2_line_3,410,false,true,true,true
data=col3,quest_dm_dragonkin3,Jas bound the dragonkin to the Catalyst,<br> an elder artefact of great power. ,vo_dm_seren_cutscene_1_slide_3_line_1,340,true,false,true,true
data=col3,quest_dm_dragonkin3,The dragonkin sought the power of the Elder Gods,<br> and their wish was granted.  ,vo_dm_seren_cutscene_1_slide_3_line_2,380,false,false,true,true
data=col3,quest_dm_dragonkin3,Pride precedes a fall. ,vo_dm_seren_cutscene_1_slide_3_line_3,400,false,true,true,true

