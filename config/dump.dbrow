table=dbtable_40
data=col0,34
data=col1,30
data=col3,quest_senntisten_cutscene_1,The elder gods must touch the eggs to hatch them correctly.,sound_50289,400,true,false,true,true
data=col3,quest_senntisten_cutscene_1,If they make a direct assault, their young could be destroyed.,sound_50290,400,false,true,true,true
data=col3,quest_senntisten_cutscene_2,If they cannot attack themselves, they will send forces both martial and magical.,sound_50284,450,true,false,true,true
data=col3,quest_senntisten_cutscene_2,We cannot know who, but they will be powerful. We need a defensible location.,sound_50291,450,false,true,true,true
data=col3,quest_senntisten_cutscene_3,We must gather the gods. They can drain the eggs to keep them from hatching.,sound_50292,500,true,false,true,true
data=col3,quest_senntisten_cutscene_3,It falls to their followers to hold off whatever is coming.,sound_50285,400,false,true,true,true
data=col3,quest_senntisten_cutscene_4,The battle to come will be apocalyptic. The world is at stake.,sound_50287,450,true,false,true,true
data=col3,quest_senntisten_cutscene_4,We must keep the fight away from the common people.,sound_50293,400,false,true,true,true
data=col3,quest_senntisten_cutscene_5,My agents recently uncovered a location which is both fortified and remote.,sound_50286,450,true,false,true,true
data=col3,quest_senntisten_cutscene_5,A place I know well.,sound_50283,200,false,false,true,true
data=col3,quest_senntisten_cutscene_5,The City of Senntisten...,sound_50288,200,false,true,true,true

