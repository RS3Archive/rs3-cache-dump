// 1077
[cheevo_atwild_elite_reward]
category=atset
runescore=25
reward=Permanent benefits:<br>- All of the benefits from the easy, medium & hard task set.<br>- +33.3% total chance to receive magical thread when crafting runes via the abyss with the Wilderness sword equipped or in your backpack.<br>- +250% Prayer XP when offering bones or ashes at the Wilderness Chaos Altar.<br>- Searing ashes will always drop noted when carrying the Wilderness sword.<br>- Free teleports to the Wilderness Agility course with the Wilderness sword.<br>- Teleports with the Wilderness sword will work from level 30 Wilderness up from level 20.<br>- Improved Ancient warrior equipment drop rates when defeating revenants in the Forinthry dungeon.<br>- When in the Wilderness, completion of the Animal Magnetism quest will allow team capes to provide the effects of the Ava's device.
name=Wilderness Set Tasks - Elite
desc=0,Given by Kolodion, in the Mage Arena bank, for completing all Elite Tasks in the Wilderness.
sprite="shields,83"
unknown22=5
