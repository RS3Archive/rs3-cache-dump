// 4782
[clientscript,clan_build_resource_mouseover](component $component0, int $int1, int $int2)
def_graphic $graphic3 = null;
def_graphic $graphic4 = null;
switch_int ($int1) {
    case 1 :
        $graphic3 = "aif_resources_progress_bar,7";
        $graphic4 = "aif_resources_progress_bar,3";
    case 2 :
        $graphic3 = "aif_resources_progress_bar,6";
        $graphic4 = "aif_resources_progress_bar,2";
    case 3 :
        $graphic3 = "aif_resources_progress_bar,5";
        $graphic4 = "aif_resources_progress_bar,1";
    case 4 :
        $graphic3 = "aif_resources_progress_bar,4";
        $graphic4 = "aif_resources_progress_bar,0";
}
if ($int2 = 1) {
    if_setgraphic($graphic3, $component0);
} else {
    if_setgraphic($graphic4, $component0);
}
