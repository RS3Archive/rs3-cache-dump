// 7984
[clientscript,script7984](int $int0)
%myq6_barricade_starttime = clientclock;
%myq6_barricade_endtime = calc(clientclock + $int0 * 30);
~aif_progressbar_set(100, myq6_barricade_timer:green_large_progress_value_layer, myq6_barricade_timer:green_large_progress_text);
if_setontimer("script7985", myq6_barricade_timer:title_layer);
