// 4660
[clientscript,script4660](component $component0)
def_int $int1 = scale(%fremsaga_hp_3, 3200, 100);
if_settext(tostring(%fremsaga_hp_3), $component0);
~aif_progressbar_set($int1, fremsaga_signature_healthoverlay:ariane_large_progress_value_layer, fremsaga_signature_healthoverlay:ariane_large_progress_text);
if (%fremsaga_hp_3 <= 1000) {
    if_setmodelanim(human_update_chathead_fear_extreme_len1, fremsaga_signature_healthoverlay:arianehead);
} else {
    if_setmodelanim(human_update_chathead_neutral_idle, fremsaga_signature_healthoverlay:arianehead);
}
