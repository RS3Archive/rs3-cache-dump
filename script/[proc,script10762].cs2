// 10762
[proc,script10762](component $component0, int $int1, int $int2, int $int3)
if ($component0 = null) {
    return;
}
def_int $int4 = calc(if_getwidth($component0) / 2);
if ($int1 > -1) {
    while ($int1 <= $int2 & cc_find($component0, $int1) = true) {
        cc_setposition(calc(cc_getx + cc_getwidth / 2 - $int4 + $int3), cc_gety, ^setpos_abs_centre, ^setpos_abs_top);
        $int1 = calc($int1 + 1);
    }
