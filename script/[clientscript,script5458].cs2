// 5458
[clientscript,script5458](component $component0, int $int1, int $int2, int $int3, int $int4, string $string0)
if ($int4 ! -1 & calc(clientclock + 50) > $int4) {
    ~script8800($string0, $component0, $int1);
    return;
}
def_string $string1 = "Total XP: <~total_xp_string($int2)>";
if ($int2 = 0 & ~total_bonus_xp = true) {
    $string1 = append($string1, "<br>Bonus XP: <col=00FF00><~script9202>");
