// 801
[clientscript,script801]
switch_int (%boss_instance_current_boss_client) {
    case 999, 2017, 1000, 1001 :
        ~script12252(%boss_instance_client_fight_length, %boss_instance_client_fight_length);
        if_setontimer("script12251(clientclock, %boss_instance_client_fight_length)", timed_kill:time_text);
    case default :
        ~script4172(%boss_instance_client_timer_elapsed);
        if_setontimer("script2959(clientclock)", timed_kill:time_text);
}
