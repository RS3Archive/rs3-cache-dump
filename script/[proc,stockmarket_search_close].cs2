// 15047
[proc,stockmarket_search_close]
if (compare(%p_dialog_input, "") = 0 & compare(%stock_search_save, "") = 0) {
    if_sethide(false, stockmarket:search_warning_layer);
    ~script11704;
} else {
    if_settext(escape(%p_dialog_input), stockmarket:search_input_display);
    %stock_search_save = %p_dialog_input;
    if_sethide(false, stockmarket:search_input_clickout);
    if_setonclick("stockmarket_clear_search", stockmarket:search_input_clickout);
    ~script15054;
}
