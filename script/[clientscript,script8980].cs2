if_sethide(true, 6awe1_onboarding:newui_edit);
if_sethide(true, 6awe1_onboarding:newui_options);
if_sethide(true, 6awe1_onboarding:newui_menu);
def_component $component1 = null;
switch_int (%6awe1_tab_selected) {
    case 0 :
        $component1 = 6awe1_onboarding:welcome_layer;
    case 1 :
        $component1 = 6awe1_onboarding:html5_content;
    case 2 :
        switch_int (%6awe1_page_selected) {
            case 1 :
                $component1 = 6awe1_onboarding:newui_overview;
            case 2 :
                $component1 = 6awe1_onboarding:newui_moving;
            case 3 :
                $component1 = 6awe1_onboarding:newui_adding;
