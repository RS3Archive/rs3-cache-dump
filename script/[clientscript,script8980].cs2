            case 7 :
                $component1 = 6awe1_onboarding:newui_edit;
        }
    case 3 :
        switch_int (%6awe1_page_selected) {
            case 1 :
                $component1 = 6awe1_onboarding:combat_features;
            case 2 :
                $component1 = 6awe1_onboarding:combat_actionbar;
            case 3 :
                $component1 = 6awe1_onboarding:combat_academy;
        }
    case 4 :
        $component1 = 6awe1_onboarding:world_event;
