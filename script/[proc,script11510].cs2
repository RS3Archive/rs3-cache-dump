// 11510
[proc,script11510]
def_int $int0 = if_getheight(mtxmgt_colour_overlay:premium_layer);
if_setsize(if_getwidth(mtxmgt_colour_overlay:colour_window), calc(if_getheight(mtxmgt_colour_overlay:colour_window) - $int0), ^setsize_abs, ^setsize_abs, mtxmgt_colour_overlay:colour_window);
if_setposition(if_getx(mtxmgt_colour_overlay:colour_window), if_gety(mtxmgt_colour_overlay:colour_window), ^setpos_abs_left, ^setpos_abs_top, mtxmgt_colour_overlay:colour_window);
