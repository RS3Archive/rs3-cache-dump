// 17320
[proc,script17320]
def_component $component0 = trh192_overlay:target_progress_click_layer;
def_int $int1 = 24;
def_string $string0 = "";
if (~script6431 = false) {
    $string0 = "Current progress: <tostring(calc(%trh192_target_score * 25))>/<tostring(calc(24 * 25))><br>Gain points with each arrow shot at the target, complete this progress bar for your next <col=89CFF0>Target Points reward</col>.";
    if_setonmouserepeat("script3876($string0, $component0, -1)", $component0);
