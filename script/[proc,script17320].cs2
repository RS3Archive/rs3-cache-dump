    $string0 = "You have a chance of hitting the target in different locations for:<br>+100 points.<br>+75 points.<br>+50 points.<br>+25 points.<br>Reach <tostring(calc(24 * 25))> points to earn the <col=89CFF0>Target Points reward</col>.";
