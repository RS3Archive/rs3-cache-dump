        }
        $int3, $int4 = ~script17095($int3, $int4, $int1, $int5, "Final reclaim cost:", 1, $long6);
    }
}
$int4 = calc($int4 + 5);
$int6 = ~script15891($string1, $int2, museo_sans_13pt_regular, 0);
~cc_add_text(death:cost_info, $int3++, 0, $int4, ^setpos_abs_left, ^setpos_abs_top, 0, $int6, ^setsize_minus, ^setsize_abs, text_body_default, $string1);
