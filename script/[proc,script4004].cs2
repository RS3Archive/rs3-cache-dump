// 4004
[proc,script4004](obj $obj0)
if (oc_category($obj0) = trh154_lamp) {
    if_sethide(true, xp_reward:titlebox);
    if_sethide(false, xp_reward:xp_type_choice);
    if_settext("(+<tostring(oc_param($obj0, xp_reward_modifier_bonus))>%)", xp_reward:xp_type_2_modifier);
} else {
    if_sethide(false, xp_reward:titlebox);
    if_sethide(true, xp_reward:xp_type_choice);
}
