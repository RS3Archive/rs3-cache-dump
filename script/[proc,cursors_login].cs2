// 1129
[proc,cursors_login]
if (~is_mobile_client = true) {
    setdefaultcursors(null, null);
    sethardcodedopcursors(null, null);
    clientoption_set(^clientoption_custom_cursors, 0);
} else {
    ~script3123;
    sethardcodedopcursors(cursor_use, null);
    if (%option_cursor = false | %option_cursor = true) {
        clientoption_set(^clientoption_custom_cursors, ~bool_to_int(%option_cursor));
    } else {
        %option_cursor = true;
        clientoption_set(^clientoption_custom_cursors, 1);
    }
}
