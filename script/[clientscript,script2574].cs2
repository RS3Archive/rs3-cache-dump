// 2574
[clientscript,script2574]
def_int $int0 = 0;
def_int $int1 = 0;
def_int $int2 = scale(%rcguild_activity, 1000, 100);
if ($int2 < 1) {
    $int2 = 1;
}
if ($int2 > 100) {
    $int2 = 100;
}
$int0 = enum(int, int, rcguild_activity_bar_position, $int2);
$int1 = enum(int, int, rcguild_activity_bar_size, $int2);
if (%rcguild_team = 1) {
    if_setposition(481, $int0, ^setpos_abs_left, ^setpos_abs_top, rcguild_overlay:yellow_activity_bar_fill);
    if_setsize(16, $int1, ^setsize_abs, ^setsize_abs, rcguild_overlay:yellow_activity_bar_fill);
} else if (%rcguild_team = 2) {
    if_setposition(481, $int0, ^setpos_abs_left, ^setpos_abs_top, rcguild_overlay:green_activity_bar_fill);
    if_setsize(16, $int1, ^setsize_abs, ^setsize_abs, rcguild_overlay:green_activity_bar_fill);
}
if ($int2 < 25) {
    if (%rcguild_team = 1) {
        if_setcolour(0xff9900, rcguild_overlay:yellow_activity_bar_fill);
    } else if (%rcguild_team = 2) {
        if_setcolour(0xff9900, rcguild_overlay:green_activity_bar_fill);
    }
} else if (%rcguild_team = 1) {
    if_setcolour(0x666600, rcguild_overlay:yellow_activity_bar_fill);
} else if (%rcguild_team = 2) {
    if_setcolour(0x284605, rcguild_overlay:green_activity_bar_fill);
}
