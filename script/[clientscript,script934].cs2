// 934
[clientscript,script934](int $int0)
switch_int ($int0) {
    case 1 :
        if_setposition(105, if_gety(tuska_island_overlay:position_pulse), ^setpos_abs_left, ^setpos_abs_top, tuska_island_overlay:position_pulse);
    case 2 :
        if_setposition(190, if_gety(tuska_island_overlay:position_pulse), ^setpos_abs_left, ^setpos_abs_top, tuska_island_overlay:position_pulse);
    case 3 :
        if_setposition(275, if_gety(tuska_island_overlay:position_pulse), ^setpos_abs_left, ^setpos_abs_top, tuska_island_overlay:position_pulse);
}
if_setontimer("script936(clientclock)", tuska_island_overlay:position_pulse);
