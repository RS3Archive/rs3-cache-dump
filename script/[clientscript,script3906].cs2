// 3906
[clientscript,script3906]
if (stat(fishing) > stat_base(fishing)) {
    ~script10624(combatv2_fishing_nerfed_dummy_ability, 0);
    return;
} else if (stat(fishing) < stat_base(fishing)) {
    ~script10624(combatv2_fishing_nerfed_dummy_ability, 1);
    return;
}
~script10624(combatv2_fishing_nerfed_dummy_ability, 0);
