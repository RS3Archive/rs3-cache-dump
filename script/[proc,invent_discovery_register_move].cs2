// 12125
[proc,invent_discovery_register_move]
%invent_synchronise_client = calc(%invent_synchronise_client + 1);
if_setontimer("invent_discovery_state_timeout(event_com, calc(clientclock + 500))", invent_discovery:workspace_layer);
switch_int (random(10)) {
    case 0 :
        sound_vorbis_rate(invent_discover_part_1, 1, 0, 125, random_sound_pitch(20, 20));
    case 1 :
        sound_vorbis_rate(invent_discover_part_2, 1, 0, 125, random_sound_pitch(20, 20));
    case 2 :
        sound_vorbis_rate(invent_discover_part_3, 1, 0, 125, random_sound_pitch(20, 20));
    case 3 :
        sound_vorbis_rate(invent_discover_part_4, 1, 0, 125, random_sound_pitch(20, 20));
    case 4 :
        sound_vorbis_rate(invent_discover_part_5, 1, 0, 125, random_sound_pitch(20, 20));
    case 5 :
        sound_vorbis_rate(invent_discover_part_6, 1, 0, 125, random_sound_pitch(20, 20));
    case 6 :
        sound_vorbis_rate(invent_discover_part_7, 1, 0, 125, random_sound_pitch(20, 20));
    case 7 :
        sound_vorbis_rate(invent_discover_part_8, 1, 0, 125, random_sound_pitch(20, 20));
    case 8 :
        sound_vorbis_rate(invent_discover_part_9, 1, 0, 125, random_sound_pitch(20, 20));
    case 9 :
        sound_vorbis_rate(invent_discover_part_10, 1, 0, 125, random_sound_pitch(20, 20));
}
