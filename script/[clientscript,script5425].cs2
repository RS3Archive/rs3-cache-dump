// 5425
[clientscript,script5425]
%dom_easter_xpos = calc(%dom_easter_xpos + 2);
if (%dom_easter_xpos <= 40) {
    if_setposition(%dom_easter_xpos, 0, ^setpos_abs_left, ^setpos_abs_centre, dom_battle_overlay:easter_egg_notification_layer);
} else {
    if_setontimer("script5426", dom_battle_overlay:global_layer);
}
