// 15432
[clientscript,script15432](component $component0, int $int1)
def_int $int2 = ~script11948($int1);
def_string $string0 = "";
if ($int2 = 0) {
    $string0 = "Rewards you with a choice of two random <col=FF00>Curio Bonuses</col>!";
} else if ($int2 = 1) {
    $string0 = "Awards a single prize.";
} else if ($int2 >= 2 & $int2 <= 10) {
    $string0 = "Awards <col=FF00>x<tostring($int2)></col> prizes!";
}
if ($int1 > 1) {
    $string0 = append($string0, "<br>Active in <tostring($int1)> keys.");
} else {
    $string0 = append($string0, "<br>Active on your next key.");
}
sound_vorbis_volume(tli_drop_out_tab_child_01, 1, 0, 180);
~script426($string0, $component0, -1, 0);
