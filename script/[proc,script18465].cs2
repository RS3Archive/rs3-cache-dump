// 18465
[proc,script18465](dbrow $dbrow0)
switch_dbrow ($dbrow0) {
    case crm_braze_lobby_main :
        cc_crmview_setonupdated("script18466(event_com, event_mousex)");
    case crm_braze_lobby_secondary_main :
        cc_crmview_setonupdated("script18467(event_com, event_mousex, 1)");
    case crm_braze_lobby_secondary_right :
        cc_crmview_setonupdated("script18467(event_com, event_mousex, 2)");
    case crm_braze_lobby_secondary_left :
        cc_crmview_setonupdated("script18467(event_com, event_mousex, 0)");
    case crm_braze_marketplace :
        cc_crmview_setonupdated("script18475(event_com, event_mousex)");
    case crm_braze_login_popup :
        cc_crmview_setonupdated("script18469(event_com, event_mousex)");
    case default :
        ~error("Missing cc/if_crmview_setonupdated plugin within ~crm_braze_setonupdated.");
}
