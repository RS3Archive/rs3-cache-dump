// 4635
[clientscript,script4635](component $component0, component $component1)
if (if_hassuboverlay($component0, modal_confirm_overlay) = false) {
    return;
}
cc_deleteall($component1);
~script4636($component0, $component1, modal_confirm_overlay:mainmodal_window_close_button, "Close");
~script4636($component0, $component1, modal_confirm_overlay:yes_button_active_layer, "Select");
~script4636($component0, $component1, modal_confirm_overlay:no_button_active_layer, "Select");
~script4636($component0, $component1, modal_confirm_overlay:dont_show_again_checkbox, "Toggle");
if_sethide(true, modal_confirm_overlay:yes_button_active_layer);
if_sethide(true, modal_confirm_overlay:no_button_active_layer);
