// 15009
[proc,script15009]
if (if_find(toplevel_v2_combat_bar_mobile_revo_parent:revo_icon) = true) {
    if (%combatv2_combat_mode ! 1 | %toplevel_v2_legacy_combat = 1) {
        cc_setgraphic(rs3_icon_combat_mode_revolution);
        ~script14990(0, "Revolution (inactive)<br><br>When active the abilities on this bar will be used automatically in combat.");
    } else {
        cc_setgraphic(rs3_icon_combat_mode_revolution_over);
        ~script14990(0, "Revolution (active)<br><br>When active the abilities on this bar will be used automatically in combat.");
    }
}
