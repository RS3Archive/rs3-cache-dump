// 9623
[clientscript,worldmap_key_onmouseover](component $component0, int $int1, int $int2)
if (cc_find($component0, $int1) = true & .cc_find($component0, 0) = true) {
    cc_setcolour($int2);
    .cc_sethide(true);
    .cc_setposition(.cc_getx, calc(cc_gety - 5 / 2), ^setpos_abs_left, ^setpos_abs_top);
    .cc_sethide(false);
}
