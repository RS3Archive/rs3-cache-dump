// 2006
[proc,script2006]
def_int $int0 = if_getx(lobbyscreen:mobile_sidemenu);
def_int $int1 = 0;
if (if_find(lobbyscreen:mobile_sidemenu) = true) {
    $int1 = cc_param(panel_direction);
}
if ($int0 <= calc(0 - if_getwidth(lobbyscreen_mobile_side_menu:base)) | $int0 < 0 & $int1 = 1) {
    if_setparam_int(panel_direction, 0, lobbyscreen:mobile_sidemenu);
    if_setontimer("script15621", lobbyscreen:mobile_sidemenu_timer);
    if_sethide(false, lobbyscreen:mobile_sidemenu_blackout);
} else {
    if_setparam_int(panel_direction, 1, lobbyscreen:mobile_sidemenu);
    if_setontimer("script15623", lobbyscreen:mobile_sidemenu_timer);
}
