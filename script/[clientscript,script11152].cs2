// 11152
[clientscript,script11152](component $component0, component $component1, component $component2)
if_setposition(~script1552(%meslayer_caret, %p_dialog_input, if_getfontmetrics($component1), $component0, -1), if_gety($component2), ^setpos_abs_left, ^setpos_abs_top, $component2);
if (applet_hasfocus = true) {
    if_sethide(false, $component2);
} else {
    if_sethide(true, $component2);
}
if_setontimer("script1400(clientclock, $component2)", $component0);
