// 19205
[proc,script19205](dbrow $dbrow0)(int, int, int, int, int, int)
switch_dbtable (db_getrowtable($dbrow0)) {
    case trh182_monsters :
        return(db_getfield($dbrow0, trh182_monsters:col2, 0));
    case trh203_nodes :
        return(db_getfield($dbrow0, trh203_nodes:col4, 0));
    case trh207_nodes :
        return(db_getfield($dbrow0, trh207_nodes:col4, 0));
    case default :
        ~error("Missed plugin point for DBTable.");
}
return(0, 0, 0, 0, 0, 0);
