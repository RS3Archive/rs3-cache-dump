// 19205
[proc,script19205](dbrow $dbrow0)(int, int, int, int, int, int)
switch_dbtable (db_getrowtable($dbrow0)) {
    case dbtable_193 :
        return(db_getfield($dbrow0, dbtable_193:col2, 0));
    case dbtable_294 :
        return(db_getfield($dbrow0, dbtable_294:col4, 0));
    case dbtable_315 :
        return(db_getfield($dbrow0, dbtable_315:col4, 0));
    case default :
        ~error("Missed plugin point for DBTable.");
}
return(0, 0, 0, 0, 0, 0);
