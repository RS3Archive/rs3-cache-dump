// 20417
[proc,script20417]
def_component $component0 = christmas_hub:winter_weeks_info_title;
def_component $component1 = christmas_hub:winter_weeks_info_date;
def_component $component2 = christmas_hub:winter_weeks_info_time;
def_component $component3 = christmas_hub:winter_weeks_info_text_layer;
def_int $int4 = 0;
def_int $int5 = 4;
def_int $int6 = 4;
def_int $int7 = if_getwidth($component3);
def_graphic $graphic8 = rs_minigame_barrows_bullet_locked;
def_struct $struct9 = xmas24_interface_winter_weeks_buff_font;
cc_deleteall($component3);
switch_int (%christmas_hub_interface_winter_weeks_selected) {
    case default :
        if_settext("Week 1 - Clue Scrolls", $component0);
        if_settext("1st December - 7th December", $component1);
        if_settext(~script20418(weekends_xmas25_week_1, 8678), $component2);
        $int4, $int6 = ~script176($component3, if_getnextsubid($component3), $int5, $int6, $int7, $graphic8, 16, 16, "1 free reroll for clue scroll rewards per day.<col=941212>*</col>", $struct9);
        $int4, $int6 = ~script176($component3, if_getnextsubid($component3), $int5, $int6, $int7, $graphic8, 16, 16, "10% increased chance to get clue scrolls as drops and from pickpocketing.<col=941212>*</col>", $struct9);
        $int4, $int6 = ~script176($component3, if_getnextsubid($component3), $int5, $int6, $int7, $graphic8, 16, 16, "Receive 50% more treasure trail points when completing clue scrolls.<col=941212>*</col>", $struct9);
    case 1 :
        if_settext("Week 2 - Bossing", $component0);
        if_settext("8th December - 14th December", $component1);
        if_settext(~script20418(weekends_xmas25_week_2, 8685), $component2);
        $int4, $int6 = ~script176($component3, if_getnextsubid($component3), $int5, $int6, $int7, $graphic8, 16, 16, "Choice of Soul Reaper task.<col=941212>*</col>", $struct9);
        $int4, $int6 = ~script176($component3, if_getnextsubid($component3), $int5, $int6, $int7, $graphic8, 16, 16, "Receive double reaper points when completing Soul Reaper tasks.<col=941212>*</col>", $struct9);
        $int4, $int6 = ~script176($component3, if_getnextsubid($component3), $int5, $int6, $int7, $graphic8, 16, 16, "Elder overload cauldrons are active at War's Retreat.<col=941212>*</col>", $struct9);
        $int4, $int6 = ~script176($component3, if_getnextsubid($component3), $int5, $int6, $int7, $graphic8, 16, 16, "All deaths are safe for members, and free for non-members.", $struct9);
    case 2 :
        if_settext("Week 3 - Skilling", $component0);
        if_settext("15th December - 21st December", $component1);
        if_settext(~script20418(weekends_xmas25_week_3, 8692), $component2);
        $int4, $int6 = ~script176($component3, if_getnextsubid($component3), $int5, $int6, $int7, $graphic8, 16, 16, "10% chance to receive an additional resource when training Gathering skills.<col=941212>*</col>", $struct9);
        $int4, $int6 = ~script176($component3, if_getnextsubid($component3), $int5, $int6, $int7, $graphic8, 16, 16, "10% chance to save resources or produce double items when training Artisan skills.<col=941212>*</col>", $struct9);
        $int4, $int6 = ~script176($component3, if_getnextsubid($component3), $int5, $int6, $int7, $graphic8, 16, 16, "Receive 50% more XP when completing Agility courses.<col=941212>*</col>", $struct9);
        $int4, $int6 = ~script176($component3, if_getnextsubid($component3), $int5, $int6, $int7, $graphic8, 16, 16, "Pickpocketing has a 20% increased chance of success.<col=941212>*</col>", $struct9);
    case 3 :
        if_settext("Week 4 - Combat", $component0);
        if_settext("22nd December - 28th December", $component1);
        if_settext(~script20418(weekends_xmas25_week_4, 8699), $component2);
        $int4, $int6 = ~script176($component3, if_getnextsubid($component3), $int5, $int6, $int7, $graphic8, 16, 16, "Choice between 2 Slayer tasks when assigned a new task.<col=941212>*</col>", $struct9);
        $int4, $int6 = ~script176($component3, if_getnextsubid($component3), $int5, $int6, $int7, $graphic8, 16, 16, "Receive double slayer points when completing Slayer tasks.<col=941212>*</col>", $struct9);
        $int4, $int6 = ~script176($component3, if_getnextsubid($component3), $int5, $int6, $int7, $graphic8, 16, 16, "Tier 4 luck is always active.<col=941212>*</col>", $struct9);
        $int4, $int6 = ~script176($component3, if_getnextsubid($component3), $int5, $int6, $int7, $graphic8, 16, 16, "Charm drops give one more charm than normal.<col=941212>*</col>", $struct9);
    case 4 :
        if_settext("Week 5 - Activities", $component0);
        if_settext("29th December - 4th January", $component1);
        if_settext(~script20418(weekends_xmas25_week_5, 8706), $component2);
        $int4, $int6 = ~script176($component3, if_getnextsubid($component3), $int5, $int6, $int7, $graphic8, 16, 16, "The Dominion Tower grants 50% more dominion factor, and killing bosses count as two for the purpose of reward unlocks.<col=941212>*</col>", $struct9);
        $int4, $int6 = ~script176($component3, if_getnextsubid($component3), $int5, $int6, $int7, $graphic8, 16, 16, "Shattered Worlds grants 50% more shattered anima.<col=941212>*</col>", $struct9);
        $int4, $int6 = ~script176($component3, if_getnextsubid($component3), $int5, $int6, $int7, $graphic8, 16, 16, "Receive double dungeoneering tokens from Dungeoneering and Elite Dungeons.<col=941212>*</col>", $struct9);
        $int4, $int6 = ~script176($component3, if_getnextsubid($component3), $int5, $int6, $int7, $graphic8, 16, 16, "Player-owned ports voyages return 30% extra resources and trade goods.<col=941212>*</col>", $struct9);
        $int4, $int6 = ~script176($component3, if_getnextsubid($component3), $int5, $int6, $int7, $graphic8, 16, 16, "Receive double thaler from minigames.<col=941212>*</col>", $struct9);
}
$int4, $int6 = ~script12086($component3, if_getnextsubid($component3), $int5, $int6, $int7, "<br><col=941212>* Not available for Ironmen.</col>", $struct9);
