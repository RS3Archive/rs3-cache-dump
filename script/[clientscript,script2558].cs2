// 2558
[clientscript,script2558]
def_int $int0 = 0;
def_component $component1 = null;
def_component $component2 = null;
def_int $int3 = 0;
while ($int0 <= calc(60 - 1)) {
    $component1 = enum(int, component, trh53_spring_cleaner_active_to_selected_layer, $int0);
    $component2 = enum(int, component, trh53_spring_cleaner_active_to_highlight_layer, $int0);
    $int3 = ~script2531($int0);
    if ($int3 = 1) {
        if_sethide(false, $component1);
        if_sethide(false, $component2);
        if_setcolour(^white, $component2);
    } else if ($int3 = 2) {
        if_sethide(false, $component1);
        if_sethide(false, $component2);
        if_setcolour(^green, $component2);
    } else if ($int3 = 0) {
        if_sethide(true, $component1);
        if_sethide(true, $component2);
    }
    $int0 = calc($int0 + 1);
}
