// 7505
[proc,script7505](graphic $graphic0)(string)
switch_graphic ($graphic0) {
    case aif_mantis_card_sml :
        return("Trading mantis");
    case aif_leech_card_sml :
        return("Trading leech");
    case aif_mosquito_card_sml :
        return("Cloning mosquito");
    case aif_bunnyip_card_sml :
        return("Whimsical bunyip");
    case aif_steel_titan_card_sml :
        return("Protecting titan");
    case aif_locust_card_sml :
        return("Thieving locust");
    case aif_yak_card_sml :
        return("Consistent yak");
    case aif_meerkat_card_sml :
        return("Scavenging meerkats");
    case aif_phoenix_card_sml :
        return("Reversing phoenix");
    case aif_stork_card_sml :
        return("Preening ibis");
    case aif_dust_devil_card_sml :
        return("Beguiling smoke devil");
}
