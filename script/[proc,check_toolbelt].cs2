// 7090
[proc,check_toolbelt](obj $obj0)(boolean)
switch_category (oc_category($obj0)) {
    case weapon_axe :
        if (oc_param($obj0, rand_item) = 0) {
            if ($obj0 = bronze_axe) {
                return(true);
            }
            if (enum_hasoutput(obj, toolbelt_hatchets, $obj0) = true) {
                if (%toolbelt_hatchet_level = enum_getreverseindex(obj, int, toolbelt_hatchets, $obj0, 0)) {
                    return(true);
                } else {
                    return(false);
                }
            } else {
                return(false);
            }
        }
    case weapon_pick :
        if (oc_param($obj0, rand_item) = 0) {
            if ($obj0 = bronze_pickaxe) {
                return(true);
            }
            if (enum_hasoutput(obj, toolbelt_pickaxes, $obj0) = true) {
                if (%toolbelt_pickaxe_level = enum_getreverseindex(obj, int, toolbelt_pickaxes, $obj0, 0)) {
                    return(true);
                } else {
                    return(false);
                }
            } else {
                return(false);
            }
        }
    case weapon_mattock :
        if (enum_hasoutput(obj, toolbelt_mattocks, $obj0) = true & %toolbelt_mattock > enum_getreverseindex(obj, int, toolbelt_mattocks, $obj0, 0)) {
            return(true);
        }
        return(false);
}
switch_obj ($obj0) {
    case knife :
        if (%toolbelt_knife = 1) {
            return(true);
        }
    case shears :
        if (%toolbelt_shears = 1) {
            return(true);
        }
