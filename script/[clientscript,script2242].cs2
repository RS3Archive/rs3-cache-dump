// 2242
[clientscript,script2242]
sound_synth(easter10_interface_final_scores, 3, 0);
if_settext("Turns taken score: <tostring(%easter10_resourcegame_turncount)> x 101 = <tostring(calc(%easter10_resourcegame_turncount * 101))>", easter10_gameresult:turnscore);
if_settext("Resources spare: <tostring(calc(%easter10_resourcegame_totalfruit + (%easter10_resourcegame_totalnuts + %easter10_resourcegame_totalchoc)))> x -10 = -<tostring(calc((%easter10_resourcegame_totalfruit + (%easter10_resourcegame_totalnuts + %easter10_resourcegame_totalchoc)) * 10))>", easter10_gameresult:resourcesscore);
if (%easter10_resourcegame_turncount < 16) {
    if_settext("Completed within turn limit: -100", easter10_gameresult:underparscore);
} else {
    if_settext("Not completed within turn limit: 0", easter10_gameresult:underparscore);
}
if_settext("Workers employed: <tostring(%easter10_resourcegame_totalworkers)> x -10 = -<tostring(calc(%easter10_resourcegame_totalworkers * 10))>", easter10_gameresult:workersemployedscore);
if_settext("Turns taken: <tostring(%easter10_resourcegame_turncount)>", easter10_gameresult:turncount);
if (%easter10_incubator_status = 0) {
    if_settext("Oven not repaired: 50", easter10_gameresult:incubatorrepaired);
} else {
    if_settext("Oven repaired: 0", easter10_gameresult:incubatorrepaired);
}
if (%easter10_conveyor_status = 0) {
    if_settext("Conveyor not repaired: 50", easter10_gameresult:conveyorrepaired);
} else {
    if_settext("Conveyor repaired: 0", easter10_gameresult:conveyorrepaired);
}
if (%easter10_painter_status = 0) {
    if_settext("Painter not repaired: 50", easter10_gameresult:painterepaired);
} else {
    if_settext("Painter repaired: 0", easter10_gameresult:painterepaired);
}
def_int $int0 = 0;
$int0 = calc(%easter10_resourcegame_turncount * 101);
if (%easter10_painter_status = 0) {
    $int0 = calc($int0 + 50);
}
if (%easter10_incubator_status = 0) {
    $int0 = calc($int0 + 50);
}
if (%easter10_conveyor_status = 0) {
    $int0 = calc($int0 + 50);
}
$int0 = calc($int0 - (%easter10_resourcegame_totalfruit + (%easter10_resourcegame_totalnuts + %easter10_resourcegame_totalchoc)) * 10);
if (%easter10_resourcegame_turncount < 16) {
    $int0 = calc($int0 - 100);
}
$int0 = calc($int0 - %easter10_resourcegame_totalworkers * 10);
if ($int0 < 0) {
    $int0 = 0;
}
if ($int0 > 32768) {
    $int0 = 32768;
}
if ($int0 = %easter10_resourcegame_score) {
    if_settext("Final score: <tostring($int0)> (New best score)", easter10_gameresult:finalscore);
} else {
    if_settext("Final score: <tostring($int0)>", easter10_gameresult:finalscore);
}
