// 2346
[clientscript,script2346]
if (++%mah1_orbit_step >= calc(spline_length(0) - 1)) {
    %mah1_orbit_step = 0;
    if_setoncamfinished(null, mah1_orbitsplines:controller);
    return;
}
if (%mah1_orbit_step = calc(spline_length(0) - 2)) {
    cam_movealong(0, %mah1_orbit_step, 200, 75, 1, %mah1_orbit_step);
} else {
    cam_movealong(0, %mah1_orbit_step, 200, 200, 1, %mah1_orbit_step);
}
if_setoncamfinished("script2346", mah1_orbitsplines:controller);
