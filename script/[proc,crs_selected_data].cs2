// 8819
[proc,crs_selected_data]()(struct, quest, achievement)
switch_int (%crs_selected) {
    case 1 :
        return(%crs_struct2, %crs_quest2, %crs_achievement2);
    case 2 :
        return(%crs_struct3, %crs_quest3, %crs_achievement3);
    case 3 :
        return(%crs_struct4, %crs_quest4, %crs_achievement4);
    case default :
        return(%crs_struct1, %crs_quest1, %crs_achievement1);
}
