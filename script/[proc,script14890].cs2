// 14890
[proc,script14890]
if (%arch_research_management_popup_type ! 0) {
    return;
}
~script10458(arch_research_management:panel_layer, arch_research_management:panel_window, null, arch_research_management:panel_window_content, null, null, null, 0, 367);
if (if_find(arch_research_management:panel_window) = true) {
    if (cc_param(panel_direction) <= 0) {
        ~script13959(arch_research_management:panel_toggle_button_graphic, rs3tli_sort_ascending_icons, false);
        if_sethide(true, arch_research_management:panel_background_layer);
    } else {
        ~script13959(arch_research_management:panel_toggle_button_graphic, rs3tli_sort_descending_icons, false);
        if_sethide(false, arch_research_management:panel_background_layer);
    }
}
