// 9770
[proc,script9770](int $int0)
if ($int0 = 1) {
    if_settext("In rolling mode, the ball can be kicked away from you only, but will bounce off surfaces and can be kicked when moving.", trh17_config:mode_info_text);
} else {
    if_settext("In free mode, you can attempt to kick the ball anywhere by clicking on the ball and then on the ground, but may not always end up where you expect.", trh17_config:mode_info_text);
}
