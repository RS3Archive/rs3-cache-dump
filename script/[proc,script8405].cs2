// 8405
[proc,script8405](component $component0)(int, int)
def_int $int1 = if_getx($component0);
def_int $int2 = if_gety($component0);
def_component $component3 = if_getparentlayer($component0);
while ($component3 ! null) {
    $int1 = calc($int1 + if_getx($component3) - if_getscrollx($component3));
    $int2 = calc($int2 + if_gety($component3) - if_getscrolly($component3));
    $component3 = if_getparentlayer($component3);
}
return($int1, $int2);
