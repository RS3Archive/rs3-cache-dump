        return(%postbag_transmog_parcel_legendary);
    case enchanted_onyx_ring :
        return(%emotes2_enchanted_onyx_ring_added);
    case enchanted_onyx_ring_red, enchanted_onyx_ring_blue, enchanted_onyx_ring_green, enchanted_onyx_ring_yellow :
        if (%emotes2_enchanted_onyx_ring_added = 1 & testbit(%loy_shop_perm1, 23) = ^true) {
            return(1);
        }
    case trail17_ring_of_coins :
        if (%emotes2_trail117_ring_of_coins_added = 1 | %poh_costume_trail17_ring_of_coins = 1) {
            return(1);
        }
    case trail17_ring_of_tree :
        if (%emotes2_trail117_ring_of_tree_added = 1 | %poh_costume_trail17_ring_of_tree = 1) {
            return(1);
        }
    case hw10_bone_broach :
        return(%hw10_reward);
    case easter06_ring_of_egg :
        return(testbit(%rareitems, 7));
    case xmas15_ring_of_snow :
        return(%xmas15_ring_unlocked);
    case trh61_crab_hat_untradable :
