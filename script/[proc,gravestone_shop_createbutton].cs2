// 682
[proc,gravestone_shop_createbutton](component $component0, int $int1, int $int2, component $component3, component $component4, component $component5, component $component6, component $component7, component $component8)
def_int $int9 = calc((if_getwidth($component0) - 164) / 2);
def_int $int10 = calc($int9 + (146 + $int9) * $int2);
cc_create($component0, ^iftype_rectangle, calc($int2 * 2));
cc_setsize(164, 146, ^setsize_abs, ^setsize_abs);
cc_setposition($int9, $int10, ^setpos_abs_left, ^setpos_abs_top);
if (%gravestone_type = $int1) {
    cc_setcolour(0x7f0000);
} else if (calc(%gravestone_type_visible - 1) = $int1) {
    cc_setcolour(0xf0be79);
} else {
    cc_setcolour(^black);
}
cc_settrans(200);
cc_setfill(true);
cc_setop(1, "Choose");
cc_setopbase("<col=ff9040><enum(int, string, gravestone_name, $int1)></col>");
cc_setonop("gravestone_shop_select($int1, $component0, event_comsubid, $component3, $component4, $component5, $component6, $component7, $component8)");
cc_create($component0, ^iftype_model, calc($int2 * 2 + 1));
cc_setsize(164, 146, ^setsize_abs, ^setsize_abs);
cc_setposition($int9, $int10, ^setpos_abs_left, ^setpos_abs_top);
~gravestone_shop_model($int1);
