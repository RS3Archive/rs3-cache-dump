// 607
[clientscript,stock_offerprice_market]
if (%stock_offeritem = null) {
    %stock_offerprice_visible = 1;
    sound_vorbis_volume(omge_error, 1, 0, 120);
    return;
}
%stock_offerprice_visible = long_max(1, %stock_offeritem_marketprice);
~script15038(%stock_offercount_visible, %stock_offerprice_visible, 1);
