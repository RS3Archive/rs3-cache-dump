// 1598
[clientscript,loot_ontimer](component $component0)
if (%varclient_53 < clientclock) {
    if (%varplayerbit_3307 = 1 | %varplayerbit_3308 = 1) {
        if_setgraphic("rs3_icon_lobby_loot_share,2", $component0);
    } else if (%varplayerbit_3306 = 1) {
        if (%varplayerbit_3310 = 1) {
            if_setgraphic("rs3_icon_lobby_loot_share,3", $component0);
        } else {
            if_setgraphic("rs3_icon_lobby_loot_share,0", $component0);
        }
    } else {
        if_setgraphic("rs3_icon_lobby_loot_share,1", $component0);
    }
    %varclient_53 = calc(clientclock + 500);
}
