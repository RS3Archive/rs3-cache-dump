// 2723
[clientscript,div_map_tooltip](component $component0, int $int1, int $int2)
def_int $int3 = stat_base(divination);
def_int $int4 = 0;
def_int $int5 = 10;
def_string $string0 = "";
switch_component ($component0) {
    case interface_92:com_12 :
        $int4, $int5 = 0, 10;
    case interface_92:com_13 :
        $int4, $int5 = 10, 20;
    case interface_92:com_14 :
        $int4, $int5 = 20, 30;
    case interface_92:com_15 :
        $int4, $int5 = 30, 40;
    case interface_92:com_16 :
        $int4, $int5 = 40, 50;
    case interface_92:com_17 :
        $int4, $int5 = 50, 60;
    case interface_92:com_18 :
        $int4, $int5 = 60, 70;
    case interface_92:com_19 :
        $int4, $int5 = 70, 80;
    case interface_92:com_20 :
        $int4, $int5 = 80, 85;
    case interface_92:com_21 :
