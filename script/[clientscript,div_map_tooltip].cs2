// 2723
[clientscript,div_map_tooltip](component $component0, int $int1, int $int2)
def_int $int3 = stat_base(divination);
def_int $int4 = 0;
def_int $int5 = 10;
def_string $string0 = "";
switch_component ($component0) {
    case div_map:colony1 :
        $int4, $int5 = 0, 10;
    case div_map:colony2 :
        $int4, $int5 = 10, 20;
    case div_map:colony3 :
        $int4, $int5 = 20, 30;
    case div_map:colony4 :
        $int4, $int5 = 30, 40;
    case div_map:colony5 :
        $int4, $int5 = 40, 50;
    case div_map:colony6 :
        $int4, $int5 = 50, 60;
    case div_map:colony7 :
        $int4, $int5 = 60, 70;
    case div_map:colony8 :
        $int4, $int5 = 70, 80;
    case div_map:colony9 :
        $int4, $int5 = 80, 85;
    case div_map:colony10 :
        $int4, $int5 = 85, 90;
    case div_map:colony11 :
        $int4, $int5 = 90, 95;
    case div_map:colony12 :
        $int4, $int5 = 95, -1;
}
if ($int3 < $int4) {
    $string0 = "This colony requires level <tostring_localised($int4, true)> Divination.";
} else if ($int5 > 0 & $int3 >= $int5) {
    $string0 = "You can use this colony, but a higher-level colony would be more beneficial.";
} else {
    $string0 = "This is the ideal colony for your Divination level.";
}
~script8800($string0, $component0, -1);
