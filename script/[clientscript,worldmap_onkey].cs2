// 1382
[clientscript,worldmap_onkey](int $key0, char $char1)
switch_int ($key0) {
    case ^key_left :
        ~worldmap_arrowkey(-1, 0);
    case ^key_right :
        ~worldmap_arrowkey(1, 0);
    case ^key_up :
        ~worldmap_arrowkey(0, 1);
    case ^key_down :
        ~worldmap_arrowkey(0, -1);
    case ^key_escape :
        ~worldmap_close;
}
