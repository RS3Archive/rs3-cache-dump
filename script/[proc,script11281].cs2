// 11281
[proc,script11281](int $int0, coord $coord1)
if_sethide(false, worldmap_v2_ui:overlay_window_cancel_layer);
if_sethide(false, worldmap_v2_confirm:confirm_window);
def_component $component2 = worldmap_v2_confirm:confirm_window_content;
def_component $component3 = worldmap_v2_confirm:positive_button_active_layer;
if_settext("Yes", worldmap_v2_confirm:positive_button_text);
if_settext("No", worldmap_v2_confirm:neutral_button_text);
if_setonop("script10090", worldmap_v2_confirm:neutral_button_active_layer);
cc_deleteall($component2);
cc_deleteall($component3);
if_setop(1, "", $component3);
def_int $int4 = 0;
while ($int4 < $int0) {
    cc_create($component3, ^iftype_graphic, $int4);
    $int4 = calc($int4 + 1);
}
cc_create($component3, ^iftype_graphic, $int0);
cc_setsize(0, 0, ^setsize_minus, ^setsize_minus);
cc_setop(1, "Select");
cc_create($component2, ^iftype_text, 0);
cc_setposition(0, 0, ^setpos_abs_centre, ^setpos_abs_top);
cc_setsize(0, calc(if_getheight($component2) - if_gety(if_getlayer($component3))), ^setsize_minus, ^setsize_minus);
if ($int0 <= 34) {
    cc_settext("Teleport to <enum(coord, string, thas_coord_to_string, $coord1)>?");
} else {
    cc_settext("Teleport to J-Mod?");
}
cc_settextfont(museo_sans_11pt_regular);
cc_setcolour(~script10495(3));
cc_settextalign(^settextalign_centre, ^settextalign_centre, 0);
