[proc,script1115]
if (store_status = 2) {
    if_settext("The Marketplace is currently unavailable. Please try again soon.", interface_1498:com_11);
    if_sethide(true, interface_1498:com_10);
} else {
    if_settext("The Marketplace is currently initialising. Please wait.", interface_1498:com_11);
    if_sethide(false, interface_1498:com_10);
    if_scriptqueue_clear(interface_1498:com_0);
    if_scriptqueue_add(50, "script1422", interface_1498:com_0);
}
