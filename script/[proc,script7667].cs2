// 7667
[proc,script7667](component $component0)
if (%flashing_int ! 1) {
    if_sethide(false, $component0);
    %flashing_int = 1;
    if (%bugreport_input_focus = 1) {
        if_setontimer("script7668($component0)", bugreport_interface:chars_left);
    } else if (%bugreport_input_focus = 2) {
        if_setontimer("script7668($component0)", bugreport_interface:chars_repro);
    }
}
