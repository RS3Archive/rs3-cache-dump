// 10887
[proc,script10887](component $component0, struct $struct1)
def_boolean $boolean2 = ~script11095($struct1);
def_int $int3 = 0;
if (.cc_find($component0, 2) = true) {
    if ($boolean2 = true) {
        .cc_setcolour(0x5a9619);
    } else {
        .cc_setcolour(0xcc0000);
    }
    if (struct_param($struct1, combatv2_buff_uses_ability_end) = true & struct_param($struct1, combatv2_buff_flash_at_low_duration) = true) {
        $int3 = calc(~script11073($struct1) - clientclock);
        if ($int3 > 0 & $int3 <= 500) {
            .cc_settrans(~script11318($struct1));
        } else {
            .cc_settrans(0);
        }
    } else {
        .cc_settrans(0);
    }
}
