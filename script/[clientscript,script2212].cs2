// 2212
[clientscript,script2212]
if (if_getx(%easter10_currentmodel) < calc(if_getwidth(easter10_nuts:content) - 1)) {
    if_setontimer("script2212", easter10_nuts:content);
    if_setposition(calc(1 + if_getx(%easter10_currentmodel)), if_gety(%easter10_currentmodel), ^setpos_abs_left, ^setpos_abs_top, %easter10_currentmodel);
} else {
    if_sethide(true, %easter10_currentmodel);
    if_setposition(0, 120, ^setpos_abs_left, ^setpos_abs_top, %easter10_currentmodel);
}
