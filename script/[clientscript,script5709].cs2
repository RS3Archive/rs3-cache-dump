// 5709
[clientscript,script5709](component $component0, int $int1)
if ($int1 >= 50) {
    if_setontimer(null, $component0);
    return;
}
def_int $int2 = calc(255 - ~tween($int1, 50, 0, 255, 4));
if (if_find($component0) = true) {
    cc_settrans($int2);
}
$int1 = calc($int1 + 1);
if_setontimer("script5709($component0, $int1)", $component0);
