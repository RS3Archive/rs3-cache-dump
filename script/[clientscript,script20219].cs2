// 20219
[clientscript,script20219](int $int0)
def_int $int1 = calc(clientclock - $int0);
if ($int1 < 100) {
    ~script20223(scale(255, 100, $int1));
} else if ($int1 < 200) {
    if ($int1 = 100) {
        if_settext("", interface_1401:com_42);
        ~script20225;
    }
    $int1 = calc($int1 - 100);
    ~script20222(calc(255 - scale(255, 100, $int1)));
} else {
    if_setparam_int(param_8058, 0, interface_1401:com_3);
    if_setontimer(null, interface_1401:com_3);
}
