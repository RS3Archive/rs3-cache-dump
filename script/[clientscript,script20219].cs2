// 20219
[clientscript,script20219](int $int0)
def_int $int1 = calc(clientclock - $int0);
if ($int1 < 100) {
    ~script20223(scale(255, 100, $int1));
} else if ($int1 < 200) {
    if ($int1 = 100) {
        if_settext("", league_onboarding:linking_name);
        ~script20225;
    }
    $int1 = calc($int1 - 100);
    ~script20222(calc(255 - scale(255, 100, $int1)));
} else {
    if_setparam_int(rs3tli_component_anim_dir, 0, league_onboarding:anim_listener);
    if_setontimer(null, league_onboarding:anim_listener);
}
