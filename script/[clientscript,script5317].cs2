// 5317
[clientscript,script5317]
if (if_gethide(clan_keep_theatre_sounds:sound_selected) = true) {
    if_sethide(false, clan_keep_theatre_sounds:sound_selected);
    if_sethide(true, clan_keep_theatre_sounds:bm_selected);
    if_sethide(true, clan_keep_theatre_sounds:bm_list);
    if_sethide(true, clan_keep_theatre_sounds:scroll_bar2);
    if_sethide(true, clan_keep_theatre_sounds:clear_button_layer);
    if_sethide(false, clan_keep_theatre_sounds:sound_list);
    if_sethide(false, clan_keep_theatre_sounds:scroll_bar1);
    if_sethide(false, clan_keep_theatre_sounds:sort_button_layer);
} else {
    if_sethide(true, clan_keep_theatre_sounds:sound_selected);
    if_sethide(false, clan_keep_theatre_sounds:bm_selected);
    if_sethide(false, clan_keep_theatre_sounds:bm_list);
    if_sethide(false, clan_keep_theatre_sounds:scroll_bar2);
    if_sethide(false, clan_keep_theatre_sounds:clear_button_layer);
    if_sethide(true, clan_keep_theatre_sounds:sound_list);
    if_sethide(true, clan_keep_theatre_sounds:scroll_bar1);
    if_sethide(true, clan_keep_theatre_sounds:sort_button_layer);
}
