// 13350
[proc,script13350]()(struct)
if (date_runeday >= 5563 & date_runeday < 5591) {
    if (~ql4_getprogress(ozan1) ! 2) {
        return(worldmap_overlay_upsell_menaphos_ozan1);
    } else if (~ql4_getprogress(ozan2) ! 2) {
        return(worldmap_overlay_upsell_menaphos_ozan2);
    }
}
return(null);
