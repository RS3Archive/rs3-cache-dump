// 9056
[proc,script9056]
if_sethide(true, achievements_sub:cheevo_reward_popup_layer);
if_settext("", achievements_sub:info_description);
cc_deleteall(achievements_sub:info_panel_scrollbar_layer);
if (if_find(achievements_sub:info_description) = true) {
    cc_setsize(10, 30, ^setsize_minus, ^setsize_minus);
    cc_setscrollsize(0, 0);
    cc_setscrollpos(0, 0);
}
