// 9834
[clientscript,script9834]
~script9836;
if_setonvarctransmit("script9835{rhino_client_question}", rhino_awareness:mainmodal_window_content);
if (%rhino_client_end_time > clientclock) {
    if_sethide(false, rhino_awareness:grey_out_layer);
    if_sethide(false, rhino_awareness:todays_rhino_wrong_answer);
    if_sethide(false, rhino_awareness:answer_1_btn_disabled_layer);
    if_sethide(false, rhino_awareness:answer_2_btn_disabled_layer);
    if_sethide(false, rhino_awareness:answer_3_btn_disabled_layer);
    if_sethide(false, rhino_awareness:answer_4_btn_disabled_layer);
    %rhino_client_time_remaining = calc((%rhino_client_end_time - clientclock) / 50);
    ~script9842;
} else {
    if_setontimer(null, sep2013_jobs:answer_question_text_layer);
    if_sethide(true, rhino_awareness:grey_out_layer);
    if_sethide(true, rhino_awareness:todays_rhino_wrong_answer);
    if_sethide(true, rhino_awareness:answer_1_btn_disabled_layer);
    if_sethide(true, rhino_awareness:answer_2_btn_disabled_layer);
    if_sethide(true, rhino_awareness:answer_3_btn_disabled_layer);
    if_sethide(true, rhino_awareness:answer_4_btn_disabled_layer);
}
