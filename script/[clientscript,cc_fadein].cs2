// 13583
[clientscript,cc_fadein](component $component0, int $int1, int $int2, component $component3)
def_int $int4 = calc($int2 - clientclock);
if (cc_find($component0, $int1) = true) {
    if ($int4 <= 0) {
        cc_settrans(0);
        cc_setontimer(null);
        if ($component3 ! null) {
            if_sethide(false, $component3);
        }
        return;
    }
    cc_settrans(max(calc(cc_gettrans - cc_gettrans / $int4), 1));
}
