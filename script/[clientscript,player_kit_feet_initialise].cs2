// 1503
[clientscript,player_kit_feet_initialise]
cc_deleteall(player_kit_feet:menu_graphics);
~rs3_background_panel(player_kit_feet:menu_graphics, rs3_content_container_active);
cc_deleteall(player_kit_feet:player_container);
~rs3_background_panel(player_kit_feet:player_container_background, rs3_content_container_inactive);
~player_kit_player_create(player_kit_feet:player_container, 380, 100);
cc_deleteall(player_kit_feet:colours_graphics);
~rs3_background_panel(player_kit_feet:colours_graphics, rs3_content_container_active);
~player_kit_feet_redraw;
if_setonvarctransmit("player_kit_feet_varctransmit{playerdesign3_feet, playerdesign3_feetcol}", player_kit_feet:universe);
