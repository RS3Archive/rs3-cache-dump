// 595
[proc,diango_resize](int $int0)
def_int $int1 = 0;
def_int $int2 = 0;
def_int $int3 = 0;
def_int $int4 = 0;
$int1, $int3, $int2, $int4 = ~script2956;
if_setposition($int1, $int3, ^setpos_abs_left, ^setpos_abs_top, diango_items:mainmodal_window);
if_setsize(calc($int1 + $int2), calc($int3 + $int4), ^setsize_minus, ^setsize_minus, diango_items:mainmodal_window);
if ($int0 = 0 & %bank_resize_cycle <= clientclock) {
    ~diango_rebuild;
    %bank_resize_cycle = calc(clientclock + 10);
}
