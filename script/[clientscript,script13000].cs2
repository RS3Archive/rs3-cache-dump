// 13000
[clientscript,script13000]
if (cc_find(toplevel_v2_combat_bar:player_adrenaline_bar, 3) = true) {
    cc_setontimer("script12631(event_com, event_comsubid)");
    cc_setparam(rs3tli_component_transparency_type, 1);
    cc_setparam(rs3tli_component_transparency_min, 0);
    cc_setparam(rs3tli_component_transparency_max, 127);
    cc_setparam(rs3tli_component_transparency_playback_rate, calc(1000 * 4));
}
if (if_find(combatv2_adrenaline:fullscreen_adrenaline_bar_graphic) = true) {
    cc_setontimer("script12631(event_com, event_comsubid)");
    cc_setparam(rs3tli_component_transparency_type, 1);
    cc_setparam(rs3tli_component_transparency_min, 0);
    cc_setparam(rs3tli_component_transparency_max, 127);
    cc_setparam(rs3tli_component_transparency_playback_rate, calc(1000 * 4));
}
