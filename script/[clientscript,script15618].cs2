// 15618
[clientscript,script15618](component $component0, int $int1)
if (~is_mobile_client = true) {
    if_settextalign(^settextalign_centre, ^settextalign_centre, 0, $component0);
} else {
    if_settextalign(^settextalign_left, ^settextalign_centre, 0, $component0);
}
~script6865($component0, -1, $int1);
