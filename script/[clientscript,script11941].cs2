// 11941
[clientscript,script11941]
switch_int (map_lang) {
    case 0 :
        if_setgraphic(trh193_title_en, trh193_overlay:title);
    case 1 :
        if_setgraphic(trh193_title_de, trh193_overlay:title);
    case 2 :
        if_setgraphic(trh193_title_fr, trh193_overlay:title);
    case 3 :
        if_setgraphic(trh193_title_pt, trh193_overlay:title);
}
if_sethide(false, trh193_overlay:splash_screen);
if_sethide(true, trh193_overlay:universe);
if_sethide(true, wheel_of_fortune:chests_layer);
if_setnpcmodel(trh193_heaven_outfit, trh193_overlay:npc_model_2);
if_setmodelangle(-10, 108, 0, 140, 0, 370, trh193_overlay:npc_model_2);
if_setmodelanim(combat_2012_casual_unarmed_idle, trh193_overlay:npc_model_2);
~script15415(trh193_overlay:plus_tooltip_layer, 5, null);
~script15415(trh193_overlay:min_tooltip_layer, 8, null);
if_settext("Activate the <col=F0BE79>Curios Bonus</col> to choose between an <col=F0BE79>increase</col> or <col=F0BE79>minimum</col> <col=FF00>multiplier</col> modifier!<br><br><br>For a <col=F0BE79>limited time</col> you have a chance to win the NEW <col=F0BE79>Heavenforged Warrior Armour token</col>!", trh193_overlay:desc);
