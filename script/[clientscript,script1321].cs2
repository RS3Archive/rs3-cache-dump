if ($int2 > 0 & cc_find($component1, calc(($int2 - 1) * 2)) = true) {
    cc_setgraphic(button_circle_blue);
}
if (cc_find($component1, calc(($int0 - 1) * 2)) = true) {
    cc_setgraphic(button_circle_blue_down);
}
~script1361(toplevel_v2_combat_bar_mobile_buttons:action_bar_selection_layer);
