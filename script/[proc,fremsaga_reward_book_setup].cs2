// 4676
[proc,fremsaga_reward_book_setup](int $int0)
switch_int ($int0) {
    case 1 :
        if (%fremsaga_signature_unabridged = 1) {
            if_sethide(true, fremsaga_reward:book_unabridged_wrapper);
        } else if (%fremsaga_completion = 10 & stat_base(magic) >= 30 & stat_base(ranged) >= 30 & stat_base(attack) >= 30) {
            if_sethide(false, fremsaga_reward:reward_notify);
            if_sethide(false, fremsaga_reward:book_unabridged_wrapper);
            if (%fremsaga_signature_abridged = 0) {
                if_settext("You receive two new books.", fremsaga_reward:reward_notify);
            }
        }
        if (%fremsaga_signature_abridged = 1) {
            if_sethide(true, fremsaga_reward:book_abridged_wrapper);
        } else {
            if_sethide(false, fremsaga_reward:reward_notify);
            if_sethide(false, fremsaga_reward:book_abridged_wrapper);
        }
    case 2 :
        if (%fremsaga_vengeance_unabridged = 1) {
            if_sethide(true, fremsaga_reward:book_unabridged_wrapper);
        } else if (%fremsaga_completion = 10 & stat_base(agility) >= 55 & stat_base(thieving) >= 55) {
            if_sethide(false, fremsaga_reward:reward_notify);
            if_sethide(false, fremsaga_reward:book_unabridged_wrapper);
            if (%fremsaga_vengeance_abridged = 0) {
                if_settext("You receive two new books.", fremsaga_reward:reward_notify);
            }
        }
        if (%fremsaga_vengeance_abridged = 1) {
            if_sethide(true, fremsaga_reward:book_abridged_wrapper);
        } else {
            if_sethide(false, fremsaga_reward:reward_notify);
            if_sethide(false, fremsaga_reward:book_abridged_wrapper);
        }
    case 4 :
        if (%fremsaga_thok_unabridged = 1) {
            if_sethide(true, fremsaga_reward:book_unabridged_wrapper);
        } else if (%fremsaga_completion = 10 & stat_base(strength) >= 70) {
            if_sethide(false, fremsaga_reward:reward_notify);
            if_sethide(false, fremsaga_reward:book_unabridged_wrapper);
            if (%fremsaga_thok_abridged = 0) {
                if_settext("You receive two new books.", fremsaga_reward:reward_notify);
            }
        }
        if (%fremsaga_thok_abridged = 1) {
            if_sethide(true, fremsaga_reward:book_abridged_wrapper);
        } else {
            if_sethide(false, fremsaga_reward:reward_notify);
            if_sethide(false, fremsaga_reward:book_abridged_wrapper);
        }
    case 3 :
        if (%fremsaga_bilrach_unabridged = 1) {
            if_sethide(true, fremsaga_reward:book_unabridged_wrapper);
        } else if (%fremsaga_completion = 10 & stat_base(attack) >= 60 & stat_base(thieving) >= 45 & stat_base(dungeoneering) >= 55) {
            if_sethide(false, fremsaga_reward:reward_notify);
            if_sethide(false, fremsaga_reward:book_unabridged_wrapper);
            if (%fremsaga_bilrach_abridged = 0) {
                if_settext("You receive two new books.", fremsaga_reward:reward_notify);
            }
        }
        if (%fremsaga_bilrach_abridged = 1) {
            if_sethide(true, fremsaga_reward:book_abridged_wrapper);
        } else {
            if_sethide(false, fremsaga_reward:reward_notify);
            if_sethide(false, fremsaga_reward:book_abridged_wrapper);
        }
    case 6 :
        if (%fremsaga_thok2_unabridged = 1) {
            if_sethide(true, fremsaga_reward:book_unabridged_wrapper);
        } else if (%fremsaga_completion = 10 & stat_base(strength) >= 75) {
            if_sethide(false, fremsaga_reward:reward_notify);
            if_sethide(false, fremsaga_reward:book_unabridged_wrapper);
            if (%fremsaga_thok2_abridged = 0) {
                if_settext("You receive two new books.", fremsaga_reward:reward_notify);
            }
        }
        if (%fremsaga_thok2_abridged = 1) {
            if_sethide(true, fremsaga_reward:book_abridged_wrapper);
        } else {
            if_sethide(false, fremsaga_reward:reward_notify);
            if_sethide(false, fremsaga_reward:book_abridged_wrapper);
        }
}
