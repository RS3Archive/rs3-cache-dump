// 20704
[proc,script20704]
def_int $int0 = 0;
def_int $int1 = inv_size(inv);
while ($int0 < $int1) {
    if (testbit(%dino_bait_box_grey_out, $int0) = ^true & cc_find(bait_box:inv_contents_layer, $int0) = true) {
        cc_setcolour(0x222222);
        cc_settrans(153);
    }
    $int0 = calc($int0 + 1);
}
