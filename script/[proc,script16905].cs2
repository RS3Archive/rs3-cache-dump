// 16905
[proc,script16905](int $int0)
def_int $int1 = 0;
while ($int1 < 4) {
    if (.cc_findbycategory(lobbyscreen_pane_playerinfo:rotator_buttons, $int1, 1) = 1) {
        if ($int1 = $int0) {
            .cc_setgraphic("rs3_icon_lobby_pagination,0");
        } else {
            .cc_setgraphic("rs3_icon_lobby_pagination,1");
        }
    }
    $int1 = calc($int1 + 1);
}
