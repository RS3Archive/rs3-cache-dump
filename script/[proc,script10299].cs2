// 10299
[proc,script10299](component $component0)(component)
if ($component0 = toplevel_v2_parent_suboverlay_group:main_layer) {
    return(toplevel_v2_parent_suboverlay_group:start_game_layer);
} else if ($component0 = group_child_dropdown:content_layer) {
    return(group_child_dropdown:start_game_layer);
} else {
    return(group_child:start_game_layer);
}
