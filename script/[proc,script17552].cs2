// 17552
[proc,script17552]
def_component $component0 = activity_progress_bar_extension:info_box_1_text;
switch_struct (%activity_progress_bar_active_struct) {
    case egwd_ful_boss_healthbar :
        if_settext("Wave: <tostring(calc(%activity_progress_bar_extension_info_box_1_value + 1))>", $component0);
    case egwd_zamorak_boss_healthbar :
        if_settext("Edicts active:<br> <tostring(%activity_progress_bar_extension_info_box_1_value)>", $component0);
    case default :
        if_settext("Phase: <tostring(calc(%activity_progress_bar_extension_info_box_1_value + 1))>", $component0);
}
