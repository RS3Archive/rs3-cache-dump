// 16067
[clientscript,script16067](component $component0)
def_string $string0 = "Unlock SILVER at 25% Enrage. This will significantly increase your chance of receiving high-value items.";
if (%egwd_wen_boss_current_enrage >= 100) {
    $string0 = "You have a significantly increased chance to receive Arch-Glacor-related item pieces and other high-value items.";
} else if (%egwd_wen_boss_current_enrage >= 25) {
    $string0 = "Unlock GOLD at 100% Enrage. This will significantly increase your chance of receiving Arch-Glacor-related item pieces.";
}
~script8800($string0, $component0, -1);
