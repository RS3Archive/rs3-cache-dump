// 7546
[clientscript,script7546]
switch_int (map_lang) {
    case 0 :
        if_setgraphic(aif_valentine_shop_bg_en, wof33_valentines_shop:background_heart);
    case 1 :
        if_setgraphic(aif_valentine_shop_bg_de, wof33_valentines_shop:background_heart);
    case 2 :
        if_setgraphic(aif_valentine_shop_bg_fr, wof33_valentines_shop:background_heart);
    case 3 :
        if_setgraphic(aif_valentine_shop_bg_pt, wof33_valentines_shop:background_heart);
}
if_settext(tostring_localised(1750, true), wof33_valentines_shop:love_emote_cost);
if_settext(tostring_localised(1000, true), wof33_valentines_shop:love_weapon_cost);
if_settext(tostring_localised(750, true), wof33_valentines_shop:love_pendant_cost);
if_settext(tostring_localised(1750, true), wof33_valentines_shop:hate_emote_cost);
if_settext(tostring_localised(1000, true), wof33_valentines_shop:hate_weapon_cost);
if_settext(tostring_localised(750, true), wof33_valentines_shop:hate_pendant_cost);
if_settext(tostring_localised(50, true), wof33_valentines_shop:random_choccy_cost);
~script7548;
if_sethide(true, wof33_valentines_shop:tooltip_box);
if_sethide(true, wof33_valentines_shop:popup_layer);
%wof33_valentines_shop_selection = 0;
