// 15106
[proc,script15106]
def_string $string0 = "";
if (%reward_chest_take_cert = 0) {
    ~script13960(reward_chest:take_cert_button, rs3tli_30px_button, false, 0);
    if_setgraphic("bank_buttons_new1,5", reward_chest:take_cert_icon);
    if_settrans(128, reward_chest:take_cert_icon);
    $string0 = "Switch to noted withdrawal mode.";
} else {
    ~script13960(reward_chest:take_cert_button, rs3tli_30px_button, false, 1);
    if_setgraphic("bank_buttons_new1,4", reward_chest:take_cert_icon);
    if_settrans(0, reward_chest:take_cert_icon);
    $string0 = "Switch to item withdrawal mode.";
}
if_setop(1, $string0, reward_chest:take_cert_button);
if_setonmouserepeat("script10009($string0, event_com, event_comsubid)", reward_chest:take_cert_button);
