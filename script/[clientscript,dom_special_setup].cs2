// 5401
[clientscript,dom_special_setup]
if (%dom_allow_spectators = 0) {
    if_sethide(true, dom_special:checkbox_selected_layer);
    if_sethide(false, dom_special:checkbox_deselected_layer);
} else {
    if_sethide(false, dom_special:checkbox_selected_layer);
    if_sethide(true, dom_special:checkbox_deselected_layer);
}
if (%dom_skip_taunt = 0) {
    if_sethide(true, dom_special:checkbox_selected_layer_1);
    if_sethide(false, dom_special:checkbox_deselected_layer_1);
} else {
    if_sethide(false, dom_special:checkbox_selected_layer_1);
    if_sethide(true, dom_special:checkbox_deselected_layer_1);
}
if (%dom_skip_victory = 0) {
    if_sethide(true, dom_special:checkbox_selected_layer_2);
    if_sethide(false, dom_special:checkbox_deselected_layer_2);
} else {
    if_sethide(false, dom_special:checkbox_selected_layer_2);
    if_sethide(true, dom_special:checkbox_deselected_layer_2);
}
%tooltip_built = 0;
if_sethide(true, dom_special:scroll_layer);
if (%dom_achieve_special_1 = 1) {
    if_sethide(false, dom_special:defeated_layer_1);
} else {
    if_sethide(true, dom_special:defeated_layer_1);
}
if (%dom_achieve_special_2 = 1) {
    if_sethide(false, dom_special:defeated_layer_2);
} else {
    if_sethide(true, dom_special:defeated_layer_2);
}
if (%dom_achieve_special_3 = 1) {
    if_sethide(false, dom_special:defeated_layer_3);
} else {
    if_sethide(true, dom_special:defeated_layer_3);
}
if (%dom_achieve_special_4 = 1) {
    if_sethide(false, dom_special:defeated_layer_4);
} else {
    if_sethide(true, dom_special:defeated_layer_4);
}
if (%dom_achieve_special_5 = 1) {
    if_sethide(false, dom_special:defeated_layer_5);
} else {
    if_sethide(true, dom_special:defeated_layer_5);
}
if (%dom_achieve_special_6 = 1) {
    if_sethide(false, dom_special:defeated_layer_6);
} else {
    if_sethide(true, dom_special:defeated_layer_6);
}
if (%dom_achieve_special_7 = 1) {
    if_sethide(false, dom_special:defeated_layer_7);
} else {
    if_sethide(true, dom_special:defeated_layer_7);
}
if (%dom_achieve_special_8 = 1) {
    if_sethide(false, dom_special:defeated_layer_8);
} else {
    if_sethide(true, dom_special:defeated_layer_8);
}
if (%dom_achieve_special_9 = 1) {
    if_sethide(false, dom_special:defeated_layer_9);
} else {
    if_sethide(true, dom_special:defeated_layer_9);
}
if (%dom_achieve_special_10 = 1) {
    if_sethide(false, dom_special:defeated_layer_10);
} else {
