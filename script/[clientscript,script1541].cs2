// 1541
[clientscript,script1541]
~script9554(skillcape_customise:modal_dialog_window_background, skillcape_customise:modal_dialog_window_border, skillcape_customise:modal_dialog_window_content, "Save Preset", toplevel_v2_default_modal_dialogue_skin_data);
if_sethide(true, skillcape_customise:positive_button_disabled_layer);
if (%distinction_capes_1 = 0 & %distinction_capes_2 = 0) {
    if_settext("That colour combination can not be saved. Please select another set of colours.", skillcape_customise:description);
    if_sethide(false, skillcape_customise:positive_button_disabled_layer);
} else {
    if_settext("Are you sure you wish to override the current preset?", skillcape_customise:description);
}
if_sethide(false, skillcape_customise:preset_confirmation_layer);
