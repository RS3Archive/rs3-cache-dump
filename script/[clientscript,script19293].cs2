[clientscript,script19293]
if_setontimer(null, trh_dungeon_crawl_overlay:boss_encounter_npc_model);
if_sethide(true, trh_dungeon_crawl_overlay:boss_encounter_dungeon_reward_layer);
if_sethide(false, trh_dungeon_crawl_overlay:boss_encounter_footer_layer);
cc_deleteall(trh_dungeon_crawl_overlay:boss_left_reward_grid);
cc_deleteall(trh_dungeon_crawl_overlay:boss_right_reward_grid);
if_scriptqueue_clear(trh_dungeon_crawl_overlay:boss_encounter_layer);
