// 222
[clientscript,snapshot_ignore_yes]
if (friend_test(%varclient_2578) = true) {
    mes_typed(^chattype_snapshotfeedback, 0, "Sorry, you cannot ignore players in your Friends List.");
} else {
    ignore_add_temp(%varclient_2578);
    mes_typed(^chattype_snapshotfeedback, 0, "You are ignoring <%varclient_2578> until you log out.");
}
%varclient_11 = false;
