        }
        if ($int4 ! 0 & $component5 ! null) {
            cc_setondrag("interface_inv_drag_slot($int1, $component2, $component5, event_mousey)");
        }
        cc_setoutline(1);
        cc_setonmouserepeat("script12093(inv_getobj($inv0, $int1), $inv0, $int1)");
        cc_setonmouseleave("script5495(null)");
        if ($component5 = null) {
            cc_setnoclickthrough(true);
        }
    } else {
        cc_setobject_nonum(null, 0);
        cc_clearops;
