// 1549
[clientscript,script1549](int $int0)
if (clientclock < $int0) {
    return;
}
def_struct $struct1 = ~trh_promo_current;
if ($struct1 = null | struct_param($struct1, trh_promo_banner_rotate) = true) {
    if_setontimer("script1654(-1)", wheel_of_fortune:advert_layer);
    if_setontimer(null, wheel_of_fortune:advert_button_container);
} else {
    if_setontimer("script1549(calc(clientclock + 800))", wheel_of_fortune:advert_button_container);
}
