// 5231
[clientscript,stockmarket_cutscene](component $component0)
switch_int (%tutorial3_cutscene_tracker) {
    case default :
        cc_deleteall($component0);
        cam_reset;
    case 0 :
        ~tutorial3_fadeout(^black, 30, $component0);
    case 1 :
        ~tutorial3_fadein(30, $component0);
    case 2 :
        if (spline_length(0) = 5) {
            cam_movealong(0, 0, 300, 800, 1, 0);
            if_setoncamfinished("script5232($component0, 1)", $component0);
        }
    case 3 :
        if (spline_length(0) = 5) {
            cam_movealong(0, 3, 500, 400, 1, 3);
        }
}
