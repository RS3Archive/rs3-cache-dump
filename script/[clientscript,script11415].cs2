// 11415
[clientscript,script11415]
if (%overload_type = 0) {
    if (stat(magic) > stat_base(magic)) {
        ~script10624(combatv2_magic_boosted_dummy_ability, 1);
        ~script10624(combatv2_magic_nerfed_dummy_ability, 0);
        return;
    } else if (stat(magic) < stat_base(magic)) {
        ~script10624(combatv2_magic_boosted_dummy_ability, 0);
        ~script10624(combatv2_magic_nerfed_dummy_ability, 1);
        return;
    }
}
~script10624(combatv2_magic_boosted_dummy_ability, 0);
~script10624(combatv2_magic_nerfed_dummy_ability, 0);
