// 11827
[proc,telemetry_set_scroll_horizontal](component $component0, int $int1, int $int2)
if ($component0 = telemetry:scroll_layer) {
    %telemetry_lastscrollpos_horizontal = $int1;
} else if ($component0 = toplevel_v2_parent_suboverlay_telemetry:scroll_layer) {
    %telemetry_suboverlay_lastscrollpos_horizontal = $int1;
}
if ($int2 = 0) {
    %telemetry_scroll_drag_active = 1;
} else {
    %telemetry_scroll_drag_active = 0;
}
