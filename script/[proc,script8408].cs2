// 8408
[proc,script8408](component $component0)(int)
def_int $int1 = if_gety($component0);
def_component $component2 = if_getparentlayer($component0);
if ($component2 = null) {
    return($int1);
}
while (if_getparentlayer($component2) ! null) {
    $int1 = calc($int1 + if_gety($component2) - if_getscrolly($component2));
    $component2 = if_getparentlayer($component2);
}
return($int1);
