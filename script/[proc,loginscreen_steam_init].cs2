// 15247
[proc,loginscreen_steam_init]
if (platformtype ! ^platformtype_steam) {
    return;
}
if (sso_available = true) {
    ~script15251(1);
} else if (~script15248 = true) {
    ~script15271(0, 0);
} else {
    %loginscreen_steam_federated_request_type = 0;
    ~script15250;
    ~script15273;
}
