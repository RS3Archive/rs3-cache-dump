// 9146
[proc,script9146]()(string)
if (%pop_meg_onmission = 1) {
    return("You have already sent <col=ffffff>Meg</col> on an adventure this week.");
} else if (%pop_meg_firsttime = 0) {
    return("Why not visit <col=ffffff>Meg</col> in the port? She's looking to be sent on adventures and you can claim a reward from her once a week.");
} else {
    return("Meg is back and ready to be sent on another adventure.");
}
