[proc,cheevo_load_list](enum $enum0, int $int1, int $int2)
if ($int1 ! -1) {
    if_sethide(false, achievements_sub:subcat_highlight);
    if_setposition(0, calc($int1 * (32 + 2)), ^setpos_abs_left, ^setpos_abs_top, achievements_sub:subcat_highlight);
    if_setsize(calc(5 - 2), calc(32 + 3), ^setsize_minus, ^setsize_abs, achievements_sub:subcat_highlight);
}
if (%cheevo_current_list ! $enum0) {
    sound_vorbis_volume(tli_click_01, 1, 0, 100);
}
%cheevo_current_list = $enum0;
~script13334($enum0, $int2);
