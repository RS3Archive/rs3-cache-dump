[clientscript,skillguide_entry_onmouseleave](int $int0)
if (cc_find(interface_1218:com_246, $int0) = true) {
    cc_setcolour(^white);
    if (cc_getgraphic = "aif_skill_select_btn_1,1") {
        cc_setgraphic("aif_skill_select_btn_1,0");
    } else {
        cc_setgraphic("aif_skill_select_btn_1,2");
    }
}
if_sethide(true, interface_1218:com_248);
