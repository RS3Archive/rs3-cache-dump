// 11386
[clientscript,script11386]
if (%overload_type = 0) {
    if (stat(defence) > stat_base(defence)) {
        ~script10624(combatv2_defence_boosted_dummy_ability, 1);
        ~script10624(combatv2_defence_nerfed_dummy_ability, 0);
        return;
    } else if (stat(defence) < stat_base(defence)) {
        ~script10624(combatv2_defence_boosted_dummy_ability, 0);
        ~script10624(combatv2_defence_nerfed_dummy_ability, 1);
        return;
    }
}
~script10624(combatv2_defence_boosted_dummy_ability, 0);
~script10624(combatv2_defence_nerfed_dummy_ability, 0);
