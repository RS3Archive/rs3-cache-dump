// 18073
[proc,script18073](dbrow $dbrow0)(string)
def_dbrow $dbrow1 = db_getfield($dbrow0, bp3_mission:col4:0, 0);
if ($dbrow1 = null) {
    return("");
}
def_string $string0 = "";
if (db_getfieldcount($dbrow1, bp3_task:col0) > 0) {
    $string0 = "+<tostring(db_getfield($dbrow0, bp3_mission:col4:1, 0))>% mission progress whilst training <col=2EF8FF><db_getfield($dbrow1, bp3_task:col0, 0)></col>";
}
return($string0);
