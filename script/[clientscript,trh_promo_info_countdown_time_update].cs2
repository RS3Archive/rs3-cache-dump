// 11199
[clientscript,trh_promo_info_countdown_time_update]
if (calc(clientclock % 50) = 0) {
    if_settext(~trh_promo_info_countdown_time(%trh_promo_time_minutes, %trh_promo_time_minuteseconds), wheel_of_fortune:countdown_text);
    if (++%trh_promo_time_minuteseconds = 60) {
        %trh_promo_time_minutes = calc(%trh_promo_time_minutes - 1);
        %trh_promo_time_minuteseconds = 0;
    }
}
