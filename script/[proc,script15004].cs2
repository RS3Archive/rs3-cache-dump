// 15004
[proc,script15004](string $string0, int $int0)
if ($int0 <= clientclock) {
    if (compare(%p_dialog_input, $string0) ! 0) {
        ~script7494;
        ~script7491(%mtxmgt_selected_tab_subcat, %mtxmgt_show_all, 0, %p_dialog_input);
        $string0 = %p_dialog_input;
        %mtxmgt_search_save = %p_dialog_input;
    }
    $int0 = calc(clientclock + 25);
    if_setontimer("script15003($string0, $int0)", mtxmgt:search_layer);
}
