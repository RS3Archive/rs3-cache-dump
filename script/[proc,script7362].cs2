// 7362
[proc,script7362]()(string)
def_string $string0 = "";
switch_int (%ecosystem_been_rewarded) {
    case 0 :
        $string0 = "You can still try and catch one of each Jadinkos this week.<br><col=FFFFFF><~script7373(%ecosystem_basic, 1, "Common Jadinko")></col>, <col=FFFFFF><~script7373(%ecosystem_amphibian, 1, "Amphibious Jadinko")></col>, <col=FFFFFF><~script7373(%ecosystem_aquatic, 1, "Aquatic Jadinko")></col>, <col=FFFFFF><~script7373(%ecosystem_shadow, 1, "Shadow Jadinko")></col>, <col=FFFFFF><~script7373(%ecosystem_carrion, 1, "Carrion Jadinko")></col>, <col=FFFFFF><~script7373(%ecosystem_carniverous, 1, "Cannibal Jadinko")></col>, <col=FFFFFF><~script7373(%ecosystem_camouflaged, 1, "Camouflaged Jadinko")></col>, <col=FFFFFF><~script7373(%ecosystem_diseased, 1, "Diseased Jadinko")></col>, <col=FFFFFF><~script7373(%ecosystem_draconic, 1, "Draconic Jadinko")></col> and <col=FFFFFF><~script7373(%ecosystem_igneous, 1, "Igneous Jadinko")></col>.";
    case 1 :
        $string0 = "You have caught one of each Jadinkos this week but have yet to claim your <col=FFFFFF>XP</col> and <col=FFFFFF>clothing</col> rewards from Papa Mambo.";
    case 2 :
        $string0 = "You have caught one of each Jadinkos this week but have yet to claim your <col=FFFFFF>clothing</col> reward from Papa Mambo.";
    case 3 :
        $string0 = "You have caught one of each Jadinkos this week and have already claimed all your rewards.";
}
switch_int (%ecosystem_caught_gods) {
    case 0 :
        $string0 = "<$string0><br>You can still try and catch one of each God Jadinkos this week.<br><col=FFFFFF><~script7373(%ecosystem_guthix, 1, "Guthix Jadinko")></col>, <col=FFFFFF><~script7373(%ecosystem_saradomin, 1, "Saradomin Jadinko")></col> and <col=FFFFFF><~script7373(%ecosystem_zamorak, 1, "Zamorak Jadinko")></col>.";
    case 1 :
        $string0 = "<$string0><br>You have caught one of each God Jadinkos this week but have yet to claim your extra <col=FFFFFF>XP</col> and <col=FFFFFF>clothing</col> rewards from Papa Mambo.";
    case 2 :
        $string0 = "<$string0><br>You have caught one of each God Jadinkos this week but have yet to claim your extra <col=FFFFFF>clothing</col> reward from Papa Mambo.";
    case 3 :
        $string0 = "<$string0><br>You have caught one of each God Jadinkos this week but have yet to claim your extra <col=FFFFFF>temporary farming boost</col> from Papa Mambo.";
    case 4 :
        $string0 = "<$string0><br>You have caught one of each God Jadinkos this week and have already claimed all your reward.";
}
return($string0);
