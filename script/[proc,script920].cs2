// 920
[proc,script920](int $int0)(int)
%objreq_lines = 0;
def_string $string0 = "";
def_int $int1 = 0;
if (%objreq_obj ! null) {
    if (compare(oc_iop(%objreq_obj, 2), "Wear") = 0 | compare(oc_iop(%objreq_obj, 2), "Wield") = 0) {
        $int1 = 1;
    }
    if_setobject_nonum(%objreq_obj, -1, obj_info:obj_graphic);
    if_settext(oc_name(%objreq_obj), obj_info:obj_name);
    if (map_members = false & oc_members(%objreq_obj) = 1) {
        ~script922("This is a members item. Additional information is not available on this world.", ^settextalign_centre, $int0);
    } else {
        $string0 = ~obj_warning;
        if (compare($string0, "") ! 0) {
            ~script922($string0, ^settextalign_centre, $int0);
            %objreq_lines = calc(%objreq_lines + 1);
        }
        ~script921(%objreq_desc, ^settextalign_centre, $int0);
        if (compare(oc_param(%objreq_obj, obj_info_extra), "") ! 0) {
            ~script921(" ", ^settextalign_centre, $int0);
            ~script921(oc_param(%objreq_obj, obj_info_extra), ^settextalign_centre, $int0);
        }
        if (calc(oc_param(%objreq_obj, objreq_requirement_priority) % 2) = 1) {
            if (compare(%objreq_wearable, "") ! 0 & $int1 = 1) {
                ~script921(%objreq_wearable, ^settextalign_left, $int0);
            }
            if (compare(%objreq_useable, "") ! 0) {
                ~script921(%objreq_useable, ^settextalign_left, $int0);
            }
        } else {
            if (compare(%objreq_useable, "") ! 0) {
                ~script921(%objreq_useable, ^settextalign_left, $int0);
            }
            if (compare(%objreq_wearable, "") ! 0 & $int1 = 1) {
                ~script921(%objreq_wearable, ^settextalign_left, $int0);
            }
        }
        $string0 = ~script912(%objreq_obj);
        if (compare($string0, "") ! 0) {
            ~script921($string0, ^settextalign_left, $int0);
        }
        if (compare(%objreq_bonus_left, "") ! 0 & $int1 = 1) {
            ~script923(%objreq_bonus_left, %objreq_bonus_mid, %objreq_bonus_right, $int0);
        }
    }
} else {
    ~script921("Select an item to see its information.", ^settextalign_centre, $int0);
}
return(calc(6 * 2 + %objreq_lines * 11));
