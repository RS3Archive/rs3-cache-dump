// 7035
[clientscript,script7035](int $int0, component $component1)
if ($int0 = 1) {
    if (%combatv2_actionbar_locked = 1) {
        if_setgraphic(hud_combat_btn_locked_over, $component1);
    } else {
        if_setgraphic(hud_combat_btn_unlocked_over, $component1);
    }
} else if (%combatv2_actionbar_locked = 1) {
    if_setgraphic(hud_combat_btn_locked, $component1);
} else {
    if_setgraphic(hud_combat_btn_unlocked, $component1);
}
