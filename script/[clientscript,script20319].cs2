// 20319
[clientscript,script20319](component $component0)
if ($component0 = league_parent_tasks:requirement_listener) {
    ~script20320(league_parent_tasks:task_panel, league_parent_tasks:task_scrollbar);
} else {
    ~script20320(league_child_tasks:task_panel, league_child_tasks:task_scrollbar);
}
