// 6286
[clientscript,script6286]
if (%cruc_overlay_maximise_state < 0) {
    %cruc_overlay_maximise_state = 0;
}
if (%cruc_overlay_maximise_state = 0) {
    %cruc_overlay_maximise_state = 1;
    if_sethide(true, cruc_battle_overlay:information_box);
    if_sethide(false, cruc_battle_overlay:minimised_layer);
    if_setposition(120, 2, ^setpos_abs_right, ^setpos_abs_top, cruc_battle_overlay:min_max_button);
} else {
    %cruc_overlay_maximise_state = 0;
    if_sethide(false, cruc_battle_overlay:information_box);
    if_sethide(true, cruc_battle_overlay:minimised_layer);
    if_setposition(120, 60, ^setpos_abs_right, ^setpos_abs_top, cruc_battle_overlay:min_max_button);
}
