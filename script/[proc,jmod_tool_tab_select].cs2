// 11264
[proc,jmod_tool_tab_select](component $component0)
if_sethide(true, jmod_tool:tools_tab);
if_sethide(true, jmod_tool:status_tab);
if_sethide(true, jmod_tool:chat_tab);
if_sethide(true, jmod_tool:outfit_tab);
if_sethide(true, jmod_tool:video_tab);
if_sethide(true, jmod_tool:tools_tab_selected_layer);
if_sethide(true, jmod_tool:status_tab_selected_layer);
if_sethide(true, jmod_tool:chat_tab_selected_layer);
if_sethide(true, jmod_tool:outfit_tab_selected_layer);
if_sethide(true, jmod_tool:video_tab_selected_layer);
switch_component ($component0) {
    case jmod_tool:tools_tab_active_layer :
        if_sethide(false, jmod_tool:tools_tab);
        if_sethide(false, jmod_tool:tools_tab_selected_layer);
    case jmod_tool:status_tab_active_layer :
        if_sethide(false, jmod_tool:status_tab);
        if_sethide(false, jmod_tool:status_tab_selected_layer);
    case jmod_tool:chat_tab_active_layer :
        if_sethide(false, jmod_tool:chat_tab);
        if_sethide(false, jmod_tool:chat_tab_selected_layer);
    case jmod_tool:outfit_tab_active_layer :
        if_sethide(false, jmod_tool:outfit_tab);
        if_sethide(false, jmod_tool:outfit_tab_selected_layer);
    case jmod_tool:video_tab_active_layer :
        if_sethide(false, jmod_tool:video_tab);
        if_sethide(false, jmod_tool:video_tab_selected_layer);
}
