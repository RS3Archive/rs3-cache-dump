// 1892
[clientscript,friendschatsetup_onload](component $component0)
%friend_lastfilter = "";
if_setonfriendtransmit("friendschatsetup_onfriendtransmit", $component0);
if (userdetail_quickchat = true) {
    if_settext("Friends Chat channel:", friendschatsetup:opt_prefix_head);
    if_setop(1, "Enable", friendschatsetup:opt_prefix);
}
~script10428(friendschatsetup:dropdown_build, friendschatsetup:dropdown_click, friends_sort_dropdown, -1, "Choose the sort mode", %friendschat_sort_mode, 0);
