[clientscript,script2663]
def_component $component0 = enum(int, component, mah3_active_strip, %mah3_strip_select);
if ($component0 = null) {
    return;
}
if (if_getx($component0) > 3) {
    sound_vorbis_volume(mah5_decoder_slide, 1, 0, 50);
    if_setposition(calc(if_getx($component0) - 2), if_gety($component0), ^setpos_abs_left, ^setpos_abs_top, $component0);
}
