// 15413
[proc,script15413]
def_int $int0 = 1;
def_dbrow $dbrow1 = ~trh193_get_bonus_dbrow($int0);
def_graphic $graphic2 = null;
def_int $int3 = 0;
def_int $int4 = 0;
def_int $int5 = 3;
def_int $int6 = 8;
def_int $int7 = 1;
def_int $int8 = 0;
def_int $int9 = 0;
def_int $int10 = 0;
while ($dbrow1 ! null) {
    $graphic2, $int10, $int9 = db_getfield($dbrow1, trh193_bonus:col4, 0);
    $int3 = db_getfield($dbrow1, trh193_bonus:col1, 0);
    $int4 = db_getfield($dbrow1, trh193_bonus:col2, 0);
    if ($graphic2 ! null) {
        if ($int3 > 0) {
            if ($int3 <= $int5) {
                if_setgraphic($graphic2, trh193_overlay:bonus_display_graphic_1_min);
            }
            if ($int3 >= $int6) {
                if_setgraphic($graphic2, trh193_overlay:bonus_display_graphic_1_max);
                ~script15415(trh193_overlay:min_multiplier_tooltip_layer, $int3, null);
            }
        }
        if ($int4 > 0) {
            if ($int4 <= $int7) {
                if_setgraphic($graphic2, trh193_overlay:bonus_display_graphic_2_min);
            }
            if ($int4 > $int8) {
                if_setgraphic($graphic2, trh193_overlay:bonus_display_graphic_2_max);
                ~script15415(trh193_overlay:increase_multiplier_tooltip_layer, $int4, null);
            }
        }
    } else {
        ~error("Missing bonus icon for bonus with ID: <tostring($int0)>");
    }
    $dbrow1 = ~trh193_get_bonus_dbrow(++$int0);
}
~script11940;
