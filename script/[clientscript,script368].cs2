// 368
[clientscript,script368](component $component0)
switch_component ($component0) {
    case div_converting:xp_click :
        %div_convert_setting = 0;
    case div_converting:energy_click :
        %div_convert_setting = 2;
    case div_converting:enhanced_click :
        %div_convert_setting = 1;
}
~script369;
