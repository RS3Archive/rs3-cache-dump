// 19006
[proc,script19006]
def_int $int0 = 1;
while (++$int0 < if_getnextsubid(trh119_buried_treasure_overlay:bonus_prize_claim)) {
    if (cc_find(trh119_buried_treasure_overlay:bonus_prize_claim, $int0) = true) {
        cc_settrans(0);
        cc_sethide(false);
        if (cc_param(rs3tli_component_speed_y) ! 0) {
            cc_setposition(cc_param(rs3tli_component_original_pos_x), cc_param(rs3tli_component_target_pos_y), cc_param(rs3tli_component_target_align_x), cc_param(rs3tli_component_target_align_y));
        }
        if (cc_param(rs3tli_component_resize_step) ! 0) {
            cc_setsize(cc_param(rs3tli_component_target_width), cc_param(rs3tli_component_target_height), ^setsize_abs, ^setsize_abs);
        }
        cc_setontimer(null);
    }
}
