if (oc_members($obj1) = 1) {
    $string0 = append($string0, "Familiar: <col=F8D56B><oc_name($obj1)></col>");
} else {
    $string0 = append($string0, "Familiar: <col=B8D1D1><oc_name($obj1)></col>");
