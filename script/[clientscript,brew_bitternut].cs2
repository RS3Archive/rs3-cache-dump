// 1752
[clientscript,brew_bitternut](component $component0, component $component1)
if (%brew_varc_bitternuts > 0) {
    if_setmodel(game_brew_if_bitternut_on, $component0);
    if_setcolour(0x33ff00, $component1);
} else {
    if_setmodel(game_brew_if_bitternut_off, $component0);
    if_setcolour(0x910000, $component1);
}
if_settext(tostring(%brew_varc_bitternuts), $component1);
