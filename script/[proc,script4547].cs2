// 4547
[proc,script4547](component $component0, component $component1, component $component2, component $component3, component $component4, component $component5, component $component6, component $component7)
cc_deleteall($component0);
cc_deleteall($component1);
cc_deleteall($component2);
cc_deleteall($component3);
~rs3_background_panel($component3, struct_21361);
~if_add_child_text($component3, 0, if_getnextsubid($component3), 0, 0, ^setpos_abs_left, ^setpos_abs_top, 0, 0, ^setsize_minus, ^setsize_minus, dbrow_2100, "If you join a clan you will be able to<br>chat with your clanmates from here.");
cc_settextalign(^settextalign_centre, ^settextalign_centre, 0);
if (~is_mobile_client = false) {
    if_settext("Not in chat", interface_912:com_22);
    if_setsize(if_getwidth($component7), 0, ^setsize_abs, ^setsize_abs, $component7);
} else {
    if_settext("(Not in clan chat)", interface_1044:com_23);
}
if_setscrollsize(0, 0, $component4);
if_setscrollpos(0, 0, $component4);
if_sethide(true, $component5);
