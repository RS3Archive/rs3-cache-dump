[proc,script235](graphic $graphic0, graphic $graphic1, graphic $graphic2, graphic $graphic3)(graphic)
switch_int (map_lang) {
    case 0 :
        return($graphic0);
    case 1 :
        return($graphic1);
    case 2 :
        return($graphic2);
    case 3 :
        return($graphic3);
}
return($graphic0);
