// 11785
[proc,script11785]
cc_sethide(false);
switch_int (random(8)) {
    case 0 :
        cc_setgraphic(elf_hefin_logo);
    case 1 :
        cc_setgraphic(elf_iowerth_logo);
    case 2 :
        cc_setgraphic(elf_cadarn_logo);
    case 3 :
        cc_setgraphic(elf_ithel_logo);
    case 4 :
        cc_setgraphic(elf_cryws_logo);
    case 5 :
        cc_setgraphic(elf_trahaern_logo);
    case 6 :
        cc_setgraphic(elf_amlodd_logo);
    case 7 :
        cc_setgraphic(elf_meilyr_logo);
}
cc_set2dangle(random(65535));
def_int $int0 = calc(random(150) + 50);
if (random(2) = 0) {
    $int0 = calc(0 - $int0);
}
cc_setparam(easter15_dtheta, $int0);
def_int $int1 = calc(random(200) - 100);
def_int $int2 = calc(random(3) + 1);
def_int $int3 = calc(random(7) - 3);
switch_int (random(4)) {
    case 0 :
        cc_setposition(calc(0 - cc_getwidth), $int1, ^setpos_abs_left, ^setpos_abs_centre);
        cc_setparam(easter15_dx, $int2);
        cc_setparam(easter15_dy, $int3);
    case 1 :
        cc_setposition($int1, calc(0 - cc_getheight), ^setpos_abs_centre, ^setpos_abs_top);
        cc_setparam(easter15_dx, $int3);
        cc_setparam(easter15_dy, $int2);
    case 2 :
        cc_setposition(calc(0 - cc_getwidth), $int1, ^setpos_abs_right, ^setpos_abs_centre);
        cc_setparam(easter15_dx, calc(0 - $int2));
        cc_setparam(easter15_dy, $int3);
    case 3 :
        cc_setposition($int1, calc(0 - cc_getheight), ^setpos_abs_centre, ^setpos_abs_bottom);
        cc_setparam(easter15_dx, $int3);
        cc_setparam(easter15_dy, calc(0 - $int2));
}
