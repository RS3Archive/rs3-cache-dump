// 15703
[clientscript,script15703](int $int0, string $string0)
switch_int ($int0) {
    case 0 :
        if_settrans(0, interface_744:com_145);
    case 250 :
        if_settrans(0, interface_744:com_145);
        if_settext($string0, interface_744:com_145);
        if_setontimer(null, interface_744:com_145);
        return;
    case default :
        if ($int0 >= 200) {
            if_settrans(min(255, calc(if_gettrans(interface_744:com_145) + 5)), interface_744:com_145);
        }
}
if_setontimer("script15703(calc($int0 + 1), $string0)", interface_744:com_145);
