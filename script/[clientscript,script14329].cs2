// 14329
[clientscript,script14329](component $component0, component $component1, component $component2)
def_int $int3 = 0;
def_obj $obj4 = null;
switch_component ($component2) {
    case hunter_charms_exchange:spirit_lure_item :
        ~script14331(%huntcharm_stored_lure, huntcharm_lure, $component1, $component2);
        if_setonvartransmit("script14330($component1, $component2){hunting_charm_third}", $component0);
    case hunter_charms_exchange:yaktwee_item :
        $int3 = %huntcharm_stored_stick;
        if ($int3 > 1 & %huntcharm_stickcount >= 1000) {
            $obj4 = huntcharm_stave_enhanced;
            $int3 = 1;
        } else {
            $obj4 = huntcharm_stave;
        }
        ~script14331($int3, $obj4, $component1, $component2);
        if_setonvartransmit("script14330($component1, $component2){hunting_charm_main, hunting_charm_third}", $component0);
    case hunter_charms_exchange:gold_slice_item :
        ~script14331(%huntcharm_stored_gold, huntcharm_fragment_gold, $component1, $component2);
        if_setonvartransmit("script14330($component1, $component2){hunting_charm_third}", $component0);
    case hunter_charms_exchange:crimson_slice_item :
        ~script14331(%huntcharm_stored_crimson, huntcharm_fragment_crimson, $component1, $component2);
        if_setonvartransmit("script14330($component1, $component2){hunting_charm_third}", $component0);
    case hunter_charms_exchange:green_slice_item :
        ~script14331(%huntcharm_stored_green, huntcharm_fragment_green, $component1, $component2);
        if_setonvartransmit("script14330($component1, $component2){hunting_charm_third}", $component0);
    case hunter_charms_exchange:blue_slice_item :
        ~script14331(%huntcharm_stored_blue, huntcharm_fragment_blue, $component1, $component2);
        if_setonvartransmit("script14330($component1, $component2){hunting_charm_second}", $component0);
    case hunter_charms_exchange:mystical_slice_item :
        ~script14331(%huntcharm_stored_mystical, huntcharm_fragment_mystical, $component1, $component2);
        if_setonvartransmit("script14330($component1, $component2){hunting_charm_main}", $component0);
}
