// 10966
[clientscript,script10966](component $component0)
def_string $string0 = "";
switch_component ($component0) {
    case trh44_valentines15_milestones:love_high :
        if (%trh44_valentines15_love_emote_unlocked = 0) {
            $string0 = "Unlock the 'Efficiency' emote once you've reached <tostring_localised(600, true)> sprinkled petals of love.";
        } else {
            $string0 = "Unlocked! Open your emotes tab to perform the 'Efficiency' emote.";
        }
    case trh44_valentines15_milestones:hate_high :
        if (%trh44_valentines15_hate_emote_unlocked = 0) {
            $string0 = "Unlock the 'No More!' emote once you've reached <tostring_localised(600, true)> crushed petals of hate.";
        } else {
            $string0 = "Unlocked! Open your emotes tab to perform the 'No More!' emote.";
        }
    case trh44_valentines15_milestones:love_low :
        if (%trh44_valentines15_love_shield_unlocked = 0) {
            $string0 = "Unlock the Aegis of devotion once you've reached <tostring_localised(200, true)> sprinkled petals of love. Ironman players cannot unlock this.";
        } else {
            $string0 = "Unlocked! You own the <oc_name(trh44_valentines15_love_shield_1)>. If you lose it then you can reclaim another from Diango in Draynor.";
        }
    case trh44_valentines15_milestones:hate_low :
        if (%trh44_valentines15_hate_shield_unlocked = 0) {
            $string0 = "Unlock the Bulwark of revenge once you've reached <tostring_localised(200, true)> crushed petals of hate. Ironman players cannot unlock this.";
        } else {
            $string0 = "Unlocked! You own the <oc_name(trh44_valentines15_hate_shield_1)>. If you lose it then you can reclaim another from Diango in Draynor.";
        }
    case trh44_valentines15_milestones:love_med :
        if (%trh44_valentines15_love_weapon_unlocked = 0) {
            $string0 = "Unlock the Ardent mace once you've reached <tostring_localised(400, true)> sprinkled petals of love. Ironman players cannot unlock this.";
        } else {
            $string0 = "Unlocked! You own the <oc_name(trh44_valentines15_love_weapon_1)>. If you lose it then you can reclaim another from Diango in Draynor.";
        }
    case trh44_valentines15_milestones:hate_med :
        if (%trh44_valentines15_hate_weapon_unlocked = 0) {
            $string0 = "Unlock the Heartseeker crossbow once you've reached <tostring_localised(400, true)> crushed petals of hate. Ironman players cannot unlock this.";
        } else {
            $string0 = "Unlocked! You own the <oc_name(trh44_valentines15_hate_weapon_1)>. If you lose it then you can reclaim another from Diango in Draynor.";
        }
    case trh44_valentines15_milestones:love_absurd :
        if (%trh44_valentines15_love_necklace_unlocked = 0) {
            $string0 = "Unlock the Lovers medallion once you've reached <tostring_localised(1000, true)> sprinkled petals of love.";
        } else {
            $string0 = "Unlocked! You own the <oc_name(trh44_valentines15_love_necklace)>. If you lose it then you can reclaim another from Diango in Draynor.";
        }
    case trh44_valentines15_milestones:hate_absurd :
        if (%trh44_valentines15_hate_necklace_unlocked = 0) {
            $string0 = "Unlock the Haters medallion once you've reached <tostring_localised(1000, true)> crushed petals of hate.";
        } else {
            $string0 = "Unlocked! You own the <oc_name(trh44_valentines15_hate_necklace)>. If you lose it then you can reclaim another from Diango in Draynor.";
        }
    case trh44_valentines15_milestones:insane :
        if (%trh44_valentines15_epic_unlocked = 0) {
            $string0 = "Unlock the Crown of the fallen once you've reached <tostring_localised(1250, true)> sprinkled petals of love and <tostring_localised(1250, true)> crushed petals of hate.";
        } else {
            $string0 = "Unlocked! You own the <oc_name(trh44_valentines15_epic)>. If you lose it then you can reclaim another from Diango in Draynor.";
        }
    case trh44_valentines15_milestones:add_to_love :
        $string0 = "Sprinkle your rose petals into the love side to fill the bar and unlock rewards.";
    case trh44_valentines15_milestones:add_to_hate :
        $string0 = "Crush your rose petals into the hate side to fill the bar and unlock rewards.";
    case trh44_valentines15_milestones:petals :
        $string0 = "You can acquire rose petals through killing, skilling, daily challenges, trading (including GE), and Treasure Hunter.";
    case trh44_valentines15_milestones:flip :
        $string0 = "With rose petals you can make love potions as well as unlock previous year Valentine rewards that you may have missed.";
