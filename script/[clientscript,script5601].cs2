// 5601
[clientscript,script5601](component $component0, int $int1, int $int2, int $int3)
if (spline_length(0) > calc($int1 + 1)) {
    cam_movealong(0, $int1, $int2, $int3, 1, $int1);
}
if (spline_length(0) = calc($int1 + 1)) {
    if_setoncamfinished(null, $component0);
} else {
    $int1 = calc($int1 + 1);
    if_setoncamfinished("script5601(event_com, $int1, 800, 800)", $component0);
}
