// 12270
[clientscript,script12270]
if_sethide(false, godscore_window:default);
if_sethide(true, godscore_window:nomel_icthlarin_chosen);
if_sethide(true, godscore_window:nomel_death_chosen);
if_sethide(true, godscore_window:fotg);
if_sethide(true, godscore_window:nomel_icthlarin_chosen_fotg);
if_sethide(true, godscore_window:nomel_death_chosen_fotg);
if (%godscore_multivar > 0) {
    if_sethide(true, godscore_window:default);
    switch_int (%godscore_multivar) {
        case 1 :
            if_sethide(false, godscore_window:nomel_icthlarin_chosen);
        case 2 :
            if_sethide(false, godscore_window:nomel_death_chosen);
        case 3 :
            if_sethide(false, godscore_window:fotg);
        case 4 :
            if_sethide(false, godscore_window:nomel_icthlarin_chosen_fotg);
        case 5 :
            if_sethide(false, godscore_window:nomel_death_chosen_fotg);
    }
}
