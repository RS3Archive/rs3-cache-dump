// 1858
[proc,script1858](int $int0)(boolean)
switch_int (%league_active_player) {
    case 1 :
        switch_int ($int0) {
            case 0 :
                return(true);
            case 1 :
                return(true);
            case 2 :
                return(true);
            case 3 :
                return(true);
            case 4 :
                return(true);
            case 5 :
                return(true);
            case 6 :
                return(true);
            case 7 :
                if (%league_relic_cache_current_tier >= 4) {
                    return(true);
                }
            case 8 :
                return(true);
            case 9 :
                return(true);
            case 10 :
                return(true);
            case 11 :
                if (%league_relic_cache_current_tier >= 2) {
                    return(true);
                }
            case 12 :
                if (quest_finished(quest_fort_intro) = false) {
                    return(true);
                }
            case 13, 14 :
                if (%league_relic_cache_current_tier >= 4) {
                    return(true);
                }
            case 15 :
                if (%league_relic_cache_current_tier >= 5) {
                    return(true);
                }
            case 16 :
                if (%league_relic_cache_current_tier >= 3) {
                    return(true);
                }
            case default :
                ~error("League 1 does not specify feature <tostring($int0)>");
                return(false);
        }
    case 0 :
        return(false);
    case -1 :
        return(false);
    case default :
        ~error("League <tostring(%league_active_player)> does not specify feature enabled.");
        return(false);
}
return(false);
