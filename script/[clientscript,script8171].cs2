// 8171
[clientscript,script8171](component $component0, int $int1)
if (cc_find($component0, $int1) = true) {
    if (%toplevel_v2_customization_lock = 1) {
        cc_setgraphic(rs3_menu_btn_locked_over);
        ~script8800("Customisation is disabled. Click here<br>to enable customisation.", $component0, $int1);
    } else {
        cc_setgraphic(rs3_menu_btn_unlocked_over);
        ~script8800("Customisation is enabled.  Click here<br>to disable customisation.", $component0, $int1);
    }
}
