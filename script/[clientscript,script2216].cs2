// 2216
[clientscript,script2216]
if (%easter10_conveyorstatus = 2) {
    if (%easter10_pushbarstatus = 0) {
        sound_synth(easter10_conveyor_push, 1, 0);
    }
    %easter10_pushbarstatus = 1;
    if_setontimer("script2214", easter10_nuts:content);
} else {
    mes("There is nothing to push off!");
}
