// 19291
[proc,script19291]
if_setmodel(null, trh_dungeon_crawl_overlay:boss_encounter_npc_model);
if_sethide(true, trh_dungeon_crawl_overlay:boss_encounter_examine_layer);
if_settext("Claim Prizes", trh_dungeon_crawl_overlay:boss_encounter_button_text);
if_sethide(false, trh_dungeon_crawl_overlay:boss_encounter_dungeon_reward_layer);
if_sethide(false, trh_dungeon_crawl_overlay:boss_encounter_footer_layer);
