// 468
[clientscript,script468]
if (activeclansettings_find_affined(0) = true) {
    ~static_checkbox_create(interface_178:com_16, interface_178:com_17, "Show broadcasts to guests", "Hide broadcasts to guests", "Show broadcasts to guests", calc(1 - %varclansettingbit_41364));
    if (%varclansettingbit_41363 = 0) {
        if_sethide(true, interface_178:com_8);
        if_sethide(false, interface_178:com_9);
        if_sethide(false, interface_178:com_11);
        if_sethide(true, interface_178:com_12);
        if_sethide(false, interface_178:com_14);
        if_sethide(true, interface_178:com_15);
    } else if (%varclansettingbit_41363 = 1) {
        if_sethide(false, interface_178:com_8);
        if_sethide(true, interface_178:com_9);
        if_sethide(true, interface_178:com_11);
        if_sethide(false, interface_178:com_12);
        if_sethide(false, interface_178:com_14);
        if_sethide(true, interface_178:com_15);
    } else {
        if_sethide(false, interface_178:com_8);
        if_sethide(true, interface_178:com_9);
        if_sethide(false, interface_178:com_11);
        if_sethide(true, interface_178:com_12);
        if_sethide(true, interface_178:com_14);
        if_sethide(false, interface_178:com_15);
    }
} else {
    mes("You're not in a clan so can't access this.");
    return;
}
