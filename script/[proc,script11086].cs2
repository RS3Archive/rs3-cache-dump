// 11086
[proc,script11086](struct $struct0)(string)
switch_struct ($struct0) {
    case halloween_spooky_time :
        return("<tostring(~script134)>% xp");
    case masterwork_set_effect_damage_pool :
        return(~script2545);
    case combatv2_prayer_rate :
