def_int $int2 = max(1, calc(%machinima_livecamera_camera_pos_speed / 12));
def_int $int3 = max(1, calc(%machinima_livecamera_camera_rot_speed / 2));
def_int $int4 = 1000;
def_int $int5 = 3000;
switch_int ($int0) {
    case 0 :
        $int1 = calc($int1 / $int4 * $int2);
