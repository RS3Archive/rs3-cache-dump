// 6629
[clientscript,script6629]
if (%toplevel_v2_mobile_interface = 1) {
    if (%lore_npc_head = null) {
        if_sethide(true, toplevel_v2_combat_bar_mobile:main_ops);
    }
    if_sethide(true, toplevel_v2_combat_bar_mobile:call_op1);
    if_sethide(true, toplevel_v2_combat_bar_mobile:call_layer);
    if_sethide(true, toplevel_v2_combat_bar_mobile:dismiss_op1);
    if_sethide(true, toplevel_v2_combat_bar_mobile:dismiss_layer);
    if_sethide(true, toplevel_v2_combat_bar_mobile:details_op1);
    if_sethide(true, toplevel_v2_combat_bar_mobile:details_layer);
    if_sethide(false, toplevel_v2_combat_bar_mobile:summon_pet);
    if_sethide(true, toplevel_v2_combat_bar_mobile:call_pet);
    if_sethide(false, toplevel_v2_combat_bar_mobile:select_leftclick_layer);
} else if (%toplevel_v2_legacy_interface = 0) {
    if (%lore_npc_head = null) {
        if_sethide(true, toplevel_v2_combat_bar:main_ops);
    }
    if_sethide(true, toplevel_v2_combat_bar:call_op1);
    if_sethide(true, toplevel_v2_combat_bar:call_layer);
    if_sethide(true, toplevel_v2_combat_bar:dismiss_op1);
    if_sethide(true, toplevel_v2_combat_bar:dismiss_layer);
    if_sethide(true, toplevel_v2_combat_bar:details_op1);
    if_sethide(true, toplevel_v2_combat_bar:details_layer);
    if_sethide(false, toplevel_v2_combat_bar:summon_pet);
    if_sethide(true, toplevel_v2_combat_bar:call_pet);
    if_sethide(false, toplevel_v2_combat_bar:select_leftclick_layer);
} else {
    if (%lore_npc_head = null) {
        if_sethide(true, topstat_lore:main_ops);
    }
    if_sethide(true, topstat_lore:call_op1);
    if_sethide(true, topstat_lore:call_layer);
    if_sethide(true, topstat_lore:dismiss_op1);
    if_sethide(true, topstat_lore:dismiss_layer);
    if_sethide(true, topstat_lore:details_op1);
    if_sethide(true, topstat_lore:details_layer);
    if_sethide(false, topstat_lore:summon_pet);
    if_sethide(true, topstat_lore:call_pet);
    if_sethide(false, topstat_lore:select_leftclick_layer);
}
