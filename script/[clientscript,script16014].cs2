// 16014
[clientscript,script16014](component $component0, int $int1, int $int2, int $int3, int $int4)
$int1 = calc($int1 * -1);
~spin_sprite($component0, scale(calc(500 * $int1), 100, $int3));
if ($int4 = 0) {
    return;
}
def_int $int5 = calc((clientclock + $int2) % 200);
if ($int5 < 100) {
    if_setcolour(~script16017(13923046, 2683126, $int5), $component0);
} else {
    if_setcolour(~script16017(2683126, 13923046, calc($int5 - 100)), $component0);
}
