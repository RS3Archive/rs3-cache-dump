// 15967
[proc,script15967]()(boolean)
if_setgraphic(trh193_currency, wheel_of_fortune:reward_layer_additional_prize_object);
if_settext("<tostring(25)>x <oc_name(trh193_currency)> as a bonus reward.", wheel_of_fortune:reward_layer_additional_prize_text);
if_setposition(0, 25, ^setpos_abs_centre, ^setpos_abs_top, wheel_of_fortune:reward_layer_additional_prize_object);
if_setsize(75, 75, ^setsize_abs, ^setsize_abs, wheel_of_fortune:reward_layer_additional_prize_object);
if_sethide(true, wheel_of_fortune:reward_layer_additional_prize_rarity_gem);
return(true);
