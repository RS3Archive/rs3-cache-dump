// 5245
[proc,script5245]
def_int $int0 = 0;
def_int $int1 = 0;
if (if_getgraphic(hlr4m_stealingcreation_rewards:volatile_checkbox_graphic) = "aif_checkbox_large,3") {
    $int0 = calc($int0 + 20);
    $int1 = calc($int1 + 20);
}
if (if_getgraphic(hlr4m_stealingcreation_rewards:proto_checkbox_graphic) = "aif_checkbox_large,3") {
    $int0 = calc($int0 + 20);
    $int1 = calc($int1 + 20);
}
if (if_getgraphic(hlr4m_stealingcreation_rewards:body_checkbox_graphic) = "aif_checkbox_large,3") {
    $int0 = calc($int0 + 30);
    $int1 = calc($int1 + 20);
}
if (if_getgraphic(hlr4m_stealingcreation_rewards:leg_checkbox_graphic) = "aif_checkbox_large,3") {
    $int0 = calc($int0 + 28);
    $int1 = calc($int1 + 20);
}
if (if_getgraphic(hlr4m_stealingcreation_rewards:head_checkbox_graphic) = "aif_checkbox_large,3") {
    $int0 = calc($int0 + 24);
    $int1 = calc($int1 + 20);
}
if (if_getgraphic(hlr4m_stealingcreation_rewards:weapon_checkbox_graphic) = "aif_checkbox_large,3") {
    $int0 = calc($int0 + 26);
    $int1 = calc($int1 + 20);
}
if (if_getgraphic(hlr4m_stealingcreation_rewards:shield_checkbox_graphic) = "aif_checkbox_large,3") {
    $int0 = calc($int0 + 200);
    $int1 = calc($int1 + 200);
}
if (if_getgraphic(hlr4m_stealingcreation_rewards:artisans_checkbox_graphic) = "aif_checkbox_large,3") {
    $int0 = calc($int0 + 100);
}
if (if_getgraphic(hlr4m_stealingcreation_rewards:fletchers_checkbox_graphic) = "aif_checkbox_large,3") {
    $int0 = calc($int0 + 100);
}
if (%sc_points < $int0 | %sc_points < $int1) {
    if_setcolour(^red, hlr4m_stealingcreation_rewards:reward_points_cost);
} else {
    if_setcolour(~rgb_to_hex(255, 255, 255), hlr4m_stealingcreation_rewards:reward_points_cost);
}
