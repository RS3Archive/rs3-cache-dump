if (oc_param(inv_getobj(worn, 3), elfcity_crystal_tool_construction) = 1) {
    $int0 = calc($int0 - 5);
} else if (inv_total(inv, eyeglo_crystal_saw) > 0) {
    $int0 = calc($int0 - 3);
}
if (inv_totalcat(worn, godss_chisel) > 0 | inv_totalcat(inv, godss_chisel) > 0) {
    $int0 = calc($int0 - 1);
}
return($int0);
