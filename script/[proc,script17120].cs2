// 17120
[proc,script17120]
%lobbyscreen_friendlist_selected_friend = -1;
~rs3_scrollbar_vertical(lobbyscreen_pane_mobile_social:player_list_scroll, lobbyscreen_pane_mobile_social:player_list_build);
~rs3_scrollbar_vertical(lobbyscreen_pane_mobile_social:chat_scroll, lobbyscreen_pane_mobile_social:chat_build);
%lobby_pmchat_lastscrollpos = if_getheight(lobbyscreen_pane_mobile_social:chat_build);
if_setontimer(null, lobbyscreen_pane_mobile_social:main);
if_setontimer("script15593(1)", lobbyscreen_pane_mobile_social:player_list_panel);
if_sethide(true, lobbyscreen_pane_mobile_social:chat_input);
if_setsize(36, 20, ^setsize_minus, ^setsize_minus, lobbyscreen_pane_mobile_social:chat_build);
if_setsize(16, 0, ^setsize_abs, ^setsize_minus, lobbyscreen_pane_mobile_social:chat_scroll);
~script3052(lobbyscreen_pane_mobile_social:chat, lobbyscreen_pane_mobile_social:chat_build, lobbyscreen_pane_mobile_social:chat_scroll);
if_button_settoggled(true, lobbyscreen_pane_mobile_social:friends_button);
if_setgraphic(icon_lobbysocial_friends_list_active, lobbyscreen_pane_mobile_social:friends_list_button_graphic);
if_setgraphic(icon_lobbysocial_ignore_list_inactive, lobbyscreen_pane_mobile_social:ignore_list_button_graphic);
if_sethide(false, lobbyscreen_pane_mobile_social:player_list_top_bar_friends);
if_sethide(true, lobbyscreen_pane_mobile_social:player_list_top_bar_clan);
if_sethide(true, lobbyscreen_pane_mobile_social:player_list_top_bar_friends_chat);
if_sethide(true, lobbyscreen_pane_mobile_social:join_leave_channel_button);
if_sethide(true, lobbyscreen_pane_mobile_social:kick_player_button_layer);
if_sethide(false, lobbyscreen_pane_mobile_social:add_player_button);
