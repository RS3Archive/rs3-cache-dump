[proc,if_highlight_create](component $component0, int $rgb1)
if ($component0 = null) {
    return;
}
if ($rgb1 = null) {
    $rgb1 = ^black;
}
cc_deleteall($component0);
cc_create($component0, ^iftype_graphic, 0);
cc_setgraphic("aif_examine_highlight_2,0");
cc_setsize(10, 10, ^setsize_abs, ^setsize_abs);
cc_setposition(0, 0, ^setpos_abs_left, ^setpos_abs_top);
cc_setcolour($rgb1);
