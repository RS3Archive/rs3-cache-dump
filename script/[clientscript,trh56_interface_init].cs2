// 12411
[clientscript,trh56_interface_init]
def_string $string0 = "Dragon bones cost - 1 Trinket<br>Hardened Dragon bones - 2 Trinkets<br>Reinforced Dragon bones - 3 Trinkets";
if (%trh56_toggle_type = 1) {
    if (%trh56_loot_bones_active = 0) {
        if_setgraphic("trh56_icon_autoloot_dragon_bones,2", trh56_dragon_pendant_metalic_abilities:ability_icon1);
    }
    if (%trh56_slayer_xp_active = 0) {
        if_setgraphic("trh56_icon_slayer_xp,2", trh56_dragon_pendant_metalic_abilities:ability_icon2);
    }
    if (%trh56_instakill_active = 0) {
        if_setgraphic("trh56_icon_instakill_dragon,2", trh56_dragon_pendant_metalic_abilities:ability_icon3);
    }
    if_settext("Automatically loot and note dragon, reinforced dragon and hardened dragon bones that are dropped from metallic dragon kills.", trh56_dragon_pendant_metalic_abilities:ability_desc1);
    if_setonmouserepeat("script3876($string0, trh56_dragon_pendant_metalic_abilities:ability1, -1)", trh56_dragon_pendant_metalic_abilities:ability1);
    $string0 = "Bronze, Iron and Steel dragon slayer XP cost - 1 Trinket<br> Mithril and Adamant dragon slayer XP cost - 2 Trinkets<br>Rune dragon slayer XP cost - 7 Trinkets";
    if_setonmouserepeat("script3876($string0, trh56_dragon_pendant_metalic_abilities:ability2, -1)", trh56_dragon_pendant_metalic_abilities:ability2);
    $string0 = "Bronze, Iron, Steel and Mithril dragons instant kill cost - 2 Trinkets<br>Adamant dragon instant kill cost - 3 Trinkets<br>Rune dragon instant kill cost - 5 Trinkets";
    if_setonmouserepeat("script3876($string0, trh56_dragon_pendant_metalic_abilities:ability3, -1)", trh56_dragon_pendant_metalic_abilities:ability3);
} else {
    if (%trh56_loot_bones_active_basic = 0) {
        if_setgraphic("trh56_icon_autoloot_dragon_bones,2", trh56_dragon_pendant_abilities:ability_icon1);
    }
    if (%trh56_loot_hide_active_basic = 0) {
        if_setgraphic("trh56_icon_autoloot_dragon_hide,2", trh56_dragon_pendant_abilities:ability_icon4);
    }
    if (%trh56_slayer_xp_active_basic = 0) {
        if_setgraphic("trh56_icon_slayer_xp,2", trh56_dragon_pendant_abilities:ability_icon2);
    }
    if (%trh56_instakill_active_basic = 0) {
        if_setgraphic("trh56_icon_instakill_dragon,2", trh56_dragon_pendant_abilities:ability_icon3);
    }
    if_settext("Auto Loot Hides", trh56_dragon_pendant_abilities:ability_name4);
    if_settext("Automatically loot and note dragon hides that are dropped from chromatic dragon kills.", trh56_dragon_pendant_abilities:ability_desc4);
    if_settext("Automatically loot and note dragon bones and baby dragon bones that are dropped from chromatic dragon kills.", trh56_dragon_pendant_abilities:ability_desc1);
    $string0 = "Dragon bones cost - 1 Trinket";
    if_setonmouserepeat("script3876($string0, trh56_dragon_pendant_abilities:ability1, -1)", trh56_dragon_pendant_abilities:ability1);
    $string0 = "Dragon hides cost - 1 Trinket";
    if_setonmouserepeat("script3876($string0, trh56_dragon_pendant_abilities:ability4, -1)", trh56_dragon_pendant_abilities:ability4);
    $string0 = "Adult dragon instant kill cost - 2 Trinkets<br>Baby dragon instant kill cost - 1 Trinket";
    if_setonmouserepeat("script3876($string0, trh56_dragon_pendant_abilities:ability3, -1)", trh56_dragon_pendant_abilities:ability3);
    $string0 = "Slayer XP cost - 1 Trinket<br>Brutal Green dragon slayer xp cost - 2 Trinkets";
    if_setonmouserepeat("script3876($string0, trh56_dragon_pendant_abilities:ability2, -1)", trh56_dragon_pendant_abilities:ability2);
}
if_setonmouseleave("script8805", trh56_dragon_pendant_abilities:ability1);
if_setonmouseleave("script8805", trh56_dragon_pendant_abilities:ability2);
if_setonmouseleave("script8805", trh56_dragon_pendant_abilities:ability3);
if_setonmouseleave("script8805", trh56_dragon_pendant_abilities:ability4);
