// 13412
[proc,script13412](int $int0, int $int1, int $int2)(int)
switch_int ($int0) {
    case 0 :
        switch_int ($int1) {
            case 0 :
                return(testbit(%menaphos_collections_var1, $int2));
            case 1 :
                return(testbit(%menaphos_collections_var1, calc($int2 + 16)));
            case 2 :
                return(testbit(%menaphos_collections_var2, $int2));
        }
}
return(^false);
