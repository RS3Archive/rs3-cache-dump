// 429
[clientscript,script429]
def_int $int0 = 0;
def_int $int1 = 0;
def_component $component2 = null;
def_component $component3 = null;
def_int $int4 = 0;
def_component $component5 = null;
def_int $int6 = 0;
while ($int6 < 4) {
    switch_int ($int6) {
        case 0 :
            if (%conq_in_tutorial = 1) {
                $int0 = 1;
            } else {
                $int0 = %conq_command_ability_1;
            }
            $component2 = conq_side_command:icon_1;
            $component3 = conq_side_command:shading_rect_1;
            $component5 = conq_side_command:cooldown_1;
        case 1 :
            if (%conq_in_tutorial = 1) {
                $int0 = 3;
            } else {
                $int0 = %conq_command_ability_2;
            }
            $component2 = conq_side_command:icon_2;
            $component3 = conq_side_command:shading_rect_2;
            $component5 = conq_side_command:cooldown_2;
        case 2 :
            if (%conq_in_tutorial = 1) {
                $int0 = 5;
            } else {
                $int0 = %conq_command_ability_3;
            }
            $component2 = conq_side_command:icon_3;
            $component3 = conq_side_command:shading_rect_3;
            $component5 = conq_side_command:cooldown_3;
        case 3 :
            if (%conq_in_tutorial = 1) {
                $int0 = 6;
            } else {
                $int0 = %conq_command_ability_4;
            }
            $component2 = conq_side_command:icon_4;
            $component3 = conq_side_command:shading_rect_4;
            $component5 = conq_side_command:cooldown_4;
    }
    switch_int ($int0) {
        case default :
            $int0 = 0;
        case 1 :
            $int1 = %conq_cooldown_battle_cry;
            $int4 = struct_param(conq_command_battle_cry, conq_command_cost);
        case 2 :
            $int1 = %conq_cooldown_stoicism;
            $int4 = struct_param(conq_command_stoicism, conq_command_cost);
        case 3 :
            $int1 = %conq_cooldown_regenerate;
            $int4 = struct_param(conq_command_regenerate, conq_command_cost);
        case 4 :
            $int1 = %conq_cooldown_barrage;
            $int4 = struct_param(conq_command_barrage, conq_command_cost);
        case 5 :
            $int1 = %conq_cooldown_bloodlust;
            $int4 = struct_param(conq_command_bloodlust, conq_command_cost);
        case 6 :
            $int1 = %conq_cooldown_chastise;
            $int4 = struct_param(conq_command_chastise, conq_command_cost);
        case 7 :
            $int1 = %conq_cooldown_vigilance;
            $int4 = struct_param(conq_command_vigilance, conq_command_cost);
        case 8 :
            $int1 = %conq_cooldown_shield_wall;
            $int4 = struct_param(conq_command_shield_wall, conq_command_cost);
        case 9 :
            $int1 = %conq_cooldown_winds_of_change;
            $int4 = struct_param(conq_command_winds_of_change, conq_command_cost);
    }
    if ($int0 ! 0) {
        if ($int1 > 0 | %conq_command_points < $int4) {
            if ($int1 > 0) {
                if_settext(tostring($int1), $component5);
            }
            if_setcolour(0x282828, $component2);
            if_sethide(false, $component3);
        } else {
            if_settext("", $component5);
            if_setcolour(^black, $component2);
            if_sethide(true, $component3);
        }
    }
    $int6 = calc($int6 + 1);
}
