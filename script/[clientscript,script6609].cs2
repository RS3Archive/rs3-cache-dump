// 6609
[clientscript,script6609](component $component0, int $int1, component $component2, int $int3, int $int4, int $int5)
def_int $int6 = 0;
def_int $int7 = 0;
if ($component2 ! null) {
    if ($int3 = -1) {
        if (if_find($component2) = true & $component2 = peng_pow_bfish_setup:gamepiece_corral) {
            $int6 = $int4;
            $int7 = $int5;
            if (.cc_find($component0, $int1) = true) {
