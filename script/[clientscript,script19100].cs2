// 19100
[clientscript,script19100]
cc_deleteall(trh199_overlay:reward_grid);
if (%trh199_active_blueprint = 0) {
    return;
}
def_dbrow $dbrow0 = ~script19067(%trh199_active_blueprint);
def_int $int1 = max(1, db_getfieldcount($dbrow0, trh199_blueprint:col4));
def_component $component2 = trh199_overlay:reward_grid;
def_int $int3 = -1;
def_int $int4 = 0;
def_obj $obj5 = null;
def_int $int6 = 1;
def_struct $struct7 = null;
def_int $int8 = 1;
while (++$int3 < $int1) {
    ~cc_add_layer($component2, $int3, 0, 0, ^setpos_abs_left, ^setpos_abs_top, 80, 42, ^setsize_abs, ^setsize_abs);
    cc_setop(1, "Preview");
    cc_setopcursor(1, cursor_info);
    cc_setonop("script19090($int3)");
    ~script7920($component2, calc($int3 + 1), $int4, 0, $int3, 0, 0, ^setpos_abs_centre, ^setpos_abs_centre, 80, 42, ^setsize_abs, ^setsize_abs, trh199_preview_square);
    $int4 = calc($int4 + 1);
