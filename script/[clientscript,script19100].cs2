    ~script9862($component2, calc($int3 + 1), $int4, 0, $int3, 0, 0, ^setpos_abs_centre, ^setpos_abs_centre, 36, 34, ^setsize_abs, ^setsize_abs, $obj5, 1);
    $struct7 = oc_param($obj5, mtxmgt_item_struct);
