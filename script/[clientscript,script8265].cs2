[clientscript,script8265]
if (%varplayer_8727 = 1) {
    if_settext("Tap a button for information on each perk.", interface_1822:com_28);
    if_sethide(false, interface_1822:com_6);
    if_sethide(true, interface_1822:com_27);
} else {
    if_settext("Calibrating the energies here gives you bonus effects related to Divination. Your selection will be locked in once confirmed, but will be adjustable once per week, or whenever you charge a new engram.", interface_1822:com_28);
    if_sethide(true, interface_1822:com_6);
    if_sethide(false, interface_1822:com_27);
}
