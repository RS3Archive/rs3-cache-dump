// 8265
[clientscript,script8265]
if (%hog_mobile_toggle = 1) {
    if_settext("Tap a button for information on each perk.", hog_rewards:hog_info);
    if_sethide(false, hog_rewards:mobile_help_layer);
    if_sethide(true, hog_rewards:hog_info_dynamic);
} else {
    if_settext("Calibrating the energies here gives you bonus effects related to Divination. Your selection will be locked in once confirmed, but will be adjustable once per week, or whenever you charge a new engram.", hog_rewards:hog_info);
    if_sethide(true, hog_rewards:mobile_help_layer);
    if_sethide(false, hog_rewards:hog_info_dynamic);
}
