// 12413
[clientscript,trh56_graphic_leave](component $component0)
if (%trh56_toggle_type = 1) {
    if ($component0 = trh56_dragon_pendant_metalic_abilities:ability_icon1) {
        if (%trh56_loot_bones_active = 1) {
            if_setgraphic("trh56_icon_autoloot_dragon_bones,0", $component0);
        } else {
            if_setgraphic("trh56_icon_autoloot_dragon_bones,2", $component0);
        }
    }
    if ($component0 = trh56_dragon_pendant_metalic_abilities:ability_icon2) {
        if (%trh56_slayer_xp_active = 1) {
            if_setgraphic("trh56_icon_slayer_xp,0", $component0);
        } else {
            if_setgraphic("trh56_icon_slayer_xp,2", $component0);
        }
    }
    if ($component0 = trh56_dragon_pendant_metalic_abilities:ability_icon3) {
        if (%trh56_instakill_active = 1) {
            if_setgraphic("trh56_icon_instakill_dragon,0", $component0);
        } else {
            if_setgraphic("trh56_icon_instakill_dragon,2", $component0);
        }
    }
} else {
    if ($component0 = trh56_dragon_pendant_abilities:ability_icon1) {
        if (%trh56_loot_bones_active_basic = 1) {
            if_setgraphic("trh56_icon_autoloot_dragon_bones,0", $component0);
        } else {
            if_setgraphic("trh56_icon_autoloot_dragon_bones,2", $component0);
        }
    }
    if ($component0 = trh56_dragon_pendant_abilities:ability_icon4) {
        if (%trh56_loot_hide_active_basic = 1) {
            if_setgraphic("trh56_icon_autoloot_dragon_hide,0", $component0);
        } else {
            if_setgraphic("trh56_icon_autoloot_dragon_hide,2", $component0);
        }
    }
    if ($component0 = trh56_dragon_pendant_abilities:ability_icon2) {
        if (%trh56_slayer_xp_active_basic = 1) {
            if_setgraphic("trh56_icon_slayer_xp,0", $component0);
        } else {
            if_setgraphic("trh56_icon_slayer_xp,2", $component0);
        }
    }
    if ($component0 = trh56_dragon_pendant_abilities:ability_icon3) {
        if (%trh56_instakill_active_basic = 1) {
            if_setgraphic("trh56_icon_instakill_dragon,0", $component0);
        } else {
            if_setgraphic("trh56_icon_instakill_dragon,2", $component0);
        }
    }
}
