// 411
[proc,clan_chat_get_struct](component $component0)(struct)
switch_component ($component0) {
    case clan_chat:main_content_layer :
        return(clan_chat_child);
    case toplevel_v2_parent_suboverlay_clan_chat:main_content_layer :
        return(clan_chat_parent);
}
return(clan_chat_child);
