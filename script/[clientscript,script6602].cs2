// 6602
[clientscript,script6602]
if_sethide(false, peng_pow_engine:highlight);
switch_int (%peng_pow_tool_select) {
    case 0 :
        if_sethide(true, peng_pow_engine:highlight);
    case 1 :
        ~script6603(peng_pow_engine:bowlingpin);
    case 2 :
        ~script6603(peng_pow_engine:balloon);
    case 3 :
        ~script6603(peng_pow_engine:raw_wire);
    case 4 :
        ~script6603(peng_pow_engine:hand);
    case 5 :
        ~script6603(peng_pow_engine:fabric);
    case 6 :
        ~script6603(peng_pow_engine:dish);
    case 7 :
        ~script6603(peng_pow_engine:hulahoop);
    case 8 :
        ~script6603(peng_pow_engine:assembled_wire);
}
