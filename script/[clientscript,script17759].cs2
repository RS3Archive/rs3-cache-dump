// 17759
[clientscript,script17759](int $int0)
def_int $int1 = scale(calc(clientclock - $int0), 100, 100);
if ($int1 > 0 & $int1 < 100) {
    $int1 = calc(255 - scale(255, 100, $int1));
    if_settrans(calc(255 - $int1), interface_1171:com_7);
    if_settrans(calc(255 - $int1), interface_1171:com_8);
    if_settrans(calc(255 - $int1), interface_1171:com_6);
    if_settrans(calc(255 - $int1), interface_1171:com_26);
    return;
} else if ($int1 >= 100) {
    if_setontimer(null, interface_1171:com_10);
}
