// 10095
[clientscript,sb_fade](int $int0)
def_int $int1 = if_gettrans(sb_overlay:border_blur);
if ($int1 = $int0) {
    if_setontimer(null, sb_overlay:border_blur);
} else if ($int1 < $int0) {
    if_settrans(calc($int1 + 1), sb_overlay:border_blur);
} else {
    if_settrans(calc($int1 - 1), sb_overlay:border_blur);
}
