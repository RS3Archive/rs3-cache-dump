if_settext("+ <tostring(%varplayer_2967)> ( <tostring(%varplayer_2961)> )<br>+ <tostring(%varplayer_2966)> ( <tostring(%varplayer_2960)> )<br>+ <tostring(%varplayer_2968)> ( <tostring(%varplayer_2962)> )<br>", interface_929:com_8);
