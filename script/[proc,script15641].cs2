// 15641
[proc,script15641](component $component0)(string)
switch_component ($component0) {
    case interface_910:com_32 :
        return("World Number");
    case interface_910:com_37 :
        return("Player Count");
    case interface_910:com_42 :
        return("Designated Activity");
    case interface_910:com_46 :
        return("Server Location");
    case interface_910:com_50 :
        return("Membership Requirement");
    case interface_910:com_55 :
        return("Lootshare Availability");
    case interface_910:com_59 :
        return("World Ping");
}
return("0");
