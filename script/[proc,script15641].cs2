// 15641
[proc,script15641](component $component0)(string)
switch_component ($component0) {
    case lobbyscreen_pane_worldselect:sort_world :
        return("World Number");
    case lobbyscreen_pane_worldselect:sort_player :
        return("Player Count");
    case lobbyscreen_pane_worldselect:sort_activity :
        return("Designated Activity");
    case lobbyscreen_pane_worldselect:sort_location :
        return("Server Location");
    case lobbyscreen_pane_worldselect:sort_type :
        return("Membership Requirement");
    case lobbyscreen_pane_worldselect:sort_lootshare :
        return("Lootshare Availability");
    case lobbyscreen_pane_worldselect:sort_ping :
        return("World Ping");
}
return("0");
