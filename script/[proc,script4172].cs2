    } else if (clientclock > calc($int5 - 250)) {
        if_setcolour(0xfa6400, interface_1508:com_2);
    } else {
        if_setcolour(^white, interface_1508:com_2);
    }
} else {
    if_setcolour(^white, interface_1508:com_2);
}
