// 1018
[proc,script1018]()(boolean)
if (~script15532(0) = true) {
    ~script1296("You will be able to toggle combat mode after the tutorial.");
    return(false);
}
switch_dbrow (%uitutorial_current_parent) {
    case path_ftue_combat_adren, path_ftue_combat_drag_inv, path_ftue_combat_drag_actionbar, path_ftue_combat_food_on_bar, path_ftue_combat_basics :
        ~script1296("You will be able to do that after the tutorial.");
        return(false);
}
return(true);
