// 19207
[proc,script19207](dbrow $dbrow0)(jingle)
switch_dbtable (db_getrowtable($dbrow0)) {
    case dbtable_193 :
        return(db_getfield($dbrow0, dbtable_193:col15, 0));
    case dbtable_294 :
        return(db_getfield($dbrow0, dbtable_294:col14, 0));
    case dbtable_315 :
        return(db_getfield($dbrow0, dbtable_315:col14, 0));
}
return(null);
