[proc,script19207](dbrow $dbrow0)(jingle)
switch_dbtable (db_getrowtable($dbrow0)) {
    case trh182_monsters :
        return(db_getfield($dbrow0, trh182_monsters:col15, 0));
    case trh203_nodes :
        return(db_getfield($dbrow0, trh203_nodes:col14, 0));
    case trh207_nodes :
        return(db_getfield($dbrow0, trh207_nodes:col14, 0));
}
return(null);
