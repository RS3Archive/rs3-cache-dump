// 20234
[clientscript,script20234](int $int0)
def_int $int1 = calc(clientclock - $int0);
def_int $int2 = calc($int1 / 50);
if ($int1 = 1) {
    if_setenabled(false, interface_1401:com_37);
    if_sethide(false, interface_1401:com_38);
} else if ($int1 >= 250) {
    if_setontimer(null, interface_1401:com_2);
    if_setenabled(true, interface_1401:com_37);
    if_sethide(true, interface_1401:com_38);
    if_settext("Confirm Nomination", interface_1401:com_37);
} else {
    if_settext("<tostring(calc(5 - $int2))>...", interface_1401:com_37);
}
