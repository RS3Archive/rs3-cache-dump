// 10383
[clientscript,script10383](component $component0, int $int1)
def_int $int2 = if_gettrans($component0);
if ($int1 = 0) {
    if ($int2 < 100) {
        if_settrans(min(100, calc($int2 + 4)), $component0);
    } else {
        $int1 = 1;
    }
} else if ($int2 > 0) {
    if_settrans(max(0, calc($int2 - 4)), $component0);
} else {
    $int1 = 0;
}
if_setontimer("script10383($component0, $int1)", $component0);
