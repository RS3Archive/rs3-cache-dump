// 6400
[proc,ss_tab_click](component $component0)
sound_vorbis_volume(select_shop_item, 1, 0, 255);
switch_component ($component0) {
    case ss_rework:buy_button_active :
        ~script13778;
    case ss_rework:learn_button_active :
        ~script13779;
    case ss_rework:assignment_button_active :
        ~script13780;
    case ss_rework:coop_button_active :
        ~script13781;
    case default :
        return;
}
