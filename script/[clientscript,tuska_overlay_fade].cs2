// 3440
[clientscript,tuska_overlay_fade](int $int0, graphic $graphic1, int $rgb2)
if_setgraphic($graphic1, tuska_effects:blur_component);
if_setcolour($rgb2, tuska_effects:blur_component);
if ($int0 = 1) {
    if_setontimer("script5243(255)", tuska_effects:blur_component);
} else {
    if_setontimer("script5243(0)", tuska_effects:blur_component);
}
