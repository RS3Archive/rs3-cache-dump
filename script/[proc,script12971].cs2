// 12971
[proc,script12971](long $long0)(string)
if ($long0 < 0) {
    return("");
} else if ($long0 < 100000) {
    return(tostring_localised_long($long0, true));
} else if ($long0 < 10000000) {
    return("<tostring_localised_long(calc($long0 / 1000), true)>K");
} else if ($long0 < 10000000000) {
    return("<tostring_localised_long(calc($long0 / 1000000), true)>M");
} else if ($long0 < 10000000000000) {
    return("<tostring_localised_long(calc($long0 / 1000000000), true)>B");
} else if ($long0 < 10000000000000000) {
    return("<tostring_localised_long(calc($long0 / 1000000000000), true)>T");
} else {
    return("<tostring_localised_long(calc($long0 / 1000000000000000), true)>Q");
}
