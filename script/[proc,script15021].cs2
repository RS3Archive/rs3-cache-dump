// 15021
[proc,script15021]
if (inv_total(stock_favourites, %stock_offeritem) > 0) {
    ~script15023(rs3tli_favourite_button_unselected_18px, rs3tli_favourite_button_selected_18px, "Add to favourites", "Remove from favourites", -1);
} else {
    ~script15023(rs3tli_favourite_button_selected_18px, rs3tli_favourite_button_unselected_18px, "Remove from favourites", "Add to favourites", -1);
}
