[clientscript,script11736]
if (%comscenario_faction_pvp_team_1 > 0) {
    ~comscenario_update_name(%comscenario_faction_pvp_team_1, faction_select:button_build_1);
}
if (%comscenario_faction_pvp_team_2 > 0) {
    ~comscenario_update_name(%comscenario_faction_pvp_team_2, faction_select:button_build_2);
}
