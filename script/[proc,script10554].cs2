// 10554
[proc,script10554](int $int0, int $int1)
if (%runemach_client_bar < %runemach_bar_value) {
    %runemach_client_bar = calc(%runemach_client_bar + 1);
} else if (%runemach_client_bar > %runemach_bar_value) {
    %runemach_client_bar = calc(%runemach_client_bar - 1);
} else {
    return;
}
if_setsize(calc(%runemach_client_bar * 16384 / 100), 0, ^setsize_rel, ^setsize_minus, runemach_dnd:green_large_progress_value_layer_1);
