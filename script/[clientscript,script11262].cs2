// 11262
[clientscript,script11262](component $component0, component $component1)
def_int $int2 = if_getwidth($component0);
def_int $int3 = if_getheight($component0);
if ($int2 > 30) {
    $int2 = max(calc($int2 - 6), 30);
}
if ($int3 > 30) {
    $int3 = max(calc($int3 - 6), 30);
}
if_setsize($int2, $int3, ^setsize_abs, ^setsize_abs, $component0);
if ($int2 = 30 & $int3 = 30) {
    if_setontimer(null, $component0);
    if_sethide(true, $component1);
}
