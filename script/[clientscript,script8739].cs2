// 8739
[clientscript,script8739]
if (~script6431 = true) {
    if_settext("Instructions (Tap to close)", interface_1053:com_42);
    if_settext("Tap on a piece to select it, and again on the grid to place it.<br><br>To Deselect a piece, tap on the Deselect button.<br><br>To return a piece from the grid, tap and hold on it and select 'Reset'.<br><br>The 'RESET' button clears the grid.", interface_1053:com_43);
}
