// 1388
[clientscript,script1388]
def_string $string0 = "Unlock your ability bar to be able to drag these";
def_int $int0 = 0;
if (%combatv2_actionbar_locked = 1 | %toplevel_v2_legacy_combat = 1) {
    $string0 = "You can drag these to your ability bar";
}
while (cc_find(prayer_quick_preset_interface:preset_ability_layer, $int0) = true) {
    cc_setonmouserepeat("script8799($string0, event_com, event_comsubid)");
    cc_setonmouseleave("script8805");
    $int0 = calc($int0 + 1);
}
