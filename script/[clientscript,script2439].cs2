// 2439
[clientscript,script2439]
if (%trawler_is_net_ripped_client = 1) {
    if_settext("Net: <col=FFFFFF>Ripped!", trawler_game_overlay:net_text);
    if_setcolour(0xe12323, trawler_game_overlay:net_text);
} else {
    if_settext("Net: <col=FFFFFF>OK", trawler_game_overlay:net_text);
    if_setcolour(0xff9900, trawler_game_overlay:net_text);
}
