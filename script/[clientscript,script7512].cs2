// 7512
[clientscript,script7512](int $int0, int $int1)
def_int $int2 = 144;
def_int $int3 = if_getheight(rand_dnd_select_card:rand_dnd_progress_bar_fill);
if (clientclock > $int1) {
    if ($int0 > 0) {
        $int2 = scale($int0, 15, 144);
        if_setsize($int2, $int3, ^setsize_abs, ^setsize_abs, rand_dnd_select_card:rand_dnd_progress_bar_fill);
        if_settext(tostring($int0), rand_dnd_select_card:rand_dnd_time_text);
        %rand_dnd_turn_time = --$int0;
        $int1 = calc(clientclock + 50);
        if_setontimer("script7512($int0, $int1)", rand_dnd_select_card:rand_dnd_progress_bar_fill);
    } else {
        $int2 = scale($int0, 15, 144);
        if_setsize($int2, $int3, ^setsize_abs, ^setsize_abs, rand_dnd_select_card:rand_dnd_progress_bar_fill);
        if_setontimer(null, rand_dnd_select_card:rand_dnd_progress_bar_fill);
    }
}
