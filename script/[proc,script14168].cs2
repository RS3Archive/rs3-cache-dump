// 14168
[proc,script14168]
if (%mobile_zoom = 2) {
    return;
}
if (if_find(struct_param(toplevel_v2_window_data_mes, toplevel_v2_window_layer)) = true) {
    ~script4452(calc(cc_getx - 50), cc_gety, calc(cc_getwidth + 100), cc_getheight);
    ~interface_zoom_set_var(4);
    ~script14171(null);
}
