// 4273
[clientscript,script4273]
if_sethide(true, interface_1083:com_93);
if_sethide(true, interface_1083:com_94);
if_sethide(false, interface_1083:com_95);
if_sethide(true, interface_1083:com_90);
if_sethide(true, interface_1083:com_91);
if_sethide(false, interface_1083:com_92);
if_sethide(true, interface_1083:com_219);
if_sethide(true, interface_1083:com_227);
if_sethide(false, interface_1083:com_235);
if_sethide(true, interface_1083:com_96);
if_settext(tostring(calc(2 * 10)), interface_1083:com_107);
if (stat_base(magic) < 83) {
    if_settext("<tostring(calc(2 / 2 * 10))> (halved)", interface_1083:com_108);
} else {
    if_settext(tostring(calc(2 * 10)), interface_1083:com_108);
}
if (stat_base(magic) < 80) {
    if_settext("<tostring(calc(12 / 2 * 10))> (halved)", interface_1083:com_109);
} else {
    if_settext(tostring(calc(12 * 10)), interface_1083:com_109);
}
if (stat_base(magic) < 86) {
    if_settext("<tostring(calc(2 / 2 * 10))> (halved)", interface_1083:com_110);
} else {
    if_settext(tostring(calc(2 * 10)), interface_1083:com_110);
}
if_settext(tostring(calc(10 * 10)), interface_1083:com_111);
if_settext("Magic and Farming", interface_1083:com_112);
if (stat_base(magic) < 83) {
    if_settext("Farming (no Magic)", interface_1083:com_113);
} else {
    if_settext("Magic and Farming", interface_1083:com_113);
}
if (stat_base(magic) < 80) {
    if_settext("Crafting (no Magic)", interface_1083:com_114);
} else {
    if_settext("Magic and Crafting", interface_1083:com_114);
}
if (stat_base(magic) < 86) {
    if_settext("Construction (no Magic)", interface_1083:com_115);
} else {
    if_settext("Magic and Construction", interface_1083:com_115);
}
if_settext("Agility", interface_1083:com_116);
