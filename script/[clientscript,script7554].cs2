// 7554
[clientscript,script7554]
def_int $int0 = if_getwidth(tsd_juna_health:juna_fill);
def_int $int1 = calc(%tsd_juna_health / 24);
if (%tsd_juna_health = 5000) {
    $int1 = 204;
}
if ($int0 < $int1) {
    if_setsize(calc($int0 + 1), if_getheight(tsd_juna_health:juna_fill), ^setsize_abs, ^setsize_abs, tsd_juna_health:juna_fill);
} else if ($int0 > $int1) {
    if_setsize(calc($int0 - 1), if_getheight(tsd_juna_health:juna_fill), ^setsize_abs, ^setsize_abs, tsd_juna_health:juna_fill);
}
