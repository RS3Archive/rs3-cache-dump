// 19208
[proc,script19208](dbrow $dbrow0)(int)
switch_dbtable (db_getrowtable($dbrow0)) {
    case trh182_monsters :
        return(db_getfieldcount($dbrow0, trh182_monsters:col10));
    case trh203_nodes :
        return(db_getfieldcount($dbrow0, trh203_nodes:col10));
    case trh207_nodes :
        return(db_getfieldcount($dbrow0, trh207_nodes:col10));
    case default :
        ~error("Missed plugin point for DBTable.");
}
return(0);
