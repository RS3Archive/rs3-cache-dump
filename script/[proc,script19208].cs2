// 19208
[proc,script19208](dbrow $dbrow0)(int)
switch_dbtable (db_getrowtable($dbrow0)) {
    case dbtable_193 :
        return(db_getfieldcount($dbrow0, dbtable_193:col10));
    case dbtable_294 :
        return(db_getfieldcount($dbrow0, dbtable_294:col10));
    case dbtable_315 :
        return(db_getfieldcount($dbrow0, dbtable_315:col10));
    case default :
        ~error("Missed plugin point for DBTable.");
}
return(0);
