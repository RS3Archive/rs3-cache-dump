// 408
[clientscript,conq_update_turn](int $int0)
if (%conq_current_team = $int0) {
    return;
}
if_setonvarctransmit("conq_update_turn(%conq_current_team){conq_current_team}", conq_scroll_overlay:turn_control_layer);
%conq_played_low_time_warning = 0;
if (%conq_current_team = %conq_team) {
    if_sethide(false, conq_side_turn:your_turn_layer);
    if_sethide(true, conq_side_turn:opponents_turn_layer);
    if_sethide(true, conq_side_turn:confirm_end_layer);
    if_settext("Your Turn", conq_scroll_overlay:whose_turn_text);
    sound_vorbis_volume(vk_conq_your_turn_01, 1, 0, 255);
} else {
    if_sethide(true, conq_side_turn:your_turn_layer);
    if_sethide(true, conq_side_turn:confirm_end_layer);
    if_settext("Opponent's Turn", conq_scroll_overlay:whose_turn_text);
    if (if_gethide(conq_side_turn:commorb_layer) = true) {
        if_sethide(false, conq_side_turn:opponents_turn_layer);
    }
}
