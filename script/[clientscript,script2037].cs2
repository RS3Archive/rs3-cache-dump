// 2037
[clientscript,script2037]
if (if_gethide(ozan1_scales_puzzle:box_one) = false) {
    if_sethide(true, ozan1_scales_puzzle:box_one);
    if_sethide(false, ozan1_scales_puzzle:box_two);
} else if (if_gethide(ozan1_scales_puzzle:box_two) = false) {
    if_sethide(true, ozan1_scales_puzzle:box_two);
    if_sethide(false, ozan1_scales_puzzle:box_three);
} else if (if_gethide(ozan1_scales_puzzle:box_three) = false) {
    if_sethide(true, ozan1_scales_puzzle:help_layer);
    if_sethide(true, ozan1_scales_puzzle:box_three);
}
