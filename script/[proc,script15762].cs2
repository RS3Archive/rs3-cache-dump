// 15762
[proc,script15762](int $int0)
def_dbfilter $dbfilter1 = db_filter_value(mtxmgt_cosmetic:col23, $int0, ^filterop_gte, 0);
def_int $int2 = db_filter_find($dbfilter1, mtxmgt_cosmetic:col23, true, -1, 0);
mes_typed(^chattype_console, 0, "Found <tostring($int2)> cosmetics released on and after runeday <tostring($int0)>.");
mes_typed(^chattype_console, 0, "The first <tostring(min(5, $int2))> found on and after this date are:");
def_int $int3 = 5;
def_dbrow $dbrow4 = db_findnext;
while ($int3-- > 0 & $dbrow4 ! null) {
    mes_typed(^chattype_console, 0, db_getfield($dbrow4, mtxmgt_cosmetic:col2, 0));
    $dbrow4 = db_findnext;
}
