// 1755
[clientscript,brew_colourwater](component $component0, component $component1)
if (%brew_varc_colourwater > 2) {
    if (inv_getobj(worn, 0) = brew_red_pirate_hat) {
        if_setmodel(game_brew_if_red_bowl_on, $component0);
    } else {
        if_setmodel(game_brew_if_blue_bowl_on, $component0);
    }
    if_setcolour(0x33ff00, $component1);
} else {
    if (inv_getobj(worn, 0) = brew_red_pirate_hat) {
        if_setmodel(game_brew_if_red_bowl_off, $component0);
    } else {
        if_setmodel(game_brew_if_blue_bowl_off, $component0);
    }
    if_setcolour(0x910000, $component1);
}
if_settext(tostring(%brew_varc_colourwater), $component1);
