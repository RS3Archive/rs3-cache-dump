        }
    case combatv2_prayer_necromancy_strength_modified_dummy_ability :
        if (%combatv2_prayer_necromancy_strength_modifier >= 0) {
            $graphic1 = "prayer_icon_curses,24";
        }
    case combatv2_buff_necromancy_undead_instinct :
        if (%combatv2_buff_necromancy_undead_instinct_ability_struct ! null) {
            $graphic1 = struct_param(%combatv2_buff_necromancy_undead_instinct_ability_struct, combatv2_ability_icon);
        }
    case combatv2_buff_necro_rasial_armguard_t95_passive :
        if (%combatv2_buff_necro_rasial_armguard_t95_passive_stacks = ~script17464) {
            $graphic1 = buff_icon_necromancy_necro_rasial_armguard_t95;
        }
    case combatv2_buff_melee_bloodlust :
        if (%combatv2_buff_melee_bloodlust_stacks >= 4) {
