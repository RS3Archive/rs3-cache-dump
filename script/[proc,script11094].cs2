        }
    case combatv2_buff_necro_devourer_armguard_t95_passive :
        if (%combatv2_buff_necro_devourer_armguard_t95_passive_stacks = ~script20086) {
            $graphic1 = buff_icon_necromancy_necro_devourer_armguard_t95;
        }
    case combatv2_boss_buff_rasial_mainhand_passive :
        if (%combatv2_boss_buff_rasial_mainhand_passive_stacks = 6) {
            $graphic1 = buff_icon_necromancy_necro_rasial_armguard_t95;
        }
    case buff_select_event_central_buff_bar_struct :
        $graphic1 = ~script18434(%buff_select_event_active_buff);
    case combatv2_buff_perfect_equilibrium :
        if (%combatv2_buff_perfect_equilibrium_stacks = 0) {
            $graphic1 = buff_icon_egw_guthix_rune_h_grey;
        }
    case combatv2_boss_buff_nex2_mage1 :
        $graphic1 = enum(int, graphic, nex2_mage_int_to_sprite, %nex2_buff_bar_mage_death1);
    case combatv2_boss_buff_nex2_mage2 :
        $graphic1 = enum(int, graphic, nex2_mage_int_to_sprite, %nex2_buff_bar_mage_death2);
    case combatv2_boss_buff_nex2_mage3 :
        $graphic1 = enum(int, graphic, nex2_mage_int_to_sprite, %nex2_buff_bar_mage_death3);
    case combatv2_boss_buff_nex2_mage4 :
        $graphic1 = enum(int, graphic, nex2_mage_int_to_sprite, %nex2_buff_bar_mage_death4);
}
return($graphic1);
