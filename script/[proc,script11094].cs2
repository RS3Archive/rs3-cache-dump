// 11094
[proc,script11094](struct $struct0)(graphic)
def_graphic $graphic1 = null;
switch_struct ($struct0) {
    case combatv2_prayer_melee_attack_modified_dummy_ability :
        if (%combatv2_prayer_melee_attack_modifier >= 0) {
            $graphic1 = "prayer_icon_curses,8";
        }
    case combatv2_prayer_ranged_attack_modified_dummy_ability :
        if (%combatv2_prayer_range_attack_modifier >= 0) {
