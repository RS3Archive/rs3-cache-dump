        }
    case combatv2_prayer_magic_attack_modified_dummy_ability :
        if (%combatv2_prayer_magic_attack_modifier >= 0) {
            $graphic1 = "prayer_icon_curses,11";
        }
    case combatv2_prayer_necromancy_attack_modified_dummy_ability :
        if (%combatv2_prayer_necromancy_attack_modifier >= 0) {
            $graphic1 = "prayer_icon_curses,11";
        }
    case combatv2_prayer_defence_modified_dummy_ability :
        if (%combatv2_prayer_defence_modifier >= 0) {
            $graphic1 = "prayer_icon_curses,16";
        }
    case combatv2_prayer_melee_strength_modified_dummy_ability :
        if (%combatv2_prayer_melee_strength_modifier >= 0) {
            $graphic1 = "prayer_icon_curses,17";
        }
    case combatv2_prayer_ranged_strength_modified_dummy_ability :
        if (%combatv2_prayer_range_strength_modifier >= 0) {
