// 13729
[clientscript,script13729]
if (calc(clientclock % 50) = 0) {
    if_settext(~trh_promo_info_countdown_time(%varclient_6297, %varclient_6298), interface_1253:com_72);
    if (++%varclient_6298 = 60) {
        %varclient_6297 = calc(%varclient_6297 - 1);
        %varclient_6298 = 0;
    }
}
