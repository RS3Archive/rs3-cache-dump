// 13729
[clientscript,script13729]
if (calc(clientclock % 50) = 0) {
    if_settext(~trh_promo_info_countdown_time(%trh130_promo_time_minutes, %trh130_promo_time_minuteseconds), wheel_of_fortune:countdown_text);
    if (++%trh130_promo_time_minuteseconds = 60) {
        %trh130_promo_time_minutes = calc(%trh130_promo_time_minutes - 1);
        %trh130_promo_time_minuteseconds = 0;
    }
}
