// 4614
[clientscript,script4614](component $component0)
switch_component ($component0) {
    case interface_20:com_162 :
        if_setcolour(hsvtorgb(~script4015(%varplayer_8573, 1)), $component0);
    case interface_20:com_186 :
        if_setcolour(hsvtorgb(~script4015(%varplayer_8573, 2)), $component0);
    case interface_20:com_210 :
        if_setcolour(hsvtorgb(~script4015(%varplayer_8573, 3)), $component0);
    case interface_20:com_234 :
        if_setcolour(hsvtorgb(~script4015(%varplayer_8573, 4)), $component0);
}
