// 12618
[proc,script12618](struct $struct0, string $string0)(string)
def_struct $struct1 = ~script8247(combatv2_ability_magic_concentrated_blast);
def_struct $struct2 = ~script8247(combatv2_ability_magic_sonic_boom);
switch_struct ($struct0) {
}
$string0 = "<$string0><br>-Your next <col=3366FF>Magic ability</col> is empowered:";
if ($struct2 = combatv2_ability_magic_greater_sonic_wave) {
    $string0 = "<$string0><br>- <sprite=27432><nbsp><col=ffffff><struct_param($struct2, combatv2_ability_name)>:</col> Your next <col=3366FF>Magic ability</col> costs <col=ffffff><tostring(calc(450 / 10))>%</col> less <sprite=14907><nbsp><col=DEAC18>Adrenaline</col>.";
} else {
    $string0 = "<$string0><br>- <sprite=27430><nbsp><col=ffffff><struct_param($struct2, combatv2_ability_name)>:</col> Your next <col=3366FF>Magic ability</col> costs <col=ffffff><tostring(calc(350 / 10))>%</col> less <sprite=14907><nbsp><col=DEAC18>Adrenaline</col>.";
}
$string0 = "<$string0><br>- <sprite=14236><nbsp><col=ffffff><struct_param(combatv2_ability_magic_dragonbreath, combatv2_ability_name)>:</col> Deals <~script17720(combatv2_ability_magic_dragonbreath, 260, calc(260 + 50), 0, 0)>.";
if ($struct1 = combatv2_ability_magic_greater_concentrated_blast) {
    $string0 = "<$string0><br>- <sprite=13310><nbsp><col=ffffff><struct_param($struct1, combatv2_ability_name)>:</col> Each attack grants an additional <tostring(10)>% <col=ffffff>Critical Strike Chance</col>.";
} else {
    $string0 = "<$string0><br>- <sprite=13309><nbsp><col=ffffff><struct_param($struct1, combatv2_ability_name)>:</col> Each attack grants an additional <tostring(10)>% <col=ffffff>Critical Strike Chance</col>.";
}
return($string0);
