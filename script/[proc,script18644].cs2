// 18644
[proc,script18644](struct $struct0, string $string0, int $int1)(string)
switch_struct ($struct0) {
    case combatv2_ability_attack_dive :
        $string0 = "<$string0><br>- Move up to <~script17709(10)> towards tile.";
    case combatv2_ability_attack_bladed_dive :
        $string0 = "<$string0><br>- Move up to <~script17709(10)> towards enemy or tile.";
        $string0 = "<$string0><br>- <~script17720($struct0, 75, calc(75 + 20), 0, $int1)> to the target and up to <~script18561(8)> within <~script17709(1)> of you.";
        $string0 = "<$string0><br>- Enemies hit will reset the cooldown of <sprite=30331><nbsp><col=ffffff><struct_param(combatv2_ability_attack_bladed_dive, combatv2_ability_name)></col> if they die within <col=ffffff><~script15973(10, 1)></col>.";
}
return($string0);
