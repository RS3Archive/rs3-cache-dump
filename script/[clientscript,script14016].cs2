// 14016
[clientscript,script14016](component $component0, int $int1, int $int2)
cc_deleteall($component0);
def_int $int3 = if_getnextsubid($component0);
def_int $int4 = 0;
def_int $int5 = 0;
if ($int2 = 0) {
    $int4 = calc(if_getwidth($component0) / $int1);
    $int5 = if_getheight($component0);
} else if ($int2 = 1) {
    $int4 = if_getwidth($component0);
    $int5 = calc(if_getheight($component0) / $int1);
}
while ($int3 < $int1) {
    cc_create($component0, ^iftype_text, $int3);
    cc_setsize($int4, $int5, ^setsize_abs, ^setsize_abs);
    if ($int2 = 0) {
        cc_setposition(calc($int3 * $int4), 0, ^setpos_abs_left, ^setpos_abs_top);
    } else {
        cc_setposition(0, calc($int3 * $int5), ^setpos_abs_left, ^setpos_abs_top);
    }
    cc_settext(tostring($int3));
    cc_setcolour(0xffcd0a);
    cc_settextalign(^settextalign_centre, ^settextalign_centre, 0);
    cc_settextfont(museo_sans_13pt_regular);
    cc_settextshadow(true);
    cc_setop(1, "Mark off");
    cc_setonop("script14026(event_com, event_comsubid)");
    $int3 = calc($int3 + 1);
}
