// 12103
[proc,script12103](obj $obj0, int $int1)(string, graphic, obj)
switch_obj ($obj0) {
    case invent_material_dummy :
        return(~invent_material_name_icon($int1), null);
    case smithing_hopper_dummy :
        return("<enum(int, string, smithing_hopper_names, $int1)> inside metal bank", null, enum(int, obj, smithing_hopper_id_to_obj, $int1));
    case smithing_orebox_dummy :
        return("<oc_name(enum(int, obj, mining_orebox_id_to_obj, $int1))> inside ore box", null, enum(int, obj, mining_orebox_id_to_obj, $int1));
    case woodcutting_box_dummy :
        return("<oc_name(enum(int, obj, woodcutting_box_id_to_obj, $int1))> inside wood box", null, enum(int, obj, woodcutting_box_id_to_obj, $int1));
    case invent_dummy_dg_token :
        return("Dungeoneering tokens", "km_shopitems,4", null);
    case godwars2_body_melee_100, godwars2_boots_melee_100_new, godwars2_gloves_melee_100_new, godwars2_helm_melee_100, godwars2_legs_melee_100, godwars2_body_range_100, godwars2_boots_range_100_new, godwars2_gloves_range_100_new, godwars2_helm_range_100, godwars2_legs_range_100, godwars2_body_magic_100, godwars2_boots_magic_100_new, godwars2_gloves_magic_100_new, godwars2_helm_magic_100, godwars2_legs_magic_100, barrows2_helm_new, barrows2_body_new, barrows2_legs_new :
        return("<oc_name($obj0)> (new)", null, $obj0);
    case godwars2_body_melee_50, godwars2_boots_melee_50, godwars2_gloves_melee_50, godwars2_helm_melee_50, godwars2_legs_melee_50, godwars2_body_range_50, godwars2_boots_range_50, godwars2_gloves_range_50, godwars2_helm_range_50, godwars2_legs_range_50, godwars2_body_magic_50, godwars2_boots_magic_50, godwars2_gloves_magic_50, godwars2_helm_magic_50, godwars2_legs_magic_50, barrows2_helm_used, barrows2_body_used, barrows2_legs_used :
        return("<oc_name($obj0)> (used)", null, $obj0);
    case godwars2_boots_melee_100, godwars2_gloves_melee_100, godwars2_boots_range_100, godwars2_gloves_range_100, godwars2_gloves_magic_100, godwars2_boots_magic_100 :
        return("", null, $obj0);
    case default :
        if (oc_uncert($obj0) ! $obj0) {
            return("<oc_name($obj0)> (noted)", null, $obj0);
        }
        return(oc_name($obj0), null, $obj0);
}
