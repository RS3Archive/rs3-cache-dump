// 819
[clientscript,script819]
if (%lore_npc_head ! null & %lore_npc_head ! hans) {
    if_setnpchead(%lore_npc_head, lore_cats_side:lore_chathead);
} else {
    if_setmodel(null, lore_cats_side:lore_chathead);
}
if (%cat_namevar_set = 1) {
    if_settext(~script821, lore_cats_side:lore_name);
} else if (%follower_obj ! null) {
    if_settext(oc_name(%follower_obj), lore_cats_side:lore_name);
} else {
    if_settext("", lore_cats_side:lore_name);
}
if (%lore_interface_boolean > 50) {
    %lore_interface_boolean = calc(%lore_interface_boolean - 50);
    if_setmodelanim(enum(int, seq, lore_chathead_anim_sad, %lore_interface_boolean), lore_cats_side:lore_chathead);
} else {
    if_setmodelanim(enum(int, seq, lore_chathead_anim_idle, %lore_interface_boolean), lore_cats_side:lore_chathead);
}
