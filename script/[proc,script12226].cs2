// 12226
[proc,script12226](component $component0)
if_setcolour(0xa0b6c0, $component0);
if_setonmouseover("clan_on_mouse_over($component0)", $component0);
if_setonmouseleave("script12225($component0)", $component0);
if_setmouseovercursor(cursor_hyperlink_hand, $component0);
if_setonclick("script12227(activeclansettings_getclanname)", $component0);
if_setopbase("Visit Clan Home Page", $component0);
