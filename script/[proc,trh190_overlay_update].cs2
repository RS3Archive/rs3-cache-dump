if (~script443 < 8) {
    if_setenabled(false, trh190_overlay:treasure_room_button);
    if_clearops(trh190_overlay:treasure_room_button);
    if_sethide(true, trh190_overlay:button_shine_graphic);
    if_sethide(true, trh190_overlay:button_light_graphic);
    if_sethide(true, trh190_overlay:loot_room_door_click);
    ~script3536("The Loot Room cannot be visited until it is full.", trh190_overlay:treasure_room_button, -1);
} else {
    if_setenabled(true, trh190_overlay:treasure_room_button);
