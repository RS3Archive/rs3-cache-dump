// 17148
[proc,trh190_overlay_update]
def_dbrow $dbrow0 = null;
def_string $string0 = "";
def_component $component1 = null;
def_component $component2 = null;
def_component $component3 = null;
def_component $component4 = null;
def_int $int5 = 0;
while (++$int5 <= 2) {
    switch_int ($int5) {
        case 1 :
            $dbrow0 = ~trh_chest_get_dbrow(%trh190_chest_1);
            $component1 = trh190_overlay:chest_1_model;
            $component2 = trh190_overlay:chest_1_title;
            $component3 = trh190_overlay:chest_1_description;
            $component4 = trh190_overlay:chest_1_tut_hook;
        case 2 :
            $dbrow0 = ~trh_chest_get_dbrow(%trh190_chest_2);
            $component1 = trh190_overlay:chest_2_model;
            $component2 = trh190_overlay:chest_2_title;
            $component3 = trh190_overlay:chest_2_description;
            $component4 = trh190_overlay:chest_2_tut_hook;
    }
    $string0 = db_getfield($dbrow0, trh_chest:col1, 0);
    if_settext($string0, $component2);
    if_settext("<col=FFFF00><$string0></col><br><db_getfield($dbrow0, trh_chest:col3, 0)>", $component3);
    ~script446($component1, $dbrow0, 0);
    ~script2690($component1, $dbrow0);
    if_setopbase($string0, $component4);
