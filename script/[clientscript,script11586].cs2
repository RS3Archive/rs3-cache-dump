// 11586
[clientscript,script11586]
if (if_gethide(mtx91_challenge_setup:noclickthrough_layer) = false) {
    if_sethide(true, mtx91_challenge_setup:noclickthrough_layer);
    if_sethide(false, mtx91_challenge_setup:start_button_layer);
    if_sethide(true, mtx91_challenge_setup:confirm_button_layer);
    if_settext("Back", mtx91_challenge_setup:back_button_text);
} else {
    ~script11587(false);
}
