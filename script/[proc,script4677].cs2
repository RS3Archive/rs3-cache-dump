// 4677
[proc,script4677]
switch_int (%fremsaga_current_saga) {
    case 1 :
        if (%fremsaga_completion = 10) {
            if (stat_base(magic) >= 30 & stat_base(ranged) >= 30 & stat_base(attack) >= 30) {
                if_settext("Carn is no more, his behemoth has been dealt with, and Linza has her ore. The tales of Great Ozan can continue!", fremsaga_reward:face_text);
            } else {
                if_settext("Carn has been defeated and Linza appreciates her new ore. The story still feels incomplete, somehow.", fremsaga_reward:face_text);
            }
        } else {
            if_settext("Carn's defeated, but the story still feels incomplete somehow.", fremsaga_reward:face_text);
        }
    case 2 :
        if (%fremsaga_completion = 10) {
            if (stat_base(agility) >= 55 & stat_base(thieving) >= 55) {
                if_settext("I have become Vengeance: death to those who callously disregard life. They, and everyone like them, will pay for what they have done.", fremsaga_reward:face_text);
            } else {
                if_settext("Am I done now? No, there's more that must be done. Vengeance has not yet been satisfied.", fremsaga_reward:face_text);
            }
        } else {
            if_settext("I killed them...but in doing so I never thought to check for survivors. Am I a monster?", fremsaga_reward:face_text);
        }
    case 4 :
        if (%fremsaga_completion = 10) {
            if (stat_base(strength) >= 70) {
                if_settext("Ha! Thok stronger than squishy monsters in dungeon! None are as mighty as Thok.", fremsaga_reward:face_text);
            } else {
                if_settext("Odd... Thok remember being much stronger in dungeon.", fremsaga_reward:face_text);
            }
        } else {
            if_settext("Thok save Marm, but Thok not show how mighty Thok is. Thok need to do more.", fremsaga_reward:face_text);
        }
    case 3 :
        if (stat_base(attack) >= 60 & stat_base(thieving) >= 45 & stat_base(dungeoneering) >= 55) {
            if (%fremsaga_completion = 10) {
                if_settext("I finally completed my task; the perfect spy, the perfect assassin.", fremsaga_reward:face_text);
            } else {
                if_settext("I completed my task, but...I made mistakes, left things undone...", fremsaga_reward:face_text);
            }
        } else {
            if_settext("My task is incomplete, this story still unfinished. I remember there was...more...", fremsaga_reward:face_text);
        }
    case 6 :
        if (stat_base(strength) >= 75) {
            if (%fremsaga_completion = 10) {
                if_settext("A mighty adventure for Thok and Marmaros! Thok have best adventures.", fremsaga_reward:face_text);
            } else {
                if_settext("Thok smash bone face good...but Thok still have more to do!", fremsaga_reward:face_text);
            }
        } else {
            if_settext("Thok enjoy smashing foes...but Thok remember being stronger before.", fremsaga_reward:face_text);
        }
}
