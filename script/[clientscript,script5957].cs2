// 5957
[clientscript,script5957]
if (if_getgraphic(interface_1260:com_87) = "aif_checkbox_small,1") {
    if_setgraphic("aif_checkbox_small,3", interface_1260:com_87);
} else if (if_getgraphic(interface_1260:com_87) = "aif_checkbox_small,3") {
    if_setgraphic("aif_checkbox_small,1", interface_1260:com_87);
    if_setgraphic("aif_checkbox_small,3", interface_1260:com_89);
}
