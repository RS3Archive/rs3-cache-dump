def_string $string1 = struct_param($struct0, task_details);
def_graphic $graphic1 = struct_param($struct0, task_icon);
def_quest $quest2 = null;
if (struct_param($struct0, quest_id) > 0) {
    $quest2 = enum(int, quest, ql4_quests, struct_param($struct0, quest_id));
    $string0 = ~quest_name($quest2);
    $string1 = quest_param($quest2, quest_description);
