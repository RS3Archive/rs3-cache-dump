// 1539
[clientscript,script1539](int $int0)
def_int $int1 = if_getheight(tuska_island_overlay:tutorial_panel);
def_int $int2 = 1;
if ($int1 = $int0) {
    if_setontimer(null, tuska_island_overlay:help_button);
} else if ($int1 > $int0) {
    if (calc($int1 - $int0) > 10) {
        $int2 = 5;
    }
    if_setsize(350, calc($int1 - $int2), ^setsize_abs, ^setsize_abs, tuska_island_overlay:tutorial_panel);
} else {
    if (calc($int0 - $int1) > 10) {
        $int2 = 5;
    }
    if_setsize(350, calc($int1 + $int2), ^setsize_abs, ^setsize_abs, tuska_island_overlay:tutorial_panel);
}
