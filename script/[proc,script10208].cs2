// 10208
[proc,script10208]
if (%pop_ship_collapse_list = 0) {
    if_sethide(true, pop_ship:obsolete_checkbox_selected_layer);
    if_sethide(false, pop_ship:obsolete_checkbox_deselected_layer);
} else {
    if_sethide(false, pop_ship:obsolete_checkbox_selected_layer);
    if_sethide(true, pop_ship:obsolete_checkbox_deselected_layer);
}
