// 1291
[clientscript,script1291]
switch_int (map_lang) {
    case default :
        if_setgraphic("aif_skill1_memory_icons_xp,1", div_converting:xp_icon);
        if_setgraphic("aif_skill1_memory_icons_xp,2", div_converting:enhanced_xp_icon);
    case 1 :
        if_setgraphic("aif_skill1_memory_icons_xp,13", div_converting:xp_icon);
        if_setgraphic("aif_skill1_memory_icons_xp,14", div_converting:enhanced_xp_icon);
    case 3 :
        if_setgraphic("aif_skill1_memory_icons_xp,10", div_converting:xp_icon);
        if_setgraphic("aif_skill1_memory_icons_xp,11", div_converting:enhanced_xp_icon);
    case 6 :
        if_setgraphic("aif_skill1_memory_icons_xp,4", div_converting:xp_icon);
        if_setgraphic("aif_skill1_memory_icons_xp,5", div_converting:enhanced_xp_icon);
}
