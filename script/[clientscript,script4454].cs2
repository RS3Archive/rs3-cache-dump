// 4454
[clientscript,script4454](int $int0, component $component1, int $int2, component $component3, component $component4)
if (activeclanchannel_find_listened = true) {
    if_setontimer(null, $component1);
    if_setonplayergrouptransmit("script4443(-1, $component3)", $component1);
    if_setonclanchanneltransmit("script4443(-1, $component3)", $component1);
    if_setonfriendtransmit("script4443(-1, $component3)", $component1);
    if_setonclansettingstransmit("script4443(-1, $component3)", $component1);
    ~script4444(%guest_line_pos, $component3);
} else {
    if_setgraphic("aif_clanchat_icons,13", $component4);
    if (calc(clientclock - $int2) > 200) {
        ~script4445($component3);
        if_setontimer("script4454($int0, $component1, clientclock, $component3, $component4)", $component1);
    }
}
