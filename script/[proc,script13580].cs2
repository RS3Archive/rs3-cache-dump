    if ($int1 ! -1) {
        cc_setparam(param_6408, ~clamp($int1, 1, 65536));
    }
    if ($int2 ! -1) {
        cc_setparam(param_6409, ~clamp($int2, 1, 65536));
    }
    cc_setparam(param_6754, ~clamp($int3, 0, 1));
