// 18325
[clientscript,script18325]
if (%activity_progress_bar_active_struct ! null & struct_param(%activity_progress_bar_active_struct, activity_progress_bar_second_healthbar) ! null & %activity_progress_bar_extension_second_health_bar_progress ! -1 & %activity_progress_bar_extension_second_health_bar_max_progress ! -1) {
    if_sethide(false, activity_progress_bar_extension:container);
    if_setposition(0, 40, ^setpos_abs_centre, ^setpos_abs_top, activity_progress_bar_extension:main_window);
} else {
    if_sethide(true, activity_progress_bar_extension:container);
    if_setposition(0, 0, ^setpos_abs_centre, ^setpos_abs_top, activity_progress_bar_extension:main_window);
}
