// 5345
[proc,script5345](stat $stat0)(int)
def_int $int1 = stat_base($stat0);
switch_stat ($stat0) {
    case cooking :
        return(enum(int, int, enum_4342, $int1));
    case crafting :
        return(enum(int, int, enum_4340, $int1));
    case firemaking :
        return(enum(int, int, enum_4338, $int1));
    case mining :
        return(enum(int, int, enum_4337, $int1));
    case smithing :
        return(enum(int, int, enum_4339, $int1));
    case summoning :
        return(enum(int, int, enum_4341, $int1));
    case woodcutting :
        return(enum(int, int, enum_4336, $int1));
}
return(0);
