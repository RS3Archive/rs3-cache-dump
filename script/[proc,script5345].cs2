// 5345
[proc,script5345](stat $stat0)(int)
def_int $int1 = stat_base($stat0);
switch_stat ($stat0) {
    case cooking :
        return(enum(int, int, clan_skill_ring_level_to_xp_cooking, $int1));
    case crafting :
        return(enum(int, int, clan_skill_ring_level_to_xp_crafting, $int1));
    case firemaking :
        return(enum(int, int, clan_skill_ring_level_to_xp_firemaking, $int1));
    case mining :
        return(enum(int, int, clan_skill_ring_level_to_xp_mining, $int1));
    case smithing :
        return(enum(int, int, clan_skill_ring_level_to_xp_smithing, $int1));
    case summoning :
        return(enum(int, int, clan_skill_ring_level_to_xp_summoning, $int1));
    case woodcutting :
        return(enum(int, int, clan_skill_ring_level_to_xp_woodcutting, $int1));
}
return(0);
