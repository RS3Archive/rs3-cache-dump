// 5354
[proc,script5354]()(int)
def_int $int0 = 0;
if (stat_base(dungeoneering) >= 110) {
    $int0 = 12;
} else if (stat_base(dungeoneering) >= 80) {
    $int0 = 9;
} else if (stat_base(dungeoneering) >= 40) {
    $int0 = 6;
} else if (stat_base(dungeoneering) >= 10) {
    $int0 = 3;
}
return(min(inv_size(rand_storage), calc(3 + $int0)));
