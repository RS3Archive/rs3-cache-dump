// 6619
[clientscript,script6619]
~script6620(peng_pow_bfish:pieces_blue);
~script6620(peng_pow_bfish:pieces_green);
if_setoninvtransmit("script6621(peng_pow_bfish:pieces_blue, boardgames_boardinv){boardgames_boardinv}", peng_pow_bfish:pieces_blue);
if_setoninvtransmit("script6621(peng_pow_bfish:pieces_green, boardgames_boardinv_secondary){boardgames_boardinv_secondary}", peng_pow_bfish:pieces_green);
if_setontimer("script6624(null, 0, 0, 0, -1)", peng_pow_bfish:game_boards);
if_setoninvtransmit("script6626(peng_pow_bfish:board_green_fish_layer){boardgames_boardinv_secondary}", peng_pow_bfish:board_green_fish_layer);
if_setoninvtransmit("script6627(peng_pow_bfish:board_blue_fish_layer){boardgames_boardinv}", peng_pow_bfish:board_blue_fish_layer);
