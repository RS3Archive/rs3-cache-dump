// 6564
[clientscript,script6564]
def_int $int0 = ~script18960;
def_string $string0 = "Graphics Preset is set to: ";
switch_int ($int0) {
    case 0 :
        $string0 = append($string0, "Custom");
    case 1 :
        $string0 = append($string0, "Min");
    case 2 :
        $string0 = append($string0, "Low");
    case 3 :
        $string0 = append($string0, "Mid");
    case 4 :
        $string0 = append($string0, "High");
    case 5 :
        $string0 = append($string0, "Ultra");
    case 6 :
        $string0 = append($string0, "Ultra Plus");
    case default :
        $string0 = append($string0, "Custom");
}
mes_typed(^chattype_console, 0, $string0);
