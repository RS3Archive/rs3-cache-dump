// 11895
[clientscript,script11895](component $component0)
if (%hlm_environment_effect = 0) {
    if_settrans(255, $component0);
    return;
}
if (%hlm_environment_effect = 255) {
    if_settrans(40, $component0);
    return;
}
def_int $int1 = scale(%hlm_environment_effect, 255, 100);
def_int $int2 = calc(40 + (215 - scale(215, 100, $int1)));
if_settrans($int2, $component0);
