// 2120
[proc,script2120](int $int0)(int)
def_int $int1 = calc(($int0 - 1) * 100);
def_int $int2 = min(calc((%qp - $int1) / 25), 4);
switch_int ($int0) {
    case 1 :
        return(calc($int2 - (~obj_gettotal(qps_reward_dice_t1) + %qps_dice_used_t1)));
    case 2 :
        return(calc($int2 - (~obj_gettotal(qps_reward_dice_t2) + %qps_dice_used_t2)));
    case 3 :
        return(calc($int2 - (~obj_gettotal(qps_reward_dice_t3) + %qps_dice_used_t3)));
    case 4 :
        return(calc($int2 - (~obj_gettotal(qps_reward_dice_t4) + %qps_dice_used_t4)));
    case 5 :
        return(calc($int2 - (~obj_gettotal(qps_reward_dice_t5) + %qps_dice_used_t5)));
    case default :
        return(0);
}
