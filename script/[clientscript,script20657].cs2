// 20657
[clientscript,script20657](int $int0, int $int1, int $int2)
switch_int (calc(min($int0, 5) % 5)) {
    case 1 :
        cc_setposition(0, calc($int1 + 35 * ($int2 / 5)), ^setpos_abs_centre, ^setpos_abs_top);
    case 2 :
        switch_int (calc($int2 % 5)) {
            case 0 :
                cc_setposition(calc((0 - 36) / 2), calc($int1 + 35 * ($int2 / 5)), ^setpos_abs_centre, ^setpos_abs_top);
            case 1 :
                cc_setposition(calc(36 / 2), calc($int1 + 35 * ($int2 / 5)), ^setpos_abs_centre, ^setpos_abs_top);
        }
    case 3 :
        switch_int (calc($int2 % 5)) {
            case 0 :
                cc_setposition(calc(0 - 36), calc($int1 + 35 * ($int2 / 5)), ^setpos_abs_centre, ^setpos_abs_top);
            case 1 :
                cc_setposition(0, calc($int1 + 35 * ($int2 / 5)), ^setpos_abs_centre, ^setpos_abs_top);
            case 2 :
                cc_setposition(36, calc($int1 + 35 * ($int2 / 5)), ^setpos_abs_centre, ^setpos_abs_top);
        }
    case 4 :
        switch_int (calc($int2 % 5)) {
            case 0 :
                cc_setposition(scale(calc(0 - 36), 2, 3), calc($int1 + 35 * ($int2 / 5)), ^setpos_abs_centre, ^setpos_abs_top);
            case 1 :
                cc_setposition(calc((0 - 36) / 2), calc($int1 + 35 * ($int2 / 5)), ^setpos_abs_centre, ^setpos_abs_top);
            case 2 :
                cc_setposition(calc(36 / 2), calc($int1 + 35 * ($int2 / 5)), ^setpos_abs_centre, ^setpos_abs_top);
            case 3 :
                cc_setposition(scale(36, 2, 3), calc($int1 + 35 * ($int2 / 5)), ^setpos_abs_centre, ^setpos_abs_top);
        }
    case 0 :
        switch_int (calc($int2 % 5)) {
            case 0 :
                cc_setposition(calc((0 - 36) * 2), calc($int1 + 35 * ($int2 / 5)), ^setpos_abs_centre, ^setpos_abs_top);
            case 1 :
                cc_setposition(calc(0 - 36), calc($int1 + 35 * ($int2 / 5)), ^setpos_abs_centre, ^setpos_abs_top);
            case 2 :
                cc_setposition(0, calc($int1 + 35 * ($int2 / 5)), ^setpos_abs_centre, ^setpos_abs_top);
            case 3 :
                cc_setposition(36, calc($int1 + 35 * ($int2 / 5)), ^setpos_abs_centre, ^setpos_abs_top);
            case 4 :
                cc_setposition(calc(36 * 2), calc($int1 + 35 * ($int2 / 5)), ^setpos_abs_centre, ^setpos_abs_top);
        }
}
