%trail_lightsout_mouseover = calc($int1 + 1);
def_int $int2 = ~script13374($int1);
~script14010($component0, $int2);
if ($int1 < 20) {
    ~script14010(~script1501(calc($int1 + 5)), ~script13374(calc($int1 + 5)));
