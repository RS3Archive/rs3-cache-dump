// 3901
[clientscript,script3901](int $int0, component $component1, int $int2, component $component3, int $int4, obj $obj5, inv $inv6)
if (%inv_obj_being_dragged ! $obj5 | %inv_inv_being_dragged ! $inv6) {
    if_setonmouserepeat(null, $component1);
