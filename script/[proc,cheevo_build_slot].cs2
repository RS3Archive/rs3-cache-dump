cc_create(achievements_sub:build_layer, ^iftype_graphic, calc($int0 * 11 + 4));
cc_create(achievements_sub:build_layer, ^iftype_text, calc($int0 * 11 + 5));
cc_create(achievements_sub:build_layer, ^iftype_text, calc($int0 * 11 + 6));
cc_create(achievements_sub:build_layer, ^iftype_graphic, calc($int0 * 11 + 7));
cc_create(achievements_sub:build_layer, ^iftype_graphic, calc($int0 * 11 + 8));
cc_create(achievements_sub:build_layer, ^iftype_rectangle, calc($int0 * 11 + 9));
cc_create(achievements_sub:build_layer, ^iftype_text, calc($int0 * 11 + 10));
