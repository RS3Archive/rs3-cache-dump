// 14287
[proc,script14287]
def_obj $obj0 = null;
def_obj $obj1 = null;
def_obj $obj2 = null;
switch_int (%hlr4m_hybrid_type) {
    case 1 :
        $obj0 = hlr4m_battlemage_legs_stats;
        $obj1 = hlr4m_trickster_legs_stats;
        $obj2 = hlr4m_vanguard_legs_stats;
    case 2 :
        $obj0 = hlr4m_battlemage_helm_stats;
        $obj1 = hlr4m_trickster_helm_stats;
        $obj2 = hlr4m_vanguard_helm_stats;
    case 3 :
        $obj0 = hlr4m_battlemage_robe_stats;
        $obj1 = hlr4m_trickster_robe_stats;
        $obj2 = hlr4m_vanguard_robe_stats;
    case 5 :
        $obj0 = hlr4m_battlemage_gloves_stats;
        $obj1 = hlr4m_trickster_gloves_stats;
        $obj2 = hlr4m_vanguard_gloves_stats;
    case 4 :
        $obj0 = hlr4m_battlemage_boots_stats;
        $obj1 = hlr4m_trickster_boots_stats;
        $obj2 = hlr4m_vanguard_boots_stats;
}
if_setobject_nonum($obj0, 1, hlr4m_itemselect:battlemage_model);
if_setobject_nonum($obj1, 1, hlr4m_itemselect:trickster_model);
if_setobject_nonum($obj2, 1, hlr4m_itemselect:vanguard_model);
