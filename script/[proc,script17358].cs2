// 17358
[proc,script17358](struct $struct0)
def_component $component1 = timed_event:variety_task_events_info_button;
if (if_find($component1) = true) {
    switch_struct ($struct0) {
        case variety_task_events_task_jagex_account :
            cc_sethide(false);
            cc_settext("Upgrade Now");
            cc_setonbuttonpressed("script15228(2521)");
        case default :
            cc_sethide(true);
            cc_setonbuttonpressed(null);
    }
}
