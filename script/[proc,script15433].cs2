// 15433
[proc,script15433](component $component0)(boolean)
while (if_getlayer($component0) ! null) {
    $component0 = if_getlayer($component0);
}
switch_component ($component0) {
    case buff_bar:universe_layer :
        return(true);
    case debuff_bar:universe_layer :
        return(false);
    case default :
        return(null);
}
