// 11964
[clientscript,script11964](component $component0)
if (++%tutisland_focus_instructions < 150) {
    return;
} else if (if_gettrans($component0) = 255) {
    if_setontimer(null, $component0);
    if_sethide(true, $component0);
    if_sethide(true, tutisland_focus:text);
    return;
} else if (calc(%tutisland_focus_instructions % 2) = 0) {
    if_settrans(min(255, calc(if_gettrans($component0) + 4)), $component0);
}
