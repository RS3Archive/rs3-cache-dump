// 11180
[proc,script11180]
if (%varclientbit_38847 = 0) {
    if_setgraphic(rs3_minimap_btn_hide, mobile_settings_button:minimap_button);
    if_sethide(false, mobile_settings_button:bg_main);
    if_sethide(false, mobile_settings_button:corner_flair);
    if_setsize(0, 0, ^setsize_minus, ^setsize_minus, mobile_settings_button:blocking_layer);
} else {
    if_setgraphic(rs3_minimap_btn_show, mobile_settings_button:minimap_button);
    if_sethide(true, mobile_settings_button:bg_main);
    if_sethide(true, mobile_settings_button:corner_flair);
    if_setsize(50, 0, ^setsize_abs, ^setsize_minus, mobile_settings_button:blocking_layer);
}
