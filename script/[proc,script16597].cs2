// 16597
[proc,script16597](int $int0, int $int1)(boolean)
if (calc($int0 * 1440 + $int1) < calc(%trh179_modifier_end_day * 1440 + %trh179_modifier_end_minute)) {
    if (%trh179_modifier_cached ! 0) {
        return(true);
    } else {
        ~error("Player had trh179 modifier cache time-outs set but not the actual cache value. cached val:<tostring(%trh179_modifier_cached)>,day:<tostring(%trh179_modifier_end_day)>,min:<tostring(%trh179_modifier_end_minute)>");
    }
}
return(false);
