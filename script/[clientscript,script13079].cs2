// 13079
[clientscript,script13079](int $int0, int $int1)
if ($int0 = 1) {
    cc_create(peng_bttf_mastermind:hints, ^iftype_rectangle, if_getnextsubid(peng_bttf_mastermind:hints));
    cc_setsize(8, 8, ^setsize_abs, ^setsize_abs);
    cc_setcolour(0x808080);
    cc_setfill(true);
    cc_setposition(calc($int1 * 10 + 10), calc(%peng_bttf_div_round * 23 + 13), ^setpos_abs_left, ^setpos_abs_bottom);
    sound_vorbis_volume(peng_bttf_mastermind_correct, 1, calc($int1 * 10 + 10), 175);
} else if ($int0 = 2) {
    cc_create(peng_bttf_mastermind:hints, ^iftype_rectangle, if_getnextsubid(peng_bttf_mastermind:hints));
    cc_setsize(8, 8, ^setsize_abs, ^setsize_abs);
    cc_setcolour(^white);
    cc_setfill(true);
    cc_setposition(calc($int1 * 10 + 10), calc(%peng_bttf_div_round * 23 + 13), ^setpos_abs_left, ^setpos_abs_bottom);
    sound_vorbis_volume(peng_bttf_mastermind_incorrect, 1, calc($int1 * 10 + 10), 175);
}
