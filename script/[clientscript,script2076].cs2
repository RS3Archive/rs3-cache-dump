// 2076
[clientscript,script2076]
def_int $int0 = 0;
if (%snp_game_in_progress_client = 0) {
    if (calc(5 - %snp_red_players_waiting_client) > 0) {
        $int0 = calc(5 - %snp_red_players_waiting_client);
    } else {
        $int0 = 0;
    }
    if_settext(tostring($int0), snp_waiting_room:text_redteam_count);
} else {
    if_settext(tostring(%snp_red_players_client), snp_waiting_room:text_redteam_count);
}
