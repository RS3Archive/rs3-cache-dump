// 17329
[clientscript,script17329]
if (%trh192_character_firing_animation_occuring = 1) {
    ~script10943("Please wait before previewing rewards.", trh192_overlay:splash_screen_btn);
    return;
}
if_sethide(false, trh192_overlay:splash_screen);
if_sethide(true, trh192_overlay:universe);
if_setgraphic(trh192_background_1, trh192_overlay:splash_screen_bg_graphic);
if_settext("Loose arrows to earn the <col=89CFF0><oc_name(trh192_archers_outfit_dummy)></col>! With a chance to receive a <col=89CFF0><oc_name(trh192_walk_override_token)></col> with each arrow shot!", trh192_overlay:splash_screen_tagline);
~script17335(~script17310(1), 0, 0, 100, -1947, 0, 650, "<col=89CFF0><oc_name(trh192_archers_outfit_dummy)></col>", combat_2012_combat_ready, trh192_overlay:npc_model_drag_layer, trh192_overlay:npc_model, trh192_overlay:npc_model_text);
~script17335(~script17310(0), 0, 0, 100, 1947, 0, 650, "<col=89CFF0><oc_name(trh192_walk_override_token)></col>", trh192_looting_range_run, trh192_overlay:npc_model_drag_layer_2, trh192_overlay:npc_model_2, trh192_overlay:npc_model_text_2);
~script16198(false, 75497473);
