[clientscript,fishcomp_rewards_shop_init]
if_setonvarctransmit("fishcomp_rewards_shop_refresh{fishcomp_rewards_shop_species_1, fishcomp_rewards_shop_quantity_1, fishcomp_rewards_shop_species_2, fishcomp_rewards_shop_quantity_2}", fishcomp_rewards_shop:main_layer);
