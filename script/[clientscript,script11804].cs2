        $int2 = %combatv2_actionbar_current_bar_mobile;
    case toplevel_v2_combat_bar_mobile_buttons_parent:mobile_bar_revo_click :
        $int2 = %combatv2_actionbar_current_bar_mobile_revo;
    case default :
