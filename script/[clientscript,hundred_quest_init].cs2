// 6940
[clientscript,hundred_quest_init](component $component0, int $int1)
cc_deleteall($component0);
cc_create($component0, ^iftype_graphic, 0);
cc_setsize(50, 50, ^setsize_abs, ^setsize_abs);
def_int $int2 = calc((if_getheight($component0) - cc_getheight) / 2);
cc_setposition($int2, 0, ^setpos_abs_left, ^setpos_abs_centre);
.cc_create($component0, ^iftype_text, 1);
.cc_setsize(calc($int2 + cc_getwidth), 0, ^setsize_minus, ^setsize_minus);
.cc_setposition(0, 0, ^setpos_abs_right, ^setpos_abs_centre);
.cc_settextfont(p12_full);
.cc_settextalign(^settextalign_centre, ^settextalign_centre, 0);
.cc_settextshadow(true);
if_setonmouseover("cc_text_colour_swapper($component0, .cc_getid, 16777215)", $component0);
~hundred_quest_setcolour($component0, $int1);
switch_int ($int1) {
    case 7500 :
        .cc_settext("Dwarf");
        cc_setgraphic("aif_recipe_for_disaster_icons,0");
        if_setonvartransmit("hundred_quest_setcolour($component0, $int1, .cc_getid){hundred_dwarf}", $component0);
    case 7501 :
        .cc_settext("Wartface & Bentnoze");
        cc_setgraphic("aif_recipe_for_disaster_icons,9");
        if_setonvartransmit("hundred_quest_setcolour($component0, $int1, .cc_getid){100council}", $component0);
    case 7505 :
        .cc_settext("Pirate Pete");
        cc_setgraphic("aif_recipe_for_disaster_icons,8");
        if_setonvartransmit("hundred_quest_setcolour($component0, $int1, .cc_getid){100_pirate_quest}", $component0);
    case 7502 :
        .cc_settext("Lumbridge Sage");
        cc_setgraphic("aif_recipe_for_disaster_icons,3");
        if_setonvartransmit("hundred_quest_setcolour($component0, $int1, .cc_getid){100_pirate_quest}", $component0);
    case 7499 :
        .cc_settext("Evil Dave");
        cc_setgraphic("aif_recipe_for_disaster_icons,4");
        if_setonvartransmit("hundred_quest_setcolour($component0, $int1, .cc_getid){hundred_dave}", $component0);
    case 7503 :
        .cc_settext("Monkey Ambassador");
        cc_setgraphic("aif_recipe_for_disaster_icons,6");
        if_setonvartransmit("hundred_quest_setcolour($component0, $int1, .cc_getid){hundred_ilm_var_1}", $component0);
    case 7506 :
        .cc_settext("Sir Amik Varze");
        cc_setgraphic("aif_recipe_for_disaster_icons,5");
        if_setonvartransmit("hundred_quest_setcolour($component0, $int1, .cc_getid){100_ogre}", $component0);
    case 7507 :
        .cc_settext("Skrach Uglogwee");
        cc_setgraphic("aif_recipe_for_disaster_icons,7");
        if_setonvartransmit("hundred_quest_setcolour($component0, $int1, .cc_getid){100_ogre}", $component0);
}
