// 1324
[clientscript,eyeglo_unlock](component $component0, component $component1, component $component2, component $component3, component $component4, component $component5)
if_setmodel(enum(int, model, eyeglo_digits, calc(%eyeglo_coin_value_1 / 10)), $component0);
if_setmodel(enum(int, model, eyeglo_digits, calc(%eyeglo_coin_value_1 % 10)), $component1);
if_setobject_nonum(%eyeglo_unlock_a, 1, $component5);
if (%eyeglo_unlock_val = 0) {
    if_setmodel(eyeglo_gnome_machine_button_invalid_red_interface, $component3);
    if_setmodel(null, $component2);
    if_setmodel(null, $component4);
    return;
}
if (%eyeglo_unlock_val > %eyeglo_coin_value_1) {
    if_setmodel(eyeglo_gnome_machine_button_invalid_red_interface, $component3);
    if_setmodel(eyeglo_gnome_machine_button_up_red_interface, $component2);
    if_setmodel(eyeglo_gnome_machine_button_down_green_interface, $component4);
    return;
}
if (%eyeglo_unlock_val < %eyeglo_coin_value_1) {
    if_setmodel(eyeglo_gnome_machine_button_invalid_red_interface, $component3);
    if_setmodel(eyeglo_gnome_machine_button_up_green_interface, $component2);
    if_setmodel(eyeglo_gnome_machine_button_down_red_interface, $component4);
    return;
}
if_setmodel(eyeglo_gnome_machine_button_invalid_green_interface, $component3);
if_setmodel(null, $component2);
if_setmodel(null, $component4);
