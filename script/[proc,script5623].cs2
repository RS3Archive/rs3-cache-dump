// 5623
[proc,script5623](component $component0)
switch_component ($component0) {
    case interface_1199:com_8 :
        if_setposition(calc(if_getwidth(interface_1199:com_14) / 2), calc(0 - if_getheight($component0)), ^setpos_abs_left, ^setpos_abs_top, $component0);
    case interface_1199:com_6 :
        if_setposition(if_getwidth(interface_1199:com_14), calc(if_getheight(interface_1199:com_14) / 2), ^setpos_abs_left, ^setpos_abs_top, $component0);
    case interface_1199:com_2 :
        if_setposition(calc(if_getwidth(interface_1199:com_14) / 2), if_getheight(interface_1199:com_14), ^setpos_abs_left, ^setpos_abs_top, $component0);
    case interface_1199:com_10 :
        if_setposition(calc(0 - if_getwidth($component0)), if_getheight(interface_1199:com_14), ^setpos_abs_left, ^setpos_abs_top, $component0);
    case interface_1199:com_4 :
        if_setposition(calc(0 - if_getwidth($component0)), calc(if_getheight(interface_1199:com_14) / 2), ^setpos_abs_left, ^setpos_abs_top, $component0);
    case interface_1199:com_12 :
        if_setposition(calc(0 - if_getwidth($component0)), calc(0 - if_getheight($component0)), ^setpos_abs_left, ^setpos_abs_top, $component0);
}
