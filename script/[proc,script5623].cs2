// 5623
[proc,script5623](component $component0)
switch_component ($component0) {
    case fmc_torch:n_tendril :
        if_setposition(calc(if_getwidth(fmc_torch:base) / 2), calc(0 - if_getheight($component0)), ^setpos_abs_left, ^setpos_abs_top, $component0);
    case fmc_torch:e_tendril :
        if_setposition(if_getwidth(fmc_torch:base), calc(if_getheight(fmc_torch:base) / 2), ^setpos_abs_left, ^setpos_abs_top, $component0);
    case fmc_torch:s_tendril :
        if_setposition(calc(if_getwidth(fmc_torch:base) / 2), if_getheight(fmc_torch:base), ^setpos_abs_left, ^setpos_abs_top, $component0);
    case fmc_torch:sw_tendril :
        if_setposition(calc(0 - if_getwidth($component0)), if_getheight(fmc_torch:base), ^setpos_abs_left, ^setpos_abs_top, $component0);
    case fmc_torch:w_tendril :
        if_setposition(calc(0 - if_getwidth($component0)), calc(if_getheight(fmc_torch:base) / 2), ^setpos_abs_left, ^setpos_abs_top, $component0);
    case fmc_torch:nw_tendril :
        if_setposition(calc(0 - if_getwidth($component0)), calc(0 - if_getheight($component0)), ^setpos_abs_left, ^setpos_abs_top, $component0);
}
