// 4377
[clientscript,clan_vote_update]
if (%varplayer_2081 = %varclient_1499) {
    if_settext("You have voted.", interface_1101:com_74);
} else {
    if_settext("You have not yet voted.<br>How would you like to vote?", interface_1101:com_74);
}
if (%varplayerbit_8989 = 0) {
    if_settext("Results of last vote:", interface_1101:com_12);
} else if (%varplayerbit_8992 = 1 | %varplayerbit_8992 = 0) {
    if_settext("Vote open for less than a minute.", interface_1101:com_12);
} else {
    if_settext("Vote open for less than <tostring(%varplayerbit_8992)> minutes.", interface_1101:com_12);
}
def_int $int0 = calc(%varplayerbit_8987 + %varplayerbit_8988);
def_int $int1 = 0;
def_int $int2 = 0;
if ($int0 > 0) {
    if ($int0 = %varplayerbit_8987) {
        $int1 = 100;
    } else if ($int0 = %varplayerbit_8988) {
        $int2 = 100;
    } else {
        $int1 = calc(100 * %varplayerbit_8987 / $int0);
        if (%varplayerbit_8988 = 0) {
            $int2 = 0;
        } else {
            $int2 = calc(100 - $int1);
        }
    }
}
if_settext(tostring(%varplayerbit_8987), interface_1101:com_7);
if_settext(tostring(%varplayerbit_8988), interface_1101:com_8);
~aif_progressbar_set($int1, interface_1101:com_51, interface_1101:com_56);
~aif_progressbar_set($int2, interface_1101:com_61, interface_1101:com_66);
