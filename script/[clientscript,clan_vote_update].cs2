// 4377
[clientscript,clan_vote_update]
if (%clan_custom_vote_cast_varp = %clan_voting_id_initial_varc) {
    if_settext("You have voted.", clan_voting:vote_status);
} else {
    if_settext("You have not yet voted.<br>How would you like to vote?", clan_voting:vote_status);
}
if (%clan_custom_vote_inprogress_varp = 0) {
    if_settext("Results of last vote:", clan_voting:vote_time);
} else if (%clan_custom_vote_time_remaining = 1 | %clan_custom_vote_time_remaining = 0) {
    if_settext("Vote open for less than a minute.", clan_voting:vote_time);
} else {
    if_settext("Vote open for less than <tostring(%clan_custom_vote_time_remaining)> minutes.", clan_voting:vote_time);
}
def_int $int0 = calc(%clan_custom_vote_yes_varp + %clan_custom_vote_no_varp);
def_int $int1 = 0;
def_int $int2 = 0;
if ($int0 > 0) {
    if ($int0 = %clan_custom_vote_yes_varp) {
        $int1 = 100;
    } else if ($int0 = %clan_custom_vote_no_varp) {
        $int2 = 100;
    } else {
        $int1 = calc(100 * %clan_custom_vote_yes_varp / $int0);
        if (%clan_custom_vote_no_varp = 0) {
            $int2 = 0;
        } else {
            $int2 = calc(100 - $int1);
        }
    }
}
if_settext(tostring(%clan_custom_vote_yes_varp), clan_voting:vote_yes_total);
if_settext(tostring(%clan_custom_vote_no_varp), clan_voting:vote_no_total);
~aif_progressbar_set($int1, clan_voting:green_large_progress_value_layer, clan_voting:green_text);
~aif_progressbar_set($int2, clan_voting:red_large_progress_value_layer, clan_voting:red_text);
