// 17079
[proc,script17079](component $component0, component $component1, component $component2)
if (%lobby_is_jpp_account = true) {
    if_sethide(true, $component1);
    if_sethide(true, $component2);
    if_setsize(calc(if_getwidth($component0) - 80), if_getheight($component0), ^setsize_abs, ^setsize_abs, $component0);
    cc_deleteall($component0);
    ~script2649;
    ~script2601;
    if_setposition(calc(if_getx($component0) - 5 - if_getwidth(lobbyscreen:clock)), if_gety(lobbyscreen:clock), ^setpos_abs_left, ^setpos_abs_top, lobbyscreen:clock);
}
