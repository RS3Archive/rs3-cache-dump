// 7077
[clientscript,script7077](int $int0)
if ($int0 = 1) {
    %ooak_dragonrider_remember_roof = ~graphics_options_detailget(graphics_options_removeroofs);
    ~graphics_options_detailset(graphics_options_removeroofs, 0, 0);
} else {
    ~graphics_options_detailset(graphics_options_removeroofs, %ooak_dragonrider_remember_roof, 0);
}
