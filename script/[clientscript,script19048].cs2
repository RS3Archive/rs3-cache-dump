// 19048
[clientscript,script19048](int $int0, int $int1)
if (clientclock > $int0) {
    if ($int1 = 1) {
        if_sethide(false, trh183_overlay:firework_set_1);
        if_setontimer("script19049(calc(clientclock + 36), $int1)", trh183_overlay:firework_layer_1);
    } else {
        if_sethide(false, trh183_overlay:firework_set_2);
        if_setontimer("script19049(calc(clientclock + 36), $int1)", trh183_overlay:firework_layer_2);
    }
}
