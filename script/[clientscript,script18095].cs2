// 18095
[clientscript,script18095]
def_dbrow $dbrow0 = ~script17853;
if (%bp3_current_viewed_pass ! $dbrow0) {
    ~error("Opening Splash on a pass which isn't the current.");
    return;
}
if (~script17912 = true) {
    ~script18096(2, 0);
    if (~script11939 = true) {
        if_setposition(0, 15, ^setpos_abs_centre, ^setpos_abs_bottom, bp3_splash_embedded:left_holder);
        if_sethide(true, bp3_splash_embedded:right_holder);
    } else {
        ~script18096(1, 1);
    }
} else if (~script17862(dbrow_7906) < ~script17890($dbrow0)) {
    ~script18096(1, 3);
    ~script18096(2, 2);
} else {
    ~script18096(1, 2);
    ~script18096(2, -1);
}
def_component $component1 = bp3_splash_embedded:close_button;
cc_deleteall($component1);
~if_add_child_button($component1, 0, 0, 0, 0, ^setpos_abs_left, ^setpos_abs_top, 0, 0, ^setsize_minus, ^setsize_minus, bp3_back_button, "");
cc_setop(1, "Close");
