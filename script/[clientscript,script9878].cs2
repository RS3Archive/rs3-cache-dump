// 9878
[clientscript,script9878]
if_setonvartransmit(null, combatv2_legacy_side:buttons);
def_obj $obj0 = inv_getobj(worn, 3);
def_int $int1 = 0;
def_string $string0 = "Attack";
def_string $string1 = "";
def_string $string2 = "";
def_string $string3 = "Sheathe/unsheathe weapon";
def_graphic $graphic2 = "combaticons,6";
def_graphic $graphic3 = "combaticons,5";
def_graphic $graphic4 = "combaticons,7";
def_graphic $graphic5 = "combaticons,4";
if ($obj0 = null) {
    $int1 = 1;
} else if (oc_param($obj0, combatv2_melee_weapon) = 1) {
    $int1 = 1;
} else if (oc_param($obj0, combatv2_ranged_weapon) = 1) {
    $int1 = 2;
} else if (oc_param($obj0, combatv2_magic_weapon) = 1) {
    $int1 = 3;
} else if (oc_param($obj0, combatv2_necromancy_weapon) = 1) {
    $int1 = 4;
} else {
    $int1 = 1;
}
switch_int ($int1) {
    case 1 :
        $string1 = "Gain Attack XP in combat.";
    case 2 :
        $string0 = "Ranged";
        $string1 = "Gain Ranged XP in combat.";
        $graphic2 = "combaticons2,16";
        $graphic4 = "combaticons2,15";
        $graphic5 = "combaticons2,17";
    case 3 :
        $string0 = "Magic";
        $string1 = "Gain Magic XP in combat.";
        $graphic2 = "combaticons2,13";
        $graphic4 = "combaticons2,14";
        $graphic5 = "combaticons,19";
    case 4 :
        $string0 = "Necromancy";
        $string1 = "Gain Necromancy XP in combat.";
        $graphic2 = "combaticons2,13";
        $graphic4 = "combaticons2,14";
        $graphic5 = "combaticons,19";
}
~script9879($int1);
if_sethide(false, combatv2_legacy_side:button1);
if ($int1 = 2 | $int1 = 3 | $int1 = 4) {
    if_sethide(true, combatv2_legacy_side:button2);
} else {
    if_sethide(false, combatv2_legacy_side:button2);
}
if_sethide(false, combatv2_legacy_side:button3);
~script11348;
if_setgraphic($graphic2, combatv2_legacy_side:icon1);
if_setgraphic($graphic3, combatv2_legacy_side:icon2);
if_setgraphic($graphic5, combatv2_legacy_side:icon3);
if_setgraphic($graphic2, combatv2_legacy_side:barbassault_icon1);
if_setgraphic($graphic2, combatv2_legacy_side:barbassault_icon1_tiny);
if_setgraphic($graphic4, combatv2_legacy_side:barbassault_icon2);
if_setgraphic($graphic4, combatv2_legacy_side:barbassault_icon2_tiny);
if_setgraphic($graphic5, combatv2_legacy_side:barbassault_icon3);
if_setgraphic($graphic5, combatv2_legacy_side:barbassault_icon3_tiny);
if_settext($string0, combatv2_legacy_side:text1);
if_setonmouserepeat("script8799($string1, event_com, event_comsubid)", combatv2_legacy_side:button1);
if_setonmouserepeat("script8799($string3, event_com, event_comsubid)", combatv2_legacy_side:combat_icon);
~script9877;
