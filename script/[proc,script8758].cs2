// 8758
[proc,script8758](component $component0, int $int1, string $string0, int $int2)
if (calc($int2 % 2) = 0) {
    cc_create($component0, ^iftype_graphic, if_getnextsubid($component0));
    cc_setgraphic(scroll_divider);
    cc_setposition(0, $int1, ^setpos_abs_left, ^setpos_abs_top);
    cc_setsize(286, 42, ^setsize_abs, ^setsize_abs);
}
cc_create($component0, ^iftype_graphic, if_getnextsubid($component0));
cc_setposition(5, calc($int1 + 10), ^setpos_abs_left, ^setpos_abs_top);
cc_setsize(260, 23, ^setsize_abs, ^setsize_abs);
cc_setgraphic(art_title_underline);
cc_create($component0, ^iftype_text, if_getnextsubid($component0));
cc_setposition(5, calc($int1 + 10), ^setpos_abs_left, ^setpos_abs_top);
cc_setsize(260, 23, ^setsize_abs, ^setsize_abs);
cc_setcolour(0xe0d471);
cc_settextfont(cinzel_13pt_bold);
cc_settext($string0);
