// 12341
[clientscript,script12341](component $component0, int $int1, int $int2)
if ($component0 = null) {
    return;
}
if (.if_find($component0) = true) {
    .cc_setparam(param_5946, 1);
    .cc_setparam(param_5947, calc(clientclock + 5));
    if ($int1 ! -1 & cc_find($component0, $int1) = true) {
        cc_setcolour($int2);
    }
}
