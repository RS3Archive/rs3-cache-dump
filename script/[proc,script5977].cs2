// 5977
[proc,script5977]
def_int $int0 = 1;
def_int $int1 = 0;
def_graphic $graphic2 = null;
def_component $component3 = null;
switch_int (%clan_stronghold_main_map_mode) {
    case 0 :
        $component3 = clan_stronghold_main_map:map_graphic;
    case 1, 3, 4 :
        $component3 = clan_stronghold_main_buildings:map_graphic;
    case 2, 5 :
        $component3 = clan_stronghold_main_decor:map_graphic;
    case default :
        return;
}
if (clanprofile_find = true) {
    if (%clan_stronghold_main_map_next_week < 0) {
        %clan_stronghold_main_map_next_week = 0;
    }
    if (%clan_stronghold_main_map_next_week = 0) {
        $int1 = %clan_stronghold_layout;
    } else {
        $int1 = %clan_stronghold_main_next_map_layout_varclan;
    }
    $int0 = %clan_stronghold_tier;
    $graphic2 = ~script4904(1, $int1, $int0);
    if ($graphic2 = null) {
        return;
    }
    if_setgraphic($graphic2, $component3);
}
