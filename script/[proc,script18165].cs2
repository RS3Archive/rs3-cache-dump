// 18165
[proc,script18165]
if (%doublexp_personal_buff_seconds_remaining = 0) {
    %doublexp_personal_buff_minutes_remaining = calc(%doublexp_personal_buff_minutes_remaining - 1);
    %doublexp_personal_buff_seconds_remaining = 59;
} else {
    %doublexp_personal_buff_seconds_remaining = calc(%doublexp_personal_buff_seconds_remaining - 1);
}
