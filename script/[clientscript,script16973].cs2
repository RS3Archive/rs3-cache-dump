[clientscript,script16973]
if_setmodelanim(trh_chest_closed_idle, trh188:cauldron_model);
switch_int (random(3)) {
    case 0 :
        sound_vorbis_rate(arch_uncover_smokepuff_1, 1, 0, 80, random_sound_pitch(20, 20));
    case 1 :
        sound_vorbis_rate(arch_uncover_smokepuff_2, 1, 0, 80, random_sound_pitch(20, 20));
    case 2 :
        sound_vorbis_rate(arch_uncover_smokepuff_3, 1, 0, 80, random_sound_pitch(20, 20));
}
