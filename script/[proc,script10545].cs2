// 10545
[proc,script10545](int $int0)(string)
switch_int ($int0) {
    case 0 :
        return("<tostring(%varplayerbit_39287)>/280 items cooked.");
    case 1 :
        return("<tostring(%varplayerbit_39301)>/3 penguins found.");
    case 2 :
        return("<tostring(calc(%varplayerbit_39289 + %varplayerbit_39290 + %varplayerbit_39291))>/3 kebbits fed.");
    case 3 :
        return("<tostring(%varplayerbit_39305)>/5 HAM members, <tostring(%varplayerbit_39306)>/5 farmers and <tostring(%varplayerbit_39308)>/5 guards pockets picked.");
    case 4 :
        return("<tostring(%varplayerbit_39293)>/100 points from caches.");
    case 5 :
        return("<tostring(%varplayerbit_39283)>/1 delivery complete.");
    case 6 :
        return("<tostring(%varplayerbit_39282)>/1 delivery complete.");
    case 7 :
        return("<tostring(%varplayerbit_39298)>/30 oak logs, <tostring(%varplayerbit_39299)>/20 willow logs.");
    case 8 :
        return("<tostring(%varplayerbit_39294)>/5 gold charm, <tostring(%varplayerbit_39295)>/5 green charm, <tostring(%varplayerbit_39296)>/5 crimson charm and <tostring(%varplayerbit_39297)>/5 blue charm pouches made.");
    case 9 :
        return("<tostring(%varplayerbit_39285)>/1 delivery complete.");
    case 10 :
        return("<tostring(%varplayerbit_39281)>/1 sinkhole explored.");
    case 11 :
        return("<tostring(%varplayerbit_39288)>/20 creatures killed.");
    case 12 :
        return("<tostring(%varplayerbit_39279)>/1 evil spirits warded.");
    case 13 :
        return("<tostring(%varplayerbit_39286)>/1 delivery complete.");
