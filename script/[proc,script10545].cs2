// 10545
[proc,script10545](int $int0)(string)
switch_int ($int0) {
    case 0 :
        return("<tostring(%event10_cooking_progress)>/280 items cooked.");
    case 1 :
        return("<tostring(%event10_penguin_progress)>/3 penguins found.");
    case 2 :
        return("<tostring(calc(%event10_dog_progress_1 + %event10_dog_progress_2 + %event10_dog_progress_3))>/3 kebbits fed.");
    case 3 :
        return("<tostring(%event10_pickpocket_progress_men)>/5 HAM members, <tostring(%event10_pickpocket_progress_farmers)>/5 farmers and <tostring(%event10_pickpocket_progress_guards)>/5 guards pockets picked.");
    case 4 :
        return("<tostring(%event10_cache_progress)>/100 points from caches.");
    case 5 :
        return("<tostring(%event10_delivery)>/1 delivery complete.");
    case 6 :
        return("<tostring(%event10_dragon)>/1 delivery complete.");
    case 7 :
        return("<tostring(%event10_woodcutting_oak_progress)>/30 oak logs, <tostring(%event10_woodcutting_willow_progress)>/20 willow logs.");
    case 8 :
        return("<tostring(%event10_summoning_gold_progress)>/5 gold charm, <tostring(%event10_summoning_green_progress)>/5 green charm, <tostring(%event10_summoning_crimson_progress)>/5 crimson charm and <tostring(%event10_summoning_blue_progress)>/5 blue charm pouches made.");
    case 9 :
        return("<tostring(%event10_jewellery)>/1 delivery complete.");
    case 10 :
        return("<tostring(%event10_sinkhole)>/1 sinkhole explored.");
    case 11 :
        return("<tostring(%event10_predator_progress)>/20 creatures killed.");
    case 12 :
        return("<tostring(%event10_evil)>/1 evil spirits warded.");
    case 13 :
        return("<tostring(%event10_potions)>/1 delivery complete.");
    case default :
        return("0/0");
}
