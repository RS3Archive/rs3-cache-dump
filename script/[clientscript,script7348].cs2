// 7348
[clientscript,script7348]
if (if_gethide(pop_log:resource_layer) = false) {
    if_sethide(true, pop_log:resource_layer);
    if_sethide(false, pop_log:stats_layer);
} else if (if_gethide(pop_log:ships_layer) = false) {
    if_sethide(true, pop_log:ships_layer);
    if_sethide(false, pop_log:resource_layer);
} else if (if_gethide(pop_log:people_layer) = false) {
    if_sethide(true, pop_log:people_layer);
    if_sethide(false, pop_log:ships_layer);
} else {
    if_sethide(true, pop_log:stats_layer);
    if_sethide(false, pop_log:people_layer);
}
