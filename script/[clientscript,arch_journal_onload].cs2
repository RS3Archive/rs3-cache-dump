// 14803
[clientscript,arch_journal_onload]
if_settext(tostring(stat_base(archaeology)), arch_journal:skill_level_text);
if_setopcursor(1, cursor_goto, arch_journal:skill_level_holder);
if (%arch_journal_bookmark_tab_selected = -1) {
    ~script14807(0);
    ~script14811(0);
} else {
    ~script14807(%arch_journal_bookmark_tab_selected);
    ~script14811(%arch_journal_context_tab_selected);
}
~script14821;
~script14823;
