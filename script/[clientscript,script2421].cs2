// 2421
[clientscript,script2421]
~script13990(peng_rak_engine_overlay:tools_bg, null, rs3tli_content_panel_black);
if_setmodel(peng_rak_panel_wrench_dark, peng_rak_engine_overlay:wrench);
if_setmodel(peng_rak_panel_wire_cutters_dark, peng_rak_engine_overlay:wirecutter);
if_setmodel(peng_rak_panel_spare_wire_dark, peng_rak_engine_overlay:sparewire);
if_setmodel(peng_rak_panel_tape_dark, peng_rak_engine_overlay:tape);
if_setmodel(peng_rak_panel_belows_dark, peng_rak_engine_overlay:bellows);
if (%peng_rak_eng_tutorial = 1) {
    if_setmodel(peng_rak_panel_wrench, peng_rak_engine_overlay:wrench);
    sound_synth(peng_rak_claw, 1, 0);
    if_sethide(true, peng_rak_engine_overlay:wirebox_cover);
} else if (%peng_rak_eng_tutorial = 2) {
    if_setmodel(peng_rak_panel_wire_cutters, peng_rak_engine_overlay:wirecutter);
    sound_synth(peng_rak_wire_cut, 1, 0);
    if_setmodel(peng_rak_panel_wires_cut, peng_rak_engine_overlay:wirebox);
} else if (%peng_rak_eng_tutorial = 3) {
    if_setmodel(peng_rak_panel_spare_wire, peng_rak_engine_overlay:sparewire);
    if_setmodel(peng_rak_panel_wires_wire, peng_rak_engine_overlay:wirebox);
} else if (%peng_rak_eng_tutorial = 4) {
    if_setmodel(peng_rak_panel_tape, peng_rak_engine_overlay:tape);
    sound_synth(peng_rak_tape, 1, 0);
    if_setmodel(peng_rak_panel_wires_tape, peng_rak_engine_overlay:wirebox);
} else if (%peng_rak_eng_tutorial = 5) {
    if_setmodel(peng_rak_panel_belows, peng_rak_engine_overlay:bellows);
    sound_synth(peng_rak_blow, 1, 0);
    if_sethide(false, peng_rak_engine_overlay:bellows_demo);
} else if (%peng_rak_eng_tutorial = 6) {
    if_setmodelanim(peng_rak_dial_left_orange, peng_rak_engine_overlay:gauge);
} else if (%peng_rak_eng_tutorial = 7) {
    if_setmodelanim(peng_rak_dial_left_yellow, peng_rak_engine_overlay:gauge);
} else if (%peng_rak_eng_tutorial = 8) {
    if_setmodelanim(peng_rak_dial_green, peng_rak_engine_overlay:gauge);
} else if (%peng_rak_eng_tutorial = 9) {
    if_setmodelanim(peng_rak_dial_right_yellow, peng_rak_engine_overlay:gauge);
} else if (%peng_rak_eng_tutorial = 10) {
    if_setmodelanim(peng_rak_dial_right_orange, peng_rak_engine_overlay:gauge);
} else if (%peng_rak_eng_tutorial = 11) {
    if_setmodelanim(peng_rak_dial_right_red, peng_rak_engine_overlay:gauge);
}
