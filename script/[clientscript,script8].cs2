// 8
[clientscript,script8]
switch_int (%quest_endgame_labyrinth_stage_section) {
    case 0 :
        if_setfill(true, quest_endgame_labyrinth_overlay:bottomleft);
        if_setfill(false, quest_endgame_labyrinth_overlay:topleft);
        if_setfill(false, quest_endgame_labyrinth_overlay:topright);
        if_setfill(false, quest_endgame_labyrinth_overlay:bottomright);
    case 1 :
        if_setfill(false, quest_endgame_labyrinth_overlay:bottomleft);
        if_setfill(true, quest_endgame_labyrinth_overlay:topleft);
        if_setfill(false, quest_endgame_labyrinth_overlay:topright);
        if_setfill(false, quest_endgame_labyrinth_overlay:bottomright);
    case 2 :
        if_setfill(false, quest_endgame_labyrinth_overlay:bottomleft);
        if_setfill(false, quest_endgame_labyrinth_overlay:topleft);
        if_setfill(true, quest_endgame_labyrinth_overlay:topright);
        if_setfill(false, quest_endgame_labyrinth_overlay:bottomright);
    case 3 :
        if_setfill(false, quest_endgame_labyrinth_overlay:bottomleft);
        if_setfill(false, quest_endgame_labyrinth_overlay:topleft);
        if_setfill(false, quest_endgame_labyrinth_overlay:topright);
        if_setfill(true, quest_endgame_labyrinth_overlay:bottomright);
    case default :
        if_setfill(false, quest_endgame_labyrinth_overlay:bottomleft);
        if_setfill(false, quest_endgame_labyrinth_overlay:topleft);
        if_setfill(false, quest_endgame_labyrinth_overlay:topright);
        if_setfill(false, quest_endgame_labyrinth_overlay:bottomright);
}
