// 9734
[clientscript,rand_overlay_ontimer](int $int0)
if (%rand_party_floor_time = -1) {
    if_setontimer(null, rand_overlay:floor_timer);
    return;
}
if (calc($int0 % 50) = 0) {
    %rand_party_floor_time = calc(%rand_party_floor_time + 1);
    ~script9735;
}
if_setontimer("rand_overlay_ontimer(calc($int0 + 1))", rand_overlay:floor_timer);
