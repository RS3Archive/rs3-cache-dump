// 14044
[proc,script14044]
if_setonmouseover("graphic_swapper(escape_menu:csat_positive, \"csat_rating_postive,1\")", escape_menu:csat_positive);
if_setonmouseover("graphic_swapper(escape_menu:csat_negative, \"csat_rating_negative,1\")", escape_menu:csat_negative);
switch_int (%varclientbit_39858) {
    case 0 :
        if_setonmouseleave("graphic_swapper(escape_menu:csat_positive, \"csat_rating_postive,2\")", escape_menu:csat_positive);
        if_setonmouseleave("graphic_swapper(escape_menu:csat_negative, \"csat_rating_negative,2\")", escape_menu:csat_negative);
    case 1 :
        if_setonmouseleave("graphic_swapper(escape_menu:csat_positive, \"csat_rating_postive,2\")", escape_menu:csat_positive);
        if_setonmouseleave("graphic_swapper(escape_menu:csat_negative, \"csat_rating_negative,0\")", escape_menu:csat_negative);
    case 2 :
        if_setonmouseleave("graphic_swapper(escape_menu:csat_positive, \"csat_rating_postive,0\")", escape_menu:csat_positive);
        if_setonmouseleave("graphic_swapper(escape_menu:csat_negative, \"csat_rating_negative,2\")", escape_menu:csat_negative);
}
