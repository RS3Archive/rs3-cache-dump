switch_int (%varclientbit_39858) {
    case 0 :
        if_setonmouseleave("graphic_swapper(interface_1433:com_56, \"csat_rating_postive,2\")", interface_1433:com_56);
        if_setonmouseleave("graphic_swapper(interface_1433:com_57, \"csat_rating_negative,2\")", interface_1433:com_57);
    case 1 :
