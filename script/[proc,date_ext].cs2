// 12832
[proc,date_ext](int $int0)(string)
if (map_lang = 3) {
    if ($int0 = 1) {
        return("<tostring($int0)>º");
    } else {
        return(tostring($int0));
    }
}
if ($int0 >= 11 & $int0 <= 13) {
    return("<tostring($int0)>th");
}
switch_int (calc($int0 % 10)) {
    case 1 :
        return("<tostring($int0)>st");
    case 2 :
        return("<tostring($int0)>nd");
    case 3 :
        return("<tostring($int0)>rd");
    case default :
        return("<tostring($int0)>th");
}
