// 13002
[proc,bonds_singletime_purchase_plugin](dbrow $dbrow0, int $int1, int $int2)(int)
switch_dbrow ($dbrow0) {
    case bonds_yak_track_premier_pass :
        if ($int2 = 0) {
            return(%bonds_temp_purchase_yak_track_premier_pass);
        } else {
            %bonds_temp_purchase_yak_track_premier_pass = 1;
        }
    case bonds_daily_keys_1_key_28_days :
        if ($int2 = 0) {
            return(%mtx_daily_keys_stipend_mar2017_purchased);
        } else {
            %mtx_daily_keys_stipend_mar2017_purchased = 1;
        }
    case bonds_mhaw_may21_bundle :
        if ($int2 = 0) {
            return(%bonds_mhaw_may21_bundle_purchased);
        } else {
            %bonds_mhaw_may21_bundle_purchased = 1;
        }
    case bonds_event_rsraffle_catchup :
        if ($int2 = 0) {
            return(%bonds_events_rsraffle_catchup_purchased);
        } else {
            %bonds_events_rsraffle_catchup_purchased = 1;
        }
    case bonds_wmh_oct21_bundle :
        if ($int2 = 0) {
            return(%bonds_wmh_oct21_bundle_purchased);
        } else {
            %bonds_wmh_oct21_bundle_purchased = 1;
        }
    case bond_package_bank_booster_bundle, bond_package_bank_booster_bundle_sale :
        if ($int2 = 0) {
            return(%bonds_temp_purchase_bank_booster_bundle);
        } else {
            %bonds_temp_purchase_bank_booster_bundle = 1;
        }
    case bond_package_callista_bundle :
        if ($int2 = 0) {
            return(%bonds_temp_purchase_callista_bundle);
        } else {
            %bonds_temp_purchase_callista_bundle = 1;
        }
    case bond_package_tztot_bundle :
        if ($int2 = 0) {
            return(%bonds_temp_purchase_tztot_bundle);
        } else {
            %bonds_temp_purchase_tztot_bundle = 1;
        }
    case bonds_bp3_premier_pass_bundle, bonds_bp3_premier_pass :
        if ($int2 = 0) {
            return(%bonds_temp_purchase_bp3_premier_pass);
        } else {
            %bonds_temp_purchase_bp3_premier_pass = 1;
        }
    case bond_package_small_bank_and_preset_booster_bundle_members, bond_package_small_bank_and_preset_booster_bundle_f2p, bond_package_small_bank_and_preset_booster_bundle_members_sale, bond_package_small_bank_and_preset_booster_bundle_f2p_sale :
        if ($int2 = 0) {
            return(%mtx54_bank_space_unlocked15);
        } else {
            %mtx54_bank_space_unlocked15 = 1;
        }
    case bond_package_xmas23_wrapping_paper :
        if ($int2 = 0) {
            return(%bonds_temp_purchase_xmas23_wrapping_paper);
        } else {
            %bonds_temp_purchase_xmas23_wrapping_paper = 1;
        }
    case bond_package_dxp_item_bundle :
        if ($int2 = 0) {
            return(%bonds_temp_purchase_dxp_item_bundle);
        } else {
            %bonds_temp_purchase_dxp_item_bundle = 1;
        }
    case bond_package_dxp_daily_bundle :
        if ($int2 = 0) {
            return(%bonds_temp_purchase_dxp_daily_bundle);
        } else {
            %bonds_temp_purchase_dxp_daily_bundle = 1;
        }
    case bond_package_easter24_currency_booster :
        if ($int2 = 0) {
            return(%bonds_temp_purchase_easter24_currency_booster);
        } else {
            %bonds_temp_purchase_easter24_currency_booster = 1;
        }
    case bond_package_easter24_bunny_ears :
        if ($int2 = 0) {
            return(%bonds_temp_purchase_easter24_bunny_ears);
        } else if (~script18801 = false) {
            %bonds_temp_purchase_easter24_bunny_ears = 1;
        }
    case bonds_passcode_membership14 :
        if ($int2 = 0) {
            if (~script2102 = false) {
                return(1);
            } else {
                return(0);
            }
        } else {
            %bonds_temp_purchase_passcode_membership14_weekly_cap = calc(%bonds_temp_purchase_passcode_membership14_weekly_cap + 1);
        }
    case bond_package_dxp_protean_bundle :
        if ($int2 = 0) {
            return(%bonds_temp_purchase_dxp_protean_bundle);
        }
    case default :
        ~error("Missing plugin into bonds_singletime_purchase_plugin, at title <db_getfield($dbrow0, bonds_package:col0, 0)>");
}
