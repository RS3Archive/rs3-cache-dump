// 8866
[clientscript,bank_cert_click](component $component0, component $component1)
if (%bankcert = 0) {
    %bankcert = 1;
    sound_vorbis_rate(page_turn, 1, 0, 100, 350);
} else {
    %bankcert = 0;
    sound_vorbis_volume(tli_click_01, 1, 0, 100);
}
~bank_cert_button($component0, $component1);
