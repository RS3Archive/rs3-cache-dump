// 8866
[clientscript,bank_cert_click](component $component0, component $component1)
if (%varplayer_160 = 0) {
    %varplayer_160 = 1;
    sound_vorbis_rate(sound_3550, 1, 0, 100, 350);
} else {
    %varplayer_160 = 0;
    sound_vorbis_volume(sound_36961, 1, 0, 100);
}
~bank_cert_button($component0, $component1);
