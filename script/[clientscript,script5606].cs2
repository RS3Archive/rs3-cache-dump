// 5606
[clientscript,script5606]
if_settext(tostring(%xmas11_frumscone_score_client), xmas11_snowman_scoreboard:xmas11_snowman_scoreboard_frumscone_score);
if_settext(tostring(%xmas11_grayzag_score_client), xmas11_snowman_scoreboard:xmas11_snowman_scoreboard_grayzag_score);
if (%xmas11_grayzag_state = true) {
    if_settext("Whitezag", xmas11_snowman_scoreboard:xmas11_snowman_scoreboard_grayzag);
} else {
    if_settext("Grayzag", xmas11_snowman_scoreboard:xmas11_snowman_scoreboard_grayzag);
}
