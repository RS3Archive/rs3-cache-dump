// 14610
[proc,arch_relic_get_description](dbrow $dbrow0)(string)
switch_dbrow ($dbrow0) {
    case arch_relic_font_of_life :
        if (%toplevel_v2_legacy_combat = 1) {
            return("Increases maximum health by 50.");
        } else {
            return("Increases maximum health by 500.");
        }
}
return(db_getfield($dbrow0, arch_relic:col2, 0));
