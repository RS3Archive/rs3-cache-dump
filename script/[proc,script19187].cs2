// 19187
[proc,script19187](struct $struct0, obj $obj1, component $component2)
switch_struct ($struct0) {
    case trh182_promo :
        ~script17014($component2, "Kill this monster to win: <oc_name($obj1)>!");
    case trh203_promo :
        ~script17014($component2, "Complete this skilling location to win: <oc_name($obj1)>!");
    case trh207_promo :
        ~script17014($component2, "Complete this encounter to win: <oc_name($obj1)>!");
}
