// 6872
[clientscript,script6872](int $int0, int $int1)
if (cc_find(oct_event_if:text_layer, $int0) = true) {
    if ($int1 = 1) {
        cc_setcolour(^white);
    } else {
        cc_setcolour(^red);
    }
}
if (cc_find(oct_event_if:text_layer, calc($int0 + 1)) = true) {
    if ($int1 = 1) {
        cc_setcolour(^white);
    } else {
        cc_setcolour(^red);
    }
}
if (cc_find(oct_event_if:text_layer, calc($int0 + 2)) = true) {
    if ($int1 = 1) {
        cc_setcolour(^white);
    } else {
        cc_setcolour(^red);
    }
}
~deltooltip_action(oct_event_if:tooltip_layer);
