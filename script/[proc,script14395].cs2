// 14395
[proc,script14395](inv $inv0, obj $obj1)
if ($obj1 = null) {
    cc_clearops;
    cc_clearscripthooks;
} else {
    ~script14420($obj1);
    cc_setop(1, "Remove");
    cc_setop(10, "Examine");
    cc_setonmouserepeat("script14392($obj1, $inv0, event_com, event_comsubid)");
    cc_setonop("script14393($inv0, event_com, event_comsubid, event_op)");
    cc_setondragcomplete("script14394($inv0, event_com, event_comsubid, event_com2, event_comsubid2)");
    cc_setdraggable(bank:preset_inventory_layer, 1);
}
