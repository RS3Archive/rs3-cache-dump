// 2492
[proc,script2492](int $int0, int $int1)(string)
def_int $int2 = calc($int0 % 10);
def_int $int3 = calc($int0 / 10 % 10);
switch_int (map_lang) {
    case 0 :
        if ($int3 = 1) {
            return("th");
        } else if ($int2 = 1) {
            return("st");
        } else if ($int2 = 2) {
            return("nd");
        } else if ($int2 = 3) {
            return("rd");
        } else {
            return("th");
        }
    case 1 :
        return(".");
    case 2 :
        if ($int0 = 1) {
            if ($int1 = 1) {
                return("re");
            } else {
                return("er");
            }
        }
        return("e");
    case 3, 6 :
        if ($int1 = 1) {
            return("a");
        } else {
            return("o");
        }
}
