// 10585
[proc,script10585](component $component0, int $int1, int $int2)
cc_deleteall($component0);
cc_create($component0, ^iftype_graphic, 0);
def_int $int3 = min(if_getwidth($component0), if_getheight($component0));
cc_setgraphic(rs3_loading_spinner_child);
cc_setsize($int3, $int3, ^setsize_abs, ^setsize_abs);
cc_setposition(0, 0, ^setpos_abs_centre, ^setpos_abs_centre);
cc_settrans(255);
cc_setparam(spinner_target_transparency, 255);
cc_set2dangle(calc((0 - 1872) * (clientclock % (65536 / 1872))));
cc_setontimer("spinner_update(event_com)");
