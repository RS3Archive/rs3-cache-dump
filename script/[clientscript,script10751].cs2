// 10751
[clientscript,script10751]
if_sethide(true, house_keyhole_overlay:house_keyhole_enter_button_legacy);
if_sethide(true, house_keyhole_overlay:house_keyhole_back_button_legacy);
if_sethide(false, house_keyhole_overlay:house_keyhole_enter_button);
if_sethide(false, house_keyhole_overlay:house_keyhole_back_button);
