// 7949
[clientscript,worldmap_v2_ontimer]
if (%worldmap_v2_zoom_current_height = %worldmap_v2_zoom_target_height) {
    return;
}
if (%worldmap_v2_zoom_current_height < %worldmap_v2_zoom_target_height) {
    %worldmap_v2_zoom_current_height = min(%worldmap_v2_zoom_target_height, calc(%worldmap_v2_zoom_current_height + %worldmap_v2_zoom_rate));
} else if (%worldmap_v2_zoom_current_height > %worldmap_v2_zoom_target_height) {
    %worldmap_v2_zoom_current_height = max(%worldmap_v2_zoom_target_height, calc(%worldmap_v2_zoom_current_height - %worldmap_v2_zoom_rate));
}
~script7952;
