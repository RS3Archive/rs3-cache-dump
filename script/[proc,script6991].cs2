// 6991
[proc,script6991]()(int)
if (inv_totalparam(worn, njslay_is_a_slayer_helmet) > 0) {
    if (inv_totalparam(worn, njslay_tier1_helmet) > 0 | inv_totalparam(worn, njslay_tier2_helmet) > 0 | inv_totalparam(worn, njslay_tier3_helmet) > 0 | inv_totalparam(worn, njslay_tier4_helmet) > 0) {
        return(0);
    }
    return(1);
}
return(0);
