// 14169
[proc,interface_zoom_set_modal]
if (if_gethide(toplevel_v2_mobile:inv_drag_options_window) = false) {
    if_sethide(true, toplevel_v2_mobile:inv_drag_options_window);
}
if (~script4550(mobile_destroy) = true) {
    return;
} else if (~script4550(lighttemple_piller) = true) {
    return;
} else if (~script4550(modal_confirm) = true & %mobile_zoom = 0) {
    return;
}
~interface_zoom_set(1, ~script14197, toplevel_v2:moveable_modal_windows);
