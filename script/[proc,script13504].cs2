// 13504
[proc,script13504](int $int0)(stat, stat)
switch_int ($int0) {
    case 1 :
        return(construction, thieving);
    case 2 :
        return(runecraft, summoning);
    case 3 :
        return(crafting, agility);
    case 4 :
        return(smithing, mining);
    case 5 :
        return(fishing, farming);
    case 6 :
        return(fletching, woodcutting);
    case 7 :
        return(firemaking, cooking);
    case 8 :
        return(hunter, herblore);
}
~error("Effigy was not valid type. Type = <tostring($int0)>.");
return(null, null);
