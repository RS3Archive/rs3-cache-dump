// 3402
[clientscript,script3402](component $component0, int $int1, int $int2, int $int3)
def_int $int4 = calc($int3 - clientclock);
if (cc_find($component0, $int1) = true) {
    if ($int4 <= 0) {
        cc_settrans(0);
        cc_setontimer(null);
        return;
    }
    cc_settrans(max(calc(cc_gettrans - cc_gettrans / $int4), 1));
}
