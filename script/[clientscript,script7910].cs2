// 7910
[clientscript,script7910](int $int0, int $int1, component $component2)
if (clientclock < $int0) {
    return;
}
switch_int ($int1) {
    case 0 :
        if_setgraphic("rs3_login_throbber_small,0", $component2);
    case 1 :
        if_setgraphic("rs3_login_throbber_small,1", $component2);
    case 2 :
        if_setgraphic("rs3_login_throbber_small,2", $component2);
    case 3 :
        if_setgraphic("rs3_login_throbber_small,3", $component2);
    case 4 :
        if_setgraphic("rs3_login_throbber_small,4", $component2);
    case 5 :
        if_setgraphic("rs3_login_throbber_small,5", $component2);
    case 6 :
        if_setgraphic("rs3_login_throbber_small,6", $component2);
    case 7 :
        if_setgraphic("rs3_login_throbber_small,7", $component2);
}
if (++$int1 = 8) {
    $int1 = 0;
}
if_setontimer("script7910(calc(clientclock + 10), $int1, $component2)", $component2);
