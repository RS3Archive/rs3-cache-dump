// 4289
[clientscript,clansettings_onload]
if (%clansettings_clanmate_filter_rank_plus_1 = -1) {
    %clansettings_clanmate_filter_rank_plus_1 = 0;
}
if (activeclansettings_find_affined(0) = true) {
    ~script4291;
} else {
    if_setonclansettingstransmit("script4290", clansettings:mainmodal_window_content);
    return;
}
~clansettings_interface_refresh;
