// 5426
[clientscript,script5426]
%dom_easter_xpos = calc(%dom_easter_xpos - 2);
if (%dom_easter_xpos > -60) {
    if_setposition(%dom_easter_xpos, 0, ^setpos_abs_left, ^setpos_abs_centre, dom_battle_overlay:easter_egg_notification_layer);
} else {
    if_setontimer(null, dom_battle_overlay:global_layer);
    if_sethide(true, dom_battle_overlay:easter_egg_notification_layer);
}
