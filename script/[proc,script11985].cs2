// 11985
[proc,script11985](string $string0, int $int0)
if ($int0 <= clientclock) {
    if (compare(%p_dialog_input, $string0) ! 0) {
        ~friendschatsetup_search_filter(%p_dialog_input);
        ~script11957(%friendschat_sort_mode, %p_dialog_input);
    }
    $string0 = %p_dialog_input;
    $int0 = calc(clientclock + 25);
