// 17681
[clientscript,script17681]
if (%overload_type = 0) {
    if (stat(necromancy) > stat_base(necromancy)) {
        ~script10624(combatv2_necromancy_boosted_dummy_ability, 1);
        ~script10624(combatv2_necromancy_nerfed_dummy_ability, 0);
        return;
    } else if (stat(necromancy) < stat_base(necromancy)) {
        ~script10624(combatv2_necromancy_boosted_dummy_ability, 0);
        ~script10624(combatv2_necromancy_nerfed_dummy_ability, 1);
        return;
    }
}
~script10624(combatv2_necromancy_boosted_dummy_ability, 0);
~script10624(combatv2_necromancy_nerfed_dummy_ability, 0);
