def_int $int4 = 0;
def_int $int5 = 0;
def_int $int6 = 0;
def_obj $obj7 = null;
def_string $string0 = "";
cc_deleteall($component0);
while ($int2 < $int1) {
    $int4 = calc(41 * ($int2 % 5));
    $int5 = calc(37 * ($int2 / 5));
    $obj7 = enum(int, obj, dino_reward_herb_bag_herbs, $int2);
    $int3 = ~script6645($obj7);
