// 2220
[proc,script2220]
~static_checkbox(easter10_resourcegame:fc_repair_tick, ~bool_to_int(%easter10_fcrepair), ~int_to_bool(%easter10_incubator_status));
~static_checkbox(easter10_resourcegame:tegg_repair_tick, ~bool_to_int(%easter10_teggrepair), ~int_to_bool(%easter10_painter_status));
~static_checkbox(easter10_resourcegame:negg_repair_tick, ~bool_to_int(%easter10_neggrepair), ~int_to_bool(%easter10_conveyor_status));
if_settext(tostring(%easter10_nutworkers), easter10_resourcegame:nuts_workers_text);
if_settext(tostring(%easter10_chocworkers), easter10_resourcegame:choc_workers_text);
if_settext(tostring(%easter10_fruitworkers), easter10_resourcegame:fruit_workers_text);
if_settext(tostring(%easter10_fcworkers), easter10_resourcegame:fc_workers_text);
if_settext(tostring(%easter10_teggworkers), easter10_resourcegame:tegg_workers_text);
if_settext(tostring(%easter10_neggworkers), easter10_resourcegame:negg_workers_text);
if_settext("Total Workers: <tostring(%easter10_totalworkers)>", easter10_resourcegame:totalworkers_text);
if_settext("<tostring(%easter10_resourcegame_totalnuts)>/15", easter10_resourcegame:nut_stock_text);
if_settext("<tostring(%easter10_resourcegame_totalfruit)>/15", easter10_resourcegame:fruit_stock_text);
if_settext("<tostring(%easter10_resourcegame_totalchoc)>/15", easter10_resourcegame:choc_stock_text);
if_settext("<tostring(%easter10_resourcegame_totalfc)>/7", easter10_resourcegame:fc_stock_text);
if_settext("<tostring(%easter10_resourcegame_totaltegg)>/7", easter10_resourcegame:tegg_stock_text);
if_settext("<tostring(%easter10_resourcegame_totalnegg)>/7", easter10_resourcegame:negg_stock_text);
~script2221;
if_settext("Turn <tostring(%easter10_resourcegame_turncount)>/15", easter10_resourcegame:turn_text);
