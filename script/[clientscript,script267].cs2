// 267
[clientscript,script267](component $component0)
def_coord $coord1 = ~script284(coord);
switch_int (%tutorial3_cutscene_tracker) {
    case 0 :
        ~tutorial3_fadeout(^black, 0, $component0);
    case 1 :
        ~tutorial3_fadein(50, $component0);
        spline_new(0, 4);
        spline_new(1, 4);
        spline_addpoint(0, 0, movecoord($coord1, 33, 0, 18), 326, movecoord($coord1, 31, 0, 20), 326, 0);
        spline_addpoint(1, 0, movecoord($coord1, 32, 0, 15), 300, movecoord($coord1, 32, 0, 15), 300, 0);
