// 5322
[clientscript,script5322](component $component0)
switch_component ($component0) {
    case clan_keep_theatre_backdrop:greenscreen_selected :
        %clan_keep_theatre_backdrop_varp = 1;
        ~script5324(1);
    case clan_keep_theatre_backdrop:cave_button :
        %clan_keep_theatre_backdrop_varp = 2;
        ~script5324(2);
    case clan_keep_theatre_backdrop:crypt_button :
        %clan_keep_theatre_backdrop_varp = 3;
        ~script5324(3);
    case clan_keep_theatre_backdrop:forest_button :
        %clan_keep_theatre_backdrop_varp = 4;
        ~script5324(4);
    case clan_keep_theatre_backdrop:ocean_button :
        %clan_keep_theatre_backdrop_varp = 5;
        ~script5324(5);
    case clan_keep_theatre_backdrop:hills_button :
        %clan_keep_theatre_backdrop_varp = 6;
        ~script5324(6);
    case clan_keep_theatre_backdrop:room_button :
        %clan_keep_theatre_backdrop_varp = 7;
        ~script5324(7);
    case clan_keep_theatre_backdrop:village_button :
        %clan_keep_theatre_backdrop_varp = 8;
        ~script5324(8);
}
