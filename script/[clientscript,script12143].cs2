// 12143
[clientscript,script12143](int $int0, int $int1)
if (clientclock < $int1) {
    return;
}
if ($int0 = 1) {
    if_sethide(true, invent_discovery:lightbulb_model);
    if_sethide(false, invent_discovery:lightbulb_cracked_model);
    if_setmodelanim(invent_discovery_lightbulb_blowup_fail, invent_discovery:lightbulb_cracked_model);
    sound_vorbis_rate(invent_prototype_fail, 1, 0, 240, 350);
} else {
    if_setmodelanim(invent_discovery_lightbulb_bright_glow, invent_discovery:lightbulb_model);
    sound_vorbis_rate(invent_prototype_success, 1, 0, 240, 270);
}
if_setontimer(null, invent_discovery:workbench_overlay);
