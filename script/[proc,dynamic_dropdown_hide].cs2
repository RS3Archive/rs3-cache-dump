// 10444
[proc,dynamic_dropdown_hide]
def_component $component0 = interface_1477:com_892;
def_component $component1 = interface_1477:com_897;
switch_toplevelinterface (if_gettop) {
    case default :
        $component0 = interface_1477:com_892;
        $component1 = interface_1477:com_897;
    case interface_906 :
        $component0 = interface_906:com_159;
        $component1 = interface_906:com_164;
    case interface_744 :
        $component0 = interface_744:com_350;
        $component1 = interface_744:com_355;
}
if (if_find($component0) = true) {
    cc_sethide(true);
    cc_setontimer(null);
    cc_setparam(param_4514, true);
    cc_setparam(param_4516, null);
    cc_setparam(param_4518, -1);
    cc_setparam(param_4517, null);
    cc_setparam(param_4515, false);
}
cc_deleteall($component1);
