// 18767
[clientscript,script18767]
def_int $int0 = calc(if_getwidth(combatv2_channel_bar:bar_progress_layer) - 2 * 1);
def_int $int1 = min(scale(calc(clientclock - %combatv2_channel_start_client), calc(%combatv2_channel_end_client - %combatv2_channel_start_client), $int0), $int0);
def_int $int2 = 2;
switch_int (%combatv2_channel_mode_client) {
    case 0 :
        $int2 = calc($int2 - 1);
    case 1 :
        $int1 = calc($int0 - $int1);
}
if_setsize($int1, 0, ^setsize_minus, ^setsize_minus, combatv2_channel_bar:bar_mask_layer);
~script18771(calc((%combatv2_channel_end_client - clientclock + 30 - 1) / 30));
if_setposition(calc($int2 + $int1), 0, ^setpos_abs_right, ^setpos_abs_centre, combatv2_channel_bar:bar_indicator_layer);
