// 1392
[proc,script1392](int $int0)
if ($int0 = 1) {
    if_sethide(true, slide_puzzle:puzzle_layer);
    if_sethide(true, slide_puzzle:puzzle_check);
    if_sethide(false, slide_puzzle:puzzle_hint);
} else {
    if_sethide(false, slide_puzzle:puzzle_layer);
    if_sethide(false, slide_puzzle:puzzle_check);
    if_sethide(true, slide_puzzle:puzzle_hint);
}
