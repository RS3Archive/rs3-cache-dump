// 6513
[proc,script6513]()(string)
def_string $string0 = "Last Chance";
def_string $string1 = tostring(calc(%varclient_6567 / 60));
def_string $string2 = tostring(calc(%varclient_6567 % 60));
def_string $string3 = tostring(calc(59 - %varclient_6568));
if (calc(%varclient_6567 + 1) > 0) {
    if (string_length($string1) = 1) {
        $string1 = append("0", $string1);
    }
    if (string_length($string2) = 1) {
        $string2 = append("0", $string2);
    }
    if (string_length($string3) = 1) {
        $string3 = append("0", $string3);
    }
    $string0 = "<col=CDE1FF><$string1> : <$string2> : <$string3>";
}
return($string0);
