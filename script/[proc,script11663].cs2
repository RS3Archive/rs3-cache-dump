// 11663
[proc,script11663]
def_component $component0 = mtxmgt_purchase:bonds_layer;
def_component $component1 = mtxmgt_purchase:bonds_bg_layer;
def_component $component2 = mtxmgt_purchase:bonds_content_layer;
def_component $component3 = mtxmgt_purchase:bonds_button_layer;
def_component $component4 = mtxmgt_purchase:buy_bonds_button_layer;
def_component $component5 = mtxmgt_purchase:ge_bonds_button_layer;
def_component $component6 = mtxmgt_purchase:buy_runecoins_button_layer;
cc_deleteall($component2);
def_int $int7 = -1;
def_int $int8 = calc(%mtxmgt_total_tradeable_bonds + %mtxmgt_total_untradeable_bonds);
if ($int7 ! -1) {
    ~script10812($component2, $component6, rs3_icon_bonds_tradeable, rs3_icon_bonds_untradeable, 34, 35, "Bonds", $int7, $int8, 2);
    if_sethide(true, $component5);
    if ($int8 < $int7) {
        if_sethide(false, $component4);
        if_sethide(true, $component3);
    } else {
        if_sethide(true, $component4);
        if_sethide(false, $component3);
    }
    ~rs3_background_panel($component1, rs3_content_container_active);
    if_sethide(false, $component0);
    if_setonvarctransmit("script11662{mtxmgt_total_tradeable_bonds, mtxmgt_total_untradeable_bonds}", $component0);
} else {
    if_sethide(true, $component0);
    if_setonvarctransmit(null, $component0);
}
