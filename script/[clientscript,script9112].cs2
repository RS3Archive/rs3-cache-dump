// 9112
[clientscript,script9112](component $component0)
def_string $string0 = "";
if (calc(^max_32bit_int / 5) < %wishing_well_client_bond_tracker) {
    $string0 = "Over $2 Bil";
} else {
    $string0 = "$<tostring_localised(scale(500, 100, %wishing_well_client_bond_tracker), true)>";
}
def_int $int1 = calc(%wishing_well_client_million_tracker / 3);
~script8800("Total charity donation:<br>$<tostring_localised($int1, true)> US$ from coins<br><$string0> US$ from Bonds", $component0, -1);
