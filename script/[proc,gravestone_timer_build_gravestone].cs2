def_int $int1 = calc($int0 / 60);
$int0 = calc($int0 - $int1 * 60);
def_string $string0 = ~script3382(-1, -1, $int1, $int0, 5, 0);
~script17116(false, true, death_grave_icon, $string0, "Time until gravestone collapses");
