// 393
[clientscript,script393]
if_sethide(true, conq_side_turn:time_left_layer);
if_settext("Command Options", conq_side_turn:main_title_text);
if_setposition(0, 133, ^setpos_abs_left, ^setpos_abs_top, conq_side_turn:gery_rectangle);
if_setsize(190, 116, ^setsize_abs, ^setsize_abs, conq_side_turn:gery_rectangle);
if_settext("Comm Orb Recharging", conq_side_turn:opponents_turn_text);
if_setposition(0, 133, ^setpos_abs_left, ^setpos_abs_top, conq_side_turn:opponents_turn_text);
if_setsize(190, 116, ^setsize_abs, ^setsize_abs, conq_side_turn:opponents_turn_text);
if_settextalign(^settextalign_centre, ^settextalign_centre, 0, conq_side_turn:opponents_turn_text);
if_setposition(30, 152, ^setpos_abs_left, ^setpos_abs_top, conq_side_turn:turn_control_layer);
if_settext("Recharge", conq_side_turn:neutral_button_text_1);
if_setop(1, "Recharge", conq_side_turn:neutral_button_text_1);
if_sethide(true, conq_side_turn:opponents_turn_layer);
if_sethide(true, conq_side_diplomacy:ignore_truce_layer);
if_settext("Retreat", conq_side_diplomacy:main_title_text);
if_sethide(true, conq_side_diplomacy:offer_truce_button_layer);
if_settext("Retreat", conq_side_diplomacy:resign_text);
if_setop(1, "Retreat", conq_side_diplomacy:resign_button);
if_setposition(30, 0, ^setpos_abs_left, ^setpos_abs_centre, conq_side_diplomacy:negative_button_layer);
if_setposition(0, 50, ^setpos_abs_left, ^setpos_abs_centre, conq_side_diplomacy:resign_instructions);
if_settext("Force Savant to teleport you to safety and order your remaining troops to fall back.", conq_side_diplomacy:resign_instructions);
