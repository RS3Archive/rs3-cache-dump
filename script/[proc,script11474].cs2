// 11474
[proc,script11474]()(string)
def_int $int0 = scale(60, 100, nc_param(enum(int, npc, gravestone_npc, %gravestone_type), gravestone_initialduration));
def_int $int1 = calc($int0 / 60);
def_int $int2 = calc($int0 % 60);
if ($int2 >= 10) {
    return("Gravestone:<br><enum(int, string, gravestone_name, %gravestone_type)><br><br>Initial duration:<br><tostring($int1)>:<tostring($int2)>");
} else if ($int2 > 0) {
    return("Gravestone:<br><enum(int, string, gravestone_name, %gravestone_type)><br><br>Initial duration:<br><tostring($int1)>:0<tostring($int2)>s");
} else {
    return("Gravestone:<br><enum(int, string, gravestone_name, %gravestone_type)><br><br>Initial duration:<br><tostring($int1)>:00");
}
