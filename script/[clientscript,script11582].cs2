// 11582
[clientscript,script11582]
~script11587(true);
if_settext("Challenge Gem - Combat Competition", mtx91_challenge_setup:skilling_title);
if_settext("Enemy combat level range", mtx91_challenge_setup:skilling_skill_select_text);
if_settext("Player combat level range", mtx91_challenge_setup:skilling_level_range);
if_settext(tostring(%mtx91_challenge_player_min_level_temp), mtx91_challenge_setup:text_input_display_min);
if_settext(tostring(%mtx91_challenge_player_max_level_temp), mtx91_challenge_setup:text_input_display_max);
if_sethide(true, mtx91_challenge_setup:skilling_skill_select);
if_sethide(false, mtx91_challenge_setup:text_input_box_mob_min_level);
if_sethide(false, mtx91_challenge_setup:text_input_box_mob_max_level);
if_sethide(false, mtx91_challenge_setup:wilderness);
if_sethide(false, mtx91_challenge_setup:wilderness_checkbox);
if_sethide(false, mtx91_challenge_setup:pvp_only);
if_sethide(false, mtx91_challenge_setup:pvp_checkbox);
if_sethide(false, mtx91_challenge_setup:info_holder_active_3);
def_string $string0 = "The minimum and maximum combat level of the enemies you need to kill in this competition.";
def_string $string1 = "Enter the minimum player combat level that can enter this competition.";
def_string $string2 = "Enter the maximum player combat level that can enter this competition.";
if_setonmouserepeat("script8799($string0, event_com, -1)", mtx91_challenge_setup:skilling_skill_select_text);
if_setonmouserepeat("script8799($string1, event_com, -1)", mtx91_challenge_setup:text_input_display_min);
if_setonmouserepeat("script8799($string2, event_com, -1)", mtx91_challenge_setup:text_input_display_max);
