// 21090
[proc,script21090](dbrow $dbrow0, int $int1)(graphic)
switch_int (%leagues_parent_relics_selected_type) {
    case 1 :
        if (~script20943($dbrow0) = 1) {
            switch_int ($int1) {
                case 0 :
                    return("league_2_combat_god_chaos,1");
                case 1 :
                    return("league_2_combat_god_relic_base,1");
                case 2 :
                    return("league_2_combat_god_order,1");
                case default :
                    error("Unexpected $relic_pos. Expected 0-2 but received : <tostring($int1)>");
                    return("league_2_combat_god_relic_base,1");
            }
        }
        switch_int ($int1) {
            case 0 :
                return("league_2_combat_base_chaos,1");
            case 1 :
                return("league_2_combat_relic_base,1");
            case 2 :
                return("league_2_combat_base_order,1");
            case default :
                error("Unexpected $relic_pos. Expected 0-2 but received : <tostring($int1)>");
                return("league_2_combat_relic_base,1");
        }
    case 0 :
        return("league_2_relic_base,1");
}
