        ~cc_add_child_rect(1, $int0, 0, $int1, ^setpos_abs_left, ^setpos_abs_top, 0, 30, ^setsize_minus, ^setsize_abs, rect_medium);
        if (%group_ironman_creator = 1 & $int2 = 0) {
            cc_setop(1, "Invite to Group");
            cc_setopcursor(1, cursor_search);
        }
        if ($int0 = 1) {
            $graphic3 = rs3_icon_ironman_group_status_leader_key;
        } else if ($int2 = 1) {
            $graphic3 = "rs3_icon_ironman_group_status_founder,3";
        } else if (%group_ironman_creator = 1) {
