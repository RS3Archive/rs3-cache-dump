// 19418
[proc,script19418]
def_int $int0 = 0;
def_int $int1 = 0;
def_string $string0 = "";
def_int $int2 = 0;
def_graphic $graphic3 = null;
cc_deleteall(group_ironman_create:members);
if (if_find(group_ironman_create:members) = true) {
    while (++$int0 <= 5) {
        switch_int ($int0) {
            case 1 :
                $string0 = %group_ironman_cache_p1_name_client;
            case 2 :
                $string0 = %group_ironman_cache_p2_name_client;
            case 3 :
                $string0 = %group_ironman_cache_p3_name_client;
            case 4 :
                $string0 = %group_ironman_cache_p4_name_client;
