        cc_settextalign(^settextalign_left, ^settextalign_centre, 0);
        cc_setmaxlines(1);
        ~script3537($string0);
        if (%group_ironman_creator = 1 & $int2 = 1 & $int0 > 1) {
            ~cc_add_child_button(4, $int0, 5, calc($int1 + 3), ^setpos_abs_right, ^setpos_abs_top, 75, 24, ^setsize_abs, ^setsize_abs, button_cornered_neutral, "Remove");
            cc_settextfont(notosans_13);
