// 653
[proc,script653](int $int0, int $int1)(int)
def_int $int2 = calc($int0 * (11 + 11 + 5 + 3));
switch_int ($int1) {
    case 1 :
        return(calc($int2 + 11 + 11));
    case 2 :
        return(calc($int2 + 11 + 11 + 3));
    case 3 :
        return(calc($int2 + 11 + 11 + 5 + 1));
    case default :
        return($int2);
}
