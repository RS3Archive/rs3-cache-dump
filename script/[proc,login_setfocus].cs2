// 15651
[proc,login_setfocus](int $int0)
if (%loginscreen_focus ! $int0) {
    %loginscreen_focus = $int0;
    switch_int (%loginscreen_focus) {
        case 100 :
            if_sendtofront(loginscreen:username_input_group_graphic_active);
        case 101 :
            if_sendtofront(loginscreen:password_input_group_graphic_active);
        case 114 :
            if_sendtofront(loginscreen:auth_input_group_graphic_active);
    }
}
