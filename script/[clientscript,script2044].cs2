// 2044
[clientscript,script2044]
if_sethide(true, target:dart_bull);
if_sethide(true, target:dart_1);
if_sethide(true, target:dart_2);
if_sethide(true, target:dart_3);
if_sethide(true, target:dart_4);
if_sethide(true, target:dart_5);
