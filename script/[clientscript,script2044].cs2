}
if (%targetcount < 8) {
    if_sethide(false, target:left7);
}
if (%targetcount < 9) {
    if_sethide(false, target:left8);
}
if (%targetcount < 10) {
    if_sethide(false, target:left9);
}
if (%targetcount < 11) {
    if_sethide(false, target:left10);
}
