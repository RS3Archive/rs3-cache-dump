if_sethide(true, target:dart_9);
if_sethide(true, target:dart_10);
if_sethide(true, target:left1);
if_sethide(true, target:left2);
if_sethide(true, target:left3);
if_sethide(true, target:left4);
if_sethide(true, target:left5);
if_sethide(true, target:left6);
if_sethide(true, target:left7);
if_sethide(true, target:left8);
if_sethide(true, target:left9);
if_sethide(true, target:left10);
switch_int (%targethit) {
    case 0 :
        if_sethide(false, target:dart_bull);
    case 1 :
        if_sethide(false, target:dart_1);
    case 2 :
        if_sethide(false, target:dart_2);
    case 3 :
        if_sethide(false, target:dart_3);
    case 4 :
        if_sethide(false, target:dart_4);
    case 5 :
        if_sethide(false, target:dart_5);
    case 6 :
        if_sethide(false, target:dart_6);
    case 7 :
        if_sethide(false, target:dart_7);
    case 8 :
        if_sethide(false, target:dart_8);
    case 9 :
        if_sethide(false, target:dart_9);
    case 10 :
        if_sethide(false, target:dart_10);
}
if (%targetcount < 2) {
    if_sethide(false, target:left1);
}
if (%targetcount < 3) {
    if_sethide(false, target:left2);
}
if (%targetcount < 4) {
    if_sethide(false, target:left3);
}
if (%targetcount < 5) {
