// 5285
[clientscript,script5285]
if (if_gety(mah5_collarpuzzle:collar_bobside) < 170) {
    sound_vorbis_rate(mah5_bobs_collar_3, 1, 0, 200, random_sound_pitch(20, 20));
    if_setposition(if_getx(mah5_collarpuzzle:collar_bobside), calc(if_gety(mah5_collarpuzzle:collar_bobside) + 10), ^setpos_abs_left, ^setpos_abs_top, mah5_collarpuzzle:collar_bobside);
    if_setposition(if_getx(mah5_collarpuzzle:collar_diraksside), calc(if_gety(mah5_collarpuzzle:collar_diraksside) + 10), ^setpos_abs_left, ^setpos_abs_top, mah5_collarpuzzle:collar_diraksside);
}
