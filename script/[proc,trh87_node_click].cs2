// 12359
[proc,trh87_node_click](int $int0, component $component1)
if (~trh_state(trh87_promo) ! 1) {
    return;
}
if (if_gethide(wheel_of_fortune:reward_layer) = false | if_gethide(trh87_overlay:confirm) = false) {
    return;
}
if (if_find($component1) = true & cc_param(rs3tli_component_param_int0) < clientclock) {
    cc_setparam(rs3tli_component_param_int0, calc(clientclock + 25));
}
