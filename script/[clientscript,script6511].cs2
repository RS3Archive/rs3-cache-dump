        if_settext("Support", vos_weekend:active_voice_name);
}
def_int $int5 = calc($int3 % 1440 / 60);
%vos_weekend_next_voice_minutes = 0;
if ($int1 = 0) {
    $int1 = 24;
}
if (calc($int1 - $int5) = 2) {
    %vos_weekend_next_voice_minutes = 59;
}
%vos_weekend_next_voice_minutes = calc(%vos_weekend_next_voice_minutes + (60 - $int3 % 60));
%vos_weekend_next_voice_seconds = $int4;
if_setontimer("script6512", vos_weekend:active_voice_timer_layer);
