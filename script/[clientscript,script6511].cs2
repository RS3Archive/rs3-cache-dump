// 6511
[clientscript,script6511](int $int0, int $int1, int $int2, int $int3, int $int4)
switch_int ($int0) {
    case 1 :
        if_setgraphic(icon_seren_artisan_trh158, vos_weekend:active_voice_graphic);
        if_settext("Artisan", vos_weekend:active_voice_name);
    case 2 :
