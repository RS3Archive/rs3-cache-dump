// 7471
[proc,script7471](int $int0, string $string0, string $string1, component $component1, component $component2, component $component3, int $int4)
def_string $string2 = $string1;
if ($int4 > 0) {
    if_settext("<col=FF0000>Eliminated</col>", $component1);
    switch_int ($int4) {
        case 1 :
            $string2 = "";
        case 2 :
            $string2 = "+10%";
