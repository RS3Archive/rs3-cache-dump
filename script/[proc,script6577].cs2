// 6577
[proc,script6577](component $component0, component $component1)
if (%tzhaar_fightcave_state < 1 | %tzhaar_fightcave_state > 63) {
    if_sethide(true, $component0);
    if_sethide(true, $component1);
    return;
}
if (%tzhaar_fightcave_state = 63) {
    if_settext("TzTok-Jad", $component1);
} else {
    if_settext("Wave <tostring(%tzhaar_fightcave_state)>", $component1);
}
if_sethide(false, $component0);
if_sethide(false, $component1);
