[proc,script10942]
def_int $int0 = if_getscrollx(bank:tabs_dynamic);
def_int $int1 = max(0, calc(($int0 / 48 - 1) * 48));
if_setscrollpos(max(calc($int0 - 4), 0), 0, bank:tabs_dynamic);
if_setscrollpos(max(calc($int0 - 4), 0), 0, bank:tabs_spacers);
if_setontimer("script13267($int1)", bank:tabs);
