// 19898
[proc,script19898](obj $obj0)(bas)
if ($obj0 = null) {
    return(null);
}
def_bas $bas1 = oc_param($obj0, combatv2_casual_bas);
if ($bas1 = null) {
    $bas1 = oc_param($obj0, combatv2_combat_bas);
}
if ($bas1 = null) {
    $bas1 = oc_param($obj0, baseanimset);
}
if ($bas1 = default_human) {
    $bas1 = null;
}
return($bas1);
