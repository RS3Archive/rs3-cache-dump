// 19314
[proc,script19314](int $int0)(string)
switch_int ($int0) {
    case 0 :
        return("Standard");
    case 1 :
        return("Ironman");
    case 2 :
        return("Hardcore Ironman");
    case 3 :
        return("Group Ironman");
    case 4 :
        return("Hardcore Group Ironman");
    case default :
        ~error("Invalid game mode <tostring($int0)>");
        return("");
}
