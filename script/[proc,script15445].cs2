// 15445
[proc,script15445](component $component0, int $int1)
if ($int1 = 1) {
    if_setgraphic(struct_param(rs3tli_checkbox_18px_ticked_on, rs3tli_button_graphic), $component0);
} else if ($int1 = 0) {
    if_setgraphic(struct_param(rs3tli_checkbox_18px_unticked_on, rs3tli_button_graphic), $component0);
}
