// 14025
[clientscript,script14025]
if (if_gethide(trail17_skyscrapers:example_puzzle) = true) {
    if_sethide(false, trail17_skyscrapers:example_puzzle);
    if_sethide(true, trail17_skyscrapers:check_button_layer);
    if_sethide(true, trail17_skyscrapers:reset_button_layer);
} else {
    if_sethide(true, trail17_skyscrapers:example_puzzle);
    if_sethide(false, trail17_skyscrapers:check_button_layer);
    if_sethide(false, trail17_skyscrapers:reset_button_layer);
}
