[proc,trh104_get_map_graphic]()(graphic)
switch_int (%trh104_current_map) {
    case 0 :
        return(trh104_arc1);
    case 1 :
        return(trh104_arc2);
    case 2 :
        return(trh104_arc3);
    case 3 :
        return(trh104_arc4);
    case 4 :
        return(trh104_arc5);
    case 5 :
        return(trh104_arc6);
    case 6 :
        return(trh104_arc7);
    case 7 :
        return(trh104_arc8);
}
