    case obj_17792 :
        return(calc(inv_total(inv_93, obj_17792) + inv_total(inv_93, obj_16103)));
    case obj_556, obj_555, obj_554, obj_557, obj_4696, obj_4698, obj_4697, obj_4694, obj_4695, obj_4699, obj_558, obj_559, obj_566, obj_565, obj_564, obj_9075, obj_560, obj_563, obj_562, obj_561, obj_58450, obj_21773 :
        return(~script18406($obj0));
    case default :
        ~error("unrecognised type of rune when checking rune total in makex2012 - <oc_name($obj0)>");
        return(inv_total(inv_93, $obj0));
}
