    case obj_17782 :
        if (inv_totalparam(inv_94, param_974) > 0) {
            return(-1);
        }
        return(calc(inv_total(inv_93, obj_17782) + inv_total(inv_93, obj_16093)));
    case obj_17784 :
        return(calc(inv_total(inv_93, obj_17784) + inv_total(inv_93, obj_16095)));
    case obj_17788 :
        return(calc(inv_total(inv_93, obj_17788) + inv_total(inv_93, obj_16099)));
    case obj_17785 :
        return(calc(inv_total(inv_93, obj_17785) + inv_total(inv_93, obj_16096)));
    case obj_17786 :
        return(calc(inv_total(inv_93, obj_17786) + inv_total(inv_93, obj_16097)));
    case obj_17787 :
        return(calc(inv_total(inv_93, obj_17787) + inv_total(inv_93, obj_16098)));
    case obj_17793 :
        return(calc(inv_total(inv_93, obj_17793) + inv_total(inv_93, obj_16104)));
    case obj_17789 :
        return(calc(inv_total(inv_93, obj_17789) + inv_total(inv_93, obj_16100)));
    case obj_17791 :
