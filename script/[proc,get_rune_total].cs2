// 7165
[proc,get_rune_total](obj $obj0)(int)
if (oc_category($obj0) ! category_149) {
    ~error("tried to get total runes of a non-rune object");
    return(0);
}
switch_obj ($obj0) {
    case obj_17780 :
        if (inv_totalparam(inv_94, param_972) > 0) {
            return(-1);
        }
        return(calc(inv_total(inv_93, obj_17780) + inv_total(inv_93, obj_16091)));
    case obj_17781 :
        if (inv_totalparam(inv_94, param_973) > 0) {
            return(-1);
        }
        return(calc(inv_total(inv_93, obj_17781) + inv_total(inv_93, obj_16092)));
    case obj_17783 :
        if (inv_totalparam(inv_94, param_975) > 0) {
