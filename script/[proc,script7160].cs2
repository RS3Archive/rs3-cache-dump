// 7160
[proc,script7160]
def_npc $npc0 = null;
def_seq $seq1 = null;
if (if_getmodel(trh180_overlay:npc_model) ! null & random(2) > 0) {
    return;
}
$npc0 = enum(int, npc, trh180_easter25_preview_npcs, random(enum_getoutputcount(trh180_easter25_preview_npcs)));
$seq1 = enum(int, seq, trh180_easter25_preview_npc_anims, random(enum_getoutputcount(trh180_easter25_preview_npc_anims)));
if_setnpcmodel($npc0, trh180_overlay:npc_model);
if_setmodelanim($seq1, trh180_overlay:npc_model);
if_setmodelangle(5, 0, 0, 75, 0, 575, trh180_overlay:npc_model);
def_string $string0 = enum(npc, string, trh180_easter25_preview_npc_to_string, $npc0);
if_settext($string0, trh180_overlay:npc_text);
