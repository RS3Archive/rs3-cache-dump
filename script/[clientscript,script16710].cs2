                case "th_gem_stones_jackpot_animated_82_100,10" :
                    cc_setgraphic("th_gem_stones_jackpot_animated_82_100,4");
                    $int4 = 80;
            }
        } else if ($int3 = 0) {
            if (cc_getgraphic = "th_gem_stones_jackpot_animated,3" | cc_getgraphic = "th_gem_stones_jackpot_animated_82_100,3") {
                $int4 = 80;
                cc_settrans(255);
            } else {
                cc_settrans(0);
            }
        }
    } else if (--$int4 <= 0 & (cc_getgraphic = "th_gem_stones_jackpot_animated,3" | cc_getgraphic = "th_gem_stones_jackpot_animated_82_100,3")) {
        cc_settrans(0);
    }
    cc_setontimer("script16710($component0, $int1, $int2, $int3, $int4)");
}
