// 16710
[clientscript,script16710](component $component0, int $int1, int $int2, int $int3, int $int4)
if (cc_find($component0, $int1) = true) {
    if ($int4 <= 0) {
        if ($int3 = 100) {
            $int2 = -1;
        } else if ($int3 = 0) {
            $int2 = 1;
        }
        $int3 = ~clamp(calc($int3 + $int2 * 24), 0, 100);
        if ($int3 = 100) {
            cc_settrans(255);
            switch_graphic (cc_getgraphic) {
                case "th_gem_stones_jackpot_animated,3" :
                    cc_setgraphic("th_gem_stones_jackpot_animated,5");
                case "th_gem_stones_jackpot_animated,4" :
                    cc_setgraphic("th_gem_stones_jackpot_animated,6");
                case "th_gem_stones_jackpot_animated,5" :
                    cc_setgraphic("th_gem_stones_jackpot_animated,7");
                case "th_gem_stones_jackpot_animated,6" :
                    cc_setgraphic("th_gem_stones_jackpot_animated,8");
                case "th_gem_stones_jackpot_animated,7" :
                    cc_setgraphic("th_gem_stones_jackpot_animated,9");
                case "th_gem_stones_jackpot_animated,8" :
                    cc_setgraphic("th_gem_stones_jackpot_animated,10");
                case "th_gem_stones_jackpot_animated,9" :
                    cc_setgraphic("th_gem_stones_jackpot_animated,3");
                case "th_gem_stones_jackpot_animated,10" :
                    cc_setgraphic("th_gem_stones_jackpot_animated,4");
                    $int4 = 80;
                case "th_gem_stones_jackpot_animated_82_100,3" :
                    cc_setgraphic("th_gem_stones_jackpot_animated_82_100,5");
                case "th_gem_stones_jackpot_animated_82_100,4" :
                    cc_setgraphic("th_gem_stones_jackpot_animated_82_100,6");
                case "th_gem_stones_jackpot_animated_82_100,5" :
                    cc_setgraphic("th_gem_stones_jackpot_animated_82_100,7");
                case "th_gem_stones_jackpot_animated_82_100,6" :
                    cc_setgraphic("th_gem_stones_jackpot_animated_82_100,8");
                case "th_gem_stones_jackpot_animated_82_100,7" :
                    cc_setgraphic("th_gem_stones_jackpot_animated_82_100,9");
                case "th_gem_stones_jackpot_animated_82_100,8" :
