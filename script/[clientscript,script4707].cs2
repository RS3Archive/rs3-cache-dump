// 4707
[clientscript,script4707]
if_settext(%castlewars_title, castlewars_game_end:win_lose);
if_settext(tostring(%castlewars_red_score), castlewars_game_end:red_flags);
if_settext(tostring(%castlewars_blue_score), castlewars_game_end:blue_flags);
if_settext(tostring(%castlewars_red_kills), castlewars_game_end:red_total_kills);
if_settext(tostring(%castlewars_blue_kills), castlewars_game_end:blue_total_kills);
if_settext(%castlewars_most_kills_name, castlewars_game_end:player_most_kills);
if_settext(%castlewars_most_captures_name, castlewars_game_end:player_most_flags);
if_settext(tostring(%castlewars_gold_tickets_won), castlewars_game_end:my_winnings_gold);
if_settext(tostring(%castlewars_silver_tickets_won), castlewars_game_end:my_winnings_silver);
if_settext(tostring(%castlewars_gold_owned), castlewars_game_end:my_total_tickets);
def_int $int0 = stringwidth(if_gettext(castlewars_game_end:my_total_tickets), if_getfontmetrics(castlewars_game_end:my_total_tickets));
if_setsize($int0, if_getheight(castlewars_game_end:my_total_tickets), ^setsize_abs, ^setsize_abs, castlewars_game_end:my_total_tickets);
def_int $int1 = calc(if_getx(castlewars_game_end:my_total_tickets) + if_getwidth(castlewars_game_end:my_total_tickets) + 5);
if_setposition($int1, if_getheight(castlewars_game_end:my_total_tickets), ^setpos_abs_left, ^setpos_abs_top, castlewars_game_end:title_total_gold_tickets);
def_int $int2 = calc(if_getx(castlewars_game_end:title_total_gold_tickets) + if_getwidth(castlewars_game_end:title_total_gold_tickets));
if_setposition($int2, if_getheight(castlewars_game_end:title_total_gold_tickets), ^setpos_abs_left, ^setpos_abs_top, castlewars_game_end:my_total_silver_tickets);
if_settext(tostring(%castlewars_silver_owned), castlewars_game_end:my_total_silver_tickets);
$int0 = stringwidth(if_gettext(castlewars_game_end:my_total_silver_tickets), if_getfontmetrics(castlewars_game_end:my_total_silver_tickets));
if_setsize($int0, if_getheight(castlewars_game_end:title_total_gold_tickets), ^setsize_abs, ^setsize_abs, castlewars_game_end:my_total_silver_tickets);
$int1 = calc(if_getx(castlewars_game_end:my_total_silver_tickets) + if_getwidth(castlewars_game_end:my_total_silver_tickets) + 5);
if_setposition($int1, if_getheight(castlewars_game_end:my_total_silver_tickets), ^setpos_abs_left, ^setpos_abs_top, castlewars_game_end:title_total_silver_tickets);
if_settext(tostring(%castlewars_total_kills), castlewars_game_end:my_kills);
if_settext(tostring(%castlewars_total_captures), castlewars_game_end:my_flag_captures);
if_settext(tostring(%castlewars_total_games_played), castlewars_game_end:total_games);
