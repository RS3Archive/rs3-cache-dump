// 5814
[clientscript,conq_camera_onkey](int $key0)
switch_int ($key0) {
    case ^key_up :
        ~conq_scroll_camera(1, 1);
    case ^key_w :
        if (map_lang ! 2) {
            ~conq_scroll_camera(1, 1);
        }
    case ^key_z :
        if (map_lang = 2) {
            ~conq_scroll_camera(1, 1);
        }
    case ^key_left :
        ~conq_scroll_camera(7, 1);
    case ^key_a :
        if (map_lang ! 2) {
            ~conq_scroll_camera(7, 1);
        }
    case ^key_q :
        if (map_lang = 2) {
            ~conq_scroll_camera(7, 1);
        }
    case ^key_d, ^key_right :
        ~conq_scroll_camera(3, 1);
    case ^key_s, ^key_down :
        ~conq_scroll_camera(5, 1);
    case ^key_page_up :
        ~script9312(-4, -5);
    case ^key_page_down :
        ~script9312(4, 5);
}
