// 12010
[clientscript,script12010]
~script8411(2007, 0);
if (%toplevel_v2_mobile_interface = 1) {
    if_sethide(true, toplevel_v2_target_info:docking_padlock);
    if_sethide(false, toplevel_v2_target_info:swipe_layer);
    if_setposition(0, 0, ^setpos_abs_left, ^setpos_abs_top, toplevel_v2_target_info:universe);
    if_setsize(0, 0, ^setsize_minus, ^setsize_minus, toplevel_v2_target_info:universe);
    if_setposition(0, calc((100 - 92) / 2), ^setpos_abs_left, ^setpos_abs_top, toplevel_v2_target_info:visible_info);
    if_sethide(true, toplevel_v2_target_info:docking_padlock);
} else {
    if_sethide(false, toplevel_v2_target_info:docking_padlock);
    if_sethide(true, toplevel_v2_target_info:swipe_layer);
}
~script14243(toplevel_v2_target_info:swipe_layer);
