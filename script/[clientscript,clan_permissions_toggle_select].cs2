// 5140
[clientscript,clan_permissions_toggle_select](component $component0)
switch_component ($component0) {
    case clansettings:recruit_button_selected_layer :
        %clan_permissions_recruit = -1;
    case clansettings:lockkeep_button_selected_layer :
        %clan_permissions_lockkeep = -1;
    case clansettings:lockwalls_button_selected_layer :
        %clan_permissions_lockwalls = -1;
    case clansettings:accesskeep_button_selected_layer :
        %clan_permissions_accesskeep = -1;
    case clansettings:accesswalls_button_selected_layer :
        %clan_permissions_accesswalls = -1;
    case clansettings:startbattle_button_selected_layer :
        %clan_permissions_startbattle = -1;
    case clansettings:leadrcw_button_selected_layer :
        %clan_permissions_leadrcw = -1;
    case clansettings:startvote_button_selected_layer :
        %clan_permissions_startvote = -1;
    case clansettings:startmeeting_button_selected_layer :
        %clan_permissions_startmeeting = -1;
    case clansettings:partytech_button_selected_layer :
        %clan_permissions_partytech = -1;
    case clansettings:theatretech_button_selected_layer :
        %clan_permissions_theatretech = -1;
    case clansettings:addnotice_button_selected_layer :
        %clan_permissions_addnotice = -1;
    case clansettings:addsign_button_selected_layer :
        %clan_permissions_addsign = -1;
    case clansettings:editfield_button_selected_layer :
        %clan_permissions_editfield = -1;
    case clansettings:canupgrade_button_selected_layer :
        %clan_permissions_upgrade = -1;
    case clansettings:candowngrade_button_selected_layer :
        %clan_permissions_downgrade = -1;
    case clansettings:canlockplots_button_selected_layer :
        %clan_permissions_lockskillplots_varc = -1;
    case clansettings:cancheckresources_button_selected_layer :
        %clan_permissions_can_check_resources_varc = -1;
    case clansettings:cangather_button_selected_layer :
        %clan_permissions_gather = -1;
    case clansettings:language_button_selected_layer :
        %clan_permissions_language = -1;
    case clansettings:removehabitat_button_selected_layer :
        %clan_permissions_removehabitat_varc = -1;
    case clansettings:customiseavatar_button_selected_layer :
        %clan_permissions_customiseavatar_varc = -1;
    case clansettings:fillbuffslot_button_selected_layer :
        %clan_permissions_fillbuffslot_varc = -1;
    case clansettings:settick_button_selected_layer :
        %clan_permissions_settick = -1;
    case clansettings:broadcastevent_button_selected_layer :
        %clan_permissions_broadcastevent_varc = -1;
    case clansettings:changebroadcastsettings_button_selected_layer :
        %clan_permissions_canchangebroadcastsettings_varc = -1;
    case clansettings:kickmember_button_selected_layer :
        %clan_permissions_cankick_varc = -1;
}
~clan_permissions_toggle_select($component0);
