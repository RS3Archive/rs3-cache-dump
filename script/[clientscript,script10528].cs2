// 10528
[clientscript,script10528]
~script13991(bank:tabs_scroll_down_bg, null, rs3tli_3x3_icon_button, true);
if (%bank_tab_vertical = 1) {
    if_setontimer("script13348(calc(if_getscrollheight(bank:tabs_dynamic) - if_getheight(bank:tabs_dynamic)))", bank:tabs);
} else {
    if_setontimer("script13348(calc(if_getscrollwidth(bank:tabs_dynamic) - if_getwidth(bank:tabs_dynamic)))", bank:tabs);
}
