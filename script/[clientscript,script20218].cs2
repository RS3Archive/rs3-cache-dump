// 20218
[clientscript,script20218](int $int0)
def_int $int1 = calc(clientclock - $int0);
def_int $int2 = 0;
if ($int1 = 1) {
    if_setenabled(false, league_onboarding:confirm_link_main);
    if_setenabled(false, league_onboarding:confirm_link_alt);
    if_sethide(true, league_onboarding:confirm_link_spinner);
    if_sethide(true, league_onboarding:check_name_spinner);
}
if ($int1 < 100) {
    ~script20222(scale(255, 100, $int1));
} else if ($int1 < 200) {
    if ($int1 = 100) {
        ~script20230;
    }
    $int1 = calc($int1 - 100);
    ~script20223(calc(255 - scale(255, 100, $int1)));
} else if (%league_onboarding_step = 3) {
    $int2 = calc(($int1 - 200) / 50);
    if ($int1 < 450) {
        if_setenabled(false, league_onboarding:confirm_link_main);
        if_setenabled(false, league_onboarding:confirm_link_alt);
        if_sethide(false, league_onboarding:confirm_link_main);
        if_sethide(false, league_onboarding:confirm_link_spinner);
        if_sethide(true, league_onboarding:confirm_link_alt);
        if_settext("<tostring(calc(5 - $int2))>...", league_onboarding:confirm_link_main);
    } else {
        if_setparam_int(rs3tli_component_anim_dir, 0, league_onboarding:anim_listener);
        if_setontimer(null, league_onboarding:anim_listener);
        if_setenabled(true, league_onboarding:confirm_link_main);
        if_sethide(true, league_onboarding:confirm_link_alt);
        if_setenabled(false, league_onboarding:confirm_link_alt);
        if_sethide(true, league_onboarding:confirm_link_spinner);
        if_settext("Confirm this Account", league_onboarding:confirm_link_main);
    }
} else {
    if_setparam_int(rs3tli_component_anim_dir, 0, league_onboarding:anim_listener);
    if_setontimer(null, league_onboarding:anim_listener);
}
