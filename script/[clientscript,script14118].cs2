// 14118
[clientscript,script14118](struct $struct0, struct $struct1)
switch_struct ($struct0) {
    case trh140_promo :
        if (%trh140_sticker_active = 1) {
            if_setgraphic(struct_param($struct1, trh_bingo_stamp_btn_graphic_over), trh_bingo:use_stamp_btn_graphic);
        } else {
            if_setgraphic(struct_param($struct1, trh_bingo_stamp_btn_graphic), trh_bingo:use_stamp_btn_graphic);
        }
    case trh150_promo :
        if (%trh150_sticker_active = 1) {
            if_setgraphic(struct_param($struct1, trh_bingo_stamp_btn_graphic_over), trh_bingo:use_stamp_btn_graphic);
        } else {
            if_setgraphic(struct_param($struct1, trh_bingo_stamp_btn_graphic), trh_bingo:use_stamp_btn_graphic);
        }
}
