// 15583
[clientscript,script15583](component $component0)
if (%ironman_comsubid ! 5) {
    switch_component ($component0) {
        case game_mode_selection:standard :
            %ironman_comsubid = 0;
            sound_vorbis_volume(tut7_login_difficulty_normal_button, 1, 0, 255);
        case game_mode_selection:ironman :
            %ironman_comsubid = 1;
            sound_vorbis_volume(tut7_login_difficulty_ironman_button, 1, 0, 255);
        case game_mode_selection:hardcore :
            %ironman_comsubid = 2;
            sound_vorbis_volume(tut7_login_difficulty_hardcore_ironman_button, 1, 0, 255);
        case game_mode_selection:group_ironman :
            %ironman_comsubid = 3;
            sound_vorbis_volume(tut7_login_difficulty_ironman_button, 1, 0, 255);
    }
}
~script15585;
