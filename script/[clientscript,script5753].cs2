// 5753
[clientscript,script5753](component $component0)
if (if_find($component0) = true) {
    cc_setparam(rs3tli_component_transparency_type, 3);
    cc_setparam(rs3tli_component_transparency_step, 8);
    cc_setparam(rs3tli_component_target_transparency, 0);
    cc_settrans(255);
    cc_sethide(true);
    cc_setontimer("script12631(event_com, event_comsubid)");
}
