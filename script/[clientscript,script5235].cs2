// 5235
[clientscript,script5235](component $component0)
switch_component ($component0) {
    case tt2_noticeboard:advert_1 :
        if_sethide(true, tt2_noticeboard:advert_1_overlay);
    case tt2_noticeboard:advert_2 :
        if_sethide(true, tt2_noticeboard:advert_2_overlay);
    case tt2_noticeboard:advert_3 :
        if_sethide(true, tt2_noticeboard:advert_3_overlay);
}
