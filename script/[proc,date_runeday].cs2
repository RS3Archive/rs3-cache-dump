// 12477
[proc,date_runeday]()(int)
switch_toplevelinterface (if_gettop) {
    case lobbyscreen :
        return(%lobby_runeday);
    case toplevel_v2 :
        return(%atlum_day_tracker);
    case loginscreen :
        return(date_runeday);
    case default :
        return(date_runeday);
}
return(date_runeday);
