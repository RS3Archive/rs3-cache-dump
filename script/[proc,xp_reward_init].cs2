// 786
[proc,xp_reward_init](stat $stat0, component $component1, component $component2, component $component3)
if_setonvarctransmit("xp_reward_update($stat0, $component1, $component2, $component3){xp_reward_currentchoice, xp_reward_internalxp, xp_reward_minlevel, xp_reward_item}", $component1);
if_setonstattransmit("xp_reward_update($stat0, $component1, $component2, $component3){$stat0}", $component1);
if_setonresize("xp_reward_update($stat0, $component1, $component2, $component3)", $component1);
~xp_reward_update($stat0, $component1, $component2, $component3);
