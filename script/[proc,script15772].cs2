// 15772
[proc,script15772](stat $stat0)(boolean)
if ($stat0 = attack) {
    if (stat_base(attack) >= min(99, ~script12038(attack)) & stat_base(strength) >= min(99, ~script12038(strength)) & stat_base(defence) >= min(99, ~script12038(defence)) & stat_base(magic) >= min(99, ~script12038(magic)) & stat_base(ranged) >= min(99, ~script12038(ranged)) & stat_base(hitpoints) >= min(99, ~script12038(hitpoints))) {
        return(true);
    }
} else if (stat_base($stat0) >= min(99, ~script12038($stat0))) {
    return(true);
}
return(false);
