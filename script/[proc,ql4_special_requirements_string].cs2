// 7087
[proc,ql4_special_requirements_string](quest $quest0)(int, string)
def_string $string0 = "";
def_int $int1 = 1;
def_int $int2 = 0;
def_string $string1 = "";
def_string $string2 = "";
if ($quest0 = null) {
    return(0, "");
}
switch_quest ($quest0) {
    case hopespears_will :
        $int1, $string0 = ~cheevo_special_string($int1, $string0, %fairyring_use, "Access to the fairy ring network");
        $int2 = 0;
        if (%deserttreasure > 12) {
            $int2 = 1;
        }
        $int1, $string0 = ~cheevo_special_string($int1, $string0, $int2, ~cheevo_req_quest_partial(30));
    case defender_of_varrock :
        if (%vm_soa_extra > 0) {
            $int2 = 1;
        }
        $int1, $string0 = ~cheevo_special_string($int1, $string0, $int2, "Claim Kudos from Historian Minas in Varrock Museum for completing Shield of Arrav");
    case eadgars_ruse :
        $int1, $string0 = ~cheevo_special_string($int1, $string0, %troll_freed_eadgar, "Rescue Mad Eadgar from the Troll Stronghold");
    case curse_of_arrav :
        if (%troll_quest >= 20) {
            $int2 = 1;
        }
        $int1, $string0 = ~cheevo_special_string($int1, $string0, $int2, "Access Trollheim by defeating Dad");
        $int2 = 0;
        if (~script165 >= 100) {
            $int2 = 1;
        }
        $string1 = "Fully restore Senliten from the ";
        $string1 = append($string1, ~cheevo_req_quest_name(155));
        $string1 = append($string1, " quest (<tostring(min(~script165, 100))>%)");
        $int1, $string0 = ~cheevo_special_string($int1, $string0, $int2, $string1);
    case nomads_requiem :
        if (%kr_knightwaves_state >= 8) {
            $int2 = 1;
        }
        $int1, $string0 = ~cheevo_special_string($int1, $string0, $int2, "Complete the Knight Waves in Camelot");
        $int2 = 0;
        $int1, $string0 = ~cheevo_special_string($int1, $string0, %snp_finished_tutorial, "Complete the Soul Wars tutorial");
    case do_no_evil :
        if (~script165 >= 100) {
            $int2 = 1;
        }
        $string1 = "Fully restore Senliten from the ";
        $string1 = append($string1, ~cheevo_req_quest_name(155));
        $string1 = append($string1, " quest (<tostring(min(~script165, 100))>%)");
        $int1, $string0 = ~cheevo_special_string($int1, $string0, $int2, $string1);
        $int2 = 0;
        if (%desert_quest_set_up >= 5) {
            $int2 = 1;
        }
        $int1, $string0 = ~cheevo_special_string($int1, $string0, $int2, "Bring Leela to Senliten's tomb");
    case crocodile_tears :
        if (%desert_quest_set_up >= 5) {
            $int2 = 1;
        }
        $int1, $string0 = ~cheevo_special_string($int1, $string0, $int2, "Bring Leela to Senliten's tomb");
        $int2 = 0;
        if (~script165 >= 100) {
            $int2 = 1;
        }
        $string1 = "Fully restore Senliten from the ";
        $string1 = append($string1, ~cheevo_req_quest_name(155));
        $string1 = append($string1, " quest (<tostring(min(~script165, 100))>%)");
        $int1, $string0 = ~cheevo_special_string($int1, $string0, $int2, $string1);
    case heros_welcome :
        $int2 = min(%brut_craft_ship, 1);
        $int1, $string0 = ~cheevo_special_string($int1, $string0, $int2, "Access to the Ancient Cavern from Barbarian Training");
    case while_guthix_sleeps :
        if (calc(stat_base_actual(attack) + stat_base_actual(strength)) >= 130 | stat_base_actual(attack) >= 99 | stat_base_actual(strength) >= 99) {
            $int2 = 1;
        }
        $int1, $string0 = ~cheevo_special_string($int1, $string0, $int2, "Ability to enter the Warriors' Guild");
    case elr_slayer :
        if (%pop_adventurer_4_completed > 0) {
            $int2 = 1;
        }
        $int1, $string0 = ~cheevo_special_string($int1, $string0, $int2, "Complete the 'Meet the Assassin' voyage in Player Owned Ports");
    case elr_cyclosis :
        if (~pop_island_unlocked(0) = ^true) {
            $int2 = 1;
        }
        $int1, $string0 = ~cheevo_special_string($int1, $string0, $int2, "Discover the island of Cyclosis in Player Owned Ports");
    case clockwork_syringe :
        if (%construction_house_teleport_arrive_portal_id > 0) {
            $int2 = 1;
        }
        $int1, $string0 = ~cheevo_special_string($int1, $string0, $int2, "Own a player-owned house");
    case caper_ourown :
        if (%feud_var > 12) {
            $int2 = 1;
        }
        $int1, $string0 = ~cheevo_special_string($int1, $string0, $int2, ~cheevo_req_quest_partial(45));
    case curse_of_zaros :
        if (%fd_shadowwarrior_quest >= 3) {
            $int2 = 1;
        }
        $int1, $string0 = ~cheevo_special_string($int1, $string0, $int2, ~cheevo_req_quest_partial(30));
    case handsand2 :
        if (%roots_quest >= 20) {
            $int2 = 1;
        }
        $int1, $string0 = ~cheevo_special_string($int1, $string0, $int2, ~cheevo_req_quest_partial(128));
    case tzhaar3_gaal :
        if (%deserttreasure > 12) {
            $int2 = 1;
        }
        $int1, $string0 = ~cheevo_special_string($int1, $string0, $int2, ~cheevo_req_quest_partial(30));
    case tales_of_the_god_wars :
        if (stat_base_actual(strength) >= 60 | stat_base_actual(agility) >= 60) {
            $int2 = 1;
        }
        $int1, $string0 = ~cheevo_special_string($int1, $string0, $int2, "Access to the God Wars dungeon");
    case fremsaga_signature, fremsaga_vengeance, fremsaga_thok, fremsaga_bilrach, fremsaga_thok2 :
        if (%fremsaga_skaldrun >= 3) {
            $int2 = 1;
        }
        $int1, $string0 = ~cheevo_special_string($int1, $string0, $int2, "You need to find and free Skaldrun from the frozen floors in Daemonheim");
    case dm :
        if (%dino_base_camp_tutorial = 30) {
            $int2 = 1;
        }
        $int1, $string0 = ~cheevo_special_string($int1, $string0, $int2, "Complete the base camp tutorial on Anachronia");
    case kerapac_dnd :
        if (stat_base(invention) >= 85 | stat_base(crafting) >= 85 | stat_base(runecraft) >= 85 | stat_base(smithing) >= 85) {
            $int2 = 1;
        }
        $int1, $string0 = ~cheevo_special_string($int1, $string0, $int2, "You need a level of at least 85 in Crafting, Runecrafting, Smithing or Invention");
    case tortle_combat :
        if (%pof_tutorial_progress = 7) {
            $int2 = 1;
        }
        $int1, $string0 = ~cheevo_special_string($int1, $string0, $int2, "Complete the introduction to the player-owned farm with Granny Potterington");
    case egwd_prerelease :
        if (%arch_tutorial >= 100) {
            $int2 = 1;
        }
        $int1, $string0 = ~cheevo_special_string($int1, $string0, $int2, "Complete the Archaeology tutorial by speaking to Acting Guildmaster Reiniger at the Varrock dig site.");
    case zamorak :
        if (%arch_infernalsource_mq_cult = 6) {
            $int2 = 1;
        }
        $int1, $string0 = ~cheevo_special_string($int1, $string0, $int2, "Complete the Eyes in Their Stars mystery");
        $int2 = 0;
        if (%egwd_naressa_met = 1) {
            $int2 = 1;
        }
        $int1, $string0 = ~cheevo_special_string($int1, $string0, $int2, "Meet Naressa in Senntisten");
    case quest_daughter2 :
        if (~script4253 >= 5) {
            $int2 = 1;
        }
        $int1, $string0 = ~cheevo_special_string($int1, $string0, $int2, "Infernal Puzzle Box Tier 5");
    case quest_fort :
        if (~script15809(2) >= 1) {
            $int2 = 1;
        }
        $int1, $string0 = ~cheevo_special_string($int1, $string0, $int2, "Town Hall Tier 1");
        $int2 = 0;
        if (~script15809(3) >= 1) {
            $int2 = 1;
        }
        $int1, $string0 = ~cheevo_special_string($int1, $string0, $int2, "Command Centre Tier 1");
        $int2 = 0;
        if (~script15809(1) >= 1) {
            $int2 = 1;
        }
        $int1, $string0 = ~cheevo_special_string($int1, $string0, $int2, "Workshop Tier 1");
        $int2 = 0;
        if (~script15809(4) >= 1) {
            $int2 = 1;
        }
        $int1, $string0 = ~cheevo_special_string($int1, $string0, $int2, "Chapel Tier 1");
    case necromancy_city_smith :
        if (%necro_hub_given_equipment = 1) {
            $int2 = 1;
        }
        $int1, $string0 = ~cheevo_special_string($int1, $string0, $int2, "Collect a set of necromancer robes from Sostratus");
    case quest_necromancy_hermod :
        if (%necro_hub_vessel_capacity >= 3000) {
            $int2 = 1;
        }
        $int1, $string0 = ~cheevo_special_string($int1, $string0, $int2, "<tostring_localised(3000, true)> City of Um vessel souls.");
    case quest_necromancy_finale :
        if (%necro_hub_vessel_capacity >= 30000) {
            $int2 = 1;
        }
        $int1, $string0 = ~cheevo_special_string($int1, $string0, $int2, "<tostring_localised(30000, true)> City of Um vessel souls.");
    case quest_fort_epilogue :
        if (~script15809(20) >= 1) {
            $int2 = 1;
        }
        $int1, $string0 = ~cheevo_special_string($int1, $string0, $int2, "Grove Cabin Tier 1");
        $int2 = 0;
        if (~script15809(24) >= 1) {
            $int2 = 1;
        }
        $int1, $string0 = ~cheevo_special_string($int1, $string0, $int2, "Botanist's Workbench Tier 1");
        $int2 = 0;
    case quest_star :
        if (%arch_mystery_stormguard_security_completed = 1) {
            $int2 = 1;
        }
        $int1, $string0 = ~cheevo_special_string($int1, $string0, $int2, "Complete the Wing Out mystery");
    case default :
        $string2 = ~quest_name($quest0);
        ~error("(.quest: <$string0>) has param=quest_requires_special,true but no case in [proc,ql4_special_requirements_string].");
        return(0, "");
}
if (string_length($string0) > 0) {
    $string0 = "<$string0><br>";
}
return($int1, $string0);
