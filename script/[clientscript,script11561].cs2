// 11561
[clientscript,script11561](int $int0, graphic $graphic1)
switch_int ($int0) {
    case 1 :
        if_setgraphic($graphic1, trh55_world_event:saradomin_button_graphic);
    case 2 :
        if_setgraphic($graphic1, trh55_world_event:zamorak_button_graphic);
    case 3 :
        if_setgraphic($graphic1, trh55_world_event:armadyl_button_graphic);
    case 4 :
        if_setgraphic($graphic1, trh55_world_event:godless_button_graphic);
    case 5 :
        if_setgraphic($graphic1, trh55_world_event:astromancer_graphic_unlocked);
}
