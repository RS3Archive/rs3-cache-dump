[proc,levelup_setlevelgraphic](int $int0, component $component1)
switch_int ($int0) {
    case 0 :
        if_setgraphic("aif_level_up_text_numbers,0", $component1);
    case 1 :
        if_setgraphic("aif_level_up_text_numbers,1", $component1);
    case 2 :
        if_setgraphic("aif_level_up_text_numbers,2", $component1);
    case 3 :
        if_setgraphic("aif_level_up_text_numbers,3", $component1);
    case 4 :
        if_setgraphic("aif_level_up_text_numbers,4", $component1);
    case 5 :
        if_setgraphic("aif_level_up_text_numbers,5", $component1);
    case 6 :
        if_setgraphic("aif_level_up_text_numbers,6", $component1);
    case 7 :
        if_setgraphic("aif_level_up_text_numbers,7", $component1);
    case 8 :
        if_setgraphic("aif_level_up_text_numbers,8", $component1);
    case 9 :
        if_setgraphic("aif_level_up_text_numbers,9", $component1);
}
