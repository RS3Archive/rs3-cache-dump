// 12763
[clientscript,script12763]
if_sethide(false, cruc_signup_board:checkbox_deselected_layer);
if_sethide(false, cruc_signup_board:checkbox_deselected_layer_1);
if_sethide(false, cruc_signup_board:checkbox_deselected_layer_2);
if_sethide(false, cruc_signup_board:checkbox_deselected_layer_3);
if_sethide(false, cruc_signup_board:checkbox_deselected_layer_4);
if_sethide(false, cruc_signup_board:checkbox_deselected_layer_5);
switch_int (%cruc_dm_signup_group) {
    case 1 :
        if_sethide(true, cruc_signup_board:checkbox_deselected_layer);
    case 2 :
        if_sethide(true, cruc_signup_board:checkbox_deselected_layer_1);
    case 3 :
        if_sethide(true, cruc_signup_board:checkbox_deselected_layer_2);
    case 4 :
        if_sethide(true, cruc_signup_board:checkbox_deselected_layer_3);
    case 5 :
        if_sethide(true, cruc_signup_board:checkbox_deselected_layer_4);
    case 6 :
        if_sethide(true, cruc_signup_board:checkbox_deselected_layer_5);
}
