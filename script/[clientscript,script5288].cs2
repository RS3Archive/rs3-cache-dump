// 5288
[clientscript,script5288]
sound_vorbis_rate(sound_7513, 1, 0, 200, random_sound_pitch(20, 20));
if (if_get2dangle(interface_555:com_14) = 0) {
    if_set2dangle(49152, interface_555:com_15);
    if_set2dangle(49152, interface_555:com_14);
    return;
}
if (if_get2dangle(interface_555:com_14) = 49152) {
    if_set2dangle(32768, interface_555:com_15);
    if_set2dangle(32768, interface_555:com_14);
    return;
}
if (if_get2dangle(interface_555:com_14) = 32768) {
    if_set2dangle(16384, interface_555:com_15);
    if_set2dangle(16384, interface_555:com_14);
    return;
}
if (if_get2dangle(interface_555:com_14) = 16384) {
    if_set2dangle(0, interface_555:com_15);
    if_set2dangle(0, interface_555:com_14);
    return;
}
return;
