// 5288
[clientscript,script5288]
sound_vorbis_rate(mah5_bobs_collar, 1, 0, 200, random_sound_pitch(20, 20));
if (if_get2dangle(mah5_collarpuzzle:collar_bobside) = 0) {
    if_set2dangle(49152, mah5_collarpuzzle:collar_diraksside);
    if_set2dangle(49152, mah5_collarpuzzle:collar_bobside);
    return;
}
if (if_get2dangle(mah5_collarpuzzle:collar_bobside) = 49152) {
    if_set2dangle(32768, mah5_collarpuzzle:collar_diraksside);
    if_set2dangle(32768, mah5_collarpuzzle:collar_bobside);
    return;
}
if (if_get2dangle(mah5_collarpuzzle:collar_bobside) = 32768) {
    if_set2dangle(16384, mah5_collarpuzzle:collar_diraksside);
    if_set2dangle(16384, mah5_collarpuzzle:collar_bobside);
    return;
}
if (if_get2dangle(mah5_collarpuzzle:collar_bobside) = 16384) {
    if_set2dangle(0, mah5_collarpuzzle:collar_diraksside);
    if_set2dangle(0, mah5_collarpuzzle:collar_bobside);
    return;
}
return;
