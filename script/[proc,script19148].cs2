// 19148
[proc,script19148](struct $struct0)(dbrow)
switch_struct ($struct0) {
    case trh182_promo :
        return(trh182_character_level_rewards);
    case trh203_promo :
        return(trh203_character_level_rewards);
    case trh207_promo :
        return(trh207_character_level_rewards);
    case default :
        ~error("Missed plugin point for promo ID <tostring(struct_param($struct0, trh_promo_id))>");
}
return(null);
