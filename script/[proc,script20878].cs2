// 20878
[proc,script20878](int $int0, int $int1)
def_string $string0 = "";
def_string $string1 = ~script20879($int0, $int1);
if (%stock_offeritem = null) {
    $string0 = "";
} else if (%stock_buylimit <= 0) {
    $string0 = "Loading...";
} else if (string_length($string1) > 0) {
    $string0 = "Buy limit per 4 hours: <tostring(%stock_buylimit_current)> / <tostring_localised(%stock_buylimit, true)> (<$string1>)";
} else {
    $string0 = "Buy limit per 4 hours: <tostring_localised(%stock_buylimit, true)>";
}
if_settext($string0, stockmarket:offeritem_buylimit);
