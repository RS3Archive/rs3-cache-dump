[clientscript,script5552]
switch_int (%trh_bingo_prize_selected) {
    case 0 :
        if_sethide(false, trh_bingo:prestige_1_active);
    case 1 :
        if_sethide(false, trh_bingo:prestige_2_active);
    case 2 :
        if_sethide(false, trh_bingo:prestige_3_active);
    case 3 :
        if_sethide(false, trh_bingo:prestige_4_active);
    case 4 :
        if_sethide(false, trh_bingo:prestige_5_active);
}
