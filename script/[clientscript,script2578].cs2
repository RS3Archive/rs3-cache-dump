// 2578
[clientscript,script2578](int $int0)
def_int $int1 = calc(clientclock % 800);
if (calc(clientclock % 25) = 0) {
    switch_int ($int1) {
        case 0 :
            ~script2573($int0, 0);
        case 200 :
            ~script2573($int0, 1);
        case 400 :
            ~script2573($int0, 2);
        case 600 :
            ~script2573($int0, 3);
    }
}
