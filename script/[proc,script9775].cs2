[proc,script9775](int $int0)(int, string, model)
switch_int ($int0) {
    case 0 :
        return(0, "None Selected", null);
    case 1 :
        return(%ecosystem_basic_found, "Common Jadinko", eco_vine_creature_green);
    case 2 :
