// 13048
[proc,script13048]()(boolean)
if (staffmodlevel >= 2) {
    if (%rotten_potato_last_known_inv_location >= 0 & inv_getobj(inv, %rotten_potato_last_known_inv_location) = rotten_potato) {
        return(true);
    }
    %rotten_potato_last_known_inv_location = ~inv_find(inv, rotten_potato, 0);
    if (%rotten_potato_last_known_inv_location >= 0) {
        return(true);
    }
}
return(false);
