// 3682
[clientscript,script3682](component $component0, component $component1, component $component2, component $component3, component $component4, component $component5, component $component6)
if (string_length(%music_searchstring) = 0 & %meslayermode ! 14) {
    if_setgraphic("aif_music_header_buttons,12", $component0);
} else {
    ~music_search_close($component0, $component1, $component2, $component3, $component4, $component5, $component6);
    if_setgraphic("aif_music_header_buttons,14", $component0);
}
