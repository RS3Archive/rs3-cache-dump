// 12006
[proc,prayer_mode_enum](component $component0)(enum)
if ($component0 = prayer_quick_preset_interface:prayer_buttons) {
    switch_int (~script6799(%prayer_quick_selected_preset)) {
        case 0 :
            return(combatv2_prayer_order_by_level);
        case 1 :
            return(combatv2_curse_order_by_level);
    }
} else {
    switch_int (%prayer_mode) {
        case 0 :
            return(combatv2_prayer_order_by_level);
        case 1 :
            return(combatv2_curse_order_by_level);
    }
}
