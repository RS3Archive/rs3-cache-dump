// 3438
[clientscript,script3438]
switch_int (map_lang) {
    case 1 :
        if_setgraphic(aif_refer_friend_text_ger, interface_329:com_10);
    case 2 :
        if_setgraphic(aif_refer_friend_text_fr, interface_329:com_10);
    case 3 :
        if_setgraphic(aif_refer_friend_text_pt, interface_329:com_10);
    case 6 :
        if_setgraphic(aif_refer_friend_text_mx_es, interface_329:com_10);
    case default :
        if_setgraphic(aif_refer_friend_text_eng, interface_329:com_10);
}
