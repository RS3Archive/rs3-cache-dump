// 3438
[clientscript,script3438]
switch_int (map_lang) {
    case 1 :
        if_setgraphic(aif_refer_friend_text_ger, raf_login_popup:welcome);
    case 2 :
        if_setgraphic(aif_refer_friend_text_fr, raf_login_popup:welcome);
    case 3 :
        if_setgraphic(aif_refer_friend_text_pt, raf_login_popup:welcome);
    case 6 :
        if_setgraphic(aif_refer_friend_text_mx_es, raf_login_popup:welcome);
    case default :
        if_setgraphic(aif_refer_friend_text_eng, raf_login_popup:welcome);
}
