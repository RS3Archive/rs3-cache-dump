// 18835
[proc,trh197_overlay_update]
def_component $component0 = null;
def_component $component1 = null;
def_component $component2 = null;
def_component $component3 = null;
def_obj $obj4 = null;
def_int $int5 = 0;
def_int $int6 = 1;
def_int $int7 = 1;
def_int $int8 = 0;
while (++$int8 <= 3) {
    switch_int ($int8) {
        case 1 :
            $component0 = trh197_overlay:chest_1_click_layer;
            $component1 = trh197_overlay:chest_1_prize_layer;
            $component2 = trh197_overlay:chest_1_prize_info;
            $component3 = trh197_overlay:chest_1_multiplier_icon;
            $obj4, $int5, $int6 = %trh197_chest_1_prize_obj, %trh197_chest_1_prize_amount, %trh197_chest_1_prize_rarity;
            $int7 = %trh197_chest_1_prize_multiplier;
        case 2 :
            $component0 = trh197_overlay:chest_2_click_layer;
            $component1 = trh197_overlay:chest_2_prize_layer;
            $component2 = trh197_overlay:chest_2_prize_info;
            $component3 = trh197_overlay:chest_2_multiplier_icon;
            $obj4, $int5, $int6 = %trh197_chest_2_prize_obj, %trh197_chest_2_prize_amount, %trh197_chest_2_prize_rarity;
            $int7 = %trh197_chest_2_prize_multiplier;
        case 3 :
            $component0 = trh197_overlay:chest_3_click_layer;
            $component1 = trh197_overlay:chest_3_prize_layer;
            $component2 = trh197_overlay:chest_3_prize_info;
            $component3 = trh197_overlay:chest_3_multiplier_icon;
            $obj4, $int5, $int6 = %trh197_chest_3_prize_obj, %trh197_chest_3_prize_amount, %trh197_chest_3_prize_rarity;
            $int7 = %trh197_chest_3_prize_multiplier;
    }
    if_setgraphic(~script10980($int7), $component3);
    if_settext(oc_name($obj4), $component2);
    if_setopcursor(1, wof_trh_key_cursor, $component0);
    ~script18836($component1, $obj4, $int5, $int6, $int7);
}
