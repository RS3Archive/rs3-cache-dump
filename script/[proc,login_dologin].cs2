// 2945
[proc,login_dologin]
sound_vorbis_volume(tut7_login_play_now_button, 1, 0, 255);
if (~script1011 = true) {
    return;
}
%login_via_social = 0;
%loginscreen_remember_single_signon = 0;
if (~script4597 = true) {
    return;
}
if (sso_available = false & (string_length(%loginscreen_username) = 0 | string_length(%loginscreen_password) = 0)) {
    ~login_open(8);
    return;
}
%loginscreen_hopblocked_time = 0;
%loginscreen_videoad = 0;
if_setonclick(null, loginscreen:login_button);
~script15660;
~script15662("Signing in...", -1, 0);
%login_reply_last = -3;
if (%login_remember_user = 1 & string_length(%loginscreen_username) ! 0) {
    %login_saved_user = %loginscreen_username;
}
if (~script6509 = true) {
    lobby_enterlobby_sso(%loginscreen_totp_auth, %loginscreen_remember_auth);
} else {
    lobby_enterlobby(%loginscreen_username, %loginscreen_password, %loginscreen_totp_auth, %loginscreen_remember_auth);
}
%loginscreen_totp_auth = "";
if_setontimer("login_reply(0)", loginscreen:login_progress_popup);
