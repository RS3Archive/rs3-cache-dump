// 19713
[clientscript,script19713]
if (if_gethide(marketplace_preview:recolour_panel) = true) {
    if_sethide(false, marketplace_preview:recolour_panel);
    if_setop(1, "Minimise", marketplace_preview:recolour_button);
} else {
    if_sethide(true, marketplace_preview:recolour_panel);
    if_setop(1, "Maximise", marketplace_preview:recolour_button);
}
