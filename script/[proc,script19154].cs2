// 19154
[proc,script19154](dbrow $dbrow0)(string)
switch_dbtable (db_getrowtable($dbrow0)) {
    case trh182_monsters :
        return(db_getfield($dbrow0, trh182_monsters:col7, 0));
    case trh203_nodes :
        return(db_getfield($dbrow0, trh203_nodes:col7, 0));
    case trh207_nodes :
        return(db_getfield($dbrow0, trh207_nodes:col7, 0));
    case default :
        ~error("Missed plugin point for DBTable.");
}
return("");
