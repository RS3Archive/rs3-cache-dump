// 19154
[proc,script19154](dbrow $dbrow0)(string)
switch_dbtable (db_getrowtable($dbrow0)) {
    case dbtable_193 :
        return(db_getfield($dbrow0, dbtable_193:col7, 0));
    case dbtable_294 :
        return(db_getfield($dbrow0, dbtable_294:col7, 0));
    case dbtable_315 :
        return(db_getfield($dbrow0, dbtable_315:col7, 0));
    case default :
        ~error("Missed plugin point for DBTable.");
}
return("");
