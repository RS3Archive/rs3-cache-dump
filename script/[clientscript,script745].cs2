// 745
[clientscript,script745](int $int0, int $int1, int $int2)
def_string $string0 = tostring($int0);
def_string $string1 = tostring($int1);
def_component $component3 = tuska_hub_overlay:time_text;
def_component $component4 = tuska_hub_overlay:time_panel;
if ($int2 = 0) {
    $component3 = tuska_world_event_info:time_text;
    $component4 = tuska_world_event_info:time_panel;
}
if (calc(clientclock % 50) = 0) {
    if (--$int1 < 0) {
        $int1 = 59;
        $int0 = max(0, calc($int0 - 1));
    }
    $string0 = tostring($int0);
    $string1 = tostring($int1);
    if ($int1 < 10) {
        $string1 = "0<tostring($int1)>";
    }
    if ($int0 < 10) {
        $string0 = "0<tostring($int0)>";
    }
    if_settext("<$string0>:<$string1>", $component3);
    if_setontimer("script745($int0, $int1, $int2)", $component3);
    if ($int1 = 0 & $int0 = 0) {
        if_setposition(0, 35, ^setpos_abs_centre, ^setpos_abs_top, $component4);
        if_setontimer(null, $component3);
        if_sendtoback(tuska_hub_overlay:time_panel);
        if_sendtoback(tuska_world_event_info:time_panel);
        if_sethide(true, tuska_hub_overlay:time_panel);
    }
}
