// 5076
[proc,script5076](component $component0, int $int1)
def_int $int2 = 0;
def_int $int3 = 0;
if (cc_find($component0, $int1) = true) {
    if (cc_gethide = true) {
        $int2 = calc((if_getscrollwidth(clan_field_editor:grid_container) - if_getwidth(clan_field_editor:grid_container)) / 2);
        $int3 = $int2;
    } else {
        $int2 = calc(cc_getx + cc_getwidth / 2 - if_getwidth(clan_field_editor:grid_container) / 2);
        $int3 = calc(cc_gety + cc_getheight / 2 - if_getheight(clan_field_editor:grid_container) / 2);
    }
} else {
    $int2 = calc((if_getscrollwidth(clan_field_editor:grid_container) - if_getwidth(clan_field_editor:grid_container)) / 2);
    $int3 = $int2;
}
if_setscrollpos($int2, $int3, clan_field_editor:grid_container);
~script5053(0, 0);
