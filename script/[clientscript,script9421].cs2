// 9421
[clientscript,script9421](int $int0, int $int1)
sound_vorbis_volume(tli_click_01, 1, 0, 200);
if_sethide(false, 6awe2_rewards:confirm_purchase);
def_struct $struct2 = enum(int, struct, 6awe2_shop_struct, $int0);
def_obj $obj3 = struct_param($struct2, 6awe2_armadyl_object);
def_string $string0 = "Are you sure you want to claim this reward?";
if (stat(defence) < oc_param($obj3, wear_requires_stat_level1)) {
    $string0 = append($string0, "<br><col=ff0000>You require <tostring(oc_param($obj3, wear_requires_stat_level1))> Defence to wear this armour.");
}
def_int $int4 = struct_param($struct2, 6awe2_price);
if (%6awe2_shop_discount > 0) {
    $int4 = scale(95, 100, $int4);
}
$int4 = calc($int4 * $int1);
$string0 = append($string0, "<br>This will cost you <tostring($int4)> renown.");
if_settext($string0, 6awe2_rewards:confirm_details_areyousure);
if (%6awe2_god_allegiance = 3) {
    if_settext(oc_name(struct_param($struct2, 6awe2_armadyl_object)), 6awe2_rewards:confirm_details_name);
    if (struct_param($struct2, 6awe2_notanobject) = 1) {
        if_setobject(null, -1, 6awe2_rewards:confirm_details_item_image);
        if_setgraphic(struct_param($struct2, 6awe2_graphic_armadyl), 6awe2_rewards:confirm_details_item_image);
    } else {
        if_setobject(struct_param($struct2, 6awe2_armadyl_object), -1, 6awe2_rewards:confirm_details_item_image);
    }
} else {
    if_settext(oc_name(struct_param($struct2, 6awe2_bandos_object)), 6awe2_rewards:confirm_details_name);
    if (struct_param($struct2, 6awe2_notanobject) = 1) {
        if_setobject(null, -1, 6awe2_rewards:confirm_details_item_image);
        if_setgraphic(struct_param($struct2, 6awe2_graphic_bandos), 6awe2_rewards:confirm_details_item_image);
    } else {
        if_setobject(struct_param($struct2, 6awe2_bandos_object), -1, 6awe2_rewards:confirm_details_item_image);
    }
}
if_setonop("script9411($int0, 1)", 6awe2_rewards:confirm_button);
