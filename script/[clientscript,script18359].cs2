// 18359
[clientscript,script18359]
switch_int (map_lang) {
    case 0 :
        if_setgraphic(trh195_promo_title_en, trh195:title);
    case 1 :
        if_setgraphic(trh195_promo_title_de, trh195:title);
    case 2 :
        if_setgraphic(trh195_promo_title_fr, trh195:title);
    case 3 :
        if_setgraphic(trh195_promo_title_pt, trh195:title);
}
if_sethide(false, trh195:splash_screen);
if_sethide(true, trh195:universe);
if_settext("Win both brand-new and returning rewards!", trh195:splash_desc);
if_setnpcmodel(trh195_splash_screen_npc_1, trh195:npc_model_1);
if_setmodelanim(human_actor_casual_side_saddle_staff_idle, trh195:npc_model_1);
if_setmodelangle(0, -10, 0, 1900, 0, 500, trh195:npc_model_1);
if_setmodellighting(2000, 1024, 0, 255, 255, 255, 0, 0, 0, reflec_small, trh195:npc_model_1);
if_setnpcmodel(trh195_splash_screen_npc_2, trh195:npc_model_2);
if_setmodelanim(human_actor_casual_side_saddle_staff_idle, trh195:npc_model_2);
if_setmodelangle(0, -10, 0, 1900, 0, 500, trh195:npc_model_2);
if_setmodellighting(2000, 1024, 0, 255, 255, 255, 0, 0, 0, reflec_small, trh195:npc_model_2);
