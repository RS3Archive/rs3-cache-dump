// 15067
[proc,script15067](int $int0, int $int1)(string)
def_string $string0 = "All abilities are hidden by the filter.";
switch_int ($int0) {
    case 3 :
        if (%toplevel_v2_legacy_combat = 1) {
            $int1 = calc($int1 + 1);
        }
        switch_int ($int1) {
            case 0 :
                $int0 = 8;
            case 1 :
                $int0 = 9;
            case 2 :
                $int0 = 10;
            case 3 :
                $int0 = 11;
        }
    case 4 :
        switch_int ($int1) {
            case 0 :
                $int0 = 14;
            case 1 :
                $int0 = 15;
        }
}
switch_int ($int0) {
    case 9, 10, 11 :
        $string0 = "All spells are hidden by the filter.";
    case 15 :
        $string0 = "All incantations are hidden by the filter.";
}
return($string0);
