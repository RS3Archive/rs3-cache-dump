// 19084
[clientscript,script19084](int $int0, int $int1)
if (cc_findbycategory(trh199_overlay:blueprint_grid, $int0, $int1) = 1) {
    switch_graphic (cc_getgraphic) {
        case trh199_blueprint_incomplete :
            cc_setgraphic(trh199_blueprint_incomplete_over);
        case trh199_blueprint_complete :
            cc_setgraphic(trh199_blueprint_complete_over);
        case trh199_blueprint_locked :
            cc_setgraphic(trh199_blueprint_locked_over);
    }
}
