// 6702
[proc,bigchinchompa_hud_timetext](int $int0)(string)
if ($int0 < 0) {
    return("---");
}
def_int $int1 = scale(3, 5, $int0);
if ($int1 <= 3) {
    return("<col=ff0000>- ! -</col>");
}
def_int $int2 = calc($int1 / 60);
$int1 = calc($int1 % 60);
if ($int1 >= 10) {
    return("<tostring($int2)>:<tostring($int1)></col>");
}
return("<tostring($int2)>:0<tostring($int1)></col>");
