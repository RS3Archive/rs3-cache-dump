// 5085
[proc,clan_field_setup_closedropdown](component $component0)
if_sethide(true, clan_field_setup:dropdown_container);
%welcome_screen_time = -1;
cc_deleteall(clan_field_setup:dropdown_options);
def_int $int1 = 0;
def_int $int2 = enum_getoutputcount(clan_field_rules);
while ($int1 < $int2) {
    if (%demomode_create = true) {
        if (cc_find($component0, calc($int1 * 10 + 3)) = true) {
            cc_setgraphic("aif_drop_down_button_1,1");
        }
        if (cc_find($component0, calc($int1 * 10 + 5)) = true) {
            cc_setgraphic("aif_drop_down_button_1,0");
        }
        if (cc_find($component0, calc($int1 * 10 + 7)) = true) {
            cc_setgraphic("aif_drop_down_button_1,2");
        }
    } else {
        if (cc_find($component0, calc($int1 * 10 + 3)) = true) {
            cc_setgraphic("aif_drop_down_button_1,10");
        }
        if (cc_find($component0, calc($int1 * 10 + 5)) = true) {
            cc_setgraphic("aif_drop_down_button_1,9");
        }
        if (cc_find($component0, calc($int1 * 10 + 7)) = true) {
            cc_setgraphic("aif_drop_down_button_1,11");
        }
    }
    $int1 = calc($int1 + 1);
}
