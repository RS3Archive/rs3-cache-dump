// 6288
[clientscript,script6288](int $int0, int $int1)
cc_create(cruc_battle_overlay:brp_layer, ^iftype_text, 0);
cc_setsize(65, 12, ^setsize_abs, ^setsize_abs);
cc_setposition(0, 0, ^setpos_abs_left, ^setpos_abs_top);
cc_settextfont(p11_full);
cc_settextalign(^settextalign_right, ^settextalign_centre, 0);
%cruc_overlay_brp_pause = 0;
if ($int1 = 1) {
    cc_settext("+1 death");
    cc_setcolour(^red);
} else if ($int0 = 1) {
    cc_settext("+1 kill");
    cc_setcolour(^green);
}
cc_settextshadow(true);
if_setontimer("script6289", cruc_battle_overlay:brp_layer);
