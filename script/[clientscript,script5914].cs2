// 5914
[clientscript,script5914](component $component0)
def_string $string0 = "Unlock SILVER at 25% enrage. This will significantly increase your chance at receiving high value items.";
if (%gwd2_solo_current_enrage >= 100) {
    $string0 = "You have a significantly increased chance to receive Telos-related item pieces and other high value items.";
} else if (%gwd2_solo_current_enrage >= 25) {
    $string0 = "Unlock GOLD at 100% enrage. This will significantly increase your chance at receiving Telos-related item pieces.";
}
~script8800($string0, $component0, -1);
