// 10103
[clientscript,script10103](component $component0, int $int1)
def_int $int2 = if_getwidth($component0);
if ($int1 = 0) {
    if_sethide(true, interface_1515:com_30);
    $int2 = scale($int2, 230, 100);
    if (if_getcolour(interface_1515:com_29) = 0xffb400) {
        if_settext("Burn: <tostring($int2)>%", interface_1515:com_30);
    } else if (if_getcolour(interface_1515:com_29) = 0x00c8ff) {
        if_settext("Wall health: <tostring(calc($int2 * 2))>%", interface_1515:com_30);
    } else {
        if_settext("Acidity level: <tostring(%varclient_4274)>%", interface_1515:com_30);
    }
} else {
    if_sethide(true, interface_1515:com_30);
}
