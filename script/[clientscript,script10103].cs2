// 10103
[clientscript,script10103](component $component0, int $int1)
def_int $int2 = if_getwidth($component0);
if ($int1 = 0) {
    if_sethide(true, sb_overlay:progress_text);
    $int2 = scale($int2, 230, 100);
    if (if_getcolour(sb_overlay:progress_graphic) = 0xffb400) {
        if_settext("Burn: <tostring($int2)>%", sb_overlay:progress_text);
    } else if (if_getcolour(sb_overlay:progress_graphic) = 0x00c8ff) {
        if_settext("Wall health: <tostring(calc($int2 * 2))>%", sb_overlay:progress_text);
    } else {
        if_settext("Acidity level: <tostring(%sb_boss_acid_level)>%", sb_overlay:progress_text);
    }
} else {
    if_sethide(true, sb_overlay:progress_text);
}
