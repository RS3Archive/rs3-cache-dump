// 10689
[clientscript,script10689]
def_int $int0 = stat_base(divination);
def_int $int1 = 0;
if (%divdnd_daily_points = 200) {
    $int1 = 0;
} else if (calc(200 - %divdnd_daily_points) > %divdnd_points) {
    $int1 = %divdnd_points;
} else {
    $int1 = calc(200 - %divdnd_daily_points);
}
def_int $int2 = calc($int1 * enum(int, int, divdnd_reward_xp_per_point, $int0));
def_int $int3 = calc(%divdnd_points / 5);
def_string $string0 = "<br>Daily Total: You have earned <tostring(%divdnd_daily_points)>/<tostring(200)>.";
if (%divdnd_points = 0) {
    ~script8800("You don't have any points yet, so you won't get any Divination XP! Get going!<$string0>", divdnd_overlay:points, -1);
} else if ($int1 = 0) {
    if (%divdnd_points < 5) {
        ~script8800("You have already gained the maximum amount of XP from this activity today, so you will not receive any additional XP. However, if you gain 5 points or more, you will still receive Divination-related boosts.<$string0>", divdnd_overlay:points, -1);
    } else if (%divdnd_points < 10) {
        ~script8800("You have already gained the maximum amount of XP from this activity today, so you will not receive any additional XP. However, your Divination-related boosts will last for 1 minute.<$string0>", divdnd_overlay:points, -1);
    } else {
        ~script8800("You have already gained the maximum amount of XP from this activity today, so you will not receive any additional XP. However, your Divination-related boosts will last for <tostring($int3)> minutes.<$string0>", divdnd_overlay:points, -1);
    }
} else if (%divdnd_points < 5) {
    if (%divdnd_points = 1) {
        ~script8800("For 1 point, you will be rewarded with <tostring($int2)> Divination XP. If you gain 5 points or more, you will also receive Divination-related boosts.<$string0>", divdnd_overlay:points, -1);
    } else {
        ~script8800("For <tostring(%divdnd_points)> points, you will be rewarded with <tostring($int2)> Divination XP. If you gain 5 points or more, you will also receive Divination-related boosts.<$string0>", divdnd_overlay:points, -1);
    }
} else if (%divdnd_points < 10) {
    ~script8800("For <tostring(%divdnd_points)> points, you will be rewarded with <tostring($int2)> Divination XP and your Divination-related boosts will last for 1 minute.<$string0>", divdnd_overlay:points, -1);
} else {
    ~script8800("For <tostring(%divdnd_points)> points, you will be rewarded with <tostring($int2)> Divination XP, and your Divination-related boosts will last for <tostring($int3)> minutes.<$string0>", divdnd_overlay:points, -1);
}
