// 4095
[clientscript,script4095]
def_int $int0 = if_gettrans(fmc_darkness:black);
if ($int0 > 75) {
    if_settrans(80, fmc_darkness:black);
    if_settrans(40, fmc_darkness:fade);
    if_setontimer(null, fmc_darkness:black);
    return;
} else {
    if_settrans(calc($int0 + 4), fmc_darkness:black);
    if_settrans(calc(($int0 + 4) / 2), fmc_darkness:fade);
}
