// 4095
[clientscript,script4095]
def_int $int0 = if_gettrans(interface_1202:com_0);
if ($int0 > 75) {
    if_settrans(80, interface_1202:com_0);
    if_settrans(40, interface_1202:com_2);
    if_setontimer(null, interface_1202:com_0);
    return;
} else {
    if_settrans(calc($int0 + 4), interface_1202:com_0);
    if_settrans(calc(($int0 + 4) / 2), interface_1202:com_2);
}
