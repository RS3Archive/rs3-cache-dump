// 4504
[clientscript,script4504](component $component0)
def_int $int1 = if_getnextsubid($component0);
def_int $int2 = -1;
def_int $int3 = 84;
def_int $int4 = if_getheight($component0);
def_int $int5 = -1;
def_string $string0 = "";
while (++$int2 < 7) {
    $int5 = calc($int2 * 84 + $int2 * 4);
    cc_create($component0, ^iftype_rectangle, $int1);
    cc_setsize($int3, $int4, ^setsize_abs, ^setsize_abs);
    cc_setposition($int5, 0, ^setpos_abs_left, ^setpos_abs_top);
    if (%toplevel_v2_legacy_interface = 1 | %toplevel_v2_active_skinset = 1) {
        cc_setcolour(0x33251d);
    } else {
        cc_setcolour(0x1c2c34);
    }
    cc_setfill(true);
    $int1 = calc($int1 + 1);
    $string0 = enum(int, string, days_of_week, $int2);
    cc_create($component0, ^iftype_text, $int1);
    cc_setsize($int3, $int4, ^setsize_abs, ^setsize_abs);
    cc_setposition($int5, 0, ^setpos_abs_left, ^setpos_abs_top);
    cc_settextfont(museo_sans_13pt_regular);
    cc_settextalign(^settextalign_centre, ^settextalign_centre, 0);
    if (%toplevel_v2_legacy_interface = 1 | %toplevel_v2_active_skinset = 1) {
        cc_setcolour(^white);
    } else {
        cc_setcolour(~script10495(3));
    }
    cc_settextshadow(true);
    cc_settext($string0);
    $int1 = calc($int1 + 1);
}
