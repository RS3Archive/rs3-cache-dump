// 6921
[proc,script6921](component $component0, int $int1, int $int2)
if ($int2 = 1) {
    if (testbit(%dueloptions, $int1) = ^true) {
        cc_setgraphic("aif_checkbox_small_2,1");
    } else {
        cc_setgraphic("aif_checkbox_small_2,5");
    }
    .cc_setcolour(~script10495(5));
} else {
    if (testbit(%dueloptions, $int1) = ^true) {
        cc_setgraphic("aif_checkbox_small_2,0");
    } else {
        cc_setgraphic("aif_checkbox_small_2,4");
    }
    .cc_setcolour(~script10495(0));
}
if_setonvartransmit("script6920(event_com, cc_getid, .cc_getid, $int1, $int2, 0){dueloptions}", $component0);
if_setonop("script6922(event_com, cc_getid, .cc_getid, $int1, $int2, event_op)", $component0);
