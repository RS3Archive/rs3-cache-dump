// 16015
[clientscript,script16015](component $component0, int $int1)
def_int $int2 = calc(clientclock % 200);
def_int $int3 = -25;
if ($int2 < 100) {
    $int3 = calc($int3 + scale($int2, 100, 16));
} else {
    $int3 = calc($int3 + scale(calc(200 - $int2), 100, 16));
}
if_setposition(0, $int3, ^setpos_abs_centre, ^setpos_abs_centre, $component0);
