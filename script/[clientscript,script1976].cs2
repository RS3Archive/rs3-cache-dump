// 1976
[clientscript,script1976](component $component0)
switch_component ($component0) {
    case town_side:ability_1_uses :
        if_settext(tostring(%town_game_perk2_uses), $component0);
    case town_side:ability_2_uses :
        if_settext(tostring(%town_game_perk3_uses), $component0);
    case town_side:ability_3_uses :
        if_settext(tostring(%town_game_perk4_uses), $component0);
}
