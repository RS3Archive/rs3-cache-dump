// 11737
[proc,comscenario_update_name](int $int0, component $component1)
if ($component1 = faction_select:button_build_1) {
    %comscenario_faction_pvp_team_1 = $int0;
    if_settext(enum(int, string, comscenario_faction_pvp_factions_string, $int0), faction_select:team_1);
} else {
    %comscenario_faction_pvp_team_2 = $int0;
    if_settext(enum(int, string, comscenario_faction_pvp_factions_string, $int0), faction_select:team_2);
}
~script11734(faction_select:button_build_1, faction_select:button_click_1, faction_select:team_1_scroll, faction_select:team_1_scrollbar);
~script11734(faction_select:button_build_2, faction_select:button_click_2, faction_select:team_2_scroll, faction_select:team_2_scrollbar);
