// 6906
[proc,script6906](int $int0, component $component1)
if (cc_find($component1, 0) = true & .cc_find($component1, 1) = true) {
    if ($int0 = 1) {
        cc_setgraphic("aif_checkbox_small_2,0");
        if_setonmouseover(null, $component1);
        if_setonmouseleave(null, $component1);
    } else {
        cc_setgraphic("aif_checkbox_small_2,4");
        if_setonmouseover("script6907(event_com, 1)", $component1);
        if_setonmouseleave("script6907(event_com, 0)", $component1);
    }
    .cc_setcolour(0xf4b13c);
}
