// 18549
[proc,script18549](dbrow $dbrow0, graphic $graphic1, graphic $graphic2, graphic $graphic3, graphic $graphic4)(graphic, graphic, graphic, graphic)
if (db_getfield($dbrow0, trh182_monsters:col8, 0) = false) {
    if (~script18539 = true) {
        $graphic1 = trh182_background_mixed;
        $graphic2 = trh182_background_swirly_mixed;
    } else if (~script18536 = true) {
        $graphic1 = trh182_background_red;
        $graphic2 = trh182_background_swirly_red;
    } else if (~script18537 = true) {
        $graphic1 = trh182_background_blue;
        $graphic2 = trh182_background_swirly_blue;
        $graphic3 = trh182_tile_reward_blue;
        $graphic4 = trh182_tile_gem_blue;
    } else if (~script18538 = true) {
        $graphic1 = trh182_background_green;
        $graphic2 = trh182_background_swirly_green;
        $graphic3 = trh182_tile_reward_green;
        $graphic4 = trh182_tile_gem_green;
    }
}
return($graphic1, $graphic2, $graphic3, $graphic4);
