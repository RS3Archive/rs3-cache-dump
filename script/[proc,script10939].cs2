// 10939
[proc,script10939](component $component0, int $int1)
switch_component ($component0) {
    case settings:set_build :
        ~settings_slider_update($int1);
    case graphics_options_v2_client_mobile:non_adv_options_build :
        ~script2787($int1);
    case machinima_livecamera:pos_build :
