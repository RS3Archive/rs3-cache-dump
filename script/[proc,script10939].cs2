    case loginscreen:audio_build, loginscreen:mobile_audio_build, lobbyscreen_pane_options:audio_build :
        ~login_setvalue($int1);
    case acc_create:mobile_audio_build :
        ~script15562($int1);
    case tut_options:mobile_audio_build :
