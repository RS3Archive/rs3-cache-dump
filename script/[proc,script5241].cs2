// 5241
[proc,script5241](struct $struct0)(int)
def_int $int1 = struct_param($struct0, potion_info_prayer_abs);
def_int $int2 = struct_param($struct0, potion_info_prayer_pcent);
if ($int2 > 0 & (inv_total(inv, deal_wrench_blessed) > 0 | inv_total(worn, deal_wrench_blessed) > 0)) {
    $int2 = calc($int2 + 2);
}
return(calc($int1 + scale(~script7081, 100, $int2)));
