// 16612
[proc,trh_setup_tooltip](string $string0)
if (~is_mobile_client = true) {
    cc_setop(1, "Information");
    cc_setonop("script7774($string0, event_com, event_comsubid, 2)");
} else {
    cc_setonmouserepeat("script7774($string0, event_com, event_comsubid, 2)");
    cc_setonmouseleave("script16608");
}
