// 3516
[proc,script3516](int $int0, component $component1, component $component2)
if (if_getscrolly($component1) > $int0) {
    if_setscrollpos(0, 0, $component1);
}
if ($int0 > if_getheight($component1)) {
    if_setsize(16, 60, ^setsize_minus, ^setsize_minus, $component1);
    if_setscrollsize(0, $int0, $component1);
    ~rs3_scrollbar_vertical($component2, $component1);
} else {
    if_setsize(0, 60, ^setsize_minus, ^setsize_minus, $component1);
    if_setscrollpos(0, 0, $component1);
    if_setscrollsize(0, 0, $component1);
    cc_deleteall($component2);
}
