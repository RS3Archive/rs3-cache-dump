// 18845
[proc,script18845]
switch_int (map_lang) {
    case 0 :
        if_setgraphic(trh148_title_en, trh148_overlay:splash_title);
    case 1 :
        if_setgraphic(trh148_title_de, trh148_overlay:splash_title);
    case 2 :
        if_setgraphic(trh148_title_fr, trh148_overlay:splash_title);
    case 3 :
        if_setgraphic(trh148_title_pt, trh148_overlay:splash_title);
}
if_setnpcmodel(trh148_torva_npc, trh148_overlay:npc_model);
if_setmodelangle(0, 0, 100, 100, 0, 550, trh148_overlay:npc_model);
if_setmodelanim(mtx_ats_player_proud_idle, trh148_overlay:npc_model);
