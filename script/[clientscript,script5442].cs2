// 5442
[clientscript,script5442]
sound_vorbis_volume(clans_interface_click, 1, 0, 255);
if_sethide(true, dom_free:boss_info_layer);
if_sethide(false, dom_free:handicaps_info_layer);
if_sethide(false, dom_free:scroll_layer_handicaps);
if_sethide(true, dom_free:scroll_layer_boss_info);
if_setcolour(0xf5b241, dom_free:boss_details_tab_text);
if_setcolour(^white, dom_free:handicaps_tab_text);
%dom_free_current_tab_info_handicaps = 1;
