// 15975
[clientscript,script15975](dbrow $dbrow0)
def_component $component1 = toplevel_v2_extra_action_button:button_graphic_cooldown;
if_sethide(false, $component1);
def_int $int2 = db_getfield($dbrow0, extra_action_button:col6, 0);
if ($int2 = 0) {
    return;
}
def_int $int3 = calc(clientclock + $int2 * 30);
if_setontimer("script15976($component1, clientclock, $int3)", $component1);
