// 2927
[proc,loginscreen_link_highlight](component $component0, component $component1, string $string0, fontmetrics $fontmetrics2, int $int3)
if ($component0 ! null) {
    if ($int3 = 1) {
        if_settext("<u=FAFAFA><$string0></u>", $component1);
        if_setcolour(0xfafafa, $component1);
        if_setsize(stringwidth($string0, $fontmetrics2), if_getheight($component0), ^setsize_abs, ^setsize_abs, $component0);
    } else {
        if_settext("<u=C8C8C8><$string0></u>", $component1);
        if_setcolour(0xc8c8c8, $component1);
        if_setsize(stringwidth($string0, $fontmetrics2), if_getheight($component0), ^setsize_abs, ^setsize_abs, $component0);
    }
}
