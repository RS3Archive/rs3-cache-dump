switch_struct ($struct0) {
    case toplevel_v2_window_size_chat_modern :
        if (%toplevel_v2_legacy_interface = 0 & %toplevel_v2_mobile_interface = 0 & %toplevel_v2_chat_style = 1) {
            return(toplevel_v2_window_size_chat_classic);
        }
    case toplevel_v2_window_size_minimap :
        if (%toplevel_v2_minimap_shape = 1) {
