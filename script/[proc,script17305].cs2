// 17305
[proc,script17305]
if (if_getgraphic(trh192_overlay:fire_btn_graphic) = null) {
    switch_int (map_lang) {
        case default :
            if (%trh192_trueshot_state = 1) {
                if_setgraphic(trh192_fire_btn_trueshot_en, trh192_overlay:fire_btn_graphic);
            } else {
                if_setgraphic(trh192_fire_btn_en, trh192_overlay:fire_btn_graphic);
            }
        case 2 :
            if (%trh192_trueshot_state = 1) {
                if_setgraphic(trh192_fire_btn_trueshot_fr, trh192_overlay:fire_btn_graphic);
            }
            if_setgraphic(trh192_fire_btn_fr, trh192_overlay:fire_btn_graphic);
        case 1 :
            if (%trh192_trueshot_state = 1) {
                if_setgraphic(trh192_fire_btn_trueshot_de, trh192_overlay:fire_btn_graphic);
            }
            if_setgraphic(trh192_fire_btn_de, trh192_overlay:fire_btn_graphic);
        case 3 :
            if (%trh192_trueshot_state = 1) {
                if_setgraphic(trh192_fire_btn_trueshot_pt, trh192_overlay:fire_btn_graphic);
            }
            if_setgraphic(trh192_fire_btn_pt, trh192_overlay:fire_btn_graphic);
    }
}
