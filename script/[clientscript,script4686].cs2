// 4686
[clientscript,script4686]
if (%loy_wave_examine >= 160) {
    return;
} else if (%loy_wave_examine_stop = 1) {
    %loy_wave_examine = 160;
    if_setposition(0, 75, ^setpos_abs_left, ^setpos_abs_top, loy_waves:examine_background);
    return;
} else if (%loy_wave_examine = 158) {
    if_sethide(true, loy_waves:examine_background);
} else {
    if_setposition(calc(-2 - %loy_wave_examine), 75, ^setpos_abs_left, ^setpos_abs_top, loy_waves:examine_background);
    %loy_wave_examine = calc(%loy_wave_examine + 2);
}
