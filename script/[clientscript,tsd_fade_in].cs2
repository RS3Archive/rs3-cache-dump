// 7575
[clientscript,tsd_fade_in]
def_int $int0 = if_gettrans(tsd_sliske_entrance:black);
if ($int0 >= 225) {
    if_settrans(235, tsd_sliske_entrance:black);
    if_setontimer(null, tsd_sliske_entrance:base);
} else {
    $int0 = calc($int0 + 8);
    if_settrans($int0, tsd_sliske_entrance:black);
}
