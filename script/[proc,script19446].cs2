// 19446
[proc,script19446](npc $npc0, npc $npc1, struct $struct2, struct $struct3, struct $struct4, component $component5, component $component6, component $component7)
if (~script19320 = true) {
    switch_npc ($npc0) {
        case group_ironman_preview_npc_tier1_male :
            $npc0 = group_ironman_preview_npc_tier1_competitive_male;
            $npc1 = group_ironman_preview_npc_tier1_competitive_female;
        case group_ironman_preview_npc_tier3_male :
            $npc0 = group_ironman_preview_npc_tier3_competitive_male;
            $npc1 = group_ironman_preview_npc_tier3_competitive_female;
    }
}
if_sethide(false, $component5);
if_setnpcmodel($npc0, $component5);
if_setmodelanim(struct_param($struct2, emotes2_player_anim), $component5);
if_setmodelangle(0, 120, 0, 0, 0, 700, $component5);
if_sethide(false, $component6);
if_setnpcmodel($npc1, $component6);
if_setmodelanim(struct_param($struct3, emotes2_player_anim), $component6);
if_setmodelangle(-80, 80, 0, 0, 0, 800, $component6);
if_sethide(false, $component7);
if_setnpcmodel($npc0, $component7);
if_setmodelanim(struct_param($struct4, emotes2_player_anim), $component7);
if_setmodelangle(80, 80, 0, 0, 0, 800, $component7);
