// 561
[clientscript,script561](component $component0)
def_coord $coord1 = ~script284(coord);
switch_int (%pnr_monkey_task_camera) {
    case 1 :
        ~fadeout(0, 50, $component0);
    case 2 :
        ~fadein(50, $component0);
    case 3 :
        spline_new(0, 3);
        spline_new(1, 3);
        spline_addpoint(0, 0, ~script565($coord1, 4, 6), 600, ~script565($coord1, 5, 5), 600, 0);
        spline_addpoint(1, 0, ~script565($coord1, 1, -8), 250, ~script565($coord1, 0, -6), 250, 0);
        spline_addpoint(0, 1, ~script565($coord1, 8, -1), 700, ~script565($coord1, 8, -4), 700, 0);
        spline_addpoint(1, 1, ~script565($coord1, 0, 0), 400, ~script565($coord1, 0, 2), 400, 0);
        spline_addpoint(0, 2, ~script565($coord1, 4, -7), 700, ~script565($coord1, 3, -8), 700, 0);
        spline_addpoint(1, 2, ~script565($coord1, 3, 6), 400, ~script565($coord1, 4, 7), 400, 0);
        cam_movealong(0, 0, 500, 500, 1, 0);
        if_setoncamfinished("script563($component0, 1, 500, 500)", $component0);
    case 4 :
        spline_new(0, 4);
        spline_new(1, 4);
        spline_addpoint(0, 0, ~script565($coord1, 4, 6), 600, ~script565($coord1, 4, 5), 600, 0);
        spline_addpoint(1, 0, ~script565($coord1, 1, -8), 250, ~script565($coord1, -1, -7), 250, 0);
        spline_addpoint(0, 1, ~script565($coord1, 7, 1), 600, ~script565($coord1, 8, -1), 600, 0);
        spline_addpoint(1, 1, ~script565($coord1, -1, -4), 300, ~script565($coord1, -1, -3), 300, 0);
        spline_addpoint(0, 2, ~script565($coord1, 6, -4), 600, ~script565($coord1, 5, -6), 600, 0);
        spline_addpoint(1, 2, ~script565($coord1, 1, 2), 300, ~script565($coord1, 1, 2), 300, 0);
        spline_addpoint(0, 3, ~script565($coord1, 2, -8), 600, ~script565($coord1, 1, -8), 600, 0);
        spline_addpoint(1, 3, ~script565($coord1, 4, 6), 250, ~script565($coord1, 4, 7), 300, 0);
        cam_movealong(0, 0, 800, 800, 1, 0);
        if_setoncamfinished("script563($component0, 1, 800, 800)", $component0);
}
