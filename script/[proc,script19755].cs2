// 19755
[proc,script19755](int $int0)(material)
def_material $material1 = null;
if (%trh205_prize_option_chosen = 1) {
    switch_int ($int0) {
        case default :
            $material1 = mtx_parcel_roses_floral_white;
        case 2 :
            $material1 = mtx_parcel_roses_floral_yellow;
        case 3 :
            $material1 = mtx_parcel_roses_floral_orange;
        case 4 :
            $material1 = mtx_parcel_roses_floral_red;
        case 5 :
            $material1 = mtx_parcel_roses_floral_purple;
    }
} else {
    switch_int ($int0) {
        case default :
            $material1 = mtx_parcel_roses_gothic_white;
        case 2 :
            $material1 = mtx_parcel_roses_gothic_yellow;
        case 3 :
            $material1 = mtx_parcel_roses_gothic_orange;
        case 4 :
            $material1 = mtx_parcel_roses_gothic_red;
        case 5 :
            $material1 = mtx_parcel_roses_gothic_purple;
    }
}
return($material1);
