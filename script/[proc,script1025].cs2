// 1025
[proc,script1025](component $component0, int $int1, fontmetrics $fontmetrics2, fontmetrics $fontmetrics3, fontmetrics $fontmetrics4)
if ($int1 = -1) {
    if (if_find($component0) = true) {
        cc_settextfont(~script12028($fontmetrics2, $fontmetrics3, $fontmetrics4, cc_gettext, cc_getwidth, cc_getheight));
