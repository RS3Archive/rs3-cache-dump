// 14844
[proc,arch_relic_update_info](component $component0, component $component1, component $component2, component $component3, component $component4, dbrow $dbrow5)
if ($dbrow5 ! null) {
    if ($component0 ! null) {
        if_setgraphic(db_getfield($dbrow5, arch_relic:col8, 0), $component0);
    }
    if ($component1 ! null & $component2 ! null) {
        if_sethide(false, $component1);
        if_sethide(false, $component2);
        if_settext(tostring_localised(~script14612($dbrow5), true), $component2);
    }
    if ($component3 ! null) {
        if_settext(db_getfield($dbrow5, arch_relic:col1, 0), $component3);
    }
    if ($component4 ! null) {
        if_settext(~arch_relic_get_description($dbrow5), $component4);
    }
} else {
    if ($component0 ! null) {
        if_setgraphic(null, $component0);
    }
    if ($component1 ! null) {
        if_sethide(true, $component1);
    }
    if ($component2 ! null) {
        if_sethide(true, $component1);
    }
    if ($component3 ! null) {
        if_settext("No Relic Power", $component3);
    }
    if ($component4 ! null) {
        if_settext("", $component4);
    }
}
