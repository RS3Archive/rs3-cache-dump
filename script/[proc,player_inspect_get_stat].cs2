// 10781
[proc,player_inspect_get_stat](stat $stat0)(int)
switch_stat ($stat0) {
    case attack :
        return(%player_inspect_stat_attack);
    case hitpoints :
        return(%player_inspect_stat_constitution);
    case mining :
        return(%player_inspect_stat_mining);
    case strength :
        return(%player_inspect_stat_strength);
    case agility :
        return(%player_inspect_stat_agility);
    case smithing :
        return(%player_inspect_stat_smithing);
    case defence :
        return(%player_inspect_stat_defence);
    case herblore :
        return(%player_inspect_stat_herblore);
    case fishing :
        return(%player_inspect_stat_fishing);
    case ranged :
        return(%player_inspect_stat_ranged);
    case thieving :
        return(%player_inspect_stat_thieving);
    case cooking :
        return(%player_inspect_stat_cooking);
    case prayer :
        return(%player_inspect_stat_prayer);
    case crafting :
        return(%player_inspect_stat_crafting);
    case firemaking :
        return(%player_inspect_stat_firemaking);
    case magic :
        return(%player_inspect_stat_magic);
    case fletching :
        return(%player_inspect_stat_fletching);
    case woodcutting :
        return(%player_inspect_stat_woodcutting);
    case runecraft :
        return(%player_inspect_stat_runecraft);
    case slayer :
        return(%player_inspect_stat_slayer);
    case farming :
        return(%player_inspect_stat_farming);
    case construction :
        return(%player_inspect_stat_construction);
    case hunter :
        return(%player_inspect_stat_hunter);
    case summoning :
        return(%player_inspect_stat_summoning);
    case dungeoneering :
        return(%player_inspect_stat_dungeoneering);
    case divination :
        return(%player_inspect_stat_divination);
    case invention :
        return(%player_inspect_stat_invention);
    case archaeology :
        return(%player_inspect_stat_archaeology);
    case necromancy :
        return(%player_inspect_stat_necromancy);
    case default :
        return(-1);
}
