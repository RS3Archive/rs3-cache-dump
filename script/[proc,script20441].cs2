// 20441
[proc,script20441](int $int0, string $string0, int $int1, string $string1, obj $obj2, obj $obj3)
def_string $string2 = "";
def_boolean $boolean4 = true;
if ($int1 = 0) {
    $string2 = $string0;
    $boolean4 = false;
} else if (~script11201(anniversary_skillcapes_token) = true) {
    $string2 = "Hand in your last inversion token before choosing another skill to focus on.";
    $boolean4 = false;
} else if ($int0 ! %anniversary_skillcapes_current_focus) {
    $string2 = "Focus on <$string0> to earn shards towards your <$string1>!";
    if (%anniversary_skillcapes_current_focus ! 0 & ~script20432($int0, ~script20424($int0)) = 1) {
        $string2 = "<$string2> <col=EB2F2F>Changing your focussed skill will remove all upgrade shards.";
    }
    $boolean4 = true;
} else {
    $string2 = "Train <$string0> to earn shards towards your <$string1>!";
    $boolean4 = false;
}
if_settext($string2, timed_event:anniversary_skillcapes_tracker_layer_text);
if_settextalign(^settextalign_centre, ^settextalign_centre, 0, timed_event:anniversary_skillcapes_tracker_layer_text);
if (if_find(timed_event:anniversary_skillcapes_selected_cape_layer) = true) {
    if (cc_param(toplevel_v2_tooltip_item) ! $obj2) {
        if_setmodel(null, timed_event:anniversary_skillcapes_selected_cape_model_normal);
        if_setmodel(null, timed_event:anniversary_skillcapes_selected_cape_model);
        if (%anniversary_skillcapes_current_focus > 0 | %anniversary_skillcapes_new_focus > 0) {
            if_sethide(false, timed_event:anniversary_skillcapes_spinner);
        } else {
            if_sethide(true, timed_event:anniversary_skillcapes_spinner);
        }
        cc_setparam(toplevel_v2_tooltip_item, $obj2);
    } else {
        if_sethide(true, timed_event:anniversary_skillcapes_spinner);
    }
}
if ($obj3 ! null) {
    ~script3536("Left: Regular skillcape.<br>Right: Inverted skillcape.", timed_event:icon_holder_capes, -1);
} else {
    ~script16247(timed_event:icon_holder_capes, -1);
}
if_sethide(~negate_bool($boolean4), timed_event:anniversary_skillcapes_focus_button);
