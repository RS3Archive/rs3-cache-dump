// 6107
[proc,shop_clear_item_info]
if_settext("Select an item", shop_main:item_name);
if_setobject(null, -1, shop_main:item_icon);
if_settext("N/A", shop_main:total_value);
def_int $int0 = parawidth(if_gettext(shop_main:total_value), if_getwidth(shop_main:total_bounding_layer), museo_sans_11pt_regular);
if_setsize($int0, 15, ^setsize_abs, ^setsize_abs, shop_main:total_layer);
if_settext("", shop_main:item_description);
if_settext("", shop_main:item_info);
if_settext("", shop_main:item_more_info);
if_settext("Transaction:", shop_main:selected_quantity_title);
if_settext("Price:", shop_main:total_title);
if_setgraphic(null, shop_main:total_icon);
if_sethide(true, shop_side:select_reticule);
if_sethide(false, shop_main:quantity_disabled);
if_sethide(false, shop_main:buy_disabled);
if_setcolour(0x827f79, shop_main:buy_text);
if_settext("N/A", shop_main:buy_text);
if_sethide(true, shop_main:sell_confirm_layer);
if_setgraphic(null, shop_main:item_no_use);
if_setonmouserepeat(null, shop_main:item_no_use);
~shop_clear_highlights;
