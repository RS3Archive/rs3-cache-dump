// 5555
[proc,script5555](int $int0, int $int1)
if ($int0 = 0 & $int1 = 0) {
    if_settext("---", lore_stats_side:animal_time_left);
    if_settext("---", lore_stats_side:animal_fixed_time_left);
    return;
}
if ($int1 = 0) {
    if_settext("<tostring($int0)>:00", lore_stats_side:animal_time_left);
    if_settext("<tostring($int0)>:00", lore_stats_side:animal_fixed_time_left);
} else {
    if_settext("<tostring($int0)>:30", lore_stats_side:animal_time_left);
    if_settext("<tostring($int0)>:30", lore_stats_side:animal_fixed_time_left);
}
