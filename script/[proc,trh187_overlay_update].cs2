// 14137
[proc,trh187_overlay_update]
def_dbrow $dbrow0 = null;
def_component $component1 = null;
def_component $component2 = null;
def_component $component3 = null;
def_component $component4 = null;
def_component $component5 = null;
def_component $component6 = null;
def_component $component7 = null;
def_int $int8 = 0;
while (++$int8 <= 3) {
    switch_int ($int8) {
        case 1 :
            $dbrow0 = ~trh_get_monster(%trh187_monster_1);
            $component2 = trh187_overlay:monster_model_1;
            $component1 = trh187_overlay:monster_layer_1;
            $component3 = trh187_overlay:monster_name_1;
            $component4 = trh187_overlay:monster_rarity_1;
            $component5 = trh187_overlay:monster_gem_1;
            $component6 = trh187_overlay:monster_smokepuff_1;
            $component7 = trh187_overlay:monster_plus_1;
        case 2 :
            $dbrow0 = ~trh_get_monster(%trh187_monster_2);
            $component2 = trh187_overlay:monster_model_2;
            $component1 = trh187_overlay:monster_layer_2;
            $component3 = trh187_overlay:monster_name_2;
            $component4 = trh187_overlay:monster_rarity_2;
            $component5 = trh187_overlay:monster_gem_2;
            $component6 = trh187_overlay:monster_smokepuff_2;
            $component7 = trh187_overlay:monster_plus_2;
        case 3 :
            $dbrow0 = ~trh_get_monster(%trh187_monster_3);
            $component2 = trh187_overlay:monster_model_3;
            $component1 = trh187_overlay:monster_layer_3;
            $component3 = trh187_overlay:monster_name_3;
            $component4 = trh187_overlay:monster_rarity_3;
            $component5 = trh187_overlay:monster_gem_3;
            $component6 = trh187_overlay:monster_smokepuff_3;
            $component7 = trh187_overlay:monster_plus_3;
    }
    ~script16787($component1, $dbrow0);
    if (%trh_custom_reward_delay_in_progress = false) {
        if_setmodelanim(null, $component2);
        if_setnpcmodel(null, $component2);
        if_setgraphic(null, $component5);
        if_setgraphic(null, $component7);
        if_settext("", $component3);
        if_settext("", $component4);
        if_setontimer("script14138(calc(($int8 - 1) * 15), $component1, $component2, $component3, $component4, $component5, $component6, $dbrow0)", $component1);
        %trh187_kill_monster = false;
    }
    if_setmodellighting(256, 1024, 0, 255, 255, 255, 3, -2, -6, reflec_small, $component2);
}
