// 4285
[clientscript,clan_create_text_input](component $component0, component $component1, char $char2, int $int3, component $component4)
%clan_create_input_varc = if_gettext($component0);
switch_int ($int3) {
    case 84 :
        ~clan_create_return;
    case 13 :
        if (~cancel_targetmode = true) {
            return;
        }
        ~clan_create_return;
    case 96, 97, 98, 99, 102, 103 :
        if (keyheld_shift = false) {
            return;
        }
        ~script1553($int3, %clan_create_input_caret_varc, %clan_create_input_varc);
    case 85 :
        if (string_length(%clan_create_input_varc) > 0) {
            %clan_create_input_varc = substring(%clan_create_input_varc, 0, calc(string_length(%clan_create_input_varc) - 1));
        }
    case default :
        if (string_length(%clan_create_input_varc) < 20) {
            %clan_create_input_varc = ~add_to_inputstring(%clan_create_input_varc, 0, $int3, $char2);
        }
}
%clan_create_input_caret_varc = ~script1552(%clan_create_input_caret_varc, %clan_create_input_varc, museo_sans_11pt_regular, $component0, -1);
if_setposition(%clan_create_input_caret_varc, if_gety($component4), ^setpos_abs_left, ^setpos_abs_top, $component4);
if_settext("<tostring(string_length(%clan_create_input_varc))>/20", $component1);
if (string_length(%clan_create_input_varc) >= 15) {
    if_setcolour(0xdd0000, $component1);
} else {
    if_setcolour(0x1f1d19, $component1);
}
if_settext(%clan_create_input_varc, $component0);
