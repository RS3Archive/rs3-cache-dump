// 11960
[clientscript,script11960](component $component0)
def_int $int1 = 0;
def_component $component2 = null;
switch_component ($component0) {
    case tutisland_lev:fish1_model :
        $int1 = %tutisland_lev_fish1;
        $component2 = tutisland_lev:fish1_type;
    case tutisland_lev:fish2_model :
        $int1 = %tutisland_lev_fish2;
        $component2 = tutisland_lev:fish2_type;
    case tutisland_lev:fish3_model :
        $int1 = %tutisland_lev_fish3;
        $component2 = tutisland_lev:fish3_type;
}
switch_int ($int1) {
    case 0 :
        if_setmodel(null, $component0);
        if_settext("None", $component2);
    case 1 :
        if_setmodel(farming_snape_grass_seed_5_inv, $component0);
        if_settext("Sweet", $component2);
    case 2 :
        if_setmodel(elf_crystal_bole_seed_5_inv, $component0);
        if_settext("Sour", $component2);
    case 3 :
        if_setmodel(farming_barberry_seed_5_inv, $component0);
        if_settext("Spicy", $component2);
    case 4 :
        if_setmodel(farming_butterfly_flower_seed_5_inv, $component0);
        if_settext("Bitter", $component2);
    case 5 :
        if_setmodel(farming_reed_seed_5_inv, $component0);
        if_settext("Mellow", $component2);
    case 6 :
        if_setmodel(farming_potato_cactus_seed_5_inv, $component0);
        if_settext("Salty", $component2);
}
