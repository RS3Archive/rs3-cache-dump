// 11504
[proc,script11504](component $component0, component $component1)
if_sethide(false, $component0);
if_sethide(false, $component1);
if ($component0 ! fishcomp_rewards_shop:fish_tab_selected_layer) {
    if_sethide(true, fishcomp_rewards_shop:fish_tab_selected_layer);
}
if ($component0 ! fishcomp_rewards_shop:buff_tab_selected_layer) {
    if_sethide(true, fishcomp_rewards_shop:buff_tab_selected_layer);
}
if ($component1 ! fishcomp_rewards_shop:raw_fish_outer_layer) {
    if_sethide(true, fishcomp_rewards_shop:raw_fish_outer_layer);
}
if ($component1 ! fishcomp_rewards_shop:buff_outer_layer) {
    if_sethide(true, fishcomp_rewards_shop:buff_outer_layer);
}
switch_component ($component0) {
    case fishcomp_rewards_shop:fish_tab_selected_layer :
        %fishcomp_rewards_shop_extras_tab = 0;
    case fishcomp_rewards_shop:buff_tab_selected_layer :
        %fishcomp_rewards_shop_extras_tab = 1;
}
