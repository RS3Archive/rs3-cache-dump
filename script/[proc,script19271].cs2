// 19271
[proc,script19271](graphic $graphic0, graphic $graphic1, component $component2, component $component3)
if (if_getgraphic($component2) ! $graphic1) {
    if_setgraphic($graphic0, $component2);
}
if_setonmouseover("graphic_swapper($component2, $graphic1)", $component3);
if_setonmouseleave("graphic_swapper($component2, $graphic0)", $component3);
