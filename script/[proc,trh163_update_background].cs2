// 4579
[proc,trh163_update_background](int $int0)
if ($int0 = 1) {
    if_setgraphic(trh163_bonus_background, wheel_of_fortune:background);
    if_sethide(false, wheel_of_fortune:bonus_feature_counter_layer);
    if_sethide(false, wheel_of_fortune:bonus_feature_info_layer);
} else {
    if_setgraphic(trh163_background, wheel_of_fortune:background);
    if_sethide(true, wheel_of_fortune:bonus_feature_counter_layer);
    if_sethide(true, wheel_of_fortune:bonus_feature_info_layer);
}
