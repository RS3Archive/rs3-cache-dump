[proc,trh163_update_background](int $int0)
if ($int0 = 1) {
    if_setgraphic(trh163_bonus_background, interface_1253:com_5);
    if_sethide(false, interface_1253:com_80);
    if_sethide(false, interface_1253:com_75);
} else {
    if_setgraphic(trh163_background, interface_1253:com_5);
    if_sethide(true, interface_1253:com_80);
    if_sethide(true, interface_1253:com_75);
}
