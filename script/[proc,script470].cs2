// 470
[proc,script470](obj $obj0, int $int1)(int, int)
if ($obj0 = null & %skillcape_perks_obj ! null) {
    $obj0 = %skillcape_perks_obj;
}
switch_obj ($obj0) {
    case njcapes_gatherer_cape :
        switch_int ($int1) {
            case 1 :
                return(%skillcape_perks_gatherer_stored_1, %skillcape_perks_gatherer_stored_1_master);
            case 2 :
                return(%skillcape_perks_gatherer_stored_2, %skillcape_perks_gatherer_stored_2_master);
        }
    case njcapes_combat_cape :
        switch_int ($int1) {
            case 1 :
                return(%skillcape_perks_combat_stored_1, %skillcape_perks_combat_stored_1_master);
            case 2 :
                return(%skillcape_perks_combat_stored_2, %skillcape_perks_combat_stored_2_master);
        }
    case njcapes_artisan_cape :
        switch_int ($int1) {
            case 1 :
                return(%skillcape_perks_artisan_stored_1, %skillcape_perks_artisan_stored_1_master);
            case 2 :
                return(%skillcape_perks_artisan_stored_2, %skillcape_perks_artisan_stored_2_master);
        }
    case njcapes_support_cape :
        switch_int ($int1) {
            case 1 :
                return(%skillcape_perks_support_stored_1, %skillcape_perks_support_stored_1_master);
            case 2 :
                return(%skillcape_perks_support_stored_2, %skillcape_perks_support_stored_2_master);
        }
    case default :
        switch_int ($int1) {
            case 1 :
                return(%skillcape_perks_stored1, %skillcape_perks_stored1_master);
            case 2 :
                return(%skillcape_perks_stored2, %skillcape_perks_stored2_master);
            case 3 :
                return(%skillcape_perks_stored3, %skillcape_perks_stored3_master);
        }
}
