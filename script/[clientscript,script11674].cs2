// 11674
[clientscript,script11674]
def_component $component0 = null;
def_string $string0 = "";
def_string $string1 = "";
def_int $int1 = 0;
def_enum $enum2 = thas_components;
def_string $string2 = "";
while ($int1 < enum_getoutputcount($enum2)) {
    $component0 = enum(int, component, $enum2, $int1);
    if ($component0 ! null) {
        $string2 = enum(int, string, thas_locations, $int1);
        $string0 = "Teleport";
        $string1 = "Quick Teleport";
        if (%quick_tele_by_default = 1) {
            $string0 = "Quick Teleport";
            $string1 = "Teleport";
        }
        if_setop(1, $string0, $component0);
        if_setop(2, $string1, $component0);
        if_setopbase("<col=FFFFFF><$string2>", $component0);
    }
    $int1 = calc($int1 + 1);
}
~script9286;
~script13513;
