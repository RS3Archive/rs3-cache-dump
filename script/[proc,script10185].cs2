// 10185
[proc,script10185]
def_int $int0 = 0;
while ($int0 <= 15) {
    if (cc_find(bank:tabs_spacers, $int0) = true) {
        cc_sethide(true);
    }
    if (cc_find(bank:tabs_click, $int0) = true) {
        cc_sethide(true);
    }
    if (cc_find(bank:tabs_icons, $int0) = true) {
        cc_sethide(true);
    }
    $int0 = calc($int0 + 1);
}
