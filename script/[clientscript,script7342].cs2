// 7342
[clientscript,script7342](int $int0)
switch_int ($int0) {
    case 1 :
        if (if_getgraphic(trh160_overlay:button_head_image) ! container_unlock_qps_active) {
            if_setgraphic(container_unlock_qps_highlight, trh160_overlay:button_head_image);
        }
    case 2 :
        if (if_getgraphic(trh160_overlay:button_body_image) ! container_unlock_qps_active) {
            if_setgraphic(container_unlock_qps_highlight, trh160_overlay:button_body_image);
        }
    case 3 :
        if (if_getgraphic(trh160_overlay:button_legs_image) ! container_unlock_qps_active) {
            if_setgraphic(container_unlock_qps_highlight, trh160_overlay:button_legs_image);
        }
    case 4 :
        if (if_getgraphic(trh160_overlay:button_feet_gloves_image) ! container_unlock_qps_active) {
            if_setgraphic(container_unlock_qps_highlight, trh160_overlay:button_feet_gloves_image);
        }
    case 5 :
        if (if_getgraphic(trh160_overlay:button_cloak_image) ! container_unlock_qps_active) {
            if_setgraphic(container_unlock_qps_highlight, trh160_overlay:button_cloak_image);
        }
    case 6 :
        if (if_getgraphic(trh160_overlay:button_lamp_image) ! container_unlock_qps_active) {
            if_setgraphic(container_unlock_qps_highlight, trh160_overlay:button_lamp_image);
        }
}
