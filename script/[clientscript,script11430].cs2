// 11430
[clientscript,script11430](int $int0)
%mobile_interface_mode_client = %mobile_interface_mode;
if (%mobile_interface_mode = 1) {
    if_setgraphic(btn_mobile_combat_active, toplevel_v2_combat_bar_mobile:combat_mode_button_icon);
} else {
    if_setgraphic(btn_mobile_combat, toplevel_v2_combat_bar_mobile:combat_mode_button_icon);
}
