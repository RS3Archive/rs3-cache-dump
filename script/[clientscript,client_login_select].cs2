// 4089
[clientscript,client_login_select]
if (~is_mobile_client = true) {
    sound_vorbis_volume(sound_36961, 1, 0, 120);
    sso_logout;
    ~loginscreen_load_overlay(16);
} else if (platformtype = ^platformtype_jagex) {
    ~script426("To change the account you are logged in to please close the game client and change account in the Jagex Launcher.", interface_744:com_87, -1, 0);
}
