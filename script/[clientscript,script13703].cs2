// 13703
[clientscript,script13703]
def_component $component0 = null;
def_int $int1 = 1;
def_int $int2 = -1;
def_int $int3 = -1;
def_int $int4 = -1;
def_int $int5 = -1;
while ($int1 < 4) {
    switch_int ($int1) {
        case 1 :
            $component0 = trh128_overlay:yellow;
            $int2 = -50;
            $int4 = 9;
            $int3 = -44;
            $int5 = 17;
        case 2 :
            $component0 = trh128_overlay:orange;
            $int2 = 0;
            $int4 = 9;
            $int3 = 0;
            $int5 = 17;
        case 3 :
            $component0 = trh128_overlay:red;
            $int2 = 50;
            $int4 = 9;
            $int3 = 44;
            $int5 = 17;
        case default :
            return;
    }
    if (if_find($component0) = true) {
        if (%trh128_golden_glow_rarity = $int1) {
            cc_setontimer("script12631(event_com, event_comsubid)");
            cc_setparam(rs3tli_component_rotation_type, 3);
            cc_setsize(48, 68, ^setsize_abs, ^setsize_abs);
            cc_settrans(20);
            cc_setposition($int2, $int4, ^setpos_abs_centre, ^setpos_abs_top);
        } else {
            cc_setontimer(null);
            cc_settrans(80);
            cc_set2dangle(0);
            cc_setsize(36, 51, ^setsize_abs, ^setsize_abs);
            cc_setposition($int3, $int5, ^setpos_abs_centre, ^setpos_abs_top);
        }
    }
    $int1 = calc($int1 + 1);
}
