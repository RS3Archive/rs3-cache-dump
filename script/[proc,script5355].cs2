// 5355
[proc,script5355](int $int0)(string)
switch_int ($int0) {
    case 3, 4, 5 :
        if (stat_base(dungeoneering) < 10) {
            return("This slot is unlocked at level <tostring(10)> Dungeoneering.");
        }
    case 6, 7, 8 :
        if (stat_base(dungeoneering) < 40) {
            return("This slot is unlocked at level <tostring(40)> Dungeoneering.");
        }
    case 9, 10, 11 :
        if (stat_base(dungeoneering) < 80) {
            return("This slot is unlocked at level <tostring(80)> Dungeoneering.");
        }
    case 12, 13, 14 :
        if (stat_base(dungeoneering) < 110) {
            return("This slot is unlocked at level <tostring(110)> Dungeoneering.");
        }
}
return("This slot is unlocked at a higher Dungeoneering level.");
