// 16776
[proc,trh_reward_screen_delay](int $int0)
def_component $component1 = interface_1253:com_0;
$int0 = ~clamp($int0, 0, 300);
if ($int0 <= 0) {
    if_setontimer(null, $component1);
    if (%varclient_1781 > 0) {
        %varclient_7075 = false;
        ~wof_show_reward;
        ~wof_hotkey(1);
    } else {
        ~error("Trh reward screen delay has run, but client vars are out of sync.");
        ~script1296("Sorry, something has gone wrong. Please close and re-open Treasure Hunter.");
    }
} else {
    %varclient_7075 = true;
    if_setontimer("trh_reward_screen_delay(calc($int0 - 1))", $component1);
}
