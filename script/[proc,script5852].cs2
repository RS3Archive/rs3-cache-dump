// 5852
[proc,script5852]
if (%6awe3_renown_points < %6awe3_cost_seedicide) {
    if_sethide(false, 6awe3_rewards:positive_button_disabled_layer_11);
} else {
    if_sethide(true, 6awe3_rewards:positive_button_disabled_layer_11);
}
if (%6awe3_renown_points < %6awe3_cost_bomb) {
    if_sethide(false, 6awe3_rewards:positive_button_disabled_layer_12);
} else {
    if_sethide(true, 6awe3_rewards:positive_button_disabled_layer_12);
}
if (%6awe3_renown_points < %6awe3_cost_bomb) {
    if_sethide(false, 6awe3_rewards:positive_button_disabled_layer_13);
} else {
    if_sethide(true, 6awe3_rewards:positive_button_disabled_layer_13);
}
if (%6awe3_renown_points < %6awe3_cost_outfit | calc(%trh13_farmer_boots_made + %trh13_farmer_hands_made + %trh13_farmer_legs_made + %trh13_farmer_torso_made + %trh13_farmer_hat_made + %trh58_farming_addon_owned) = 6 | map_members = false) {
    if_sethide(false, 6awe3_rewards:positive_button_disabled_layer_14);
} else {
    if_sethide(true, 6awe3_rewards:positive_button_disabled_layer_14);
}
if (%6awe3_renown_points <= 0) {
    if_sethide(false, 6awe3_rewards:positive_button_disabled_layer_6);
} else {
    if_sethide(true, 6awe3_rewards:positive_button_disabled_layer_6);
}
if (%6awe3_renown_points <= 0) {
    if_sethide(false, 6awe3_rewards:positive_button_disabled_layer_7);
} else {
    if_sethide(true, 6awe3_rewards:positive_button_disabled_layer_7);
}
if (%6awe3_renown_points <= 0) {
    if_sethide(false, 6awe3_rewards:positive_button_disabled_layer_8);
} else {
    if_sethide(true, 6awe3_rewards:positive_button_disabled_layer_8);
}
