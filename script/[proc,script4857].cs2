// 4857
[proc,script4857]
if (clanprofile_find = true) {
    ~script4854;
    if (%clan_stronghold_tier < 7) {
        if_sethide(true, clan_stronghold_main_decor:custom_button_on_layer_5x5_1);
        if_sethide(true, clan_stronghold_main_decor:custom_button_on_layer_4x4_5);
        if_sethide(true, clan_stronghold_main_decor:custom_button_on_layer_2x2_7);
        if_sethide(true, clan_stronghold_main_decor:custom_button_on_layer_2x2_8);
    }
    if (%clan_stronghold_tier < 5) {
        if_sethide(true, clan_stronghold_main_decor:custom_button_on_layer_4x4_3);
        if_sethide(true, clan_stronghold_main_decor:custom_button_on_layer_4x4_4);
        if_sethide(true, clan_stronghold_main_decor:custom_button_on_layer_2x2_5);
        if_sethide(true, clan_stronghold_main_decor:custom_button_on_layer_2x2_6);
    }
    if (%clan_stronghold_tier < 3) {
        if_sethide(true, clan_stronghold_main_decor:custom_button_on_layer_2x2_3);
        if_sethide(true, clan_stronghold_main_decor:custom_button_on_layer_2x2_4);
    }
}
