// 13027
[proc,script13027]
if (%trh116_staff_of_devotion_unlocked = 0) {
    if_settext("Rep: <tostring_localised(150, true)>", trh116_valentines_shop:staff_of_devotion_price);
} else {
    if_settext("Unlocked", trh116_valentines_shop:staff_of_devotion_price);
    if_sethide(false, trh116_valentines_shop:staff_of_devotion_button_disabled);
}
if (%trh116_heart_balloon_unlocked = 0) {
    if_settext("Rep: <tostring_localised(200, true)>", trh116_valentines_shop:heart_balloon_price);
} else {
    if_settext("Unlocked", trh116_valentines_shop:heart_balloon_price);
    if_sethide(false, trh116_valentines_shop:heart_balloon_button_disabled);
}
if (%trh116_rest_anim_unlocked = 0) {
    if_settext("Rep: <tostring_localised(300, true)>", trh116_valentines_shop:loved_up_rest_price);
} else {
    if_settext("Unlocked", trh116_valentines_shop:loved_up_rest_price);
    if_sethide(false, trh116_valentines_shop:loved_up_rest_button_disabled);
}
if (%trh116_walk_unlocked = 0) {
    if_settext("Rep: <tostring_localised(350, true)>", trh116_valentines_shop:loved_up_walk_price);
} else {
    if_settext("Unlocked", trh116_valentines_shop:loved_up_walk_price);
    if_sethide(false, trh116_valentines_shop:loved_up_walk_button_disabled);
}
if (%trh116_lootbeam_unlocked = 0) {
    if_settext("Rep: <tostring_localised(150, true)>", trh116_valentines_shop:loved_up_loot_price);
} else {
    if_settext("Unlocked", trh116_valentines_shop:loved_up_loot_price);
    if_sethide(false, trh116_valentines_shop:loved_up_loot_button_disabled);
}
if (%trh116_bunch_of_flowers_unlocked = 0) {
    if_settext("Rep: <tostring_localised(250, true)>", trh116_valentines_shop:bunch_of_flowers_price);
} else {
    if_settext("Unlocked", trh116_valentines_shop:bunch_of_flowers_price);
    if_sethide(false, trh116_valentines_shop:bunch_of_flowers_button_disabled);
}
if (%trh116_staff_of_devotion_unlocked = 1 & %trh116_heart_balloon_unlocked = 1 & %trh116_rest_anim_unlocked = 1 & %trh116_walk_unlocked = 1 & %trh116_lootbeam_unlocked = 1 & %trh116_bunch_of_flowers_unlocked = 1) {
    if_settext("Rep: <tostring_localised(250, true)>", trh116_valentines_shop:prismatic_star_price);
} else {
    if_settext("Locked until all other rewards are unlocked", trh116_valentines_shop:prismatic_star_price);
    if_sethide(false, trh116_valentines_shop:prismatic_star_button_disabled);
}
