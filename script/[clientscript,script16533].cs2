// 16533
[clientscript,script16533](obj $obj0, int $int1)
def_string $string0 = "Open <tostring(2)> bonus eggs to receive:<br>";
if (if_find(trh180_overlay:progress_bar_prize_layer) = true) {
    if ($int1 > 1) {
        $string0 = append($string0, "<tostring_localised($int1, true)> x <oc_name($obj0)>");
    } else {
        $string0 = append($string0, oc_name($obj0));
    }
    ~script3537($string0);
}
