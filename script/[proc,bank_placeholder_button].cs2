// 8901
[proc,bank_placeholder_button](component $component0, component $component1, component $component2)
if_setobject_alwaysnum(cake, 0, $component1);
if_settrans(128, $component1);
if (%bank_always_placeholder = 1) {
    if_setgraphic("aif_tick_cross_icon,0", $component2);
    ~script13960($component0, rs3tli_30px_button, false, 1);
} else {
    if_setgraphic("aif_tick_cross_icon,1", $component2);
    ~script13960($component0, rs3tli_30px_button, false, 0);
}
