// 8012
[clientscript,fadeout_comp](int $int0, component $component1, component $component2)
def_int $int3 = 0;
def_int $int4 = 0;
if (if_find($component1) = true) {
    $int3 = calc($int0 - clientclock);
    if ($int3 <= 0) {
        cc_settrans(255);
        if_setontimer(null, $component2);
        return;
    }
    $int4 = calc(255 - cc_gettrans);
    cc_settrans(min(calc(cc_gettrans + $int4 / $int3), 254));
}
