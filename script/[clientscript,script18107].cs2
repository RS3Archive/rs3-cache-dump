// 18107
[clientscript,script18107](int $int0)
def_int $int1 = 0;
if (cc_findbycategory(bp3_buffs_tab:xp_buff_content_layer, $int0, 0) = 1) {
    $int1 = calc(1 - cc_param(is_minimised));
    cc_setparam_int(is_minimised, $int1);
    if ($int1 = 0) {
        cc_setsize(cc_getwidth, cc_param(bp3_accordion_content_height), ^setsize_abs, ^setsize_abs);
    } else {
        cc_setsize(cc_getwidth, 58, ^setsize_abs, ^setsize_abs);
    }
    ~script18108;
}
