// 17080
[clientscript,script17080](int $int0)
switch_int ($int0) {
    case 0 :
        %exchange_version_0 = 1;
    case 1 :
        %exchange_version_1 = 1;
    case 2 :
        %exchange_version_2 = 1;
    case 3 :
        %exchange_version_3 = 1;
    case 4 :
        %exchange_version_4 = 1;
    case 5 :
        %exchange_version_5 = 1;
    case 6 :
        %exchange_version_6 = 1;
    case 7 :
        %exchange_version_7 = 1;
    case default :
        ~error("Slot <tostring($int0)> does not have a slot version variable defined.");
}
