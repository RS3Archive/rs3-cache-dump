// 1931
[proc,script1931](int $int0, int $int1)(int)
switch_int ($int1) {
    case 0 :
        return(calc(1 + $int0 - bitcount(%qps_unlocks_armour)));
    case 1 :
        return(calc(1 + $int0 - bitcount(%qps_unlocks_pet)));
    case 2 :
        return(calc(1 + $int0 - bitcount(%qps_unlocks_hub)));
