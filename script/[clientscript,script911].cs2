// 911
[clientscript,script911]
if (%easter08_fade_to_black = 1 & %easter08_cl_fade_amount < 253) {
    %easter08_cl_fade_amount = calc(%easter08_cl_fade_amount + 3);
    if_settrans(calc(255 - %easter08_cl_fade_amount), easter08_chocatrice_hatching:blackout_rect);
} else if (%easter08_fade_to_black = 0 & %easter08_cl_fade_amount > 3) {
    %easter08_cl_fade_amount = calc(%easter08_cl_fade_amount - 3);
    if_settrans(calc(255 - %easter08_cl_fade_amount), easter08_chocatrice_hatching:blackout_rect);
}
