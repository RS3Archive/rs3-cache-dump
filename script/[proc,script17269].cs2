// 17269
[proc,script17269](stat $stat0, struct $struct1)(int)
switch_stat ($stat0) {
    case agility :
        return(struct_param($struct1, potion_info_stat_bonus_pcent_agility));
    case summoning :
        return(struct_param($struct1, potion_info_stat_bonus_pcent_animallore));
    case archaeology :
        return(struct_param($struct1, potion_info_stat_bonus_pcent_archaeology));
    case attack :
        return(struct_param($struct1, potion_info_stat_bonus_pcent_attack));
    case hitpoints :
        return(struct_param($struct1, potion_info_stat_bonus_pcent_constitution));
    case construction :
        return(struct_param($struct1, potion_info_stat_bonus_pcent_construction));
    case cooking :
        return(struct_param($struct1, potion_info_stat_bonus_pcent_cooking));
    case crafting :
        return(struct_param($struct1, potion_info_stat_bonus_pcent_crafting));
    case defence :
        return(struct_param($struct1, potion_info_stat_bonus_pcent_defence));
    case divination :
        return(struct_param($struct1, potion_info_stat_bonus_pcent_divination));
    case dungeoneering :
        return(struct_param($struct1, potion_info_stat_bonus_pcent_dungeoneering));
    case farming :
        return(struct_param($struct1, potion_info_stat_bonus_pcent_farming));
    case firemaking :
        return(struct_param($struct1, potion_info_stat_bonus_pcent_firemaking));
    case fishing :
        return(struct_param($struct1, potion_info_stat_bonus_pcent_fishing));
    case fletching :
        return(struct_param($struct1, potion_info_stat_bonus_pcent_fletching));
    case herblore :
        return(struct_param($struct1, potion_info_stat_bonus_pcent_herblore));
    case hunter :
        return(struct_param($struct1, potion_info_stat_bonus_pcent_hunter));
    case invention :
        return(struct_param($struct1, potion_info_stat_bonus_pcent_invention));
    case magic :
        return(struct_param($struct1, potion_info_stat_bonus_pcent_magic));
    case mining :
        return(struct_param($struct1, potion_info_stat_bonus_pcent_mining));
    case necromancy :
        return(struct_param($struct1, potion_info_stat_bonus_pcent_necromancy));
    case prayer :
        return(struct_param($struct1, potion_info_stat_bonus_pcent_prayer));
    case ranged :
        return(struct_param($struct1, potion_info_stat_bonus_pcent_ranged));
    case runecraft :
        return(struct_param($struct1, potion_info_stat_bonus_pcent_runecraft));
    case slayer :
        return(struct_param($struct1, potion_info_stat_bonus_pcent_slayer));
    case smithing :
        return(struct_param($struct1, potion_info_stat_bonus_pcent_smithing));
    case strength :
        return(struct_param($struct1, potion_info_stat_bonus_pcent_strength));
    case thieving :
        return(struct_param($struct1, potion_info_stat_bonus_pcent_thieving));
    case woodcutting :
        return(struct_param($struct1, potion_info_stat_bonus_pcent_woodcutting));
}
~error("Unexpected stat in potion stat lookup");
return(0);
