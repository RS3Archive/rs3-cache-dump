// 10597
[clientscript,script10597](int $int0)
def_int $int1 = calc(clientclock - $int0);
if ($int1 <= 50) {
    if_setposition(calc(scale($int1, 2, 5) - 150), 0, ^setpos_abs_centre, ^setpos_abs_centre, elfcity_rush_of_blood_timer:splash_graphic);
    if_setposition(calc(150 - scale($int1, 2, 5)), 0, ^setpos_abs_centre, ^setpos_abs_centre, elfcity_rush_of_blood_timer:splash_wave);
    if_settrans(calc(255 - $int1 * 5), elfcity_rush_of_blood_timer:splash_graphic);
    if_settrans(calc(255 - $int1 * 5), elfcity_rush_of_blood_timer:splash_wave);
} else if ($int1 <= 100) {
    if_setposition(calc($int1 - 50 - 25), 0, ^setpos_abs_centre, ^setpos_abs_centre, elfcity_rush_of_blood_timer:splash_graphic);
    if_setposition(calc(25 - ($int1 - 50)), 0, ^setpos_abs_centre, ^setpos_abs_centre, elfcity_rush_of_blood_timer:splash_wave);
    if_settrans(0, elfcity_rush_of_blood_timer:splash_graphic);
    if_settrans(0, elfcity_rush_of_blood_timer:splash_wave);
} else if ($int1 <= 150) {
    if_setposition(calc(scale($int1, 2, 5) - 225), 0, ^setpos_abs_centre, ^setpos_abs_centre, elfcity_rush_of_blood_timer:splash_graphic);
    if_setposition(calc(225 - scale($int1, 2, 5)), 0, ^setpos_abs_centre, ^setpos_abs_centre, elfcity_rush_of_blood_timer:splash_wave);
    if_settrans(calc(5 + ($int1 - 100) * 5), elfcity_rush_of_blood_timer:splash_graphic);
    if_settrans(calc(5 + ($int1 - 100) * 5), elfcity_rush_of_blood_timer:splash_wave);
} else {
    if_sethide(true, elfcity_rush_of_blood_timer:wave_splash_layer);
    if_setontimer(null, elfcity_rush_of_blood_timer:wave_splash_layer);
}
