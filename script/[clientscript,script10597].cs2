// 10597
[clientscript,script10597](int $int0)
def_int $int1 = calc(clientclock - $int0);
if ($int1 <= 50) {
    if_setposition(calc(scale($int1, 2, 5) - 150), 0, ^setpos_abs_centre, ^setpos_abs_centre, interface_1535:com_15);
    if_setposition(calc(150 - scale($int1, 2, 5)), 0, ^setpos_abs_centre, ^setpos_abs_centre, interface_1535:com_16);
    if_settrans(calc(255 - $int1 * 5), interface_1535:com_15);
    if_settrans(calc(255 - $int1 * 5), interface_1535:com_16);
} else if ($int1 <= 100) {
    if_setposition(calc($int1 - 50 - 25), 0, ^setpos_abs_centre, ^setpos_abs_centre, interface_1535:com_15);
    if_setposition(calc(25 - ($int1 - 50)), 0, ^setpos_abs_centre, ^setpos_abs_centre, interface_1535:com_16);
    if_settrans(0, interface_1535:com_15);
    if_settrans(0, interface_1535:com_16);
} else if ($int1 <= 150) {
    if_setposition(calc(scale($int1, 2, 5) - 225), 0, ^setpos_abs_centre, ^setpos_abs_centre, interface_1535:com_15);
    if_setposition(calc(225 - scale($int1, 2, 5)), 0, ^setpos_abs_centre, ^setpos_abs_centre, interface_1535:com_16);
    if_settrans(calc(5 + ($int1 - 100) * 5), interface_1535:com_15);
    if_settrans(calc(5 + ($int1 - 100) * 5), interface_1535:com_16);
} else {
    if_sethide(true, interface_1535:com_14);
    if_setontimer(null, interface_1535:com_14);
}
