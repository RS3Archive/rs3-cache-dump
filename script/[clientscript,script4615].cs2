// 4615
[clientscript,script4615](component $component0)
switch_component ($component0) {
    case skillcape_customise:picker_colour_top1 :
        if_setcolour(hsvtorgb(~script4015(%current_cape_customising, 2)), $component0);
    case skillcape_customise:picker_colour_top2 :
        if_setcolour(hsvtorgb(~script4015(%current_cape_customising, 1)), $component0);
    case skillcape_customise:picker_colour_top3 :
        if_setcolour(hsvtorgb(~script4015(%current_cape_customising, 1)), $component0);
    case skillcape_customise:picker_colour_top4 :
        if_setcolour(hsvtorgb(~script4015(%current_cape_customising, 1)), $component0);
    case skillcape_customise:picker_colour_middle1 :
        if_setcolour(hsvtorgb(~script4015(%current_cape_customising, 3)), $component0);
    case skillcape_customise:picker_colour_middle2 :
        if_setcolour(hsvtorgb(~script4015(%current_cape_customising, 3)), $component0);
    case skillcape_customise:picker_colour_middle3 :
        if_setcolour(hsvtorgb(~script4015(%current_cape_customising, 2)), $component0);
    case skillcape_customise:picker_colour_middle4 :
        if_setcolour(hsvtorgb(~script4015(%current_cape_customising, 2)), $component0);
    case skillcape_customise:picker_colour_bottom1 :
        if_setcolour(hsvtorgb(~script4015(%current_cape_customising, 4)), $component0);
    case skillcape_customise:picker_colour_bottom2 :
        if_setcolour(hsvtorgb(~script4015(%current_cape_customising, 4)), $component0);
    case skillcape_customise:picker_colour_bottom3 :
        if_setcolour(hsvtorgb(~script4015(%current_cape_customising, 4)), $component0);
    case skillcape_customise:picker_colour_bottom4 :
        if_setcolour(hsvtorgb(~script4015(%current_cape_customising, 3)), $component0);
}
