// 16542
[proc,script16542](component $component0, component $component1, graphic $graphic2, boolean $boolean3, int $int4)
if ($int4 = 1) {
    if_setgraphic(prizemount_circle_yellow, $component1);
    if_setcolour(^white, $component0);
} else if ($boolean3 = true) {
    if_setgraphic(prizemount_circle_white, $component1);
    if_setcolour(^white, $component0);
} else {
    if_setgraphic(prizemount_circle_red, $component1);
    if_setcolour(0x4b4b4b, $component0);
}
if ($graphic2 ! null) {
    if_setgraphic($graphic2, $component0);
}
