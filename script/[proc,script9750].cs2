// 9750
[proc,script9750]
def_string $string0 = "";
if (%varplayer_4476 < 2 | %varclient_4189 = 1) {
    if_sethide(false, interface_1049:com_52);
    if (if_getgraphic(interface_1049:com_6) = rs3_btn_radio_on) {
        if_setgraphic(rs3_btn_radio_on_disabled, interface_1049:com_73);
    } else {
        if_setgraphic(rs3_btn_radio_off_disabled, interface_1049:com_73);
    }
    if_sethide(false, interface_1049:com_54);
    if (if_getgraphic(interface_1049:com_4) = rs3_btn_radio_on) {
        if_setgraphic(rs3_btn_radio_on_disabled, interface_1049:com_74);
    } else {
        if_setgraphic(rs3_btn_radio_off_disabled, interface_1049:com_74);
    }
    if_sethide(false, interface_1049:com_56);
    if (if_getgraphic(interface_1049:com_2) = rs3_btn_radio_on) {
        if_setgraphic(rs3_btn_radio_on_disabled, interface_1049:com_75);
    } else {
        if_setgraphic(rs3_btn_radio_off_disabled, interface_1049:com_75);
    }
    if_setcolour(~rgb_to_hex(125, 125, 125), interface_1049:com_7);
    if_setcolour(~rgb_to_hex(125, 125, 125), interface_1049:com_5);
    if_setcolour(~rgb_to_hex(125, 125, 125), interface_1049:com_3);
    if (%varclient_4189 = 1) {
        if (%varplayer_4475 < 3) {
            if_setgraphic(rs3_btn_radio_off_disabled, interface_1049:com_73);
            if_setgraphic(rs3_btn_radio_on_disabled, interface_1049:com_74);
            if_setgraphic(rs3_btn_radio_off_disabled, interface_1049:com_75);
            $string0 = "Party sizes of 1 to 2 are restricted to medium dungeons in Hard Mode.";
        } else {
            if_setgraphic(rs3_btn_radio_off_disabled, interface_1049:com_73);
            if_setgraphic(rs3_btn_radio_off_disabled, interface_1049:com_74);
            if_setgraphic(rs3_btn_radio_on_disabled, interface_1049:com_75);
            $string0 = "Party sizes of 3 to 5 are restricted to large dungeons in Hard Mode.";
        }
        if_setonmouserepeat("script8799($string0, interface_1049:com_52, -1)", interface_1049:com_52);
        if_setonmouserepeat("script8799($string0, interface_1049:com_54, -1)", interface_1049:com_54);
        if_setonmouserepeat("script8799($string0, interface_1049:com_56, -1)", interface_1049:com_56);
    }
} else {
    if_sethide(true, interface_1049:com_52);
    if_sethide(true, interface_1049:com_54);
    if_sethide(true, interface_1049:com_56);
    if_setcolour(~rgb_to_hex(255, 255, 255), interface_1049:com_7);
    if_setcolour(~rgb_to_hex(255, 255, 255), interface_1049:com_5);
    if_setcolour(~rgb_to_hex(255, 255, 255), interface_1049:com_3);
}
if (%varplayer_1068 = 1) {
    if_sethide(true, interface_1049:com_52);
    if_sethide(true, interface_1049:com_54);
    if_sethide(true, interface_1049:com_56);
    if_sethide(false, interface_1049:com_57);
}
