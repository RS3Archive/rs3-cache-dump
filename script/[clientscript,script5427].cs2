// 5427
[clientscript,script5427]
%dom_next_icon = 1;
%dom_spin_speed = 1;
%dom_start_slowdown = 0;
%dom_move_mode = 1;
%tooltip_built = 0;
~dom_create_icon(0, 0);
~dom_create_icon(1, 90);
~dom_create_icon(2, 180);
if_setontimer("dom_move_all", dom_handicap:slot_layer);
if_settext(tostring(%dom_handicap_lives), dom_handicap:lives);
~script5434;
