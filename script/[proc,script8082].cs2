// 8082
[proc,script8082]()(component)
if (%toplevel_v2_mobile_interface = 1) {
    switch_int (%lore_selected_op1) {
        case 5 :
            return(toplevel_v2_combat_bar_mobile:details_op1);
        case 1 :
            return(toplevel_v2_combat_bar_mobile:spell_icon);
        case 2 :
            return(toplevel_v2_combat_bar_mobile:attack_op1);
        case 4 :
            return(toplevel_v2_combat_bar_mobile:call_op1);
        case 3 :
            return(toplevel_v2_combat_bar_mobile:dismiss_op1);
        case 7 :
            return(toplevel_v2_combat_bar_mobile:renew_op1);
        case 6 :
            return(toplevel_v2_combat_bar_mobile:interact_op1);
        case 8 :
            return(toplevel_v2_combat_bar_mobile:bob_take_op1);
        case 9 :
            return(toplevel_v2_combat_bar_mobile:bob_give_op1);
        case 10 :
            return(toplevel_v2_combat_bar_mobile:restore_points_op1);
        case default :
            return(toplevel_v2_combat_bar_mobile:details_op1);
    }
} else if (%toplevel_v2_legacy_interface = 0) {
    switch_int (%lore_selected_op1) {
        case 5 :
            return(toplevel_v2_combat_bar:details_op1);
        case 1 :
            return(toplevel_v2_combat_bar:spell_icon);
        case 2 :
            return(toplevel_v2_combat_bar:attack_op1);
        case 4 :
            return(toplevel_v2_combat_bar:call_op1);
        case 3 :
            return(toplevel_v2_combat_bar:dismiss_op1);
        case 7 :
            return(toplevel_v2_combat_bar:renew_op1);
        case 6 :
            return(toplevel_v2_combat_bar:interact_op1);
        case 8 :
            return(toplevel_v2_combat_bar:bob_take_op1);
        case 9 :
            return(toplevel_v2_combat_bar:bob_give_op1);
        case 10 :
            return(toplevel_v2_combat_bar:restore_points_op1);
        case default :
            return(toplevel_v2_combat_bar:details_op1);
    }
} else {
    switch_int (%lore_selected_op1) {
        case 5 :
            return(topstat_lore:details_op1);
        case 1 :
            return(topstat_lore:spell_icon);
        case 2 :
            return(topstat_lore:attack_op1);
        case 4 :
            return(topstat_lore:call_op1);
        case 3 :
            return(topstat_lore:dismiss_op1);
        case 7 :
            return(topstat_lore:renew_op1);
        case 6 :
            return(topstat_lore:interact_op1);
        case 8 :
            return(topstat_lore:bob_take_op1);
        case 9 :
            return(topstat_lore:bob_give_op1);
        case 10 :
            return(toplevel_v2_combat_bar:restore_points_op1);
        case default :
            return(topstat_lore:details_op1);
    }
}
