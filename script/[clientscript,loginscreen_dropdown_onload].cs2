// 14135
[clientscript,loginscreen_dropdown_onload](int $int0)
if_sethide(true, loginscreen:settings_bg_text);
if_sethide(true, loginscreen:background_dropdown);
if_setsize(300, 279, ^setsize_abs, ^setsize_abs, loginscreen:desktop_settings_root);
if_setsize(10, 0, ^setsize_minus, ^setsize_minus, loginscreen:settings_content);
if_setposition(0, -15, ^setpos_abs_centre, ^setpos_abs_top, loginscreen:settings_content);
