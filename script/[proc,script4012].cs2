// 4012
[proc,script4012]()(int)
def_int $int0 = 0;
def_obj $obj1 = inv_getobj(worn, 1);
if (~ql4_getprogress(animal_magnetism) = 2) {
    if (~ql4_getprogress(do_no_evil) = 2) {
        $int0 = 3;
    } else if (stat_base(ranged) >= 50) {
        $int0 = 2;
    } else {
        $int0 = 1;
    }
}
switch_obj ($obj1) {
    case anma_30_reward :
        if ($int0 < 1) {
            $int0 = 1;
        }
    case anma_50_reward :
        if ($int0 < 2) {
            $int0 = 2;
        }
    case apmeken_alerter_reward :
        if ($int0 < 3) {
            $int0 = 3;
        }
}
return($int0);
