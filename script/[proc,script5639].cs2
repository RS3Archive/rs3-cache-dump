// 5639
[proc,script5639](int $int0, int $int1)
if (~is_mobile_client = true) {
    switch_int ($int0) {
        case -1 :
            %audio_options_mobile_global_mute_server = $int1;
            return;
        case 0 :
            %audio_options_mobile_music_mute_server = $int1;
            return;
        case 1 :
            %audio_options_mobile_soundfx_mute_server = $int1;
            return;
        case 2 :
            %audio_options_mobile_bgsound_mute_server = $int1;
            return;
        case 3 :
            %audio_options_mobile_speech_mute_server = $int1;
            return;
    }
}
switch_int ($int0) {
    case -1 :
        %audio_options_global_mute_server = $int1;
    case 0 :
        %audio_options_music_mute_server = $int1;
    case 1 :
        %audio_options_soundfx_mute_server = $int1;
    case 2 :
        %audio_options_bgsound_mute_server = $int1;
    case 3 :
        %audio_options_speech_mute_server = $int1;
    case default :
        ~error("Attempting to set invalid music option mode: <tostring($int0)>");
}
