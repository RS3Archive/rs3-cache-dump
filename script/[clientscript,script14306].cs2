// 14306
[clientscript,script14306](component $component0, int $int1)
def_boolean $boolean2 = false;
if ($int1 = 2 & %sc_client_collect_sc < 1 & %sc_client_damage_sc < 1) {
    ~script10943("The awards tab is not available for this scoring.", $component0);
    $int1 = 1;
    $boolean2 = true;
}
if (%sc_client_winning_team = 99999992) {
    $boolean2 = true;
}
~sc_tab_build($int1, $boolean2);
