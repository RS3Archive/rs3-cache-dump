// 9257
[proc,script9257](inv $inv0, obj $obj1, int $int2)(boolean)
if (%lore_npc_head ! null) {
    switch_npc (%lore_npc_head) {
        case lore_abyssal_leech, lore_abyssal_leech_combat, lore_abyssal_lurker, lore_abyssal_lurker_combat, lore_abyssal_titan, lore_abyssal_titan_combat :
            if ($obj1 ! blankrune & $obj1 ! blankrune_high & $obj1 ! impure_essence) {
                return(true);
            }
        case lore_jackalope :
            return(true);
        case default :
            if ($obj1 = blankrune | $obj1 = blankrune_high | $obj1 = impure_essence) {
                return(true);
            }
    }
    if (nc_param(%lore_npc_head, lore_is_bob) = 0 & (nc_param(%lore_npc_head, mtxmgt_pet_legendary) = 0 | nc_param(%lore_npc_head, mtxmgt_pet_legendary) = 1 & %mtx_pet_bob_ability = 0)) {
        switch_npc (%lore_npc_head) {
            case rand_lorebob_01, rand_lorebob_02, rand_lorebob_03, rand_lorebob_04, rand_lorebob_05, rand_lorebob_06, rand_lorebob_07, rand_lorebob_08, rand_lorebob_09, rand_lorebob_10, rand_lorebob_01_combat, rand_lorebob_02_combat, rand_lorebob_03_combat, rand_lorebob_04_combat, rand_lorebob_05_combat, rand_lorebob_06_combat, rand_lorebob_07_combat, rand_lorebob_08_combat, rand_lorebob_09_combat, rand_lorebob_10_combat :
            case default :
                return(true);
        }
    }
} else if ($inv0 ! share_preset_bob) {
    return(true);
}
if ($obj1 = rs_bond | $obj1 = rs_bond_untradeable) {
    return(true);
}
if (oc_param($obj1, one_to_one_trade) ! 0) {
    return(true);
}
if (oc_category($obj1) = castlewars_item) {
    return(true);
}
if (oc_param($obj1, poh_only) = 1) {
    return(true);
}
if (oc_category($obj1) = wof46_lamp_part) {
    return(true);
}
switch_obj ($obj1) {
    case trh38_crafting_rig, trh38_rig_case, trh38_rig_focus, trh38_rig_setting, trh38_summoning_focus :
        return(true);
}
if (oc_tradeable($obj1) = false & oc_param($obj1, lore_trade_to_bob) = 0) {
    if ($obj1 ! null & oc_cert($obj1) = $obj1 & oc_param(oc_uncert($obj1), lore_trade_to_bob) = 1) {
        return(false);
    }
    return(true);
}
return(false);
