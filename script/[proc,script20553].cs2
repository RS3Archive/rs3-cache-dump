// 20553
[proc,script20553]
switch_int (%marketplace_bonds_side_tab_id) {
    case 0 :
        if_sethide(false, mtx_front_end_bonds:redeem);
        if_sethide(false, mtx_front_end_bonds:scrollbar);
        if_sethide(true, mtx_front_end_bonds:convert);
    case 1 :
        if_sethide(true, mtx_front_end_bonds:redeem);
        if_sethide(true, mtx_front_end_bonds:scrollbar);
        if_sethide(false, mtx_front_end_bonds:convert);
}
