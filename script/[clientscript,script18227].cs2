// 18227
[clientscript,script18227](obj $obj0, int $int1)
if_sethide(false, jobs_main:information_panel);
if_settext(oc_name($obj0), jobs_main:item_name);
if_setobject_alwaysnum($obj0, $int1, jobs_main:item_graphic);
def_string $string0 = "";
if (oc_members($obj0) = 0 | oc_members($obj0) = 1 & map_members = true) {
    $string0 = oc_desc($obj0);
}
if (string_length($string0) > 0) {
    if_settext($string0, jobs_main:level_description);
} else {
    if_settext(oc_param($obj0, trh_extended_desc), jobs_main:level_description);
}
