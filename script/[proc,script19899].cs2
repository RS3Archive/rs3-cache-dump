// 19899
[proc,script19899]
switch_int (%trh189_selected_skin_pos) {
    case 1 :
        ~if_sethide(trh189_overlay:skin_select_rollover_1, 0);
        ~if_sethide(trh189_overlay:skin_select_rollover_2, 1);
        ~if_sethide(trh189_overlay:skin_select_rollover_3, 1);
    case 2 :
        ~if_sethide(trh189_overlay:skin_select_rollover_2, 0);
        ~if_sethide(trh189_overlay:skin_select_rollover_1, 1);
        ~if_sethide(trh189_overlay:skin_select_rollover_3, 1);
    case 3 :
        ~if_sethide(trh189_overlay:skin_select_rollover_3, 0);
        ~if_sethide(trh189_overlay:skin_select_rollover_1, 1);
        ~if_sethide(trh189_overlay:skin_select_rollover_2, 1);
    case default :
        ~if_sethide(trh189_overlay:skin_select_rollover_1, 1);
        ~if_sethide(trh189_overlay:skin_select_rollover_2, 1);
        ~if_sethide(trh189_overlay:skin_select_rollover_3, 1);
}
