// 19899
[proc,script19899]
switch_int (%varplayerbit_57809) {
    case 1 :
        ~if_sethide(interface_1082:com_153, 0);
        ~if_sethide(interface_1082:com_159, 1);
        ~if_sethide(interface_1082:com_165, 1);
    case 2 :
        ~if_sethide(interface_1082:com_159, 0);
        ~if_sethide(interface_1082:com_153, 1);
        ~if_sethide(interface_1082:com_165, 1);
    case 3 :
        ~if_sethide(interface_1082:com_165, 0);
        ~if_sethide(interface_1082:com_153, 1);
        ~if_sethide(interface_1082:com_159, 1);
    case default :
        ~if_sethide(interface_1082:com_153, 1);
        ~if_sethide(interface_1082:com_159, 1);
        ~if_sethide(interface_1082:com_165, 1);
}
