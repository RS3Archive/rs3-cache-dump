// 1943
[clientscript,script1943]
if (string_length(%sc_tutorial_client_title) = 0) {
    if_sethide(true, sc_tutorial_overlay:title_layer);
    return;
}
if_sethide(false, sc_tutorial_overlay:title_layer);
if_settext(%sc_tutorial_client_title, sc_tutorial_overlay:title_text);
%sc_tutorial_title_visible = 1;
