// 7864
[clientscript,script7864](int $int0, int $int1)
if (clientclock < $int0) {
    return;
}
switch_int ($int1) {
    case 0 :
        basecolour($int1, %playerdesign3_haircol);
    case 1 :
        basecolour($int1, %playerdesign3_torsocol);
    case 2 :
        basecolour($int1, %playerdesign3_legscol);
    case 3 :
        basecolour($int1, %playerdesign3_feetcol);
    case 4 :
        basecolour($int1, %playerdesign3_skincol);
}
if_setontimer(null, acc_create:colours_menu);
