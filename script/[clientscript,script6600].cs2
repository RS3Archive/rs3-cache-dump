// 6600
[clientscript,script6600]
def_component $component0 = null;
def_int $int1 = 0;
def_graphic $graphic2 = "aif_penguin_icons,2";
def_graphic $graphic3 = "aif_penguin_icons,3";
def_graphic $graphic4 = "aif_penguin_icons,1";
def_graphic $graphic5 = "aif_penguin_icons,4";
def_int $int6 = 0;
while ($int6 < 5) {
    switch_int ($int6) {
        case 0 :
            $component0 = peng_pow_sub_overlay:assign_gun;
            $int1 = %peng_pow_sub_gun_assign;
        case 1 :
            $component0 = peng_pow_sub_overlay:assign_engine;
            $int1 = %peng_pow_sub_engine_assign;
        case 2 :
            $component0 = peng_pow_sub_overlay:assign_windows;
            $int1 = %peng_pow_sub_windows_assign;
        case 3 :
            $component0 = peng_pow_sub_overlay:assign_pump;
            $int1 = %peng_pow_sub_pump_assign;
        case 4 :
            $component0 = peng_pow_sub_overlay:assign_sonar;
            $int1 = %peng_pow_sub_sonar_assign;
    }
    switch_int ($int1) {
        case 0 :
            if_setgraphic(null, $component0);
        case 1 :
            if_setgraphic($graphic2, $component0);
        case 2 :
            if_setgraphic($graphic3, $component0);
        case 3 :
            if_setgraphic($graphic4, $component0);
        case 4 :
            if_setgraphic($graphic5, $component0);
    }
    $int6 = calc($int6 + 1);
}
