// 7995
[proc,script7995](component $component0, inv $inv1)
def_int $int2 = 0;
if (%slidepuzzle_anim_frame_enum = null) {
    return;
}
while (cc_find($component0, $int2) = true) {
    cc_setgraphic(enum(obj, graphic, %slidepuzzle_anim_frame_enum, inv_getobj($inv1, $int2)));
    $int2 = calc($int2 + 1);
}
