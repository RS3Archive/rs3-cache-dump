// 11713
[clientscript,script11713](component $component0)
def_int $int1 = 0;
switch_component ($component0) {
    case raid1_beastmaster_buffbar:raid1_beastmaster_pet1_dead :
        $int1 = %raid1_beastmaster_buff_pet1_dead;
    case raid1_beastmaster_buffbar:raid1_beastmaster_pet2_dead :
        $int1 = %raid1_beastmaster_buff_pet2_dead;
}
if ($int1 = 1) {
    if_sethide(false, $component0);
}
