// 6196
[proc,script6196]
def_string $string0 = "";
if (string_length(%twitch_stream_user_name) > 0) {
    $string0 = append("https://www.twitch.tv/", %twitch_stream_user_name);
    openurlraw($string0, false);
    sound_vorbis_volume(tli_click_01, 1, 0, 100);
} else {
    mes("You need to choose a broadcast first");
    sound_vorbis_volume(omge_error, 1, 0, 150);
}
