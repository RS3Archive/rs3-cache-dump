// 15826
[clientscript,trh181_on_load]
cc_deleteall(wheel_of_fortune:fake_op);
def_int $int0 = -1;
while (++$int0 < 7) {
    cc_create(wheel_of_fortune:fake_op, ^iftype_graphic, $int0);
}
~script15827;
if_setsize(200, 190, ^setsize_abs, ^setsize_abs, wheel_of_fortune:wheel_spin_button_layer_1);
if_setposition(100, 0, ^setpos_abs_left, ^setpos_abs_top, wheel_of_fortune:wheel_spin_button_layer_1);
def_obj $obj1 = struct_param(trh181_promo, trh_featured_prize);
if ($obj1 ! null) {
    ~script16663(trh181_prize_preview_components, $obj1, 2);
    ~script16503(trh181_overlay:gemfall_probability_scroll_layer, trh181_overlay:gemfall_probability_scroll_bar, trh181_overlay:gemfall_probability_content, trh181_prize_display_screen, 0, null, trh181_promo);
}
