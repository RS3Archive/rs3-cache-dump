[proc,script8576]
if (if_find(prayer_quick_preset_interface:glow) = true) {
    switch_int (%prayer_quick_selected_preset) {
        case 0 :
            cc_setonvartransmit("script8563{prayer_quick_preset_0_prayers_0, prayer_quick_preset_0_prayers_1}");
        case 1 :
            cc_setonvartransmit("script8563{prayer_quick_preset_1_prayers_0, prayer_quick_preset_1_prayers_1}");
        case 2 :
            cc_setonvartransmit("script8563{prayer_quick_preset_2_prayers_0, prayer_quick_preset_2_prayers_1}");
        case 3 :
            cc_setonvartransmit("script8563{prayer_quick_preset_3_prayers_0, prayer_quick_preset_3_prayers_1}");
        case 4 :
            cc_setonvartransmit("script8563{prayer_quick_preset_4_prayers_0, prayer_quick_preset_4_prayers_1}");
        case 5 :
            cc_setonvartransmit("script8563{prayer_quick_preset_5_prayers_0, prayer_quick_preset_5_prayers_1}");
        case 6 :
            cc_setonvartransmit("script8563{prayer_quick_preset_6_prayers_0, prayer_quick_preset_6_prayers_1}");
        case 7 :
            cc_setonvartransmit("script8563{prayer_quick_preset_7_prayers_0, prayer_quick_preset_7_prayers_1}");
        case 8 :
            cc_setonvartransmit("script8563{prayer_quick_preset_8_prayers_0, prayer_quick_preset_8_prayers_1}");
        case 9 :
            cc_setonvartransmit("script8563{prayer_quick_preset_9_prayers_0, prayer_quick_preset_9_prayers_1}");
    }
}
