// 13596
[clientscript,script13596](component $component0, int $int1)
cc_deleteall($component0);
def_achievement $achievement2 = null;
switch_int ($int1) {
    case 0 :
        $achievement2 = %player_inspect_cheevo_complete_1;
    case 1 :
        $achievement2 = %player_inspect_cheevo_complete_2;
    case 2 :
        $achievement2 = %player_inspect_cheevo_complete_3;
    case 3 :
        $achievement2 = %player_inspect_cheevo_complete_4;
