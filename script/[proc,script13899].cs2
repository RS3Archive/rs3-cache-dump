// 13899
[proc,script13899](component $component0, component $component1)
if ($component0 = null) {
    return;
}
def_string $string0 = "Regenerate";
def_string $string1 = "Cure Poison";
if (%toplevel_v2_legacy_combat = 1 | %combatv2_auto_regenerate = 1 & ~arch_relic_check_active(arch_relic_persistent_rage) = false & ~script16800 = false) {
    $string0 = $string1;
    $string1 = "";
}
if_setop(1, $string0, $component0);
if_setop(2, $string1, $component0);
if ($component1 ! null) {
    if_setonmouserepeat("script8799($string0, event_com, event_comsubid)", $component1);
}
