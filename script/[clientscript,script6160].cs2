// 6160
[clientscript,script6160]
~script6162;
switch_int (map_lang) {
    case 1 :
        if_setgraphic("aif_runecrafting_pyramid_title,2", rcsiphonxp_shop:top_colour);
    case 2 :
        if_setgraphic("aif_runecrafting_pyramid_title,3", rcsiphonxp_shop:top_colour);
    case 3 :
        if_setgraphic("aif_runecrafting_pyramid_title,1", rcsiphonxp_shop:top_colour);
    case 6 :
        if_setgraphic("aif_runecrafting_pyramid_title,4", rcsiphonxp_shop:top_colour);
    case default :
        if_setgraphic("aif_runecrafting_pyramid_title,0", rcsiphonxp_shop:top_colour);
}
if_setontimer("script6164(rcsiphonxp_shop:buy_op_layer, 0)", rcsiphonxp_shop:buy_op_layer);
if (map_members = false) {
    if_sethide(false, rcsiphonxp_shop:buy_button_disabled_layer);
}
