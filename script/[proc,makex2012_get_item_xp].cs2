// 10873
[proc,makex2012_get_item_xp](obj $obj0, int $int1, int $int2, int $int3)(int)
switch_obj ($obj0) {
    case trh43_protean_leather_recipe, trh43_protean_hard_leather_recipe, trh43_protean_snakehide_recipe, trh43_protean_dragonhide_recipe :
