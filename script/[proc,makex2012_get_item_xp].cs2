switch_category (oc_category($obj0)) {
    case arch_screening_dummy :
        return(~script14692($obj0));
    case arch_magic_screening_dummy :
        if ($int3 = 1) {
            return(~script14692($obj0));
        } else {
            return($int1);
        }
