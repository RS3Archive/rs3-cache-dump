// 7140
[proc,script7140](int $int0)(int)
def_int $int1 = calc($int0 / 10000);
def_int $int2 = calc($int0 / 100 % 100);
def_int $int3 = calc($int0 % 100);
if (calc($int1 + 1) > enum(int, int, days_in_month, calc($int2 - 1))) {
    $int1 = 1;
    if ($int2 = 12) {
        $int2 = 1;
        $int3 = calc($int3 + 1);
    } else {
        $int2 = calc($int2 + 1);
    }
} else {
    $int1 = calc($int1 + 1);
}
return(calc($int1 * 10000 + $int2 * 100 + $int3));
