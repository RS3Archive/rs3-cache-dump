// 16665
[proc,script16665](string $string0, component $component0, int $int1)
if (~is_mobile_client = true) {
    cc_setop(1, "Information");
    cc_setonop("script7774($string0, $component0, $int1, 2)");
} else {
    cc_setonmouserepeat("script7774($string0, $component0, $int1, 2)");
    cc_setonmouseleave("script16608");
}
