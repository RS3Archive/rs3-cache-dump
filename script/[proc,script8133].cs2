// 8133
[proc,script8133](component $component0)
def_graphic $graphic1 = "rs3_btn_minimise,0";
def_graphic $graphic2 = "rs3_btn_minimise,1";
def_string $string0 = "Minimise";
if (cc_find($component0, 1) = true) {
    if (~script20655 = 1) {
        $string0 = "Maximise";
        $graphic1 = "rs3_btn_minimise,3";
        $graphic2 = "rs3_btn_minimise,4";
    }
    cc_setgraphic($graphic1);
    cc_setonmouseleave("graphic_swapper_dynamic(event_com, event_comsubid, $graphic1)");
    cc_setonmouseover("graphic_swapper_dynamic(event_com, event_comsubid, $graphic2)");
    cc_setop(1, $string0);
    cc_setonmouserepeat("script8799($string0, event_com, event_comsubid)");
    cc_setnoclickthrough(true);
}
