// 9069
[clientscript,login_mouseleave](int $int0)
switch_int ($int0) {
    case 100 :
        if (%loginscreen_focus = 100) {
            if_sendtofront(loginscreen:username_input_group_graphic_active);
        } else {
            if_sendtofront(loginscreen:username_input_group_graphic_normal);
        }
    case 101 :
        if (%loginscreen_focus = 101) {
            if_sendtofront(loginscreen:password_input_group_graphic_active);
        } else {
            if_sendtofront(loginscreen:password_input_group_graphic_normal);
        }
    case 114 :
        if (%loginscreen_focus = 114) {
            if_sendtofront(loginscreen:auth_input_group_graphic_active);
        } else {
            if_sendtofront(loginscreen:auth_input_group_graphic_normal);
        }
}
