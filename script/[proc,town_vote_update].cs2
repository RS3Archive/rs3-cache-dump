// 1991
[proc,town_vote_update]
if (%town_has_voted = 1) {
    if_sethide(false, town_map_vote:vote_1_highlight);
    if_sethide(true, town_map_vote:vote_2_highlight);
} else if (%town_has_voted = 2) {
    if_sethide(false, town_map_vote:vote_2_highlight);
    if_sethide(true, town_map_vote:vote_1_highlight);
}
if_settext(tostring(%town_votes_map1), town_map_vote:vote_1_count);
if_settext(tostring(%town_votes_map2), town_map_vote:vote_2_count);
