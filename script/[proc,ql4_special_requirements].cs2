// 2194
[proc,ql4_special_requirements](quest $quest0)(boolean)
def_int $int1 = 1;
def_string $string0 = "";
if ($quest0 ! null) {
    $int1, $string0 = ~ql4_special_requirements_string($quest0);
    if ($int1 = 0) {
        return(false);
    }
} else {
    $string0 = ~quest_name($quest0);
    ~error("Special quest <$string0> is missing from [ql4_quests] enum.");
