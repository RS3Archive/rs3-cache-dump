def_component $component6 = necro_ritual_information:output_holding_layer;
if_settext("No ritual selected", necro_ritual_information:name_title_text);
if_setsize(calc(if_getwidth($component2) - if_getwidth($component3)), $int1, ^setsize_minus, ^setsize_abs, $component3);
if_setsize(calc(if_getwidth($component3) - if_getwidth($component4)), $int1, ^setsize_minus, ^setsize_abs, $component4);
if_setsize(calc(if_getwidth($component2) - if_getwidth($component5)), $int1, ^setsize_minus, ^setsize_abs, $component5);
if_setsize(calc(if_getwidth($component5) - if_getwidth($component6)), $int1, ^setsize_minus, ^setsize_abs, $component6);
$int0 = calc($int0 + ($int1 * 3 + 8 * 2));
if_setposition(0, $int0, ^setpos_abs_centre, ^setpos_abs_top, $component5);
$int0 = calc($int0 + ($int1 + 8));
if_setposition(0, $int0, ^setpos_abs_centre, ^setpos_abs_top, necro_ritual_information:options_layer);
if_sethide(true, necro_ritual_information:output_scrollbar_layer);
