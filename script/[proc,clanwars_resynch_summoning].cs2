// 1778
[proc,clanwars_resynch_summoning]
~static_checkbox(clanwars_setup:summoning_indicator, ~bool_to_int(~not_bool(%clanwars_rulevarc_nosummoning)), false);
if (%clanwars_rulevarc_nosummoning = false) {
    if_settrans(0, clanwars_setup:summoning);
} else {
    if_settrans(225, clanwars_setup:summoning);
}
~clanwars_updateside;
