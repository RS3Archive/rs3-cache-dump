// 8991
[proc,script8991]
switch_int (~script8984) {
    case default :
        return;
    case 1 :
        if (%6awe1_god_allegiance = 1) {
            if_setgraphic("aif_6th_age_escalation_icons,3", 6awe1_vote:choice1_icon);
            if_setgraphic("aif_6th_age_escalation_icons,4", 6awe1_vote:choice2_icon);
        } else {
            if_setgraphic("aif_6th_age_escalation_icons,0", 6awe1_vote:choice1_icon);
            if_setgraphic("aif_6th_age_escalation_icons,1", 6awe1_vote:choice2_icon);
        }
    case 3 :
        if (%6awe1_god_allegiance = 1) {
            if_setgraphic("aif_6th_age_escalation_icons,4", 6awe1_vote:choice1_icon);
            if_setgraphic("aif_6th_age_escalation_icons,5", 6awe1_vote:choice2_icon);
        } else {
            if_setgraphic("aif_6th_age_escalation_icons,1", 6awe1_vote:choice1_icon);
            if_setgraphic("aif_6th_age_escalation_icons,2", 6awe1_vote:choice2_icon);
        }
}
