// 1643
[clientscript,script1643]
switch_int (map_lang) {
    case 0 :
        if_setgraphic(aif_valentine_shop_bg_2014_en, wof65_valentines_shop:background_heart);
    case 1 :
        if_setgraphic(aif_valentine_shop_bg_2014_de, wof65_valentines_shop:background_heart);
    case 2 :
        if_setgraphic(aif_valentine_shop_bg_2014_fr, wof65_valentines_shop:background_heart);
    case 3 :
        if_setgraphic(aif_valentine_shop_bg_2014_pt, wof65_valentines_shop:background_heart);
    case 6 :
        if_setgraphic(aif_valentine_shop_bg_2014_es, wof65_valentines_shop:background_heart);
}
if_settext(tostring_localised(1750, true), wof65_valentines_shop:love_emote_cost);
if_settext(tostring_localised(1000, true), wof65_valentines_shop:love_weapon_cost);
if_settext(tostring_localised(800, true), wof65_valentines_shop:love_crown_cost);
if_settext(tostring_localised(1750, true), wof65_valentines_shop:hate_emote_cost);
if_settext(tostring_localised(1000, true), wof65_valentines_shop:hate_weapon_cost);
if_settext(tostring_localised(800, true), wof65_valentines_shop:hate_crown_cost);
if_settext(tostring_localised(50, true), wof65_valentines_shop:random_chocolate_cost);
~script1647;
if_sethide(true, wof65_valentines_shop:popup_layer);
%wof65_valentines_shop_selection = 0;
