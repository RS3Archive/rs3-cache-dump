// 12434
[clientscript,script12434]
if_settext("Current charges: <tostring_localised(%trh84_amulet_charges, true)>", trh84_amulet_effects:current_charges);
if_setcolour(^white, trh84_amulet_effects:ability_name1);
if_setcolour(^white, trh84_amulet_effects:ability_desc1);
if (%trh84_amulet_level >= 2) {
    if_sethide(true, trh84_amulet_effects:ability_lock2);
    if_setcolour(^white, trh84_amulet_effects:ability_name2);
    if_setcolour(^white, trh84_amulet_effects:ability_desc2);
}
if (%trh84_amulet_level >= 3) {
    if_sethide(true, trh84_amulet_effects:ability_lock3);
    if_setcolour(^white, trh84_amulet_effects:ability_name3);
    if_setcolour(^white, trh84_amulet_effects:ability_desc3);
}
if (%trh84_amulet_level >= 4) {
    if_sethide(true, trh84_amulet_effects:ability_lock4);
    if_setcolour(^white, trh84_amulet_effects:ability_name4);
    if_setcolour(^white, trh84_amulet_effects:ability_desc4);
}
