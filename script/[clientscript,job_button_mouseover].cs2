// 6729
[clientscript,job_button_mouseover](component $component0, component $component1, int $int2)
def_struct $struct3 = null;
def_struct $struct4 = null;
def_struct $struct5 = null;
if (cc_find($component0, $int2) = true) {
    $struct3 = cc_param(jobs_button_graphics_data);
    $struct4 = ~script9952($struct3);
    if ($struct4 ! null) {
        cc_setgraphic(struct_param($struct4, rs3tli_icon_graphic_over));
    }
}
if ($component1 ! null & cc_find($component1, $int2) = true) {
    $struct3 = cc_param(jobs_button_graphics_data);
    $struct4 = ~script9952($struct3);
    $struct5 = struct_param($struct4, jobs_button_font_active);
    cc_settextfont(struct_param($struct5, rs3tli_text_font));
    cc_setcolour(struct_param($struct5, rs3tli_text_colour));
}
