// 5898
[clientscript,script5898](component $component0, int $int1)
def_int $int2 = calc($int1 + 1);
if (if_gethide(wheel_of_fortune:chests_layer) = true | if_gethide(wheel_of_fortune:reward_layer) = false | if_gethide(wheel_of_fortune:play_again_layer) = false) {
    if_setontimer(null, wheel_of_fortune:main_layer);
    return;
}
if ($int2 >= 300) {
    if_setontimer(null, wheel_of_fortune:main_layer);
    if (%wof_result_slot_client > 0) {
        ~wof_show_reward;
        %wof_in_progress = 0;
    }
} else {
    if_setontimer("script5898(event_com, $int2)", wheel_of_fortune:main_layer);
}
