// 15760
[proc,script15760](dbrow $dbrow0)(boolean)
switch_int (platformtype) {
    case ^platformtype_default, ^platformtype_jagex :
        if (db_getfield($dbrow0, popup:col6, 0) = 1) {
            return(true);
        }
    case ^platformtype_apple, ^platformtype_android :
        if (db_getfield($dbrow0, popup:col8, 0) = 1) {
            return(true);
        }
    case ^platformtype_steam :
        if (db_getfield($dbrow0, popup:col7, 0) = 1) {
            return(true);
        }
    case default :
        return(true);
}
return(false);
