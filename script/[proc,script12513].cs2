// 12513
[proc,script12513](struct $struct0)
if (struct_param($struct0, combatv2_lodestone_teleport) = 1) {
    if (%quick_tele_by_default = 1) {
        cc_setop(1, "Quick teleport");
        cc_setop(2, "Teleport");
    } else {
        cc_setop(1, "Teleport");
        cc_setop(2, "Quick Teleport");
    }
}
