def_string $string0 = "Unlocked tomorrow";
def_string $string1 = "Unlocked tomorrow";
def_string $string2 = "Unlocked<br>soon";
if (date_runeday < 4946) {
    if (date_runeday < 4943) {
        $string0 = "Unlocked<br>soon";
    } else if (date_runeday = 4943) {
        $string0 = "Unlocked<br>in three days";
    } else if (date_runeday = 4944) {
        $string0 = "Unlocked<br>in two days";
    }
    if_sethide(false, trh69_starfury:cape_date_locked);
    if_settext($string0, trh69_starfury:cape_date_locked_text);
}
if (date_runeday < 4945) {
    if (date_runeday < 4943) {
        $string1 = "Unlocked<br>soon";
    } else if (date_runeday = 4943) {
        $string1 = "Unlocked<br>in two days";
    }
    if_sethide(false, trh69_starfury:melee_chestplate_date_locked);
    if_settext($string1, trh69_starfury:melee_chestplate_date_locked_text);
    if_sethide(false, trh69_starfury:ranged_hauberk_date_locked);
    if_settext($string1, trh69_starfury:ranged_hauberk_date_locked_text);
    if_sethide(false, trh69_starfury:magic_robe_date_locked);
    if_settext($string1, trh69_starfury:magic_robe_date_locked_text);
}
if (date_runeday < 4944) {
    if_sethide(false, trh69_starfury:melee_helmet_date_locked);
    if_sethide(false, trh69_starfury:melee_legplates_date_locked);
    if_sethide(false, trh69_starfury:ranged_coif_date_locked);
    if_sethide(false, trh69_starfury:ranged_chaps_date_locked);
    if_sethide(false, trh69_starfury:magic_hood_date_locked);
    if_sethide(false, trh69_starfury:magic_skirt_date_locked);
    if (date_runeday < 4943) {
        if_settext($string2, trh69_starfury:melee_helmet_date_locked_text);
        if_settext($string2, trh69_starfury:melee_legplates_date_locked_text);
        if_settext($string2, trh69_starfury:ranged_coif_date_locked_text);
        if_settext($string2, trh69_starfury:ranged_chaps_date_locked_text);
        if_settext($string2, trh69_starfury:magic_hood_date_locked_text);
        if_settext($string2, trh69_starfury:magic_skirt_date_locked_text);
    }
}
