// 11337
[clientscript,script11337]
if (%overload_type = 0) {
    if (stat(strength) > stat_base(strength)) {
        ~script10624(combatv2_strength_boosted_dummy_ability, 1);
        ~script10624(combatv2_strength_nerfed_dummy_ability, 0);
        return;
    } else if (stat(strength) < stat_base(strength)) {
        ~script10624(combatv2_strength_boosted_dummy_ability, 0);
        ~script10624(combatv2_strength_nerfed_dummy_ability, 1);
        return;
    }
}
~script10624(combatv2_strength_boosted_dummy_ability, 0);
~script10624(combatv2_strength_nerfed_dummy_ability, 0);
