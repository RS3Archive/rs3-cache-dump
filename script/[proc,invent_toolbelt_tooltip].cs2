// 12165
[proc,invent_toolbelt_tooltip](int $int0)(string)
switch_int ($int0) {
    case 2 :
        return("Bag of Materials<br>A bag of materials gained from disassembly.");
    case 1 :
        return("Inventor's Tools<br>A set of tools used to disassemble objects.");
    case 3 :
        return("Charge Pack<br>A pack containing stored divine energy.<br>Current charge: <~invent_charge_string(%varplayer_5984, 0)><br>Max charge: <~invent_charge_string(~invent_max_charge, 0)><br>Combat drain rate: <~invent_charge_string(scale(%varplayer_5991, 6, 10), 2)>/s");
}
