// 4449
[clientscript,clan_chat_onclantransmit](component $component0, component $component1)
if (minimenuopen($component1, -1) = true) {
    if_setontimer("clan_chat_minimenu_timer($component0, $component1)", $component1);
    return;
}
if (activeclanchannel_find_affined(0) = true) {
    ~script4451($component0);
}
