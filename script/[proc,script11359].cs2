// 11359
[proc,script11359](struct $struct0)(int)
switch_struct ($struct0) {
    case mtx_pet_ability_banking :
        if (%mtx_bank_time_left > 0) {
            return(1);
        }
    case mtx_pet_ability_repair :
        if (%mtx_repair_time_left > 0) {
            return(1);
        }
    case mtx_pet_ability_alchemy :
        if (%mtx_alch_time_left > 0) {
            return(1);
        }
    case mtx_pet_ability_fertiliser :
        if (%mtx_fertiliser_time_left > 0) {
            return(1);
        }
    case mtx_pet_ability_lifesaver :
        if (%mtx_lifesaver_time_left > 0) {
            return(1);
        }
    case mtx_pet_ability_bob :
        if (%mtx_bob_timer > 0) {
            return(1);
        }
}
return(0);
