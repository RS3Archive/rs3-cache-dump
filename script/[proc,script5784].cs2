if (%njcapes_unlocked_gatherer = 1) {
    if_sethide(false, njcapes_shard_bag:cape_unlocked);
}
if (%njcapes_unlocked_combat = 1) {
    if_sethide(false, njcapes_shard_bag:cape_unlocked_1);
}
if (%njcapes_unlocked_artisan = 1) {
    if_sethide(false, njcapes_shard_bag:cape_unlocked_2);
}
if (%njcapes_unlocked_support = 1) {
    if_sethide(false, njcapes_shard_bag:cape_unlocked_3);
}
