// 7086
[proc,script7086](component $component0, obj $obj1)
if ($component0 = null | $obj1 = null) {
    return;
}
def_int $int2 = 0;
if (oc_param($obj1, recipe_tool_xp_type_1) ! -1) {
    $int2 = calc($int2 + 1);
}
if (oc_param($obj1, recipe_tool_xp_type_2) ! -1) {
    $int2 = calc($int2 + 1);
}
if ($int2 = 0) {
    return;
}
def_int $int3 = calc(if_getwidth($component0) / ($int2 + 1));
def_int $int4 = $int3;
def_int $int5 = 0;
def_int $int6 = 0;
def_int $int7 = -1;
def_int $int8 = -1;
while ($int6 < $int2) {
    if ($int6 = 0) {
        $int7 = oc_param($obj1, recipe_tool_xp_type_1);
    } else if ($int6 = 1) {
        $int7 = oc_param($obj1, recipe_tool_xp_type_2);
    }
    if ($int7 ! -1) {
        cc_create($component0, ^iftype_graphic, $int5);
        cc_setgraphic(enum(int, graphic, stat2icon_medium, $int7));
        cc_setposition(calc($int3 - 32 / 2), calc(8 - (32 - 22) / 2), ^setpos_abs_left, ^setpos_abs_top);
        cc_setsize(32, 32, ^setsize_abs, ^setsize_abs);
        $int5 = calc($int5 + 1);
        .cc_create($component0, ^iftype_text, $int5);
        .cc_settextfont(museo_sans_13pt_regular);
        .cc_settextalign(^settextalign_centre, ^settextalign_centre, 0);
        .cc_setcolour(^white);
        .cc_settextshadow(true);
        .cc_settext("+XP");
        .cc_setsize(calc(2 * $int4), 20, ^setsize_abs, ^setsize_abs);
        .cc_setposition(calc($int3 - .cc_getwidth / 2), calc(cc_gety + cc_getheight), ^setpos_abs_left, ^setpos_abs_top);
        $int5 = calc($int5 + 1);
        $int3 = calc($int3 + $int4);
    }
    $int6 = calc($int6 + 1);
}
