// 18131
[proc,script18131](component $component0)
switch_int (%emotes2_last_type) {
    case 0 :
        if ($component0 = toplevel_v2_parent_suboverlay_emotes:emotes_filter) {
            ~emotes2_sort(toplevel_v2_parent_suboverlay_emotes:main, toplevel_v2_parent_suboverlay_emotes:scrollbar, %emote_last_list, %emote_last_sort);
        } else {
            ~emotes2_sort(emotes2:main, emotes2:scrollbar, %emote_last_list, %emote_last_sort);
        }
    case 1 :
        if ($component0 = toplevel_v2_parent_suboverlay_emotes:emotes_filter) {
            ~script6255(toplevel_v2_parent_suboverlay_emotes:transmog, toplevel_v2_parent_suboverlay_emotes:scrollbar, %emote_last_transmog_sort);
        } else {
            ~script6255(emotes2:transmog, emotes2:scrollbar, %emote_last_transmog_sort);
        }
    case 2 :
        if ($component0 = toplevel_v2_parent_suboverlay_emotes:emotes_filter) {
            ~script18273(toplevel_v2_parent_suboverlay_emotes:overhead);
        } else {
            ~script18273(emotes2:overhead);
        }
}
