// 11563
[clientscript,script11563]
if (%trh55_effect_duration < 60) {
    %trh55_effect_duration = calc(%trh55_effect_duration + 1);
} else {
    if_sethide(true, trh55_world_event:astromancer_sparkle_1);
    if_sethide(true, trh55_world_event:astromancer_sparkle_2);
    if_sethide(true, trh55_world_event:astromancer_sparkle_3);
    if_sethide(true, trh55_world_event:astromancer_sparkle_4);
    if_setontimer(null, trh55_world_event:astromancer_sparkle_4);
}
