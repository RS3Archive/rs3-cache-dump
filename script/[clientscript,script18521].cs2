// 18521
[clientscript,script18521](component $component0, component $component1)
~script16924($component0, $component1);
def_int $int2 = 1;
def_int $int3 = 0;
def_int $int4 = 0;
def_component $component5 = newplayer_prompt:nxt_background_graphic_0;
if (if_find($component5) = true) {
    $int3 = cc_getwidth;
    $int4 = cc_getheight;
    cc_setposition(0, 0, ^setpos_abs_left, ^setpos_abs_top);
}
while ($int2 < 9) {
    switch_int ($int2) {
        case 1 :
            $component5 = newplayer_prompt:nxt_background_graphic_1;
        case 2 :
            $component5 = newplayer_prompt:nxt_background_graphic_2;
        case 3 :
            $component5 = newplayer_prompt:nxt_background_graphic_3;
        case 4 :
            $component5 = newplayer_prompt:nxt_background_graphic_4;
        case 5 :
            $component5 = newplayer_prompt:nxt_background_graphic_5;
        case 6 :
            $component5 = newplayer_prompt:nxt_background_graphic_6;
        case 7 :
            $component5 = newplayer_prompt:nxt_background_graphic_7;
        case 8 :
            $component5 = newplayer_prompt:nxt_background_graphic_8;
    }
    if (if_find($component5) = true) {
        cc_setposition(calc($int3 * ($int2 % 3)), calc($int4 * ($int2 / 3)), ^setpos_abs_left, ^setpos_abs_top);
    }
    $int2 = calc($int2 + 1);
}
