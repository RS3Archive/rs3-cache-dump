// 8164
[proc,script8164]
if (%toplevel_v2_legacy_interface = 1 | %toplevel_v2_mobile_interface = 1) {
    if_sethide(true, toplevel_v2:buttons_window_settings_button);
    return;
} else if (~script20475 = false) {
    if_sethide(true, toplevel_v2:buttons_window_settings_button);
    return;
} else if (cc_find(toplevel_v2:buttons_window_settings_button, 1) = true & ~script20475 = true) {
    cc_setop(1, "Toggle Interface Customisation");
    cc_setonop("script8166(event_com, event_comsubid)");
    cc_setonmouserepeat("script8171(event_com, event_comsubid)");
    cc_setonmouseleave("script8172(event_com, event_comsubid)");
    cc_setonvartransmit("script8165(event_com, event_comsubid){toplevel_v2_skins_varp}");
    if (~script8839(20) = true) {
        ~script8844(1, ~script8825(20, 0), toplevel_v2:buttons_window_settings_button, 1);
    }
    cc_setmouseovercursor(cursor_default);
    cc_setnoclickthrough(true);
}
if_sethide(false, toplevel_v2:buttons_window_settings_button);
