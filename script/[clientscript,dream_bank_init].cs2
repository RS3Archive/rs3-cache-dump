// 60
[clientscript,dream_bank_init]
def_int $int0 = 3;
def_int $int1 = 5;
def_int $int2 = 0;
def_obj $obj3 = null;
while ($int0 < 255) {
    while ($int1 < 235) {
        cc_create(dream_armour:bank_layer, ^iftype_graphic, $int2);
        cc_setsize(36, 32, ^setsize_abs, ^setsize_abs);
        cc_setposition($int1, $int0, ^setpos_abs_left, ^setpos_abs_top);
        $obj3 = inv_getobj(dream_bank_inventory, $int2);
        if ($obj3 ! null) {
            cc_setobject($obj3, inv_getnum(dream_bank_inventory, $int2));
            cc_setopbase(oc_name(inv_getobj(dream_bank_inventory, $int2)));
            cc_setop(1, "Withdraw");
            cc_setoutline(1);
            cc_setonmouserepeat("script9564($obj3, event_com, event_comsubid)");
        }
        $int1 = calc($int1 + 40);
        $int2 = calc($int2 + 1);
    }
    $int0 = calc($int0 + 44);
    $int1 = 5;
}
