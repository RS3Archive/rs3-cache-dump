// 3512
[proc,mobile_chatv3_zoom_check]
def_component $component0 = struct_param(toplevel_v2_window_data_mes, toplevel_v2_window_content_layer_mobile);
if (if_hassub($component0) = true) {
    ~script5695;
    ~chat_v3_set_safe_area;
    if (if_hassubmodal($component0, chat_v3_choice) = true) {
        ~script3513;
    }
    ~chat_v3_set_core_chat_height;
    if (if_hassubmodal($component0, chat_v3) = true) {
        if (if_find(chat_v3:chat_text_layer) = true) {
            cc_callonresize;
        }
    } else if (cc_find(chat_v3_choice:choice_buttons_draw, 0) = true) {
        cc_callonresize;
    }
}
