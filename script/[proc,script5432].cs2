// 5432
[proc,script5432]
def_int $int0 = 0;
if (%dom_client_handicap = 1) {
    $int0 = 16;
} else if (%dom_client_handicap = 2) {
    $int0 = 17;
} else if (%dom_client_handicap = 3) {
    $int0 = 18;
} else if (%dom_client_handicap = 4) {
    $int0 = 19;
} else if (%dom_client_handicap = 5) {
    $int0 = 20;
} else if (%dom_client_handicap = 6) {
    $int0 = 21;
} else if (%dom_client_handicap = 7) {
    $int0 = 22;
} else {
    $int0 = calc(%dom_client_handicap - 7);
}
if (%dom_current_icon = $int0) {
    %dom_start_slowdown = 1;
}
