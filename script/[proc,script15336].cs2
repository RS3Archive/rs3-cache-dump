// 15336
[proc,script15336](component $component0, int $int1)
def_int $int2 = 0;
while ($int2 < $int1) {
    cc_create($component0, ^iftype_rectangle, calc($int2 * 11));
    cc_create($component0, ^iftype_graphic, calc($int2 * 11 + 1));
    cc_create($component0, ^iftype_rectangle, calc($int2 * 11 + 2));
    cc_create($component0, ^iftype_graphic, calc($int2 * 11 + 3));
    cc_create($component0, ^iftype_graphic, calc($int2 * 11 + 4));
    cc_create($component0, ^iftype_text, calc($int2 * 11 + 5));
    cc_create($component0, ^iftype_text, calc($int2 * 11 + 6));
    cc_create($component0, ^iftype_graphic, calc($int2 * 11 + 7));
    cc_create($component0, ^iftype_graphic, calc($int2 * 11 + 8));
    cc_create($component0, ^iftype_rectangle, calc($int2 * 11 + 9));
    cc_create($component0, ^iftype_text, calc($int2 * 11 + 10));
    $int2 = calc($int2 + 1);
}
