// 1753
[clientscript,script1753](component $component0, component $component1)
if (%brew_varc_sweetgrubs > 0) {
    if_setmodel(game_brew_if_sweetgrub_on, $component0);
    if_setcolour(0x33ff00, $component1);
} else {
    if_setmodel(game_brew_if_sweetgrub_off, $component0);
    if_setcolour(0x910000, $component1);
}
if_settext(tostring(%brew_varc_sweetgrubs), $component1);
