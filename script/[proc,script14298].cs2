// 14298
[proc,script14298](int $int0, component $component1, component $component2)
def_int $int3 = if_getwidth($component1);
if ($int0 < 15) {
    $int3 = scale(calc(15 - $int0), 15, $int3);
    if_setcolour(0x3366ff, $component2);
    if_setposition(0, 0, ^setpos_abs_right, ^setpos_abs_top, $component2);
} else if ($int0 > 15) {
    $int3 = calc($int3 - scale(calc(30 - $int0), 15, $int3));
    if_setcolour(0xe12323, $component2);
    if_setposition(0, 0, ^setpos_abs_left, ^setpos_abs_top, $component2);
