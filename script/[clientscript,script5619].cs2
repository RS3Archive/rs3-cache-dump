// 5619
[clientscript,script5619](int $int0)
def_component $component1 = null;
def_component $component2 = null;
switch_int ($int0) {
    case 0 :
        $component1 = fmc_torch:n_layer;
        $component2 = fmc_torch:n_tendril;
    case 2 :
        $component1 = fmc_torch:e_layer;
        $component2 = fmc_torch:e_tendril;
    case 4 :
        $component1 = fmc_torch:s_layer;
        $component2 = fmc_torch:s_tendril;
    case 5 :
        $component1 = fmc_torch:sw_layer;
        $component2 = fmc_torch:sw_tendril;
    case 6 :
        $component1 = fmc_torch:w_layer;
        $component2 = fmc_torch:w_tendril;
    case 7 :
        $component1 = fmc_torch:nw_layer;
        $component2 = fmc_torch:nw_tendril;
}
if_setontimer("script5620($component1, $component2)", $component1);
