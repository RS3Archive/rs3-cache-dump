// 12211
[proc,trh81_prize_setup]
def_int $int0 = 0;
if_settext("Prestige Level - <tostring(%trh81_prestige_level)>", trh81_zodiac:prestige_title);
while ($int0 <= %trh81_prestige_level_claimed) {
    ~script12212($int0);
    $int0 = calc($int0 + 1);
}
switch_int (%trh81_prestige_level) {
    case 1 :
        if (%trh81_prestige_level = %trh81_prestige_level_claimed) {
            if_sethide(false, trh81_zodiac:green_dragon_hat_unlocked);
        }
        if_sethide(true, trh81_zodiac:green_dragon_hat_disabled);
        if_sethide(false, trh81_zodiac:blue_dragon_hat_disabled);
        if_sethide(false, trh81_zodiac:red_dragon_hat_disabled);
        if_sethide(false, trh81_zodiac:black_dragon_hat_disabled);
        if_sethide(false, trh81_zodiac:gold_dragon_hat_disabled);
    case 2 :
        if_sethide(true, trh81_zodiac:green_dragon_hat_disabled);
        if_sethide(false, trh81_zodiac:green_dragon_hat_unlocked);
        if (%trh81_prestige_level = %trh81_prestige_level_claimed) {
            if_sethide(false, trh81_zodiac:blue_dragon_hat_unlocked);
        }
        if_sethide(true, trh81_zodiac:blue_dragon_hat_disabled);
        if_sethide(false, trh81_zodiac:red_dragon_hat_disabled);
        if_sethide(false, trh81_zodiac:black_dragon_hat_disabled);
        if_sethide(false, trh81_zodiac:gold_dragon_hat_disabled);
    case 3 :
        if_sethide(false, trh81_zodiac:green_dragon_hat_unlocked);
        if_sethide(true, trh81_zodiac:green_dragon_hat_disabled);
        if_sethide(false, trh81_zodiac:blue_dragon_hat_unlocked);
        if_sethide(true, trh81_zodiac:blue_dragon_hat_disabled);
        if (%trh81_prestige_level = %trh81_prestige_level_claimed) {
            if_sethide(false, trh81_zodiac:red_dragon_hat_unlocked);
        }
        if_sethide(true, trh81_zodiac:red_dragon_hat_disabled);
        if_sethide(false, trh81_zodiac:black_dragon_hat_disabled);
        if_sethide(false, trh81_zodiac:gold_dragon_hat_disabled);
    case 4 :
        if_sethide(false, trh81_zodiac:green_dragon_hat_unlocked);
        if_sethide(true, trh81_zodiac:green_dragon_hat_disabled);
        if_sethide(false, trh81_zodiac:blue_dragon_hat_unlocked);
        if_sethide(true, trh81_zodiac:blue_dragon_hat_disabled);
        if_sethide(false, trh81_zodiac:red_dragon_hat_unlocked);
        if_sethide(true, trh81_zodiac:red_dragon_hat_disabled);
        if (%trh81_prestige_level = %trh81_prestige_level_claimed) {
            if_sethide(false, trh81_zodiac:black_dragon_hat_unlocked);
        }
        if_sethide(true, trh81_zodiac:black_dragon_hat_disabled);
        if_sethide(false, trh81_zodiac:gold_dragon_hat_disabled);
    case 5 :
        if_sethide(false, trh81_zodiac:green_dragon_hat_unlocked);
        if_sethide(true, trh81_zodiac:green_dragon_hat_disabled);
        if_sethide(false, trh81_zodiac:blue_dragon_hat_unlocked);
        if_sethide(true, trh81_zodiac:blue_dragon_hat_disabled);
        if_sethide(false, trh81_zodiac:red_dragon_hat_unlocked);
        if_sethide(true, trh81_zodiac:red_dragon_hat_disabled);
        if_sethide(false, trh81_zodiac:black_dragon_hat_unlocked);
        if_sethide(true, trh81_zodiac:black_dragon_hat_disabled);
        if (%trh81_prestige_level = %trh81_prestige_level_claimed) {
            if_sethide(false, trh81_zodiac:gold_dragon_hat_unlocked);
        }
        if_sethide(true, trh81_zodiac:gold_dragon_hat_disabled);
}
if (%trh81_prestige_level > %trh81_prestige_level_claimed) {
    if_sethide(false, trh81_zodiac:prize_layer);
    if_sethide(false, trh81_zodiac:confirm_button_disabled_layer);
} else {
    if_sethide(true, trh81_zodiac:prize_layer);
}
