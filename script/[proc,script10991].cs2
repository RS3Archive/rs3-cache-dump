// 10991
[proc,script10991](int $int0)
def_string $string0 = "Welcome to the Golden Partyhat Hunt!<br>Members can complete any 8 out of the 11 tasks to earn golden partyhat shards which can be combined into your very own golden partyhat.";
def_int $int1 = ~script10506;
def_int $int2 = ~script13276(golden_phat_shard);
def_int $int3 = 0;
if (%golden_phat_created = 1) {
    $string0 = append($string0, "<br><br>Congratulations! You have created your golden partyhat!");
} else {
    $int1 = ~script10506;
    $int2 = ~script13276(golden_phat_shard);
    $int3 = calc($int1 - $int2);
    if ($int3 > 0) {
        $string0 = append($string0, ~text_plural($int3, "<br><br>You have <col=00FF00>1 golden partyhat shard</col> you can reclaim from the Wise Old Man outside the Grand Exchange in Varrock.", "<br><br>You have <col=00FF00><tostring($int3)> golden partyhat shards</col> that you can reclaim from the Wise Old Man outside the Grand Exchange in Varrock."));
    } else if ($int1 >= 8) {
        $string0 = append($string0, "<br><br><col=00FF00>You have earned 8 golden partyhat shards! Visit the Wise Old Man outside the Grand Exchange in Varrock to create your golden partyhat!</col>");
    }
}
~script11847($string0);
if_settext("Information", timed_event:variety_task_events_specific_title);
if_settext($string0, timed_event:variety_task_events_specific_info);
~script10983($int0);
