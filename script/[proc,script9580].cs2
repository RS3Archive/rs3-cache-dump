// 9580
[proc,script9580](component $component0)
if ($component0 = null) {
    return;
}
if (if_find(if_getparentlayer($component0)) = true & cc_param(param_4040) ! null) {
    if (if_gethide(cc_param(param_4040)) = false) {
        if_sethide(true, cc_param(param_4040));
    } else {
        if_sethide(false, cc_param(param_4040));
    }
    if_callonresize(cc_param(param_4040));
    ~script9579($component0);
    ~script9581(if_getparentlayer(if_getparentlayer(if_getparentlayer($component0))));
}
