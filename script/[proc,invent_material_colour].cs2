// 12044
[proc,invent_material_colour](dbrow $dbrow0)(string)
switch_int (db_getfield($dbrow0, invent_material_table:col7, 0)) {
    case default :
        return("");
    case 3, 6 :
        return("<col=ff8000>");
    case 4 :
        return("<col=ff0000>");
    case 5 :
        return("<col=43bcbc>");
}
