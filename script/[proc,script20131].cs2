// 20131
[proc,script20131](dbrow $dbrow0, achievement $achievement1)(string)
switch_category (achievement_subcat($achievement1)) {
    case category_4747, category_4748 :
        return("Complete the quest: <achievement_getname($achievement1)>.");
    case category_4882, category_4883, category_4887, category_4884, category_4885, category_4886 :
        if (achievement_sprite($achievement1) = achievement_icon_archaeology_mysteries) {
            return("Solve the Archaeology mystery: <achievement_getname($achievement1)>.");
        }
}
if (achievement_category($achievement1) = category_4766 & db_getfield($dbrow0, dbtable_334:col5, 0) = 7) {
    return("Complete the task set: <enum(category, string, enum_3482, achievement_subcat(achievement_achievement_req($achievement1, 0)))>.");
}
return(~achievement_description($achievement1));
