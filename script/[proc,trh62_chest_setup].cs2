// 11671
[proc,trh62_chest_setup]
if (~trh_promo_current = trh130_promo & ~script433(5) = 1) {
    ~trh62_chest_model(trh_chest);
    return;
}
switch_int (%trh62_chest_id) {
    case 5 :
        ~trh62_chest_model(mtxjul_th_adamant_chest);
    case 6 :
        ~trh62_chest_model(mtxjul_th_runite_chest);
    case 7 :
        ~trh62_chest_model(mtxjul_th_dragon_chest);
    case 8 :
        ~trh62_chest_model(mtxjul_th_god_chest);
    case 9 :
        ~trh62_chest_model(trh_double_adamant_chest);
    case 10 :
        ~trh62_chest_model(trh_double_runite_chest);
    case 11 :
        ~trh62_chest_model(trh_double_dragon_chest);
    case 12 :
        ~trh62_chest_model(trh_double_god_chest);
    case default :
        ~trh62_chest_model(trh_chest);
}
