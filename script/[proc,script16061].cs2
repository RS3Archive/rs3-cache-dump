[proc,script16061](component $component0, component $component1)
def_int $int2 = 0;
switch_int (randominc(3)) {
    case 0 :
        $int2 = 5461;
    case 1 :
        $int2 = 6371;
    case 2 :
        $int2 = 3640;
    case 3 :
        $int2 = 4551;
}
if_set2dangle($int2, $component0);
if_set2dangle(calc(65535 - $int2), $component1);
