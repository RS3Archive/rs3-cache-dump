// 9829
[clientscript,diango_search]
if (%p_dialog_mode <= 0) {
    ~diango_cancel_search;
    %p_dialog_listener = diango_items:text_input_listener;
    %p_dialog_mode = 8;
    %p_dialog_maxchar = 40;
    ~diango_search_timer("", clientclock, diango_items:text_input_box, diango_items:holiday_items, 0);
    ~script9833(diango_items:text_input_listener, diango_items:text_input_listen, diango_items:text_input_caret, diango_items:text_input_display, diango_items:cancel_search, 0, 0);
}
