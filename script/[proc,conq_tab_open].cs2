// 14284
[proc,conq_tab_open](int $int0)(boolean)
switch_int ($int0) {
    case 2 :
        return(if_hassuboverlay(conq_if_container:turn_interface, conq_side_turn));
    case 4 :
        return(if_hassuboverlay(conq_if_container:command_interface, conq_side_command));
    case 3 :
        return(if_hassuboverlay(conq_if_container:units_interface, conq_side_unit_details));
    case 5 :
        return(if_hassuboverlay(conq_if_container:diplomacy_interface, conq_side_diplomacy));
}
return(false);
