// 1232
[clientscript,trawler_reward_setup](component $component0)
cc_deleteall($component0);
def_int $int1 = calc((if_getwidth($component0) - 36 * 8) / 7);
def_int $int2 = calc((if_getheight($component0) - 32 * 5) / 4);
def_int $int3 = 0;
def_int $int4 = inv_size(trawler_rewardinv);
def_obj $obj5 = null;
def_boolean $boolean6 = ~is_mobile_client;
while ($int3 < $int4) {
    cc_create($component0, ^iftype_graphic, $int3);
    cc_setsize(36, 32, ^setsize_abs, ^setsize_abs);
    cc_setposition(calc((36 + $int1) * ($int3 % 8)), calc($int3 / 8 * (32 + $int2)), ^setpos_abs_left, ^setpos_abs_top);
    $obj5 = inv_getobj(trawler_rewardinv, $int3);
    if (inv_getobj(trawler_rewardinv, $int3) ! null) {
        cc_setobject($obj5, inv_getnum(trawler_rewardinv, $int3));
        cc_setopbase("<col=FF981F><oc_name(inv_getobj(trawler_rewardinv, $int3))>");
        cc_setop(1, "Bank All");
        cc_setop(2, "Withdraw 1");
        cc_setop(3, "Withdraw All");
        cc_setop(10, "Examine");
        if ($boolean6 = false) {
            cc_setdragdeadzone(5);
            cc_setdragdeadtime(10);
        } else {
            cc_setdragdeadzone(20);
            cc_setdragdeadtime(5);
        }
        cc_setoutline(1);
        cc_setonmouserepeat("script9564($obj5, event_com, event_comsubid)");
    } else {
        cc_setobject_nonum(null, 0);
    }
    $int3 = calc($int3 + 1);
}
