// 4367
[proc,script4367]
def_string $string0 = escape(getclipboard);
if (string_length($string0) <= 13) {
    %qfc_input_varc = $string0;
    %qfc_input_caret_varc = string_length(%qfc_input_varc);
    %qfc_input_caret_varc = ~script1552(%qfc_input_caret_varc, %qfc_input_varc, museo_sans_11pt_regular, clan_qfc_input:text_box, -1);
    if_setposition(%qfc_input_caret_varc, if_gety(clan_qfc_input:caret), ^setpos_abs_left, ^setpos_abs_top, clan_qfc_input:caret);
    if_settext(%qfc_input_varc, clan_qfc_input:text_box);
}
