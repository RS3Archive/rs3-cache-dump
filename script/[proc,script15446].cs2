// 15446
[proc,script15446](component $component0, component $component1)(boolean)
def_component $component2 = if_getparentlayer($component0);
while ($component2 ! null) {
    if ($component2 = $component1) {
        return(false);
    }
    $component2 = if_getparentlayer($component2);
}
return(true);
