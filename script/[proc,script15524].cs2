// 15524
[proc,script15524](int $int0)(int, int)
def_int $int1 = cc_param(fairyring_start_angle);
def_int $int2 = cc_param(fairyring_current_angle);
def_int $int3 = calc($int1 + $int0);
if ($int3 < $int2) {
    $int3 = calc($int3 + 360);
}
def_int $int4 = calc($int3 - $int2);
if ($int2 < $int3) {
    $int2 = calc($int2 + 360);
}
def_int $int5 = calc($int2 - $int3);
return($int4, $int5);
