// 6388
[proc,script6388](obj $obj0)(string)
switch_int (oc_param($obj0, statsize)) {
    case 0 :
        return("Small level-scaled");
    case 1 :
        return("Medium level-scaled");
    case 2 :
        return("Large level-scaled");
    case 3 :
        return("Huge level-scaled");
    case default :
        return("");
}
