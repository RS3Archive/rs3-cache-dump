// 7660
[proc,bugreport_input_close]
if (~script5909(bugreport_interface) = true) {
    if_triggerop(bugreport_interface:bugreport_interface_close_button, -1, 1);
}
if_settext("", bugreport_interface:input_repro);
if_settext("", bugreport_interface:input_text);
%bugreport_in_progress = false;
%bugtrack_final_category = 0;
%bugtrack_main_category = 0;
%bugreport_bugs_squashed = 0;
%bugreport_input_focus = 0;
%bugreport_caret1_pos = 0;
%bugreport_caret2_pos = 0;
%bugreport_caret_lastindex = -1;
~script8841(17, 0);
