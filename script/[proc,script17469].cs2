    case 5, 6, 7 :
        $int2 = calc($int2 + (100 + (max(0, calc((min(stat_base(strength), 95) - 10) / 10)) + max(0, calc((min(stat_base(strength), 99) - 95) / 5))) * 50));
    case 8, 9, 10 :
        $int2 = calc($int2 + (100 + (max(0, calc((min(stat_base(ranged), 95) - 10) / 10)) + max(0, calc((min(stat_base(ranged), 99) - 95) / 5))) * 50));
    case 1, 2, 3, 4 :
