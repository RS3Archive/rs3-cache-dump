// 5481
[proc,script5481]()(boolean)
if (%hvh_game_role = 2 | %hvh_game_role = 3) {
    return(true);
}
if (%sc_team ! 0) {
    return(true);
}
switch_obj (inv_getobj(worn, 17)) {
    case barbassault_playericon_attacker_01, barbassault_playericon_attacker_02, barbassault_playericon_attacker_03, barbassault_playericon_attacker_04, barbassault_playericon_attacker_05 :
        return(true);
}
if (%dom_catalytic_enable = 1) {
    return(true);
}
if (%bank_v2_inputdelay = true) {
    return(true);
}
return(false);
