// 19722
[proc,script19722]
def_int $int0 = 0;
def_int $int1 = 0;
if (if_find(toplevel_v2:gameview_window) = true & .if_find(toplevel_v2_edit_mode:edit_mode_window) = true) {
    $int0 = calc(cc_getwidth / 2 + cc_getx - .cc_getwidth / 2);
    $int1 = calc(cc_getheight / 2 + cc_gety - .cc_getheight / 2);
    .cc_setposition($int0, $int1, ^setpos_abs_left, ^setpos_abs_top);
}
