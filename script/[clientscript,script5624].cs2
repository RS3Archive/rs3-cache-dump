// 5624
[clientscript,script5624](component $component0, component $component1, int $int2)
if ($int2 = 1) {
    if_setmodelanim(fmc_smoke_tendrils_flinch, $component1);
} else {
    if_setmodelanim(fmc_smoke_tendrils_approaching, $component1);
}
if_setontimer("script5625($component0, $component1)", $component0);
