// 8501
[clientscript,script8501]
def_int $int0 = calc(reboottimer / 50 % 60);
def_int $int1 = calc(reboottimer / 3000);
if ($int0 < 10) {
    if_settext("System update in<br><tostring($int1)>:0<tostring($int0)>", toplevel_v2:system_update_message);
} else {
    if_settext("System update in<br><tostring($int1)>:<tostring($int0)>", toplevel_v2:system_update_message);
}
if (reboottimer > 0) {
    if_sethide(false, toplevel_v2:system_update_layer);
} else {
    if_sethide(true, toplevel_v2:system_update_layer);
}
