// 5183
[proc,script5183](int $int0, int $int1, int $int2, int $int3)(int)
%colour_picker_colour = $int0;
%colour_picker_h_varp = min(63, max(0, calc(%colour_picker_h_varp + $int1)));
%colour_picker_s_varp = min(7, max(0, calc(%colour_picker_s_varp + $int2)));
%colour_picker_l_varp = min(127, max(0, calc(%colour_picker_l_varp + $int3)));
return(%colour_picker_colour);
