// 6878
[proc,script6878]
def_graphic $graphic0 = "customise_hair_colour_button,1";
def_graphic $graphic1 = "customise_hair_colour_button,0";
if (%mtxmgt_enable_secondary_colour = 0) {
    if_settrans(160, mtxmgt:secondary_colour_graphic);
    if_setonmouseover(null, mtxmgt:secondary_swapper);
    if_setonmouseleave(null, mtxmgt:secondary_swapper);
} else {
    if_settrans(0, mtxmgt:secondary_colour_graphic);
    if_setonmouseover("graphic_swapper(event_com, $graphic0)", mtxmgt:secondary_swapper);
    if_setonmouseleave("graphic_swapper(event_com, $graphic1)", mtxmgt:secondary_swapper);
}
