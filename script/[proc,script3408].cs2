// 3408
[proc,script3408](component $component0, string $string0)
def_string $string1 = "<u=88FFFF><$string0></u>";
def_string $string2 = "<u=64C8FA><$string0></u>";
if_setop(1, "Open link", $component0);
if_setopcursor(1, cursor_advisor_no_ring_1, $component0);
if_setonmouseover("script2381($component0, 0x88ffff, $string1)", $component0);
if_setonmouseleave("script2381($component0, 0x64c8fa, $string2)", $component0);
