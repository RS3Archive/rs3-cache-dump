// 4991
[proc,script4991]
~script4993;
~script4994;
def_int $int0 = -1;
def_int $int1 = 0;
if (clanprofile_find = true) {
    $int0 = %clan_stronghold_tier;
    if_sethide(false, clan_stronghold_main_buildings:building_button_walls_layer);
    if_sethide(false, clan_stronghold_main_buildings:building_button_warehouse_layer);
    if_sethide(false, clan_stronghold_main_buildings:building_button_battlefield_layer);
    if_sethide(false, clan_stronghold_main_buildings:building_button_woodcutting_layer);
    $int1 = 4;
    if ($int0 >= 2) {
        if_sethide(false, clan_stronghold_main_buildings:building_button_mining_layer);
        $int1 = calc($int1 + 1);
    }
    if ($int0 >= 3) {
        if_sethide(false, clan_stronghold_main_buildings:building_button_firemaking_layer);
        if_sethide(false, clan_stronghold_main_buildings:building_button_smithing_layer);
        $int1 = calc($int1 + 2);
    }
    if ($int0 >= 5) {
        if_sethide(false, clan_stronghold_main_buildings:building_button_summoning_layer);
        if_sethide(false, clan_stronghold_main_buildings:building_button_crafting_layer);
        $int1 = calc($int1 + 2);
    }
    if ($int0 >= 6) {
        if_sethide(false, clan_stronghold_main_buildings:building_button_cooking_layer);
        $int1 = calc($int1 + 1);
    }
    if (calc($int1 % 2) ! 0) {
        $int1 = calc($int1 + 1);
    }
    if_setscrollsize(if_getwidth(clan_stronghold_main_buildings:building_button_scrolling_layer), calc($int1 / 2 * 58 + 6), clan_stronghold_main_buildings:building_button_scrolling_layer);
    ~scrollbar_vertical(clan_stronghold_main_buildings:building_button_scrollbar_layer, clan_stronghold_main_buildings:building_button_scrolling_layer, "aif_scrollbar_dragger_2,3", "aif_scrollbar_dragger_2,0", "aif_scrollbar_dragger_2,1", "aif_scrollbar_dragger_2,2", "aif_scrollbar_arrow_2,1", "aif_scrollbar_arrow_2,0");
}
