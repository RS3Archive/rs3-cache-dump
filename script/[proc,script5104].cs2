// 5104
[proc,script5104](int $int0, component $component1, component $component2, component $component3, component $component4, component $component5)
if_sethide(true, $component1);
if_sethide(false, $component2);
if ($int0 = 1) {
    if_settext("Click to add<br>clan relationship", $component3);
    if_setop(1, "Add", $component4);
    if_sethide(true, $component5);
} else {
    if_settext("No clan set", $component3);
    if_clearops($component4);
    if_sethide(false, $component5);
}
