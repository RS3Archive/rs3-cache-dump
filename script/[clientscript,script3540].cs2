// 3540
[clientscript,script3540](component $component0, component $component1, component $component2)
if (%trh165_core_type_selected = 1) {
    ~script9554($component0, $component1, $component2, "Pulse Core Skills Toggle", toplevel_v2_default_main_modal_skin_data);
} else if (%trh165_core_type_selected = 2) {
    ~script9554($component0, $component1, $component2, "Cinder Core Skills Toggle", toplevel_v2_default_main_modal_skin_data);
}
