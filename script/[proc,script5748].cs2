// 5748
[proc,script5748](component $component0, int $int1)
def_int $int2 = 3;
def_int $int3 = calc(5 * (%sworlds_max_world_reached / 5) + 3);
if ($int3 < calc(5 * 10 + 3)) {
    $int3 = calc(5 * 10 + 3);
}
while ($int2 <= $int3) {
    if (cc_find($component0, $int2) = true) {
        cc_sethide(true);
    }
    $int2 = calc($int2 + 5);
}
if (cc_find($component0, $int1) = true) {
    cc_sethide(false);
}
