// 19054
[proc,script19054](int $int0)
switch_int ($int0) {
    case 1 :
        if_setgraphic(trh183_main_chest_panel, trh183_overlay:chest_1_parchment);
        if_sethide(false, trh183_overlay:chest_1_prize_layer);
        if_sethide(false, trh183_overlay:chest_1_multiplier_icon);
        if_sethide(false, trh183_overlay:chest_1_prize_info);
    case 2 :
        if_setgraphic(trh183_main_chest_panel, trh183_overlay:chest_2_parchment);
        if_sethide(false, trh183_overlay:chest_2_prize_layer);
        if_sethide(false, trh183_overlay:chest_2_multiplier_icon);
        if_sethide(false, trh183_overlay:chest_2_prize_info);
    case 3 :
        if_setgraphic(trh183_main_chest_panel, trh183_overlay:chest_3_parchment);
        if_sethide(false, trh183_overlay:chest_3_prize_layer);
        if_sethide(false, trh183_overlay:chest_3_multiplier_icon);
        if_sethide(false, trh183_overlay:chest_3_prize_info);
}
