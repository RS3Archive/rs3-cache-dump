// 17557
[proc,script17557](string $string0, int $int0, component $component1)
def_string $string1 = "";
def_int $int2 = 0;
def_int $int3 = 0;
switch_component ($component1) {
    case activity_progress_bar_extension:progress_bar_text :
        $int2 = %activity_progress_bar_extension_progress_bar_max;
        $int3 = %activity_progress_bar_extension_progress_bar_value;
