// 12347
[clientscript,script12347](component $component0, int $int1, int $int2)
if ($component0 = null) {
    return;
}
if (.if_find($component0) = true & .cc_param(rs3tli_component_param_int1) ! -1 & .cc_param(rs3tli_component_param_int1) < clientclock & .cc_param(rs3tli_component_param_int0) ! 1) {
    .cc_setparam(rs3tli_component_param_int1, -1);
    if ($int1 ! -1 & cc_find($component0, $int1) = true) {
