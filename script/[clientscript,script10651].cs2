// 10651
[clientscript,script10651]
if (%mtxmgt_show_all = 1) {
    if_sethide(false, mtxmgt:show_all_toggle_button_off_icon);
    if_sethide(true, mtxmgt:show_all_toggle_button_on_icon);
} else {
    if_sethide(true, mtxmgt:show_all_toggle_button_off_icon);
    if_sethide(false, mtxmgt:show_all_toggle_button_on_icon);
}
if (%mtxmgt_selected_category = 2) {
    ~script10653(%mtxmgt_selected_filter, 1);
} else {
    ~script7494;
    ~script7491(%mtxmgt_selected_tab_subcat, %mtxmgt_show_all, 0, %mtxmgt_search_save);
    ~script6481(%mtxmgt_last_selected_component, %mtxmgt_last_selected_comsubid);
}
