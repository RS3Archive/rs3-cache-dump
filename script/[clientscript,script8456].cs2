// 8456
[clientscript,script8456](component $component0, int $int1)
switch_int ($int1) {
    case 1 :
        %combatv2_equip_screen_vs_level = max(2, min(198, calc(%combatv2_equip_screen_vs_level + 1)));
    case 2 :
        %combatv2_equip_screen_vs_level = max(2, min(198, calc(%combatv2_equip_screen_vs_level + 10)));
}
~script8454($component0);
