// 5372
[clientscript,script5372](component $component0, int $int1)
def_int $int2 = 3;
def_int $int3 = calc(if_getx($component0) + if_getwidth($component0) / 2 - if_getwidth(agidad_overlay:numbers) / 2);
if ($int3 >= $int1) {
    if_setposition($int1, if_gety($component0), ^setpos_abs_centre, ^setpos_abs_top, $component0);
    if_setontimer(null, $component0);
} else {
    if_setposition(calc($int3 + $int2), if_gety($component0), ^setpos_abs_centre, ^setpos_abs_top, $component0);
}
