// 475
[clientscript,skillcape_perks_load]
~script476(1, skillcape_perks:perk1_holder, skillcape_perks:perk1_icon, skillcape_perks:perk1_title, skillcape_perks:perk1_description);
~script476(2, skillcape_perks:perk2_holder, skillcape_perks:perk2_icon, skillcape_perks:perk2_title, skillcape_perks:perk2_description);
if (%skillcape_perks_obj = skillcape_max) {
    if_sethide(false, skillcape_perks:perk3_holder);
    ~script476(3, skillcape_perks:perk3_holder, skillcape_perks:perk3_icon, skillcape_perks:perk3_title, skillcape_perks:perk3_description);
} else {
    if_sethide(true, skillcape_perks:perk3_holder);
}
