// 5405
[clientscript,script5405](int $int0, component $component1, component $component2)
def_int $int3 = 0;
if (calc(clientclock % 1) = 0) {
    $int3 = if_getwidth($component2);
    $int3 = calc($int3 - 490);
    if (%dom_taunt_x_pos > $int3) {
        if_setontimer(null, dom_taunt_overlay:player_name_layer);
        return;
    }
    if ($int0 = 0) {
        if_setposition(%dom_taunt_x_pos, 100, ^setpos_abs_left, ^setpos_abs_top, $component1);
    } else {
        if_setposition(%dom_taunt_x_pos, 100, ^setpos_abs_right, ^setpos_abs_bottom, $component1);
    }
    if (%dom_taunt_x_pos < 25) {
        %dom_taunt_x_pos = calc(%dom_taunt_x_pos + 14);
    } else if (%dom_taunt_x_pos < 50) {
        %dom_taunt_x_pos = calc(%dom_taunt_x_pos + 12);
    } else if (%dom_taunt_x_pos < 100) {
        %dom_taunt_x_pos = calc(%dom_taunt_x_pos + 10);
    } else if (%dom_taunt_x_pos < 150) {
        %dom_taunt_x_pos = calc(%dom_taunt_x_pos + 8);
    } else if (%dom_taunt_x_pos < 200) {
        %dom_taunt_x_pos = calc(%dom_taunt_x_pos + 5);
    } else if (%dom_taunt_x_pos < 250) {
        %dom_taunt_x_pos = calc(%dom_taunt_x_pos + 3);
    } else {
        %dom_taunt_x_pos = calc(%dom_taunt_x_pos + 1);
    }
}
