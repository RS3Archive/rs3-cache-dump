// 8812
[proc,script8812]
if_setobject_nonum(%wishing_well_player_donate_obj, ^max_32bit_int, donation:item_to_donate);
if_settext(oc_name(%wishing_well_player_donate_obj), donation:item_name);
if_settext("You can donate <tostring_localised(%wishing_well_player_max_amount, true)>", donation:item_amount);
