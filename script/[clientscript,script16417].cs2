// 16417
[clientscript,script16417](int $int0, component $component1)
if (calc(clientclock % 15) ! 0) {
    return;
}
if (db_getfield(%uitutorial_current_step, uitutorial_step:col21, 0) = true) {
    return;
}
if (cc_find($component1, $int0) = true) {
    switch_graphic (cc_getgraphic) {
        case default :
