// 11947
[proc,script11947]
~script3536("Scrolls remaining in your backpack", lore_stats_side:scroll_inv, -1);
~script3536("Scrolls remaining in your familiar", lore_stats_side:scroll_familiar, -1);
~script3536("Scrolls remaining in your backpack and familiar", lore_stats_side:lore_scroll_counter_small, -1);
if (if_find(lore_stats_side:scroll_object) = true) {
    cc_setonmouserepeat("script8799(~script5554(%follower_obj), lore_stats_side:scroll_object, -1)");
}
~script3536(~script5554(%follower_obj), lore_stats_side:scroll_counter_graphic_small, -1);
~script3536("Time remaining until your familiar desummons", lore_stats_side:time, -1);
~script3536("Time remaining until your familiar desummons", lore_stats_side:animal_fixed_time_left, -1);
~script3536("Familiar life points", lore_stats_side:lore_familiar_healthbar_button, -1);
~script3536("Familiar spell points", lore_stats_side:lore_familiar_specbar_button, -1);
if (%lore_bob_collapsed = 1) {
    ~script3536("<tostring(%lore_follower_lifepoints)>/<tostring(%lore_follower_base_lifepoints)>", lore_stats_side:lore_fixed_health_bar, -1);
    ~script3536("<tostring(%lore_spell_points)>/60", lore_stats_side:lore_fixed_spell_points, -1);
} else {
    ~script3536("Familiar life points", lore_stats_side:lore_fixed_health_bar, -1);
    ~script3536("Familiar spell points", lore_stats_side:lore_fixed_spell_points, -1);
}
~script3536("Pet hunger", lore_stats_side:lore_pet_hunger_button, -1);
~script3536("Pet growth", lore_stats_side:lore_pet_growth_button, -1);
