// 10576
[clientscript,script10576]
if (inv_total(inv, trh29_doubloons) < 100) {
    return;
}
if (inv_freespace(inv) = 0) {
    return;
}
%trh29_pirate_coins_shop_selection = 10;
if_setgraphic(trh29_pirate_icon_biscuit, trh29_pirate_coins_shop:popup_icon);
if_settext("Good old-fashioned pirate food. Eat for healing and a random stat boost. (+2 stat boost. Heals the same as a mackerel)", trh29_pirate_coins_shop:popup_description);
if_settext("Buy a ship's biscuit?", trh29_pirate_coins_shop:popup_question);
if_sethide(false, trh29_pirate_coins_shop:popup_layer);
