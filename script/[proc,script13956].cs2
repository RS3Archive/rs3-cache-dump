// 13956
[proc,script13956]()(int)
switch_int (%trh117_staff_level) {
    case default :
        return(0);
    case 2, 3 :
        if (stat_base(magic) >= 70) {
            return(1);
        }
        return(0);
    case 4 :
        if (stat_base(magic) >= 70) {
            return(2);
        }
        return(3);
    case 5 :
        if (stat_base(magic) >= 75) {
            return(4);
        }
        if (stat_base(magic) >= 70) {
            return(2);
        }
        return(3);
}
