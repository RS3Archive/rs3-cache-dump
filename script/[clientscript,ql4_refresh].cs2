// 2169
[clientscript,ql4_refresh](component $component0)
%ql4_sort_mode = %ql4_perm_sort;
%ql4_reverse_list = %ql4_perm_reverse;
%ql4_filter_doable = %ql4_perm_filter;
%ql4_filter_done = %ql4_perm_donefilter;
%ql4_filter_fullquests = %ql4_perm_hidefullquests;
%ql4_filter_miniquests = %ql4_perm_hideminiquests;
~ql4_sort($component0, 1, %ql4_sort_mode, %ql4_reverse_list, %ql4_filter_doable, %ql4_filter_done, %ql4_filter_fullquests, %ql4_filter_miniquests);
