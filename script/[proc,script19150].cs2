// 19150
[proc,script19150](struct $struct0)(dbrow)
def_dbrow $dbrow1 = null;
switch_struct ($struct0) {
    case trh182_promo :
        if (%trh182_monster_id < 0) {
            ~error("Invalid monster id.");
        }
        db_find(trh182_monsters:col0, %trh182_monster_id);
        $dbrow1 = db_findnext;
    case trh203_promo :
        if (%trh203_node_id < 0) {
            ~error("Invalid node id.");
        }
        db_find(trh203_nodes:col0, %trh203_node_id);
        $dbrow1 = db_findnext;
    case trh207_promo :
        if (%trh207_node_id < 0) {
            ~error("Invalid node id.");
        }
        db_find(trh207_nodes:col0, %trh207_node_id);
        $dbrow1 = db_findnext;
    case default :
        ~error("Missed plugin point for promo ID <tostring(struct_param($struct0, trh_promo_id))>");
}
if ($dbrow1 = null) {
    ~error("Cannot find a valid dbrow.");
}
return($dbrow1);
