// 14709
[clientscript,info_popup_timer](int $int0)
def_int $int1 = -1;
def_int $int2 = calc(clientclock - $int0);
if ($int2 < 50) {
    if_settrans(scale(255, 50, $int2), interface_512:com_12);
} else if ($int2 >= 50 & $int2 < 150) {
    if_sethide(true, interface_512:com_12);
} else if ($int2 >= 150 & $int2 < 200) {
    $int2 = calc(255 - scale(255, 50, calc(200 - $int2)));
    while (++$int1 < if_getnextsubid(interface_512:com_1)) {
        if (cc_find(interface_512:com_1, $int1) = true) {
            cc_settrans($int2);
        }
    }
    $int1 = -1;
    while (++$int1 < if_getnextsubid(interface_512:com_9)) {
        if (cc_find(interface_512:com_9, $int1) = true) {
            cc_settrans($int2);
        }
    }
    if_settrans($int2, interface_512:com_7);
    if_settrans($int2, interface_512:com_8);
    if_settrans($int2, interface_512:com_4);
    if_settrans($int2, interface_512:com_5);
    if_settrans($int2, interface_512:com_11);
}
