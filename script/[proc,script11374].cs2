// 11374
[proc,script11374](component $component0, int $int1, struct $struct2)
if (cc_find($component0, $int1) = true) {
    if (~script11309(struct_param($struct2, mm15_task_id)) = 0) {
        cc_setcolour(~script10495(3));
        cc_setonmouseover("cc_text_colour_swapper($component0, $int1, 16777215)");
        cc_setonmouseleave("cc_text_colour_swapper($component0, $int1, ~script10495(3))");
        cc_setonop("script6959($struct2, $component0, $int1)");
        cc_setop(1, "Select");
        cc_setopbase(struct_param($struct2, mm15_task_desc));
    } else {
        cc_setcolour(~rgb_to_hex(152, 209, 152));
        cc_setonmouseover(null);
        cc_setonmouseleave(null);
        cc_clearops;
    }
}
