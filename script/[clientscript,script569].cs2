// 569
[clientscript,script569]
~chat_v3_set_safe_area;
~script5695;
~script20389;
def_int $rgb0 = 0x3b1d2a;
if (%toplevel_v2_active_skinset = 1) {
    $rgb0 = 0x1b1915;
} else if (%toplevel_v2_active_skinset = 0) {
    $rgb0 = 0x6a3c20;
}
if_setcolour($rgb0, chat_v3:left_name_box);
if_setcolour($rgb0, chat_v3:right_name_box);
if_setcolour($rgb0, chat_v3:left_name_box_1);
if_setcolour($rgb0, chat_v3:right_name_box_1);
if_setcolour($rgb0, chat_v3_overlay:left_name_box);
if_setcolour($rgb0, chat_v3_overlay:right_name_box);
if_setcolour($rgb0, chat_v3_overlay:left_name_box_1);
if_setcolour($rgb0, chat_v3_overlay:right_name_box_1);
if_setcolour($rgb0, chat_v3_choice:right_name_box);
if_setcolour($rgb0, chat_v3_choice:right_name_box_1);
if_setcolour(0x010000, chat_v3:fade_to_black);
if_setcolour(0x010000, chat_v3_choice:fade_to_black);
if (%chat_v3_toggle_background = 1) {
    if_sethide(true, chat_v3:fade_to_black);
    if_sethide(true, chat_v3_choice:fade_to_black);
} else {
    if_sethide(false, chat_v3:fade_to_black);
    if_sethide(false, chat_v3_choice:fade_to_black);
}
