// 3488
[clientscript,rand_ring_interface_init]
max(%rand_ring_interface_selected_tab, 1);
switch_int (%rand_ring_interface_selected_tab) {
    case 1 :
        if_setsize(scale(250, 100, calc(%rand_tank_ring * 10)), 17, ^setsize_abs, ^setsize_abs, rand_ring_interface:ring_a_bar_actual);
        if (%rand_tank_ring = 10) {
            if_sethide(true, rand_ring_interface:upgrade_ring_a_layer);
        } else {
