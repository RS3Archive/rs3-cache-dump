def_enum $enum0 = enum(int, enum, rand_ring_enums, %rand_ring_interface_selected_tab);
if_settext(struct_param(enum(int, struct, $enum0, 1), rand_ring_spec), rand_ring_interface:ring_a_name);
if_settext(struct_param(enum(int, struct, $enum0, 1), rand_ring_desc), rand_ring_interface:ring_a_description);
if_settext(struct_param(enum(int, struct, $enum0, 2), rand_ring_spec), rand_ring_interface:ring_b_name);
if_settext(struct_param(enum(int, struct, $enum0, 2), rand_ring_desc), rand_ring_interface:ring_b_description);
if_settext(struct_param(enum(int, struct, $enum0, 3), rand_ring_spec), rand_ring_interface:ring_c_name);
if_settext(struct_param(enum(int, struct, $enum0, 3), rand_ring_desc), rand_ring_interface:ring_c_description);
~script7227;
