~script13995(rand_ring_interface:melee_button_graphic, null, rs3tli_3x3_button, "", ~equal_int(%rand_ring_interface_selected_tab, 1));
~script13995(rand_ring_interface:ranged_button_graphic, null, rs3tli_3x3_button, "", ~equal_int(%rand_ring_interface_selected_tab, 2));
