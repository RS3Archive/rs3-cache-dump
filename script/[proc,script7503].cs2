// 7503
[proc,script7503](obj $obj0)(graphic)
def_graphic $graphic1 = null;
switch_obj ($obj0) {
    case rand_dnd_card_praying_mantis :
        $graphic1 = aif_mantis_card_sml;
    case rand_dnd_card_bloated_leech :
        $graphic1 = aif_leech_card_sml;
    case rand_dnd_card_spirit_mosquito :
        $graphic1 = aif_mosquito_card_sml;
    case rand_dnd_card_bunyip :
        $graphic1 = aif_bunnyip_card_sml;
    case rand_dnd_card_steel_titan :
        $graphic1 = aif_steel_titan_card_sml;
    case rand_dnd_card_ravenous_locust :
        $graphic1 = aif_locust_card_sml;
    case rand_dnd_card_pack_yak :
        $graphic1 = aif_yak_card_sml;
    case rand_dnd_card_meerkat :
        $graphic1 = aif_meerkat_card_sml;
    case rand_dnd_card_phoenix :
        $graphic1 = aif_phoenix_card_sml;
    case rand_dnd_card_ibis :
        $graphic1 = aif_stork_card_sml;
    case rand_dnd_card_smoke_devil :
        $graphic1 = aif_dust_devil_card_sml;
}
return($graphic1);
