// 11520
[proc,script11520]
cc_deleteall(mtxmgt_colour_overlay:prismatic_wheel_active);
%mtxmgt_colour_last_hue = -1;
def_int $int0 = 0;
while ($int0 < 32) {
    cc_create(mtxmgt_colour_overlay:prismatic_wheel_active, ^iftype_rectangle, $int0);
    cc_setposition(0, 0, ^setpos_abs_left, ^setpos_abs_top);
    cc_setsize(0, 0, ^setsize_minus, ^setsize_minus);
    cc_setop(1, "Select");
    cc_sethide(true);
    cc_setcolour(^black);
    cc_settrans(255);
    $int0 = calc($int0 + 1);
}
~script11521(%mtxmgt_temp_hue);
