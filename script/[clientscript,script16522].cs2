// 16522
[clientscript,script16522](int $int0, int $int1)
if (calc(clientclock % $int1) = 0 & cc_findbycategory(wheel_of_fortune:background_holder, $int0, 0) = 1) {
    if (cc_getscrollx > 0) {
        cc_setscrollpos(calc(cc_getscrollx - 1), 0);
    } else {
        cc_setscrollpos(cc_getscrollwidth, 0);
    }
}
