// 17113
[proc,gravestone_timer_update]
if (%varplayerbit_52412 > 0 & %varclient_815 > 0) {
    %varclient_815 = calc(%varclient_815 - 1);
    ~gravestone_timer_build_gravestone;
} else if (%varplayerbit_52409 > 0 | %varplayerbit_52410 > 0 | %varplayerbit_52411 > 0) {
    ~gravestone_stop_timer(0);
    ~script17115;
} else {
    if_sethide(true, interface_1483:com_1);
    ~gravestone_stop_timer(1);
}
