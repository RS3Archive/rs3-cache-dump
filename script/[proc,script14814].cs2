// 14814
[proc,script14814](component $component0, int $int1, int $int2, component $component3, component $component4)
if ($int2 = -1) {
    if_setscrollpos(0, max(0, calc(if_getscrolly($component0) - $int1)), $component0);
} else {
    if_setscrollpos(0, min(if_getscrollheight($component0), calc(if_getscrolly($component0) + $int1)), $component0);
}
def_int $int5 = calc(if_getscrolly($component0) / max(1, $int1));
if_settext(tostring(calc(1 + 2 * $int5)), $component3);
if_settext(tostring(calc(2 + 2 * $int5)), $component4);
