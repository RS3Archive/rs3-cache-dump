// 18346
[proc,script18346]
%trh195_prize_multiplier = max(1, %trh195_prize_multiplier);
def_graphic $graphic0 = null;
if (%trh195_prize_multiplier < 2) {
    if_sethide(true, trh195:potion_multiplier_1);
    if_sethide(true, trh195:potion_multiplier_2);
    if_sethide(true, trh195:potion_multiplier_3);
} else {
    $graphic0 = ~script10980(%trh195_prize_multiplier);
    if_setgraphic($graphic0, trh195:potion_multiplier_1);
    if_setgraphic($graphic0, trh195:potion_multiplier_2);
    if_setgraphic($graphic0, trh195:potion_multiplier_3);
    if_sethide(false, trh195:potion_multiplier_1);
    if_sethide(false, trh195:potion_multiplier_2);
    if_sethide(false, trh195:potion_multiplier_3);
}
