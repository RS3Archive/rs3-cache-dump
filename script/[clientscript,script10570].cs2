// 10570
[clientscript,script10570]
if (%trh29_wheel_shield_owned = 1) {
    return;
}
if (inv_total(inv, trh29_doubloons) < 1500) {
    return;
}
if (inv_freespace(inv) = 0) {
    return;
}
%trh29_pirate_coins_shop_selection = 4;
if_setgraphic(trh29_pirate_icon_shield, trh29_pirate_coins_shop:popup_icon);
if_settext("Defend yourself with this wheel, pulled straight from a pirate ship. (Shield with level 1 and level 40 versions)", trh29_pirate_coins_shop:popup_description);
if_settext("Buy ship's wheel shield?", trh29_pirate_coins_shop:popup_question);
if_sethide(false, trh29_pirate_coins_shop:popup_layer);
