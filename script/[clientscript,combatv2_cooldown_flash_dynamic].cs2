// 6299
[clientscript,combatv2_cooldown_flash_dynamic](component $component0, int $int1, int $int2, int $int3)
def_int $int4 = 0;
if ($int1 = -1 & if_find($component0) = true | cc_find($component0, $int1) = true) {
    $int4 = calc(clientclock - $int3);
    if ($int4 >= 16) {
        cc_settrans(255);
        cc_setfill(false);
        cc_setontimer(null);
    } else {
        cc_settrans(min(255, calc(35 * abs(calc(8 - $int4)))));
    }
}
