// 13330
[clientscript,cheevo_onload]
%cheevo_current_list = null;
%cheevo_selected_cat_client = 0;
%cheevo_selected_subcat_client = 0;
~static_checkbox_create(achievements_sub:hide_comp_build, achievements_sub:hide_comp_click, "Show Completed", "", "", calc(1 - min(%cheevo_toggle_complete, 1)));
~static_checkbox_create(achievements_sub:hide_locked_build, achievements_sub:hide_locked_click, "Show Locked", "", "", calc(1 - min(%cheevo_toggle_locked, 1)));
~static_checkbox_create(achievements_sub:toggle_list_build, achievements_sub:toggle_list_click, "List Mode", "", "", %cheevo_min_mode);
if_setonvartransmit("script15361{cheevo_misc_varp}", achievements_sub:cheevo_panel_controls);
~script9056;
~script15365;
