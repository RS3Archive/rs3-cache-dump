// 1689
[proc,script1689]
if (++%mah4_cutscene_fade_framecount >= calc(2 - 1)) {
    %mah4_cutscene_fade_framecount = 0;
    if (%mah4_cutscene_fade_direction = 0) {
        %mah4_cutscene_fade_transparency = min(calc(%mah4_cutscene_fade_transparency + 2), 255);
    } else if (%mah4_cutscene_fade_direction = 1) {
        %mah4_cutscene_fade_transparency = max(calc(%mah4_cutscene_fade_transparency - 2), 0);
    }
    if_settrans(%mah4_cutscene_fade_transparency, mah4_cutscene_overlay:black_rect);
}
if (++%mah4_golden_framecount >= calc(6 - 1)) {
    %mah4_golden_framecount = 0;
    if (%mah4_golden_direction = 0) {
        %mah4_golden_transparency = min(calc(%mah4_golden_transparency + 1), 255);
        if (%mah4_golden_transparency >= 255) {
            %mah4_golden_direction = 1;
        }
    } else if (%mah4_golden_direction = 1 & %mah4_golden_active = 1) {
        %mah4_golden_transparency = max(calc(%mah4_golden_transparency - 3), 192);
        if (%mah4_golden_transparency <= 192) {
            %mah4_golden_direction = 0;
        }
    } else {
        %mah4_golden_transparency = 255;
    }
    if_settrans(%mah4_golden_transparency, mah4_cutscene_overlay:yellow_rect);
}
