// 10403
[proc,script10403](int $int0)(int)
switch_int ($int0) {
    case 7 :
        return(%option_publicchatcolour);
    case 0 :
        return(%option_friendchatcolour);
    case 1 :
        return(%option_pm);
    case 2 :
        return(%option_clanchatcolour);
    case 3 :
        return(%option_guestchatcolour);
    case 4 :
        return(%option_groupchatcolour);
    case 5 :
        return(%option_groupchatteamcolour);
    case 17 :
        return(%option_group_ironman_chatcolour);
    case 6 :
        return(%option_twitchchatcolour);
    case 8 :
        return(%option_broadcast_global_colour);
    case 9 :
        return(%option_broadcast_world_colour);
    case 10 :
        return(%option_broadcast_friends_colour);
    case 11 :
        return(~settings_get_state(settings_accessibility_highlight_active_player_colour));
    case 12 :
        return(~settings_get_state(settings_accessibility_highlight_other_player_colour));
    case 13 :
        return(~settings_get_state(settings_accessibility_highlight_npc_colour));
    case 14 :
        return(~settings_get_state(settings_accessibility_highlight_monster_colour));
    case 15 :
        return(~settings_get_state(settings_accessibility_highlight_interactables_colour));
    case 16 :
        return(~settings_get_state(settings_accessibility_highlight_loot_colour));
    case default :
        return(-1);
}
