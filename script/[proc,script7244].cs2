// 7244
[proc,script7244](obj $obj0)(int)
def_int $int1 = 0;
def_int $int2 = 0;
def_int $int3 = 0;
def_stat $stat4 = null;
if (oc_param($obj0, combatv2_magic_weapon) = 1) {
    $int1 = oc_param($obj0, magicattack);
    $stat4 = magic;
} else if (oc_param($obj0, combatv2_melee_weapon) = 1) {
    $int1 = oc_param($obj0, meleeattack);
    $stat4 = attack;
} else if (oc_param($obj0, combatv2_ranged_weapon) = 1) {
    $int1 = oc_param($obj0, rangeattack);
    $stat4 = ranged;
} else if (oc_param($obj0, combatv2_necromancy_weapon) = 1) {
    $int1 = oc_param($obj0, necromancyattack);
    $stat4 = necromancy;
}
if ($stat4 ! null) {
    $int2 = enum(int, int, combatv2_weapon_level, $int1);
    $int1 = max(0, enum(int, int, combatv2_weapon_attack_value, $int2));
    $int3 = max(0, min(10, scale(calc(stat($stat4) - $int2), 100, 50)));
    $int3 = enum(int, int, combatv2_weapon_attack_value, calc($int3 + $int2));
    $int3 = max(0, calc($int3 - enum(int, int, combatv2_weapon_attack_value, min(85, $int2))));
}
return($int1);
