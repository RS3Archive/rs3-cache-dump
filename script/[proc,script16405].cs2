// 16405
[proc,script16405](component $component0)
switch_component ($component0) {
    case uitutorial:arrow_below :
        if_setontimer("script16407(event_com, 10, 0, 0)", uitutorial:arrow_below_moving);
    case uitutorial:arrow_above :
        if_setontimer("script16407(event_com, 20, 20, 0)", uitutorial:arrow_above_moving);
    case uitutorial:arrow_right :
        if_setontimer("script16407(event_com, 10, 0, 1)", uitutorial:arrow_right_moving);
    case uitutorial:arrow_left :
        if_setontimer("script16407(event_com, 20, 20, 1)", uitutorial:arrow_left_moving);
}
