// 10595
[proc,script10595](int $int0)
def_int $int1 = calc(30000 - $int0);
def_int $int2 = 0;
def_int $int3 = 0;
def_string $string0 = "";
if (calc($int1 % 50) ! 0) {
    return;
}
$int1 = calc($int1 / 50);
$int2 = max(0, calc($int1 / 60));
$int3 = max(0, calc($int1 % 60));
if ($int3 < 10) {
    $string0 = "0";
}
if_settext("<tostring($int2)>:<$string0><tostring($int3)>", elfcity_rush_of_blood_timer:green_large_progress_text);
~aif_progressbar_set(scale($int1, 600, 100), elfcity_rush_of_blood_timer:green_large_progress_value_layer, null);
