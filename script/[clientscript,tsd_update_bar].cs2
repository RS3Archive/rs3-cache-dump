// 7557
[clientscript,tsd_update_bar](component $component0)
def_int $int1 = 0;
def_component $component2 = interface_1398:com_66;
switch_component ($component0) {
    case interface_1398:com_1 :
        $int1 = calc(%varplayerbit_18117 * 11);
        $component2 = interface_1398:com_47;
    case interface_1398:com_0 :
        $int1 = calc(%varplayerbit_18116 * 11);
        $component2 = interface_1398:com_49;
    case interface_1398:com_2 :
        $int1 = calc(%varplayerbit_18119 * 11);
        $component2 = interface_1398:com_45;
    case interface_1398:com_3 :
        $int1 = calc(%varplayerbit_18118 * 11);
        $component2 = interface_1398:com_44;
}
if ($int1 = 0) {
    if_setsize(if_getwidth($component0), 0, ^setsize_abs, ^setsize_abs, $component0);
} else {
    if ($int1 > 128) {
        $int1 = 128;
    }
    if_setontimer("tsd_update_bar_timer($int1, $component0, $component2)", $component2);
}
