// 1066
[proc,quickchat_path_scroll](component $component0, int $int1, int $int2)
def_int $int3 = if_getwidth($component0);
def_int $int4 = 0;
def_int $int5 = 0;
def_int $int6 = 0;
while (cc_find($component0, $int5) = true) {
    $int4 = calc($int4 + cc_getwidth);
    $int5 = calc($int5 + 1);
}
if ($int4 <= $int3) {
    $int5 = 0;
    $int6 = 0;
    while (cc_find($component0, $int5) = true) {
        cc_sethide(false);
        cc_setposition($int6, 0, ^setpos_abs_left, ^setpos_abs_top);
        if (.cc_find(~script8601($int2), $int5) = true) {
            .cc_setposition(cc_getx, cc_gety, ^setpos_abs_left, ^setpos_abs_top);
        }
        $int6 = calc($int6 + cc_getwidth);
        $int5 = calc($int5 + 1);
    }
    return;
}
cc_create($component0, ^iftype_text, calc($int1 + 1));
cc_setcolour(^white);
cc_settextfont(museo_sans_11pt_regular);
cc_settextalign(^settextalign_left, ^settextalign_centre, 0);
cc_settext(" ... <img=<2>>");
cc_settextshadow(true);
cc_setsize(parawidth(" ... <img=<2>>", $int3, museo_sans_11pt_regular), if_getheight($component0), ^setsize_abs, ^setsize_abs);
$int4 = cc_getwidth;
if (cc_find($component0, $int1) = true) {
    $int4 = calc($int4 + cc_getwidth);
}
$int5 = 0;
while ($int5 < $int1) {
    if (cc_find($component0, $int5) = true) {
        if (calc($int4 + cc_getwidth) <= $int3) {
            cc_sethide(false);
            $int4 = calc($int4 + cc_getwidth);
        } else {
            cc_sethide(true);
        }
    }
    $int5 = calc($int5 + 1);
}
$int5 = 0;
$int6 = 0;
while ($int5 < $int1) {
    if (cc_find($component0, $int5) = true) {
        if (cc_gethide = false) {
            cc_setposition($int6, 0, ^setpos_abs_left, ^setpos_abs_top);
            if (.cc_find(~script8601($int2), $int5) = true) {
                .cc_setposition(cc_getx, cc_gety, ^setpos_abs_left, ^setpos_abs_top);
            }
            $int6 = calc($int6 + cc_getwidth);
        } else if (.cc_find(~script8601($int2), $int5) = true) {
            .cc_sethide(true);
        }
    }
    $int5 = calc($int5 + 1);
}
if (cc_find($component0, calc($int1 + 1)) = true) {
    cc_setposition($int6, 0, ^setpos_abs_left, ^setpos_abs_top);
    $int6 = calc($int6 + cc_getwidth);
}
if (cc_find($component0, $int1) = true) {
    cc_setposition($int6, 0, ^setpos_abs_left, ^setpos_abs_top);
    if (.cc_find(~script8601($int2), $int5) = true) {
        .cc_setposition(cc_getx, cc_gety, ^setpos_abs_left, ^setpos_abs_top);
    }
