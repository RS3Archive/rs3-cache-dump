// 11260
[clientscript,script11260](component $component0, component $component1, component $component2, component $component3, struct $struct4)
if (if_getwidth($component0) > 30) {
    if_setontimer("script11262($component0, $component3)", $component0);
    ~script9554($component1, $component2, $component3, " ", $struct4);
    if_sethide(true, jmod_tool:close_button_layer);
} else {
    if_setontimer("script11261($component0, $component3)", $component0);
    ~script9554($component1, $component2, $component3, "JMod Toolbox", $struct4);
    if_sethide(false, $component3);
    if_sethide(false, jmod_tool:close_button_layer);
}
