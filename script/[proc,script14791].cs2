// 14791
[proc,script14791]()(string)
def_string $string0 = "Sprite Focus - A 10% increase to Archaeology XP";
def_string $string1 = "Bonus (<tostring(40)>%) : A further 10% increase to Archaeology XP and a 10% increase to your mattock's precision";
def_string $string2 = "Bonus (<tostring(100)>%) : Guaranteed material and <tostring(~script14581)>x mattock precision for a single action. Your focus is then reduced to <tostring(60)>%";
if (%arch_excavation_focus_count < 40) {
    $string0 = "<$string0><br><br><col=969696><$string1></col><br><col=969696><$string2></col>";
} else {
    $string0 = "<$string0><br><br><$string1><br><col=969696><$string2></col>";
}
return($string0);
