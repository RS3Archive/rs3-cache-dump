if (%wof_promo_spins > 0) {
    $string0 = "Promotion Keys: <col=F0BE79><tostring(%wof_promo_spins)></col><br>";
}
if (%wof_daily_spins > 0) {
    $string0 = "<$string0>Daily Keys: <col=F0BE79><tostring(%wof_daily_spins)></col>";
