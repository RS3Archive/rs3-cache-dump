// 7306
[clientscript,script7306]
if_setcolour(0xfaf2d6, pop_crew:recruit_speed_1);
if_setcolour(0xfaf2d6, pop_crew:recruit_speed_2);
if_setcolour(0xfaf2d6, pop_crew:recruit_speed_3);
if_setcolour(0xfaf2d6, pop_crew:recruit_speed_0);
if_setcolour(0xfaf2d6, pop_crew:recruit_combat_1);
if_setcolour(0xfaf2d6, pop_crew:recruit_combat_2);
if_setcolour(0xfaf2d6, pop_crew:recruit_combat_3);
if_setcolour(0xfaf2d6, pop_crew:recruit_combat_0);
if_setcolour(0xfaf2d6, pop_crew:recruit_graft_1);
if_setcolour(0xfaf2d6, pop_crew:recruit_graft_2);
if_setcolour(0xfaf2d6, pop_crew:recruit_graft_3);
if_setcolour(0xfaf2d6, pop_crew:recruit_graft_0);
if_setcolour(0xfaf2d6, pop_crew:recruit_seafaring_1);
if_setcolour(0xfaf2d6, pop_crew:recruit_seafaring_2);
if_setcolour(0xfaf2d6, pop_crew:recruit_seafaring_3);
if_setcolour(0xfaf2d6, pop_crew:recruit_seafaring_0);
if_setcolour(0xfaf2d6, pop_crew:speed_text);
if_setcolour(0xfaf2d6, pop_crew:graft_text);
if_setcolour(0xfaf2d6, pop_crew:combat_text);
if_setcolour(0xfaf2d6, pop_crew:seafaring_text);
def_component $component0 = null;
def_component $component1 = null;
def_component $component2 = null;
def_component $component3 = null;
def_obj $obj4 = inv_getobj(pop_crew_recruit, %pop_crew_recruit_selected_var);
if (%pop_crew_stat_obj = null | $obj4 = null) {
    return;
}
def_int $int5 = 0;
if (enum_hasoutput(obj, pop_captain_list, %pop_crew_stat_obj) = true & enum_hasoutput(obj, pop_captain_list, $obj4) = false) {
    $int5 = 1;
}
if (enum_hasoutput(obj, pop_captain_list, %pop_crew_stat_obj) = false & enum_hasoutput(obj, pop_captain_list, $obj4) = true) {
    $int5 = 1;
}
switch_int (%pop_crew_recruit_selected_var) {
    case 0 :
        $component0 = pop_crew:recruit_speed_1;
        $component1 = pop_crew:recruit_graft_1;
        $component2 = pop_crew:recruit_combat_1;
        $component3 = pop_crew:recruit_seafaring_1;
    case 1 :
        $component0 = pop_crew:recruit_speed_2;
        $component1 = pop_crew:recruit_graft_2;
        $component2 = pop_crew:recruit_combat_2;
        $component3 = pop_crew:recruit_seafaring_2;
    case 2 :
        $component0 = pop_crew:recruit_speed_3;
        $component1 = pop_crew:recruit_graft_3;
        $component2 = pop_crew:recruit_combat_3;
        $component3 = pop_crew:recruit_seafaring_3;
    case 3 :
        $component0 = pop_crew:recruit_speed_0;
        $component1 = pop_crew:recruit_graft_0;
        $component2 = pop_crew:recruit_combat_0;
        $component3 = pop_crew:recruit_seafaring_0;
}
if ($int5 = 1) {
    if_setcolour(0x616160, pop_crew:speed_text);
    if_setcolour(0x616160, $component0);
} else if (oc_param($obj4, pop_crew_basestat_1) > %pop_crew_stat_speed) {
    if_setcolour(^red, pop_crew:speed_text);
    if_setcolour(0x1d8c07, $component0);
} else if (oc_param($obj4, pop_crew_basestat_1) < %pop_crew_stat_speed) {
    if_setcolour(0x1d8c07, pop_crew:speed_text);
    if_setcolour(^red, $component0);
}
if ($int5 = 1) {
    if_setcolour(0x616160, pop_crew:graft_text);
    if_setcolour(0x616160, $component1);
} else if (oc_param($obj4, pop_crew_basestat_2) > %pop_crew_stat_graft) {
    if_setcolour(^red, pop_crew:graft_text);
    if_setcolour(0x1d8c07, $component1);
} else if (oc_param($obj4, pop_crew_basestat_2) < %pop_crew_stat_graft) {
    if_setcolour(0x1d8c07, pop_crew:graft_text);
    if_setcolour(^red, $component1);
}
if ($int5 = 1) {
    if_setcolour(0x616160, pop_crew:combat_text);
    if_setcolour(0x616160, $component2);
} else if (oc_param($obj4, pop_crew_basestat_3) > %pop_crew_stat_combat) {
    if_setcolour(^red, pop_crew:combat_text);
    if_setcolour(0x1d8c07, $component2);
} else if (oc_param($obj4, pop_crew_basestat_3) < %pop_crew_stat_combat) {
    if_setcolour(0x1d8c07, pop_crew:combat_text);
    if_setcolour(^red, $component2);
}
if ($int5 = 1) {
    if_setcolour(0x616160, pop_crew:seafaring_text);
    if_setcolour(0x616160, $component3);
} else if (oc_param($obj4, pop_crew_basestat_4) > %pop_crew_stat_seafaring) {
    if_setcolour(^red, pop_crew:seafaring_text);
    if_setcolour(0x1d8c07, $component3);
} else if (oc_param($obj4, pop_crew_basestat_4) < %pop_crew_stat_seafaring) {
    if_setcolour(0x1d8c07, pop_crew:seafaring_text);
    if_setcolour(^red, $component3);
}
