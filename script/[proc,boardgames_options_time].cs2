// 1408
[proc,boardgames_options_time]
~static_checkbox(boardgames_options:15seconds1, ~equal_int(%boardgames_timepermove, 0), false);
~static_checkbox(boardgames_options:30seconds1, ~equal_int(%boardgames_timepermove, 1), false);
~static_checkbox(boardgames_options:1minute1, ~equal_int(%boardgames_timepermove, 2), false);
~static_checkbox(boardgames_options:2minutes1, ~equal_int(%boardgames_timepermove, 3), false);
