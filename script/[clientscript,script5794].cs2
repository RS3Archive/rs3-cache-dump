// 5794
[clientscript,script5794]
if (string_length(%bugreport_input) < 1) {
    ~script426("You need to enter bug information before you can continue.", bugreport_interface:next_button, -1, 0);
    return;
}
if_sethide(false, bugreport_interface:prev_button);
if_sethide(true, bugreport_interface:next_button);
if_sethide(false, bugreport_interface:submit_button);
if_sethide(true, bugreport_interface:input_step1);
if_sethide(false, bugreport_interface:input_step2);
if_sethide(false, bugreport_interface:prev_button);
if_sethide(true, bugreport_interface:close_bugreporter);
