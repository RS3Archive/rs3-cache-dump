// 2041
[clientscript,blast_furnace_bar_stock]
if_settext("Steel: <tostring(%blast_furnace_steel_bars)>", blast_furnace_bar_stock:bf_steel);
if (%blast_furnace_steel_bars > 0) {
    if_setcolour(0xff981f, blast_furnace_bar_stock:bf_steelall);
    if_setcolour(0xff981f, blast_furnace_bar_stock:bf_steel);
} else {
    if_setcolour(0x999999, blast_furnace_bar_stock:bf_steelall);
    if_setcolour(0x999999, blast_furnace_bar_stock:bf_steel);
}
if_settext("Mithril: <tostring(%blast_furnace_mithril_bars)>", blast_furnace_bar_stock:bf_mithril);
if (%blast_furnace_mithril_bars > 0) {
    if_setcolour(0xff981f, blast_furnace_bar_stock:bf_mithrilall);
    if_setcolour(0xff981f, blast_furnace_bar_stock:bf_mithril);
} else {
    if_setcolour(0x999999, blast_furnace_bar_stock:bf_mithrilall);
    if_setcolour(0x999999, blast_furnace_bar_stock:bf_mithril);
}
if_settext("Adamant: <tostring(%blast_furnace_adamantite_bars)>", blast_furnace_bar_stock:bf_adamantite);
if (%blast_furnace_adamantite_bars > 0) {
    if_setcolour(0xff981f, blast_furnace_bar_stock:bf_adamantiteall);
    if_setcolour(0xff981f, blast_furnace_bar_stock:bf_adamantite);
} else {
    if_setcolour(0x999999, blast_furnace_bar_stock:bf_adamantiteall);
    if_setcolour(0x999999, blast_furnace_bar_stock:bf_adamantite);
}
if_settext("Rune: <tostring(%blast_furnace_runite_bars)>", blast_furnace_bar_stock:bf_runite);
if (%blast_furnace_runite_bars > 0) {
    if_setcolour(0xff981f, blast_furnace_bar_stock:bf_runiteall);
    if_setcolour(0xff981f, blast_furnace_bar_stock:bf_runite);
} else {
    if_setcolour(0x999999, blast_furnace_bar_stock:bf_runiteall);
    if_setcolour(0x999999, blast_furnace_bar_stock:bf_runite);
}
