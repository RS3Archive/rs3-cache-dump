// 1659
[clientscript,rden2_overlay_setup]
if (%rden2_events_hidden = 1) {
    if_setgraphic("conq_tick_box,1", rden2_overlay:showevents_button);
    if_sethide(true, rden2_overlay:events_layer);
    if_setop(1, "Hide", rden2_overlay:minimise_button);
}
if (%rden2_overlay_hidden = 1) {
    if_set2dangle(32768, rden2_overlay:minimise_button);
    if_sethide(true, rden2_overlay:info_layer);
    if_setsize(172, 50, ^setsize_abs, ^setsize_abs, rden2_overlay:gold_frame_2_layer);
    if_setop(1, "Unhide", rden2_overlay:minimise_button);
}
