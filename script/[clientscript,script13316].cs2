// 13316
[clientscript,script13316](component $component0)
if_setgraphic(rs3_parent_side_tab_unselected, achievements:summary_bg);
if_setgraphic(rs3_parent_side_tab_unselected, achievements:achievements_bg);
if_setgraphic(rs3_parent_side_tab_unselected, achievements:area_task_bg);
if_setgraphic(rs3_parent_side_tab_unselected, achievements:combat_mastery_bg);
if_setgraphic(rs3_parent_side_tab_unselected, achievements:tracker_bg);
if_setgraphic(rs3_parent_side_tab_current, $component0);
if ($component0 ! achievements:achievements_bg) {
    ~cheevo_reset_goto;
}
