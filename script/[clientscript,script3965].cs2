// 3965
[clientscript,script3965](component $component0)
if ((%varclient_1885 < 5 | %varclient_1885 > 9) & if_gettrans($component0) ! 255) {
    if_settrans(255, $component0);
    if_sethide(true, interface_1050:com_1);
    if_sethide(true, interface_1050:com_2);
} else if (%varclient_1885 > 4 & %varclient_1885 < 10 & if_gettrans($component0) ! 0) {
    if_settrans(0, $component0);
    if_sethide(false, interface_1050:com_1);
    if_sethide(false, interface_1050:com_2);
}
