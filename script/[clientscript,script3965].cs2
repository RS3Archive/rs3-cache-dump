// 3965
[clientscript,script3965](component $component0)
if ((%fremsaga_thok2_ending_montage_slice_count < 5 | %fremsaga_thok2_ending_montage_slice_count > 9) & if_gettrans($component0) ! 255) {
    if_settrans(255, $component0);
    if_sethide(true, fremsaga_thok2_ending_montage:image_graphic);
    if_sethide(true, fremsaga_thok2_ending_montage:text_description);
} else if (%fremsaga_thok2_ending_montage_slice_count > 4 & %fremsaga_thok2_ending_montage_slice_count < 10 & if_gettrans($component0) ! 0) {
    if_settrans(0, $component0);
    if_sethide(false, fremsaga_thok2_ending_montage:image_graphic);
    if_sethide(false, fremsaga_thok2_ending_montage:text_description);
}
