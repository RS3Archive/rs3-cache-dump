// 16687
[proc,script16687](component $component0, int $int1)
def_int $int2 = 0;
if (cc_find($component0, $int1) = true) {
    $int2 = calc(~script12722(cc_param(rs3tli_component_transparency_playback_rate), cc_param(rs3tli_component_transparency_offset)) % 360);
    cc_settrans(calc(255 - scale(max(0, calc(enum(int, int, sin_deg2percentage_enum, $int2) - 50)), 50, 150)));
}
