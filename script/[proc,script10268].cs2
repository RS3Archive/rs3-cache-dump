// 10268
[proc,script10268](int $int0)
switch_int ($int0) {
    case 0 :
        %chat_alert_game = -1;
    case 1 :
        %chat_alert_public = -1;
    case 2 :
        %chat_alert_private = -1;
    case 4 :
        %chat_alert_clan = -1;
    case 3 :
        %chat_alert_friendschat = -1;
    case 5 :
        %chat_alert_otherclan = -1;
    case 6 :
        %chat_alert_trade = -1;
    case 15 :
        %chat_alert_group = -1;
    case 16 :
        %chat_alert_group_ironman = -1;
}
