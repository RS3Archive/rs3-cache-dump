// 7088
[clientscript,script7088](component $component0, int $int1, graphic $graphic2)
def_vorbis $vorbis3 = null;
if (cc_find($component0, $int1) = true) {
    switch_int (random(5)) {
        case 0 :
            $vorbis3 = makex_ui_mouseover_01;
        case 1 :
            $vorbis3 = makex_ui_mouseover_02;
        case 2 :
            $vorbis3 = makex_ui_mouseover_03;
        case 3 :
            $vorbis3 = makex_ui_mouseover_04;
        case 4 :
            $vorbis3 = makex_ui_mouseover_05;
    }
    sound_vorbis_rate($vorbis3, 1, 0, 20, random_sound_pitch(5, 10));
    cc_setgraphic($graphic2);
}
