// 15612
[proc,script15612]
def_boolean $boolean0 = ~is_mobile_client;
if ($boolean0 = true) {
    if_sethide(true, lobbyscreen:tabs);
    if_sethide(false, lobbyscreen:mobile_tabs);
} else {
    if_sethide(false, lobbyscreen:tabs);
    if_sethide(true, lobbyscreen:mobile_tabs);
}
if_sethide(true, lobbyscreen:background);
~lobby_tab_build(lobbyscreen:tab_1, lobbyscreen:tab_m1, "Updates", 0, $boolean0, lobby_icon_tab_mobile_updates_selected, lobby_icon_tab_mobile_updates_default);
~lobby_tab_build(lobbyscreen:tab_2, lobbyscreen:tab_m2, "World", 1, $boolean0, lobby_icon_tab_mobile_world_selected, lobby_icon_tab_mobile_world_default);
~lobby_tab_build(lobbyscreen:tab_3, lobbyscreen:tab_m3, "Friends", 2, $boolean0, child_header_icon_chat_private, child_header_icon_chat_private);
~lobby_tab_build(lobbyscreen:tab_4, null, "Friends Chat", 3, $boolean0, rs3_menu_icon_friends_chat_normal, rs3_menu_icon_friends_chat_normal);
~lobby_tab_build(lobbyscreen:tab_5, null, "Clan Chat", 4, $boolean0, rs3_menu_icon_clan_chat_normal, rs3_menu_icon_clan_chat_normal);
~lobby_tab_build(lobbyscreen:tab_6, null, "Options", 5, false, null, null);
