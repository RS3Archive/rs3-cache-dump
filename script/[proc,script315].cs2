// 315
[proc,script315]
if (~is_mobile_client = false) {
    return;
}
switch_int (%loginscreen_focus) {
    case 100 :
        ~script1566(4, %loginscreen_username, 320);
        ~script15661;
    case 113 :
        ~script1566(4, %loginscreen_recovery_username, 320);
        ~script15661;
    case 101 :
        ~script1566(2, %loginscreen_password, 20);
        ~script15661;
    case 114 :
        ~script1566(3, %loginscreen_totp_auth, 6);
        ~script15661;
}
