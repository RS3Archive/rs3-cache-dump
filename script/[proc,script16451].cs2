// 16451
[proc,script16451](dbrow $dbrow0, int $int1, string $string0, int $int2)(int, string, int)
def_string $string1 = "";
def_boolean $boolean3 = false;
switch_dbrow ($dbrow0) {
    case farming_site_cactus_patch_2 :
        $boolean3, $string1 = ~script16453($boolean3, $string1, %menaphos_cactus_patch_given_logs, 1, %menaphos_cactus_patch_progress, 255, "Help Zahra build the cactus patch.");
    case farming_site_cactus_patch_3 :
