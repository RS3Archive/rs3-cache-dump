    case default :
        return($int1, $string0, $int2);
}
if ($boolean3 = true) {
    $int1 = 0;
    $int2 = ~script10495(6);
}
if (string_length($string0) > 0) {
    $string0 = "<$string0><br><$string1>";
} else {
    $string0 = $string1;
}
return($int1, $string0, $int2);
