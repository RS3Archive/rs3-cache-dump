// 9024
[proc,script9024]()(component, component)
switch_int (%crs_selected) {
    case 1 :
        return(featured_main:crs_button2_build, featured_main:crs_button2_click);
    case 2 :
        return(featured_main:crs_button3_build, featured_main:crs_button3_click);
    case 3 :
        return(featured_main:crs_button4_build, featured_main:crs_button4_click);
    case default :
        return(featured_main:crs_button1_build, featured_main:crs_button1_click);
}
