// 1105
[proc,rand_party_side_build_misc](int $int0)(int)
def_int $int1 = 60;
def_int $int2 = 30;
if (~script6431 = true) {
    $int2 = 40;
    $int1 = calc($int1 + 30);
}
if_setposition(0, $int0, ^setpos_abs_left, ^setpos_abs_top, rand_party_side_new:misc_layer);
if_setsize(0, $int1, ^setsize_minus, ^setsize_abs, rand_party_side_new:misc_layer);
if_setposition(0, 0, ^setpos_abs_left, ^setpos_abs_top, rand_party_side_new:party_floor_layer);
if_setsize(0, $int2, ^setsize_minus, ^setsize_abs, rand_party_side_new:party_floor_layer);
if_setposition(0, $int2, ^setpos_abs_left, ^setpos_abs_top, rand_party_side_new:party_complexity_layer);
if_setsize(0, $int2, ^setsize_minus, ^setsize_abs, rand_party_side_new:party_complexity_layer);
return(calc($int0 + $int1 - 4));
