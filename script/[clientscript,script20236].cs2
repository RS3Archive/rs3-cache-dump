// 20236
[clientscript,script20236]
if_settext("For Leagues: CATALYST we have worked with the RuneScape Wiki team to enable the automatic synchronisation of League progression.<br><br>This provides additional statistics around percentages of players completing tasks, and allows you to filter the task list on the RuneScape Wiki task list.", league_onboarding_wiki:wiki_text);
if (~script6431 = true) {
    if_settext("", league_onboarding_wiki:interface_sharing_title);
    if_settext("", league_onboarding_wiki:interface_sharing_text);
} else {
    if_settext("Interface sharing can be accessed from the Options Menu (Escape key) via the Edit Layout Mode button. You may load your main RuneScape interface layout by entering your own display name.", league_onboarding_wiki:interface_sharing_text);
}
if_settext("You can change this setting at any time in gameplay settings.", league_onboarding_wiki:wiki_smallprint);
if (%option_wiki_sync_opted_in = 1) {
    if_setenabled(false, league_onboarding_wiki:enable_wiki);
    if_settext("Enabled", league_onboarding_wiki:enable_wiki);
} else {
    if_setenabled(true, league_onboarding_wiki:enable_wiki);
    if_settext("Enable WikiSync", league_onboarding_wiki:enable_wiki);
}
