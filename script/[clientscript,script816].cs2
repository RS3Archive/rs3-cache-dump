// 816
[clientscript,script816]
if (if_find(music_v3_child:unlock_counter) = true) {
    cc_setontimer(null);
}
~music_v3_refresh(music_v3_child:music_search, music_v3_child:music_search_empty, music_v3_child:now_playing_text, music_v3_child:jukebox, music_v3_child:scrollbar, music_v3_child:unlock_counter, music_v3_child:music_shuffle);
