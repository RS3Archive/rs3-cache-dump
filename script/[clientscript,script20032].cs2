[clientscript,script20032]
if_settext(~script11601(%trh210_currency, true), trh210_overlay:currency_count);
def_boolean $boolean0 = false;
if (%trh210_currency >= 400) {
    $boolean0 = true;
}
if ($boolean0 = true) {
    if_setop(1, "Buy Bonus", trh210_overlay:currency_buy_button);
} else {
    if_setop(1, "", trh210_overlay:currency_buy_button);
}
if_setenabled($boolean0, trh210_overlay:currency_buy_button);
