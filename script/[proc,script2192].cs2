// 2192
[proc,script2192]
def_int $int0 = %pop_voyage_list_story_available;
switch_int (%pop_voyage_list_mode) {
    case 0 :
        ~script13972(pop_voyage_list:tab_build_1, pop_voyage_list:tab_click_1, rs3tli_modal_tab, "Standard Voyages", ~equal_int(0, %pop_voyage_list_mode));
    case 1 :
        if (%pop_tutorial_progress >= 38 & %pop_tutorial_progress < 50) {
            $int0 = 1;
        }
        ~script13972(pop_voyage_list:tab_build, pop_voyage_list:tab_click, rs3tli_modal_tab, "Special Voyages (<tostring($int0)>)", ~equal_int(1, %pop_voyage_list_mode));
}
