// 9843
[clientscript,script9843]
if (calc(clientclock % 50) = 0 & --%rhino_client_time_remaining <= 0) {
    if_setontimer(null, sep2013_jobs:answer_question_text_layer);
    if_sethide(true, rhino_awareness:todays_rhino_wrong_answer);
    if_sethide(true, rhino_awareness:answer_1_btn_disabled_layer);
    if_sethide(true, rhino_awareness:answer_2_btn_disabled_layer);
    if_sethide(true, rhino_awareness:answer_3_btn_disabled_layer);
    if_sethide(true, rhino_awareness:answer_4_btn_disabled_layer);
    if_sethide(true, rhino_awareness:grey_out_layer);
}
if_settext("Time remaining until you can try again: <tostring(%rhino_client_time_remaining)> seconds", rhino_awareness:todays_rhino_wrong_answer);
