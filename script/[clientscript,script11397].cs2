// 11397
[clientscript,script11397](int $int0, int $int1)
if ($int1 ! 1) {
    return;
}
if (cc_find(poh_costume_room:click_area, calc(%poh_costume_room_selected - 1)) = true) {
    cc_setoutline(0);
}
if (cc_find(poh_costume_room:click_area, $int0) = true) {
    cc_setoutline(2);
}
%poh_costume_room_selected = calc($int0 + 1);
~script11398($int0);
