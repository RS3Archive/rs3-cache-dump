// 10573
[clientscript,titles2_onclick]
if (%trh29_titles2_owned = 1) {
    return;
}
if (inv_total(inv, trh29_doubloons) < 500) {
    return;
}
%trh29_pirate_coins_shop_selection = 8;
if_setgraphic(trh29_pirate_icon_title_2, trh29_pirate_coins_shop:popup_icon);
if_settext("Pirate titles: Red-Hand, Blackbeard, Runebeard, the Rum Thief and Pirate King/Queen.", trh29_pirate_coins_shop:popup_description);
if_settext("Buy the second set of pirate titles?", trh29_pirate_coins_shop:popup_question);
if_sethide(false, trh29_pirate_coins_shop:popup_layer);
