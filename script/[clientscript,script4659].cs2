// 4659
[clientscript,script4659](component $component0)
def_int $int1 = scale(%fremsaga_hp_2, 3200, 100);
~aif_progressbar_set($int1, fremsaga_signature_healthoverlay:ozan_large_progress_value_layer, fremsaga_signature_healthoverlay:ozan_large_progress_text);
if_settext(tostring(%fremsaga_hp_2), $component0);
if (%fremsaga_hp_2 <= 1000) {
    if_setmodelanim(human_update_chathead_fear_extreme_len1, fremsaga_signature_healthoverlay:ozanhead);
} else {
    if_setmodelanim(human_update_chathead_neutral_idle, fremsaga_signature_healthoverlay:ozanhead);
}
