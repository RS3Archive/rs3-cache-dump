// 3817
[clientscript,script3817](component $component0)
if (if_getgraphic($component0) = xmas2019_advent_button_over) {
    if_setgraphic(xmas2019_advent_button_down, $component0);
}
if (if_getgraphic($component0) = xmas2019_advent_right_button_over) {
    if_setgraphic(xmas2019_advent_right_button_down, $component0);
}
