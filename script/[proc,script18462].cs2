// 18462
[proc,script18462]()(string)
if (%crm_braze_endpoint_url_environment <= 0) {
    return("https://crmintegration.production.rs.aws.jagex.com/getlatestcampaign/%deviceid%/?userHash=%userhash%");
} else if (%crm_braze_endpoint_url_environment = 1) {
    return("https://crmintegration.development.rs.aws.jagex.com/getlatestcampaign/%deviceid%/?userHash=%userhash%");
} else {
    ~error("Unknown %crm_braze_endpoint_url_environment: <tostring(%crm_braze_endpoint_url_environment)> when trying to pull Braze request URL. Returning Live URL.");
    return("https://crmintegration.production.rs.aws.jagex.com/getlatestcampaign/%deviceid%/?userHash=%userhash%");
}
