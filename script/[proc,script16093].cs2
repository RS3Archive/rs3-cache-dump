// 16093
[proc,script16093]()(string)
def_string $string0 = "";
if (%ozan3_main >= 45 & stat(slayer) >= 99) {
    switch_int (%slayer_target) {
        case 152 :
            $string0 = ~script16094(slayer_pod_combo_list_menaphos_corrupted);
        case 153 :
            $string0 = ~script16094(slayer_pod_combo_list_menaphos_devourer);
        case 139 :
            $string0 = ~script16094(slayer_pod_combo_list_gem_dragons);
        case 154 :
            $string0 = ~script16094(slayer_pod_combo_list_nature);
        case 160 :
            $string0 = ~script16094(slayer_pod_combo_list_stalker);
        case 171 :
            $string0 = ~script16094(slayer_pod_combo_list_dinosaur);
        case 172 :
            $string0 = ~script16094(slayer_pod_combo_list_plant);
        case 180 :
            $string0 = ~script16094(slayer_pod_combo_list_abyssal_demon);
        case default :
            if (~slayer_codex_check_monster(calc(%slayer_target - 1)) = ^false & enum(int, npc, slayer_pod_npc_list, %slayer_target) ! null) {
                $string0 = "You have not yet claimed this creature's soul";
            }
    }
}
return($string0);
