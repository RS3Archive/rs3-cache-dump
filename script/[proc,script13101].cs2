[proc,script13101](struct $struct0)(int, boolean)
switch_struct ($struct0) {
    case mtx_batch3_sizzling_full :
        if (%mtx_batch3_sizzling_hat_unlocked = 1 & %mtx_batch3_sizzling_boots_unlocked = 1 & %mtx_batch3_sizzling_gloves_unlocked = 1 & %mtx_batch3_sizzling_amulet_unlocked = 1) {
            return(1, false);
        } else {
            return(0, false);
        }
    case title_gwd2_solo_bronze_struct :
