// 18374
[proc,script18374](obj $obj0)(int)
def_int $int1 = oc_param($obj0, recipe_make_stack_size);
switch_obj ($obj0) {
    case eternal_shaft :
        if (stat(fletching) >= struct_param(skillguide_fletching_eternal_ammunition_efficiency, skillguide_level)) {
            return(calc($int1 + 15));
        }
    case eternal_headless_shaft :
        if (stat(fletching) >= struct_param(skillguide_fletching_eternal_feather_proficiency, skillguide_level)) {
            return(calc($int1 + 15));
        }
    case primal_arrow :
        if (stat(fletching) >= struct_param(skillguide_fletching_eternal_arrow_proficiency, skillguide_level)) {
            return(calc($int1 + 15));
        }
    case xbows_crossbow_bolts_primal :
        if (stat(fletching) >= struct_param(skillguide_fletching_eternal_bolt_proficiency, skillguide_level)) {
            return(calc($int1 + 15));
        }
}
return($int1);
