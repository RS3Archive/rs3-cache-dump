// 3820
[clientscript,script3820](component $component0)
if (if_getgraphic($component0) = xmas2019_advent_button_down) {
    if_setgraphic(xmas2019_advent_button_over, $component0);
}
if (if_getgraphic($component0) = xmas2019_advent_right_button_down) {
    if_setgraphic(xmas2019_advent_right_button_over, $component0);
}
