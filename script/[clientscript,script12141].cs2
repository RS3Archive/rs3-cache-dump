// 12141
[clientscript,script12141]
~invent_discovery_register_move;
if_sethide(false, invent_discovery:prototype_disable_layer);
if_setonmouserepeat(null, invent_discovery:prototype_disable_layer);
if_sethide(false, invent_discovery:workbench_overlay);
if_sethide(true, invent_discovery:refine_continue_button_layer);
if_settext("Creating Prototype...", invent_discovery:refine_continue_text);
if_setontimer(null, invent_discovery:workbench_overlay);
if_sethide(false, invent_discovery:lightbulb_model);
if_sethide(true, invent_discovery:lightbulb_cracked_model);
if_setmodelanim(invent_discovery_lightbulb_slow_light_loop, invent_discovery:lightbulb_model);
if_setmodelanim(invent_discovery_lightbulb_slow_light_loop, invent_discovery:lightbulb_cracked_model);
