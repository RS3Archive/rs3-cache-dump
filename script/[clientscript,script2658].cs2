// 2658
[clientscript,script2658]
if (++%mah3_spline_leg >= calc(spline_length(0) - 1)) {
    %mah3_spline_leg = 0;
    if_setoncamfinished(null, mah3_heistsplines:controller);
    return;
}
cam_movealong(0, %mah3_spline_leg, 600, 400, 1, %mah3_spline_leg);
if_setoncamfinished("script2658", mah3_heistsplines:controller);
