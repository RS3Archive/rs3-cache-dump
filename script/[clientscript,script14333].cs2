// 14333
[clientscript,script14333](component $component0, component $component1)
def_obj $obj2 = null;
switch_component ($component1) {
    case hunter_charms_exchange_side:spirit_lure_item :
        ~script14334(huntcharm_lure, $component0, $component1);
    case hunter_charms_exchange_side:yaktwee_item :
        if (inv_total(inv, huntcharm_stave_enhanced) > 0 | inv_total(worn, huntcharm_stave_enhanced) > 0) {
            $obj2 = huntcharm_stave_enhanced;
        } else {
            $obj2 = huntcharm_stave;
        }
        ~script14334($obj2, $component0, $component1);
    case hunter_charms_exchange_side:gold_slice_item :
        ~script14334(huntcharm_fragment_gold, $component0, $component1);
    case hunter_charms_exchange_side:crimson_slice_item :
        ~script14334(huntcharm_fragment_crimson, $component0, $component1);
    case hunter_charms_exchange_side:green_slice_item :
        ~script14334(huntcharm_fragment_green, $component0, $component1);
    case hunter_charms_exchange_side:blue_slice_item :
        ~script14334(huntcharm_fragment_blue, $component0, $component1);
    case hunter_charms_exchange_side:mystical_slice_item :
        ~script14334(huntcharm_fragment_mystical, $component0, $component1);
}
