// 16051
[clientscript,script16051]
if (%egwd_wen_boss_mechanic_prayer = 1) {
    if_setgraphic(wen_boss_icon_mechanic_random_attack_active, egwd_wen_lobby_overlay:mechanic1);
    if_setgraphic("rs3_icon_check_mark_18px,0", egwd_wen_lobby_overlay:mechanic1_check);
} else {
    if_setgraphic(wen_boss_icon_mechanic_random_attack_inactive, egwd_wen_lobby_overlay:mechanic1);
    if_setgraphic("rs3_icon_check_mark_18px,1", egwd_wen_lobby_overlay:mechanic1_check);
}
if (%egwd_wen_boss_mechanic_movement = 1) {
    if_setgraphic(wen_boss_icon_mechanic_movement_active, egwd_wen_lobby_overlay:mechanic2);
    if_setgraphic("rs3_icon_check_mark_18px,0", egwd_wen_lobby_overlay:mechanic2_check);
} else {
    if_setgraphic(wen_boss_icon_mechanic_movement_inactive, egwd_wen_lobby_overlay:mechanic2);
    if_setgraphic("rs3_icon_check_mark_18px,1", egwd_wen_lobby_overlay:mechanic2_check);
}
if (%egwd_wen_boss_mechanic_dps = 1) {
    if_setgraphic(wen_boss_icon_mechanic_damage_active, egwd_wen_lobby_overlay:mechanic3);
    if_setgraphic("rs3_icon_check_mark_18px,0", egwd_wen_lobby_overlay:mechanic3_check);
} else {
    if_setgraphic(wen_boss_icon_mechanic_damage_inactive, egwd_wen_lobby_overlay:mechanic3);
    if_setgraphic("rs3_icon_check_mark_18px,1", egwd_wen_lobby_overlay:mechanic3_check);
}
if (%egwd_wen_boss_mechanic_defensive = 1) {
    if_setgraphic(wen_boss_icon_mechanic_huge_hit_active, egwd_wen_lobby_overlay:mechanic4);
    if_setgraphic("rs3_icon_check_mark_18px,0", egwd_wen_lobby_overlay:mechanic4_check);
} else {
    if_setgraphic(wen_boss_icon_mechanic_huge_hit_inactive, egwd_wen_lobby_overlay:mechanic4);
    if_setgraphic("rs3_icon_check_mark_18px,1", egwd_wen_lobby_overlay:mechanic4_check);
}
if (%egwd_wen_boss_mechanic_adds = 1) {
    if_setgraphic(wen_boss_icon_mechanic_minions_active, egwd_wen_lobby_overlay:mechanic5);
    if_setgraphic("rs3_icon_check_mark_18px,0", egwd_wen_lobby_overlay:mechanic5_check);
} else {
    if_setgraphic(wen_boss_icon_mechanic_minions_inactive, egwd_wen_lobby_overlay:mechanic5);
    if_setgraphic("rs3_icon_check_mark_18px,1", egwd_wen_lobby_overlay:mechanic5_check);
}
if (%egwd_wen_boss_unlocked_hard_mode = 1) {
    if_settext("Enable Hardmode:", egwd_wen_lobby_overlay:egwd_wen_interface_text_hm);
    if_setcolour(0xb4a092, egwd_wen_lobby_overlay:egwd_wen_interface_text_hm);
    if (%egwd_wen_boss_mechanic_hardmode = 1) {
        if_setgraphic("rs3_btn_checkbox_32px,2", egwd_wen_lobby_overlay:hm_checkbox);
    } else {
        if_setgraphic("rs3_btn_checkbox_32px,0", egwd_wen_lobby_overlay:hm_checkbox);
    }
} else {
    if_settext("Hardmode locked", egwd_wen_lobby_overlay:egwd_wen_interface_text_hm);
    if_setcolour(0x8e8e8e, egwd_wen_lobby_overlay:egwd_wen_interface_text_hm);
    if_setgraphic("rs3_btn_checkbox_32px,4", egwd_wen_lobby_overlay:hm_checkbox);
}
if (%egwd_wen_boss_highest_enrage > 0) {
    if_settext("<tostring(%egwd_wen_boss_highest_enrage)>% Enrage", egwd_wen_lobby_overlay:egwd_wen_interface_text_highest_difficulty);
} else {
    if_settext("<tostring(%egwd_wen_boss_max_mechanics_done)> <~text_plural(%egwd_wen_boss_max_mechanics_done, "Active Mechanic", "Active Mechanics")>", egwd_wen_lobby_overlay:egwd_wen_interface_text_highest_difficulty);
}
