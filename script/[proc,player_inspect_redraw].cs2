// 10773
[proc,player_inspect_redraw]
if (%toplevel_v2_active_layout = 5) {
    if_sethide(true, player_inspect:expand_button_layer);
    if_setposition(40, 15, ^setpos_abs_right, ^setpos_abs_top, player_inspect:main_report_button_layer);
} else {
    if_sethide(false, player_inspect:expand_button_layer);
    if_setposition(15, 15, ^setpos_abs_left, ^setpos_abs_top, player_inspect:main_report_button_layer);
}
~script10774;
~script9554(player_inspect:background_layer, player_inspect:border_layer, player_inspect:content_layer, %player_inspect_target_name, toplevel_v2_default_modal_dialogue_skin_data);
