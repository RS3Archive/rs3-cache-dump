// 884
[proc,script884]()(string)
def_component $component0 = timed_event_tasks:event11_reward_square_4;
if (if_find($component0) = true) {
    if (calc((%event10_level + 1) % 2) = 0) {
        cc_setonmouserepeat("script3876(oc_name(event10_mystery_box_big), $component0, 0)");
        if_sethide(false, timed_event_tasks:event11_mystery_box_big);
        return("Big event mystery box");
    } else {
        cc_setonmouserepeat("script3876(oc_name(event10_mystery_box), $component0, 0)");
        if_sethide(false, timed_event_tasks:event11_mystery_box);
        return("Event mystery box");
    }
}
