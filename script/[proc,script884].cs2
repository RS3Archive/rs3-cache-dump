// 884
[proc,script884]()(string)
def_component $component0 = interface_1930:com_43;
if (if_find($component0) = true) {
    if (calc((%varplayerbit_39302 + 1) % 2) = 0) {
        cc_setonmouserepeat("script3876(oc_name(obj_41755), $component0, 0)");
        if_sethide(false, interface_1930:com_225);
        return("Big event mystery box");
    } else {
        cc_setonmouserepeat("script3876(oc_name(obj_41754), $component0, 0)");
        if_sethide(false, interface_1930:com_224);
        return("Event mystery box");
    }
}
