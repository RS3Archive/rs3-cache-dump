// 20838
[clientscript,script20838](component $component0)
switch_int (%construction_neighbourhood_invite_type) {
    case 1 :
        if (string_length(%construction_neighbourhood_cache_clan_name_client) > 0) {
            if_settext("<col=FFFFFF><%construction_neighbourhood_inviter_name_client></col> is inviting you to become a founding member of their homestead: <col=FFFFFF><%construction_neighbourhood_cache_clan_name_client></col>", $component0);
        } else {
            if_settext("<col=FFFFFF><%construction_neighbourhood_inviter_name_client></col> is inviting you to become a founding member of their homestead.", $component0);
        }
    case 2 :
        if_settext("<col=FFFFFF><%construction_neighbourhood_inviter_name_client></col> is inviting you to become a member of their homestead: <col=FFFFFF><%construction_neighbourhood_cache_clan_name_client></col>", $component0);
    case 3 :
        if_settext("<col=FFFFFF><%construction_neighbourhood_inviter_name_client></col> is inviting you to <col=FFFFFF>swap plots</col>.", $component0);
}
