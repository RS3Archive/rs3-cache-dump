// 11639
[proc,script11639](int $int0, int $int1, int $int2, int $int3, int $int4)(int, int)
$int2 = calc($int2 - 1);
$int3 = calc($int3 - 1);
switch_int ($int4) {
    case default :
        return($int0, $int1);
    case 1 :
        return($int1, calc(0 - $int0 - $int3));
    case 2 :
        return(calc(0 - $int0 - $int2), calc(0 - $int1 - $int3));
