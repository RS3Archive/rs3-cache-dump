// 7805
[proc,script7805](component $component0)
def_component $component1 = mm_tasklist:task_1;
def_int $int2 = %mm14_current_tracker;
if ($component0 = mm_tasklist:jmod_task_highlight) {
    $int2 = %mm14_current_tracker_jmod;
}
switch_int ($int2) {
    case 0 :
        if_setposition(-60, -60, ^setpos_abs_left, ^setpos_abs_top, $component0);
    case 1 :
        $component1 = mm_tasklist:task_1;
    case 2 :
        $component1 = mm_tasklist:task_2;
    case 3 :
        $component1 = mm_tasklist:task_3;
    case 4 :
        $component1 = mm_tasklist:task_4;
    case 5 :
        $component1 = mm_tasklist:task_5;
    case 6 :
        $component1 = mm_tasklist:task_6;
    case 7 :
        $component1 = mm_tasklist:task_7;
    case 8 :
        $component1 = mm_tasklist:task_8;
    case 9 :
        $component1 = mm_tasklist:task_9;
    case 10 :
        $component1 = mm_tasklist:task_10;
    case 11 :
        $component1 = mm_tasklist:task_11;
    case 12 :
        $component1 = mm_tasklist:task_12;
    case 13 :
        $component1 = mm_tasklist:task_13;
    case 14 :
        $component1 = mm_tasklist:task_14;
    case 15 :
        $component1 = mm_tasklist:task_15;
    case 16 :
        $component1 = mm_tasklist:task_16;
    case 17 :
        $component1 = mm_tasklist:task_17;
    case 18 :
        $component1 = mm_tasklist:task_18;
    case 19 :
        $component1 = mm_tasklist:task_19;
    case 20 :
        $component1 = mm_tasklist:task_20;
}
if ($int2 > 0) {
    if_setposition(calc(if_getx($component1) - 2), calc(if_gety($component1) - 2), ^setpos_abs_left, ^setpos_abs_top, $component0);
}
