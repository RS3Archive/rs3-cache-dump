// 17465
[proc,script17465](obj $obj0)(boolean)
if ($obj0 = null) {
    return(false);
}
if (oc_wearpos($obj0) ! 0 & oc_wearpos($obj0) ! 4 & oc_wearpos($obj0) ! 7 & oc_wearpos($obj0) ! 9 & oc_wearpos($obj0) ! 10) {
    return(false);
}
if (oc_param($obj0, combatv2_player_armour) = 0) {
    return(false);
}
if (oc_param($obj0, combatv2_pvp_tier) ! 0) {
    return(false);
}
if (oc_param($obj0, melee_strength) > 0 | oc_param($obj0, magic_strength) > 0 | oc_param($obj0, ranged_strength) > 0 | oc_param($obj0, necromancy_strength) > 0) {
    return(false);
}
if (oc_param($obj0, combatv2_generic_item) = 1) {
    return(false);
}
if (oc_param($obj0, combatv2_item_cosmetic) = 1) {
    return(false);
}
return(true);
