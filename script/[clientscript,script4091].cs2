// 4091
[clientscript,script4091](int $int0)
def_int $int1 = if_gettrans(fmc_darkness:black);
if ($int1 > calc(255 - ($int0 + 1))) {
    if_settrans(255, fmc_darkness:black);
    if_settrans(125, fmc_darkness:fade);
    if_setontimer(null, fmc_darkness:black);
    return;
} else {
    if_settrans(calc($int1 + $int0), fmc_darkness:black);
