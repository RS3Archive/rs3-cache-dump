// 9622
[proc,worldmap_key_build_scrollbar](component $component0, component $component1)
if (if_getscrollheight($component0) <= if_getheight($component0)) {
    cc_deleteall($component1);
    if_setscrollpos(0, 0, $component0);
} else {
    ~scrollbar_vertical($component1, $component0, "scrollbar_dragger_v2,3", "scrollbar_dragger_v2,0", "scrollbar_dragger_v2,1", "scrollbar_dragger_v2,2", "scrollbar_v2,0", "scrollbar_v2,1");
}
if (cc_find($component1, 1) = true) {
    ~scrollbar_vertical_doscroll($component1, $component0, if_getscrolly($component0), 1);
}
