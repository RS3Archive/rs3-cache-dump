// 16700
[clientscript,script16700]
def_component $component0 = modal_storage:inventory_window_highlight;
def_component $component1 = modal_storage:storage_window_highlight;
switch_inv (%modal_storage_active_inv) {
    case rand_storage :
        $component0 = rand_storage:inventory_window_highlight;
        $component1 = rand_storage:storage_window_highlight;
}
%modal_storage_drag_in_progress = 0;
if_sethide(true, $component0);
if_sethide(true, $component1);
