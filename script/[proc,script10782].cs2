// 10782
[proc,script10782](stat $stat0)(int)
switch_stat ($stat0) {
    case attack :
        return(%player_inspect_stat_base_actual_attack);
    case hitpoints :
        return(%player_inspect_stat_base_actual_constitution);
    case mining :
        return(%player_inspect_stat_base_actual_mining);
    case strength :
        return(%player_inspect_stat_base_actual_strength);
    case agility :
        return(%player_inspect_stat_base_actual_agility);
    case smithing :
        return(%player_inspect_stat_base_actual_smithing);
    case defence :
        return(%player_inspect_stat_base_actual_defence);
    case herblore :
        return(%player_inspect_stat_base_actual_herblore);
    case fishing :
        return(%player_inspect_stat_base_actual_fishing);
    case ranged :
        return(%player_inspect_stat_base_actual_ranged);
    case thieving :
        return(%player_inspect_stat_base_actual_thieving);
    case cooking :
        return(%player_inspect_stat_base_actual_cooking);
    case prayer :
        return(%player_inspect_stat_base_actual_prayer);
    case crafting :
        return(%player_inspect_stat_base_actual_crafting);
    case firemaking :
        return(%player_inspect_stat_base_actual_firemaking);
    case magic :
        return(%player_inspect_stat_base_actual_magic);
    case fletching :
        return(%player_inspect_stat_base_actual_fletching);
    case woodcutting :
        return(%player_inspect_stat_base_actual_woodcutting);
    case runecraft :
        return(%player_inspect_stat_base_actual_runecraft);
    case slayer :
        return(%player_inspect_stat_base_actual_slayer);
    case farming :
        return(%player_inspect_stat_base_actual_farming);
    case construction :
        return(%player_inspect_stat_base_actual_construction);
    case hunter :
        return(%player_inspect_stat_base_actual_hunter);
    case summoning :
        return(%player_inspect_stat_base_actual_summoning);
    case dungeoneering :
        return(%player_inspect_stat_base_actual_dungeoneering);
    case divination :
        return(%player_inspect_stat_base_actual_divination);
    case invention :
        return(%player_inspect_stat_base_actual_invention);
    case archaeology :
        return(%player_inspect_stat_base_actual_archaeology);
    case necromancy :
        return(%player_inspect_stat_base_actual_necromancy);
    case default :
        return(-1);
}
