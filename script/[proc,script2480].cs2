// 2480
[proc,script2480]
def_int $int0 = if_getheight(tzhaar2_egg_side:emote_default);
if_setscrollsize(0, 275, tzhaar2_egg_side:emote_scroll);
~rs3_scrollbar_vertical(tzhaar2_egg_side:emote_scrollbar, tzhaar2_egg_side:emote_scroll);
if ($int0 >= 275) {
    if_setsize(0, 0, ^setsize_minus, ^setsize_minus, tzhaar2_egg_side:emote_scroll);
    if_sethide(true, tzhaar2_egg_side:emote_scrollbar);
} else {
    if_sethide(false, tzhaar2_egg_side:emote_scrollbar);
    if_setsize(20, 0, ^setsize_minus, ^setsize_minus, tzhaar2_egg_side:emote_scroll);
}
