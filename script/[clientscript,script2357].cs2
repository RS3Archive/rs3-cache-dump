// 2357
[clientscript,script2357](component $component0)
if_sendtofront($component0);
if (%vkq3_active_piece = null) {
    return;
}
def_component $component1 = enum(component, component, vkq3_piece_borders, %vkq3_active_piece);
def_int $int2 = if_getx($component0);
def_int $int3 = if_gety($component0);
if ($component0 = vkq3_blockpuzzle:return_layer) {
    $int2 = calc($int2 + if_getwidth($component0) / 2 - if_getwidth($component1) / 2);
    $int3 = calc($int3 + if_getheight($component0) / 2 - if_getheight($component1) / 2);
}
if_setposition($int2, $int3, ^setpos_abs_left, ^setpos_abs_top, $component1);
