// 14043
[proc,script14043]
switch_int (%csat_type) {
    case 0 :
        if_sethide(true, escape_menu:csat_layer);
    case 1 :
        if_sethide(false, escape_menu:csat_layer);
        if_sethide(true, escape_menu:csat_stars);
        if_sethide(false, escape_menu:csat_thumbs);
        ~script14044;
    case 2 :
        if_sethide(false, escape_menu:csat_layer);
        if_sethide(false, escape_menu:csat_stars);
        if_sethide(true, escape_menu:csat_thumbs);
        ~script14047(%varclientbit_39859, 0);
}
