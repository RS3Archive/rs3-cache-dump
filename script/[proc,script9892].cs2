// 9892
[proc,script9892](component $component0)
cc_deleteall($component0);
def_int $int1 = 0;
while ($int1 < 8) {
    cc_create($component0, ^iftype_graphic, $int1);
    if ($int1 = 3) {
        cc_setposition(0, 0, ^setpos_abs_right, ^setpos_abs_top);
        cc_setsize(31, 0, ^setsize_abs, ^setsize_minus);
        cc_setgraphic("topstat_fill_full,4");
        cc_settiling(true);
    }
    $int1 = calc($int1 + 1);
}
cc_create($component0, ^iftype_text, 8);
cc_settextfont(museo_sans_11pt_regular);
cc_settextalign(^settextalign_centre, ^settextalign_centre, 0);
cc_setcolour(^green);
cc_settextshadow(true);
cc_setposition(30, 13, ^setpos_abs_right, ^setpos_abs_top);
cc_setsize(30, 14, ^setsize_minus, ^setsize_abs);
