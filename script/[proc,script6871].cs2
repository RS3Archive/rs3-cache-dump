// 6871
[proc,script6871](int $int0, int $int1)
if (cc_find(oct_event_if:text_layer, $int0) = true) {
    cc_setcolour(0xeec900);
}
if (cc_find(oct_event_if:text_layer, calc($int0 + 1)) = true) {
    cc_setcolour(0xeec900);
}
if (cc_find(oct_event_if:text_layer, calc($int0 + 2)) = true) {
    cc_setcolour(0xeec900);
}
