// 9754
[proc,script9754](component $component0, component $component1, component $component2, component $component3, component $component4)
if ($component0 = null | $component1 = null) {
    return;
}
if_setgraphic(rs3_btn_radio_on, $component0);
if_setgraphic(rs3_btn_radio_off, $component1);
if ($component2 ! null) {
    if_setgraphic(rs3_btn_radio_off, $component2);
}
if ($component3 ! null) {
    if_setgraphic(rs3_btn_radio_off, $component3);
}
if ($component4 ! null) {
    if_setgraphic(rs3_btn_radio_off, $component4);
}
