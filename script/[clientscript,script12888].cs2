// 12888
[clientscript,script12888](struct $struct0)
if (calc(clientclock % 50) = 0) {
    ~script12889($struct0);
    if (++%timed_event_countdown_minuteseconds = 60) {
        %timed_event_countdown_minutes = calc(%timed_event_countdown_minutes - 1);
        %timed_event_countdown_minuteseconds = 0;
    }
}
