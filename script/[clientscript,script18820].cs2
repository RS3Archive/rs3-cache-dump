// 18820
[clientscript,script18820](component $component0, int $int1, int $int2, seq $seq3, seq $seq4)
if (cc_find($component0, $int1) = true) {
    if ($int2-- > 0) {
        cc_setontimer("script18820($component0, $int1, $int2, $seq3, $seq4)");
        return;
    }
    cc_setontimer("script18820($component0, $int1, calc(seqlength($seq3) + 1), $seq3, $seq4)");
    ~script18821($component0, $int1, $seq3, $seq4);
}
