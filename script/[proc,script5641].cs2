[proc,script5641](struct $struct0)(string)
def_int $int1 = struct_param($struct0, potion_info_duration);
if ($int1 = 0) {
    return("");
}
def_int $int2 = 0;
def_int $int3 = 0;
def_string $string0 = "";
if ($int1 >= 3600) {
