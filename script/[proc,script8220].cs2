// 8220
[proc,script8220](quest $quest0)(string)
switch_int (quest_param($quest0, quest_sublist)) {
    case 1 :
        switch_int (~quest_difficulty($quest0)) {
            case 5 :
                return("Complete this Special miniquest.");
            case default :
                return("Complete this miniquest.");
        }
    case 2 :
        switch_int (~quest_difficulty($quest0)) {
            case 5 :
                return("Complete this Special saga.");
            case default :
                return("Complete this saga.");
        }
    case default :
        switch_int (~quest_difficulty($quest0)) {
            case 5 :
                return("Complete this Special quest.");
            case default :
                return("Complete this quest.");
        }
}
