// 10153
[clientscript,script10153](int $int0)
def_int $int1 = 0;
if (calc(clientclock % 50) = 0) {
    if_sethide(false, twitch_stream:countdown_text);
    if_setontimer(null, twitch_stream:webcam_buttons);
    if_sethide(true, twitch_stream:live_status);
    if (--$int0 >= 0) {
        if_setontimer("script10153($int0)", twitch_stream:webcam_buttons);
        if_settext(tostring($int0), twitch_stream:countdown_text);
    } else {
        if_setontimer(null, twitch_stream:webcam_buttons);
        if_settext("initialising", twitch_stream:countdown_text);
        $int1 = ~script3110;
        if_sethide(true, twitch_stream:countdown_text);
        if ($int1 = 1) {
            if_setontimer("script10154", twitch_stream:quality_listener_layer);
            if_sethide(false, twitch_stream:live_status);
            if_settext("Stop Broadcast", toplevel_v2_parent_suboverlay_twitch:start_broadcast_button);
        } else {
            %varclientbit_23079 = 0;
            if_settext("Start Broadcast", toplevel_v2_parent_suboverlay_twitch:start_broadcast_button);
            if_setgraphic("rs3_btn_twitch_play,0", twitch_stream:stream_status);
        }
    }
}
