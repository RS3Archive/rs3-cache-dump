// 7747
[proc,script7747](component $component0)
if (%music_v3_protect = 1 | %cutscene_status = 1) {
    return;
}
if (%music_playlist_toggle_varc = true) {
    ~script8800("Click here to access full song list", $component0, -1);
    if_setgraphic("aif_music_header_buttons,1", $component0);
} else {
    ~script8800("Click here to access playlist", $component0, -1);
    if_setgraphic("aif_music_header_buttons,3", $component0);
}
