// 9675
[clientscript,script9675]
def_int $int0 = 0;
def_int $int1 = enum_getoutputcount(vkq3_component_indices_p1);
def_component $component2 = null;
while ($int0 < $int1) {
    $component2 = enum(int, component, vkq3_component_indices_p1, $int0);
    if ($component2 ! null) {
        if (%vkq3_active_piece = null) {
            if_setop(1, "Select", $component2);
            if_setop(2, "Reset", $component2);
        } else {
            if_clearops($component2);
        }
    }
    $int0 = calc($int0 + 1);
}
