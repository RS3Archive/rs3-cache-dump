// 5840
[proc,script5840](struct $struct0)(string)
if (struct_param($struct0, cheevo_rewards_exception) = true) {
    switch_struct ($struct0) {
        case cheevo_reaper_crew :
            return("'the Reaper' title and the following passive stats which are always active.<br><tostring(2)> Prayer Bonus<br><tostring(calc(200 / 10))> Armour<br><tostring(200)> Life Points Bonus<br><tostring(calc(120 / 10))> Melee Damage Bonus<br><tostring(calc(120 / 10))> Ranged Damage Bonus<br><tostring(calc(120 / 10))> Magic Damage Bonus<br><tostring(calc(120 / 10))> Necromancy Damage Bonus");
    }
}
return(struct_param($struct0, cheevo_rewards));
