// 1179
[clientscript,script1179](component $component0)
def_int $int1 = calc(%returning_player_bxp_active - date_minutes);
if (%toplevel_v2_active_skinset = 1 & %doublexp_setupflag = 0) {
    if (map_lang = 1) {
        if_setgraphic("xp_token,3", $component0);
    } else {
        if_setgraphic("xp_token,1", $component0);
    }
} else {
    if (map_lang = 1) {
        if_setgraphic("xp_token_with_plus,3", $component0);
    } else {
        if_setgraphic("xp_token_with_plus,1", $component0);
    }
    if (%doublexp_setupflag = 1 | $int1 > 0) {
        ~script8800("Bonus XP is active!", $component0, -1);
    }
}
