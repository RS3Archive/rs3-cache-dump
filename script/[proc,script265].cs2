// 265
[proc,script265]
~script13995(fishcomp_side:hook_standard_layer, null, rs3tli_3x3_button, "", 0);
~script13995(fishcomp_side:hook_slim_layer, null, rs3tli_3x3_button, "", 0);
~script13995(fishcomp_side:hook_large_layer, null, rs3tli_3x3_button, "", 0);
~script13995(fishcomp_side:hook_double_layer, null, rs3tli_3x3_button, "", 0);
~script13995(fishcomp_side:hook_bone_layer, null, rs3tli_3x3_button, "", 0);
~script13995(fishcomp_side:hook_wood_layer, null, rs3tli_3x3_button, "", 0);
def_string $string0 = "Hook: None";
switch_int (%fishcomp_client_hook) {
    case 2 :
        $string0 = "Hook: slim";
        ~script13995(fishcomp_side:hook_slim_layer, null, rs3tli_3x3_button, "", 1);
    case 1 :
        $string0 = "Hook: standard";
        ~script13995(fishcomp_side:hook_standard_layer, null, rs3tli_3x3_button, "", 1);
    case 3 :
        $string0 = "Hook: large";
        ~script13995(fishcomp_side:hook_large_layer, null, rs3tli_3x3_button, "", 1);
    case 6 :
        $string0 = "Hook: double";
        ~script13995(fishcomp_side:hook_double_layer, null, rs3tli_3x3_button, "", 1);
    case 4 :
        $string0 = "Hook: bone";
        ~script13995(fishcomp_side:hook_bone_layer, null, rs3tli_3x3_button, "", 1);
    case 5 :
        $string0 = "Hook: wooden";
        ~script13995(fishcomp_side:hook_wood_layer, null, rs3tli_3x3_button, "", 1);
}
if_settext($string0, fishcomp_side:hook_heading_txt);
