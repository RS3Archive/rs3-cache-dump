// 6157
[clientscript,script6157](component $component0)
def_int $int1 = 0;
def_int $int2 = 120;
def_int $int3 = 75;
def_int $int4 = 0;
def_int $int5 = 0;
def_int $int6 = -1;
def_enum $enum7 = null;
while ($int1 < 16) {
    cc_create($component0, ^iftype_graphic, $int1);
    cc_setsize($int2, $int3, ^setsize_abs, ^setsize_abs);
    $int4 = calc($int2 * ($int1 % 4));
    $int5 = calc($int3 * ($int1 / 4));
    cc_setposition($int4, $int5, ^setpos_abs_left, ^setpos_abs_top);
    switch_int (map_lang) {
        case 0 :
            $enum7 = omge_madmay_picture_en;
        case 2 :
            $enum7 = omge_madmay_picture_fr;
        case 3 :
            $enum7 = omge_madmay_picture_pt;
        case 1 :
            $enum7 = omge_madmay_picture_de;
    }
    cc_setgraphic(enum(int, graphic, $enum7, $int1));
    $int1 = calc($int1 + 1);
}
