// 5673
[proc,script5673](component $component0, int $int1, string $string0)
cc_create($component0, ^iftype_text, if_getnextsubid($component0));
cc_setsize(15, 10, ^setsize_minus, ^setsize_abs);
cc_setposition(15, calc($int1 - 1), ^setpos_abs_left, ^setpos_abs_top);
cc_settext($string0);
cc_settextfont(museo_sans_11pt_regular_multiline);
cc_setcolour(~script10495(3));
cc_settextalign(^settextalign_left, ^settextalign_top, 0);
