// 6371
[proc,if_highlight_clear](int $int0, component $component1)
def_component $component2 = enum(int, component, if_highlight_channel_display, $int0);
if_setontimer(null, $component1);
if_setsize(0, 0, ^setsize_abs, ^setsize_abs, $component2);
if_sethide(true, $component2);
cc_deleteall(enum(int, component, if_highlight_flash_yellow, $int0));
cc_deleteall(enum(int, component, if_highlight_flash_white, $int0));
switch_int ($int0) {
    case 0 :
        %if_highlight_static_0 = null;
        %if_highlight_ccid_0 = -1;
    case 1 :
        %if_highlight_static_1 = null;
        %if_highlight_ccid_1 = -1;
