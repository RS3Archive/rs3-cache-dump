// 6469
[clientscript,inventory_setophelds](component $component0, int $int1, obj $obj2, int $int3)
if ($int1 = -1 & if_find($component0) = true | cc_find($component0, $int1) = true) {
    if (cc_getinvobject ! $obj2) {
        return;
    }
    cc_clearops;
    ~inventory_setophelds($obj2, $int3, $int1, -1);
}
