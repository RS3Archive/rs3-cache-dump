// 6249
[clientscript,script6249]
~script19684;
if_setonresize("script19683", seren_coeden:close);
if_sethide(true, seren_coeden:dream);
def_component $component0 = seren_coeden:distractions;
if_setontimer("script7201(event_com)", $component0);
cc_deleteall($component0);
if_setontimer("script11782(seren_coeden:top_lid)", seren_coeden:eyelids);
if_setontimer("script11782(seren_coeden:bottom_lid)", seren_coeden:eyelids);
def_int $int1 = 0;
while ($int1 < 3) {
    cc_create($component0, ^iftype_graphic, $int1);
    cc_setop(1, "Maintain Focus");
    cc_setonop("cc_sethide(true, event_com, $int1)");
    cc_setsize(64, 64, ^setsize_abs, ^setsize_abs);
    cc_sethide(true);
    $int1 = calc($int1 + 1);
}
