// 6260
[clientscript,script6260](component $component0)
def_component $component1 = null;
if (worldlist_fetch = true) {
    $component1 = ~script3099($component0);
    %friends_last_worldlist_fetch = clientclock;
    if_setontimer(null, $component1);
    ~friend_update($component0, %friends_line_pos);
}
