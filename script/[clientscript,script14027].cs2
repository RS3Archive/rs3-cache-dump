// 14027
[clientscript,script14027]
def_int $int0 = -1;
def_int $int1 = calc(4 * 5);
while (++$int0 < $int1) {
    switch_int (calc($int0 / 5)) {
        case 0 :
            if (cc_find(trail17_skyscrapers:hint_top, calc($int0 % 5)) = true) {
                cc_setcolour(0xffcd0a);
            }
        case 1 :
            if (cc_find(trail17_skyscrapers:hint_left, calc($int0 % 5)) = true) {
                cc_setcolour(0xffcd0a);
            }
        case 2 :
            if (cc_find(trail17_skyscrapers:hint_bottom, calc($int0 % 5)) = true) {
                cc_setcolour(0xffcd0a);
            }
        case 3 :
            if (cc_find(trail17_skyscrapers:hint_right, calc($int0 % 5)) = true) {
                cc_setcolour(0xffcd0a);
            }
    }
}
