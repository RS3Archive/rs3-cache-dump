// 10862
[clientscript,script10862]
def_string $string0 = "You can teleport to the Death Altar <tostring(%atelf_tele_charges)> more times today.";
if (%atelf_tele_charges = 1) {
    $string0 = "You can teleport to the Death Altar 1 more time today.";
}
if_settext($string0, atelf_teleports:elfcity_tele_charges);
