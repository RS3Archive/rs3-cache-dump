// 7463
[clientscript,script7463](component $component0)
def_graphic $graphic1 = "rs3_icon_direction_down_32px,0";
def_graphic $graphic2 = "rs3_icon_direction_down_32px,1";
if (if_getgraphic($component0) = "rs3_icon_direction_up_32px,1" | if_getgraphic($component0) = "rs3_icon_direction_up_32px,0") {
    $graphic1 = "rs3_icon_direction_up_32px,0";
    $graphic2 = "rs3_icon_direction_up_32px,1";
}
if_setonmouseleave("script7465($component0, $graphic1)", $component0);
if_setgraphic($graphic2, $component0);
