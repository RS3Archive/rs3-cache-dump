// 17420
[proc,script17420]
if (clientoption_get(^clientoption_shadows) = 1) {
    clientoption_set(^clientoption_shadows, 0);
}
if (clientoption_get(^clientoption_texturing) = 0) {
    clientoption_set(^clientoption_texturing, 1);
}
if (clientoption_get(^clientoption_ambient_occlusion) = 1) {
    clientoption_set(^clientoption_ambient_occlusion, 0);
}
if (clientoption_get(^clientoption_draw_distance) = 0) {
    clientoption_set(^clientoption_draw_distance, 1);
}
