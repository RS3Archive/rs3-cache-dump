// 20660
[proc,script20660](dbrow $dbrow0)(string)
switch_dbrow ($dbrow0) {
    case mobile_shop_membership_1_month_v2 :
        return("<col=E0D471>Standard Membership (Recurring/Subscription)</col>");
    case mobile_shop_premier_membership_12_month_v2 :
        return("<col=E0D471>12 Months Membership (Recurring/Subscription)</col>");
    case default :
        return(db_getfield($dbrow0, mobile_shop_feature_information:col8, 0));
}
