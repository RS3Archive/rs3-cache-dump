// 507
[clientscript,script507](component $component0, component $component1, component $component2, int $int3, component $component4, component $component5, component $component6)
if_setoninvtransmit("script712($component0, $component1, $component2, $int3, $component4, $component5, $component6){trade_loan_offer}", $component0);
if_setonvartransmit("script712($component0, $component1, $component2, $int3, $component4, $component5, $component6){attack}", $component0);
~clanwars_setup_createbox($component0, 0, 0, 0);
~clanwars_setup_createbox($component4, 0, 0, 0);
~script713($component0, $component1, $component2, $int3, $component4, $component5, $component6);
