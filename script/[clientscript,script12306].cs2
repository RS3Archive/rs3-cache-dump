// 12306
[clientscript,script12306]
if (~script12328 = false) {
    cc_deleteall(toplevel_v2:graph_data_layer);
    cc_deleteall(toplevel_v2:graph_data_fine_layer);
    return;
}
def_int $int0 = -1;
def_boolean $boolean1 = false;
if_setparam_int(telemetry_graph_last_update, clientclock, toplevel_v2:graph_data_layer);
if (%telemetry_graph_ids_changed ! 0 | calc((clientclock - %telemetry_graph_data_initial_modulo) % %telemetry_graph_data_divisor) = 0) {
    if (%telemetry_graph_data_divisor > 0) {
        $int0 = calc((clientclock - %telemetry_graph_data_initial_modulo) / %telemetry_graph_data_divisor % 256);
    }
    if (%telemetry_graph_ids_changed = 0 & cc_find(toplevel_v2:graph_data_layer, $int0) = true) {
        ~script12309(toplevel_v2:graph_data_layer, $int0, 0);
        ~script12308;
        ~script12309(toplevel_v2:graph_data_fine_layer, 0, 1);
    } else if (%telemetry_graph_ids_changed = 1 | %telemetry_graph_ids_changed = 2 & calc(clientclock % 25) = 0) {
        ~script12307;
        $int0 = calc((clientclock - %telemetry_graph_data_initial_modulo) / %telemetry_graph_data_divisor % 256);
        $boolean1 = ~script12309(toplevel_v2:graph_data_layer, $int0, 1);
        if ($boolean1 = true) {
            ~script12309(toplevel_v2:graph_data_fine_layer, 0, 1);
        }
        if ($boolean1 = true) {
            %telemetry_graph_ids_changed = 0;
        }
        if (~script12344(30, 0) = true) {
            ~script12318(~script3387(0));
        }
        if (~script12344(30, 1) = true) {
            ~script12318(~script3387(1));
