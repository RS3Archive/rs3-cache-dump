    }
} else if (calc((clientclock - %telemetry_graph_data_initial_modulo) % %telemetry_graph_data_divisor % %telemetry_graph_data_divisor_fine) = 0) {
    ~script12309(toplevel_v2:graph_data_fine_layer, 1, 0);
