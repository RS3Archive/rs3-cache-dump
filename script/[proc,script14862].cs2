        if_settext("Unharnessing relic power: <db_getfield($dbrow3, arch_relic:col1, 0)>.", arch_relic_management:confirmation_info);
        if_settext("Harnessing this relic power again will require the following:<br>Chronote cost: <tostring_localised(~script14611($dbrow3), true)><br>Monolith energy: <tostring_localised(~script14612($dbrow3), true)><br>Are you sure you wish to continue?", arch_relic_management:confirmation_summary);
