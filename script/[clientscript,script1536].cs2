// 1536
[clientscript,script1536](int $int0)
def_int $int1 = calc(65 - scale(calc($int0 + 300 - clientclock), 300, 50));
def_int $int2 = 255;
def_int $int3 = scale(220, 50, $int1);
def_int $int4 = scale(180, 50, $int1);
if ($int1 < 65) {
    if_setsize($int1, if_getheight(tuska_island_overlay:gt_ready), ^setsize_abs, ^setsize_abs, tuska_island_overlay:gt_ready);
    if_setcolour(~rgb_to_hex($int2, $int3, $int4), tuska_island_overlay:gt_text);
} else {
    if_sethide(false, tuska_island_overlay:finished_recharge);
    if_setontimer(null, tuska_island_overlay:gatestone_layer);
}
