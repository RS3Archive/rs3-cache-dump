// 14251
[clientscript,boardgames_options_click](component $component0)
switch_component ($component0) {
    case boardgames_options:firerune1, boardgames_options:firerune2 :
        %boardgames_piece = 1;
    case boardgames_options:waterrune1, boardgames_options:waterrune2 :
        %boardgames_piece = 2;
    case boardgames_options:earthrune1, boardgames_options:earthrune2 :
        %boardgames_piece = 3;
    case boardgames_options:airrune1, boardgames_options:airrune2 :
        %boardgames_piece = 4;
    case boardgames_options:mindrune1, boardgames_options:mindrune2 :
        %boardgames_piece = 5;
    case boardgames_options:bodyrune1, boardgames_options:bodyrune2 :
        %boardgames_piece = 6;
    case boardgames_options:naturerune1, boardgames_options:naturerune2 :
        %boardgames_piece = 7;
    case boardgames_options:chaosrune1, boardgames_options:chaosrune2 :
        %boardgames_piece = 8;
    case boardgames_options:lawrune1, boardgames_options:lawrune2 :
        %boardgames_piece = 9;
    case boardgames_options:cosmicrune1, boardgames_options:cosmicrune2 :
        %boardgames_piece = 10;
    case boardgames_options:bloodrune1, boardgames_options:bloodrune2 :
        %boardgames_piece = 11;
    case boardgames_options:soulrune1, boardgames_options:soulrune2 :
        %boardgames_piece = 12;
}
~script1409;
