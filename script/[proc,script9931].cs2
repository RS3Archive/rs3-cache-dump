// 9931
[proc,script9931](component $component0, component $component1)(boolean)
if ($component0 = null | $component1 = null) {
    return(false);
}
while ($component0 ! null) {
    if ($component0 = $component1) {
        return(true);
    }
    $component0 = if_getparentlayer($component0);
}
return(false);
