if_setonmouseleave("wof_chest_mouseleave(wheel_of_fortune:chest_model_2)", wheel_of_fortune:wheel_spin_button_active_layer_2);
if_setmodelanim(trh_chest_closed_idle, wheel_of_fortune:chest_model_3);
