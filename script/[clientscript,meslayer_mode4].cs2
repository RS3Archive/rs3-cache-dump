// 105
[clientscript,meslayer_mode4]
if (%has_displayname_client = false) {
    return;
}
if (%snapshot_open = true) {
    ~script675;
}
if_sethide(false, meslayer:root);
if_settext("Enter name of player to add to list", meslayer:mes_text);
%meslayermode = 4;
~meslayer_setupinput("");
if_setonclick(null, meslayer:mes_layer);
~script2026;
