// 8542
[clientscript,script8542]
if (%oct13_isrunefest = 0) {
    if_sethide(true, oct13_therm:oct13_runefest_logo);
    if_setsize(424, 215, ^setsize_abs, ^setsize_abs, oct13_therm:oct13_therm_text);
    if_setsize(6, 46, ^setsize_minus, ^setsize_abs, oct13_therm:oct13_current_info);
    if_settext("Lumbridge needs you!<br>Carry rubble and gather resources to rebuild the homes damaged by the Battle of Lumbridge!", oct13_therm:oct13_current_info_text);
    if_setsize(16384, 16384, ^setsize_rel, ^setsize_rel, oct13_therm:oct13_current_info_text);
    if_setposition(0, 0, ^setpos_abs_right, ^setpos_abs_top, oct13_therm:oct13_current_info_text);
} else {
    if_sethide(false, oct13_therm:oct13_runefest_logo);
    if_setsize(424, 249, ^setsize_abs, ^setsize_abs, oct13_therm:oct13_therm_text);
    if_setsize(6, 80, ^setsize_minus, ^setsize_abs, oct13_therm:oct13_current_info);
    if_settext("Today only, you can help build a memorial to the fallen of the Battle of Lumbridge.<br>Bring stone to builder Bob between the foreman and the stockpiles.", oct13_therm:oct13_current_info_text);
    if_setsize(320, 16384, ^setsize_abs, ^setsize_rel, oct13_therm:oct13_current_info_text);
    if_setposition(0, 0, ^setpos_abs_right, ^setpos_abs_top, oct13_therm:oct13_current_info_text);
}
