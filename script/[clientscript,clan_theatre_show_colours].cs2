// 5302
[clientscript,clan_theatre_show_colours](component $component0, component $component1)
if (if_gethide($component0) = true) {
    ~script5306;
    if_sethide(false, $component0);
    if_setgraphic("aif_symbol_set_1,5", $component1);
} else {
    if_sethide(true, $component0);
    if_setgraphic("aif_symbol_set_1,4", $component1);
    ~script8808;
}
