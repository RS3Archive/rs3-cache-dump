// 6097
[proc,shop_mode_button_setup](int $int0)
if ($int0 = 0) {
    if_sethide(false, shop_main:buy_tab_selected_layer);
    if_sethide(true, shop_main:sell_tab_selected_layer);
} else {
    if_sethide(true, shop_main:buy_tab_selected_layer);
    if_sethide(false, shop_main:sell_tab_selected_layer);
}
