// 15295
[proc,script15295]
def_int $int0 = 0;
while ($int0 < 7) {
    cc_create(trh171_overlay:modifier_list_panels, ^iftype_rectangle, $int0);
    cc_setsize(4, 32, ^setsize_minus, ^setsize_abs);
    cc_setposition(0, calc(32 * $int0), ^setpos_abs_centre, ^setpos_abs_top);
    cc_setfill(true);
    if (calc($int0 % 2) = 0) {
        cc_setcolour(0x071920);
    } else {
        cc_setcolour(0x1c2c34);
    }
    $int0 = calc($int0 + 1);
}
cc_create(trh171_overlay:modifier_list_panels, ^iftype_line, $int0);
cc_setposition(0, calc(32 * 2), ^setpos_abs_centre, ^setpos_abs_top);
cc_setsize(40, 0, ^setsize_minus, ^setsize_abs);
cc_setcolour(0xb4a092);
