// 14723
[proc,script14723](string $string0)(string)
def_int $int0 = ~script8942;
if ($int0 = 0) {
    $string0 = "<$string0>- Your armour spikes gain <col=ffffff><tostring(65)>%</col> of your melee power armour damage bonus as bonus damage.";
    $string0 = "<$string0><br>- Increase this bonus damage by <col=ffffff><tostring(50)>%</col> of melee power armour damage bonus if your <sprite=18851><nbsp><col=ED705A>Life<nbsp>Points</col> are below <col=ffffff><tostring_localised(scale(60, 100, ~script2915), true)></col> (<col=ffffff>60%</col> <sprite=18851><nbsp><col=ED705A>Maximum<nbsp>Life<nbsp>Points</col>).";
} else {
    $string0 = "<$string0>- Your armour spikes gain <col=ffffff><tostring(scale($int0, 100, 65))></col> (<col=ffffff><tostring(65)>%</col> of melee power armour damage bonus) as bonus damage.";
    $string0 = "<$string0><br>- Increase this bonus damage by <col=ffffff><tostring(scale($int0, 100, 50))></col> (<col=ffffff><tostring(50)>%</col> of melee power armour damage bonus) if your <sprite=18851><nbsp><col=ED705A>Life<nbsp>Points</col> are below <col=ffffff><tostring_localised(scale(60, 100, ~script2915), true)></col> (<col=ffffff>60%</col> <sprite=18851><nbsp><col=ED705A>Maximum<nbsp>Life<nbsp>Points</col>).";
}
return($string0);
