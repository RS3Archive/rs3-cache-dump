// 5598
[clientscript,script5598](component $component0)
def_coord $coord1 = ~script284(coord);
switch_int (%xmas11_cutscene_tracker) {
    case 1 :
        ~tutorial3_fadein(75, $component0);
        ~script5602($coord1);
        cam_movealong(0, 0, 1000, 0, 1, 0);
    case 2 :
        ~script5602($coord1);
        cam_movealong(0, 1, 2000, 2000, 1, 1);
        if_setoncamfinished("script5599(event_com, 2, 2000, 2000)", $component0);
    case 3 :
        ~tutorial3_fadein(75, $component0);
        ~script5603($coord1);
        cam_movealong(0, 0, 800, 800, 1, 0);
        if_setoncamfinished("script5600(event_com, 1, 800, 800)", $component0);
    case 4 :
        ~script5603($coord1);
        cam_movealong(0, 3, 800, 800, 1, 3);
        if_setoncamfinished("script5601(event_com, 4, 800, 800)", $component0);
}
