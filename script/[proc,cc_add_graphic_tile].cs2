// 6199
[proc,cc_add_graphic_tile](component $component0, graphic $graphic1, int $int2, int $int3, int $int4, int $int5)
cc_create($component0, ^iftype_graphic, if_getnextsubid($component0));
cc_setposition($int2, $int3, ^setpos_abs_left, ^setpos_abs_top);
cc_setsize($int4, $int5, ^setsize_abs, ^setsize_abs);
cc_setgraphic($graphic1);
cc_settiling(true);
