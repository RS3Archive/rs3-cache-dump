// 11506
[proc,script11506](component $component0, component $component1)
if_sethide(false, $component0);
if_sethide(false, $component1);
if ($component0 ! fishcomp_rewards_shop:box_tab_selected_layer) {
    if_sethide(true, fishcomp_rewards_shop:box_tab_selected_layer);
}
if ($component0 ! fishcomp_rewards_shop:reset_tab_selected_layer) {
    if_sethide(true, fishcomp_rewards_shop:reset_tab_selected_layer);
}
if ($component1 ! fishcomp_rewards_shop:tackle_box_layer) {
    if_sethide(true, fishcomp_rewards_shop:tackle_box_layer);
}
if ($component1 ! fishcomp_rewards_shop:tackle_box_reset_layer) {
    if_sethide(true, fishcomp_rewards_shop:tackle_box_reset_layer);
}
switch_component ($component0) {
    case fishcomp_rewards_shop:box_tab_selected_layer :
        %fishcomp_rewards_shop_tackle_tab = 0;
    case fishcomp_rewards_shop:reset_tab_selected_layer :
        %fishcomp_rewards_shop_tackle_tab = 1;
}
