// 6123
[clientscript,script6123](component $component0, int $int1, int $int2)
def_int $int3 = if_gety($component0);
if ($int3 > $int1) {
    $int3 = calc($int3 - $int2);
    if ($int3 <= $int1) {
        $int3 = $int1;
        if_setontimer(null, $component0);
    }
} else {
    $int3 = calc($int3 + $int2);
    if ($int3 >= $int1) {
        $int3 = $int1;
        if_setontimer(null, $component0);
    }
}
if_setposition(if_getx($component0), $int3, ^setpos_abs_left, ^setpos_abs_top, $component0);
