// 11399
[proc,script11399]
cc_deleteall(poh_costume_room:set_build_area);
if_settext("", poh_costume_room:name_text);
if (%poh_costume_external = 1 | %costume_room_opened_from_bank = 1) {
    if_settext("Select an item from the list to view the contents of the set.<br><br>To deposit or withdraw, you must visit your player-owned house.", poh_costume_room:set_text);
} else {
    if_settext("Select an item from the list to view the contents of the set.<br><br>With an item selected you can deposit the items if they are in your inventory.<br><br>If you have items stored selecting them will allow you to withdraw them.", poh_costume_room:set_text);
}
~script13971(poh_costume_room:deposit_build, poh_costume_room:deposit_click, rs3tli_positive_button, "Deposit", true);
