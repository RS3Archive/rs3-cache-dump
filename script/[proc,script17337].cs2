// 17337
[proc,script17337](obj $obj0)(int)
switch_obj ($obj0) {
    case bought_mhaw_may23_power_bundle, mhaw_may23_power_bundle_giftbox :
        return(%mhaw_may23_power_bundles_opened);
    case bought_mhaw_may23_cosmetic_bundle, mhaw_may23_cosmetic_bundle_giftbox :
        return(%mhaw_may23_cosmetic_bundles_opened);
}
