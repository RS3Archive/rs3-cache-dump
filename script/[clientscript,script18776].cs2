// 18776
[clientscript,script18776](component $component0, int $int1)
def_int $int2 = 0;
def_int $int3 = calc(clientclock - $int1);
if ($int3 <= 30) {
    $int2 = max(0, calc(255 - 255 / (30 / 6) * $int3));
    $int2 = min(if_gettrans(interface_764:com_19), $int2);
} else {
    $int2 = min(255, calc(255 / (30 / 5) * ($int3 - 30)));
    $int2 = max(if_gettrans(interface_764:com_19), $int2);
}
if_settrans($int2, interface_764:com_19);
if ($int3 >= calc(30 * 2)) {
    if_setontimer(null, $component0);
}
