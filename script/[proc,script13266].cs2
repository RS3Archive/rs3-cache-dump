// 13266
[proc,script13266]
def_int $int0 = if_getscrollx(bank:tabs_dynamic);
def_int $int1 = calc(if_getscrollwidth(bank:tabs_dynamic) - if_getwidth(bank:tabs_dynamic));
def_int $int2 = min($int1, calc(($int0 / 48 + 1) * 48));
if_setscrollpos(min(calc($int0 + 4), $int1), 0, bank:tabs_dynamic);
if_setscrollpos(min(calc($int0 + 4), $int1), 0, bank:tabs_spacers);
if_setontimer("script13267($int2)", bank:tabs);
