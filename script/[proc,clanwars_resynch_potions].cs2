// 1780
[proc,clanwars_resynch_potions]
~static_checkbox(clanwars_setup:potions_indicator, ~bool_to_int(~not_bool(%clanwars_rulevarc_nopotions)), false);
if (%clanwars_rulevarc_nopotions = false) {
    if_settrans(0, clanwars_setup:potions);
} else {
    if_settrans(225, clanwars_setup:potions);
}
~clanwars_updateside;
