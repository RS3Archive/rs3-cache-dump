// 4538
[clientscript,script4538](int $int0, component $component1, component $component2)
def_int $int3 = 0;
if (clientclock > $int0 | if_gethide($component2) = true) {
    if_setontimer(null, $component1);
    if_settext("", $component1);
} else {
    $int3 = calc(1 + ($int0 - clientclock) / 50);
    if ($int3 > 60) {
        if_settext("<tostring(calc($int3 / 60))>m", $component1);
    } else {
        if_settext(tostring($int3), $component1);
    }
}
