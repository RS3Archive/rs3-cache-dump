// 919
[proc,script919]
def_int $int0 = inv_total(inv, %objreq_currency);
if (%objreq_currency = coins | %objreq_currency = null) {
    $int0 = ~script17404;
}
def_string $string0 = "Cost:";
def_int $int1 = -1;
if (%objreq_price = 0) {
    $string0 = "None available";
} else if (%objreq_price = -1) {
    $string0 = "Free sample!";
} else {
    $int1 = %objreq_price;
}
if_settext($string0, obj_info:buy_text);
if ($int1 > $int0) {
    if_setcolour(^red, obj_info:player_has);
} else {
    if_setcolour(%objreq_fontcol, obj_info:player_has);
}
if ($int1 > -1) {
    if_setobject_alwaysnum(%objreq_currency, $int1, obj_info:buy_graphic);
} else {
    if_setobject_nonum(null, -1, obj_info:buy_graphic);
}
if (%objreq_price = -1) {
    ~script13969(obj_info:buy_button, null, rs3tli_positive_button, "Take");
    if_setop(1, "Take 1", obj_info:buy_button);
    if_setop(2, "Take 5", obj_info:buy_button);
    if_setop(3, "Take 10", obj_info:buy_button);
    if_setop(4, "Take 50", obj_info:buy_button);
} else {
    ~script13969(obj_info:buy_button, null, rs3tli_positive_button, "Buy");
    if_setop(1, "Buy 1", obj_info:buy_button);
    if_setop(2, "Buy 5", obj_info:buy_button);
    if_setop(3, "Buy 10", obj_info:buy_button);
    if_setop(4, "Buy 50", obj_info:buy_button);
}
