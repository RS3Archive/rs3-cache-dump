[proc,script4856]
if (clanprofile_find = true) {
    if (%clan_stronghold_tier < 7) {
        if_sethide(true, clan_stronghold_main_buildings:skill_plot_button_parent_layer_9);
        if_sethide(true, clan_stronghold_main_buildings:skill_plot_button_parent_layer_10);
        if_sethide(true, clan_stronghold_main_buildings:skill_plot_button_parent_layer_11);
        if_sethide(true, clan_stronghold_main_buildings:skill_plot_button_parent_layer_12);
    }
    if (%clan_stronghold_tier < 5) {
        if_sethide(true, clan_stronghold_main_buildings:skill_plot_button_parent_layer_8);
        if_sethide(true, clan_stronghold_main_buildings:skill_plot_button_parent_layer_7);
        if_sethide(true, clan_stronghold_main_buildings:skill_plot_button_parent_layer_6);
        if_sethide(true, clan_stronghold_main_buildings:skill_plot_button_parent_layer_5);
    }
    if (%clan_stronghold_tier < 3) {
        if_sethide(true, clan_stronghold_main_buildings:skill_plot_button_parent_layer_4);
        if_sethide(true, clan_stronghold_main_buildings:skill_plot_button_parent_layer_3);
    }
}
