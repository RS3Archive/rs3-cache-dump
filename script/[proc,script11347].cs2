// 11347
[proc,script11347](component $component0, component $component1)
def_string $string0 = "Special Attack (<tostring(calc(%sa_energy / 10))>%)";
if (%fremsaga_current_saga = 3 & %fremsaga_bilrach_is_charged_moia = 1) {
    $string0 = "Portal Energy (<tostring(calc(%sa_energy / 10))>%)";
}
if (paraheight($string0, if_getwidth($component1), verdana_11pt_regular) > 1 | parawidth($string0, if_getwidth($component1), verdana_11pt_regular) > if_getwidth($component1)) {
    $string0 = "<tostring(calc(%sa_energy / 10))>%";
}
~aif_progressbar_set(scale(%sa_energy, 1000, 100), $component0, $component1);
def_int $rgb2 = 0xd5d9d3;
if (%sa_attack > 0) {
    $rgb2 = 0xff981f;
}
~script4212($component1, $string0, verdana_11pt_regular, $rgb2, 0);
