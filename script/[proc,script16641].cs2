// 16641
[proc,script16641](component $component0)
if_sethide(false, $component0);
def_string $string0 = "";
switch_int (%trail_compass_open_source) {
    case 1 :
    case 2 :
        $string0 = "You can excavate at this location.";
        if (if_find(trail_compassclue_side:dig_icon) = true) {
            cc_setmodel(human_worker_miner_mattock_crystal);
            cc_setmodelangle(-85, -200, 1340, 1872, 1596, 450);
            cc_setonmouserepeat("script8799($string0, trail_compassclue_side:dig_icon, -1)");
        }
        if_setop(1, "Excavate", trail_compassclue_side:dig_icon_layer);
    case 3 :
        if_sethide(true, trail_compassclue_side:dig_icon_layer);
}
