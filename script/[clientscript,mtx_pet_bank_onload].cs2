// 10043
[clientscript,mtx_pet_bank_onload](component $component0, component $component1, component $component2, struct $struct3)
def_string $string0 = "Pet Banking Service";
def_string $string1 = "Select an item to send to your bank:";
if (%mtx_pet_alch_ability = 1) {
    $string0 = "Pet High Level Alchemy";
    $string1 = "Select an item to cast high level alchemy on:";
}
~script9554($component0, $component1, $component2, $string0, $struct3);
if_settext($string1, pet_bank:instruction_text);
