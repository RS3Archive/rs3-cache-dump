[clientscript,script7438](component $component0, int $int1, int $int2)
def_graphic $graphic3 = null;
if (cc_find($component0, $int1) = true) {
    if ($int2 = ~script20335(1) | $int2 = ~script20335(2) | $int2 = ~script20335(3)) {
        $graphic3 = "rs3_icon_lobby_favorite_small,0";
    } else {
        $graphic3 = "rs3_icon_lobby_favorite_small,2";
