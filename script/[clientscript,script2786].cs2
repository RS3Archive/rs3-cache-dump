// 2786
[clientscript,script2786](int $int0)
if ($int0 = 2) {
    sound_vorbis_volume(tli_click_01, 1, 0, 120);
    autosetup_setlow;
    if (~is_mobile_client = true) {
        ~script17420;
    }
    %using_autosetup = 0;
    ~script2710;
} else if ($int0 = 3 & %using_autosetup = 0) {
