// 5731
[proc,bank_get_side_inv]()(inv)
switch_int (%bank_current_inv) {
    case default :
        return(inv);
    case 2 :
        return(worn);
    case 1 :
        if (%follower_obj = null | ~script11682(%lore_npc_head) = 0) {
            return(inv);
        }
        return(lore_bob);
}
return(inv);
