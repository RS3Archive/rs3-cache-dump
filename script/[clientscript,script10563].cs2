// 10563
[clientscript,script10563](int $int0, int $int1)
if (cc_find(runemach_dnd:runes_layer, $int0) = true) {
    cc_settrans(120);
}
if ($int1 = 1) {
    if (%runemach_selected_1 >= 20 | %runemach_selected_1 = $int0) {
        $int1 = 2;
    } else if (%runemach_selected_2 >= 20 | %runemach_selected_2 = $int0) {
        $int1 = 3;
    } else if (%runemach_selected_2 >= 20 | %runemach_selected_2 = $int0) {
        $int1 = 4;
    } else if (%runemach_last_slot > 0) {
        $int1 = calc(%runemach_last_slot + 1);
    }
}
if ($int1 = 2) {
    if ($int0 ! %runemach_selected_1) {
        ~script10560($int0, runemach_dnd:slot1_container);
        if_settext("Base rune cost: <col=ffffff>???</col>.<br>+<col=ffffff>???</col> Total: <col=ffffff>???</col>.", runemach_dnd:slot1_quantity);
    }
} else if ($int1 = 3) {
    if ($int0 ! %runemach_selected_2) {
        ~script10560($int0, runemach_dnd:slot2_container);
        if_settext("Base rune cost: <col=ffffff>???</col>.<br>+<col=ffffff>???</col> Total: <col=ffffff>???</col>.", runemach_dnd:slot2_quantity);
    }
} else if ($int1 = 4 & $int0 ! %runemach_selected_3) {
    ~script10560($int0, runemach_dnd:slot3_container);
    if_settext("Base rune cost: <col=ffffff>???</col>.<br>+<col=ffffff>???</col> Total: <col=ffffff>???</col>.", runemach_dnd:slot3_quantity);
}
