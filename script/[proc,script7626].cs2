// 7626
[proc,script7626](dbrow $dbrow0, int $int1, string $string0)(string)
switch_dbrow ($dbrow0) {
    case wish_options :
        if ($int1 = 0) {
            $string0 = append("<col=ffffff>Charge Remaining:</col> <tostring(%wish_charges_remaining)>%<br><br>", $string0);
        } else {
            $string0 = append("<col=ffffff>Charge Remaining:</col> <tostring(%wish_charges_remaining)>%<br><col=ffffff>Charge Cost:</col> <~script2700($int1)>%<br><br>", $string0);
