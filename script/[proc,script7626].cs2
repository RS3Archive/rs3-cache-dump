        } else if (enum(int, dbrow, weekends_boss_spotlight_events, $int1) ! null) {
            $string0 = append("<col=ffffff>Active:</col> <~fromdate_numeric(~script16024(enum(int, int, weekends_boss_spotlight_week_to_event_id, $int1)))> - <~fromdate_numeric(~script16025(enum(int, int, weekends_boss_spotlight_week_to_event_id, $int1)))><br><br>", $string0);
