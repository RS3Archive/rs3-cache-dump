// 17542
[proc,script17542](loc $loc0)(int)
switch_loc ($loc0) {
    case default :
        ~error("necro_ritual_pedestal_state_get - no pedestal found!");
    case necro_ritual_site_city_pedestal :
        return(%necro_ritual_site_city_pedestal_state);
    case necro_ritual_site_ungael_pedestal :
        return(%necro_ritual_site_ungael_pedestal_state);
}
