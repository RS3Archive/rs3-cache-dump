// 21256
[clientscript,script21256]
if (if_gethide(minimenu:clickout_and_blocking_layer) = true) {
    if_setontimer(null, minimenu:clickout_and_blocking_layer);
    return;
}
if (~script21257(minimenu:menu_blocking_layer) = false & ~script21257(minimenu:submenu_blocking_layer) = false) {
    ~minimenu_close;
    minimenu_close;
}
