// 3624
[proc,script3624](int $int0, int $int1, int $int2, string $string0, int $int3)
if ($int0 < $int3 | $int3 = -1) {
    if ($int0 < $int1) {
        if_setonop("runepass_claim_screen(calc($int0 + 1), %runepass_reward_start_index, $int1, $int2, $string0, $int3)", runepass:claim_button);
    } else {
        if_setonop("runepass_reward_close_claim", runepass:claim_button);
    }
    if_setonmouserepeat(null, runepass:claim_button);
} else {
    if_setonop("script8799($string0, event_com, -1)", runepass:claim_button);
    if_setonmouserepeat("script8799($string0, event_com, -1)", runepass:claim_button);
}
