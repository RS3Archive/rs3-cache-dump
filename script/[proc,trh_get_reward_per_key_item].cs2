// 6762
[proc,trh_get_reward_per_key_item](struct $struct0, dbrow $dbrow1)(obj, int)
switch_struct ($struct0) {
    case trh177_promo :
        return(db_getfield($dbrow1, trh177_promo_bonus:col6, 0));
    case trh196_promo :
        return(db_getfield($dbrow1, trh196_promo_bonus:col6, 0));
    case trh205_promo :
        return(db_getfield($dbrow1, trh205_promo_bonus:col6, 0));
    case default :
        ~error("Unexpected promo in trh_get_reward_per_key_item - returning null,0");
}
return(null, 0);
