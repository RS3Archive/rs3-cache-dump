// 6621
[clientscript,script6621](component $component0, inv $inv1)
def_int $int2 = 0;
while ($int2 < 100) {
    if (inv_getobj($inv1, $int2) = boardgames_airrune) {
        if (cc_find($component0, $int2) = true) {
            cc_setgraphic(aif_penguin_miss);
        }
    } else if ((inv_getobj($inv1, $int2) = boardgames_draughts_mindrune_king | inv_getobj($inv1, $int2) = boardgames_draughts_bodyrune_king | inv_getobj($inv1, $int2) = boardgames_draughts_naturerune_king | inv_getobj($inv1, $int2) = boardgames_draughts_chaosrune_king | inv_getobj($inv1, $int2) = boardgames_draughts_lawrune_king | inv_getobj($inv1, $int2) = boardgames_draughts_cosmicrune_king | inv_getobj($inv1, $int2) = boardgames_draughts_waterrune_king) & cc_find($component0, $int2) = true) {
        cc_setgraphic(aif_penguin_hit);
    }
    $int2 = calc($int2 + 1);
}
