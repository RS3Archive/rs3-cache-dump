// 6621
[clientscript,script6621](component $component0, inv $inv1)
def_int $int2 = 0;
while ($int2 < 100) {
    if (inv_getobj($inv1, $int2) = obj_7099) {
        if (cc_find($component0, $int2) = true) {
            cc_setgraphic(aif_penguin_miss);
        }
    } else if ((inv_getobj($inv1, $int2) = obj_3873 | inv_getobj($inv1, $int2) = obj_3874 | inv_getobj($inv1, $int2) = obj_3875 | inv_getobj($inv1, $int2) = obj_3876 | inv_getobj($inv1, $int2) = obj_3877 | inv_getobj($inv1, $int2) = obj_3878 | inv_getobj($inv1, $int2) = obj_3870) & cc_find($component0, $int2) = true) {
        cc_setgraphic(aif_penguin_hit);
    }
    $int2 = calc($int2 + 1);
}
