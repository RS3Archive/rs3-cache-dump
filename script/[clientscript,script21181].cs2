// 21181
[clientscript,script21181]
if (if_find(plugin_hub_parent_auth:input) = true) {
    if (cc_input_getcontentvisibilitymode = 1) {
        if_setgraphic("rs3_icon_hide_16px,4", plugin_hub_parent_auth:show_hide_graphic);
        cc_input_setup(0, cc_input_getfiltermode, cc_input_getmaxlength);
        cc_focus;
    } else {
        if_setgraphic("rs3_icon_hide_16px,0", plugin_hub_parent_auth:show_hide_graphic);
        cc_input_setup(1, cc_input_getfiltermode, cc_input_getmaxlength);
        cc_focus;
    }
}
