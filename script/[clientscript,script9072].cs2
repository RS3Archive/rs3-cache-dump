// 9072
[clientscript,script9072](component $component0, int $int1, int $int2)
if (%trh167_crystal_exploding ! $int2) {
    if ($int1 <= 0) {
        if_setmodelanim(null, $component0);
        if_setmodelanim(trh167_crystal_idle, $component0);
        if_setontimer(null, $component0);
    } else {
        $int1 = calc($int1 - 1);
        if_setontimer("script9072($component0, $int1, $int2)", $component0);
    }
} else {
    if_setontimer(null, $component0);
}
