// 4039
[clientscript,script4039](component $component0, int $int1, int $int2)
if (cc_find($component0, $int1) = true) {
    if ($int2 = 1) {
        cc_setcolour(^cyan);
    } else if (~script7073($int1) = 2) {
        cc_setcolour(^green);
    } else if (~script7073($int1) = 1) {
        cc_setcolour(^yellow);
    } else {
        cc_setcolour(^red);
    }
}
