// 6671
[proc,wof_button_setup_claim](obj $obj0, int $int1)
if (%wof_claim_state = -1) {
    return;
}
def_string $string0 = "Claim item";
def_boolean $boolean2 = false;
def_string $string1 = "You do not have a prize to claim.";
def_string $string2 = "You do not have a prize to claim.";
if (%wof_reward_slot <= 0) {
    $string1 = "You do not have a prize to claim.";
    $string2 = "You do not have a prize to claim.";
    $boolean2 = false;
} else {
    $string0 = "Claim item";
    switch_int (%wof_claim_state) {
        case 1, 3, 8, 9, 5 :
            $boolean2 = true;
        case default :
            $boolean2 = false;
    }
    switch_int (%wof_claim_state) {
        case 1 :
            $string1 = "Claim your prize to your backpack.";
            $string2 = "Your backpack doesn't have room for your prize at the moment.";
        case 2 :
            $string1 = "Claim your prize to your backpack.";
            $string2 = "Your backpack doesn't have room for your prize at the moment.";
        case 3 :
            $string1 = "Claim your prize to your bank.";
            $string2 = "Your bank doesn't have room for your prize at the moment.";
        case 4 :
            $string1 = "Claim your prize to your bank.";
            $string2 = "Your bank doesn't have room for your prize at the moment.";
        case 5, 6 :
            $string1 = "Claim your prize to your money pouch.";
            $string2 = "Your money pouch doesn't have room for your prize at the moment.";
        case 7 :
            $string1 = "Treasure Hunter is not available at the moment. Please try later.";
            $string2 = "Treasure Hunter is not available at the moment. Please try later.";
        case 8 :
            $string1 = "Claim to unlock this prize.";
            $string2 = "Claim to unlock this prize.";
            $string0 = "Claim prize";
        case 9 :
            $string1 = "Add the key to your collection of earned keys.";
            $string2 = "Add the key to your collection of earned keys.";
            $string0 = "Use ticket";
        case 10 :
            $string1 = "Loading...";
            $string2 = "Loading...";
        case 11 :
            $string1 = "Your backpack doesn't have room for your prize at the moment.";
            $string2 = "Your backpack doesn't have room for your prize at the moment.";
    }
}
if_setop(1, $string0, wheel_of_fortune:reward_claim_auto_button);
if_setenabled($boolean2, wheel_of_fortune:reward_claim_auto_button);
if ($boolean2 = true) {
    if_setonmouserepeat("script3876($string1, event_com, -1)", wheel_of_fortune:reward_claim_auto_button);
} else {
    if_setonmouserepeat("script3876($string2, event_com, -1)", wheel_of_fortune:reward_claim_auto_button);
}
