// 1223
[clientscript,script1223]
if (gender = 1) {
    if_setmodel(chosen_reward_statue_action_melee_female_plinth_if, chosen_reward_statue_interface:statue_model_1);
    if_setmodel(chosen_reward_statue_action_mage_female_plinth_if, chosen_reward_statue_interface:statue_model_2);
    if_setmodel(chosen_reward_statue_action_ranger_female_plinth_if, chosen_reward_statue_interface:statue_model_3);
    if_setmodel(chosen_female_triumphant_plinth_if, chosen_reward_statue_interface:statue_model_4);
    if_setmodel(chosen_female_ushering_zanik_plinth_if, chosen_reward_statue_interface:statue_model_5);
    if_setmodel(chosen_female_feeding_zanik_plinth_if, chosen_reward_statue_interface:statue_model_6);
    if_setmodel(chosen_reward_statue_female_star_wars_plinth_if, chosen_reward_statue_interface:statue_model_7);
}
~script1226(%chosen_statue_selected);
