// 12048
[proc,trh193_get_bonus_option](int $int0)(int)
switch_int ($int0) {
    case 1 :
        return(%trh193_bonus_option_1);
    case 2 :
        return(%trh193_bonus_option_2);
    case default :
        ~error("No entry for bonus option <tostring($int0)> in trh193_get_bonus_option.");
}
return(-1);
