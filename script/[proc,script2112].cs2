// 2112
[proc,script2112](quest $quest0, int $int1)(stat, int)
if ($quest0 = null) {
    ~error("Null .quest.");
    return(null, 0);
}
if (quest_statreq_count($quest0) < $int1) {
    return(null, 0);
}
return(quest_statreq_stat($quest0, calc($int1 - 1)), quest_statreq_level($quest0, calc($int1 - 1)));
