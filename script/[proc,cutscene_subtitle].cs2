// 7173
[proc,cutscene_subtitle](string $string0, int $int0)
if (%cutscene_subtitle_hide = null) {
    %cutscene_subtitle_hide = false;
}
if (%cutscene_subtitle_hide = false) {
    ~script7177;
    if (compare(lowercase($string0), "[subtitles_load]") = 0) {
        return;
    } else if (compare(lowercase($string0), "[subtitles_close]") = 0) {
        ~script7178;
    } else if (compare(lowercase($string0), "[subtitles_hide]") = 0) {
        ~script7176;
    } else if (compare(lowercase($string0), "[subtitles_mode_noeffects]") = 0) {
        %cutscene_subtitle_show_effect = 1;
    } else if (compare(lowercase($string0), "[subtitles_mode_typein]") = 0) {
        %cutscene_subtitle_show_effect = 2;
    } else if (compare(lowercase($string0), "[subtitles_mode_typein_dropshadow]") = 0) {
        %cutscene_subtitle_show_effect = 3;
    } else if (compare(lowercase($string0), "[subtitles_mode_fadein]") = 0) {
        %cutscene_subtitle_show_effect = 4;
    } else if (compare(lowercase($string0), "[subtitles_mode_fadein_dropshadow]") = 0) {
        %cutscene_subtitle_show_effect = 5;
    } else if (compare(lowercase($string0), "[subtitles_mode_dropshadow]") = 0) {
        %cutscene_subtitle_show_effect = 6;
    } else {
        ~display_cutscene_subtitle(1, 2, $string0, $int0);
    }
}
