// 11431
[proc,script11431](component $component0)
switch_component ($component0) {
    case acc_create:logout_cancel :
        cc_setonbuttonpressed("script7880");
    case acc_create:logout_confirm :
        cc_setonbuttonpressed("script7881");
    case acc_create_name:sug_1, acc_create_name:sug_2, acc_create_name:sug_3 :
        cc_setonbuttonpressed("script15558(event_com)");
    case acc_create_name:back_button :
        cc_setonbuttonpressed("script15556");
    case acc_create_name:refresh_suggestions_layer :
        cc_setonbuttonpressed("script7838");
    case game_mode_selection:button_confirm :
        cc_setonop("script15584");
    case game_mode_selection:button_back :
        cc_setonop("script19611");
}
