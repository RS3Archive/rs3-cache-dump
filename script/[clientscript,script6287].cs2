// 6287
[clientscript,script6287]
if (%cruc_overlay_sh_state < 0) {
    %cruc_overlay_sh_state = 0;
}
if (%cruc_overlay_sh_state = 0) {
    %cruc_overlay_sh_state = 1;
    if_sethide(false, cruc_battle_overlay:dropdown_list_layer);
    if_set2dangle(32768, cruc_battle_overlay:dropdown_arrow);
} else {
    %cruc_overlay_sh_state = 0;
    if_sethide(true, cruc_battle_overlay:dropdown_list_layer);
    if_set2dangle(0, cruc_battle_overlay:dropdown_arrow);
}
