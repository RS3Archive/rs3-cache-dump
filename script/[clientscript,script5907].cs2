// 5907
[clientscript,script5907](int $int0)
switch_int ($int0) {
    case default :
        ~rs3_background_panel(bugreport_interface:text_background, rs3tli_3x3_button_on_2);
        ~rs3_background_panel(bugreport_interface:text_background_repro, rs3tli_3x3_button_on_2);
    case 1 :
        ~rs3_background_panel(bugreport_interface:text_background, rs3tli_3x3_button_over_2);
        ~rs3_background_panel(bugreport_interface:text_background_repro, rs3tli_3x3_button_on_2);
    case 2 :
        ~rs3_background_panel(bugreport_interface:text_background, rs3tli_3x3_button_on_2);
        ~rs3_background_panel(bugreport_interface:text_background_repro, rs3tli_3x3_button_over_2);
}
