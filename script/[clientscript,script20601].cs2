// 20601
[clientscript,script20601](component $component0, int $int1, int $int2, int $int3)
if ($int1 = 1) {
    if (cc_find($component0, $int2) = true) {
        cc_sethide(true);
    }
    if (cc_find($component0, $int3) = true) {
        cc_sethide(false);
    }
} else {
    if (cc_find($component0, $int2) = true) {
        cc_sethide(false);
