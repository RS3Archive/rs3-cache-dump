// 13255
[proc,script13255](int $int0, component $component1)(boolean)
switch_int ($int0) {
    case 0 :
        if_setgraphic(rs3_icon_worldmap_key_rare_tree, $component1);
    case 1 :
        if_setgraphic(rs3_icon_worldmap_key_fishing_spot, $component1);
    case 2 :
        if_setgraphic(rs3_icon_worldmap_key_hunter_tutor, $component1);
    case 3 :
        if_setgraphic(rs3_icon_worldmap_key_mining_site, $component1);
    case 4 :
        if_setgraphic(rs3_icon_worldmap_key_farming_patch, $component1);
    case 5 :
        if_setgraphic(rs3_icon_worldmap_key_wisp_colony, $component1);
}
if_sethide(false, $component1);
if_sethide(true, elrc:resources_text);
