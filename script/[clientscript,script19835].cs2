// 19835
[clientscript,script19835](int $int0)
switch_int ($int0) {
    case 58412 :
        mes("Quick access to the central Sarcophagus during the Barrows encounter.<br>");
        mes(~script19838(5));
        mes(~script19839(1));
        mes(~script19840(5));
    case 58413 :
        mes("You no longer require kill count for all God Wars Dungeon encounters (excludes Nex).<br>");
        mes("Your kill count requirement for all God Wars Dungeon 2 encounters is reduced by <tostring(50)>%. This stacks additively with any reputation rewards from the Heart of Gielinor.<br>");
        mes("Your Sign of Life cooldown is reduced by 50%.<br>");
        mes(~script19838(10));
        mes(~script19839(2));
        mes(~script19840(10));
    case 58414 :
        mes(~script19837("Barrows: Rise of the Six"));
        mes(~script19837("Araxxor"));
        mes("War's Grimoire will now allow you to change your prayer book.<br>");
        mes(~script19838(25));
        mes(~script19840(25));
        mes(~script19841(500));
    case 58415 :
        mes(~script19837("Vorago"));
        mes("Adrenaline gain from Adrenaline Crystals is increased to 100% per action.<br>");
        mes(~script19836(1, combat_mastery_incomplete_costless_ancient_weapon_gizmo));
        mes(~script19836(1, combat_mastery_incomplete_costless_ancient_armour_gizmo));
        mes(~script19838(100));
        mes(~script19840(50));
        mes(~script19841(1000));
