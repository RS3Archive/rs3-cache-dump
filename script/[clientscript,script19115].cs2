[clientscript,script19115]
switch_int (map_lang) {
    case 0 :
        if_setgraphic(trh199_claim_button_over_en, trh199_overlay:claim_rewards_graphic);
    case 1 :
        if_setgraphic(trh199_claim_button_over_de, trh199_overlay:claim_rewards_graphic);
    case 2 :
        if_setgraphic(trh199_claim_button_over_fr, trh199_overlay:claim_rewards_graphic);
    case 3 :
        if_setgraphic(trh199_claim_button_over_pt, trh199_overlay:claim_rewards_graphic);
}
