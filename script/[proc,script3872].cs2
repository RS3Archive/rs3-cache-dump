// 3872
[proc,script3872]()(string)
def_int $int0 = calc(~date_runeday - 7847);
if (calc($int0 % 7) ! 0) {
    return("Thalmund has left the City of Um smithy and will return on Wednesday.");
} else {
    if (%necro_hub_thalmund_slot_1_max > 0 | %necro_hub_thalmund_slot_2_max > 0 | %necro_hub_thalmund_slot_3_max > 0 | %necro_hub_thalmund_slot_4_max > 0) {
        if (%necro_hub_thalmund_slot_1_bought >= %necro_hub_thalmund_slot_1_max & %necro_hub_thalmund_slot_2_bought >= %necro_hub_thalmund_slot_2_max & %necro_hub_thalmund_slot_3_bought >= %necro_hub_thalmund_slot_3_max & %necro_hub_thalmund_slot_4_bought >= %necro_hub_thalmund_slot_4_max) {
            return("You have purchased all of Thalmund's wares this week.");
        } else {
            return("You have viewed Thalmund's wares this week.");
        }
    }
    return("Thalmund has arrived by the City of Um smithy, with a variety of wares for sale!");
}
