[clientscript,script7840]
def_int $int0 = 0;
def_string $string0 = "";
$int0, $string0 = create_suggest_name_reply;
switch_int ($int0) {
    case -3 :
        return;
    case 2 :
        %create_displayname = $string0;
        if_settext(%create_displayname, acc_create_name:name_input_text);
