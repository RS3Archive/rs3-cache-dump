// 10005
[proc,script10005](obj $obj0, int $int1)(int)
def_int $int2 = 0;
switch_int ($int1) {
    case 3 :
        $int2 = oc_param($obj0, magic_strength);
    case 1 :
        $int2 = oc_param($obj0, melee_strength);
    case 2 :
        $int2 = oc_param($obj0, ranged_strength);
    case 7 :
        $int2 = oc_param($obj0, necromancy_strength);
}
return($int2);
