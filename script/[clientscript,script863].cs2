// 863
[clientscript,script863]
if (%csi_gather_evid_1 = 1 & %csi_gather_fing_fakeout = 0) {
    if_setmodel(enum(int, model, csi_get_finger_model_culprit, %csi_gather_fing_culp), csi_fingerprint:fingerprint_magnified);
    if_sethide(true, csi_fingerprint:confirm_layer);
    if (%csi_gather_fing_select ! 0) {
        if_sethide(false, csi_fingerprint:selected);
    }
    if (%csi_gather_fing_select = 1) {
        if_setposition(30, 205, ^setpos_abs_left, ^setpos_abs_top, csi_fingerprint:selected);
    } else if (%csi_gather_fing_select = 2) {
        if_setposition(112, 205, ^setpos_abs_left, ^setpos_abs_top, csi_fingerprint:selected);
    } else if (%csi_gather_fing_select = 3) {
        if_setposition(196, 205, ^setpos_abs_left, ^setpos_abs_top, csi_fingerprint:selected);
    } else {
        if_sethide(true, csi_fingerprint:selected);
    }
} else {
    if_setmodel(null, csi_fingerprint:fingerprint_magnified);
}
