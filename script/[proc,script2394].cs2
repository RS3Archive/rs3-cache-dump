// 2394
[proc,script2394](component $component0)
def_string $string0 = "Join a Friends chat channel";
if (clan_getchatcount > 0) {
    if_setop(1, "Leave chat", interface_1927:com_11);
    if_setgraphic("aif_clanchat_icons,12", interface_1927:com_12);
    $string0 = "Leave the Friends chat channel";
} else {
    if_setop(1, "Join chat", interface_1927:com_11);
    if_setgraphic("aif_clanchat_icons,13", interface_1927:com_12);
}
if_setonmouserepeat("script8799($string0, event_com, event_comsubid)", interface_1927:com_11);
