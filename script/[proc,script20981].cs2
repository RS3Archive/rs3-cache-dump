[proc,script20981](dbrow $dbrow0)(boolean)
switch_int (-1) {
    case -1 :
        return(false);
    case 1 :
        return(db_getfield($dbrow0, dbtable_334:col1, 0));
    case 2 :
        return(db_getfield($dbrow0, dbtable_334:col2, 0));
    case default :
        ~error("League <tostring(-1)> has not been plugged in to task validation.");
