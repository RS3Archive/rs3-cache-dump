// 5373
[proc,script5373](component $component0, int $int1)
if ($int1 = -1) {
    sound_vorbis_volume(agidad_hi_lo_click, 45, 0, 100);
    if_setontimer("script5369($component0)", $component0);
} else {
    if_setontimer(null, $component0);
    if ($int1 = -2) {
        if_settext("-", $component0);
    } else {
        if_settext(tostring($int1), $component0);
    }
}
