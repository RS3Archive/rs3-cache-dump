// 5901
[clientscript,script5901](component $component0)
switch_component ($component0) {
    case report_choices_category_v2:text_audio :
        %bugtrack_main_category = 1;
    case report_choices_category_v2:graphical :
        %bugtrack_main_category = 2;
    case report_choices_category_v2:gameplay :
        %bugtrack_main_category = 3;
    case report_choices_category_v2:billing_issue :
        %bugtrack_main_category = 4;
    case report_choices_category_v2:lost_items :
        %bugtrack_main_category = 5;
    case report_choices_category_v2:technical :
        %bugtrack_main_category = 6;
}
~script5902;
