// 5607
[clientscript,script5607]
if_settext("<tostring(%xmas11_frumscone_score_client)> - <tostring(%xmas11_grayzag_score_client)>", xmas11_snowman_score_overlay:xmas11_score);
if (%xmas11_grayzag_state = true) {
    if_settext("Whitezag", xmas11_snowman_score_overlay:xmas11_grayzag);
} else {
    if_settext("Grayzag", xmas11_snowman_score_overlay:xmas11_grayzag);
}
