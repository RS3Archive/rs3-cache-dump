// 21264
[clientscript,script21264](component $component0, int $int1)
if_setonclick("script20610(1, $int1)", $component0);
switch_int ($int1) {
    case 1 :
        if_settext("Bonus XP Table", $component0);
    case 2 :
        if_settext("Learn more", $component0);
    case default :
        if_settext("Bonus XP Table", $component0);
}
