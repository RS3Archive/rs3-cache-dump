// 1485
[clientscript,script1485](component $component0, int $int1, int $int2, int $int3, int $int4, int $int5)
if (%trail_shufflepattern = 0) {
    return;
}
if (if_find($component0) = true) {
    if (~trail_rune($int1, $int2, $int3) = ~trail_rune($int1, $int4, $int5)) {
        if_setgraphic("trail_knot_junction,1", $component0);
        if_setcolour(0x8dff6a, $component0);
    } else {
        if_setgraphic("trail_knot_junction,0", $component0);
        if_setcolour(0xcc0000, $component0);
    }
}
