// 7335
[clientscript,script7335](component $component0, int $int1, int $int2)
switch_component ($component0) {
    case pop_hud_side:ship_info_1 :
        if ($int1 = 1) {
            if_setgraphic("aif_pop_ship_icons,1", pop_hud_side:ship_icon_1);
        } else {
            if_setgraphic("aif_pop_ship_icons,0", pop_hud_side:ship_icon_1);
        }
    case pop_hud_side:ship_info_2 :
        if ($int1 = 1) {
            if_setgraphic("aif_pop_ship_icons,1", pop_hud_side:ship_icon_2);
        } else {
            if_setgraphic("aif_pop_ship_icons,0", pop_hud_side:ship_icon_2);
        }
    case pop_hud_side:ship_info_3 :
        if ($int1 = 1) {
            if_setgraphic("aif_pop_ship_icons,1", pop_hud_side:ship_icon_3);
        } else {
            if_setgraphic("aif_pop_ship_icons,0", pop_hud_side:ship_icon_3);
        }
    case pop_hud_side:ship_info_4 :
        if ($int1 = 1) {
            if_setgraphic("aif_pop_ship_icons,1", pop_hud_side:ship_icon_4);
        } else {
            if_setgraphic("aif_pop_ship_icons,0", pop_hud_side:ship_icon_4);
        }
}
