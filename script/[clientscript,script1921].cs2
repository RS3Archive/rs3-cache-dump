// 1921
[clientscript,script1921]
if (%sc_lobby_clan_size > 0) {
    if_settext(append(append_num(append(%sc_lobby_clan_leader, " ("), %sc_lobby_clan_size), ")"), sc_lobby_clan_overlay:clan_leader_text);
} else {
    if_settext(%sc_lobby_clan_leader, sc_lobby_clan_overlay:clan_leader_text);
}
if (%sc_lobby_ally_size_1 > 0) {
    if_settext(append(append_num(append(%sc_lobby_ally_leader_1, " ("), %sc_lobby_ally_size_1), ")"), sc_lobby_clan_overlay:ally_1_text);
} else {
    if_settext(%sc_lobby_ally_leader_1, sc_lobby_clan_overlay:ally_1_text);
}
if (%sc_lobby_ally_size_2 > 0) {
    if_settext(append(append_num(append(%sc_lobby_ally_leader_2, " ("), %sc_lobby_ally_size_2), ")"), sc_lobby_clan_overlay:ally_2_text);
} else {
    if_settext(%sc_lobby_ally_leader_2, sc_lobby_clan_overlay:ally_2_text);
}
