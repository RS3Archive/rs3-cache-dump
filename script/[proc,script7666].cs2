// 7666
[proc,script7666](int $int0, component $component1)
if (~is_mobile_client = true) {
    return;
}
def_string $string0 = "";
def_int $int2 = 0;
def_int $int3 = 0;
if ($int0 = 1) {
    if (calc(string_length(removetags(%bugreport_input)) + 1) > 500) {
        return;
    }
    $int2, $int3 = if_getcharposatindex(string_length(%bugreport_input), $component1);
    if ($int3 > if_getheight($component1)) {
        return;
    }
    $string0 = substring(%bugreport_input, %bugreport_caret, string_length(%bugreport_input));
    %bugreport_input = substring(%bugreport_input, 0, %bugreport_caret);
    %bugreport_input = append(%bugreport_input, "<br>");
    %bugreport_input = append(%bugreport_input, $string0);
    %bugreport_caret = calc(%bugreport_caret + 4);
    if_settext(%bugreport_input, $component1);
    ~script7671(bugreport_interface:input_text, bugreport_interface:input_caret, %bugreport_input);
    if_settext(tostring(calc(500 - string_length(removetags(%bugreport_input)))), bugreport_interface:chars_left);
    return;
} else if ($int0 = 2) {
    if (calc(string_length(removetags(%bugreport_repro)) + 1) > 500) {
