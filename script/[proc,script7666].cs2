    }
    $int2, $int3 = if_getcharposatindex(string_length(%bugreport_repro), $component1);
    if ($int3 > if_getheight($component1)) {
        return;
    }
    $string0 = substring(%bugreport_repro, %bugreport_caret_repro, string_length(%bugreport_repro));
    %bugreport_repro = substring(%bugreport_repro, 0, %bugreport_caret_repro);
    %bugreport_repro = append(%bugreport_repro, "<br>");
    %bugreport_repro = append(%bugreport_repro, $string0);
    %bugreport_caret_repro = calc(%bugreport_caret_repro + 4);
    if_settext(%bugreport_repro, $component1);
    ~script7671(bugreport_interface:input_repro, bugreport_interface:repro_caret, %bugreport_repro);
    if_settext(tostring(calc(500 - string_length(removetags(%bugreport_repro)))), bugreport_interface:chars_repro);
    return;
} else {
    return;
}
