// 9258
[clientscript,lore_bank_confirm_drop](obj $obj0, string $string0, string $string1, string $string2)
if ($obj0 = null) {
    if_resume_pausebutton(lore_bank:cancel_drop_button);
    if_sethide(true, lore_bank:confirm_drop_item_layer);
    return;
}
if_sethide(false, lore_bank:confirm_drop_item_layer);
if_setobject_nonum($obj0, 100, lore_bank:confirm_drop_graphic);
if_settext($string1, lore_bank:confirm_drop_text);
if_settext($string2, lore_bank:positive_button_text);
