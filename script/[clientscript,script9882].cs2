// 9882
[clientscript,script9882](component $component0, int $int1)
def_int $int2 = 0;
if ($int1 = %combatv2_barb_assault_stance) {
    $int2 = 1;
}
if ($int2 = 1) {
    if_setgraphic("combatboxes_large,1", $component0);
} else {
    if_setgraphic("combatboxes_large,0", $component0);
}
if_setonmouseover("script9881($component0, $int2, 1)", $component0);
if_setonmouseleave("script9881($component0, $int2, 0)", $component0);
