// 8808
[proc,script8808]
def_component $component0 = ~script10075;
def_component $component1 = ~script10076;
if_setontimer(null, $component0);
if_setparam_int(toplevel_v2_tooltip_type, -1, $component1);
if (if_hassub($component0) = true | %tooltip_built = 1) {
    if_closesubclient($component0);
    %tooltip_built = 0;
    ~tooltip_time_reset(25);
}
if_sethide(true, toplevel_v2:tooltips_ragdoll_layer);
