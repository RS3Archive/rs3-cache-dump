// 19567
[proc,script19567](inv $inv0)(component)
switch_inv ($inv0) {
    case default :
        return(group_ironman_storage:all);
    case group_ironman_storage_player_inv_temp :
        return(group_ironman_storage:inventory_click);
    case group_ironman_storage_clan_temp :
        return(group_ironman_storage:clan_inv);
}
