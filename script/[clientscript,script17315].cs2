// 17315
[clientscript,script17315](component $component0, int $int1, int $int2, string $string0)
if ($int1 <= 0) {
    ~script17317($int2, $string0);
    if ($component0 = trh192_overlay:character_model) {
        %trh192_character_firing_animation_occuring = 0;
        if_setnpcmodel(~script17310(0), trh192_overlay:character_model);
        if_setmodelanim(trh192_looting_range_idle, $component0);
    }
    if_setontimer(null, $component0);
    %trh192_trueshot_firing = 0;
} else {
    if_setontimer("script17315($component0, calc($int1 - 1), $int2, $string0)", $component0);
}
