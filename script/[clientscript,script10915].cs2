// 10915
[clientscript,script10915](int $int0)
if (%thedrop_player_count_client > $int0) {
    if_setcolour(0xf03232, thedrop:survivor_number);
    if_settext(tostring(--%thedrop_player_count_client), thedrop:survivor_number);
} else if (%thedrop_player_count_client < $int0) {
    if_setcolour(0x32f032, thedrop:survivor_number);
    if_settext(tostring(++%thedrop_player_count_client), thedrop:survivor_number);
} else {
    if_setcolour(0xf0dcb4, thedrop:survivor_number);
    if_settext(tostring(%thedrop_player_count_client), thedrop:survivor_number);
    if_setontimer(null, thedrop:survivor_number);
}
