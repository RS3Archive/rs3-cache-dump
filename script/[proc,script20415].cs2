[proc,script20415]
if_settext("Winter Weeks", christmas_hub:winter_weeks_title);
if_settext("Enjoy a new host of buffs each week over the festive period!<br>Each week's buffs run from 00:00 Monday, to 23:59 Sunday game time.", christmas_hub:winter_weeks_description);
