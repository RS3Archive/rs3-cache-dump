if_settext("8th - 14th December", christmas_hub:winter_weeks_button_2_date);
if_settext("Week 3 - Skilling", christmas_hub:winter_weeks_button_3_title);
if_settext("15th - 21st December", christmas_hub:winter_weeks_button_3_date);
if_settext("Week 4 - Combat", christmas_hub:winter_weeks_button_4_title);
if_settext("22nd - 28th December", christmas_hub:winter_weeks_button_4_date);
if_settext("Week 5 - Activities", christmas_hub:winter_weeks_button_5_title);
if_settext("29th - 4th January", christmas_hub:winter_weeks_button_5_date);
~script20417;
