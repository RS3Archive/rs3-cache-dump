// 1804
[clientscript,clanwars_setup_magictooltip](component $component0, int $int1)
if (map_members = true) {
    ~script8800("You may choose:<br>- Allow all spells<br>- Standard spellbook only<br>- Bind/Snare/Entangle only<br>- No Magic", $component0, $int1);
} else {
    ~script8800("You may choose:<br>- Standard spellbook<br>- Bind only<br>- No Magic", $component0, $int1);
}
