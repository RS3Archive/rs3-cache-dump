// 16578
[proc,script16578]()(int, int)
def_int $int0 = cc_getx;
def_int $int1 = cc_gety;
def_component $component2 = cc_getparentlayer;
while (cc_find_parent = true) {
    if (cc_getid ! -1) {
        $int0 = calc($int0 + (cc_getx - cc_getscrollx));
        $int1 = calc($int1 + (cc_gety - cc_getscrolly));
    }
}
while (if_getparentlayer($component2) ! null) {
    $int0 = calc($int0 + (if_getx($component2) - if_getscrollx($component2)));
    $int1 = calc($int1 + (if_gety($component2) - if_getscrolly($component2)));
    $component2 = if_getparentlayer($component2);
}
return($int0, $int1);
