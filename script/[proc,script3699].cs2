// 3699
[proc,script3699]
def_int $int0 = 0;
if (%crcs_agility_active = 1) {
    $int0 = %crcs_agility_score;
} else if (%crcs_ranged_active = 1) {
    $int0 = %crcs_ranged_score;
} else if (%crcs_magic_active = 1) {
    $int0 = %crcs_magic_score;
} else if (%crcs_thieving_active = 1) {
    $int0 = %crcs_thieving_score;
} else if (%fmc_circus_firebreath_active = 1) {
    $int0 = %crcs_firemaking_breath_score;
} else if (%fmc_circus_poi_active = 1) {
    $int0 = %crcs_firemaking_poi_score;
}
$int0 = calc($int0 + %crcs_emote_bonus);
if_settext(tostring($int0), crcs_info_overlay:points);
