[proc,script15652]
if (~is_mobile_client = false) {
    return;
}
if (if_gethide(interface_744:com_191) = false & %varclient_174 = 113) {
    if_setposition(0, 0, ^setpos_abs_centre, ^setpos_abs_top, interface_744:com_310);
    return;
}
