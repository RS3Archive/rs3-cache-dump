// 17412
[proc,trh194_update_background]
def_int $int0 = 0;
def_int $int1 = 0;
def_int $int2 = 0;
if_setgraphic(black_placeholder, wheel_of_fortune:background);
if_setsize(0, 0, ^setsize_minus, ^setsize_minus, wheel_of_fortune:background);
cc_deleteall(wheel_of_fortune:background_holder);
$int1, $int0 = $int0, calc($int0 + 1);
$int2 = 0;
~if_add_child_layer(wheel_of_fortune:background_holder, $int1, $int2++, 0, -45, ^setpos_abs_centre, ^setpos_abs_centre, 800, 600, ^setsize_abs, ^setsize_abs);
cc_sendtofront;
~cc_add_child_graphic_full($int1, $int2++, 0, 0, ^setpos_abs_left, ^setpos_abs_centre, 0, 0, ^setsize_minus, ^setsize_minus, trh194_background_snowy, false, false, false, 0);
