// 1445
[clientscript,6awe3_side_graphic](component $component0)
def_struct $struct1 = null;
switch_component ($component0) {
    case 6awe3_side:icon_1 :
        $struct1 = enum(int, struct, 6awe3_ability_to_struct, %6awe3_passive_ability);
    case 6awe3_side:icon_2 :
        $struct1 = enum(int, struct, 6awe3_ability_to_struct, %6awe3_active_ability1);
    case 6awe3_side:icon_3 :
        $struct1 = enum(int, struct, 6awe3_ability_to_struct, %6awe3_active_ability2);
}
if ($struct1 ! null) {
    if_setgraphic(struct_param($struct1, 6awe3_ability_graphic), $component0);
} else {
    if_setgraphic(null, $component0);
}
