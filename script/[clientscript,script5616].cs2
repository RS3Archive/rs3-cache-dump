// 5616
[clientscript,script5616]
if (%fmc_wave = 0) {
    if_setsize(0, if_getheight(fmc_wave_progress:bar_fill), ^setsize_abs, ^setsize_abs, fmc_wave_progress:bar_fill);
} else {
    switch_int (%fmc_wave) {
        case 1 :
            if_setontimer("script5617(calc(if_getwidth(fmc_wave_progress:filling) / 4))", fmc_wave_progress:filling);
        case 2 :
            if_setontimer("script5617(calc(if_getwidth(fmc_wave_progress:filling) / 2))", fmc_wave_progress:filling);
        case 3 :
            if_setontimer("script5617(calc(if_getwidth(fmc_wave_progress:filling) * 3 / 4))", fmc_wave_progress:filling);
        case 4 :
            if_setontimer("script5617(if_getwidth(fmc_wave_progress:filling))", fmc_wave_progress:filling);
    }
}
