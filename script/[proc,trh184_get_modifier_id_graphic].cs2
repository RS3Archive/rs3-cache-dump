// 16631
[proc,trh184_get_modifier_id_graphic](int $int0)(graphic)
if (%trh184_modifiers_generated = 0) {
    return(null);
}
switch_int ($int0) {
    case 0 :
        if (map_lang = 3) {
            return(trh184_bonus_icon_pt);
        } else {
            return(trh184_bonus_icon);
        }
    case 1 :
        return("trh109_icons,8");
    case 2 :
        return("trh109_icons,9");
    case 3 :
        return("trh109_icons,10");
    case 4 :
        return("trh109_icons,11");
    case 5 :
        return("trh109_icons,12");
    case 6 :
        return("trh109_icons,13");
    case 7 :
        return("trh109_icons,14");
    case default :
        ~error("No graphic specified for modifier <tostring($int0)> in trh184_get_modifier_id_graphic.");
}
return(null);
