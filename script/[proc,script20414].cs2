// 20414
[proc,script20414]
if_settext("Seasonal Quest: Cold Front", christmas_hub:event_overview_parchment_title_1);
if_settext("The Queen of Snow has arrived in the Christmas Village! Help her rediscover the joy of Christmas in this new seasonal quest.", christmas_hub:event_overview_parchment_text_1);
if_settext("Wrapping Paper", christmas_hub:event_overview_parchment_title_2);
if_settext("Exchange your Wrapping Paper for festive presents to earn both classic and brand-new rewards!", christmas_hub:event_overview_parchment_text_2);
if_settext("Christmas Spirit Shop", christmas_hub:event_overview_parchment_title_3);
if_settext("Earn Christmas spirit as you play and complete seasonal activities in the Land of Snow. Spend your Christmas spirit in the Christmas Spirit Shop to earn classic holiday rewards.", christmas_hub:event_overview_parchment_text_3);
if_settext("Rewards", christmas_hub:event_overview_parchment_title_4);
if_settext("Santa's Lodge", christmas_hub:event_overview_info_title);
if_settext("Secure a spot on Santa's Nice List and join him in his lodge to obtain unique cosmetic rewards each week, including a chance at the Black Partyhat.<br><br>Visit Santa himself from 8pm to 10pm game time each Sunday until the 28th December.", christmas_hub:event_overview_info_text);
if_setobject(black_partyhat, 1, christmas_hub:event_overview_parchment_reward_1);
def_string $string0 = "Black Partyhat - Santa's Lodge";
if_setobject(xmas25_blue_santahat, 1, christmas_hub:event_overview_parchment_reward_2);
def_string $string1 = "Blue Santa hat - Wrapping paper";
if_setobject(xmas25_christmas_jumper_snowman, 1, christmas_hub:event_overview_parchment_reward_3);
def_string $string2 = "Christmas jumper (Snowman) - Christmas Spirit Shop";
if_setobject(xmas25_christmas_jumper_snow_imp, 1, christmas_hub:event_overview_parchment_reward_4);
def_string $string3 = "Christmas jumper (Snow imp) - Christmas Spirit Shop";
if_setobject(xmas25_snowman_slippers, 1, christmas_hub:event_overview_parchment_reward_5);
def_string $string4 = "Snowman Slippers - Cold Front seasonal quest";
if (~script6431 = true) {
    if_setonclick("script7774($string0, christmas_hub:event_overview_parchment_reward_1, -1, 0)", christmas_hub:event_overview_parchment_reward_1);
    if_setonclick("script7774($string1, christmas_hub:event_overview_parchment_reward_2, -1, 0)", christmas_hub:event_overview_parchment_reward_2);
    if_setonclick("script7774($string2, christmas_hub:event_overview_parchment_reward_3, -1, 0)", christmas_hub:event_overview_parchment_reward_3);
    if_setonclick("script7774($string3, christmas_hub:event_overview_parchment_reward_4, -1, 0)", christmas_hub:event_overview_parchment_reward_4);
    if_setonclick("script7774($string4, christmas_hub:event_overview_parchment_reward_5, -1, 0)", christmas_hub:event_overview_parchment_reward_5);
} else {
    if_setonmouserepeat("script3876($string0, christmas_hub:event_overview_parchment_reward_1, -1)", christmas_hub:event_overview_parchment_reward_1);
    if_setonmouserepeat("script3876($string1, christmas_hub:event_overview_parchment_reward_2, -1)", christmas_hub:event_overview_parchment_reward_2);
    if_setonmouserepeat("script3876($string2, christmas_hub:event_overview_parchment_reward_3, -1)", christmas_hub:event_overview_parchment_reward_3);
    if_setonmouserepeat("script3876($string3, christmas_hub:event_overview_parchment_reward_4, -1)", christmas_hub:event_overview_parchment_reward_4);
    if_setonmouserepeat("script3876($string4, christmas_hub:event_overview_parchment_reward_5, -1)", christmas_hub:event_overview_parchment_reward_5);
}
