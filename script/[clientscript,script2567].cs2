// 2567
[clientscript,script2567]
def_int $int0 = 0;
def_int $int1 = 0;
def_int $int2 = 0;
def_int $int3 = 0;
def_enum $enum4 = null;
def_int $int5 = 5;
$int1 = calc((if_getwidth(mob_rewards_quest_kit:content) - 36 * $int5) / ($int5 - 1));
$int2 = calc((if_getheight(mob_rewards_quest_kit:content) - 128) / 3);
if (inv_total(inv, mob_quest_kit_low) > 0) {
    $enum4 = mob_quest_kit_objects_low;
} else if (inv_total(inv, mob_quest_kit_med) > 0) {
    $enum4 = mob_quest_kit_objects_med;
} else if (inv_total(inv, mob_quest_kit_high) > 0) {
    $enum4 = mob_quest_kit_objects_high;
} else if (inv_total(inv, mob_quest_kit_elite) > 0) {
    $enum4 = mob_quest_kit_objects_elite;
