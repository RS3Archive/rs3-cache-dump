while ($int3 = 0) {
    if (enum(int, obj, $enum4, $int0) ! logs) {
        cc_create(mob_rewards_quest_kit:content, ^iftype_graphic, $int0);
        cc_setsize(36, 32, ^setsize_abs, ^setsize_abs);
        cc_setposition(calc((36 + $int1) * ($int0 % $int5)), calc($int0 / $int5 * (32 + $int2)), ^setpos_abs_left, ^setpos_abs_top);
        cc_setobject(enum(int, obj, $enum4, $int0), -1);
        cc_setopbase("<col=FF981F><oc_name(enum(int, obj, $enum4, $int0))>");
        cc_setop(1, "Withdraw");
