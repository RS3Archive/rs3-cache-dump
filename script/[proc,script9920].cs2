// 9920
[proc,script9920](int $int0, int $int1)
switch_int ($int0) {
    case 0 :
        %chat_alert_game = $int1;
    case 1 :
        %chat_alert_public = $int1;
    case 2 :
        %chat_alert_private = $int1;
    case 4 :
        %chat_alert_clan = $int1;
    case 3 :
        %chat_alert_friendschat = $int1;
    case 5 :
        %chat_alert_otherclan = $int1;
    case 6 :
        %chat_alert_trade = $int1;
    case 15 :
        %chat_alert_group = $int1;
    case 16 :
        %chat_alert_group_ironman = $int1;
}
if (calc($int1 % 25) = 0) {
    ~script8492(18);
}
