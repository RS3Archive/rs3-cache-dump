// 20231
[proc,script20231]
def_int $int0 = cc_getwidth;
def_int $int1 = 0;
def_int $int2 = 4;
def_int $int3 = 0;
$int1, $int2 = ~script19613(0, $int1, $int2, $int0, "Final Confirmation");
cc_settextalign(^settextalign_centre, ^settextalign_centre, 0);
if (%league_onboarding_step = 2 | %league_onboarding_step = 4) {
    $int3 = 54;
    if (%league_onboarding_name_status = 0) {
        $int1, $int2 = ~script19615(0, $int1, $int2, $int0, "Rewards may be imported only by '<col=FFFFFF><%league_onboarding_link_displayname_current_varc></col>'.");
        cc_settextalign(^settextalign_centre, ^settextalign_centre, 0);
    } else {
        $int1, $int2 = ~script19615(0, $int1, $int2, $int0, " ");
    }
} else if (string_indexof_string(chat_playername, "#", 0) = -1) {
    $int1, $int2 = ~script19615(0, $int1, $int2, $int0, "Rewards may be imported only by 'this character'.");
    cc_settextalign(^settextalign_centre, ^settextalign_centre, 0);
} else {
    $int1, $int2 = ~script19615(0, $int1, $int2, $int0, "Rewards may be imported only by '<col=FFFFFF><chat_playername></col>'.");
    cc_settextalign(^settextalign_centre, ^settextalign_centre, 0);
}
$int1, $int2 = ~script20338(0, $int1, $int2, $int0, "This decision can NOT be reversed after this point.", notosans_13, ^white, ^settextalign_centre, ^settextalign_centre);
~script20232(calc($int2 + 4), $int3);
