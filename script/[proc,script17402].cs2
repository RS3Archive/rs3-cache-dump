// 17402
[proc,script17402](inv $inv0, inv $inv1)(long)
if ($inv0 = null) {
    return(-1);
}
def_int $int2 = inv_total($inv0, coins_b);
def_int $int3 = inv_total($inv0, coins);
def_long $long0 = calc(1000000000 * int_to_long($int2) + int_to_long($int3));
if ($inv1 = null) {
    return($long0);
}
return(calc($long0 + int_to_long(inv_total($inv1, coins))));
