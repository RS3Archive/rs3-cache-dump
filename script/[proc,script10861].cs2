[proc,script10861](int $int0)(boolean)
switch_int ($int0) {
    case 1 :
        if (%atelf_easy_reward = 1) {
            return(true);
        }
    case 2 :
        if (%atelf_easy_reward = 1 & %atelf_med_reward = 1) {
            return(true);
        }
    case 3 :
        if (%atelf_easy_reward = 1 & %atelf_med_reward = 1 & %atelf_hard_reward = 1) {
            return(true);
        }
    case 4 :
        if (%atelf_easy_reward = 1 & %atelf_med_reward = 1 & %atelf_hard_reward = 1 & %atelf_elite_reward = 1) {
            return(true);
        }
}
return(false);
