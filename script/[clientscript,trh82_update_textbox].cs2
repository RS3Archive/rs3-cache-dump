// 12213
[clientscript,trh82_update_textbox](int $int0)
if ($int0 > inv_total(inv, trh82_valentines_currency)) {
    $int0 = inv_total(inv, trh82_valentines_currency);
}
if ($int0 > 2500) {
    $int0 = 2500;
}
if (calc($int0 + %trh82_currency) > 2500) {
    $int0 = calc(2500 - %trh82_currency);
}
if_settext(tostring_localised($int0, true), trh82_valentines:text_input_display);
if ($int0 > 0) {
    if_sethide(true, trh82_valentines:accept_button_disabled_layer_accept);
} else {
    if_sethide(false, trh82_valentines:accept_button_disabled_layer_accept);
}
