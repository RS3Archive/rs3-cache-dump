// 4704
[clientscript,login_transfer_reply]
def_int $int0 = 0;
def_int $int1 = 0;
def_int $int2 = -1;
$int0, $int1, $int2 = login_last_transfer_reply;
switch_int ($int0) {
    case 0 :
    case 1 :
    case 2 :
    case 3 :
        mes("Your password has been updated. Please leave the world and log in again.");
    case 4 :
        mes("Your account has been involved in serious rule breaking. Check your Message Centre for details.");
    case 5 :
        mes("Your account has not logged out from its last session or the server is too busy to handle your request. Please try again in a few minutes or try a different server.");
    case 6 :
        if (~is_mobile_client = true) {
            mes("RuneScape has been updated! Please restart the app to retry.");
        } else {
            mes("RuneScape has been updated! Please restart the game to retry.");
        }
    case 7 :
        mes("This world is full. Please try back later.");
    case 8 :
        mes("Unable to connect: login server offline.");
    case 9 :
        mes("Login limit exceeded: too many connections from your address.");
    case 10 :
        mes("Unable to connect: bad session id.");
    case 11 :
        mes("Your password is an extremely common choice, and is not secure. You must change it.");
    case 12 :
        mes("You need a member's account to log in to this world.");
    case 13 :
        mes("Could not complete login. Please try back later.");
    case 14 :
        mes("The server is being updated. Please wait a few minutes and try again.");
        if (~is_mobile_client = true) {
            mes("RuneScape is currently updating. Please wait a few minutes and restart the app to retry.");
        } else {
            mes("RuneScape is currently updating. Please wait a few minutes and restart the game to retry.");
        }
    case 15 :
    case 16 :
        mes("Too many logins from your address. Please wait 5 minutes before trying again.");
    case 17 :
        mes("You are standing in a members-only area. To play on this world, move to a free area first.");
    case 18 :
        mes("Your account has been locked due to suspicious activity. Please recover your account.");
    case 19 :
        mes("Fullscreen is currently a members-only feature. To log in, either exit fullscreen via the options menu or use a member's account.");
    case 20 :
        mes("Invalid loginserver requested. Please try back later.");
    case 21 :
    case 22 :
        mes("Sorry, we had trouble logging you in. Please try again.");
    case 23 :
        mes("No reply from login server. Please wait a minute and try again.");
    case 24 :
        mes("Error loading your profile. Please contact customer support.");
    case 25 :
        mes("Unexpected loginserver response. Please try back later.");
    case 26 :
        mes("This computer's address has been blocked, as it was used to break our rules.");
    case 27 :
        mes("Service unavailable.");
    case 28 :
    case 29 :
        switch_int ($int1) {
            case 0 :
                mes("You must have a Combat Level of at least 20 (not including Summoning) to enter a Bounty Hunter world.");
            case 1 :
                mes("You are currently carrying lent items and cannot enter a PvP world.");
            case 2 :
                mes("You must be standing in the Wilderness or Edgeville to enter this bounty world.");
            case 3 :
                mes("You must have a total skill level of 1,000 or greater to enter this world.");
            case 5 :
                mes("You must have a total skill level of 1,500 or greater to enter this world.");
            case 6 :
                mes("You must have a total skill level of 2,000 or greater to enter this world.");
            case 7 :
                mes("You must have a total skill level of 2,600 or greater to enter this world.");
            case 4 :
                mes("You must move to a safe area before you can log in to a Bounty Hunter world.");
            case 9 :
                mes("This server is for staff only.");
            case 10 :
                mes("You cannot enter a Classic Mode world while in the tutorial.");
            case 13 :
                mes("You are standing in a members-only area. To play on this world, move to a free area first.");
            case 14 :
                mes("You need a member's account to log in to this world. Enter the lobby and opt into the open access weekend or subscribe to enter this world.");
            case 15 :
                mes("You can not login to a Classic Mode world on mobile.");
            case 17 :
                mes("Your account cannot currently log into this world. Please try another world.");
            case default :
                mes("Unexpected server response. Please try back later.");
        }
    case 30 :
        mes("This is not a member's account. Please choose a 'free' world from the website to play on this account.");
    case 31 :
    case 32 :
        mes("Your account has negative membership credit. Please log into the billing system to add credit to your account.");
    case 33 :
    case 34 :
    case 35 :
    case 36 :
    case 37, 62 :
        mes("Your account is currently inaccessible. Please try again in a few minutes.");
    case 38 :
    case 39 :
        mes("The instance you tried to join no longer exists. Please try back later.");
    case 40 :
        mes("You need a member's account to log in to this instance.");
    case 41 :
        mes("The instance you tried to join is full. Please try back later.");
    case 42 :
    case 43 :
    case 44 :
        mes("Our systems are currently unavailable. Please try again in a few minutes.");
    case 48 :
        if (~is_mobile_client = true) {
            mes("Your game session has now ended.<br><br>To play again, please close the app and wait 5 minutes before reloading it.");
        } else {
            mes("Your game session has now ended.<br><br>To play again, please close your browser tab/window and wait 5 minutes before reloading the game.");
        }
    case 45 :
        switch_int ($int2) {
            case 0 :
                switch_int ($int1) {
                    case 0 :
                        mes("You must be near the TzHaar Fight Pit entrance to enter a global match.");
                    case default :
                        mes("Unable to log in. Please try back later.");
                }
            case 1 :
                switch_int ($int1) {
                    case 1 :
                        mes("There was an error connecting to your meeting room. Please try again.");
                    case 2 :
                        mes("You need a higher rank to enter that private tent.");
                    case 3 :
                        mes("You need an invitation to enter that private room.");
                    case default :
                        mes("Unable to log in. Please try back later.");
                }
            case 4 :
                switch_int ($int1) {
                    case 1 :
                        mes("You need to clear some inventory space to enter a Flash Factory game.");
                    case 2 :
                        mes("You must dismiss your follower before entering a Flash Factory game.");
                }
            case 5 :
                switch_int ($int1) {
                    case 0 :
                        mes("The instance you attempted to join is full.");
                    case 1 :
                        mes("You can't join that instance as you or your follower are carrying items.");
                    case default :
                        mes("Unable to log in. Please try using a different world.");
                }
            case default :
                mes("Unable to log in. Please try back later.");
        }
    case 46 :
        mes("This instance is marked for deletion/rebuild. Please try again in a few minutes.");
    case 47, 51 :
        mes("You need to validate your email address to log in.");
    case 50 :
        mes("The Jagex Account Guardian is protecting this account.<br><br>This device is not recognised.<br><br>No new devices can be added for up to 24 hours as too many failed attempts to answer the security questions have been made.<br><br>During this time access will still be granted to any devices already trusted.");
    case 52 :
        mes("You need to validate this device to use with your account. Please follow the instructions in the window that will open shortly.");
    case 58 :
    case 59 :
    case 55 :
        mes("Sorry, but your account is not eligible to play.");
    case 60 :
        mes("Connection timed out. Please try again.");
    case 61 :
    case 1401 :
        mes("Single Sign on failed because your token has expired. Please try re-entering your login details.");
    case 1402 :
        mes("Single Sign on failed because you exited without signing in.");
    case 1403 :
        mes("Could not connect. Please check your internet connection or try again later.");
    case 1404 :
        mes("Single Sign on failed because your access is unauthorized. Please try re-entering your login details.");
    case 1405 :
        mes("Revoking token action unsuccessful.");
    case 1406 :
        mes("Single Sign on failed because your account creation was unsuccessful. Please ensure you have entered a valid date of birth.");
    case 1407 :
        mes("Single Sign on failed because you have a pending transaction.");
}
