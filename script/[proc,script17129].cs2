// 17129
[proc,script17129](int $int0)(int, string)
def_int $rgb1 = ^yellow;
def_string $string0 = "";
if ($int0 = 0) {
    $string0 = "Offline";
    $rgb1 = ^red;
} else {
    if ($int0 >= 1149 & $int0 < 1200) {
        $string0 = "Beta lobby";
    } else if ($int0 >= 1100) {
        $string0 = "Lobby <tostring(calc($int0 - 1099))>";
    } else if ($int0 >= 200 & $int0 < 210) {
        $string0 = "Beta <tostring($int0)>";
    } else {
        $string0 = "World <tostring($int0)>";
    }
    $rgb1 = ^yellow;
}
return($rgb1, $string0);
