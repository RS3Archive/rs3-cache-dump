// 11229
[proc,comscenario_tab_select](component $component0)
if_sethide(true, comscenario:all_tab_selected);
if_sethide(true, comscenario:combat_tab_selected);
if_sethide(true, comscenario:skilling_tab_selected);
if_sethide(true, comscenario:community_tab_selected);
switch_component ($component0) {
    case comscenario:all_tab_select :
        if_sethide(false, comscenario:all_tab_selected);
        ~script6499(0);
    case comscenario:combat_tab_select :
        if_sethide(false, comscenario:combat_tab_selected);
        ~script6499(1);
    case comscenario:skill_tab_select :
        if_sethide(false, comscenario:skilling_tab_selected);
        ~script6499(2);
    case comscenario:community_tab_select :
        if_sethide(false, comscenario:community_tab_selected);
        ~script6499(3);
}
