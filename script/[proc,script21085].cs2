// 21085
[proc,script21085](component $component0)
def_graphic $graphic1 = ~script20126;
def_graphic $graphic2 = ~script20919;
if_sethide(false, $component0);
if_setgraphic($graphic1, $component0);
if_setonmouseover("graphic_swapper(event_com, $graphic2)", $component0);
if_setonmouseleave("graphic_swapper(event_com, $graphic1)", $component0);
