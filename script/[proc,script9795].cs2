// 9795
[proc,script9795](struct $struct0, int $int1)(graphic)
def_graphic $graphic2 = null;
if (struct_param($struct0, rs3tli_icon_graphic_width) > 0) {
    switch_int ($int1) {
        case 1 :
            $graphic2 = struct_param($struct0, rs3tli_icon_graphic_on);
        case 2 :
            $graphic2 = struct_param($struct0, rs3tli_icon_graphic_over);
        case 3 :
            $graphic2 = struct_param($struct0, rs3tli_icon_graphic_hit);
        case 4 :
            $graphic2 = struct_param($struct0, rs3tli_icon_graphic_selected);
        case 5 :
            $graphic2 = struct_param($struct0, rs3tli_icon_graphic_disabled);
    }
    if ($graphic2 = null) {
        $graphic2 = struct_param($struct0, rs3tli_icon_graphic_on);
    }
    return($graphic2);
} else {
    return(struct_param($struct0, rs3tli_button_graphic));
}
