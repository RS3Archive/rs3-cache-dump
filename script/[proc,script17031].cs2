// 17031
[proc,script17031](dbrow $dbrow0)(int, int)
if (~script5759($dbrow0) = false) {
    return(0, 0);
}
def_int $int1 = 0;
switch_dbrow ($dbrow0) {
    case intern_notes_parent_adventure_calendar :
        return(%intern_notes_calendar, 0);
    case intern_notes_parent_adventure_challenge :
        if (%intern_notes_new_daily_challenges > 0) {
            $int1 = max(0, calc(%intern_notes_new_daily_challenges - %intern_notes_daily_challenges_complete));
        }
        return(calc($int1 + %intern_notes_daily_challenges_complete + %intern_notes_daily_challenge_weekly_rewards), 0);
    case intern_notes_challenge_claim_button :
