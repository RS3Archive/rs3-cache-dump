// 19796
[clientscript,script19796]
if (%trh205_prize_option_selected = 1) {
    if_setgraphic(trh205_select_panel_smart_rolloverselected, trh205_overlay:prize_select_preview_background_1);
    if_setgraphic(trh205_select_panel_goth_default, trh205_overlay:prize_select_preview_background_2);
} else {
    if_setgraphic(trh205_select_panel_smart_default, trh205_overlay:prize_select_preview_background_1);
    if_setgraphic(trh205_select_panel_goth_rolloverselected, trh205_overlay:prize_select_preview_background_2);
}
