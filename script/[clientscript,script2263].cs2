// 2263
[clientscript,script2263](component $component0, int $int1, int $int2)
switch_component ($component0) {
    case pop_voyage_list:voyage_select_ship_1, pop_voyage_list:voyage_select_ship_2, pop_voyage_list:voyage_select_ship_3, pop_voyage_list:voyage_select_ship_4 :
        if ($int1 = 1) {
            if ($int2 = %pop_voyage_list_ship) {
                if_setgraphic("aif_pop_ship_icons,2", $component0);
            } else {
                if_setgraphic("aif_pop_ship_icons,1", $component0);
            }
        } else if ($int2 = %pop_voyage_list_ship) {
            if_setgraphic("aif_pop_ship_icons,2", $component0);
        } else {
            if_setgraphic("aif_pop_ship_icons,0", $component0);
        }
}
