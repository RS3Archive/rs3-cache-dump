// 783
[clientscript,quickchat_tutorial_loadcontent]
if (%quickchat_tutorial_show ! %quickchat_tutorial_show_client) {
    %quickchat_tutorial_show_client = %quickchat_tutorial_show;
    if (~script6431 = true & %quickchat_tutorial_show = 1) {
        %quickchat_tutorial_show = 2;
    }
    if (%quickchat_tutorial_show = 1) {
        ~script1029(quickchat_tutorial_shortcuts, 9);
    } else if (%quickchat_tutorial_show = 2) {
        if (~script6431 = true) {
            ~quickchat_tutorial_showpage(quickchat_tutorial_guide_mobile, 0, 7);
        } else {
            ~quickchat_tutorial_showpage(quickchat_tutorial_guide, 0, 7);
        }
    } else if (%quickchat_tutorial_show = 3) {
        ~script1030(1485);
    }
}
