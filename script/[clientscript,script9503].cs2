// 9503
[clientscript,script9503](component $component0, int $int1, int $int2)
def_int $int3 = 0;
def_string $string0 = null;
switch_component ($component0) {
    case 6awe2_hud:armadyl_icon_1 :
        $int3 = %6awe2_armadyl_icon_1;
        if ($int3 = 1) {
