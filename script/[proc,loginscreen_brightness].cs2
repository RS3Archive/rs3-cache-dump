// 1185
[proc,loginscreen_brightness](component $component0, component $component1)
def_int $int2 = calc(if_getwidth($component0) - if_getwidth($component1));
def_int $int3 = 4;
def_int $int4 = clientoption_get(^clientoption_brightness);
if_setposition(calc($int4 * ($int2 / $int3)), 0, ^setpos_abs_left, ^setpos_abs_top, $component1);
if_setsize(calc(if_getx($component0) + if_getx($component1)), 0, ^setsize_abs, ^setsize_minus, graphics_options_v2_client:brightness_fill);
