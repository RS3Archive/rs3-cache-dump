// 5829
[clientscript,script5829]
if_settext(tostring(%6awe3_pvp_kill_count), 6awe3_score_board:myscore_kills_player);
if_settext(tostring(%6awe3_items_gathered), 6awe3_score_board:myscore_gathering_points);
if_settext(tostring(%6awe3_killed_weak), 6awe3_score_board:myscore_kills_monkey_weak);
if_settext(tostring(calc(%6awe3_games_played - %6awe3_all_waves_survived)), 6awe3_score_board:myscore_deaths_player);
if_settext(tostring(%6awe3_waves_survived), 6awe3_score_board:myscore_wave_points);
if_settext(~script9383(%6awe3_pvp_kill_count, %6awe3_pvp_death_count), 6awe3_score_board:myscore_ratio_player);
if_settext(tostring(%6awe3_all_waves_survived), 6awe3_score_board:myscore_game_points);
