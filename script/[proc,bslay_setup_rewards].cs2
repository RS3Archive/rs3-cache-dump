// 7381
[proc,bslay_setup_rewards]
if_sethide(true, bslay_shop:items);
if_sethide(true, bslay_shop:effects);
if_sethide(false, bslay_shop:rewards);
if_sethide(true, bslay_shop:items_tab_selected_layer);
if_sethide(true, bslay_shop:effects_tab_selected_layer);
if_sethide(false, bslay_shop:rewards_tab_selected_layer);
if_sethide(false, bslay_shop:scrollbar);
~rs3_scrollbar_vertical(bslay_shop:scrollbar, bslay_shop:rewards);
if (~script10165 = 1) {
    ~script7382(bslay_shop:title_lock_state);
}
if (~bslay_gloves_unlock = 1) {
    ~script7382(bslay_shop:gloves_lock_state);
}
if (~bslay_boots_unlock = 1) {
    ~script7382(bslay_shop:boots_lock_state);
}
if (~bslay_legs_unlock = 1) {
    ~script7382(bslay_shop:legs_lock_state);
}
if (~bslay_body_unlock = 1) {
    ~script7382(bslay_shop:chest_lock_state);
}
if (~bslay_hat_unlock = 1) {
    ~script7382(bslay_shop:head_lock_state);
}
if (~script10252 = 1) {
    ~script7382(bslay_shop:title2_lock_state);
}
if (~script11034 = 1) {
    ~script7382(bslay_shop:title3_lock_state);
}
if (~bslay_scythe_unlock = 1) {
    ~script7382(bslay_shop:scythe_lock_state);
}
if (~bslay_pet_unlock = 1) {
    ~script7382(bslay_shop:pet_lock_state);
}
