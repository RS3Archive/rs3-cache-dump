// 14010
[proc,script14010](component $component0, int $int1)
switch_int ($int1) {
    case 0 :
        if_setgraphic("combat_style_icon_melee,1", $component0);
    case 1 :
        if_setgraphic("combat_style_icon_ranged,1", $component0);
    case 2 :
        if_setgraphic("combat_style_icon_magic,1", $component0);
}
