// 5499
[proc,info_box_build]
~info_reset;
cc_create(info_box:mainlayer, ^iftype_graphic, 0);
cc_setposition(0, 0, ^setpos_abs_centre, ^setpos_abs_centre);
cc_setsize(20, 22, ^setsize_minus, ^setsize_minus);
cc_settiling(true);
cc_create(info_box:mainlayer, ^iftype_graphic, 1);
cc_setsize(10, 22, ^setsize_abs, ^setsize_minus);
cc_setposition(0, 0, ^setpos_abs_left, ^setpos_abs_centre);
cc_settiling(true);
cc_create(info_box:mainlayer, ^iftype_graphic, 2);
cc_setsize(10, 22, ^setsize_abs, ^setsize_minus);
cc_setposition(0, 0, ^setpos_abs_right, ^setpos_abs_centre);
cc_settiling(true);
cc_create(info_box:mainlayer, ^iftype_graphic, 3);
cc_setsize(20, 11, ^setsize_minus, ^setsize_abs);
cc_setposition(0, 0, ^setpos_abs_centre, ^setpos_abs_top);
cc_settiling(true);
cc_create(info_box:mainlayer, ^iftype_graphic, 4);
cc_setsize(20, 11, ^setsize_minus, ^setsize_abs);
cc_setposition(0, 0, ^setpos_abs_centre, ^setpos_abs_bottom);
cc_settiling(true);
cc_create(info_box:mainlayer, ^iftype_graphic, 5);
cc_setsize(10, 11, ^setsize_abs, ^setsize_abs);
cc_setposition(0, 0, ^setpos_abs_right, ^setpos_abs_top);
cc_create(info_box:mainlayer, ^iftype_graphic, 6);
cc_setsize(10, 11, ^setsize_abs, ^setsize_abs);
cc_setposition(0, 0, ^setpos_abs_left, ^setpos_abs_top);
cc_create(info_box:mainlayer, ^iftype_graphic, 7);
cc_setsize(10, 11, ^setsize_abs, ^setsize_abs);
cc_setposition(0, 0, ^setpos_abs_left, ^setpos_abs_bottom);
cc_create(info_box:mainlayer, ^iftype_graphic, 8);
cc_setsize(10, 11, ^setsize_abs, ^setsize_abs);
cc_setposition(0, 0, ^setpos_abs_right, ^setpos_abs_bottom);
cc_create(info_box:mainlayer, ^iftype_text, 9);
cc_setsize(20, 22, ^setsize_minus, ^setsize_minus);
cc_setposition(0, 0, ^setpos_abs_centre, ^setpos_abs_centre);
cc_settextfont(museo_sans_13pt_bold);
cc_setcolour(%info_box_text_col);
cc_settextalign(^settextalign_centre, ^settextalign_centre, 15);
cc_settextshadow(false);
cc_create(info_box:mainlayer, ^iftype_graphic, 10);
cc_setsize(50, 50, ^setsize_abs, ^setsize_abs);
cc_setposition(0, 0, ^setpos_abs_centre, ^setpos_abs_centre);
def_int $int0 = 0;
while ($int0 < 11) {
    if (%info_box_type = -1 | %info_box_type = 0) {
        switch_int ($int0) {
            case 0 :
                if (cc_find(info_box:mainlayer, $int0) = true) {
                    cc_setgraphic("aif_examine_text_frame_1,4");
                }
            case 1 :
                if (cc_find(info_box:mainlayer, $int0) = true) {
                    cc_setgraphic("aif_examine_text_frame_1,3");
                }
            case 2 :
                if (cc_find(info_box:mainlayer, $int0) = true) {
                    cc_setgraphic("aif_examine_text_frame_1,5");
                }
            case 3 :
                if (cc_find(info_box:mainlayer, $int0) = true) {
                    cc_setgraphic("aif_examine_text_frame_1,1");
                }
            case 4 :
                if (cc_find(info_box:mainlayer, $int0) = true) {
                    cc_setgraphic("aif_examine_text_frame_1,7");
                }
            case 5 :
                if (cc_find(info_box:mainlayer, $int0) = true) {
                    cc_setgraphic("aif_examine_text_frame_1,2");
                }
            case 6 :
                if (cc_find(info_box:mainlayer, $int0) = true) {
                    cc_setgraphic("aif_examine_text_frame_1,0");
                }
            case 7 :
                if (cc_find(info_box:mainlayer, $int0) = true) {
                    cc_setgraphic("aif_examine_text_frame_1,6");
                }
            case 8 :
                if (cc_find(info_box:mainlayer, $int0) = true) {
                    cc_setgraphic("aif_examine_text_frame_1,8");
                }
            case 9 :
                if (cc_find(info_box:mainlayer, $int0) = true) {
                    cc_settext(%info_box_text);
                }
            case 10 :
                if (cc_find(info_box:mainlayer, $int0) = true) {
                    cc_setgraphic(%info_box_icon);
                }
        }
    } else if (%info_box_type = 1) {
        switch_int ($int0) {
            case 0 :
                if (cc_find(info_box:mainlayer, $int0) = true) {
                    cc_setgraphic("aif_examine_text_frame_2,4");
                }
            case 1 :
                if (cc_find(info_box:mainlayer, $int0) = true) {
                    cc_setgraphic("aif_examine_text_frame_2,3");
                }
            case 2 :
                if (cc_find(info_box:mainlayer, $int0) = true) {
                    cc_setgraphic("aif_examine_text_frame_2,5");
                }
            case 3 :
                if (cc_find(info_box:mainlayer, $int0) = true) {
                    cc_setgraphic("aif_examine_text_frame_2,1");
                }
            case 4 :
                if (cc_find(info_box:mainlayer, $int0) = true) {
                    cc_setgraphic("aif_examine_text_frame_2,7");
                }
            case 5 :
                if (cc_find(info_box:mainlayer, $int0) = true) {
                    cc_setgraphic("aif_examine_text_frame_2,2");
                }
            case 6 :
                if (cc_find(info_box:mainlayer, $int0) = true) {
                    cc_setgraphic("aif_examine_text_frame_2,0");
                }
            case 7 :
                if (cc_find(info_box:mainlayer, $int0) = true) {
                    cc_setgraphic("aif_examine_text_frame_2,6");
                }
            case 8 :
                if (cc_find(info_box:mainlayer, $int0) = true) {
                    cc_setgraphic("aif_examine_text_frame_2,8");
                }
            case 9 :
                if (cc_find(info_box:mainlayer, $int0) = true) {
                    cc_settext(%info_box_text);
                }
            case 10 :
                if (cc_find(info_box:mainlayer, $int0) = true) {
                    cc_setgraphic(%info_box_icon);
                }
        }
    }
    $int0 = calc($int0 + 1);
}
