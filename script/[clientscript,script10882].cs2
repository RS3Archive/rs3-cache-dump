// 10882
[clientscript,script10882]
if (%boothpreview_elf_choosen = 0) {
    if_sethide(true, boothpreview:npc_model);
    if_sethide(true, boothpreview:npc_head);
    if_sethide(false, boothpreview:playermodel);
    if_sethide(false, boothpreview:chathead);
} else {
    if_sethide(false, boothpreview:npc_model);
    if_sethide(false, boothpreview:npc_head);
    if_sethide(true, boothpreview:playermodel);
    if_sethide(true, boothpreview:chathead);
    if_setnpchead(enum(int, npc, atelf_dropdown_to_elf, %boothpreview_elf_choosen), boothpreview:npc_head);
    if_setmodelanim(single_frame_avatar_ready, boothpreview:npc_model);
    if_setnpcmodel(enum(int, npc, atelf_dropdown_to_elf, %boothpreview_elf_choosen), boothpreview:npc_model);
    if_setmodelanim(bas_getanim_ready(%boothpreview_npc_bas), boothpreview:npc_model);
}
