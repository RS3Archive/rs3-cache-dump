// 6285
[clientscript,script6285](int $int0)
def_int $int1 = 0;
if (calc(clientclock % 6) = 0 & cc_find(cruc_battle_overlay:face_layer, $int0) = true) {
    $int1 = cc_gettrans;
    if ($int1 >= 235) {
        cc_delete;
        if_setontimer(null, cruc_battle_overlay:face_layer);
    } else {
        cc_settrans(calc($int1 + 20));
    }
}
