    if ($int1 = 1) {
        switch_component ($component0) {
            case ss_rework:aquanite_pet_layer, ss_rework:ice_pet_layer, ss_rework:runt_pet_layer :
                if_settext("Already owned", $component4);
            case ss_rework:upgrade1_layer :
                if (stat_base(defence) < 30) {
                    if_settext("Req: 30 Defence", $component4);
                } else {
                    if_settext("No suitable helm", $component4);
                }
            case ss_rework:upgrade2_layer :
                if (stat_base(defence) < 50) {
                    if_settext("Req: 50 Defence", $component4);
                } else {
                    if_settext("No suitable helm", $component4);
                }
            case ss_rework:upgrade3_layer :
                if (stat_base(defence) < 70) {
                    if_settext("Req: 70 Defence", $component4);
                } else {
                    if_settext("No suitable helm", $component4);
                }
            case ss_rework:upgrade4_layer :
                if (stat_base(defence) < 70) {
                    if_settext("Req: 70 Defence", $component4);
                } else {
                    if_settext("No suitable helm", $component4);
                }
            case ss_rework:recharge_helm_layer :
                if_settext("No suitable helm", $component4);
            case ss_rework:recharge_ring_layer :
                if_settext("No suitable ring", $component4);
            case ss_rework:freezy_skin1_layer, ss_rework:freezy_skin2_layer, ss_rework:freezy_skin3_layer :
                if (testbit(%lore_followers_owned_2, calc(34 % 42)) = ^false) {
                    if_settext("Requires pet", $component4);
                } else {
                    if_settext("Already owned", $component4);
                }
            case ss_rework:helmet_layer :
                if (%smki < 250 & ~script1858(8) = false) {
                    if_settext("Req Smoking Kills", $component4);
                } else {
                    if_settext("Already learned", $component4);
                }
            case ss_rework:fuse_layer :
                if (%smki < 250 & ~script1858(8) = false) {
                    if_settext("Req Smoking Kills", $component4);
                } else {
                    if_settext("Already learned", $component4);
                }
            case ss_rework:elf_fero_ring_layer :
                if (%elfcity_access = 0 | %me3_quest < 400) {
                    if_settext("Req Plague's End", $component4);
                } else {
                    if_settext("Already bought", $component4);
                }
            case ss_rework:soul_catcher_layer :
                if (stat_base(slayer) < 99 | %slayer_pod_tutorial_progress < 3) {
                    if_settext("Locked", $component4);
                }
            case ss_rework:slayer_pod_fourth_room_layer :
                if (stat_base(slayer) < 99 | %slayer_pod_tutorial_progress < 3 | %quest_desert_finale_main < 138) {
                    if_settext("Locked", $component4);
                } else {
                    if_settext("Already bought", $component4);
                }
            case default :
                if_settext("Already learned", $component4);
        }
    } else {
        switch_component ($component0) {
            case ss_rework:upgrade2_layer :
                if (%njslay_bought_upgrade2 = 0) {
                    if_settext("400 points", $component4);
                } else {
                    if_settext("40 points", $component4);
                }
            case ss_rework:upgrade3_layer :
                if (%njslay_bought_upgrade3 = 0) {
                    if_settext("600 points", $component4);
                } else {
                    if_settext("60 points", $component4);
                }
            case ss_rework:upgrade4_layer :
                if (%njslay_bought_upgrade4 = 0) {
                    if_settext("1000 points", $component4);
                } else {
                    if_settext("100 points", $component4);
                }
            case ss_rework:freezy_skin1_layer, ss_rework:freezy_skin2_layer, ss_rework:freezy_skin3_layer :
                if_settext("125 points", $component4);
        }
    }
} else {
    switch_component ($component0) {
        case ss_rework:cancel_current_layer :
            if_settext("Cancel task", ss_rework:cancel_current_title);
        case ss_rework:never_again_layer :
            if_settext("Block task", ss_rework:never_again_title);
        case ss_rework:extend_current_layer :
            if_settext("Extend task", ss_rework:extend_current_title);
        case ss_rework:prefer_task_layer :
            if_settext("Prefer task", ss_rework:prefer_task_title);
    }
}
