// 2752
[proc,meslayer_setupdynamicbutton]
cc_settextalign(^settextalign_centre, ^settextalign_centre, 0);
cc_settextfont(museo_sans_11pt_regular);
cc_setcolour(^blue);
cc_settextshadow(false);
cc_setsize(0, calc(if_getheight(cc_getlayer) - (if_gety(meslayer:mes_text2) + if_getheight(meslayer:mes_text2))), ^setsize_minus, ^setsize_abs);
cc_setposition(0, 0, ^setpos_abs_centre, ^setpos_abs_bottom);
cc_setonmouseover("cc_text_colour_swapper(event_com, event_comsubid, 16777215)");
cc_setonmouseleave("cc_text_colour_swapper(event_com, event_comsubid, 255)");
