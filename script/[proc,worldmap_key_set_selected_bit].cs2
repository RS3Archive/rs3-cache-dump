// 14742
[proc,worldmap_key_set_selected_bit](int $int0)
def_int $int1 = calc($int0 / 32);
def_int $int2 = calc($int0 % 32);
switch_int ($int1) {
    case 0 :
        %varclient_3928 = setbit(%varclient_3928, $int2);
    case 1 :
        %varclient_3929 = setbit(%varclient_3929, $int2);
    case 2 :
        %varclient_3930 = setbit(%varclient_3930, $int2);
    case 3 :
        %varclient_3931 = setbit(%varclient_3931, $int2);
    case 4 :
        %varclient_3932 = setbit(%varclient_3932, $int2);
    case 5 :
        %varclient_8300 = setbit(%varclient_8300, $int2);
    case default :
        ~error("worldmap_key_set_selected_bit - Hitting default case for mapicon bits, new var needed!");
}
