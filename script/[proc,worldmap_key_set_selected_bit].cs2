// 14742
[proc,worldmap_key_set_selected_bit](int $int0)
def_int $int1 = calc($int0 / 32);
def_int $int2 = calc($int0 % 32);
switch_int ($int1) {
    case 0 :
        %worldmap_selected_keys_int0 = setbit(%worldmap_selected_keys_int0, $int2);
    case 1 :
        %worldmap_selected_keys_int1 = setbit(%worldmap_selected_keys_int1, $int2);
    case 2 :
        %worldmap_selected_keys_int2 = setbit(%worldmap_selected_keys_int2, $int2);
    case 3 :
        %worldmap_selected_keys_int3 = setbit(%worldmap_selected_keys_int3, $int2);
    case 4 :
        %worldmap_selected_keys_int4 = setbit(%worldmap_selected_keys_int4, $int2);
    case 5 :
        %worldmap_selected_keys_int5 = setbit(%worldmap_selected_keys_int5, $int2);
    case default :
        ~error("worldmap_key_set_selected_bit - Hitting default case for mapicon bits, new var needed!");
}
