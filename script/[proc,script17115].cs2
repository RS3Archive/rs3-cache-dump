// 17115
[proc,script17115]
def_int $int0 = calc(%gravestone_timer_inv_slots + %gravestone_timer_worn_slots);
def_int $int1 = calc($int0 + %gravestone_timer_overflow_slots);
def_boolean $boolean2 = true;
def_string $string0 = "Number of items stored with Death:<br><tostring($int0)> with Death<br><tostring(%gravestone_timer_overflow_slots)> / <tostring(50)> in overflow storage";
if ($int0 > 0 & $int1 >= 50) {
    $boolean2 = false;
    $string0 = "<$string0><br><br><col=FF0000>Warning: If you die, you may permanently lose items. Reclaim items from Death when you can!";
}
~script17116(true, $boolean2, death_storage_icon, tostring($int1), $string0);
