// 9201
[proc,total_bonus_xp]()(boolean)
def_int $int0 = 1;
def_int $int1 = 0;
while ($int1 = 0 & $int0 <= enum_getoutputcount(int_to_stat)) {
    switch_stat (enum(int, stat, int_to_stat, $int0)) {
        case attack :
            $int1 = %bonusxp_attack;
        case strength :
            $int1 = %bonusxp_strength;
        case defence :
            $int1 = %bonusxp_defence;
        case magic :
            $int1 = %bonusxp_magic;
        case ranged :
            $int1 = %bonusxp_ranged;
        case prayer :
            $int1 = %bonusxp_prayer;
        case summoning :
            $int1 = %bonusxp_summoning;
        case mining :
            $int1 = %bonusxp_mining;
        case smithing :
            $int1 = %bonusxp_smithing;
        case crafting :
            $int1 = %bonusxp_crafting;
        case woodcutting :
            $int1 = %bonusxp_woodcutting;
        case farming :
            $int1 = %bonusxp_farming;
        case firemaking :
            $int1 = %bonusxp_firemaking;
        case fishing :
            $int1 = %bonusxp_fishing;
        case cooking :
            $int1 = %bonusxp_cooking;
        case dungeoneering :
            $int1 = %bonusxp_dungeoneering;
        case slayer :
            $int1 = %bonusxp_slayer;
        case runecraft :
            $int1 = %bonusxp_runecrafting;
        case hunter :
            $int1 = %bonusxp_hunter;
        case thieving :
            $int1 = %bonusxp_thieving;
        case construction :
            $int1 = %bonusxp_construction;
        case hitpoints :
            $int1 = %bonusxp_hitpoints;
        case agility :
            $int1 = %bonusxp_agility;
        case fletching :
            $int1 = %bonusxp_fletching;
        case herblore :
            $int1 = %bonusxp_herblore;
        case divination :
            $int1 = %bonusxp_divination;
        case invention :
            $int1 = %bonusxp_invention;
        case archaeology :
            $int1 = %bonusxp_archaeology;
        case necromancy :
            $int1 = %bonusxp_necromancy;
    }
    $int0 = calc($int0 + 1);
}
if ($int1 > 0) {
    return(true);
} else {
    return(false);
}
