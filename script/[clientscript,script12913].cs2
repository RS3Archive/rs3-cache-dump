// 12913
[clientscript,script12913](int $int0, component $component1, component $component2, int $int3)
def_int $int4 = 0;
if (clientclock > $int0 | if_gethide($component2) = true) {
    if_setontimer(null, $component1);
    if_settext("", $component1);
} else {
    $int4 = calc(1 + ($int0 - clientclock) / 50);
    if ($int4 > 60) {
        if_settext("<tostring(calc($int4 / 60))>m<br>(<tostring($int3)>)", $component1);
    } else {
        if_settext("<tostring($int4)><br>(<tostring($int3)>)", $component1);
    }
}
