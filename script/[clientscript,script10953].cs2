// 10953
[clientscript,script10953]
if (~ironman_mode = true) {
    mes("Ironman players cannot make love potions.");
    return;
}
if (inv_freespace(inv_93) = 0 & inv_total(inv_93, obj_34010) = 0) {
    mes("You don't have enough free inventory space to make any love potions.");
    return;
}
if (inv_total(inv_93, obj_33968) >= 10) {
    if_setgraphic("rs3_valentines15_icons,3", interface_1584:com_188);
    if_settext("How many love potions would you like to make? (<tostring(10)> rose petals each)", interface_1584:com_216);
    if_settext("0", interface_1584:com_214);
    if_sethide(false, interface_1584:com_195);
    if_sethide(false, interface_1584:com_60);
    if_sethide(false, interface_1584:com_14);
} else {
    mes("You don't have enough rose petals to make a love potion.");
}
