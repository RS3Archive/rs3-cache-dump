// 8998
[clientscript,script8998](component $component0)
def_component $component1 = null;
if ($component0 = 6awe1_vote:choice1_button) {
    $component1 = 6awe1_vote:choice_1_button_graphic;
} else {
    $component1 = 6awe1_vote:choice_2_button_graphic;
}
if_setgraphic(~script8997(1), $component1);
