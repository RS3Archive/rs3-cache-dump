~cc_add_child_graphic_full($int1, $int2++, 0, 0, ^setpos_abs_left, ^setpos_abs_centre, calc(2 * if_getwidth(wheel_of_fortune:background_holder)), 0, ^setsize_abs, ^setsize_minus, trh180_paintover_river2, false, false, true, 0);
