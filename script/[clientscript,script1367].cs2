// 1367
[clientscript,script1367]
if_settext(tostring(%castlewars_zamorak_score), castlewars_status_overlay_saradomin:zamorak_score);
if_settext(tostring(%castlewars_saradomin_score), castlewars_status_overlay_saradomin:saradomin_score);
if (%castlewars_timer = 1) {
    if_settext("<tostring(%castlewars_timer)> Min", castlewars_status_overlay_saradomin:time_remaining);
} else {
    if_settext("<tostring(%castlewars_timer)> Mins", castlewars_status_overlay_saradomin:time_remaining);
}
if_settext("", castlewars_status_overlay_saradomin:taken_by_zam_player);
if (%castlewars_saradomin_flag = 0) {
    if_settext("Safe", castlewars_status_overlay_saradomin:saradomin_flag);
    if_setcolour(^green, castlewars_status_overlay_saradomin:saradomin_flag);
    if_settext("", castlewars_status_overlay_saradomin:taken_by_zam_player);
} else if (%castlewars_saradomin_flag = 1) {
    if_settext("Taken", castlewars_status_overlay_saradomin:saradomin_flag);
    if_setcolour(^red, castlewars_status_overlay_saradomin:saradomin_flag);
    if_settext("by <%castlewars_flag_taker_name>", castlewars_status_overlay_saradomin:taken_by_zam_player);
} else if (%castlewars_saradomin_flag = 2) {
    if_settext("Dropped", castlewars_status_overlay_saradomin:saradomin_flag);
    if_setcolour(^yellow, castlewars_status_overlay_saradomin:saradomin_flag);
    if_settext("", castlewars_status_overlay_saradomin:taken_by_zam_player);
}
if_settext("", castlewars_status_overlay_saradomin:taken_by_sara_player);
if (%castlewars_zamorak_flag = 0) {
    if_settext("Safe", castlewars_status_overlay_saradomin:zamorak_flag);
    if_setcolour(^green, castlewars_status_overlay_saradomin:zamorak_flag);
} else if (%castlewars_zamorak_flag = 1) {
    if_settext("Taken", castlewars_status_overlay_saradomin:zamorak_flag);
    if_setcolour(^red, castlewars_status_overlay_saradomin:zamorak_flag);
} else if (%castlewars_zamorak_flag = 2) {
    if_settext("Dropped", castlewars_status_overlay_saradomin:zamorak_flag);
    if_setcolour(^yellow, castlewars_status_overlay_saradomin:zamorak_flag);
}
if (%castlewars_saradomin_maindoor = 0) {
    if_settext("Health: <tostring(%castlewars_saradomin_maindoor)>%", castlewars_status_overlay_saradomin:health);
    if_setcolour(^red, castlewars_status_overlay_saradomin:health);
    if_setgraphic("aif_castle_wars_icons_1,4", castlewars_status_overlay_saradomin:main_door_pic);
} else {
    if_settext("Health <tostring(%castlewars_saradomin_maindoor)>%", castlewars_status_overlay_saradomin:health);
    if_setcolour(^green, castlewars_status_overlay_saradomin:health);
    if_setgraphic("aif_castle_wars_icons_1,5", castlewars_status_overlay_saradomin:main_door_pic);
}
if (%castlewars_saradomin_sidedoor = 1) {
    if_settext("Unlocked", castlewars_status_overlay_saradomin:door);
    if_setcolour(^red, castlewars_status_overlay_saradomin:door);
    if_setgraphic("aif_castle_wars_icons_1,3", castlewars_status_overlay_saradomin:side_door_pic);
} else {
    if_settext("Locked", castlewars_status_overlay_saradomin:door);
    if_setcolour(^green, castlewars_status_overlay_saradomin:door);
    if_setgraphic("aif_castle_wars_icons_1,2", castlewars_status_overlay_saradomin:side_door_pic);
}
if (%castlewars_saradomin_tunnel1 = 1) {
    if_settext("Cleared", castlewars_status_overlay_saradomin:tunnel1);
    if_setcolour(^red, castlewars_status_overlay_saradomin:tunnel1);
} else {
    if_settext("Collapsed", castlewars_status_overlay_saradomin:tunnel1);
    if_setcolour(^green, castlewars_status_overlay_saradomin:tunnel1);
}
if (%castlewars_saradomin_tunnel2 = 1) {
    if_settext("Cleared", castlewars_status_overlay_saradomin:tunnel2);
    if_setcolour(^red, castlewars_status_overlay_saradomin:tunnel2);
} else {
    if_settext("Collapsed", castlewars_status_overlay_saradomin:tunnel2);
    if_setcolour(^green, castlewars_status_overlay_saradomin:tunnel2);
}
if_setgraphic("aif_castle_wars_icons_1,0", castlewars_status_overlay_saradomin:tunnel1_pic);
if_setgraphic("aif_castle_wars_icons_1,0", castlewars_status_overlay_saradomin:tunnel2_pic);
if (%castlewars_saradomin_catapult = 1) {
    if_settext("Destroyed", castlewars_status_overlay_saradomin:catapult);
    if_setcolour(^red, castlewars_status_overlay_saradomin:catapult);
} else {
    if_settext("Operational", castlewars_status_overlay_saradomin:catapult);
    if_setcolour(^green, castlewars_status_overlay_saradomin:catapult);
}
if_setgraphic("aif_castle_wars_icons_1,1", castlewars_status_overlay_saradomin:catapult_pic);
