// 11562
[clientscript,script11562]
if (%trh55_astromancer_unlocked = 0) {
    return;
}
def_graphic $graphic0 = null;
if_sethide(false, trh55_world_event:astromancer_layer);
if_setgraphic("trh55_btn_astromancer,0", trh55_world_event:astromancer_graphic_unlocked);
$graphic0 = "trh55_btn_astromancer,1";
if_setonmouseover("script11561(5, $graphic0)", trh55_world_event:astromancer_graphic_unlocked);
$graphic0 = "trh55_btn_astromancer,0";
if_setonmouseleave("script11561(5, $graphic0)", trh55_world_event:astromancer_graphic_unlocked);
if_setontimer("script11032", trh55_world_event:astromancer_progress_bar_layer);
if_settext(tostring(%trh55_astromancer_currency), trh55_world_event:astromancer_amount);
~script11564;
if (if_gethide(trh55_world_event:astromancer_sparkle_1) = false) {
    if_setontimer("script11563", trh55_world_event:astromancer_sparkle_4);
}
