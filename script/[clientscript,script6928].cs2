// 6928
[clientscript,script6928](component $component0, int $int1, int $int2, int $int3)
if ($int3 ! 1) {
    return;
}
sound_vorbis_rate(clans_interface_click, 1, 0, 100, 350);
if ($int2 = 17) {
    if (%duel3_pocket = 1) {
        %duel3_pocket = 0;
    } else {
        %duel3_pocket = 1;
    }
} else if (testbit(%duel3_wornslots, $int2) = ^true) {
    %duel3_wornslots = clearbit(%duel3_wornslots, $int2);
} else {
    %duel3_wornslots = setbit(%duel3_wornslots, $int2);
}
if (.cc_find($component0, $int1) = true) {
    ~script6927($int2);
}
