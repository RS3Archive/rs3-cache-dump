[clientscript,script5466]
def_int $int0 = if_getwidth(dom_battle_overlay:boss_health_layer);
def_int $int1 = 0;
$int1 = calc($int0 - 33);
$int1 = scale($int1, 100, %dom_battle_boss_health_width);
if_setsize($int1, if_getheight(dom_battle_overlay:boss_healthbar), ^setsize_abs, ^setsize_abs, dom_battle_overlay:boss_healthbar);
