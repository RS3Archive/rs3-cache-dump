// 6960
[clientscript,script6960]
if (%mm15_skip_credit = 0) {
    if_sethide(false, mm15_tasklist:skip_task_btn_disabled_layer);
}
if (%mm15_skip_credit ! 1) {
    if_settext("You have <tostring(%mm15_skip_credit)> Chits", mm15_tasklist:skip_credit);
} else {
    if_settext("You have 1 Chit", mm15_tasklist:skip_credit);
}
