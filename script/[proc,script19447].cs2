// 19447
[proc,script19447](npc $npc0, npc $npc1, component $component2, component $component3, component $component4)
if_sethide(true, $component2);
if_sethide(false, $component3);
if_setnpcmodel($npc0, $component3);
if_setmodelanim(acc_create_idle, $component3);
if_setmodelangle(-50, 105, 0, 0, 0, 500, $component3);
if_sethide(false, $component4);
if_setnpcmodel($npc1, $component4);
if_setmodelanim(acc_create_idle, $component4);
if_setmodelangle(50, 105, 0, 0, 0, 500, $component4);
