// 8581
[clientscript,script8581](component $component0, component $component1, component $component2)
if (%godss_firsttime_progress < 4) {
    cc_deleteall($component0);
    cc_deleteall($component1);
    if_setsize(500, 50, ^setsize_abs, ^setsize_abs, $component2);
} else {
    if_setsize(500, 70, ^setsize_abs, ^setsize_abs, $component2);
    ~static_checkbox_create($component0, $component1, "Skip completion cutscene", "Toggle to start viewing the statue sculpting cutscene.", "Toggle to stop viewing the statue sculpting cutscene.", %godss_skip_cutscene);
}
