// 13125
[proc,script13125](component $component0, component $component1, component $component2)
if (if_find($component0) = true) {
    if (string_length(removetags(%p_dialog_display_text)) = 0) {
        if_sethide(false, $component2);
    } else {
        if_sethide(true, $component2);
    }
    if_settext(cc_param(p_dialog_display_text), $component1);
    if_setcolour(~script10495(3), $component1);
}
