// 19525
[proc,script19525](int $int0, int $int1)
if ($int0 > $int1 | $int1 > 20) {
    return;
}
def_int $int2 = $int0;
while ($int2 <= $int1) {
    if (cc_find(group_ironman_storage:separators, $int2) = true) {
        cc_sethide(true);
    }
    if (cc_find(group_ironman_storage:dividers, $int2) = true) {
        cc_sethide(true);
    }
    $int2 = calc($int2 + 1);
}
