// 18626
[proc,script18626](struct $struct0, string $string0, int $int1)(string)
$string0 = "<$string0><br>- Charge <~script17720($struct0, 45, calc(45 + 10), 0, $int1)> every <col=ffffff><~script15973(1, 1)></col>.";
