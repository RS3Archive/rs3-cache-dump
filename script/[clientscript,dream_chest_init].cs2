// 61
[clientscript,dream_chest_init]
def_int $int0 = 0;
def_obj $obj1 = null;
while ($int0 < 5) {
    cc_create(dream_armour:chest_layer, ^iftype_graphic, $int0);
    cc_setsize(36, 32, ^setsize_abs, ^setsize_abs);
    if ($int0 = 0) {
        cc_setposition(0, 43, ^setpos_abs_left, ^setpos_abs_top);
    }
    if ($int0 = 1) {
        cc_setposition(50, 2, ^setpos_abs_left, ^setpos_abs_top);
    }
    if ($int0 = 2) {
        cc_setposition(50, 43, ^setpos_abs_left, ^setpos_abs_top);
    }
    if ($int0 = 3) {
        cc_setposition(50, 85, ^setpos_abs_left, ^setpos_abs_top);
    }
    if ($int0 = 4) {
        cc_setposition(50, 125, ^setpos_abs_left, ^setpos_abs_top);
    }
    $obj1 = inv_getobj(dream_crate_inventory, $int0);
    if ($obj1 ! null) {
        cc_setobject($obj1, inv_getnum(dream_crate_inventory, $int0));
        cc_setopbase(oc_name($obj1));
        cc_setop(1, "Deposit");
        cc_setoutline(1);
        cc_setonmouserepeat("script9564($obj1, event_com, event_comsubid)");
        if ($int0 = 0) {
            if_setgraphic(null, dream_armour:inv_icon_weapon);
        }
        if ($int0 = 1) {
            if_setgraphic(null, dream_armour:inv_icon_helm);
        }
        if ($int0 = 2) {
            if_setgraphic(null, dream_armour:inv_icon_chest);
        }
        if ($int0 = 3) {
            if_setgraphic(null, dream_armour:inv_icon_leggings);
        }
        if ($int0 = 4) {
            if_setgraphic(null, dream_armour:inv_icon_boots);
        }
    } else {
        if ($int0 = 0) {
            if_setgraphic("rs3_icon_worn_equipment,3", dream_armour:inv_icon_weapon);
        }
        if ($int0 = 1) {
            if_setgraphic("rs3_icon_worn_equipment,0", dream_armour:inv_icon_helm);
        }
        if ($int0 = 2) {
            if_setgraphic("rs3_icon_worn_equipment,5", dream_armour:inv_icon_chest);
        }
        if ($int0 = 3) {
            if_setgraphic("rs3_icon_worn_equipment,7", dream_armour:inv_icon_leggings);
        }
        if ($int0 = 4) {
            if_setgraphic("rs3_icon_worn_equipment,9", dream_armour:inv_icon_boots);
        }
    }
    $int0 = calc($int0 + 1);
}
