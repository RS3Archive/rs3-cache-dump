// 7384
[proc,script7384](int $int0)
switch_int ($int0) {
    case 0 :
        ~script7385(rand_speedrun_board:personal_content_layer, 308);
        if_sethide(false, rand_speedrun_board:personal_content_layer);
        if_sethide(true, rand_speedrun_board:global_content_layer);
        ~script13972(rand_speedrun_board:personal_tab, null, rs3tli_modal_tab, "Personal", 1);
        ~script13972(rand_speedrun_board:global_tab, null, rs3tli_modal_tab, "Global", 0);
    case 1 :
        ~script7385(rand_speedrun_board:global_content_layer, 420);
        if_sethide(true, rand_speedrun_board:personal_content_layer);
        if_sethide(false, rand_speedrun_board:global_content_layer);
        ~script13972(rand_speedrun_board:personal_tab, null, rs3tli_modal_tab, "Personal", 0);
        ~script13972(rand_speedrun_board:global_tab, null, rs3tli_modal_tab, "Global", 1);
}
