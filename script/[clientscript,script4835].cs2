// 4835
[clientscript,script4835]
def_component $component0 = null;
def_component $component1 = null;
def_component $component2 = null;
switch_int (%clan_custom_stronghold_current_slot_varp) {
    case 1 :
        $component0 = ~script4817(%clan_custom_slot_1_tier_varp, 1);
        $component1 = ~script4817(%clan_custom_slot_1_tier_varp, 2);
        $component2 = ~script4817(%clan_custom_slot_1_tier_varp, 3);
    case 2 :
        $component0 = ~script4817(%clan_custom_slot_2_tier_varp, 1);
        $component1 = ~script4817(%clan_custom_slot_2_tier_varp, 2);
        $component2 = ~script4817(%clan_custom_slot_2_tier_varp, 3);
    case 3 :
        $component0 = ~script4817(%clan_custom_slot_3_tier_varp, 1);
        $component1 = ~script4817(%clan_custom_slot_3_tier_varp, 2);
        $component2 = ~script4817(%clan_custom_slot_3_tier_varp, 3);
}
def_int $int3 = calc(if_getnextsubid($component0) - 1);
while ($int3 >= 0) {
    if (cc_find($component0, $int3) = true) {
        cc_setgraphic("aif_checkbox_large,5");
    }
    $int3 = calc($int3 - 1);
}
