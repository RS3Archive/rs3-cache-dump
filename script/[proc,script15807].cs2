// 15807
[proc,script15807](component $component0)(string)
switch_component ($component0) {
    case default :
        return("");
    case bonds_redeem_generic_embedded:confirm_button_active_layer :
        return("Confirm");
    case bonds_redeem_generic_embedded:cancel_button_active_layer :
        return("Cancel");
    case bonds_redeem_generic_embedded:mainmodal_window_close_button :
        return("Close");
}
