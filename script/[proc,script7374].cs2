// 7374
[proc,script7374](component $component0, int $int1)
def_component $component2 = pop_manager:selected_item;
if_sethide(false, $component2);
def_int $int3 = calc(if_getx($component0) + if_getx(if_getparentlayer($component0)));
def_int $int4 = calc(if_gety($component0) + if_gety(if_getparentlayer($component0)));
if_setposition(calc($int3 - 1), calc($int4 - 1), ^setpos_abs_left, ^setpos_abs_top, $component2);
