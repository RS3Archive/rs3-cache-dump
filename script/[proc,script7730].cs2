// 7730
[proc,script7730](graphic $graphic0, int $int1, boolean $boolean2, int $int3)
cc_create(tsd_boulder_overlay:gold_frame_content_layer, ^iftype_graphic, $int1);
cc_setgraphic($graphic0);
if ($boolean2 = true) {
    cc_setposition(0, $int3, ^setpos_abs_centre, ^setpos_abs_top);
    cc_setonclick("script7567($int1)");
} else {
    cc_setposition($int3, 0, ^setpos_abs_left, ^setpos_abs_centre);
    cc_setonmouseover("script7567($int1)");
    cc_setonmouseleave("script7568($int1)");
}
cc_setsize(25, 25, ^setsize_abs, ^setsize_abs);
