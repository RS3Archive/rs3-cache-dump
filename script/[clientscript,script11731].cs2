// 11731
[clientscript,script11731](component $component0, int $int1)
if ($int1 > 50) {
    switch_graphic (if_getgraphic($component0)) {
        case default :
            if_setontimer(null, $component0);
        case "rs3_icon_grouping_system,1" :
            if_setgraphic("rs3_icon_grouping_system,2", $component0);
        case "rs3_icon_grouping_system,2" :
            if_setgraphic("rs3_icon_grouping_system,1", $component0);
        case "rs3_icon_grouping_system,6" :
            if_setgraphic("rs3_icon_grouping_system,8", $component0);
        case "rs3_icon_grouping_system,11" :
            if_setgraphic("rs3_icon_grouping_system,12", $component0);
        case "rs3_icon_grouping_system,12" :
            if_setgraphic("rs3_icon_grouping_system,11", $component0);
        case "rs3_icon_lobby_loot_share,0" :
            if_setgraphic("rs3_icon_lobby_loot_share,1", $component0);
        case "rs3_icon_lobby_loot_share,1" :
            if_setgraphic("rs3_icon_lobby_loot_share,3", $component0);
        case "rs3_icon_lobby_loot_share,3" :
            if_setgraphic("rs3_icon_lobby_loot_share,0", $component0);
    }
    $int1 = 0;
} else {
    $int1 = calc($int1 + 1);
}
if_setontimer("script11731($component0, $int1)", $component0);
