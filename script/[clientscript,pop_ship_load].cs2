// 5928
[clientscript,pop_ship_load]
~script8841(59, 1);
if (~script4186 < 2) {
    if_sethide(true, pop_ship:next_layer);
    if_sethide(true, pop_ship:prev_layer);
} else {
    if_sethide(false, pop_ship:next_layer);
    if_sethide(false, pop_ship:prev_layer);
    if_setopkey(1, ^key_left, 0, pop_ship:prev_layer);
    if_setopkey(1, ^key_right, 0, pop_ship:next_layer);
}
if_setopkey(1, ^key_escape, 0, pop_ship:close_button);
~script5815;
if (%pop_tutorial_progress < 63) {
    if_sethide(true, pop_ship:crew_button);
} else {
    if_sethide(false, pop_ship:crew_button);
}
if (~script6431 = false) {
    if_sethide(true, pop_ship:hover_crew_dragable_hint);
}
