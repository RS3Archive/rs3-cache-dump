// 4528
[proc,script4528]
if_sethide(false, trh178_overlay:splash_screen);
if_sethide(true, trh178_overlay:universe);
if_sethide(true, wheel_of_fortune:chests_layer);
def_graphic $graphic0 = trh178_title_en;
switch_int (map_lang) {
    case 0 :
        $graphic0 = trh178_title_en;
    case 1 :
        $graphic0 = trh178_title_de;
    case 2 :
        $graphic0 = trh178_title_fr;
    case 3 :
        $graphic0 = trh178_title_pt;
}
~cc_add_graphic(trh178_overlay:splash_screen, 0, 0, 15, ^setpos_abs_centre, ^setpos_abs_top, 478, 38, ^setsize_abs, ^setsize_abs, $graphic0);
~cc_add_text(trh178_overlay:splash_screen, 1, 0, 62, ^setpos_abs_centre, ^setpos_abs_top, 692, 33, ^setsize_abs, ^setsize_abs, bp3_text_white_notosans_centre_12pt, "The vault is open and there's a wealth of rewards on offer!");
~cc_add_model(trh178_overlay:splash_screen, 2, -170, 130, ^setpos_abs_centre, ^setpos_abs_centre, 32, 32, ^setsize_abs, ^setsize_abs);
cc_setnpcmodel(trh178_suit_1);
cc_setmodelanim(human_actor_heroic_pose_emote_var_a_mirrored_loop);
cc_setmodelangle(0, -5, 0, 0, 0, 650);
~cc_add_model(trh178_overlay:splash_screen, 3, -310, 130, ^setpos_abs_centre, ^setpos_abs_centre, 32, 32, ^setsize_abs, ^setsize_abs);
cc_setnpcmodel(trh178_suit_2);
cc_setmodelanim(human_actor_heroic_pose_emote_var_a_loop);
cc_setmodelangle(0, -5, 0, 0, 0, 650);
~cc_add_model(trh178_overlay:splash_screen, 4, -240, 125, ^setpos_abs_centre, ^setpos_abs_centre, 32, 32, ^setsize_abs, ^setsize_abs);
cc_setnpcmodel(trh178_suit_4);
cc_setmodelanim(trh178_rich_idle);
cc_setmodelangle(0, -5, 0, 0, 0, 650);
~cc_add_text(trh178_overlay:splash_screen, 5, -240, 145, ^setpos_abs_centre, ^setpos_abs_centre, 225, 33, ^setsize_abs, ^setsize_abs, bp3_text_white_notosans_centre_12pt, "Win the new Gala Attire from Gem Chests.");
~cc_add_model(trh178_overlay:splash_screen, 6, 0, 83, ^setpos_abs_centre, ^setpos_abs_centre, 32, 32, ^setsize_abs, ^setsize_abs);
cc_setnpcmodel(trh178_suit_3);
cc_setmodelanim(mtx_ats_player_proud_idle);
cc_setmodelangle(0, 10, 0, 0, 0, 600);
~cc_add_text(trh178_overlay:splash_screen, 7, 0, 115, ^setpos_abs_centre, ^setpos_abs_centre, 225, 33, ^setsize_abs, ^setsize_abs, bp3_text_white_notosans_centre_12pt, "Win all 3 Outfits to unlock the Moonstone Gala Attire.");
~cc_add_graphic(trh178_overlay:splash_screen, 8, 240, 63, ^setpos_abs_centre, ^setpos_abs_centre, 128, 128, ^setsize_abs, ^setsize_abs, trh178_coins_1_billion);
~cc_add_text(trh178_overlay:splash_screen, 9, 240, 145, ^setpos_abs_centre, ^setpos_abs_centre, 225, 33, ^setsize_abs, ^setsize_abs, bp3_text_white_notosans_centre_12pt, "Hydrix chests have a chance to contain<col=FF00> 1 Billion coins</col>.");
