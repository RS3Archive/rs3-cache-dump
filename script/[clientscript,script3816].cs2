// 3816
[clientscript,script3816](component $component0)
if (if_getgraphic($component0) = xmas2019_advent_button_over) {
    if_setgraphic(xmas2019_advent_button, $component0);
}
if (if_getgraphic($component0) = xmas2019_advent_right_button_over) {
    if_setgraphic(xmas2019_advent_right_button, $component0);
}
