// 7524
[proc,script7524](int $int0)
def_int $int1 = 0;
def_int $int2 = 3;
if (%rand_dnd_total_cards = 5) {
    $int2 = 5;
} else if (%rand_dnd_total_cards >= 3) {
    $int2 = 4;
}
if (%rand_dnd_current_card < $int2 & %rand_dnd_interface_scrolling = false) {
    sound_vorbis_volume(megagames_athletics_card_mouseover, 1, 0, 50);
    if_setgraphic(~script7504(~script7529(++%rand_dnd_current_card)), rand_dnd_card_preview:rand_dnd_chosen_card);
    if_settext(~script7505(~script7529(%rand_dnd_current_card)), rand_dnd_card_preview:rand_dnd_card_name_text);
    if_settext(~script7515(~script7529(%rand_dnd_current_card)), rand_dnd_card_preview:info_text);
    if_setontimer("script7528(-100, 1, $int0)", rand_dnd_card_preview:rand_dnd_cards_perm_layer);
    %rand_dnd_interface_scrolling = true;
}
