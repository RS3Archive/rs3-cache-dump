// 397
[clientscript,script397]
if (%objreq_currency = null & %stock_offeritem ! null) {
    if (~script17400 < ~script17377(%stock_offerprice, int_to_long(%stock_offercount))) {
        if_setcolour(^red, obj_info:player_has);
    } else {
        if_setcolour(%objreq_fontcol, obj_info:player_has);
    }
}
