$int1 = calc($int1 + ~script17810($dbrow0, $int1, $component2));
$int1 = calc($int1 + ~script17811($dbrow0, $int1, $component2));
if (if_getheight($component2) < $int1) {
    if_sethide(false, $component3);
    if_setscrollpos(0, 0, $component2);
