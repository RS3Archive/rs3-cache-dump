// 15450
[proc,script15450](int $int0, int $int1, int $int2, int $int3, int $int4)
if_setop(1, "Feed honeycomb", pof_animal:honeycomb_health_button);
if_setop(1, "Feed honeycomb", pof_animal:honeycomb_happiness_button);
if_setop(1, "Feed honeycomb", pof_animal:honeycomb_weight_button);
if_setop(1, "Feed honeycomb", pof_animal:honeycomb_speed_button);
