~script15451($int0, 100, pof_honey_health, pof_animal:add_honey_health, "This animal is already the healthiest it can be.", "You don't have any Medicinal honeycomb to feed this animal.", pof_animal:honeycomb_health_button, "Feed Medicinal honeycomb.");
~script15451($int1, 100, pof_honey_happiness, pof_animal:add_honey_happiness, "This animal is already the happiest it can be.", "You don't have any Delicious honeycomb to feed this animal.", pof_animal:honeycomb_happiness_button, "Feed Delicious honeycomb.");
~script15451($int2, 2047, pof_honey_weight, pof_animal:add_honey_weight, "This animal is already the heaviest it can be.", "You don't have any Dense honeycomb to feed this animal.", pof_animal:honeycomb_weight_button, "Feed Dense honeycomb.");
~script15451($int3, 2047, pof_honey_speed, pof_animal:add_honey_speed, "This animal is already the fastest it can be.", "You don't have any Runny honeycomb to feed this animal.", pof_animal:honeycomb_speed_button, "Feed Runny honeycomb.");
~script15451($int4, 2047, pof_honey_attractiveness, pof_animal:add_honey_attractiveness, "This animal is already the prettiest it can be.", "You don't have any Sweet honeycomb to feed this animal.", pof_animal:honeycomb_attractiveness_button, "Feed Sweet honeycomb.");
~script15452($int0, 100, "This animal is not at its healthiest, gathering produce from the animal will result in less XP.", "This animal is as healthy as can be!", pof_animal:health_bar);
~script15452($int1, 100, "This animal is not at its happiest, gathering produce from the animal will result in less XP.", "This animal is as happy as can be!", pof_animal:happiness_bar);
