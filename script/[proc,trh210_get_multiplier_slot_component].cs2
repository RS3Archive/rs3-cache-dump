// 20012
[proc,trh210_get_multiplier_slot_component](int $int0)(component)
switch_int ($int0) {
    case 1 :
        return(trh210_overlay:multiplier_1);
    case 2 :
        return(trh210_overlay:multiplier_2);
    case 3 :
        return(trh210_overlay:multiplier_3);
    case 4 :
        return(trh210_overlay:multiplier_4);
    case 5 :
        return(trh210_overlay:multiplier_5);
    case 6 :
        return(trh210_overlay:multiplier_6);
    case 7 :
        return(trh210_overlay:multiplier_7);
    case 8 :
        return(trh210_overlay:multiplier_8);
    case default :
        ~error("No entry for multiplier slot <tostring($int0)> in trh210_get_multiplier_slot_component.");
}
return(null);
