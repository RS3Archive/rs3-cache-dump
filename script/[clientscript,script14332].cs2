// 14332
[clientscript,script14332](component $component0, component $component1, component $component2)
def_obj $obj3 = null;
switch_component ($component2) {
    case hunter_charms_exchange_side:spirit_lure_item :
        ~script14334(huntcharm_lure, $component1, $component2);
        if_setoninvtransmit("script14333($component1, $component2){inv}", $component0);
    case hunter_charms_exchange_side:yaktwee_item :
        if (inv_total(inv, huntcharm_stave_enhanced) > 0 | inv_total(worn, huntcharm_stave_enhanced) > 0) {
            $obj3 = huntcharm_stave_enhanced;
        } else {
            $obj3 = huntcharm_stave;
        }
        ~script14334($obj3, $component1, $component2);
        if_setoninvtransmit("script14333($component1, $component2){inv, worn}", $component0);
    case hunter_charms_exchange_side:gold_slice_item :
        ~script14334(huntcharm_fragment_gold, $component1, $component2);
        if_setoninvtransmit("script14333($component1, $component2){inv}", $component0);
    case hunter_charms_exchange_side:crimson_slice_item :
        ~script14334(huntcharm_fragment_crimson, $component1, $component2);
        if_setoninvtransmit("script14333($component1, $component2){inv}", $component0);
    case hunter_charms_exchange_side:green_slice_item :
        ~script14334(huntcharm_fragment_green, $component1, $component2);
        if_setoninvtransmit("script14333($component1, $component2){inv}", $component0);
    case hunter_charms_exchange_side:blue_slice_item :
        ~script14334(huntcharm_fragment_blue, $component1, $component2);
        if_setoninvtransmit("script14333($component1, $component2){inv}", $component0);
    case hunter_charms_exchange_side:mystical_slice_item :
        ~script14334(huntcharm_fragment_mystical, $component1, $component2);
        if_setoninvtransmit("script14333($component1, $component2){inv}", $component0);
}
