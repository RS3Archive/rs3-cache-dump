// 15387
[clientscript,script15387]
if (~script6431 = true | %settings_chat_hide_wiki_button = 1) {
    if_sethide(true, chatdefault:wiki_button);
    return;
}
if_sethide(false, chatdefault:wiki_button);
~script13990(chatdefault:wiki_button_build, chatdefault:wiki_button_click, rs3tli_3x3_icon_button);
if_setonop("script15388", chatdefault:wiki_button_click);
