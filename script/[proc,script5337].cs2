// 5337
[proc,script5337](int $int0)(int)
switch_int ($int0) {
    case 1 :
        return(%arch_orthen_potion_renew_aggrooverload_unlocked);
    case 2 :
        return(%arch_orthen_potion_lore_renewal_unlocked);
    case 4 :
        return(%arch_orthen_potion_spirit_attraction_unlocked);
    case 3 :
        return(%arch_orthen_potion_archaeology_unlocked);
    case 5 :
        return(%arch_orthen_potion_pow_opportunity_unlocked);
    case default :
        ~error("Invalid potion ID: <tostring($int0)>");
        return(-1);
}
