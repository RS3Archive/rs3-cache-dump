// 12260
[clientscript,script12260](component $component0, int $int1, int $int2)
def_int $int3 = calc($int2 - $int1);
def_int $int4 = calc(clientclock - $int1);
def_int $int5 = 0;
def_graphic $graphic6 = null;
if ($int4 >= $int3) {
    $graphic6 = "combatv2_cooldown_animation,138";
} else {
    $int5 = scale($int4, $int3, 138);
    $int5 = max($int5, 0);
    $int5 = min($int5, 138);
    $graphic6 = ~script7988($int5);
