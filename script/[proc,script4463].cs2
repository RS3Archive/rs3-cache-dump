// 4463
[proc,script4463](component $component0, struct $struct1)(string)
switch_component ($component0) {
    case trh_bingo:prestige_level :
        return("The amount of times you have prestiged your Plague Doctor task list.");
    case trh_bingo:use_stamp_button_layer :
        return("Use Plague Doctor mask stamps to instantly complete tasks.");
    case trh_bingo:easy_task_1 :
        return("Knock knock - Interact with the Ardougne wall door.");
    case trh_bingo:easy_task_2 :
        return("Doctor's visit - Talk to Hans while wearing the gas mask.");
    case trh_bingo:easy_task_3 :
        return("Cure the infection - Create an antipoison.");
    case trh_bingo:easy_task_4 :
        return("Right to the source -  Kill 30 giant rats in the Stronghold of Security - <tostring(~script5542($struct1, 3))>/<tostring(30)>");
    case trh_bingo:medium_task_1 :
        return("An apple a day - Harvest an apple from an apple tree.");
    case trh_bingo:medium_task_2 :
        return("Animal Clinic - Feed animals medicinal honeycomb at the Manor Farm - <tostring(~script5542($struct1, 5))>/<tostring(5)>");
    case trh_bingo:medium_task_3 :
        return("This sucks - Create 24 bloated leech pouches - <tostring(~script5542($struct1, 6))>/<tostring(24)>");
    case trh_bingo:medium_task_4 :
        return("You should probably get that checked - Defeat the Giant mole.");
    case trh_bingo:hard_task_1 :
        return("Ahead of the Game - Complete a soul reaper assignment.");
    case trh_bingo:hard_task_2 :
        return("Medical logs - Cut 50 blisterwood logs - <tostring(~script5542($struct1, 9))>/<tostring(50)>");
    case trh_bingo:hard_task_3 :
        return("Chief Sturgeon - Catch 50 leaping sturgeon - <tostring(~script5542($struct1, 10))>/<tostring(50)>");
    case trh_bingo:hard_task_4 :
        return("Just part of the job - Burn 25 vyre corpses - <tostring(~script5542($struct1, 11))>/<tostring(25)>");
    case trh_bingo:elite_task_1 :
        return("Regular exercise - <tostring(~script5542($struct1, 12))>/<tostring(25)> laps of Hefin Agility Course completed.");
    case trh_bingo:elite_task_2 :
        return("Always read the label - Create a Strong Cure Potion in Daemonheim.");
    case trh_bingo:elite_task_3 :
        return("Home Remedy - Fetch items for the Plague Doctor :<br>1x 6 dose Overload Salve<br>1x Divine herb patch III<br>1x Empty Birds Nest<br>200x Harmonic Dust<br>10x Wallasalkibanite ore<br>1x Sack full of Potatoes");
    case trh_bingo:elite_task_4 :
        return("Crimson Skillchompas : Catch 200 Crimson Skillchompas - <tostring(~script5542($struct1, 15))>/<tostring(200)>");
    case trh_bingo:line_prize_1 :
        return("Complete this line to get a medium cash bag.");
    case trh_bingo:line_prize_2 :
        return("Complete this line to get a large cash bag.");
    case trh_bingo:line_prize_3 :
        return("Complete this line to get a huge prismatic star.");
    case trh_bingo:line_prize_4 :
        return("Complete this line to get a huge prismatic lamp.");
    case trh_bingo:column_prize_1 :
        switch_int (%trh150_prestige) {
            case 0, 2, 4 :
                return("Complete this column to receive the Plague Doctor gloves and boots.");
            case 1, 3 :
                return("Complete this column to receive a large cash bag.");
        }
    case trh_bingo:column_prize_2 :
        switch_int (%trh150_prestige) {
            case 0, 2, 4 :
                return("Complete this column to receive the Plague Doctor legs.");
            case 1, 3 :
                return("Complete this column to receive a huge prismatic star.");
        }
    case trh_bingo:column_prize_3 :
        switch_int (%trh150_prestige) {
            case 0, 2, 4 :
                return("Complete this column to receive the Plague Doctor coat.");
            case 1, 3 :
                return("Complete this column to receive a huge prismatic lamp.");
        }
    case trh_bingo:column_prize_4 :
        switch_int (%trh150_prestige) {
            case 0, 2, 4 :
                return("Complete this column to receive the Plague Doctor mask.");
            case 1, 3 :
                return("Complete this column to receive 2 huge prismatic stars.");
        }
    case trh_bingo:prestige_1_layer :
        return("Plague Doctor syringe daggers.");
    case trh_bingo:prestige_2_layer :
        return("Plague Doctor rest animation.");
    case trh_bingo:prestige_3_layer :
        return("Plague Doctor staff.");
    case trh_bingo:prestige_4_layer :
        return("Plague Doctor teleport animation.");
    case trh_bingo:prestige_5_layer :
        return("Plague Doctor walk override.");
}
