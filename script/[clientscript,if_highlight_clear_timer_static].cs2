// 13872
[clientscript,if_highlight_clear_timer_static](component $component0, int $int1, int $int2)
if ($int2 > 0) {
    if_setontimer("if_highlight_clear_timer_static(event_com, $int1, calc($int2 - 1))", $component0);
} else {
    ~if_highlight_clear_channel($int1);
    if_setontimer(null, $component0);
}
