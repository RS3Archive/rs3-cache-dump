// 13057
[clientscript,script13057](component $component0, component $component1, component $component2)
if_setop(1, "Confirm", $component1);
if_setonop("xp_reward_confirm_invalid", $component1);
if_setonvartransmit("script13058($component0, $component1, $component2){xp_reward_current_choice, xp_reward_second_choice}", $component0);
if_setonresize("script13058($component0, $component1, $component2)", $component0);
~script13059($component0, $component1, $component2);
