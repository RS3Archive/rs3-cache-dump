// 5463
[clientscript,script5463]
if (%dom_battle_infobox_state = 0) {
    %dom_battle_infobox_state = 1;
    if_sethide(true, dom_battle_overlay:handicap_icons_layer);
    if_setsize(if_getwidth(dom_battle_overlay:stats_layer), 37, ^setsize_abs, ^setsize_abs, dom_battle_overlay:stats_layer);
    if_set2dangle(16384, dom_battle_overlay:expand_graphic);
} else {
    %dom_battle_infobox_state = 0;
    if_sethide(false, dom_battle_overlay:handicap_icons_layer);
    if_set2dangle(49152, dom_battle_overlay:expand_graphic);
    ~script5464;
}
