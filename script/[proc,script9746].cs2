// 9746
[proc,script9746]
if_setcolour(~rgb_to_hex(255, 255, 255), rand_entrance:yes_text);
if_setcolour(~rgb_to_hex(255, 255, 255), rand_entrance:no_text);
if (%rand_player_eligable_for_harmode = 0 | %rand_player_eligable_for_harmode = -1) {
    if_sethide(false, rand_entrance:hm_yes_option_layer_disabled);
    if (if_getgraphic(rand_entrance:yes_radial) = rs3_btn_radio_on) {
        if_setgraphic(rs3_btn_radio_on_disabled, rand_entrance:yes_radial_disabled);
    } else {
        if_setgraphic(rs3_btn_radio_off_disabled, rand_entrance:yes_radial_disabled);
    }
    if_sethide(false, rand_entrance:hm_no_option_layer_disabled);
    if (if_getgraphic(rand_entrance:no_radial) = rs3_btn_radio_on) {
        if_setgraphic(rs3_btn_radio_on_disabled, rand_entrance:no_radial_disabled);
    } else {
        if_setgraphic(rs3_btn_radio_off_disabled, rand_entrance:no_radial_disabled);
    }
    if_setcolour(~rgb_to_hex(125, 125, 125), rand_entrance:yes_text);
    if_setcolour(~rgb_to_hex(125, 125, 125), rand_entrance:no_text);
} else {
    if_sethide(true, rand_entrance:hm_yes_option_layer_disabled);
    if_sethide(true, rand_entrance:hm_no_option_layer_disabled);
}
