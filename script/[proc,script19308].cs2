// 19308
[proc,script19308]
~script8844(1, 83, 0, trh_dungeon_crawl_overlay:keybind_layer, -1);
if (%trh_dungeon_crawl_dungeon_dbrow = null) {
    ~script8844(1, 16, 8, trh_dungeon_crawl_overlay:dungeon_option_1_button_layer, -1);
    ~script8844(1, 17, 8, trh_dungeon_crawl_overlay:dungeon_option_2_button_layer, -1);
} else if (db_getrowtable(%trh_dungeon_crawl_dungeon_floor_dbrow) = trh_dungeon_crawl_bonus_encounter) {
    ~script8844(1, 16, 8, trh_dungeon_crawl_overlay:bonus_option_1_button_layer, -1);
    ~script8844(1, 17, 8, trh_dungeon_crawl_overlay:bonus_option_2_button_layer, -1);
}
%wof_hotkey = 0;
