if (%trh100_farming_total < 800) {
    $boolean0 = false;
}
~script12816(%trh100_farming_total, 800, trh100_herbs_vs_zombies:farming_progress_text, trh100_herbs_vs_zombies:farming_total_progress_text);
~script12817(%trh100_farming_total, trh100_herbs_vs_zombies:farming_progressbar_layer);
~script12818($boolean0, trh100_herbs_vs_zombies:farming_reward_locked_graphic);
~script12819($boolean0, trh100_herbs_vs_zombies:farming_reward_line_1);
if (%trh100_herblore_total < 800) {
    $boolean1 = false;
}
~script12816(%trh100_herblore_total, 800, trh100_herbs_vs_zombies:herblore_progress_text, trh100_herbs_vs_zombies:herblore_total_progress_text);
