// 11876
[clientscript,script11876]
if (%falsiege_sabotage_woodcutting = 1) {
    ~script9754(falsiege_configure:sabotage_woodcutting_op, falsiege_configure:sabotage_construction_op, null, null, null);
}
if (%falsiege_heal_constitution = 1) {
    ~script9754(falsiege_configure:heal_constitution_op, falsiege_configure:heal_herblore_op, null, null, null);
}
~script11878(falsiege_configure:checkbox_build, falsiege_configure:checkbox_click);
def_string $string0 = "Sabotage catapults to earn Construction XP.";
if_setonmouserepeat("script8799($string0, event_com, event_comsubid)", falsiege_configure:sabotage_construction_layer);
$string0 = "Sabotage catapults to earn Woodcutting XP.";
if_setonmouserepeat("script8799($string0, event_com, event_comsubid)", falsiege_configure:sabotage_woodcutting_layer);
$string0 = "Heal injured soldiers to earn Herblore XP.";
if_setonmouserepeat("script8799($string0, event_com, event_comsubid)", falsiege_configure:heal_herblore_layer);
$string0 = "Heal injured soldiers to earn Constitution XP.";
if_setonmouserepeat("script8799($string0, event_com, event_comsubid)", falsiege_configure:heal_constitution_layer);
