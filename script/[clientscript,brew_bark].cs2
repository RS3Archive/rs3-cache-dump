// 1756
[clientscript,brew_bark](component $component0, component $component1)
if (%brew_varc_bark > 0) {
    if_setmodel(game_brew_if_bark_on, $component0);
    if_setcolour(0x33ff00, $component1);
} else {
    if_setmodel(game_brew_if_bark_off, $component0);
    if_setcolour(0x910000, $component1);
}
if_settext(tostring(%brew_varc_bark), $component1);
