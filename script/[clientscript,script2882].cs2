// 2882
[clientscript,script2882](component $component0)
if (%music_v3_protect = 1 | %cutscene_status = 1) {
    return;
}
if (%playlist_mode = 0) {
    ~script8800("Playlist on", $component0, -1);
    if_setgraphic("aif_music_header_buttons,7", $component0);
} else {
    ~script8800("Playlist off", $component0, -1);
    if_setgraphic("aif_music_header_buttons,5", $component0);
}
