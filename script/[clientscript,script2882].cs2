// 2882
[clientscript,script2882](component $component0)
if (%varplayerbit_207 = 1 | %varplayerbit_3028 = 1) {
    return;
}
if (%varplayerbit_187 = 0) {
    ~script8800("Playlist on", $component0, -1);
    if_setgraphic("aif_music_header_buttons,7", $component0);
} else {
