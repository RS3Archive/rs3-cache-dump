// 12862
[clientscript,trh107_tooltips](component $component0)
def_string $string0 = "";
switch_component ($component0) {
    case trh107:prestige_level :
        $string0 = "How many times you have completed you card.";
    case trh107:use_brains_button_layer :
        $string0 = "Use brain stickers to complete tasks immediately!";
    case trh107:easy_task_1 :
        $string0 = "Find and talk to Zrik.";
    case trh107:easy_task_2 :
        $string0 = "Telegrab 15 pickled brain jars from the pub in Canifis - <tostring(%trh107_telegrab_progress)>/15";
    case trh107:easy_task_3 :
        $string0 = "Gather 100 Mort Myre Fungus - <tostring(%trh107_fungus_progress)>/100";
    case trh107:easy_task_4 :
        $string0 = "Kill 50 experiments - <tostring(%trh107_experiments_progress)>/50";
    case trh107:medium_task_1 :
        $string0 = "Create an Evil Turnip pouch at the Obelisk within the Nature grotto.";
    case trh107:medium_task_2 :
        $string0 = "Complete 3 maximum length slayer contracts of Infernal Mages or higher (not including Wilderness contracts) - <tostring(%trh107_contract_progress)>/3";
    case trh107:medium_task_3 :
        $string0 = "Mine 300 Daeyalt ore - <tostring(%trh107_daeyalt_progress)>/300";
    case trh107:medium_task_4 :
        $string0 = "Complete 25 laps of the Werewolf Agility course - <tostring(%trh107_agility_progress)>/25";
    case trh107:hard_task_1 :
        $string0 = "Cremate 200 Vyres with the Sunspear - <tostring(%trh107_vrye_progress)>/200";
    case trh107:hard_task_2 :
        $string0 = "Fletch from Blisterwood logs 150 times - <tostring(%trh107_blisterwood_progress)>/150";
    case trh107:hard_task_3 :
        $string0 = "Harvest 36 poison ivy - <tostring(%trh107_ivy_progress)>/36";
    case trh107:hard_task_4 :
        $string0 = "Complete 5 Occult or Warped, medium or large dungeoneering floors - <tostring(%trh107_dungeoneering_progress)>/5";
    case trh107:elite_task_1 :
        $string0 = "Burn 100 Tortured souls - <tostring(%trh107_souls_progress)>/100";
    case trh107:elite_task_2 :
        $string0 = "Catch 5 Zombie Implings - <tostring(%trh107_impling_progress)>/5";
    case trh107:elite_task_3 :
        $string0 = "Deposit 50 Manifest Shadow Cores in Prifddinas - <tostring(%trh107_manifest_progress)>/50";
    case trh107:elite_task_4 :
        $string0 = "Open 5 gold chests in the Shades of Mort'ton minigame - <tostring(%trh107_mortton_progress)>/5";
    case trh107:line_prize_1 :
        $string0 = "Complete this line to get a medium cash bag.";
    case trh107:line_prize_2 :
        $string0 = "Complete this line to get a large cash bag.";
    case trh107:line_prize_3 :
        $string0 = "Complete this line to get a huge prismatic star.";
    case trh107:line_prize_4 :
        $string0 = "Complete this line to get a huge prismatic lamp.";
    case trh107:column_prize_1 :
        switch_int (%trh107_prestige) {
            case 0 :
                $string0 = "Complete this column to receive the hands and feet of the Zombie outfit with the Infected appearance.";
            case 2 :
                $string0 = "Complete this column to receive the Decaying appearance for your Zombie outfit hands and feet.";
            case 4 :
                $string0 = "Complete this column to receive the Rotten appearance for your Zombie outfit hands and feet.";
            case default :
                $string0 = "Complete this column to receive a large cash bag.";
        }
    case trh107:column_prize_2 :
        switch_int (%trh107_prestige) {
            case 0 :
                $string0 = "Complete this column to receive the legs of the Zombie outfit with the Infected appearance.";
            case 2 :
                $string0 = "Complete this column to receive the Decaying appearance for your Zombie outfit legs.";
            case 4 :
                $string0 = "Complete this column to receive the Rotten appearance for your Zombie outfit legs.";
            case default :
                $string0 = "Complete this column to receive a Huge Prismatic Star.";
        }
    case trh107:column_prize_3 :
        switch_int (%trh107_prestige) {
            case 0 :
                $string0 = "Complete this column to receive the torso of the Zombie outfit with the Infected appearance.";
            case 2 :
                $string0 = "Complete this column to receive the Decaying appearance for your Zombie outfit torso.";
            case 4 :
                $string0 = "Complete this column to receive the Rotten appearance for your Zombie outfit torso.";
            case default :
                $string0 = "Complete this column to receive a Huge Prismatic Lamp.";
        }
    case trh107:column_prize_4 :
        switch_int (%trh107_prestige) {
            case 0 :
                $string0 = "Complete this column to receive the head of the Zombie outfit with the Infected appearance.";
            case 2 :
                $string0 = "Complete this column to receive the Decaying appearance for your Zombie outfit head.";
            case 4 :
                $string0 = "Complete this column to receive the Rotten appearance for your Zombie outfit head.";
            case default :
                $string0 = "Complete this column to receive 2 Huge Prismatic Stars.";
        }
}
if_setonmouserepeat("script3876($string0, $component0, -1)", $component0);
