// 17051
[proc,script17051]
def_dbrow $dbrow0 = ~script1626(1, %trh189_left_bonus_active);
def_dbrow $dbrow1 = ~script1626(2, %trh189_right_bonus_active);
def_seq $seq2 = ~script1611(1, $dbrow0);
def_seq $seq3 = ~script1611(2, $dbrow1);
def_seq $seq4 = ~script1611(0, $dbrow0);
def_seq $seq5 = ~script1611(0, $dbrow1);
if_setmodelanim($seq2, trh189_overlay:solar_armour);
if_setontimer("trh189_reset_anim(seqlength($seq2), $seq4, trh189_overlay:solar_armour)", trh189_overlay:solar_armour);
if_setontimer("script17060(20, $seq3, $seq5, trh189_overlay:lunar_armour)", trh189_overlay:lunar_armour);
