def_int $int4 = ui_getcategory($int1);
def_int $int5 = scale(-20000, 100, $int2);
def_int $int6 = 0;
if (cc_findbycategory(wheel_of_fortune:background_holder, $int4, $int3) = 1) {
    $int6 = calc(cc_get2dangle + 65536 / $int5);
    if ($int6 < 0) {
        $int6 = calc(65536 + $int6);
