def_graphic $graphic1 = null;
def_graphic $graphic2 = null;
def_graphic $graphic3 = null;
def_int $int4 = 0;
$graphic0, $graphic1, $graphic2 = ~script18988(12);
if (cc_find(trh119_buried_treasure_overlay:grid_rect_layer, 12) = true) {
    $graphic3 = cc_getgraphic;
