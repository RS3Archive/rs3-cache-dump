// 8009
[proc,fadein_comp](int $int0, component $component1, component $component2)
if ($component2 = null) {
    $component2 = $component1;
}
if (if_find($component1) = true) {
    cc_settrans(255);
    $int0 = min($int0, 250);
    if_setontimer("fadein_comp(calc(clientclock + $int0), $component1, $component2)", $component2);
}
