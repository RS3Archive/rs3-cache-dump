// 4017
[clientscript,script4017](int $int0, int $int1)
if ($int0 < 14) {
    if_setscrollsize(0, 0, quest_journal:text_scrolling_layer);
    if_setscrollpos(0, 0, quest_journal:text_scrolling_layer);
    cc_deleteall(quest_journal:scrollbar_layer);
} else {
    if_setscrollsize(0, calc($int0 * 20), quest_journal:text_scrolling_layer);
    if ($int1 = 1) {
        if_setscrollpos(0, 0, quest_journal:text_scrolling_layer);
    } else {
        if_setscrollpos(0, calc($int0 * 20 - 180), quest_journal:text_scrolling_layer);
    }
    ~rs3_scrollbar_vertical(quest_journal:scrollbar_layer, quest_journal:text_scrolling_layer);
}
