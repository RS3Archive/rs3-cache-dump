// 2046
[proc,worldmap_overlay_clear](component $component0)
if_setontimer("worldmap_overlay($component0, worldmap_v2:game_world, 0, 0, 0)", $component0);
cc_deleteall($component0);
cc_deleteall(worldmap_v2_ui:you_are_here);
cc_deleteall(worldmap_v2_ui:arrow0);
cc_deleteall(worldmap_v2_ui:arrow1);
cc_deleteall(worldmap_v2_ui:arrow2);
cc_deleteall(worldmap_v2_ui:arrow3);
cc_deleteall(worldmap_v2_ui:arrow_gravestone);
cc_deleteall(worldmap_v2_ui:arrow_waypoint);
cc_deleteall(worldmap_v2_ui:newcontent_upsell0);
if (playermember = false) {
    cc_deleteall(worldmap_v2_ui:upsell0);
    cc_deleteall(worldmap_v2_ui:upsell1);
    cc_deleteall(worldmap_v2_ui:upsell2);
    cc_deleteall(worldmap_v2_ui:upsell3);
    cc_deleteall(worldmap_v2_ui:upsell4);
    cc_deleteall(worldmap_v2_ui:upsell5);
    cc_deleteall(worldmap_v2_ui:upsell6);
    cc_deleteall(worldmap_v2_ui:upsell7);
    cc_deleteall(worldmap_v2_ui:upsell8);
    cc_deleteall(worldmap_v2_ui:upsell9);
    cc_deleteall(worldmap_v2_ui:upsell10);
}
