// 7991
[clientscript,script7991]
if (has_nxt = false) {
    return;
}
if (%fps_shown_this_session = 1 | %fps_dont_show_again = 1) {
    return;
}
def_int $int0 = ~graphics_options_detailget(graphics_options_nxt_vsync);
if ($int0 = 1) {
    return;
}
if_setontimer("script7992", toplevel_v2:fps_monitor);
