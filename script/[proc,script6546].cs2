// 6546
[proc,script6546](dbrow $dbrow0)(int)
switch_dbrow ($dbrow0) {
    case reward_chest_barrows :
        if (~script12432 >= 4) {
            return(1);
        } else {
            return(0);
        }
    case reward_chest_sb :
        if (%sb_player_pet_melee = 1 | %sb_player_pet_magic = 1 | %sb_player_pet_range = 1 | %sb_player_pet_reflect = 1 | %sb_player_pet_healer = 1 | %sb_player_pet_acid = 1) {
            return(0);
        } else {
            return(1);
        }
    case reward_chest_raid1 :
        return(1);
    case reward_chest_dominion_tower :
        if (%atdes_elite_reward = 1) {
            return(1);
        }
    case reward_chest_dungeon_egwd_zamorak_boss :
        return(1);
    case default :
        return(0);
}
return(0);
