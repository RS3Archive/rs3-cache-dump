// 12496
[clientscript,script12496]
switch_int (~script12497) {
    case default :
        if_settext("Lose your mind with weekend madness throughout May.", mm16_summary:weekend_desc);
    case 0 :
        if_settext("Current: Temporary ports buffs", mm16_summary:weekend_desc);
    case 1 :
        if_settext("Next: Ports Skills", mm16_summary:weekend_desc);
    case 2 :
        if_settext("Next: Dungeoneering & Raids", mm16_summary:weekend_desc);
    case 3 :
        if_settext("Next: Bossing & Slayer", mm16_summary:weekend_desc);
    case 4 :
        if_settext("Next: Minigames", mm16_summary:weekend_desc);
    case -1 :
        if_settext("May Weekends are now over!", mm16_summary:weekend_desc);
}
