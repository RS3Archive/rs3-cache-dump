// 12496
[clientscript,script12496]
switch_int (~script12497) {
    case default :
        if_settext("Lose your mind with weekend madness throughout May.", interface_1758:com_16);
    case 0 :
        if_settext("Current: Temporary ports buffs", interface_1758:com_16);
    case 1 :
        if_settext("Next: Ports Skills", interface_1758:com_16);
    case 2 :
        if_settext("Next: Dungeoneering & Raids", interface_1758:com_16);
    case 3 :
        if_settext("Next: Bossing & Slayer", interface_1758:com_16);
    case 4 :
        if_settext("Next: Minigames", interface_1758:com_16);
    case -1 :
        if_settext("May Weekends are now over!", interface_1758:com_16);
}
