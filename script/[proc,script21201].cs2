// 21201
[proc,script21201](int $int0)
cc_deleteall(plugin_hub_parent_install:dependency_list);
cc_deleteall(plugin_hub_parent_install:dependency_scrollbar);
if_settext("", plugin_hub_parent_install:dependency_title);
if_setscrollsize(0, 0, plugin_hub_parent_install:dependency_list);
if_settext("Installation complete", plugin_hub_parent_install:dependency_title);
def_string $string0 = "The plugin has been installed and enabled. Use the 'manage' tab to change the settings of your new plugins, or close this window and install another plugin.";
if (plugin_enable($int0) = false) {
    $string0 = "Use the 'manage' tab to enable and change the settings of your new plugins, or close this window and install another plugin.";
}
~cc_add_text(plugin_hub_parent_install:dependency_list, 0, 0, 0, ^setpos_abs_left, ^setpos_abs_top, 0, 40, ^setsize_minus, ^setsize_abs, text_body_paragraph, $string0);
