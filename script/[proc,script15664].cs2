// 15664
[proc,script15664](component $component0, component $component1, component $component2)
if_settext("", $component0);
%throbber_last = 0;
if_setgraphic(null, $component1);
if ($component2 ! null) {
    if (cc_find($component2, 0) = true & cc_getgraphic = rs3_loading_spinner_default_backing) {
        cc_sethide(true);
    }
    if (cc_find($component2, 1) = true & cc_getgraphic = rs3_loading_spinner_default) {
        cc_sethide(true);
        cc_set2dangle(0);
    }
}
if_setontimer(null, $component2);
