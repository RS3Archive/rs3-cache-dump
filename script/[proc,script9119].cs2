// 9119
[proc,script9119]
if (%wishing_well_player_redonate = 0) {
    if_sethide(true, confirm_donation:checkbox_selected_layer);
    if_sethide(false, confirm_donation:checkbox_deselected_layer);
} else {
    if_sethide(false, confirm_donation:checkbox_selected_layer);
    if_sethide(true, confirm_donation:checkbox_deselected_layer);
}
if (%wishing_well_player_donate_anon = 0) {
    if_sethide(true, confirm_donation:donate_anon_checkbox_selected_layer);
    if_sethide(false, confirm_donation:donate_anon_checkbox_deselected_layer);
} else {
    if_sethide(false, confirm_donation:donate_anon_checkbox_selected_layer);
    if_sethide(true, confirm_donation:donate_anon_checkbox_deselected_layer);
}
