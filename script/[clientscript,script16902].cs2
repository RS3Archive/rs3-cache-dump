// 16902
[clientscript,script16902](int $int0)
~lobby_popup_close;
switch_int ($int0) {
    case 10010 :
        ~lobby_popup($int0, lobby_popup_negative_action, "Continue?", "After converting your account you will no longer be able to access Fresh Start mode.<br><br><col=ff0000>This cannot be reversed.</col><br><br>Are you sure you wish to convert your account?", "loadingwheel,9", "Convert to Standard Account", "Go Back");
    case default :
        ~lobby_popup($int0, lobby_popup_positive_action, "Continue?", "You need to be in game to access the store.<br><br>Do you want to continue?", "loadingwheel,9", "Continue", "Return to lobby");
}
