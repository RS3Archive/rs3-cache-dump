// 7025
[proc,fromdate_numeric](int $int0)(string)
def_int $int1 = 0;
def_int $int2 = 0;
def_int $int3 = 0;
$int1, $int2, $int3 = date_runeday_todate($int0);
$int2 = calc($int2 + 1);
def_string $string0 = tostring($int1);
if ($int1 < 10) {
    $string0 = "0<$string0>";
}
def_string $string1 = tostring($int2);
if ($int2 < 10) {
    $string1 = "0<$string1>";
}
return("<$string0>/<$string1>/<tostring($int3)>");
