// 11901
[proc,script11901]()(string)
if_sethide(true, timed_event_tasks:foo_lion);
if_sethide(true, timed_event_tasks:mystery_box);
if_sethide(true, timed_event_tasks:mystery_box_big);
if_sethide(true, timed_event_tasks:zodiac_shield);
if_sethide(true, timed_event_tasks:rest_anim);
def_component $component0 = timed_event_tasks:reward_square_5;
cc_create($component0, ^iftype_graphic, 0);
cc_setsize(40, 40, ^setsize_abs, ^setsize_abs);
cc_setposition(0, 0, ^setpos_abs_left, ^setpos_abs_top);
switch_int (calc(%event10_level + 1)) {
    case 2 :
        if_sethide(false, timed_event_tasks:zodiac_shield);
        cc_setonmouserepeat("script12893(timed_event10, 2, %event10_shield_unlocked, event10_shield, event10_shield, $component0, 0)");
        return("Zodiac Shield");
    case 5 :
        if_sethide(false, timed_event_tasks:rest_anim);
        cc_setonmouserepeat("script12893(timed_event10, 5, %event10_rest_unlocked, event10_rest, event10_rest, $component0, 0)");
        return("Tea Making Rest");
    case 10 :
        if_sethide(false, timed_event_tasks:foo_lion);
        cc_setonmouserepeat("script12893(timed_event10, 10, %event10_pet_unlocked, event10_pet, event10_pet, $component0, 0)");
        return("Foo Lion Pet");
    case default :
        if (calc((%event10_level + 1) % 2) = 0) {
            if_sethide(false, timed_event_tasks:mystery_box_big);
            cc_setonmouserepeat("script3876(oc_name(event10_mystery_box_big), $component0, 0)");
            return("Big event mystery box");
        } else {
            if_sethide(false, timed_event_tasks:mystery_box);
            cc_setonmouserepeat("script3876(oc_name(event10_mystery_box), $component0, 0)");
            return("Event mystery box");
        }
}
