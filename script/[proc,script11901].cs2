if_sethide(true, interface_1930:com_175);
if_sethide(true, interface_1930:com_174);
def_component $component0 = interface_1930:com_170;
cc_create($component0, ^iftype_graphic, 0);
cc_setsize(40, 40, ^setsize_abs, ^setsize_abs);
cc_setposition(0, 0, ^setpos_abs_left, ^setpos_abs_top);
switch_int (calc(%varplayerbit_39302 + 1)) {
    case 2 :
        if_sethide(false, interface_1930:com_175);
        cc_setonmouserepeat("script12893(struct_9802, 2, %varplayerbit_39311, obj_41760, obj_41760, $component0, 0)");
        return("Zodiac Shield");
    case 5 :
        if_sethide(false, interface_1930:com_174);
        cc_setonmouserepeat("script12893(struct_9802, 5, %varplayerbit_39312, obj_41761, obj_41761, $component0, 0)");
