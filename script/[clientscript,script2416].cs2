// 2416
[clientscript,script2416](component $component0)
if (%peng_rak_eng_tools = 2 | %peng_rak_eng_tools = 8) {
    if_setop(1, "Cut wire", $component0);
} else if (%peng_rak_eng_tools = 3 | %peng_rak_eng_tools = 9) {
    if_setop(1, "Replace wire", $component0);
} else if (%peng_rak_eng_tools = 4 | %peng_rak_eng_tools = 10) {
    if_setop(1, "Repair wire", $component0);
} else {
    if_setop(1, "Inspect", $component0);
}
