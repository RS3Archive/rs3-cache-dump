// 10113
[clientscript,twitch_highlight_background](int $int0, int $int1, int $int2)
def_int $int3 = 0;
def_component $component4 = toplevel_v2_parent_suboverlay_twitch:build_layer;
if (%twitch_stream_highlight_left ! -1 & cc_find($component4, %twitch_stream_highlight_left) = true) {
    $int3 = calc(cc_gety / 47);
    if (calc($int3 % 2) = 0) {
        cc_setcolour(0x071820);
    } else {
        cc_setcolour(0x1c2c34);
    }
}
if (%twitch_stream_highlight_mid ! -1 & cc_find($component4, %twitch_stream_highlight_mid) = true) {
    $int3 = calc(cc_gety / 47);
    if (calc($int3 % 2) = 0) {
        cc_setcolour(0x071820);
    } else {
        cc_setcolour(0x1c2c34);
    }
}
if (%twitch_stream_highlight_right ! -1 & cc_find($component4, %twitch_stream_highlight_right) = true) {
    $int3 = calc(cc_gety / 47);
    if (calc($int3 % 2) = 0) {
        cc_setcolour(0x071820);
    } else {
        cc_setcolour(0x1c2c34);
    }
}
if (cc_find($component4, $int0) = true) {
    cc_setcolour(0x003652);
    %twitch_stream_highlight_left = cc_getid;
}
if (cc_find($component4, $int1) = true) {
    cc_setcolour(0x003652);
    %twitch_stream_highlight_mid = cc_getid;
}
if (cc_find($component4, $int2) = true) {
    cc_setcolour(0x003652);
    %twitch_stream_highlight_right = cc_getid;
}
