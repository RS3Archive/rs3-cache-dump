// 19114
[clientscript,script19114]
def_graphic $graphic0 = null;
def_graphic $graphic1 = null;
switch_int (map_lang) {
    case 0 :
        $graphic0 = trh199_claim_button_en;
        $graphic1 = trh199_claim_button_disabled_en;
    case 1 :
        $graphic0 = trh199_claim_button_de;
        $graphic1 = trh199_claim_button_disabled_de;
    case 2 :
        $graphic0 = trh199_claim_button_fr;
        $graphic1 = trh199_claim_button_disabled_fr;
    case 3 :
        $graphic0 = trh199_claim_button_pt;
        $graphic1 = trh199_claim_button_disabled_pt;
}
if_setgraphic($graphic0, trh199_overlay:claim_rewards_graphic);
if_setgraphic($graphic1, trh199_overlay:claim_rewards_disabled_graphic);
