// 10902
[clientscript,script10902](int $int0, int $int1, int $int2, component $component3)
if (calc(clientclock % 3000) = calc($int2 % 3000) & clientclock ! $int2) {
    if (++$int1 >= 60) {
        $int1 = 0;
        if (++$int0 >= 24) {
            $int0 = 0;
        }
    }
    if_settext(~script10901($int0, $int1, 1), $component3);
    if_setontimer("script10902($int0, $int1, $int2, $component3)", $component3);
}
