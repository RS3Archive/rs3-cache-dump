// 13034
[clientscript,script13034](int $int0)
switch_int (map_lang) {
    case default :
        if_setgraphic(rs3_bxp_overlay_background_en, bxp_countdown:background);
    case 1 :
        if_setgraphic(rs3_bxp_overlay_background_de, bxp_countdown:background);
    case 2 :
        if_setgraphic(rs3_bxp_overlay_background_fr, bxp_countdown:background);
    case 3 :
        if_setgraphic(rs3_bxp_overlay_background_pt, bxp_countdown:background);
}
%bxp_date_runeday = $int0;
~script13036;
