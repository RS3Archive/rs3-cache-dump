// 9810
[clientscript,script9810](int $setsize0, int $int1, component $component2, component $component3)
if (if_find($component2) = true & .if_find(cc_getparentlayer) = true) {
    cc_setsize(scale(~script9550($setsize0, $int1, .cc_getheight), cc_param(rs3tli_component_initial_height), cc_param(rs3tli_component_initial_width)), $int1, ^setsize_abs, $setsize0);
    if ($component3 ! $component2) {
        cc_callonresize;
    }
}
