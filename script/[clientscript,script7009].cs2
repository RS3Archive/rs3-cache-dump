// 7009
[clientscript,script7009](component $component0)
def_int $int1 = 1;
switch_component ($component0) {
    case default :
        $int1 = %combatv2_actionbar_current_bar;
    case toplevel_v2_combat_bar2:fullscreen_arrow_text :
        $int1 = %combatv2_actionbar_current_bar2;
    case toplevel_v2_combat_bar3:fullscreen_arrow_text :
        $int1 = %combatv2_actionbar_current_bar3;
    case toplevel_v2_combat_bar4:fullscreen_arrow_text :
        $int1 = %combatv2_actionbar_current_bar4;
    case toplevel_v2_combat_bar5:fullscreen_arrow_text :
        $int1 = %combatv2_actionbar_current_bar5;
    case toplevel_v2_combat_bar_mobile_buttons:revo_bar_text :
        $int1 = %combatv2_actionbar_current_bar_mobile;
    case toplevel_v2_combat_bar_mobile_revo:revo_bar_text :
        $int1 = %combatv2_actionbar_current_bar_mobile_revo;
    case share_actionbar_accept:fullscreen_arrow_text :
        if (~script6431 = true) {
            $int1 = %combatv2_actionbar_current_bar_mobile;
        } else {
            $int1 = %combatv2_actionbar_current_bar;
        }
}
if ($int1 = 31) {
    if_settext(".", $component0);
} else {
    if_settext(tostring($int1), $component0);
}
