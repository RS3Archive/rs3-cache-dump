// 20550
[proc,script20550](int $int0)
if ($int0 = 1) {
    ~script20618(mtx_front_end_bonds:tab_layer, 0, "Redeem");
    cc_setonop("script20552(0)");
    ~script20551(0);
    ~script20618(mtx_front_end_bonds:tab_layer, 1, "Convert");
    cc_setonop("script20552(1)");
    ~script20551(1);
} else {
    if (cc_find(mtx_front_end_bonds:tab_layer, 0) = true) {
        ~script20551(0);
    }
    if (cc_find(mtx_front_end_bonds:tab_layer, 1) = true) {
        ~script20551(1);
    }
}
