// 3157
[clientscript,script3157](int $int0, int $int1)
switch_int ($int0) {
    case 1 :
        %incense_guam_potency_duration = $int1;
    case 2 :
        %incense_tarromin_potency_duration = $int1;
    case 3 :
        %incense_marrentill_potency_duration = $int1;
    case 4 :
        %incense_harralander_potency_duration = $int1;
    case 5 :
        %incense_ranarr_potency_duration = $int1;
    case 6 :
        %incense_toadflax_potency_duration = $int1;
    case 7 :
        %incense_spirit_potency_duration = $int1;
    case 8 :
        %incense_irit_potency_duration = $int1;
    case 9 :
        %incense_wergali_potency_duration = $int1;
    case 10 :
        %incense_avantoe_potency_duration = $int1;
    case 11 :
        %incense_kwuarm_potency_duration = $int1;
    case 12 :
        %incense_bloodweed_potency_duration = $int1;
    case 13 :
        %incense_snapdragon_potency_duration = $int1;
    case 14 :
        %incense_cadantine_potency_duration = $int1;
    case 15 :
        %incense_lantadyme_potency_duration = $int1;
    case 16 :
        %incense_dwarf_potency_duration = $int1;
    case 17 :
        %incense_torstol_potency_duration = $int1;
    case 18 :
        %incense_fellstalk_potency_duration = $int1;
    case default :
        ~error("Attempted to set potency duration for unexpected burner type: <tostring($int0)>");
}
