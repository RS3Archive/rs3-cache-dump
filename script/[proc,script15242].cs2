// 15242
[proc,script15242]
switch_int (platformtype) {
    case ^platformtype_default, ^platformtype_jagex :
        openurl_shim("billing_core", "popupredirect.ws?externalName=rsspins", "packagegroupredirect.ws?value=rsspins", true);
    case ^platformtype_apple, ^platformtype_android :
        ~mobile_open_shop(2);
    case default :
        ~script15238(2);
}
~script10930;
