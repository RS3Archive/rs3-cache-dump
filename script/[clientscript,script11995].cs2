// 11995
[clientscript,script11995](int $int0, component $component1)
if (%prayer_client_current_filter = 0) {
    if_setop(1, "Show All", $component1);
    %prayer_client_current_filter = 1;
} else {
    if_setop(1, "Filter", $component1);
    %prayer_client_current_filter = 0;
}
if (%prayer_client_showing_active_summary ! 1) {
    ~script7819(struct_param(prayer_draw_prayers_normal, prayer_child_buttons));
    ~script7819(struct_param(prayer_draw_prayers_sub_overlay, prayer_child_buttons));
}
~script11999(struct_param(prayer_draw_prayers_normal, prayer_child_filter_title), struct_param(prayer_draw_prayers_normal, prayer_child_filter_icon), struct_param(prayer_draw_prayers_normal, prayer_child_filter), 0);
~script11999(struct_param(prayer_draw_prayers_sub_overlay, prayer_child_filter_title), struct_param(prayer_draw_prayers_sub_overlay, prayer_child_filter_icon), struct_param(prayer_draw_prayers_sub_overlay, prayer_child_filter), 0);
