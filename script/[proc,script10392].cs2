// 10392
[proc,script10392](int $int0, int $int1, int $int2)
cc_create(group_parent:req_build_area, ^iftype_graphic, if_getnextsubid(group_parent:req_build_area));
cc_setsize(15, 15, ^setsize_abs, ^setsize_abs);
cc_setposition(calc($int0 + $int2 - 15), calc($int1 + $int2 - 15), ^setpos_abs_left, ^setpos_abs_top);
cc_setgraphic("aif_tick_cross_icon,1");
