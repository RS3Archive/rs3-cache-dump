// 16541
[proc,script16541]
def_graphic $graphic0 = prizemount_circle_white;
def_graphic $graphic1 = prizemount_circle_red;
if (if_getgraphic(inv_drop_areas:alch_bg) ! $graphic1) {
    if_setgraphic($graphic0, inv_drop_areas:alch_bg);
}
if (if_getgraphic(inv_drop_areas:drop_bg) ! $graphic1) {
    if_setgraphic($graphic0, inv_drop_areas:drop_bg);
}
if (if_getgraphic(inv_drop_areas:diss_bg) ! $graphic1) {
    if_setgraphic($graphic0, inv_drop_areas:diss_bg);
}
