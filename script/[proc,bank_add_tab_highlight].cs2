// 9340
[proc,bank_add_tab_highlight](int $int0, int $int1, int $int2)
if (cc_find(interface_517:com_200, $int0) = true) {
    cc_setposition(calc($int1 - 4), calc($int2 - 2), ^setpos_abs_left, ^setpos_abs_top);
    if (%varplayerbit_22875 = 1) {
        cc_setcolour(0xffcb6f);
    } else {
        cc_setcolour(^black);
    }
    cc_sethide(false);
}
