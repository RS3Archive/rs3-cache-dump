// 5
[proc,script5](int $int0, int $int1)
if (%toplevel_v2_mobile_interface = 1) {
    return;
}
def_int $int2 = calc(if_gety(toplevel_v2_target_info:target_health_bar_layer) + if_getheight(toplevel_v2_target_info:target_health_bar_layer));
if (if_gethide(toplevel_v2_target_info:graphic_0) = false) {
    $int2 = calc($int2 + (if_gety(toplevel_v2_target_info:buff_0) + if_getheight(toplevel_v2_target_info:buff_0)));
    if (if_gethide(toplevel_v2_target_info:graphic_6) = false) {
        $int2 = calc($int2 + (if_gety(toplevel_v2_target_info:buff_6) + if_getheight(toplevel_v2_target_info:buff_6)));
    }
}
$int2 = calc($int2 + 2);
if (%toplevel_v2_undock_target_info = 0 | %toplevel_v2_undock_target_info = 1 & %toplevel_v2_legacy_mode >= 2) {
    if_setsize(200, $int2, ^setsize_abs, ^setsize_abs, toplevel_v2_target_info:universe);
} else {
    if_setsize(0, $int2, ^setsize_minus, ^setsize_abs, toplevel_v2_target_info:universe);
}
$int0 = calc($int0 - 200 / 2);
$int1 = calc($int1 - $int2);
$int0 = max(min($int0, calc(if_getwidth(toplevel_v2_targeting:universe) - 200)), 0);
$int1 = max(min($int1, calc(if_getheight(toplevel_v2_targeting:universe) - 92)), 0);
def_int $int3 = 200;
if (%toplevel_v2_undock_target_info = 1) {
    if (if_hassuboverlay(toplevel_v2_targeting:target, toplevel_v2_target_info) = false) {
        if_setposition(0, 0, ^setpos_abs_centre, ^setpos_abs_top, toplevel_v2_target_info:universe);
    } else {
        $int1 = max(0, calc($int1 - 10));
        if_setposition($int0, $int1, ^setpos_abs_left, ^setpos_abs_top, toplevel_v2_target_info:universe);
    }
} else if (if_hassuboverlay(toplevel_v2_targeting:target, toplevel_v2_target_info) = false) {
    $int3, $int2 = ~script8716(2008);
    $int0 = calc($int0 + (if_getwidth(toplevel_v2_target_info:universe) - $int3) / 2);
    ~script8387($int0, $int1, $int3, $int2, 2008);
} else {
    if_setposition($int0, $int1, ^setpos_abs_left, ^setpos_abs_top, toplevel_v2_target_info:universe);
}
if (%toplevel_v2_customization_lock = 1) {
    if_sethide(true, toplevel_v2_target_info:docking_padlock);
} else {
    if_sethide(false, toplevel_v2_target_info:docking_padlock);
}
