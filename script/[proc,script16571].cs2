// 16571
[proc,script16571](int $int0)
switch_int ($int0) {
    case 0 :
        if_setop(2, "Always Show Mode", interface_279:com_6);
        if_setop(3, "Hidden Mode", interface_279:com_6);
    case 1 :
        if_setop(2, "Dynamic Mode", interface_279:com_6);
        if_setop(3, "Hidden Mode", interface_279:com_6);
    case 2 :
        if_setop(2, "Dynamic Mode", interface_279:com_6);
        if_setop(3, "Always Show Mode", interface_279:com_6);
}
