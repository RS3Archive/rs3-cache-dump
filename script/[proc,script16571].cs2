// 16571
[proc,script16571](int $int0)
switch_int ($int0) {
    case 0 :
        if_setop(2, "Always Show Mode", mobile_ribbon_left:chat_wrapper);
        if_setop(3, "Hidden Mode", mobile_ribbon_left:chat_wrapper);
    case 1 :
        if_setop(2, "Dynamic Mode", mobile_ribbon_left:chat_wrapper);
        if_setop(3, "Hidden Mode", mobile_ribbon_left:chat_wrapper);
    case 2 :
        if_setop(2, "Dynamic Mode", mobile_ribbon_left:chat_wrapper);
        if_setop(3, "Always Show Mode", mobile_ribbon_left:chat_wrapper);
}
