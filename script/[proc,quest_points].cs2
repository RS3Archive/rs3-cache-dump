// 2133
[proc,quest_points](quest $quest0)(string, int)
if ($quest0 = null) {
    ~error("Null .quest.");
    return("", -1);
}
def_int $int1 = quest_points($quest0);
switch_quest ($quest0) {
    case quest_74 :
        if (%varplayer_2163 >= 21 & %varplayerbit_9584 = 0) {
            $int1 = 1;
        }
    case quest_20 :
        if (%varplayer_2473 >= 3 & %varplayerbit_9585 = 0) {
            $int1 = 1;
        }
    case quest_341 :
        if (%varplayer_2692 = 100) {
            $int1 = 0;
        }
    case quest_355 :
        if (%varplayer_2388 = 110) {
            $int1 = 0;
        }
    case quest_357 :
        if (%varplayer_2261 = 100) {
            $int1 = 0;
        }
    case quest_358 :
        if (%varplayer_2689 = 6) {
            $int1 = 0;
        }
    case quest_363 :
        if (%varplayer_2552 = 4) {
            $int1 = 0;
        }
}
switch_int ($int1) {
    case 0 :
        return("", $int1);
    case 1 :
        return("1 Quest Point", $int1);
    case default :
        return("<tostring($int1)> Quest Points", $int1);
}
