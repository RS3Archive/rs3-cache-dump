// 10747
[proc,glidermap_update](int $int0)
if_sethide(true, glidermap:window_close_button);
if_sethide(true, glidermap:mountain_go);
if_sethide(true, glidermap:mountain_back);
if_sethide(true, glidermap:digsite_go);
if_sethide(true, glidermap:desert_go);
if_sethide(true, glidermap:desert_back);
if_sethide(true, glidermap:jungle_go);
if_sethide(true, glidermap:jungle_back);
if_sethide(true, glidermap:ogre_go);
if_sethide(true, glidermap:ogre_back);
if_sethide(true, glidermap:tgv_go);
if_sethide(true, glidermap:tgv_back);
if_sethide(true, glidermap:crash_go);
if_sethide(true, glidermap:crash_back);
if_sethide(true, glidermap:elfcity_go);
if_sethide(true, glidermap:elfcity_back);
if_sethide(true, glidermap:elr1_go);
if_sethide(true, glidermap:elr1_back);
if (%onesmallfavour < 200) {
    if_sethide(true, glidermap:ogre_button_layer);
}
if (%glo3_main < 120) {
    if_sethide(true, glidermap:tgv_button_layer);
}
if (%elfcity_access = 0 | %me3_quest < 400) {
    if_sethide(true, glidermap:elfcity_button_layer);
}
if (%elr1_lore_bottle_07 < 1) {
    if_sethide(true, glidermap:elr1_button_layer);
}
switch_int ($int0) {
    case 0 :
        if_sethide(false, glidermap:window_close_button);
    case 1 :
        if_sethide(false, glidermap:mountain_go);
        if_setmodelanim(pilot_mountain, glidermap:mountain_go);
    case 2 :
        if_sethide(false, glidermap:mountain_back);
        if_setmodelanim(pilot_mountain, glidermap:mountain_back);
    case 3 :
        if_sethide(false, glidermap:digsite_go);
        if_setmodelanim(pilot_varrock, glidermap:digsite_go);
    case 4 :
        if_sethide(false, glidermap:desert_go);
        if_setmodelanim(pilot_varrock, glidermap:desert_go);
    case 5 :
        if_sethide(false, glidermap:desert_back);
        if_setmodelanim(pilot_varrock, glidermap:desert_back);
    case 6 :
        if_sethide(false, glidermap:jungle_go);
        if_setmodelanim(pilot_varrock, glidermap:jungle_go);
    case 7 :
        if_sethide(false, glidermap:jungle_back);
        if_setmodelanim(pilot_varrock, glidermap:jungle_back);
    case 10 :
        if_sethide(false, glidermap:ogre_go);
        if_setmodelanim(pilot_varrock, glidermap:ogre_go);
    case 11 :
        if_sethide(false, glidermap:ogre_back);
        if_setmodelanim(pilot_varrock, glidermap:ogre_back);
    case 12 :
        if_sethide(false, glidermap:tgv_go);
        if_setmodelanim(pilot_varrock, glidermap:tgv_go);
    case 13 :
        if_sethide(false, glidermap:tgv_back);
        if_setmodelanim(pilot_varrock, glidermap:tgv_back);
    case 9 :
        if_sethide(false, glidermap:crash_go);
        if_setmodelanim(pilot_varrock, glidermap:crash_go);
    case 8 :
        if_sethide(false, glidermap:crash_back);
        if_setmodelanim(pilot_varrock, glidermap:crash_back);
    case 14 :
        if_sethide(false, glidermap:elfcity_go);
        if_setmodelanim(pilot_mountain, glidermap:elfcity_go);
    case 15 :
        if_sethide(false, glidermap:elfcity_back);
        if_setmodelanim(pilot_mountain, glidermap:elfcity_back);
    case 16 :
        if_sethide(false, glidermap:elr1_go);
        if_setmodelanim(pilot_mountain, glidermap:elr1_go);
    case 17 :
        if_sethide(false, glidermap:elr1_back);
        if_setmodelanim(pilot_mountain, glidermap:elr1_back);
}
~script8841(57, 1);
