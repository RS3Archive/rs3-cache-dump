// 2380
[proc,makeover_colour](component $component0, component $component1)
if ($component1 = makeover_mage:tick_promo) {
    if_sethide(true, makeover_mage:tick);
} else {
    if_sethide(true, makeover_mage:tick_promo);
}
if ($component0 = null) {
    if_sethide(true, $component1);
    return;
}
if_sethide(false, $component1);
if_setposition(calc(if_getx($component0) + (if_getwidth($component0) - if_getwidth($component1)) / 2), calc(if_gety($component0) + (if_getheight($component0) - if_getheight($component1)) / 2), ^setpos_abs_left, ^setpos_abs_top, $component1);
