// 13611
[proc,script13611]
cc_deleteall(cheevo_player_inspect_full:scrollbar_layer);
def_int $int0 = 60;
def_int $int1 = 28;
def_int $int2 = calc(($int0 - $int1) / 2);
if (cc_find(cheevo_player_inspect_full:player_cheevos, calc(if_getnextsubid(cheevo_player_inspect_full:player_cheevos) - 1)) = true & calc(cc_gety + cc_getheight + $int2) > if_getheight(cheevo_player_inspect_full:cheevos_wrapper)) {
    if_setscrollpos(0, 0, cheevo_player_inspect_full:cheevos_wrapper);
    if_setscrollsize(0, calc(cc_gety + cc_getheight + $int2 + 2), cheevo_player_inspect_full:cheevos_wrapper);
    ~rs3_scrollbar_vertical(cheevo_player_inspect_full:scrollbar_layer, cheevo_player_inspect_full:cheevos_wrapper);
}
