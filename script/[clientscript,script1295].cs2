// 1295
[clientscript,script1295]
if_setcolour(^red, hauntedmine_controls:hauntedmine_cart_start);
if_setonmouseleave("text_colour_swapper(event_com, 16711680)", hauntedmine_controls:hauntedmine_cart_start);
if_sethide(true, hauntedmine_controls:hauntedmine_cart0);
if_setmodel(quest_hauntedmine_if_track_cart, hauntedmine_controls:hauntedmine_cart1);
if_setmodelanim(hauntedmine_cart_travel, hauntedmine_controls:hauntedmine_cart1);
