// 7695
[proc,script7695](component $component0, int $int1)
def_int $rgb2 = 0x27353c;
if ($int1 = 1) {
    switch_component ($component0) {
        case egq_tracking:air :
            $rgb2 = 0xbbb199;
        case egq_tracking:chaos :
            $rgb2 = 0xc5814b;
        case egq_tracking:cosmic :
            $rgb2 = 0xc4ac5d;
        case egq_tracking:fire :
            $rgb2 = 0x711010;
        case egq_tracking:earth :
            $rgb2 = 0x4b2d12;
        case egq_tracking:law :
            $rgb2 = 0x112f91;
        case egq_tracking:mind :
            $rgb2 = 0x9f551e;
        case egq_tracking:nature :
            $rgb2 = 0x247032;
        case egq_tracking:water :
            $rgb2 = 0x14448a;
    }
}
if_setcolour($rgb2, $component0);
