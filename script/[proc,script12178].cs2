~script12158($obj0, $component1, $component2);
def_dbrow $dbrow3 = null;
def_int $int4 = 0;
while ($int4 < enum_getoutputcount(invent_material_list)) {
    if (cc_find($component1, $int4) = true) {
        $dbrow3 = enum(int, dbrow, invent_material_list, $int4);
        if (cc_gethide = false) {
