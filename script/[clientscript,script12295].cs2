// 12295
[clientscript,script12295]
if (%elr0_cannonballs_herblore = 1) {
    ~script9754(elr0_configure:cannonball_herblore_op, elr0_configure:cannonball_smithing_op, null, null, null);
}
if (%elr0_repairs_construction = 1) {
    ~script9754(elr0_configure:prison_construction_op, elr0_configure:prison_crafting_op, null, null, null);
}
if (%elr0_cannon_ranged = 1) {
    ~script9754(elr0_configure:cannon_ranged_op, elr0_configure:cannon_firemaking_op, null, null, null);
}
~script11878(falsiege_configure:checkbox_build, falsiege_configure:checkbox_click);
def_string $string0 = "Make cannonballs to earn Smithing XP.";
if_setonmouserepeat("script8799($string0, event_com, event_comsubid)", elr0_configure:cannonball_smithing_layer);
$string0 = "Mix black powder to earn Herblore XP.";
if_setonmouserepeat("script8799($string0, event_com, event_comsubid)", elr0_configure:cannonball_herblore_layer);
$string0 = "Make small repairs to the prison to earn Crafting XP.";
if_setonmouserepeat("script8799($string0, event_com, event_comsubid)", elr0_configure:prison_crafting_layer);
$string0 = "Shore up the prison's defences to earn Construction XP.";
if_setonmouserepeat("script8799($string0, event_com, event_comsubid)", elr0_configure:prison_construction_layer);
$string0 = "Fire the cannon at Jed's ship for Firemaking XP.";
if_setonmouserepeat("script8799($string0, event_com, event_comsubid)", elr0_configure:cannon_firemaking_layer);
$string0 = "Aim the cannon at Jed's ship for Ranged XP.";
if_setonmouserepeat("script8799($string0, event_com, event_comsubid)", elr0_configure:cannon_ranged_layer);
