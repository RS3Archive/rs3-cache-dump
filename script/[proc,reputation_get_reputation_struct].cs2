// 13433
[proc,reputation_get_reputation_struct](int $int0)(struct)
def_struct $struct1 = null;
switch_int ($int0) {
    case 1 :
        $struct1 = menaphos_slave_faction;
    case 2 :
        $struct1 = menaphos_royal_faction;
    case 3 :
        $struct1 = menaphos_merchant_faction;
    case 4 :
        $struct1 = menaphos_sailor_faction;
    case 5 :
        $struct1 = menaphos_overall_faction;
    case 6 :
        $struct1 = farming_faction;
}
return($struct1);
