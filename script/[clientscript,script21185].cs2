// 21185
[clientscript,script21185](component $component0, component $component1, component $component2)
if (calc(%plugin_hub_last_search_clientclock + 250) > clientclock) {
    return;
}
if_setontimer(null, plugin_hub_parent_browse:search_listener);
if_setonpluginsearchevent(null, plugin_hub_parent_browse:search_listener);
if_sethide(false, plugin_hub_parent_browse:content);
~script21189($component0, $component1, $component2, "Plugin details can not be loaded at this time. Please try again later.");
