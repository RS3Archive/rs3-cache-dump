// 578
[proc,objdialog_doscrollbar]
def_int $int0 = if_getheight(objdialog:resultlist);
def_int $int1 = if_getscrollheight(objdialog:resultlist);
if ($int1 < $int0) {
    if_setscrollsize(0, 0, objdialog:resultlist);
    if_sethide(true, objdialog:resultscrollbar);
} else {
    if_sethide(false, objdialog:resultscrollbar);
}
def_int $int2 = calc($int1 - $int0);
if ($int2 < 0) {
    $int2 = 0;
}
def_int $int3 = if_getscrolly(objdialog:resultlist);
if ($int3 > $int2) {
    $int3 = $int2;
}
~scrollbar_resize(objdialog:resultscrollbar, objdialog:resultlist, $int3);
