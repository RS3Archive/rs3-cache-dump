// 6944
[proc,notes_scrollbar](int $int0, int $int1)
def_component $component2 = ~script7799($int0, notes:main);
def_component $component3 = ~script7799($int0, notes:drag);
def_component $component4 = ~script7799($int0, notes:scrollbar);
if (if_gethide($component4) = false) {
    if ($int1 < if_getheight($component2)) {
        if_setscrollsize(0, 0, $component2);
        if_setscrollpos(0, 0, $component2);
        if_sethide(true, $component4);
        if_setsize(8, 8, ^setsize_minus, ^setsize_minus, $component3);
    } else {
        if_setscrollsize(0, calc($int1 + 10), $component2);
        if_sethide(false, $component4);
        ~scrollbar_resize($component4, $component2, if_getscrolly($component2));
        if_setsize(24, 8, ^setsize_minus, ^setsize_minus, $component3);
    }
} else if ($int1 >= if_getheight($component2)) {
    if_setscrollsize(0, calc($int1 + 10), $component2);
    if_sethide(false, $component4);
    ~rs3_scrollbar_vertical($component4, $component2);
    if_setsize(24, 8, ^setsize_minus, ^setsize_minus, $component3);
}
