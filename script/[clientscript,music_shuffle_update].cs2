// 7641
[clientscript,music_shuffle_update](component $component0, component $component1)
if (%music_shuffle_toggle_varc ! 0 & %music_shuffle_toggle_varc ! 1) {
    %music_shuffle_toggle_varc = 0;
}
if (if_getgraphic($component0) ! "aif_shuffle_button,1" & if_getgraphic($component0) ! "aif_shuffle_button,3") {
    ~script7643($component0, $component1, 1);
    ~script8808;
} else {
    ~script7643($component0, $component1, 0);
}
