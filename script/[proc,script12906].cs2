if_sethide(true, trh109_potofgold_overlay:highlight3);
if_sethide(true, trh109_potofgold_overlay:highlight4);
if_sethide(true, trh109_potofgold_overlay:highlight5);
if_sethide(true, trh109_potofgold_overlay:highlight6);
