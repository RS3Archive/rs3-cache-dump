    case 3 :
        if_sethide(false, trh109_potofgold_overlay:highlight3);
    case 4 :
        if_sethide(false, trh109_potofgold_overlay:highlight4);
    case 5 :
        if_sethide(false, trh109_potofgold_overlay:highlight5);
    case 6 :
        if_sethide(false, trh109_potofgold_overlay:highlight6);
    case 7 :
