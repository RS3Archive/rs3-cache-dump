// 17236
[proc,script17236](dbrow $dbrow0)(string)
def_int $int1 = 0;
def_int $int2 = db_getfieldcount($dbrow0, requirements:col8);
def_achievement $achievement3 = null;
def_string $string0 = "";
while ($int1 < $int2) {
    $achievement3 = db_getfield($dbrow0, requirements:col8, $int1);
    if (achievement_reqstate($achievement3) ! -2) {
        $string0 = ~script17238($string0, "Complete achievement: <achievement_getname($achievement3)>");
    }
    $int1 = calc($int1 + 1);
}
return($string0);
