// 2883
[clientscript,script2883](component $component0)
if (%music_v3_protect = 1 | %cutscene_status = 1) {
    return;
}
if (if_getgraphic($component0) ! "aif_music_header_buttons,10" & if_getgraphic($component0) ! "aif_music_header_buttons,9") {
    if_setgraphic("aif_music_header_buttons,10", $component0);
}
~script8800("Clear playlist", $component0, -1);
