// 18490
[proc,script18490](string $string0, component $component0, component $component1)
if ($component0 ! null) {
    if_settext($string0, $component0);
    if (map_lang ! 0 | string_length($string0) > 30) {
        if_settextfont(fontmetrics_57, $component0);
    } else {
        if_settextfont(fontmetrics_58, $component0);
    }
}
def_string $string1 = "";
if ($component1 ! null) {
    $string1 = "<$string0>/Quick guide";
    if_setonbuttonpressed("wiki($string1)", $component1);
} else if ($component0 = interface_1500:com_21) {
    if_sethide(true, interface_1500:com_2);
    if_sethide(true, interface_1500:com_14);
    if_sethide(true, interface_1500:com_7);
}
