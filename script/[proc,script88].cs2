// 88
[proc,script88](int $int0)(dbfilter)
def_dbfilter $dbfilter1 = null;
switch_int ($int0) {
    case 1 :
        $dbfilter1 = db_filter_value(pvm_portal_destination:col6, 1, ^filterop_eq, 0);
    case 2, 3 :
        $dbfilter1 = db_filter_value(pvm_portal_destination:col6, 2, ^filterop_eq, 0);
    case default :
        error("PVM portal ID <tostring($int0)> is missing from switch case.");
}
return($dbfilter1);
