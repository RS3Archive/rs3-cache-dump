[clientscript,script2665]
def_component $component0 = enum(int, component, mah3_active_strip, %mah3_strip_select);
if ($component0 = null) {
    return;
}
if (if_gety($component0) > -13) {
    sound_vorbis_volume(mah5_decoder_slide, 1, 0, 50);
    if_setposition(if_getx($component0), calc(if_gety($component0) - 2), ^setpos_abs_left, ^setpos_abs_top, $component0);
}
