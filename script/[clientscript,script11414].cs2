// 11414
[clientscript,script11414]
if (%overload_type = 0) {
    if (stat(ranged) > stat_base(ranged)) {
        ~script10624(combatv2_ranged_boosted_dummy_ability, 1);
        ~script10624(combatv2_ranged_nerfed_dummy_ability, 0);
        return;
    } else if (stat(ranged) < stat_base(ranged)) {
        ~script10624(combatv2_ranged_boosted_dummy_ability, 0);
        ~script10624(combatv2_ranged_nerfed_dummy_ability, 1);
        return;
    }
}
~script10624(combatv2_ranged_boosted_dummy_ability, 0);
~script10624(combatv2_ranged_nerfed_dummy_ability, 0);
