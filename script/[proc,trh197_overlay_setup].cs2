// 18831
[proc,trh197_overlay_setup]
cc_deleteall(wheel_of_fortune:fake_op);
def_int $int0 = -1;
while (++$int0 <= 3) {
    cc_create(wheel_of_fortune:fake_op, ^iftype_graphic, $int0);
}
def_component $component1 = null;
$int0 = 0;
while (++$int0 <= 3) {
    switch_int ($int0) {
        case 1 :
            $component1 = trh197_overlay:chest_1_model;
        case 2 :
            $component1 = trh197_overlay:chest_2_model;
        case 3 :
            $component1 = trh197_overlay:chest_3_model;
    }
    if_setontimer("script18832(clientclock, $component1)", $component1);
    if_setmodel(mtx_chest_basic, $component1);
}
