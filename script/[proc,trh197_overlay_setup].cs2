// 18831
[proc,trh197_overlay_setup]
cc_deleteall(interface_1253:com_556);
def_int $int0 = -1;
while (++$int0 <= 3) {
    cc_create(interface_1253:com_556, ^iftype_graphic, $int0);
}
def_component $component1 = null;
$int0 = 0;
while (++$int0 <= 3) {
    switch_int ($int0) {
        case 1 :
            $component1 = interface_1282:com_21;
        case 2 :
            $component1 = interface_1282:com_22;
        case 3 :
            $component1 = interface_1282:com_23;
    }
    if_setontimer("script18832(clientclock, $component1)", $component1);
    if_setmodel(model_126627, $component1);
}
