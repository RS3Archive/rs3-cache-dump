// 18885
[clientscript,script18885]
if (if_find(calendar_main:today_text) = true) {
    ~cc_set_stylesheet_text(text_body_emphasis, 0, 0);
    cc_setcolour(~script10495(0));
    cc_settextalign(^settextalign_centre, ^settextalign_centre, 0);
}
if (if_find(calendar_main:today_view_button) = true) {
    ~cc_set_stylesheet(button_action_neutral);
}
~script18887;
