// 4757
[clientscript,script4757](component $component0)
def_int $int1 = scale(16384, 5000, %eva_hp);
$int1 = min(max($int1, 0), 16384);
if_setsize($int1, 0, ^setsize_rel, ^setsize_minus, slug3_hero_overlay:eva_large_progress_value_layer);
if_settext(tostring(%eva_hp), $component0);
if (%eva_hp <= 1000) {
    if_setcolour(0xff2266, slug3_hero_overlay:eva_healthbar_left);
    if_setcolour(0xff2266, slug3_hero_overlay:eva_healthbar_mid);
    if_setcolour(0xff2266, slug3_hero_overlay:eva_healthbar_right);
    if_setmodelanim(slug3_human_chathead_fear_no_talking, slug3_hero_overlay:eva_head);
} else {
    if_setcolour(^white, slug3_hero_overlay:eva_healthbar_left);
    if_setcolour(^white, slug3_hero_overlay:eva_healthbar_mid);
    if_setcolour(^white, slug3_hero_overlay:eva_healthbar_right);
    if_setmodelanim(human_update_chathead_neutral_idle, slug3_hero_overlay:eva_head);
}
