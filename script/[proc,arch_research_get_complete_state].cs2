// 14630
[proc,arch_research_get_complete_state](dbrow $dbrow0)(int)
if ($dbrow0 = null) {
    return(1);
}
def_int $int1 = db_getfield($dbrow0, arch_research:col0, 0);
if ($int1 < 0) {
    return(1);
}
switch_int (calc($int1 / 32)) {
    case 0 :
        return(testbit(%arch_research_complete_1, calc($int1 % 32)));
    case 1 :
        return(testbit(%arch_research_complete_2, calc($int1 % 32)));
    case 2 :
        return(testbit(%arch_research_complete_3, calc($int1 % 32)));
}
return(0);
