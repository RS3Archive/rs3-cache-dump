// 20521
[clientscript,script20521]
if (if_getheight(interface_1475:com_51) >= 404) {
    if_setop(1, "Expand", interface_1475:com_57);
    if_setvflip(false, interface_1475:com_58);
    ~script14092(interface_1475:com_51, -1, 150, ^setsize_abs, 60, ^setsize_abs, 20, 0);
} else {
    if_setop(1, "Collapse", interface_1475:com_57);
    if_setvflip(true, interface_1475:com_58);
    ~script14092(interface_1475:com_51, -1, 450, ^setsize_abs, 404, ^setsize_abs, 20, 0);
}
