// 20521
[clientscript,script20521]
if (if_getheight(toplevel_v2_edit_mode:edit_mode_window) >= 404) {
    if_setop(1, "Expand", toplevel_v2_edit_mode:collapse_button);
    if_setvflip(false, toplevel_v2_edit_mode:collapse_sprite);
    ~script14092(toplevel_v2_edit_mode:edit_mode_window, -1, 150, ^setsize_abs, 60, ^setsize_abs, 20, 0);
} else {
    if_setop(1, "Collapse", toplevel_v2_edit_mode:collapse_button);
    if_setvflip(true, toplevel_v2_edit_mode:collapse_sprite);
    ~script14092(toplevel_v2_edit_mode:edit_mode_window, -1, 450, ^setsize_abs, 404, ^setsize_abs, 20, 0);
}
