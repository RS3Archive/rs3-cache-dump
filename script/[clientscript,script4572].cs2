// 4572
[clientscript,script4572](int $int0, component $component1, component $component2)
if (clan_getchatcount <= 0) {
    if_settext("Tap here to chat", $component1);
    if_sethide(true, $component2);
    return;
}
if (calc((clientclock - $int0) % 40) < 20 & applet_hasfocus = true) {
    if_sethide(false, $component2);
} else {
    if_sethide(true, $component2);
}
