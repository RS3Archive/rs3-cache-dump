// 2269
[proc,script2269]
def_int $int0 = %pop_captain_selected;
def_model $model1 = null;
def_model $model2 = null;
def_model $model3 = null;
def_int $int4 = -1;
def_int $int5 = 0;
def_int $int6 = 0;
def_int $int7 = 0;
switch_int ($int0) {
    case 1 :
        $int4 = %pop_captain_1_gender;
        $int5 = %pop_captain_1_body;
        $int6 = %pop_captain_1_legs;
        $int7 = %pop_captain_1_head;
    case 2 :
        $int4 = %pop_captain_2_gender;
        $int5 = %pop_captain_2_body;
        $int6 = %pop_captain_2_legs;
        $int7 = %pop_captain_2_head;
    case 3 :
        $int4 = %pop_captain_3_gender;
        $int5 = %pop_captain_3_body;
        $int6 = %pop_captain_3_legs;
        $int7 = %pop_captain_3_head;
    case 4 :
        $int4 = %pop_captain_4_gender;
        $int5 = %pop_captain_4_body;
        $int6 = %pop_captain_4_legs;
        $int7 = %pop_captain_4_head;
    case 5 :
        $int4 = %pop_captain_5_gender;
        $int5 = %pop_captain_5_body;
        $int6 = %pop_captain_5_legs;
        $int7 = %pop_captain_5_head;
    case 6 :
        $int4 = %pop_captain_n_gender;
        $int5 = %pop_captain_n_body;
        $int6 = %pop_captain_n_legs;
        $int7 = %pop_captain_n_head;
}
if ($int4 = 0) {
    $model1 = enum(int, model, pop_uniform_hat_male, $int7);
    $model2 = enum(int, model, pop_captain_body, $int5);
    $model3 = enum(int, model, pop_captain_legs, $int6);
} else {
    $model1 = enum(int, model, pop_uniform_hat_female, $int7);
    $model2 = enum(int, model, pop_captain_body_female, $int5);
    $model3 = enum(int, model, pop_captain_legs_female, $int6);
}
if_setmodel($model1, pop_captain_customise:hat);
if_setmodel($model2, pop_captain_customise:torso);
if_setmodel($model3, pop_captain_customise:legs);
