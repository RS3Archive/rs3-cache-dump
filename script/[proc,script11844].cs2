// 11844
[proc,script11844](int $int0)(seq)
def_seq $seq1 = mtx93_alec_showcase_player_hunter_idle;
def_obj $obj2 = inv_getobj(worn_display_preview, 3);
if (%mtx_skill_anim_walk_override ! 7 & $int0 = 0 | %mtx_skill_anim_walk_override = 7 & $int0 = 1) {
    if ($int0 = 1) {
        if ($obj2 ! null) {
            return(bas_getanim_ready(struct_param(oc_param($obj2, weapon_category), combatv2_casual_bas)));
        } else {
            return(bas_getanim_ready(default_human));
        }
    }
    return(null);
}
if ($obj2 ! null) {
    switch_struct (oc_param($obj2, weapon_category)) {
        case combatv2_weapon_bow, combatv2_weapon_chargebow :
            $seq1 = mtx93_alec_showcase_player_hunter_idle;
        case combatv2_weapon_2hsword :
            $seq1 = mtx93_alec_showcase_player_hunter_idle_two_handed;
        case combatv2_weapon_staff, combatv2_weapon_maul, combatv2_weapon_spear, combatv2_weapon_halberd :
            $seq1 = mtx93_alec_showcase_player_hunter_maul_idle;
        case combatv2_weapon_2hxbow :
            $seq1 = mtx93_alec_showcase_player_hunter_two_handed_crossbow_idle;
        case default :
            $seq1 = mtx93_alec_showcase_player_hunter_idle_dual;
    }
} else {
    $seq1 = mtx93_alec_showcase_player_hunter_idle_dual;
}
if (oc_param(inv_getobj(worn_display_preview, 5), combatv2_item_is_shield) = 1) {
    $seq1 = mtx93_alec_showcase_player_hunter_idle;
}
return($seq1);
