// 19085
[clientscript,script19085](int $int0, int $int1)
if (cc_findbycategory(trh199_overlay:blueprint_grid, $int0, $int1) = 1) {
    switch_graphic (cc_getgraphic) {
        case trh199_blueprint_incomplete_over :
            cc_setgraphic(trh199_blueprint_incomplete);
        case trh199_blueprint_complete_over :
            cc_setgraphic(trh199_blueprint_complete);
        case trh199_blueprint_locked_over :
            cc_setgraphic(trh199_blueprint_locked);
    }
}
