// 11124
[clientscript,script11124]
def_component $component0 = easter15_hatching:distraction_layer;
if_setontimer("script11129(event_com)", $component0);
cc_deleteall($component0);
def_int $int1 = 0;
while ($int1 < 3) {
    cc_create($component0, ^iftype_graphic, $int1);
    cc_setop(1, "Remove Distraction");
    cc_setonop("cc_sethide(true, event_com, $int1)");
    cc_setsize(64, 64, ^setsize_abs, ^setsize_abs);
    cc_sethide(true);
    $int1 = calc($int1 + 1);
}
