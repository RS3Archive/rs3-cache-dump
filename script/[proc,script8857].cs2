// 8857
[proc,script8857]
if (%wishing_well_player_donation_millions = 0) {
    if (%wishing_well_player_donation_remainder = 1) {
        if_settext("<tostring_localised(%wishing_well_player_donation_remainder, true)> coin", donation:player_donation_so_far);
    } else {
        if_settext("<tostring_localised(%wishing_well_player_donation_remainder, true)> coins", donation:player_donation_so_far);
    }
} else if (%wishing_well_player_donation_remainder > 0) {
    if (%wishing_well_player_donation_millions = 1) {
        if_settext("<tostring_localised(%wishing_well_player_donation_millions, true)> Million<br><tostring_localised(%wishing_well_player_donation_remainder, true)> Coins", donation:player_donation_so_far);
    }
    if_settext("<tostring_localised(%wishing_well_player_donation_millions, true)> Million<br><tostring_localised(%wishing_well_player_donation_remainder, true)> Coins", donation:player_donation_so_far);
} else {
    if_settext("<tostring_localised(%wishing_well_player_donation_millions, true)> Million", donation:player_donation_so_far);
}
