// 5816
[clientscript,script5816]
if (if_gethide(pop_ship:list_layer) = false) {
    switch_int (%pop_ship_slot_selected) {
        case 5 :
            if_setgraphic("aif_pop_hotspot_icons,11", pop_ship:ram_target);
            if_setgraphic("aif_pop_hotspot_icons,2", pop_ship:deck1_target);
            if_setgraphic("aif_pop_hotspot_icons,3", pop_ship:deck2_target);
            if_setgraphic("aif_pop_hotspot_icons,4", pop_ship:rudder_target);
            if_setgraphic("aif_pop_hotspot_icons,0", pop_ship:hull_target);
        case 2 :
            if_setgraphic("aif_pop_hotspot_icons,12", pop_ship:deck1_target);
            if_setgraphic("aif_pop_hotspot_icons,1", pop_ship:ram_target);
            if_setgraphic("aif_pop_hotspot_icons,3", pop_ship:deck2_target);
            if_setgraphic("aif_pop_hotspot_icons,4", pop_ship:rudder_target);
            if_setgraphic("aif_pop_hotspot_icons,0", pop_ship:hull_target);
        case 3 :
            if_setgraphic("aif_pop_hotspot_icons,13", pop_ship:deck2_target);
            if_setgraphic("aif_pop_hotspot_icons,1", pop_ship:ram_target);
            if_setgraphic("aif_pop_hotspot_icons,2", pop_ship:deck1_target);
            if_setgraphic("aif_pop_hotspot_icons,4", pop_ship:rudder_target);
            if_setgraphic("aif_pop_hotspot_icons,0", pop_ship:hull_target);
        case 4 :
            if_setgraphic("aif_pop_hotspot_icons,14", pop_ship:rudder_target);
            if_setgraphic("aif_pop_hotspot_icons,1", pop_ship:ram_target);
            if_setgraphic("aif_pop_hotspot_icons,2", pop_ship:deck1_target);
            if_setgraphic("aif_pop_hotspot_icons,3", pop_ship:deck2_target);
            if_setgraphic("aif_pop_hotspot_icons,0", pop_ship:hull_target);
        case 1 :
            if_setgraphic("aif_pop_hotspot_icons,10", pop_ship:hull_target);
            if_setgraphic("aif_pop_hotspot_icons,1", pop_ship:ram_target);
            if_setgraphic("aif_pop_hotspot_icons,2", pop_ship:deck1_target);
            if_setgraphic("aif_pop_hotspot_icons,3", pop_ship:deck2_target);
            if_setgraphic("aif_pop_hotspot_icons,4", pop_ship:rudder_target);
    }
}
