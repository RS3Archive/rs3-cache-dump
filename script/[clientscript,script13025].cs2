// 13025
[clientscript,script13025](component $component0)
if (%music_v3_protect = 1 | %cutscene_status = 1) {
    return;
}
switch_int (%music_filter_toggle_varc) {
    case default :
        ~script8800("Show unlocked tracks only", $component0, -1);
        if_setgraphic("aif_music_filter_buttons,1", $component0);
    case 1 :
        ~script8800("Show locked tracks only", $component0, -1);
        if_setgraphic("aif_music_filter_buttons,3", $component0);
    case 2 :
        ~script8800("Show all tracks", $component0, -1);
        if_setgraphic("aif_music_filter_buttons,5", $component0);
}
