// 1137
[proc,script1137]
if (%pop_crew_rerolls <= 0) {
    ~script13960(pop_crew:reroll_icon_1, rs3tli_lobby_refresh_icons, true, 0);
    ~script13960(pop_crew:reroll_icon_2, rs3tli_lobby_refresh_icons, true, 0);
    ~script13960(pop_crew:reroll_icon_3, rs3tli_lobby_refresh_icons, true, 0);
} else {
    ~script13960(pop_crew:reroll_icon_1, rs3tli_lobby_refresh_icons, false, 0);
    ~script13960(pop_crew:reroll_icon_2, rs3tli_lobby_refresh_icons, false, 0);
    ~script13960(pop_crew:reroll_icon_3, rs3tli_lobby_refresh_icons, false, 0);
}
if (%pop_port_item_3_quantity <= 0) {
    ~script13960(pop_crew:reroll_icon_0, rs3tli_lobby_refresh_icons, true, 0);
} else {
    ~script13960(pop_crew:reroll_icon_0, rs3tli_lobby_refresh_icons, false, 0);
}
if (%pop_port_item_1_quantity < 1 | %pop_crew_rerolls > 10) {
    if_sethide(false, pop_crew:add_crew_no);
} else {
    if_sethide(true, pop_crew:add_crew_no);
}
