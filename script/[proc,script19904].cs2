// 19904
[proc,script19904]
if_setnpcmodel(trh189_solar, trh189_overlay:skin_select_model_1);
if_setnpcmodel(trh189_evil_necromancer, trh189_overlay:skin_select_model_2);
if_setnpcmodel(trh189_evil_phoenix_knight, trh189_overlay:skin_select_model_3);
if_setmodelangle(0, 120, 0, -266, 0, 500, trh189_overlay:skin_select_model_1);
if_setmodelangle(0, 120, 0, 0, 0, 500, trh189_overlay:skin_select_model_2);
if_setmodelangle(0, 120, 0, 266, 0, 500, trh189_overlay:skin_select_model_3);
if_setmodelanim(combat_2012_combat_ready, trh189_overlay:skin_select_model_1);
if_setmodelanim(combat_2012_combat_ready, trh189_overlay:skin_select_model_2);
if_setmodelanim(combat_2012_combat_ready_mirrored, trh189_overlay:skin_select_model_3);
if_settext("Solstice", trh189_overlay:skin_select_title_1);
if_settext("Soul", trh189_overlay:skin_select_title_2);
if_settext("Phoenix", trh189_overlay:skin_select_title_3);
if_settext("Select a Showdown to fight for different cosmetics.", trh189_overlay:skin_select_info_text_1);
if_settext("You can change Showdowns at any time.", trh189_overlay:skin_select_info_text_2);
