// 20546
[proc,script20546](dbrow $dbrow0)(string)
switch_dbrow ($dbrow0) {
    case mobile_shop_bond_1_v2 :
        return("1 Bond");
    case mobile_shop_bond_3_v2 :
        return("3 Bonds");
    case mobile_shop_bond_5_v2 :
        return("5 Bonds");
    case mobile_shop_bond_10_v2 :
        return("10 Bonds");
    case mobile_shop_membership_1_month_v2 :
        return("1 month subscription");
    case mobile_shop_premier_membership_12_month_v2 :
        return("12 Months Membership");
    case default :
        return(db_getfield($dbrow0, mobile_shop_feature_information:col7, 0));
}
