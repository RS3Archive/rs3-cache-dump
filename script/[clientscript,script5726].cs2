        spline_addpoint(0, 0, movecoord($coord1, 34, 0, 52), 300, movecoord($coord1, 34, 0, 52), 300, 0);
        spline_addpoint(0, 1, movecoord($coord1, 34, 0, 52), 300, movecoord($coord1, 34, 0, 52), 300, 0);
        spline_addpoint(1, 0, movecoord($coord1, 30, 0, 51), 150, movecoord($coord1, 30, 0, 51), 150, 0);
        spline_addpoint(1, 1, movecoord($coord1, 30, 0, 51), 150, movecoord($coord1, 30, 0, 51), 150, 0);
        cam_movealong(0, 0, 50, 0, 1, 0);
    case 5 :
