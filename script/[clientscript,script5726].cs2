        spline_addpoint(0, 0, movecoord($coord1, 32, 0, 47), 350, movecoord($coord1, 32, 0, 47), 400, 0);
        spline_addpoint(0, 1, movecoord($coord1, 32, 0, 47), 350, movecoord($coord1, 32, 0, 47), 400, 0);
