// 12990
[clientscript,script12990]
switch_int (%quest_endgame_choice_6awe1_choice) {
    case 0 :
        if_sethide(true, quest_endgame_replay:saradomin_checkbox_selected_layer);
        if_sethide(true, quest_endgame_replay:zamorak_checkbox_selected_layer);
    case 1 :
        if_sethide(false, quest_endgame_replay:saradomin_checkbox_selected_layer);
        if_sethide(true, quest_endgame_replay:zamorak_checkbox_selected_layer);
    case 2 :
        if_sethide(true, quest_endgame_replay:saradomin_checkbox_selected_layer);
        if_sethide(false, quest_endgame_replay:zamorak_checkbox_selected_layer);
}
