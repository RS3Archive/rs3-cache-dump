            $string3 = "Treasure Hunter is not available at the moment. Please try later.";
        case 10 :
            $string2 = "Loading...";
            $string3 = "Loading...";
    }
}
if_setop(1, $string1, interface_1253:com_278);
if_setenabled($boolean2, interface_1253:com_278);
if ($boolean2 = true) {
