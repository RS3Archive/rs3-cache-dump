// 9719
[proc,wof_button_setup_claim_bank](obj $obj0, int $int1)
if (%varclient_4079 = -1) {
    return;
}
def_string $string0 = "Bank";
def_string $string1 = "Claim to bank";
def_boolean $boolean2 = false;
def_string $string2 = "You do not have a prize to claim.";
def_string $string3 = "You do not have a prize to claim.";
if (%varplayerbit_4323 <= 0) {
    $string2 = "You do not have a prize to claim.";
    $string3 = "You do not have a prize to claim.";
    $boolean2 = false;
} else {
    $string1 = "Claim to bank";
    switch_int (%varclient_4079) {
        case 3 :
            if (oc_members($obj0) = 1 & map_members = false) {
                $string2 = "Claim your prize to your bank. This is a members-only prize, so you will need to subscribe to use it.";
            } else {
                $string2 = "Claim your prize to your bank.";
            }
            $boolean2 = true;
        case 4 :
