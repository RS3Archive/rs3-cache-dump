// 9101
[proc,script9101](struct $struct0)(struct)
if ($struct0 = null) {
    return(null);
}
if (struct_param($struct0, combatv2_tiered_prayer) = 1) {
    if (stat_base(prayer) >= struct_param($struct0, combatv2_tier3_level)) {
        return(struct_param($struct0, combatv2_tier3_struct));
    } else if (stat_base(prayer) >= struct_param($struct0, combatv2_tier2_level)) {
        return(struct_param($struct0, combatv2_tier2_struct));
    } else {
        return(struct_param($struct0, combatv2_tier1_struct));
    }
}
return($struct0);
