// 43
[clientscript,trail_reward_generation]
def_int $int0 = 0;
def_int $int1 = 0;
def_string $string0 = "";
while ($int0 < inv_size(trail_rewardinv)) {
    cc_create(trail_reward:trail_reward_box, ^iftype_graphic, $int0);
    cc_setsize(36, 32, ^setsize_abs, ^setsize_abs);
    cc_setposition(calc(10 + 40 * $int1), 10, ^setpos_abs_left, ^setpos_abs_top);
    if (inv_getobj(trail_rewardinv, $int0) ! null) {
        cc_setobject(inv_getobj(trail_rewardinv, $int0), inv_getnum(trail_rewardinv, $int0));
        cc_setopbase("<col=ff9040><oc_name(inv_getobj(trail_rewardinv, $int0))>");
        cc_setop(1, "Examine");
        cc_setoutline(1);
        cc_setonmouserepeat("script5495(inv_getobj(trail_rewardinv, $int0))");
        cc_setonmouseleave("script9300(event_com, event_comsubid)");
    }
    $int0 = calc($int0 + 1);
    $int1 = calc($int1 + 1);
}
