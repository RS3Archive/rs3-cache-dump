// 14028
[clientscript,script14028]
def_component $component0 = clue_stats:mainmodal_window_content;
cc_deleteall($component0);
def_int $int1 = -1;
def_int $int2 = 0;
def_string $string0 = "";
def_string $string1 = "";
def_string $string2 = "";
def_string $string3 = "";
def_int $int3 = ~script3864;
def_int $int4 = 3;
while (++$int1 < 5) {
    switch_int ($int1) {
        case 0 :
            $string0 = "Easy Treasure Trails";
            $string1 = "Clues completed: <tostring_localised(%trail_easy_clues_completed, true)>";
            $string2 = "Rerolls available: <tostring(%trail_easy_rerolls_available)>/<tostring($int3)>";
            $string3 = "Progress to reroll: <tostring(%trail_easy_reroll_progress)>/<tostring($int4)>";
        case 1 :
            $string0 = "Medium Treasure Trails";
            $string1 = "Clues completed: <tostring_localised(%trail_medium_clues_completed, true)>";
            $string2 = "Rerolls available: <tostring(%trail_medium_rerolls_available)>/<tostring($int3)>";
            $string3 = "Progress to reroll: <tostring(%trail_medium_reroll_progress)>/<tostring($int4)>";
        case 2 :
            $string0 = "Hard Treasure Trails";
            $string1 = "Clues completed: <tostring_localised(%trail_hard_clues_completed, true)>";
            $string2 = "Rerolls available: <tostring(%trail_hard_rerolls_available)>/<tostring($int3)>";
            $string3 = "Progress to reroll: <tostring(%trail_hard_reroll_progress)>/<tostring($int4)>";
        case 3 :
            $string0 = "Elite Treasure Trails";
            $string1 = "Clues completed: <tostring_localised(%trail_elite_clues_completed, true)>";
            $string2 = "Rerolls available: <tostring(%trail_elite_rerolls_available)>/<tostring($int3)>";
            $string3 = "Progress to reroll: <tostring(%trail_elite_reroll_progress)>/<tostring($int4)>";
        case 4 :
            $string0 = "Master Treasure Trails";
            $string1 = "Clues completed: <tostring_localised(%trail_master_clues_completed, true)>";
            $string2 = "Rerolls available: <tostring(%trail_master_rerolls_available)>/<tostring($int3)>";
            $string3 = "Progress to reroll: <tostring(%trail_master_reroll_progress)>/<tostring($int4)>";
    }
    $int2 = calc(5 + $int1 * 70);
    cc_create($component0, ^iftype_text, if_getnextsubid($component0));
    cc_setsize(0, 18, ^setsize_minus, ^setsize_abs);
    cc_setposition(0, $int2, ^setpos_abs_centre, ^setpos_abs_top);
    cc_settextfont(museo_sans_13pt_regular);
    cc_setcolour(~script10495(1));
    cc_settext($string0);
    cc_settextalign(^settextalign_centre, ^settextalign_centre, 0);
    cc_create($component0, ^iftype_text, if_getnextsubid($component0));
    cc_setsize(0, 15, ^setsize_minus, ^setsize_abs);
    cc_setposition(0, calc($int2 + 18), ^setpos_abs_centre, ^setpos_abs_top);
    cc_settextfont(museo_sans_11pt_regular);
    cc_setcolour(~script10495(3));
    cc_settext($string1);
    cc_settextalign(^settextalign_centre, ^settextalign_centre, 0);
    cc_create($component0, ^iftype_text, if_getnextsubid($component0));
    cc_setsize(0, 15, ^setsize_minus, ^setsize_abs);
    cc_setposition(0, calc($int2 + 33), ^setpos_abs_centre, ^setpos_abs_top);
    cc_settextfont(museo_sans_11pt_regular);
    cc_setcolour(~script10495(3));
    cc_settext($string2);
    cc_settextalign(^settextalign_centre, ^settextalign_centre, 0);
    cc_create($component0, ^iftype_text, if_getnextsubid($component0));
    cc_setsize(0, 15, ^setsize_minus, ^setsize_abs);
    cc_setposition(0, calc($int2 + 48), ^setpos_abs_centre, ^setpos_abs_top);
    cc_settextfont(museo_sans_11pt_regular);
    cc_setcolour(~script10495(3));
    cc_settext($string3);
    cc_settextalign(^settextalign_centre, ^settextalign_centre, 0);
}
