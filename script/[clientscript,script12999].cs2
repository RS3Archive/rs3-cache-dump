    if_setcolour(~rgb_to_hex($int3, $int4, 0), interface_1819:com_7);
} else if ($int2 > $int0) {
    if ($int2 > calc($int0 + 10)) {
        $int5 = 5;
    }
    if_setsize(calc($int2 - $int5), 19, ^setsize_abs, ^setsize_abs, interface_1819:com_1);
