// 16181
[clientscript,script16181](component $component0, int $int1)
if (if_find($component0) = true) {
    cc_setontimer("script12631($component0, -1)");
    cc_setparam(rs3tli_component_oscillation_offset_max, 4);
    switch_int ($int1) {
        case 1, 2 :
            cc_setparam(rs3tli_component_oscillation_type, 2);
        case 4, 5 :
            cc_setparam(rs3tli_component_oscillation_type, 2);
            cc_setparam(rs3tli_component_oscillation_flip_y, true);
        case 7, 8 :
            cc_setparam(rs3tli_component_oscillation_type, 2);
            cc_setparam(rs3tli_component_oscillation_flip_x, true);
            cc_setparam(rs3tli_component_oscillation_flip_y, true);
        case 10, 11 :
            cc_setparam(rs3tli_component_oscillation_type, 2);
            cc_setparam(rs3tli_component_oscillation_flip_x, true);
        case 6 :
            cc_setparam(rs3tli_component_oscillation_type, 0);
            cc_setparam(rs3tli_component_oscillation_flip_y, true);
        case 12 :
            cc_setparam(rs3tli_component_oscillation_type, 0);
        case 3 :
            cc_setparam(rs3tli_component_oscillation_type, 1);
        case 9 :
            cc_setparam(rs3tli_component_oscillation_type, 1);
            cc_setparam(rs3tli_component_oscillation_flip_x, true);
    }
}
