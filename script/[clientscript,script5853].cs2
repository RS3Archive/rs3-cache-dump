// 5853
[clientscript,script5853](component $component0, int $int1)
if ($int1 < 90) {
    $int1 = calc($int1 + 1);
    if_setposition(0, $int1, ^setpos_abs_right, ^setpos_abs_bottom, $component0);
    if_settrans(calc(if_gettrans($component0) + 2), $component0);
    if_setontimer("script5853($component0, $int1)", $component0);
} else {
    if_setontimer(null, $component0);
    if_sethide(true, $component0);
}
