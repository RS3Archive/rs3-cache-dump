// 20400
[proc,script20400](struct $struct0, string $string0, int $int1)(string)
$string0 = "<$string0><br>- <~script17720($struct0, 80, calc(80 + 20), 0, $int1)> on first and second hit.";
$string0 = "<$string0><br>- <col=ffffff>+<tostring(calc(250 / 10))>%</col> Increased <col=ffffff>Critical Strike Chance</col> & <col=ffffff>Critical Strike Damage</col> on the first and second hits.";
$string0 = "<$string0><br>- <~script17720($struct0, 150, calc(150 + 30), 0, $int1)> on third hit.";
$string0 = "<$string0><br>- <col=ffffff>+<tostring(calc(500 / 10))>%</col> Increased <col=ffffff>Critical Strike Chance</col> & <col=ffffff>Critical Strike Damage</col> on the third hit.";
$string0 = "<$string0><br>- <col=ffffff><tostring(3)></col> hits.";
return($string0);
