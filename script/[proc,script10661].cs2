// 10661
[proc,script10661](component $component0, component $component1)
if (%tzkiln_current_wave < 1 | %tzkiln_current_wave > 37) {
    if_sethide(true, $component0);
    if_sethide(true, $component1);
    return;
}
if (%tzkiln_current_wave = 37) {
    if_settext("Har-Aken", $component1);
} else {
    if_settext("Wave <tostring(%tzkiln_current_wave)>", $component1);
}
if_sethide(false, $component0);
if_sethide(false, $component1);
