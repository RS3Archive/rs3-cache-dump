// 14005
[clientscript,script14005]
if (%costume_room_opened_from_bank = 1) {
    if_setsize(0, 140, ^setsize_minus, ^setsize_minus, poh_costume_room:set_area);
    if_sethide(false, poh_costume_room:bank_container);
} else {
    if_setsize(0, 85, ^setsize_minus, ^setsize_minus, poh_costume_room:set_area);
    if_sethide(true, poh_costume_room:bank_container);
}
