// 16972
[clientscript,script16972]
if_setmodelanim(trh188_chest_sfx_selected, trh188:cauldron_model);
switch_int (random(5)) {
    case 0 :
        sound_vorbis_rate(mtx36_player_magic_cooking_pot_lid_1, 1, 0, 80, random_sound_pitch(20, 20));
    case 1 :
        sound_vorbis_rate(mtx36_player_magic_cooking_pot_lid_2, 1, 0, 80, random_sound_pitch(20, 20));
    case 2 :
        sound_vorbis_rate(mtx36_player_magic_cooking_pot_lid_3, 1, 0, 50, random_sound_pitch(20, 20));
    case 3 :
        sound_vorbis_rate(mtx36_player_magic_cooking_pot_lid_2, 1, 0, 80, random_sound_pitch(20, 20));
    case 4 :
        sound_vorbis_rate(mtx36_player_magic_cooking_pot_lid_1, 1, 0, 30, random_sound_pitch(20, 20));
}
