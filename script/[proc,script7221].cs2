// 7221
[proc,script7221](obj $obj0)(string)
switch_obj ($obj0) {
    case obj_48105 :
        return("A totem that decreases clue scrolls by 1 step.");
    case obj_48109 :
        return("A totem that changes the winds to help port ships return from voyages quicker.");
    case obj_48113 :
        return("A totem that helps see off the gaze of Elven clan workers 25% quicker.");
    case obj_48117 :
        return("A totem that connects to the Abyss to allow teleportation to itself.");
    case obj_48121 :
        return("A totem that satisfies a lust for blood at the God Wars Dungeon, allowing kill count to be skipped.");
    case obj_48125 :
        return("A totem that helps to keep familiars summoned for <tostring(16)> minutes longer.");
    case obj_48129 :
        return("A totem that helps to increase the players health by 25% to a maximum of 1,500 extra.");
    case obj_50421 :
        return("A totem used to build a remote totem access point in the Anachronia base camp.");
}
