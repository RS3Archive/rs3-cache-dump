switch_npc ($npc0) {
    case npc_17399, npc_17400, npc_17401, npc_17402, npc_17406, npc_17407, npc_17405, npc_17403, npc_17404 :
        switch_int (%varplayerbit_18580) {
            case 12, 13, 14 :
                $int1 = calc($int1 + 4);
            case 15, 16, 17 :
                $int1 = calc($int1 + 18);
        }
}
if (nc_param($npc0, param_5048) = 1) {
    $int1 = %varplayerbit_27748;
}
return($int1);
