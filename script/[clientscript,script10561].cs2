// 10561
[clientscript,script10561](component $component0)
def_int $int1 = 0;
def_int $int2 = 0;
def_obj $obj3 = null;
while ($int1 < 20) {
    $obj3 = enum(int, obj, runemach_int_to_rune, $int1);
    $int2 = calc(inv_total(inv, $obj3) + inv_total(bank, $obj3));
    if (cc_find($component0, $int1) = true) {
        if ($int2 = 0 | %runemach_selected_1 = $int1 | %runemach_selected_2 = $int1 | %runemach_selected_3 = $int1) {
            cc_settrans(120);
        } else {
            cc_settrans(0);
        }
    }
    $int1 = calc($int1 + 1);
}
