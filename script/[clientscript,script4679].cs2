// 4679
[clientscript,script4679]
if (enum(int, int, deadly_hunting_energydrainrate, %deadly_hunting_side_state) < 1) {
    if_sethide(true, deadly_hunting_side:energy_layer);
    if_settext("Difficulty: <tostring(%deadly_hunting_side_state)>/10", deadly_hunting_side:difficulty_text);
} else {
    if_sethide(false, deadly_hunting_side:energy_layer);
    if_settext("Difficulty: <tostring(%deadly_hunting_side_state)>/10", deadly_hunting_side:difficulty_text);
}
