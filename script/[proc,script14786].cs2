// 14786
[proc,script14786]
def_int $int0 = if_getwidth(hcape_interface:customisation_layer);
if_setposition($int0, 0, ^setpos_abs_left, ^setpos_abs_top, hcape_interface:tabs_content_main);
if_setposition(calc($int0 * 2), 0, ^setpos_abs_left, ^setpos_abs_top, hcape_interface:tabs_content_crest);
if_setscrollsize(calc($int0 * 3), 0, hcape_interface:scroller);
