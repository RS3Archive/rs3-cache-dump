[clientscript,trh147_overlay_setup]
def_int $int0 = -1;
cc_deleteall(wheel_of_fortune:fake_op);
while (++$int0 <= 2) {
    cc_create(wheel_of_fortune:fake_op, ^iftype_graphic, $int0);
}
if_setmodellighting(768, 512, 0, 255, 255, 255, 0, -1, -4, reflec_small, trh147_overlay:chest_1_model);
if_setmodellighting(768, 512, 0, 255, 255, 255, 0, -1, -4, reflec_small, trh147_overlay:chest_2_model);
