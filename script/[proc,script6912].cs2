// 6912
[proc,script6912](component $component0)
if (%worldswitcher_1stfavfailed = true) {
    if_sethide(false, $component0);
    if_sethide(false, duel3_options:stake_showinv);
    if_sethide(false, duel3_options:stake_showworn);
    if_setsize(69, 24, ^setsize_minus, ^setsize_minus, duel3_options:output);
} else {
    if_sethide(true, $component0);
    if_sethide(true, duel3_options:stake_showinv);
    if_sethide(true, duel3_options:stake_showworn);
    if_setsize(0, 24, ^setsize_minus, ^setsize_minus, duel3_options:output);
}
