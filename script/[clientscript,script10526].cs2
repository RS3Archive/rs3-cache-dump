// 10526
[clientscript,script10526]
if (%quest_endgame_new_canon = 1) {
    return;
}
if (%quest_endgame_lore_maze_selected = 0) {
    return;
}
if_sethide(false, quest_endgame_replay:interactions_selected);
if_sethide(true, quest_endgame_replay:options_selected);
if_sethide(true, quest_endgame_replay:choices_selected);
if_sethide(true, quest_endgame_replay:options);
if_sethide(true, quest_endgame_replay:choices);
if_sethide(false, quest_endgame_replay:interaction);
