// 1492
[proc,script1492]
def_obj $obj0 = null;
def_int $int1 = 0;
def_int $int2 = enum_getoutputcount(dino_reward_herb_bag_herbs_inv_slot);
def_int $int3 = 0;
while ($int3 < $int2) {
    $obj0 = enum(int, obj, dino_reward_herb_bag_herbs_inv_slot, $int3);
    $int1 = min(inv_getnum(dino_reward_herb_bag, $int3), 255);
    switch_obj ($obj0) {
        case unidentified_arbuck :
            %dino_herb_bag_arbuck = $int1;
        case unidentified_avantoe :
            %dino_herb_bag_avantoe = $int1;
        case unidentified_bloodweed :
            %dino_herb_bag_bloodweed = $int1;
        case unidentified_cadantine :
            %dino_herb_bag_cadantine = $int1;
        case unidentified_dwarf_weed :
            %dino_herb_bag_dwarf_weed = $int1;
        case unidentified_fellstalk :
            %dino_herb_bag_fellstalk = $int1;
        case unidentified_guam :
            %dino_herb_bag_guam = $int1;
        case unidentified_harralander :
            %dino_herb_bag_harralander = $int1;
        case unidentified_irit :
            %dino_herb_bag_irit = $int1;
        case unidentified_kwuarm :
            %dino_herb_bag_kwuarm = $int1;
        case unidentified_lantadyme :
            %dino_herb_bag_lantadyme = $int1;
        case unidentified_marentill :
            %dino_herb_bag_marrentill = $int1;
        case unidentified_ranarr :
            %dino_herb_bag_ranarr = $int1;
        case unidentified_snapdragon :
            %dino_herb_bag_snapdragon = $int1;
        case unidentified_tarromin :
            %dino_herb_bag_tarromin = $int1;
        case unidentified_toadflax :
            %dino_herb_bag_toadflax = $int1;
        case unidentified_torstol :
            %dino_herb_bag_torstol = $int1;
        case unidentified_wergali :
            %dino_herb_bag_wergali = $int1;
        case lore_spirit_weed_dirty :
            %dino_herb_bag_spirit_weed = $int1;
        case default :
            ~error("Invalid herb <oc_debugname>");
    }
    $int3 = calc($int3 + 1);
}
