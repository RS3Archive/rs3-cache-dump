// 10546
[proc,script10546](int $int0)(string)
switch_int ($int0) {
    case 0 :
        return("<tostring(%event10_cooking_progress)>/280");
    case 1 :
        return("<tostring(%event10_penguin_progress)>/3");
    case 2 :
        return("<tostring(calc(%event10_dog_progress_1 + %event10_dog_progress_2 + %event10_dog_progress_3))>/3");
    case 3 :
        return("<tostring(calc(%event10_pickpocket_progress_men + %event10_pickpocket_progress_farmers + %event10_pickpocket_progress_guards))>/15");
    case 4 :
        return("<tostring(%event10_cache_progress)>/100");
    case 5 :
        return("<tostring(%event10_delivery)>/1");
    case 6 :
        return("<tostring(%event10_dragon)>/1");
    case 7 :
        return("<tostring(calc(%event10_woodcutting_oak_progress + %event10_woodcutting_willow_progress))>/50");
    case 8 :
        return("<tostring(calc(%event10_summoning_gold_progress + %event10_summoning_green_progress + %event10_summoning_crimson_progress + %event10_summoning_blue_progress))>/20");
    case 9 :
        return("<tostring(%event10_jewellery)>/1");
    case 10 :
        return("<tostring(%event10_sinkhole)>/1");
    case 11 :
        return("<tostring(%event10_predator_progress)>/20");
    case 12 :
        return("<tostring(%event10_evil)>/1");
    case 13 :
        return("<tostring(%event10_potions)>/1");
    case default :
        return("0/0");
}
