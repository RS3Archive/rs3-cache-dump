// 3097
[proc,lobby_popup_close]
if_clearops(lobbyscreen_popup:left_button);
if_clearops(lobbyscreen_popup:right_button);
if_setonclick(null, lobbyscreen_popup:left_button);
if_setonclick(null, lobbyscreen_popup:right_button);
if_setonop(null, lobbyscreen_popup:left_button);
if_setonop(null, lobbyscreen_popup:right_button);
if_sethide(true, lobbyscreen_popup:left_button);
if_sethide(true, lobbyscreen_popup:right_button);
if_settext("", lobbyscreen_popup:text);
if_sethide(true, lobbyscreen_popup:static_graphic);
if_sethide(true, lobbyscreen_popup:spinner);
if_setonkey(null, lobbyscreen:popup);
if_sethide(true, lobbyscreen:popup);
