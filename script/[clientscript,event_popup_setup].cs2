// 4608
[clientscript,event_popup_setup](struct $struct0, graphic $graphic1, obj $obj2, int $int3, int $int4, int $int5)
def_string $string0 = "";
switch_int ($int5) {
    case 2 :
        $string0 = "<col=FF0000>Locked";
    case 0 :
        $string0 = "<col=FFFF00>Unclaimed";
    case 1 :
        $string0 = "<col=00FF00>Claimed";
}
if (struct_param($struct0, timed_event_text_progress_divider) > 1) {
    $int4 = calc($int4 / struct_param($struct0, timed_event_text_progress_divider));
