// 6972
[clientscript,script6972](component $component0)
def_int $int1 = if_getheight(interface_560:com_8);
def_int $int2 = calc($int1 / 3);
if (if_getmodelzoom($component0) > 200) {
    if_setmodelzoom(calc(if_getmodelzoom($component0) - 10), $component0);
    if (if_gety($component0) > $int2) {
        if_setposition(0, calc(if_gety($component0) - 3), ^setpos_abs_centre, ^setpos_abs_top, $component0);
    }
} else if (if_getmodelzoom($component0) <= 200 & if_gethide(interface_560:com_4) = true) {
    if_sethide(false, interface_560:com_4);
    if_sethide(true, $component0);
}
