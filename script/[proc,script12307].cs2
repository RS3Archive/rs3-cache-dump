// 12307
[proc,script12307]
cc_deleteall(toplevel_v2:graph_data_layer);
if (%varclientbit_30618 = 2) {
    %telemetry_graph_data_divisor = 30;
    %telemetry_graph_data_divisor_fine = 10;
} else {
    %telemetry_graph_data_divisor = 750;
    %telemetry_graph_data_divisor_fine = 30;
}
%telemetry_graph_data_initial_modulo = calc(clientclock % %telemetry_graph_data_divisor);
def_int $int0 = -1;
while (++$int0 < 256) {
    cc_create(toplevel_v2:graph_data_layer, ^iftype_rectangle, $int0);
    cc_setparam(rs3tli_component_param_int0, 0);
}
~script12308;
