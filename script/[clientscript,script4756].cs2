// 4756
[clientscript,script4756](component $component0)
def_int $int1 = scale(16384, 5000, %ezekial_hp);
$int1 = min(max($int1, 0), 16384);
if_setsize($int1, 0, ^setsize_rel, ^setsize_minus, slug3_hero_overlay:ezekial_large_progress_value_layer);
if_settext(tostring(%ezekial_hp), $component0);
if (%ezekial_hp >= 3000) {
    if_setcolour(^white, slug3_hero_overlay:ezekial_healthbar_left);
    if_setcolour(^white, slug3_hero_overlay:ezekial_healthbar_mid);
    if_setcolour(^white, slug3_hero_overlay:ezekial_healthbar_right);
    if_setmodelanim(slug3_human_chathead_happy_no_talking, slug3_hero_overlay:ezekial_head);
} else if (%ezekial_hp <= 1500) {
    if_setcolour(0xff2266, slug3_hero_overlay:ezekial_healthbar_left);
    if_setcolour(0xff2266, slug3_hero_overlay:ezekial_healthbar_mid);
    if_setcolour(0xff2266, slug3_hero_overlay:ezekial_healthbar_right);
    if_setmodelanim(slug3_human_chathead_fear_no_talking, slug3_hero_overlay:ezekial_head);
} else {
    if_setcolour(^white, slug3_hero_overlay:ezekial_healthbar_left);
    if_setcolour(^white, slug3_hero_overlay:ezekial_healthbar_mid);
    if_setcolour(^white, slug3_hero_overlay:ezekial_healthbar_right);
    if_setmodelanim(human_update_chathead_neutral_idle, slug3_hero_overlay:ezekial_head);
}
