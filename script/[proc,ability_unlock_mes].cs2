// 768
[proc,ability_unlock_mes](struct $struct0)(string)
if ($struct0 = null) {
    return("");
}
def_string $string0 = "";
switch_struct ($struct0) {
    case combatv2_ability_ranged_deaths_swiftness, combatv2_ability_ranged_deaths_shroud, combatv2_ability_magic_sunshine, combatv2_ability_magic_solar_charge, combatv2_ability_strength_berserk, combatv2_ability_necromancy_living_death :
        if (~script20987 = 1) {
            return("Locked by the 'Higher Power' relic.");
        }
}
if (struct_param($struct0, combatv2_ability_parent_stat) = 29 & struct_param($struct0, combatv2_spell_classification) ! 11 & string_length(struct_param($struct0, combatv2_ability_unlock_description)) = 0 & %quest_necromancy_origins_main < 30) {
    $string0 = "Rune Mythos";
    return("Unlocked by completing the '<$string0>' quest.");
