// 13855
[clientscript,script13855](component $component0, int $int1, int $int2)
if (cc_find($component0, $int1) = true & cc_param(minimenu_onrepeat_applied) = 0) {
    cc_setparam(minimenu_onrepeat_applied, 1);
    ~minimenu_highlight_background;
    if ($int2 = 1) {
        ~minimenu_addentryclick($component0, $int1);
        ~script2958(cc_param(minimenu_submenu), cc_param(minimenu_entry_id), $component0);
    }
}
