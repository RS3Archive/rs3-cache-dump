def_string $string2 = "<tostring($int3)> <~text_plural($int3, "Hour", "Hours")>";
def_string $string3 = "<tostring($int4)> <~text_plural($int4, "Minute", "Minutes")>";
def_struct $struct5 = null;
def_struct $struct6 = null;
if ($int2 >= 1) {
    $string0 = append($string0, append($string1, " <$string2>"));
