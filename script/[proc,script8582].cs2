// 8582
[proc,script8582](stat $stat0, int $int1, quest $quest2)(string, int)
def_string $string0 = null;
def_int $int3 = 1;
if (~ql4_skill_requirements($quest2) = false) {
    $string0 = "Level <tostring($int1)> <enum_string(stat_to_string, $stat0)> is one of the requirements for <~quest_name($quest2)>.";
} else {
    $string0 = "You now have all the levels you need for <~quest_name($quest2)>.";
}
return($string0, $int3);
