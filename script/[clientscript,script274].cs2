// 274
[clientscript,script274]
if_setsize(if_getwidth(fishcomp_overlay:fishcomp_right_panel), 95, ^setsize_abs, ^setsize_abs, fishcomp_overlay:fishcomp_right_panel);
cc_deleteall(fishcomp_overlay:history_scrollbar);
if_setvflip(true, fishcomp_overlay:show_history_arrow_left);
if_setvflip(true, fishcomp_overlay:show_history_arrow_right);
if_setscrollpos(0, 0, fishcomp_overlay:history_scrolllayer);
