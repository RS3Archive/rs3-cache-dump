// 15151
[proc,script15151](int $int0, boolean $boolean1)
if ($int0 = 0) {
    $boolean1 = ~negate_bool(if_gethide(event_crafting:info_overlay));
}
if_sethide($boolean1, event_crafting:info_overlay);
if ($boolean1 = true) {
    if_setop(1, "Open info panel", event_crafting:topbar_info_button);
} else {
    if_setop(1, "Close info panel", event_crafting:topbar_info_button);
    ~event_crafting_start_counter(-1);
}
