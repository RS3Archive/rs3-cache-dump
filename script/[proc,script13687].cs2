// 13687
[proc,script13687](string $string0)(string)
switch_int (%bank_customop) {
    case default :
        return("<$string0>-1");
    case 3 :
        return("<$string0>-5");
    case 4 :
        return("<$string0>-10");
    case 5 :
        return("<$string0>-<tostring(%bank_move_x)>");
    case 7 :
        return("<$string0>-All");
}
