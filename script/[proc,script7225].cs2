[proc,script7225]()(string)
if (%dino_herblore_dnd_completed = 1) {
    return("You have already completed Herby Werby this week.");
}
return("You can currently help clear corrupt herbs in the ancient zygomite cave on Anachronia.<br> <br>You have collected <col=FFFFFF><tostring(%dino_herblore_dnd_points)> of 100</col> spirit points this week.");
