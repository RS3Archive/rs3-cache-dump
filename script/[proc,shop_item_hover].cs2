// 6101
[proc,shop_item_hover](int $int0, int $int1, int $int2, component $component3, int $int4)
if ($int2 = 0) {
    ~deltooltip_action(shop_main:tooltip_layer);
    %tli_optext_item = null;
}
if (cc_find($component3, $int4) = true) {
    if ($int1 = 1) {
        if ($int2 = 1) {
            cc_setcolour(~script10495(10));
        } else {
            cc_setcolour(~script10495(9));
        }
    } else if ($int2 = 1) {
        cc_setcolour(~script10495(10));
    } else {
        cc_setcolour(~script10495(9));
    }
}
