// 16241
[clientscript,script16241]
if (%trh181_gemfall_gems_remaining > 0) {
    if_settext("Choose <col=FF00><tostring(%trh181_gemfall_gems_remaining)></col> more free <~text_plural(%trh181_gemfall_gems_remaining, "prize", "prizes")>!", trh181_overlay:gemfall_info);
} else {
    if_settext("", trh181_overlay:gemfall_info);
}
