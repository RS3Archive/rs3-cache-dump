// 3368
[clientscript,levelup_unlocktimer](int $int0, string $string0, int $int1)
if (cc_find(levelup:unlocks_layer, $int0) = true & string_length(cc_gettext) = 0 & clientclock > $int1) {
    $string0 = append("New: ", $string0);
    cc_settext($string0);
    cc_settextfont(verdana_15pt_regular);
    cc_settextshadow(true);
    cc_setcolour(0xf5b241);
    cc_settextalign(^settextalign_centre, ^settextalign_centre, 15);
}
~levelup_unlockmove($int0, $int1);
