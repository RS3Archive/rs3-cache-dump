// 6413
[proc,script6413]
if_settext("Current co-op points: <tostring(%ss_points)>", ss_rework:current_points_title);
if (%ss_bought_food = 1) {
    ~ss_disable_button(ss_rework:food_layer, 1);
} else if (%ss_points < 25) {
    ~ss_disable_button(ss_rework:food_layer, 0);
}
if (~script10881(lore_ss_aquanite_pet) = 1) {
    ~ss_disable_button(ss_rework:aquanite_pet_layer, 1);
} else if (%ss_points < 50) {
    ~ss_disable_button(ss_rework:aquanite_pet_layer, 0);
}
if (%ss_bought_potion = 1) {
    ~ss_disable_button(ss_rework:potion_layer, 1);
} else if (%ss_points < 75) {
    ~ss_disable_button(ss_rework:potion_layer, 0);
}
if (testbit(%lore_followers_owned_2, calc(34 % 42)) = ^true) {
    ~ss_disable_button(ss_rework:ice_pet_layer, 1);
} else if (%ss_points < 100) {
    ~ss_disable_button(ss_rework:ice_pet_layer, 0);
}
if (%ss_points < 5) {
    ~ss_disable_button(ss_rework:recharge_helm_layer, 0);
    if (%ss_points < 10) {
        ~ss_disable_button(ss_rework:recharge_ring_layer, 0);
    } else if (~script9659 = 0) {
        ~ss_disable_button(ss_rework:recharge_ring_layer, 1);
    }
} else {
    if (~script9658 = 0) {
        ~ss_disable_button(ss_rework:recharge_helm_layer, 1);
    }
    if (~script9659 = 0) {
        ~ss_disable_button(ss_rework:recharge_ring_layer, 1);
    }
}
if (%njslay_bought_divine = 1) {
    ~ss_disable_button(ss_rework:divine_layer, 1);
} else if (%ss_points < 35) {
    ~ss_disable_button(ss_rework:divine_layer, 0);
}
if (%njslay_bought_teleports = 1) {
    ~ss_disable_button(ss_rework:teleport_layer, 1);
} else if (%ss_points < 60) {
    ~ss_disable_button(ss_rework:teleport_layer, 0);
}
if (~script10881(lore_ganodermic_runt_pet) = 1) {
    ~ss_disable_button(ss_rework:runt_pet_layer, 1);
} else if (%ss_points < 200) {
    ~ss_disable_button(ss_rework:runt_pet_layer, 0);
}
if (%njslay_desert_skin = 1 | testbit(%lore_followers_owned_2, calc(34 % 42)) = ^false) {
    ~ss_disable_button(ss_rework:freezy_skin1_layer, 1);
} else if (%ss_points < 125) {
    ~ss_disable_button(ss_rework:freezy_skin1_layer, 0);
} else {
    ~ss_enable_button(85721949);
}
if (%njslay_jungle_skin = 1 | testbit(%lore_followers_owned_2, calc(34 % 42)) = ^false) {
    ~ss_disable_button(ss_rework:freezy_skin2_layer, 1);
} else if (%ss_points < 125) {
    ~ss_disable_button(ss_rework:freezy_skin2_layer, 0);
} else {
    ~ss_enable_button(85721917);
}
if (%njslay_wildy_skin = 1 | testbit(%lore_followers_owned_2, calc(34 % 42)) = ^false) {
    ~ss_disable_button(ss_rework:freezy_skin3_layer, 1);
} else if (%ss_points < 125) {
    ~ss_disable_button(ss_rework:freezy_skin3_layer, 0);
} else {
    ~ss_enable_button(85721933);
}
if (%njslay_bought_equipshare = 1) {
    ~ss_disable_button(ss_rework:equip_share_layer, 1);
} else if (%ss_points < 30) {
    ~ss_disable_button(ss_rework:equip_share_layer, 0);
}
