// 10123
[clientscript,script10123]
if (calc(clientclock % 50) = 0) {
    if (ttv_stream_getstate = 0) {
        if_setontimer(null, interface_231:com_13);
        if_settext("0", interface_231:com_13);
        return;
    }
    if_settext(tostring(ttv_stream_getviewers), interface_231:com_13);
    if (%varplayerbit_27169 = 1 & getwindowmode > 1) {
        if_sethide(true, interface_231:com_12);
    } else {
        if_sethide(false, interface_231:com_12);
    }
}
