// 2104
[proc,quest_sortname](quest $quest0)(string)
if ($quest0 = null) {
    ~error("Null .quest.");
    return("");
}
def_string $string0 = quest_getsortname($quest0);
def_string $string1 = "";
if (string_length($string0) = 0) {
    $string1 = ~quest_name($quest0);
    ~error("No sortname= specified for quest_id #<tostring(quest_param($quest0, quest_id))> <$string1>.");
}
return($string0);
