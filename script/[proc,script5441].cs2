// 5441
[proc,script5441]
if_sethide(false, dom_free:boss_info_layer);
if_sethide(false, dom_free:scroll_layer_boss_info);
if_sethide(true, dom_free:handicaps_info_layer);
if_sethide(true, dom_free:scroll_layer_handicaps);
if (if_getscrollheight(dom_free:boss_info_layer) > if_getheight(dom_free:boss_info_layer)) {
    if_sethide(false, dom_free:scroll_layer_boss_info);
}
if_setcolour(^white, dom_free:boss_details_tab_text);
if_setcolour(0xf5b241, dom_free:handicaps_tab_text);
%dom_free_current_tab_info_handicaps = 0;
