// 5083
[clientscript,script5083](component $component0, int $int1, int $int2)
if (clientclock < $int2) {
    return;
}
if_setontimer(null, $component0);
if ($int1 = %welcome_screen_time) {
    ~scrollbar_resize(clan_field_setup:dropdown_scrollbar, clan_field_setup:dropdown_options, if_getscrolly(clan_field_setup:dropdown_options));
}
