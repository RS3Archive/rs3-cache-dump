// 11555
[clientscript,grave_item_tooltip](obj $obj0, int $int1)
if ($obj0 = null | $int1 < 0) {
    return;
}
~script12094($obj0, grave_gravestone_contents, $int1);
if (~script11470($obj0) > 0) {
    if ($int1 < %death_protected_items) {
        %tli_optext_custom_string = "<col=00FF00>Protected: Will not degrade on death.";
    } else {
        %tli_optext_custom_string = "<col=FF0000>Unprotected: Will degrade on death.";
    }
}
