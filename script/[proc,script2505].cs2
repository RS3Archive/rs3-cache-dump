// 2505
[proc,script2505]
cc_deleteall(pop_hud:people_scrollbar);
if_setscrollsize(0, 0, pop_hud:people_content);
if_setscrollpos(0, 0, pop_hud:people_content);
def_int $int0 = if_gety(pop_hud:people_layer);
def_int $int1 = if_getheight(pop_hud:people_layer);
def_int $int2 = if_getheight(pop_hud:container);
if_setsize(if_getwidth(pop_hud:people_content), 0, ^setsize_abs, ^setsize_minus, pop_hud:people_content);
if (calc($int0 + $int1) > $int2) {
    if_setsize(if_getwidth(pop_hud:people_content), calc($int2 - $int0), ^setsize_abs, ^setsize_abs, pop_hud:people_content);
    if_setsize(16, calc($int2 - $int0), ^setsize_abs, ^setsize_abs, pop_hud:people_scrollbar);
    if_setscrollsize(0, $int1, pop_hud:people_content);
    ~rs3_scrollbar_vertical(pop_hud:people_scrollbar, pop_hud:people_content);
}
if_sethide(false, pop_hud:people_layer);
if_setgraphic("aif_pop_drop_down_tab,3", pop_hud:people_drop_left);
if_setgraphic("aif_pop_drop_down_tab,4", pop_hud:people_drop_mid);
if_setgraphic("aif_pop_drop_down_tab,5", pop_hud:people_drop_right);
