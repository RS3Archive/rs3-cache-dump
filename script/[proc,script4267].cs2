// 4267
[proc,script4267]
def_int $int0 = calc(%lunarfm_produce_points * 10);
if_settext(~tostring_spacer($int0, ","), lunarfm_rewards_new:current_points);
if (%lunarfm_spells_unlocked > 0) {
    if_setgraphic(null, lunarfm_rewards_new:spell_unlock_falador);
}
if (%lunarfm_spells_unlocked > 1) {
    if_setgraphic(null, lunarfm_rewards_new:spell_unlock_rune);
}
if (%lunarfm_spells_unlocked > 2) {
    if_setgraphic(null, lunarfm_rewards_new:spell_unlock_ardougne);
}
if (%lunarfm_spells_unlocked > 3) {
    if_setgraphic(null, lunarfm_rewards_new:spell_unlock_remote);
}
if (%lunarfm_spells_unlocked > 4) {
    if_setgraphic(null, lunarfm_rewards_new:spell_unlock_spirit);
}
if (%lunarfm_spells_unlocked > 5) {
    if_setgraphic(null, lunarfm_rewards_new:spell_unlock_leather);
}
if (%lunarfm_spells_unlocked > 6) {
    if_setgraphic(null, lunarfm_rewards_new:spell_unlock_shield);
}
if (%lunarfm_spells_unlocked > 7) {
    if_setgraphic(null, lunarfm_rewards_new:spell_unlock_vengeance);
}
if (%lunarfm_spells_unlocked > 8) {
    if_setgraphic(null, lunarfm_rewards_new:spell_unlock_trollheim);
}
if (%lunarfm_spells_unlocked > 9) {
    if_setgraphic(null, lunarfm_rewards_new:spell_unlock_trollgroup);
}
if (%lunarfm_spells_unlocked > 10) {
    if_setgraphic(null, lunarfm_rewards_new:spell_unlock_borrowed);
    if_setgraphic(null, lunarfm_rewards_new:spell_unlock_rune);
    if_setgraphic(null, lunarfm_rewards_new:wish_unlock_seeds);
    if_setgraphic(null, lunarfm_rewards_new:wish_unlock_herbs);
    if_setgraphic(null, lunarfm_rewards_new:wish_unlock_vials);
    if_setgraphic(null, lunarfm_rewards_new:wish_unlock_runes);
    if_setgraphic(null, lunarfm_rewards_new:wish_unlock_burn);
    if_setgraphic(null, lunarfm_rewards_new:wish_unlock_planks);
    if_setgraphic(null, lunarfm_rewards_new:wish_unlock_awesome);
    if_setgraphic(null, lunarfm_rewards_new:wish_unlock_patch);
    if_setgraphic(null, lunarfm_rewards_new:wish_unlock_power_unset);
    if_setgraphic(null, lunarfm_rewards_new:wish_unlock_power);
    if_setgraphic(null, lunarfm_rewards_new:wish_unlock_protect);
}
