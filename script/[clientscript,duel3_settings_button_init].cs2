// 12847
[clientscript,duel3_settings_button_init](component $component0, string $string0)
cc_deleteall($component0);
cc_create($component0, ^iftype_graphic, 0);
cc_setsize(0, 0, ^setsize_minus, ^setsize_minus);
cc_setposition(0, 0, ^setpos_abs_centre, ^setpos_abs_centre);
cc_setgraphic(rs3_menu_icon_settings_locked);
cc_setonmouserepeat("script8799($string0, event_com, -1)");
cc_setonmouseleave("script8805");
cc_setonclick("duel3_showoptions");
.cc_create($component0, ^iftype_graphic, 1);
.cc_setsize(10, 32, ^setsize_abs, ^setsize_abs);
.cc_setposition(0, 0, ^setpos_abs_centre, ^setpos_abs_centre);
.cc_setgraphic(exclamation_mark);
.cc_sethide(true);
cc_setontimer("script12848($component0, .cc_getid)");
