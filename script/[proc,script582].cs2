// 582
[proc,script582](component $component0, component $component1, int $int2)
if ($component0 = null | $component1 = null) {
    return;
}
if_setscrollpos(0, if_getscrolly($component1), $component1);
if_setscrollsize(0, max(if_getheight($component1), calc($int2 * (113 + 6))), $component1);
~rs3_scrollbar_vertical($component0, $component1);
