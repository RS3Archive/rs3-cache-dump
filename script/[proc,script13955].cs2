// 13955
[proc,script13955]()(int)
switch_int (%trh86_cannon_level) {
    case default :
        return(0);
    case 2 :
        return(1);
    case 3 :
        return(2);
    case 4 :
        if (stat_base(ranged) >= 70) {
            return(3);
        }
        return(0);
    case 5 :
        if (stat_base(ranged) >= 75) {
            return(4);
        } else if (stat_base(ranged) >= 70) {
            return(3);
        }
        return(0);
}
