// 5929
[proc,invent_techtree_unlocked](int $int0, int $int1)(int)
if ($int0 < 1 | $int0 > 2) {
    return(0);
}
if ($int1 > 127) {
    return(0);
}
switch_int ($int0) {
    case 1 :
        return(testbit(%invent_dwarven_unlocks, $int1));
    case 2 :
        return(testbit(%invent_goblin_unlocks, $int1));
}
