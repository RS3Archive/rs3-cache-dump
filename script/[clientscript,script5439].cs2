// 5439
[clientscript,script5439]
if (%dom_allow_spectators = 0) {
    if_sethide(true, dom_free:checkbox_selected_layer);
    if_sethide(false, dom_free:checkbox_deselected_layer);
} else {
    if_sethide(false, dom_free:checkbox_selected_layer);
    if_sethide(true, dom_free:checkbox_deselected_layer);
}
if (%dom_skip_taunt = 0) {
    if_sethide(true, dom_free:checkbox_selected_layer_1);
    if_sethide(false, dom_free:checkbox_deselected_layer_1);
} else {
    if_sethide(false, dom_free:checkbox_selected_layer_1);
    if_sethide(true, dom_free:checkbox_deselected_layer_1);
}
if (%dom_skip_victory = 0) {
    if_sethide(true, dom_free:checkbox_selected_layer_2);
    if_sethide(false, dom_free:checkbox_deselected_layer_2);
} else {
    if_sethide(false, dom_free:checkbox_selected_layer_2);
    if_sethide(true, dom_free:checkbox_deselected_layer_2);
}
if_sethide(true, dom_free:scroll_layer_boss_info);
if_sethide(true, dom_free:scroll_layer_handicaps);
~script5441;
~script5444(1);
%tooltip_built = 0;
