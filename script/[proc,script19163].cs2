    if_setmodelangle(60, 50, 0, 150, 0, 300, trh_academy_shared_overlay:splash_screen_npc_large_model_2);
    if_setmodelanim(trh_chest_closed_idle, trh_academy_shared_overlay:splash_screen_npc_large_model_2);
