[proc,script19163]
if_sethide(false, trh_academy_shared_overlay:splash_screen);
if_sethide(true, trh_academy_shared_overlay:universe);
if_sethide(true, trh_academy_shared_overlay:splash_screen_title);
if_sethide(false, trh_academy_shared_overlay:splash_screen_title_graphic);
~script4170(trh_academy_shared_overlay:splash_screen_title_graphic, trh203_title_en, trh203_title_de, trh203_title_fr, trh203_title_pt);
if_setposition(0, 20, ^setpos_abs_centre, ^setpos_abs_top, trh_academy_shared_overlay:splash_screen_desc);
if_setsize(325, 200, ^setsize_abs, ^setsize_abs, trh_academy_shared_overlay:splash_screen_desc);
if_settextfont(notosans_14, trh_academy_shared_overlay:splash_screen_desc);
if_sethide(true, trh_academy_shared_overlay:splash_screen_desc_shadow);
if_settext("Increase your skill level up to a maximum of <col=F0BE79><tostring(99)></col> by completing skilling locations.<br><br><br>Reach level milestones to get extra <col=F0BE79>Christmas wrapping paper</col>!", trh_academy_shared_overlay:splash_screen_desc);
if_setgraphic(trh203_background_splash, trh_academy_shared_overlay:splash_screen_bg);
if_setposition(0, 4, ^setpos_abs_centre, ^setpos_abs_bottom, trh_academy_shared_overlay:splash_screen_bg);
if (~script18365 = false) {
    if_setnpcmodel(trh203_character_blue, trh_academy_shared_overlay:splash_screen_npc_large_model_1);
    if_setposition(-29, -3, ^setpos_abs_centre, ^setpos_abs_centre, trh_academy_shared_overlay:splash_screen_npc_large_model_1);
    if_setmodelangle(-55, 72, 0, -230, 0, 400, trh_academy_shared_overlay:splash_screen_npc_large_model_1);
    if_setmodelanim(combat_2012_casual_unarmed_idle, trh_academy_shared_overlay:splash_screen_npc_large_model_1);
    if_setnpcmodel(trh203_character_red, trh_academy_shared_overlay:splash_screen_npc_large_model_2);
    if_setposition(29, -3, ^setpos_abs_centre, ^setpos_abs_centre, trh_academy_shared_overlay:splash_screen_npc_large_model_2);
    if_setmodelangle(55, 72, 0, 230, 0, 400, trh_academy_shared_overlay:splash_screen_npc_large_model_2);
    if_setmodelanim(combat_2012_casual_unarmed_idle, trh_academy_shared_overlay:splash_screen_npc_large_model_2);
} else {
    if_setnpcmodel(trh203_christmas_character, trh_academy_shared_overlay:splash_screen_npc_large_model_1);
    if_setposition(-29, -3, ^setpos_abs_centre, ^setpos_abs_centre, trh_academy_shared_overlay:splash_screen_npc_large_model_1);
    if_setmodelangle(-55, 72, 0, -230, 0, 400, trh_academy_shared_overlay:splash_screen_npc_large_model_1);
    if_setmodelanim(combat_2012_casual_unarmed_idle, trh_academy_shared_overlay:splash_screen_npc_large_model_1);
    if_setnpcmodel(trh203_present, trh_academy_shared_overlay:splash_screen_npc_large_model_2);
