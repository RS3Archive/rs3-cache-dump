// 7099
[clientscript,script7099](component $component0, int $int1, int $int2)
if ($component0 = null) {
    return;
}
def_string $string0 = "";
if (clientclock >= $int2) {
    if (%makex2012_total_remaining > 0) {
        $string0 = "<tostring(max(1, $int1))>s";
    } else {
        $string0 = "Done";
    }
    if_settext($string0, $component0);
    if ($int1 > 0) {
        if_setontimer("script7099(makex2012_progress_dialogue:time_text, calc($int1 - 1), calc(clientclock + 50))", makex2012_progress_dialogue:production_dialog_control);
    } else {
        if_setontimer(null, makex2012_progress_dialogue:production_dialog_control);
    }
}
