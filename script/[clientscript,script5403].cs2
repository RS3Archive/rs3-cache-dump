// 5403
[clientscript,script5403](component $component0, string $string0)
if_settext($string0, dom_taunt_overlay:player_name);
%dom_taunt_x_pos = 0;
if_sethide(true, dom_taunt_overlay:boss_name_layer);
if_sethide(false, dom_taunt_overlay:player_name_layer);
if_sethide(true, dom_taunt_overlay:win_lose_layer);
if_setontimer("script5405(0, dom_taunt_overlay:player_name_layer, $component0)", dom_taunt_overlay:player_name_layer);
