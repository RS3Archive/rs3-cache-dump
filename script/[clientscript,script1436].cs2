// 1436
[clientscript,script1436]
if_setposition(random(calc(if_getwidth(safes_if:notch_pane) - if_getwidth(safes_if:notch_holder))), random(calc(if_getheight(safes_if:notch_pane) - if_getheight(safes_if:notch_holder))), ^setpos_abs_left, ^setpos_abs_top, safes_if:notch_holder);
if_set2dangle(calc(random(4) * 16384 - 1), safes_if:notch);
