// 11854
[proc,script11854](component $component0, component $component1)
def_int $int2 = max(0, scale(%sa_energy, 1000, if_getwidth(toplevel_v2_combat_bar_mobile:combat_bar)));
def_int $int3 = max(0, scale(max(0, calc(%sa_energy - 1000)), 1000, if_getwidth(toplevel_v2_combat_bar_mobile:combat_bar)));
if_setsize($int2, if_getheight($component0), ^setsize_abs, ^setsize_abs, $component0);
if_setsize($int3, if_getheight($component1), ^setsize_abs, ^setsize_abs, $component1);
