~trh31_update_info(%trh31_druid_unlocked, trh31_druid, trh31_costume:costume_cost_druid, trh31_costume:costume_druid, trh31_costume:druid_male, trh31_costume:druid_female);
~trh31_update_info(%trh31_fremennik_unlocked, trh31_fremennik, trh31_costume:costume_cost_fremennik, trh31_costume:costume_fremennik, trh31_costume:fremennik_male, trh31_costume:fremennik_female);
~trh31_update_info(%trh31_princess_unlocked, trh31_princess, trh31_costume:costume_cost_princess, trh31_costume:costume_princess, trh31_costume:princess_male, trh31_costume:princess_female);
~trh31_update_info(%trh31_fisher_unlocked, trh31_fisher, trh31_costume:costume_cost_fisher, trh31_costume:costume_fisher, trh31_costume:fisher_male, trh31_costume:fisher_female);
