// 4093
[clientscript,script4093]
def_int $int0 = if_gettrans(fmc_torch:black);
if ($int0 < 11) {
    if_settrans(10, fmc_torch:black);
    if_settrans(20, fmc_torch:fade);
    if_setontimer(null, fmc_torch:black);
    return;
} else {
    if_settrans(calc($int0 - 10), fmc_torch:black);
    if_settrans(calc(($int0 - 10) / 2), fmc_torch:fade);
}
