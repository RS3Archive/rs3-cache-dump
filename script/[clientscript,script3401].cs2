// 3401
[clientscript,script3401](component $component0, int $int1, int $int2, int $int3)
def_int $int4 = calc($int3 - clientclock);
def_int $int5 = 0;
if (cc_find($component0, $int1) = true) {
    if ($int4 <= 0) {
        cc_settrans(255);
        cc_setontimer("script3402($component0, $int1, $int2, calc(clientclock + $int2))");
        cc_settext(~script15798);
        return;
    }
    $int5 = calc(255 - cc_gettrans);
    cc_settrans(min(calc(cc_gettrans + $int5 / $int4), 254));
}
