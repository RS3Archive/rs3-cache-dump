// 8764
[proc,script8764](component $component0, component $component1)
if_setonvartransmit("script10842{option_toggle2}", $component1);
cam2_setpositionmode(1);
cam2_setlookatmode(1);
if (%zoom < 1860) {
    %zoom = calc(1860 + (7600 - 1860) / 2);
}
if (%toplevel_v2_camera_keyboard_responce_horizontal < 100 | %toplevel_v2_camera_keyboard_responce_horizontal > 250) {
    %toplevel_v2_camera_keyboard_responce_horizontal = calc(100 + (250 - 100) / 2);
}
if (%toplevel_v2_camera_keyboard_responce_vertical < 70 | %toplevel_v2_camera_keyboard_responce_vertical > 200) {
    %toplevel_v2_camera_keyboard_responce_vertical = calc(70 + (200 - 70) / 2);
}
if (%toplevel_v2_camera_mouse_responce_horizontal < 4 | %toplevel_v2_camera_mouse_responce_horizontal > 24) {
    %toplevel_v2_camera_mouse_responce_horizontal = calc(4 + (24 - 4) / 2);
}
if (%toplevel_v2_camera_mouse_responce_vertical < 3 | %toplevel_v2_camera_mouse_responce_vertical > 23) {
    %toplevel_v2_camera_mouse_responce_vertical = calc(3 + (23 - 3) / 2);
}
if (%toplevel_v2_camera_zoom_rate < 0 | %toplevel_v2_camera_zoom_rate > 350) {
    %toplevel_v2_camera_zoom_rate = calc(0 + (350 - 0) / 2);
}
if (%toplevel_v2_camera_swipe_response_horizontal < 4 | %toplevel_v2_camera_swipe_response_horizontal > 16) {
    %toplevel_v2_camera_swipe_response_horizontal = calc(4 + (16 - 4) / 2);
}
if (%toplevel_v2_camera_swipe_response_vertical < 3 | %toplevel_v2_camera_swipe_response_vertical > 15) {
    %toplevel_v2_camera_swipe_response_vertical = calc(3 + (15 - 3) / 2);
}
if_setonop("script8770(event_op)", $component1);
if_setonmouserepeat("script8773(event_com, event_mousex, event_mousey, -1, -1, -1)", $component0);
if_setonscrollwheel("script8774(event_mousey)", $component0);
~script14184($component0);
~script724;
