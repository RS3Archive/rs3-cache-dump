// 14330
[clientscript,script14330](component $component0, component $component1)
def_int $int2 = 0;
def_obj $obj3 = null;
switch_component ($component1) {
    case hunter_charms_exchange:spirit_lure_item :
        ~script14331(%huntcharm_stored_lure, huntcharm_lure, $component0, $component1);
    case hunter_charms_exchange:yaktwee_item :
        $int2 = %huntcharm_stored_stick;
        if ($int2 > 1 & %huntcharm_stickcount >= 1000) {
            $obj3 = huntcharm_stave_enhanced;
            $int2 = 1;
        } else {
            $obj3 = huntcharm_stave;
        }
        ~script14331($int2, $obj3, $component0, $component1);
    case hunter_charms_exchange:gold_slice_item :
        ~script14331(%huntcharm_stored_gold, huntcharm_fragment_gold, $component0, $component1);
    case hunter_charms_exchange:crimson_slice_item :
        ~script14331(%huntcharm_stored_crimson, huntcharm_fragment_crimson, $component0, $component1);
    case hunter_charms_exchange:green_slice_item :
        ~script14331(%huntcharm_stored_green, huntcharm_fragment_green, $component0, $component1);
    case hunter_charms_exchange:blue_slice_item :
        ~script14331(%huntcharm_stored_blue, huntcharm_fragment_blue, $component0, $component1);
    case hunter_charms_exchange:mystical_slice_item :
        ~script14331(%huntcharm_stored_mystical, huntcharm_fragment_mystical, $component0, $component1);
}
