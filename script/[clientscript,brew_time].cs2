// 1762
[clientscript,brew_time](component $component0)
if (%brew_varc_time > 6) {
    if_settext("Time Left : <tostring(calc(%brew_varc_time - 5))> mins", $component0);
} else if (%brew_varc_time = 6) {
    if_settext("Time Left : 1 min", $component0);
} else {
    if_settext("Time Left : 0 mins", $component0);
}
