// 11265
[clientscript,script11265](component $component0, int $int1)
def_string $string0 = "Link this button to any scenario in the Scenario tool by selecting it as a favourite.";
if (%jmod_tool_custom_scenario = 0) {
    if_settext("Fave Scenario", $component0);
    if_sethide(true, jmod_tool:custom_button_tint);
} else {
    if_settext(~script11233(%jmod_tool_custom_scenario), $component0);
    $string0 = "Click to run scenario : <~script11233(%jmod_tool_custom_scenario)>.";
    if_sethide(false, jmod_tool:custom_button_tint);
}
if_setonmouserepeat("script8799($string0, event_com, -1)", $component0);
