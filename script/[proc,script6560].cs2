// 6560
[proc,script6560](obj $obj0)(int)
if (~map_members = false) {
    return(0);
}
if ($obj0 = null | enum_hasoutput(obj, elfcity_increasers_activatable, $obj0) = true) {
    return(0);
}
switch_obj ($obj0) {
    case elfcity_maw_damage_airut :
        return(%elfcity_increaser_active_airut);
    case elfcity_maw_damage_cadarn :
        return(%elfcity_increaser_active_cadarn);
