// 2020
[proc,script2020]
def_enum $enum0 = null;
def_enum $enum1 = null;
def_enum $enum2 = null;
$enum0, $enum1, $enum2 = ~script7386;
def_string $string0 = "";
def_string $string1 = "";
def_string $string2 = "Select A Ship";
switch_int (%pop_voyage_list_ship) {
    case 1 :
        $string0 = enum(int, string, $enum0, %pop_ship_1_prefix);
        $string1 = enum(int, string, $enum1, %pop_ship_1_name1);
        $string2 = enum(int, string, $enum2, %pop_ship_1_name2);
    case 2 :
        $string0 = enum(int, string, $enum0, %pop_ship_2_prefix);
        $string1 = enum(int, string, $enum1, %pop_ship_2_name1);
        $string2 = enum(int, string, $enum2, %pop_ship_2_name2);
    case 3 :
        $string0 = enum(int, string, $enum0, %pop_ship_3_prefix);
        $string1 = enum(int, string, $enum1, %pop_ship_3_name1);
        $string2 = enum(int, string, $enum2, %pop_ship_3_name2);
    case 4 :
        $string0 = enum(int, string, $enum0, %pop_ship_4_prefix);
        $string1 = enum(int, string, $enum1, %pop_ship_4_name1);
        $string2 = enum(int, string, $enum2, %pop_ship_4_name2);
}
if_settext("<$string0><$string1><$string2>", pop_voyage_list:ship_name);
if (parawidth("<$string0><$string1><$string2>", 700, cinzel_15pt_bold) > 220) {
    if_settextfont(cinzel_13pt_bold, pop_voyage_list:ship_name);
}
