// 9764
[clientscript,script9764]
def_component $component0 = null;
if_setopkey(1, 0, 0, spirittree2:spirittree_window_close_button);
def_int $int1 = 0;
while ($int1 < enum_getoutputcount(spirittree_component)) {
    $component0 = enum(int, component, spirittree_component, $int1);
    if_setopkey(1, 0, 0, $component0);
    $int1 = calc($int1 + 1);
}
~closebutton_click;
