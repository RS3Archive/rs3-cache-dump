// 13329
[proc,cheevo_populate_scrollbar](int $int0)
def_component $component1 = enum(int, component, cheevo_category_button_index, calc(enum_getoutputcount(cheevo_category_button_index) - 1));
def_int $int2 = calc(if_gety($component1) + if_getheight($component1) + 3);
if_setscrollsize(0, $int2, if_getparentlayer($component1));
if_setscrollpos(0, calc(($int0 - 1) * 45), if_getparentlayer($component1));
if ($int2 <= 404) {
    cc_deleteall(achievements_sub:category_scrollbar);
    ~script13578(achievements_sub:category_scrollbar);
} else {
    ~rs3_scrollbar_vertical(achievements_sub:category_scrollbar, achievements_sub:category_scrollinglayer);
}
