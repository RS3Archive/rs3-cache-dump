// 9149
[proc,script9149]()(string)
if (%peng_rak_main = 140) {
    if (%peng_spy_bear_found = 0) {
        return("You have found <col=ffffff><tostring(%peng_spy_week_peng)> of 12</col> penguins this week and have <col=ffffff>not yet found</col> the polar bear.");
    } else {
        return("You have found <col=ffffff><tostring(%peng_spy_week_peng)> of 12</col> penguins this week and you've <col=ffffff>found</col> the polar bear.");
    }
} else {
    return("You have found <col=ffffff><tostring(%peng_spy_week_peng)> of 12</col> penguins this week. If you complete the quest <col=ffffff>'Hunt for Red Raktuber'</col> you'll also be able to hunt a polar bear");
}
