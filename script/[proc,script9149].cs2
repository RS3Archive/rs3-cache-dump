[proc,script9149]()(string)
if (%varplayer_2759 = 140) {
    if (%varplayerbit_4168 = 0) {
        return("You have found <col=ffffff><tostring(%varplayerbit_4164)> of 12</col> penguins this week and have <col=ffffff>not yet found</col> the polar bear.");
    } else {
        return("You have found <col=ffffff><tostring(%varplayerbit_4164)> of 12</col> penguins this week and you've <col=ffffff>found</col> the polar bear.");
    }
} else {
    return("You have found <col=ffffff><tostring(%varplayerbit_4164)> of 12</col> penguins this week. If you complete the quest <col=ffffff>'Hunt for Red Raktuber'</col> you'll also be able to hunt a polar bear");
}
