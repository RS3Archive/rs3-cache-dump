// 2722
[proc,div_map_mouseleave](component $component0)
~deltooltip(div_map:tooltip_bound);
def_graphic $graphic1 = if_getgraphic($component0);
def_graphic $graphic2 = null;
switch_graphic ($graphic1) {
    case "aif_skill1_map_icons,3" :
        $graphic2 = "aif_skill1_map_icons,0";
    case "aif_skill1_map_icons,4" :
        $graphic2 = "aif_skill1_map_icons,1";
    case "aif_skill1_map_icons,5" :
        $graphic2 = "aif_skill1_map_icons,2";
}
if ($graphic2 = null) {
    return;
}
if_setgraphic($graphic2, $component0);
