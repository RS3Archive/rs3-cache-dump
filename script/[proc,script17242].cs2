// 17242
[proc,script17242](dbrow $dbrow0)(int, string)
def_int $int1 = 0;
def_int $int2 = db_getfieldcount($dbrow0, requirements:col4);
def_quest $quest3 = null;
def_int $int4 = 0;
def_string $string0 = "";
def_string $string1 = "";
while ($int1 < $int2) {
    $quest3 = db_getfield($dbrow0, requirements:col4, $int1);
    if (quest_finished($quest3) = false) {
        $int4 = calc($int4 + 1);
        $string1 = quest_getname($quest3);
        $string0 = ~script17238($string0, "Complete quest: <$string1>");
    } else {
        $string0 = ~script17238($string0, "<str=FFFFFE>Complete quest: <$string1>");
    }
    $int1 = calc($int1 + 1);
}
return($int4, $string0);
