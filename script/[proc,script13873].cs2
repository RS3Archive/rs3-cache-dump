// 13873
[proc,script13873](component $component0, int $int1, int $int2)
def_string $string0 = "There are new Player Power Polls to vote on.";
if (if_getnextsubid($component0) = 0) {
    .cc_create($component0, ^iftype_graphic, 0);
    .cc_setgraphic(rs3_icon_info);
    .cc_setsize(20, 20, ^setsize_abs, ^setsize_abs);
    .cc_setonmouserepeat("script8799($string0, event_com, event_comsubid)");
}
if (.cc_find($component0, 0) = true) {
    .cc_setposition(calc($int1 - .cc_getwidth), $int2, ^setpos_abs_left, ^setpos_abs_top);
}
