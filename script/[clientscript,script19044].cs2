// 19044
[clientscript,script19044]
def_int $int0 = 0;
def_component $component1 = null;
while (++$int0 <= 3) {
    switch_int ($int0) {
        case 1 :
            $component1 = trh183_overlay:chest_1_model;
        case 2 :
            $component1 = trh183_overlay:chest_2_model;
        case 3 :
            $component1 = trh183_overlay:chest_3_model;
    }
    if_setmodelanim(trh_chest_reroll_prize_quick, $component1);
    if_setontimer("script16715(clientclock, $int0, $component1, 60)", $component1);
}
if_setontimer("script19045(clientclock, 50)", trh183_overlay:chest_layer);
