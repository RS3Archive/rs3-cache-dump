// 9667
[clientscript,script9667](int $int0, component $component1)
if ($int0 < 300) {
    $int0 = calc($int0 + 1);
    if_setontimer("script9667($int0, $component1)", $component1);
    return;
}
if_setontimer(null, $component1);
~fadeout_comp(50, mole2_help:flashy_icon, mole2_help:flashy_icon);
~fadeout_comp(50, mole2_help:help_text, mole2_help:help_text);
~fadeout_comp(50, mole2_help:bg_10, mole2_help:bg_10);
~fadeout_comp(50, mole2_help:bg_11, mole2_help:bg_11);
~fadeout_comp(50, mole2_help:bg_12, mole2_help:bg_12);
~fadeout_comp(50, mole2_help:bg_13, mole2_help:bg_13);
~fadeout_comp(50, mole2_help:bg_14, mole2_help:bg_14);
~fadeout_comp(50, mole2_help:bg_15, mole2_help:bg_15);
~fadeout_comp(50, mole2_help:bg_16, mole2_help:bg_16);
~fadeout_comp(50, mole2_help:bg_17, mole2_help:bg_17);
~fadeout_comp(50, mole2_help:bg_18, mole2_help:bg_18);
