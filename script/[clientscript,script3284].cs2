// 3284
[clientscript,script3284](int $int0)
def_int $int1 = calc(61 + 10 * ($int0 - 1));
if_setposition(0, $int1, ^setpos_abs_left, ^setpos_abs_top, rand_floor_select:floor_tooltip);
if_settext(tostring($int0), rand_floor_select:floor_tooltip_floor);
switch_int (enum(int, int, rand_floor_theme, $int0)) {
    case 1 :
        if_settext("Frozen", rand_floor_select:floor_tooltip_theme);
    case 2, 6 :
        if_settext("Abandoned", rand_floor_select:floor_tooltip_theme);
    case 3 :
        if_settext("Furnished", rand_floor_select:floor_tooltip_theme);
    case 4 :
        if_settext("Occult", rand_floor_select:floor_tooltip_theme);
    case 5 :
        if_settext("Warped", rand_floor_select:floor_tooltip_theme);
    case default :
        if_settext("Dungeon", rand_floor_select:floor_tooltip_theme);
}
