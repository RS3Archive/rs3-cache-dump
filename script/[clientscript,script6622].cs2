// 6622
[clientscript,script6622](int $int0, int $int1, int $int2)
def_graphic $graphic3 = "close_buttons,6";
if ($int2 = 2) {
    $graphic3 = "close_buttons,4";
}
def_component $component4 = peng_pow_bfish:pieces_blue;
def_component $component5 = peng_pow_bfish:piece_highlight_blue;
if ($int0 = 674) {
    $component4 = peng_pow_bfish:pieces_green;
    $component5 = peng_pow_bfish:piece_highlight_green;
}
if (if_find($component5) = true & .cc_find($component4, $int1) = true) {
    cc_setsize(25, 25, ^setsize_abs, ^setsize_abs);
    cc_setposition(.cc_getx, .cc_gety, ^setpos_abs_left, ^setpos_abs_top);
    cc_setontimer("script6623(calc(clientclock + 100), 0, $graphic3, $component5)");
}
