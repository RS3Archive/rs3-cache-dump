// 7423
[proc,script7423]
def_int $int0 = 0;
def_int $int1 = if_gety(mtxmgt:dash_component);
def_int $int2 = 34;
def_int $int3 = 0;
def_int $int4 = calc(stringwidth(if_gettext(mtxmgt:pet_name), museo_sans_13pt_regular) + 10);
def_int $int5 = 0;
if (stringwidth(if_gettext(mtxmgt:pet_stage), museo_sans_13pt_regular) > 0) {
    $int3 = calc(stringwidth(if_gettext(mtxmgt:pet_stage), museo_sans_13pt_regular) + 10);
    $int0 = calc(stringwidth("-", museo_sans_13pt_regular) + 10);
    if_settext("-", mtxmgt:dash_component);
    $int5 = calc($int4 + $int0 + $int3 + 20);
    if_setsize($int5, if_getheight(mtxmgt:pets_name_layer), ^setsize_abs, ^setsize_abs, mtxmgt:pets_name_layer);
} else {
    if_setsize($int4, if_getheight(mtxmgt:pets_name_layer), ^setsize_abs, ^setsize_abs, mtxmgt:pets_name_layer);
}
if_setsize($int3, 0, ^setsize_abs, ^setsize_minus, mtxmgt:pet_stage);
if_setsize($int0, 0, ^setsize_abs, ^setsize_minus, mtxmgt:dash_component);
if_setsize($int4, 0, ^setsize_abs, ^setsize_minus, mtxmgt:pet_name);
if (stringwidth(if_gettext(mtxmgt:pet_stage), museo_sans_13pt_regular) > 0) {
    if_setposition(if_getx(mtxmgt:pet_name_background), $int1, ^setpos_abs_left, ^setpos_abs_top, mtxmgt:pet_stage);
    if_setposition(calc(if_getx(mtxmgt:pet_stage) + if_getwidth(mtxmgt:pet_stage) + 15), $int1, ^setpos_abs_left, ^setpos_abs_top, mtxmgt:dash_component);
    if_setposition(calc(if_getx(mtxmgt:dash_component) + if_getwidth(mtxmgt:dash_component) + 5), $int1, ^setpos_abs_left, ^setpos_abs_top, mtxmgt:pet_name);
} else {
    if_setposition(0, 0, ^setpos_abs_centre, ^setpos_abs_centre, mtxmgt:pet_name);
