// 9759
[clientscript,script9759]
if (%wc_update09_got_job = 0) {
    if_settext("<tostring(calc((%wc_update09_target_short_hard + 1) * 5))> x Short plank<br><tostring(calc((%wc_update09_target_long_hard + 1) * 5))> x Long plank<br><tostring(calc((%wc_update09_target_diag_hard + 1) * 5))> x Diagonal plank<br><tostring(calc((%wc_update09_target_tooth_hard + 1) * 5))> x Tooth plank<br><tostring(calc((%wc_update09_target_groove_hard + 1) * 5))> x Groove plank<br><tostring(calc((%wc_update09_target_curve_hard + 1) * 5))> x Curved plank", wc_update09_sawmill_job_board:difficult_list);
    if_settext("<tostring(calc((%wc_update09_target_short + 1) * 5))> x Short plank<br><tostring(calc((%wc_update09_target_long + 1) * 5))> x Long plank<br><tostring(calc((%wc_update09_target_diag + 1) * 5))> x Diagonal plank<br><tostring(calc((%wc_update09_target_tooth + 1) * 5))> x Tooth plank<br><tostring(calc((%wc_update09_target_groove + 1) * 5))> x Groove plank<br><tostring(calc((%wc_update09_target_curve + 1) * 5))> x Curved plank", wc_update09_sawmill_job_board:normal_list);
} else {
    if_sethide(false, wc_update09_sawmill_job_board:accept_quick_job_disabled_layer);
    if_sethide(false, wc_update09_sawmill_job_board:accept_difficult_job_disabled_layer);
    if (%wc_update09_difficulty = 0) {
        if_settext("<tostring(%wc_update09_actual_short)>/<tostring(calc((%wc_update09_target_short + 1) * 5))>  Short plank<br><tostring(%wc_update09_actual_long)>/<tostring(calc((%wc_update09_target_long + 1) * 5))>  Long plank<br><tostring(%wc_update09_actual_diag)>/<tostring(calc((%wc_update09_target_diag + 1) * 5))>  Diagonal plank<br><tostring(%wc_update09_actual_tooth)>/<tostring(calc((%wc_update09_target_tooth + 1) * 5))>  Tooth plank<br><tostring(%wc_update09_actual_groove)>/<tostring(calc((%wc_update09_target_groove + 1) * 5))>  Groove plank<br><tostring(%wc_update09_actual_curve)>/<tostring(calc((%wc_update09_target_curve + 1) * 5))>  Curved plank", wc_update09_sawmill_job_board:normal_list);
        if_sethide(false, wc_update09_sawmill_job_board:difficult_hide);
    } else {
        if_settext("<tostring(%wc_update09_actual_short)>/<tostring(calc((%wc_update09_target_short + 1) * 5))>  Short plank<br><tostring(%wc_update09_actual_long)>/<tostring(calc((%wc_update09_target_long + 1) * 5))>  Long plank<br><tostring(%wc_update09_actual_diag)>/<tostring(calc((%wc_update09_target_diag + 1) * 5))>  Diagonal plank<br><tostring(%wc_update09_actual_tooth)>/<tostring(calc((%wc_update09_target_tooth + 1) * 5))>  Tooth plank<br><tostring(%wc_update09_actual_groove)>/<tostring(calc((%wc_update09_target_groove + 1) * 5))>  Groove plank<br><tostring(%wc_update09_actual_curve)>/<tostring(calc((%wc_update09_target_curve + 1) * 5))>  Curved plank", wc_update09_sawmill_job_board:difficult_list);
        if_sethide(false, wc_update09_sawmill_job_board:normal_hide);
    }
}
