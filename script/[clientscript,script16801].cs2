// 16801
[clientscript,script16801](component $component0, component $component1)
def_int $int2 = %wildy_pvp_toggle_warning;
def_graphic $graphic3 = "warning_icons,1";
if ($int2 = 1) {
    if_sethide(false, $component0);
    if_setgraphic("warning_icons,2", $component1);
    if_setonclick("graphic_swapper($component1, $graphic3)", $component0);
} else {
    if_sethide(false, $component0);
    if_setgraphic("warning_icons,1", $component1);
    $graphic3 = "warning_icons,2";
    if_setonclick("graphic_swapper($component1, $graphic3)", $component0);
}
