// 10025
[proc,script10025](obj $obj0, int $int1, int $int2, int $int3)
switch_int ($int2) {
    case default :
        cc_setobject($obj0, $int1);
    case 1 :
        cc_setobject_nonum($obj0, $int1);
    case 2 :
        cc_setobject_alwaysnum($obj0, $int1);
    case 3 :
        cc_setobject_highres($obj0);
        return;
}
cc_setoutline($int3);
