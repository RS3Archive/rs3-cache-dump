// 17232
[proc,script17232](dbrow $dbrow0)(string)
def_int $int1 = 0;
def_int $int2 = db_getfieldcount($dbrow0, requirements:col4);
def_quest $quest3 = null;
def_string $string0 = "";
def_string $string1 = "";
while ($int1 < $int2) {
    $quest3 = db_getfield($dbrow0, requirements:col4, $int1);
    if (quest_finished($quest3) = false) {
        $string1 = quest_getname($quest3);
        $string0 = ~script17238($string0, "Complete quest: <$string1>");
    }
    $int1 = calc($int1 + 1);
}
return($string0);
