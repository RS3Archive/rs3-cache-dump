[proc,script19994](component $component0, component $component1, dbrow $dbrow2)
if_setonmouseover("trh_chest_onmouseover($component1, db_getfield($dbrow2, trh_chest:col9, 0), db_getfield($dbrow2, trh_chest:col10, 0))", $component0);
if_setonmouseleave("trh_chest_onmouseleave($component1, db_getfield($dbrow2, trh_chest:col8, 0))", $component0);
