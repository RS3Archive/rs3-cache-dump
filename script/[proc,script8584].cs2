// 8584
[proc,script8584](stat $stat0, int $int1, quest $quest2)(string, int)
if ($quest2 = null) {
    ~error("$quest for <tostring($int1)> <enum(stat, string, stat_to_string, $stat0)> is null");
    return("", 0);
}
if (~ql4_getquestcomplete($quest2) = true) {
    return("", 0);
}
def_int $int3 = stat_base($stat0);
def_int $int4 = 0;
def_int $int5 = 0;
if ($quest2 = while_guthix_sleeps & ($stat0 = strength | $stat0 = attack)) {
    if ($stat0 = attack) {
        $int4 = stat_base_actual(strength);
        $int5 = %lvl_strength_before_levelup_varc;
    } else {
        $int4 = stat_base_actual(attack);
        $int5 = %lvl_attack_before_levelup_varc;
    }
    if (calc($int1 + $int5) < 130 & calc($int3 + $int4) >= 130) {
        return(~script8583($stat0, $int3, $quest2));
    } else {
        return("", 0);
    }
}
def_int $int6 = quest_statreq_count($quest2);
def_stat $stat7 = null;
def_int $int8 = 0;
def_int $int9 = 0;
while ($int9 < $int6) {
    $stat7, $int8 = ~script2112($quest2, calc($int9 + 1));
    if ($stat7 = null) {
        return("", 0);
    }
    if ($stat7 = $stat0 & $int3 >= $int8 & $int1 < $int8) {
        return(~script8582($stat0, $int8, $quest2));
    }
    $int9 = calc($int9 + 1);
}
return("", 0);
