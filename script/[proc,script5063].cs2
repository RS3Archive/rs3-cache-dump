// 5063
[proc,script5063](component $component0, int $int1, int $int2)
def_int $int3 = calc($int1 * 12);
if ($int2 = 1) {
    if (cc_find($component0, calc($int3 + 5)) = true) {
        cc_setgraphic("aif_button_group_2,4");
    }
    if (cc_find($component0, calc($int3 + 6)) = true) {
        cc_setgraphic("aif_button_group_2,3");
    }
    if (cc_find($component0, calc($int3 + 7)) = true) {
        cc_setgraphic("aif_button_group_2,5");
    }
} else {
    if (cc_find($component0, calc($int3 + 5)) = true) {
        cc_setgraphic("aif_button_group_2,1");
    }
    if (cc_find($component0, calc($int3 + 6)) = true) {
        cc_setgraphic("aif_button_group_2,0");
    }
    if (cc_find($component0, calc($int3 + 7)) = true) {
        cc_setgraphic("aif_button_group_2,2");
    }
}
if (cc_find($component0, calc($int3 + 10)) = true) {
    cc_setgraphic("aif_settings_icon,1");
}
