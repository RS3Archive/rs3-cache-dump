// 5959
[clientscript,script5959]
def_string $string0 = "";
switch_int (%clan_contribution_bonus_varp) {
    case 1 :
        $string0 = "15% Bonus Citadel Skilling XP";
    case 2 :
        $string0 = "30% Bonus Citadel Skilling XP";
    case 3 :
        $string0 = "45% Bonus Citadel Skilling XP";
}
if (compare($string0, "") ! 0) {
    ~script4408(clan_resource_data:fealty);
    if (~script6431 = false) {
        if_setonmouserepeat("script8799($string0, event_com, event_comsubid)", clan_resource_data:fealty);
    } else {
        if_setonclick("script8799($string0, event_com, event_comsubid)", clan_resource_data:fealty);
    }
}
