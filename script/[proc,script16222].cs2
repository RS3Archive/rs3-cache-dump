// 16222
[proc,script16222](component $component0, int $int1, graphic $graphic2, graphic $graphic3)
if (cc_find($component0, $int1) = true) {
    cc_setgraphic($graphic2);
    cc_setonmouseover("graphic_swapper_dynamic($component0, $int1, $graphic3)");
    cc_setonmouseleave("graphic_swapper_dynamic($component0, $int1, $graphic2)");
}
