// 16
[proc,script16]
if (~script6431 = false) {
    if_sethide(true, interface_1270:com_14);
    if_setonmouserepeat("script6131(event_mousex, event_mousey)", interface_1270:com_17);
} else {
    if_setop(1, "", interface_1270:com_16);
    if_setonclick("script6131(event_mousex, event_mousey)", interface_1270:com_17);
    if_sethide(false, interface_1270:com_14);
    %varclient_1889 = calc(if_getwidth(interface_1270:com_2) / 2);
    %varclient_1890 = calc(if_getheight(interface_1270:com_2) / 2);
    if_setposition(calc(%varclient_1889 - if_getwidth(interface_1270:com_14) / 2), calc(%varclient_1890 - if_getheight(interface_1270:com_14) / 2), ^setpos_abs_left, ^setpos_abs_top, interface_1270:com_14);
    cc_create(interface_1270:com_14, ^iftype_rectangle, 0);
    cc_setposition(0, 0, ^setpos_abs_centre, ^setpos_abs_centre);
    cc_setsize(40, 40, ^setsize_abs, ^setsize_abs);
    cc_setonop("script119");
    cc_setop(6, "Place beacon");
    cc_setfill(true);
    cc_settrans(255);
    cc_setnoclickthrough(true);
}
