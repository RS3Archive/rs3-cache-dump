// 16
[proc,script16]
if (~script6431 = false) {
    if_sethide(true, fremsaga_bilrach_mind:cursor_layer);
    if_setonmouserepeat("script6131(event_mousex, event_mousey)", fremsaga_bilrach_mind:mouse_track_layer);
} else {
    if_setop(1, "", fremsaga_bilrach_mind:mind_bg);
    if_setonclick("script6131(event_mousex, event_mousey)", fremsaga_bilrach_mind:mouse_track_layer);
    if_sethide(false, fremsaga_bilrach_mind:cursor_layer);
    %fremsaga_bilrach_mind_mouse_x = calc(if_getwidth(fremsaga_bilrach_mind:wrapper_layer) / 2);
    %fremsaga_bilrach_mind_mouse_y = calc(if_getheight(fremsaga_bilrach_mind:wrapper_layer) / 2);
    if_setposition(calc(%fremsaga_bilrach_mind_mouse_x - if_getwidth(fremsaga_bilrach_mind:cursor_layer) / 2), calc(%fremsaga_bilrach_mind_mouse_y - if_getheight(fremsaga_bilrach_mind:cursor_layer) / 2), ^setpos_abs_left, ^setpos_abs_top, fremsaga_bilrach_mind:cursor_layer);
    cc_create(fremsaga_bilrach_mind:cursor_layer, ^iftype_rectangle, 0);
    cc_setposition(0, 0, ^setpos_abs_centre, ^setpos_abs_centre);
    cc_setsize(40, 40, ^setsize_abs, ^setsize_abs);
    cc_setonop("script119");
    cc_setop(6, "Place beacon");
    cc_setfill(true);
    cc_settrans(255);
    cc_setnoclickthrough(true);
}
