// 5985
[clientscript,script5985](component $component0)
cc_deleteall($component0);
def_int $int1 = if_getnextsubid($component0);
cc_create($component0, ^iftype_rectangle, if_getnextsubid($component0));
cc_setcolour(^white);
cc_setfill(true);
cc_setposition(2, 2, ^setpos_abs_left, ^setpos_abs_top);
cc_setsize(4, 4, ^setsize_minus, ^setsize_minus);
cc_settrans(255);
cc_setonmouseover("cc_settrans($component0, $int1, 180)");
cc_setonmouseleave("cc_settrans($component0, $int1, 255)");
