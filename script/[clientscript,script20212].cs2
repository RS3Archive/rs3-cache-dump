// 20212
[clientscript,script20212](int $int0)
def_int $int1 = calc(clientclock - $int0);
def_int $int2 = if_getwidth(league_onboarding:logo_wrapper);
def_int $int3 = scale($int2, 500, 456);
if ($int1 < 50) {
    if_settrans(scale(255, 50, $int1), league_onboarding:flash);
} else if ($int1 < 150) {
    $int1 = calc($int1 - 50);
    if_settrans(255, league_onboarding:flash);
    if_setgraphic(league_logo_500x456, league_onboarding:logo);
    if_settrans(calc(255 - scale(255, 100, $int1)), league_onboarding:logo);
    if_settrans(calc(255 - scale(255, 100, $int1)), league_onboarding:logo_bg);
} else if ($int1 < 250) {
    if_settrans(0, league_onboarding:logo);
    if_settrans(0, league_onboarding:logo_bg);
    $int1 = calc($int1 - 150);
    if_settrans(calc(255 - scale(255, 100, $int1)), league_onboarding:subheader_text);
} else if ($int1 < 350) {
    if_settrans(0, league_onboarding:subheader_text);
    $int1 = calc($int1 - 250);
    $int2 = calc(500 - scale(500, 200, $int1));
} else if ($int1 < 450) {
    if ($int1 = 351) {
        ~script20224;
    }
    $int1 = calc($int1 - 350);
    ~script20220(calc(255 - scale(255, 100, $int1)));
    ~script20221(calc(255 - scale(255, 100, $int1)));
} else {
    ~script20220(0);
    ~script20221(0);
    if_setontimer(null, league_onboarding:anim_listener);
}
if_setsize(700, calc($int3 - 20), ^setsize_abs, ^setsize_minus, league_onboarding:panels_bg);
if_setsize($int2, $int3, ^setsize_abs, ^setsize_abs, league_onboarding:logo_wrapper);
if_setposition(0, $int3, ^setpos_abs_centre, ^setpos_abs_top, league_onboarding:subheader);
$int3 = calc($int3 + if_getheight(league_onboarding:subheader) + 4 * 2);
if_setposition(0, $int3, ^setpos_abs_centre, ^setpos_abs_top, league_onboarding:contents);
if_setsize(0, $int3, ^setsize_minus, ^setsize_minus, league_onboarding:contents);
