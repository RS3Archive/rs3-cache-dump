// 10869
[clientscript,script10869](component $component0)
switch_component ($component0) {
    case xmas2014_snowboard_prep:trick_icon_1 :
        if (%xmas2014_snowboard_trick_1 = 1) {
            if_setgraphic("snowboard_icon_xmas14,0", $component0);
        } else {
            if_setgraphic("snowboard_icon_xmas14_off,0", $component0);
        }
    case xmas2014_snowboard_prep:trick_icon_2 :
        if (%xmas2014_snowboard_trick_2 = 1) {
            if_setgraphic("snowboard_icon_xmas14,1", $component0);
        } else {
            if_setgraphic("snowboard_icon_xmas14_off,1", $component0);
        }
    case xmas2014_snowboard_prep:trick_icon_3 :
        if (%xmas2014_snowboard_trick_3 = 1) {
            if_setgraphic("snowboard_icon_xmas14,2", $component0);
        } else {
            if_setgraphic("snowboard_icon_xmas14_off,2", $component0);
        }
    case xmas2014_snowboard_prep:trick_icon_4 :
        if (%xmas2014_snowboard_trick_4 = 1) {
            if_setgraphic("snowboard_icon_xmas14,3", $component0);
        } else {
            if_setgraphic("snowboard_icon_xmas14_off,3", $component0);
        }
}
