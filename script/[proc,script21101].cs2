// 21101
[proc,script21101]
def_int $int0 = 0;
def_int $int1 = inv_size(inv);
while ($int0 < $int1) {
    if (testbit(%dino_herb_bag_grey_out, $int0) = ^true & cc_find(league_relic_herb_bag:inv_contents_layer, $int0) = true) {
        cc_settrans(175);
    }
    $int0 = calc($int0 + 1);
}
