// 1996
[clientscript,town_notification](string $string0)
def_component $component0 = town_ingame_hud:notification_text;
def_component $component1 = town_ingame_hud:text_layer;
def_int $int2 = paraheight($string0, if_getwidth($component0), if_getfontmetrics($component0));
$int2 = calc($int2 * 17 + 20);
if_setsize(170, $int2, ^setsize_minus, ^setsize_abs, $component1);
if_settext($string0, $component0);
if_sethide(false, $component1);
mes($string0);
