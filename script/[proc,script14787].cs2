// 14787
[proc,script14787](dbrow $dbrow0, int $int1)
if_sethide(true, bonds_gratz:runecoins_layer);
if_sethide(true, bonds_gratz:generic_redeem_layer);
if_sethide(false, bonds_gratz:namechange_redeem_layer);
switch_int ($int1) {
    case 1 :
        ~script1296("Sorry, we were unable to process your request. Please try again later.");
    case 2 :
        if_settext("Bond redeemed.", bonds_gratz:namechange_1);
        if_settext("You can now change your display name.", bonds_gratz:namechange_2);
        if_sethide(true, bonds_gratz:confirm_button);
        if_sethide(false, bonds_gratz:namechange_redeem_confirm_button);
        ~script13463("You've redeemed a bond to change your display name. You can now change your display name.");
    case 3 :
        if_settext("Bond redeemed", bonds_gratz:namechange_1);
        if_settext("You will be able to change your display name shortly.", bonds_gratz:namechange_2);
        ~script13463("You've redeemed a bond to change your display name. You will be able to change your display name shortly.");
    case 4 :
        if_sethide(true, bonds_gratz:firework_layer);
        ~script9554(bonds_gratz:background, bonds_gratz:border, bonds_gratz:content, "Sorry", toplevel_v2_default_main_modal_skin_data);
        if_settext("We were unable to process your request.", bonds_gratz:namechange_1);
        if_settext("Please try again later.", bonds_gratz:namechange_2);
        ~script1296("Sorry, we were unable to process your request. Please try again later.");
    case 5 :
        if_sethide(true, bonds_gratz:firework_layer);
        ~script9554(bonds_gratz:background, bonds_gratz:border, bonds_gratz:content, "Sorry", toplevel_v2_default_main_modal_skin_data);
        if_settext("We were unable to process your request.", bonds_gratz:namechange_1);
        if_settext("Please try again later.", bonds_gratz:namechange_2);
        ~script1296("Sorry, we were unable to process your request. Please try again later.");
}
