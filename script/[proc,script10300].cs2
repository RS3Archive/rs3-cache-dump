// 10300
[proc,script10300](component $component0)(component)
if ($component0 = toplevel_v2_parent_suboverlay_group:main_layer) {
    return(toplevel_v2_parent_suboverlay_group:leave_group_layer);
} else if ($component0 = group_child_dropdown:content_layer) {
    return(group_child_dropdown:leave_group_layer);
} else {
    return(group_child:leave_group_layer);
}
