// 14128
[proc,script14128](component $component0, struct $struct1)(string)
switch_component ($component0) {
    case trh_bingo:prestige_level :
        return("The amount of times you have prestiged your Tribal task list.");
    case trh_bingo:use_stamp_button_layer :
        return("Use Tribal mask stamps to instantly complete tasks.");
    case trh_bingo:easy_task_1 :
        return("Making Music : Listen to the two drummers that can be found in Karamja - <tostring(~script5542($struct1, 0))>/<tostring(2)>");
    case trh_bingo:easy_task_2 :
        return("Magical Intervention : Kill 10 enemies with magic - <tostring(~script5542($struct1, 1))>/<tostring(10)>");
    case trh_bingo:easy_task_3 :
        return("Idolising : Find and talk to the wandering Tribal idol.");
    case trh_bingo:easy_task_4 :
        return("Exorcism : Burn 15 Mort'Ton shades on pyres - <tostring(~script5542($struct1, 3))>/<tostring(15)>");
    case trh_bingo:medium_task_1 :
        return("Laid To Rest : Bury 50 Zogre bones - <tostring(~script5542($struct1, 4))>/<tostring(50)>");
    case trh_bingo:medium_task_2 :
        return("Chicken Tiki : Cook 50 chickens on the fires near the cauldron west of the Karamja lodestone - <tostring(~script5542($struct1, 5))>/<tostring(50)>");
    case trh_bingo:medium_task_3 :
        return("Nature's Purification : Contribute towards Evil Tree 250 times - <tostring(~script5542($struct1, 6))>/<tostring(250)>");
    case trh_bingo:medium_task_4 :
        return("Monkey Madness : Complete Ape Atoll agility course 25 times - <tostring(~script5542($struct1, 7))>/<tostring(25)>");
    case trh_bingo:hard_task_1 :
        return("Crafting Juju : Create any five Juju potions - <tostring(~script5542($struct1, 8))>/<tostring(5)>");
    case trh_bingo:hard_task_2 :
        return("Exploring the Occult : Solo a medium Occult dungeoneering floor (or hard mode floor) on high complexity.");
    case trh_bingo:hard_task_3 :
        return("Grave Robbing : Loot any piece of Barrows equipment.");
    case trh_bingo:hard_task_4 :
        return("Reaping : Complete a soul reaper assignment.");
    case trh_bingo:elite_task_1 :
        return("Preparation : Harvest 30 Fellstalk - <tostring(~script5542($struct1, 12))>/<tostring(30)>");
    case trh_bingo:elite_task_2 :
        return("All Fired Up : Light all bonfires in the All Fired Up minigame (they must all be alight at the same time).");
    case trh_bingo:elite_task_3 :
        return("Taming Nihil : Create 25 Nihil summoning pouches - <tostring(~script5542($struct1, 14))>/<tostring(25)>");
    case trh_bingo:elite_task_4 :
        return("Habitat : Catch 200 God Jadinkos in Herblore Habitat - <tostring(~script5542($struct1, 15))>/<tostring(200)>");
    case trh_bingo:line_prize_1 :
        return("Complete this line to get a medium cash bag.");
    case trh_bingo:line_prize_2 :
        return("Complete this line to get a large cash bag.");
    case trh_bingo:line_prize_3 :
        return("Complete this line to get a huge prismatic star.");
    case trh_bingo:line_prize_4 :
        return("Complete this line to get a huge prismatic lamp.");
    case trh_bingo:column_prize_1 :
        switch_int (%trh140_prestige) {
            case 0 :
                return("Complete this column to receive the Iwi Outfit hand and feet wraps (pink).");
            case 2 :
                return("Complete this column to receive the Iwi Outfit hand and feet wraps (blue).");
            case 4 :
                return("Complete this column to receive the Iwi Outfit hand and feet wraps (orange).");
            case 1, 3 :
                return("Complete this column to receive a large cash bag.");
        }
    case trh_bingo:column_prize_2 :
        switch_int (%trh140_prestige) {
            case 0 :
                return("Complete this column to receive the Iwi Outfit shin guards (pink).");
            case 2 :
                return("Complete this column to receive the Iwi Outfit shin guards (blue).");
            case 4 :
                return("Complete this column to receive the Iwi Outfit shin guards (orange).");
            case 1, 3 :
                return("Complete this column to receive a huge prismatic star.");
        }
    case trh_bingo:column_prize_3 :
        switch_int (%trh140_prestige) {
            case 0 :
                return("Complete this column to receive the Iwi Outfit chest piece (pink).");
            case 2 :
                return("Complete this column to receive the Iwi Outfit chest piece (blue).");
            case 4 :
                return("Complete this column to receive the Iwi Outfit chest piece (orange).");
            case 1, 3 :
                return("Complete this column to receive a huge prismatic lamp.");
        }
    case trh_bingo:column_prize_4 :
        switch_int (%trh140_prestige) {
            case 0 :
                return("Complete this column to receive the Iwi Outfit mask (pink).");
            case 2 :
                return("Complete this column to receive the Iwi Outfit mask (blue).");
            case 4 :
                return("Complete this column to receive the Iwi Outfit mask (orange).");
            case 1, 3 :
                return("Complete this column to receive 2 huge prismatic stars.");
        }
    case trh_bingo:prestige_1_layer :
        return("Iwi Sword main and offhand Overrides.");
    case trh_bingo:prestige_2_layer :
        return("Iwi Shield Override.");
    case trh_bingo:prestige_3_layer :
        return("Iwi Javelin Override.");
    case trh_bingo:prestige_4_layer :
        return("Iwi Staff Override.");
    case trh_bingo:prestige_5_layer :
        return("Howie Pet.");
}
