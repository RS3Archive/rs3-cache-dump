// 2118
[proc,script2118](int $int0)
def_int $int1 = if_getnextsubid(qps:claim_layer_build);
if (%qps_unlocks_hub_3 = 1 & ~obj_gettotal(qps_reward_ring) = 0) {
    cc_create(qps:claim_layer_build, ^iftype_graphic, $int1);
    cc_setsize(100, 100, ^setsize_abs, ^setsize_abs);
    cc_setposition(calc(10 + $int0 * 110), 0, ^setpos_abs_left, ^setpos_abs_centre);
    cc_setgraphic(struct_param(qps_track_hub_node_3, qps_if_graphic));
    cc_setonmouserepeat("script3876(struct_param(qps_track_hub_node_3, qps_if_node_title), event_com, event_comsubid)");
}
