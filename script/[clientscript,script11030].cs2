[clientscript,script11030]
switch_int (map_lang) {
    case 1 :
        if_setgraphic(trh55_faction_quadrant_godless_de, interface_1631:com_77);
        if_setgraphic(trh55_astromancer_overlay_de, interface_1631:com_50);
    case 2 :
        if_setgraphic(trh55_faction_quadrant_godless_fr, interface_1631:com_77);
        if_setgraphic(trh55_astromancer_overlay_fr, interface_1631:com_50);
    case 3 :
        if_setgraphic(trh55_faction_quadrant_godless_pt, interface_1631:com_77);
        if_setgraphic(trh55_astromancer_overlay_pt, interface_1631:com_50);
    case default :
        if_setgraphic(trh55_faction_quadrant_godless_en, interface_1631:com_77);
        if_setgraphic(trh55_astromancer_overlay_en, interface_1631:com_50);
}
