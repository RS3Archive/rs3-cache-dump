// 11030
[clientscript,script11030]
switch_int (map_lang) {
    case 1 :
        if_setgraphic(trh55_faction_quadrant_godless_de, trh55_world_event:godless_background);
        if_setgraphic(trh55_astromancer_overlay_de, trh55_world_event:astromancer_overlay);
    case 2 :
        if_setgraphic(trh55_faction_quadrant_godless_fr, trh55_world_event:godless_background);
        if_setgraphic(trh55_astromancer_overlay_fr, trh55_world_event:astromancer_overlay);
    case 3 :
        if_setgraphic(trh55_faction_quadrant_godless_pt, trh55_world_event:godless_background);
        if_setgraphic(trh55_astromancer_overlay_pt, trh55_world_event:astromancer_overlay);
    case default :
        if_setgraphic(trh55_faction_quadrant_godless_en, trh55_world_event:godless_background);
        if_setgraphic(trh55_astromancer_overlay_en, trh55_world_event:astromancer_overlay);
}
