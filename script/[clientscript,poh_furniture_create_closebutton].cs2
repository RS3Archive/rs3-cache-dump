// 6314
[clientscript,poh_furniture_create_closebutton](component $component0)
if (testbit(%mob_client_squad_rank, 0) = ^true) {
    if_clearops($component0);
    if_clearscripthooks($component0);
    if_setpausetext("Back", $component0);
} else {
    if_setop(1, "Close", $component0);
    if_setonop("closebutton_click", $component0);
    if_setpausetext("", $component0);
}
if_setonvarctransmit("poh_furniture_create_closebutton($component0){mob_client_squad_rank}", $component0);
