// 9755
[clientscript,script9755](int $int0)
switch_int ($int0) {
    case 0 :
        if_setonmouseover("graphic_swapper(polls:polls_featured_gold_background, \"aif_pttp_feature_tab_gold_02,1\")", polls:polls_featured_gold);
        if_setonmouseleave("graphic_swapper(polls:polls_featured_gold_background, \"aif_pttp_feature_tab_gold_02,0\")", polls:polls_featured_gold);
    case 1 :
        if_setonmouseover("graphic_swapper(polls:polls_featured_silver_background, \"aif_pttp_feature_tab_silver_02,1\")", polls:polls_featured_silver);
        if_setonmouseleave("graphic_swapper(polls:polls_featured_silver_background, \"aif_pttp_feature_tab_silver_02,0\")", polls:polls_featured_silver);
    case 2 :
        if_setonmouseover("graphic_swapper(polls:polls_featured_bronze_background, \"aif_pttp_feature_tab_bronze_02,1\")", polls:polls_featured_bronze);
        if_setonmouseleave("graphic_swapper(polls:polls_featured_bronze_background, \"aif_pttp_feature_tab_bronze_02,0\")", polls:polls_featured_bronze);
}
