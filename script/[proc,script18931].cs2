[proc,script18931](dbrow $dbrow0)(int)
def_int $int1 = -1;
switch_dbrow ($dbrow0) {
    case uitutorial_helpbutton_adventures_calendar_4 :
        if (cc_find(calendar_main:entries_container, 0) = true) {
            $int1 = 0;
        }
    case uitutorial_helpbutton_league_blessings_1 :
        $int1 = ~script17441(0, 1);
    case uitutorial_helpbutton_league_blessings_2, uitutorial_helpbutton_league_blessings_3 :
        $int1 = ~script17441(3, 1);
    case default :
