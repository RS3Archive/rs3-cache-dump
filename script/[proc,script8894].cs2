// 8894
[proc,script8894](stat $stat0)(graphic)
switch_stat ($stat0) {
    case attack :
        return("challenge_skill_icons_35px,0");
    case strength :
        return("challenge_skill_icons_35px,1");
    case defence :
        return("challenge_skill_icons_35px,2");
    case ranged :
        return("challenge_skill_icons_35px,3");
    case prayer :
        return("challenge_skill_icons_35px,4");
    case mining :
        return("challenge_skill_icons_35px,5");
    case hitpoints :
        return("challenge_skill_icons_35px,6");
    case firemaking :
        return("challenge_skill_icons_35px,7");
    case thieving :
        return("challenge_skill_icons_35px,8");
    case hunter :
        return("challenge_skill_icons_35px,9");
    case crafting :
        return("challenge_skill_icons_35px,10");
    case fletching :
        return("challenge_skill_icons_35px,11");
    case magic :
        return("challenge_skill_icons_35px,12");
    case runecraft :
        return("challenge_skill_icons_35px,13");
    case woodcutting :
        return("challenge_skill_icons_35px,14");
    case smithing :
        return("challenge_skill_icons_35px,15");
    case construction :
        return("challenge_skill_icons_35px,16");
    case herblore :
        return("challenge_skill_icons_35px,17");
    case fishing :
        return("challenge_skill_icons_35px,18");
    case cooking :
        return("challenge_skill_icons_35px,19");
    case farming :
        return("challenge_skill_icons_35px,20");
    case slayer :
        return("challenge_skill_icons_35px,21");
    case dungeoneering :
        return("challenge_skill_icons_35px,22");
    case summoning :
        return("challenge_skill_icons_35px,23");
    case agility :
        return("challenge_skill_icons_35px,24");
    case divination :
        return("challenge_skill_icons_35px,25");
}
return(null);
