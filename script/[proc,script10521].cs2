// 10521
[proc,script10521](component $component0, int $int1)
if (%p_dialog_mode = 9) {
    switch_component ($component0) {
        case text_input_dialog:text_input_listen :
            if_sethide(true, text_input_dialog:input_confirm_instructions);
        case bonds_namechange_change:text_input_listen :
            ~script9853;
        case player_inspect_settings:text_input_listen :
            ~script10787;
        case investigate:text_input_listen :
            if_sethide(true, investigate:input_confirm_instructions);
        case bank:text_input_listen :
            ~script13907;
        case group_ironman_storage:text_input_listen :
            ~script19557;
    }
} else if (%p_dialog_mode = 7) {
    switch_component ($component0) {
        case stockmarket:price_input_listen :
            ~script15050($int1);
        case stockmarket:quantity_input_listen :
            ~script15051($int1);
        case marketplace_bonus_xp_redeem:quantity_input_listen :
            ~script20584($int1);
    }
}
switch_component ($component0) {
    case stockmarket:search_input_listen :
        if (compare(%stock_search_save, "") ! 0) {
            if_sethide(false, stockmarket:search_input_clickout);
            if_setonclick("stockmarket_clear_search", stockmarket:search_input_clickout);
        }
}
