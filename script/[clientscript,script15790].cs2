// 15790
[clientscript,script15790](int $int0)
def_int $int1 = 0;
def_int $int2 = 0;
switch_int (%tut7_main) {
    case 10 :
        if (%zoom > calc($int0 + 250) | %zoom < calc($int0 - 250)) {
            if_triggerop(tut7_camera:continue_button, -1, 1);
            if_setontimer(null, tut7_camera:main_container);
            return;
        }
    case 15 :
        $int1, $int2 = cam2_getpositionentity_angleoffsets;
        if ($int2 >= 7000 & $int2 <= 10000) {
            if_triggerop(tut7_camera:continue_button, -1, 1);
            if_setontimer(null, tut7_camera:main_container);
            return;
        }
}
if_setontimer("script15790($int0)", tut7_camera:main_container);
