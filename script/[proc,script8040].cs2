// 8040
[proc,script8040](inv $inv0, obj $obj1)(boolean)
if ($obj1 = null) {
    return(false);
}
if (oc_wearpos($obj1) = 3) {
    if (oc_wearpos2($obj1) = 5 & inv_getobj($inv0, 5) ! null) {
        return(true);
    }
    return(false);
} else if (oc_wearpos($obj1) ! 5) {
    return(false);
}
def_obj $obj2 = inv_getobj($inv0, 3);
if ($obj2 = null) {
    return(false);
}
if (oc_wearpos2($obj2) = 5) {
    return(true);
}
return(false);
