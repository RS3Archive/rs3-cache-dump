// 19885
[proc,script19885](obj $obj0, int $int1)(obj, int)
switch_obj ($obj0) {
    case timed_event_fallen_nihil_outfit :
        if (~script19384(event1_demon_outfit_struct) = 1) {
            return(null, 0);
        }
    case timed_event_deathbeard_outfit :
        if (~script19384(event2_pirate_outfit_struct) = 1) {
            return(null, 0);
        }
    case timed_event_deathbeard_ghost_outfit :
        if (~script19384(event2_ghost_pirate_outfit_struct) = 1) {
            return(null, 0);
        }
    case timed_event_furies_agent_outfit :
        if (~script19384(event4_incubus_outfit_struct) = 1) {
            return(null, 0);
        }
}
return($obj0, $int1);
