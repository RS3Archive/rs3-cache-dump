// 11125
[clientscript,script11125](obj $obj0)
if ($obj0 = easter15_correct_egg) {
    if_setgraphic(easter2015_egg_base_combined, easter15_hatching:egg_graphic);
    if_sethide(true, easter15_hatching:egg_spots_graphic_1);
    if_sethide(true, easter15_hatching:egg_spots_graphic_2);
    if_sethide(true, easter15_hatching:egg_graphic_bottom);
    if_setmodel(easter_2015_jadinko_baby4, easter15_hatching:complete_jadinko_model);
} else {
    if_sethide(false, easter15_hatching:egg_spots_graphic_1);
    if_sethide(false, easter15_hatching:egg_spots_graphic_2);
    if_sethide(false, easter15_hatching:egg_graphic_bottom);
    if_setmodel(easter_2015_jadinko_baby5, easter15_hatching:complete_jadinko_model);
}
if_setcolour(oc_param($obj0, easter15_shell_colour), easter15_hatching:egg_graphic);
if_setcolour(oc_param($obj0, easter15_spot_colour), easter15_hatching:egg_spots_graphic_1);
if_setcolour(oc_param($obj0, easter15_spot_colour), easter15_hatching:egg_spots_graphic_2);
if_setcolour(oc_param($obj0, easter15_spot_colour), easter15_hatching:egg_graphic_bottom);
if_setrecol(1, 36840, oc_param($obj0, easter15_recol1), easter15_hatching:complete_egg_model);
if_setrecol(2, 17384, oc_param($obj0, easter15_recol2), easter15_hatching:complete_egg_model);
if_setrecol(3, 55232, oc_param($obj0, easter15_recol3), easter15_hatching:complete_egg_model);
if_setrecol(4, 6798, oc_param($obj0, easter15_recol4), easter15_hatching:complete_egg_model);
