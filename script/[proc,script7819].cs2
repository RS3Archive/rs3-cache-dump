// 7819
[proc,script7819](component $component0)
switch_component ($component0) {
    case toplevel_v2_parent_suboverlay_prayer:prayer_buttons :
        ~script5808(struct_param(prayer_draw_prayers_sub_overlay, prayer_child_stats), 0);
        ~prayer_load_buttons($component0, prayer_draw_prayers_sub_overlay);
    case prayer_quick_preset_interface:prayer_buttons :
        ~prayer_load_buttons($component0, prayer_draw_prayers_quick_prayers);
    case toplevel_v2_prayer:prayer_buttons :
        ~prayer_load_buttons($component0, prayer_draw_prayers_normal);
}
