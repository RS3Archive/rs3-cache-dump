// 376
[clientscript,script376](component $component0, component $component1)
if (%toplevel_v2_undock_target_info = 1 | %toplevel_v2_mobile_interface = 1) {
    if_setgraphic(hud_combat_btn_unlocked, $component0);
    if_setop(1, "Dock", toplevel_v2_target_info:docking_padlock);
    if (if_find($component1) = true) {
        ~script3927(2008);
    }
} else {
    if_setgraphic(hud_combat_btn_locked, $component0);
    if_setop(1, "Undock", toplevel_v2_target_info:docking_padlock);
    if (if_find($component1) = true) {
        ~script3927(-1);
    }
}
