// 16179
[clientscript,script16179]
if_setgraphic(trh62_multiplier_single_x2_inactive, trh168:multiplier_x2);
if_setgraphic(trh62_multiplier_single_x3_inactive, trh168:multiplier_x3);
if_setgraphic(trh62_multiplier_single_x4_inactive, trh168:multiplier_x4);
switch_int (%trh168_prize_multiplier) {
    case 2 :
        if_setgraphic(trh62_multiplier_single_x2_active, trh168:multiplier_x2);
        if_setmodel(mtxjul_th_adamant_chest, trh168:claim_chest_model);
    case 3 :
        if_setgraphic(trh62_multiplier_single_x3_active, trh168:multiplier_x3);
        if_setmodel(mtxjul_th_runite_chest, trh168:claim_chest_model);
    case 4 :
        if_setgraphic(trh62_multiplier_single_x4_active, trh168:multiplier_x4);
        if_setmodel(mtxjul_th_dragon_chest, trh168:claim_chest_model);
    case default :
        if_setmodel(trh_chest, trh168:claim_chest_model);
}
