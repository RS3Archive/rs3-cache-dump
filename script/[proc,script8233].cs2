// 8233
[proc,script8233](struct $struct0, inv $inv1, obj $obj2, int $int3)(obj, int)
if ($int3 = 0) {
    ~error("Increment of 0 - would be an infinite loop. Breaking out.");
    return(null, -1);
}
def_int $int4 = 0;
def_obj $obj5 = null;
switch_int (oc_param($obj2, potion_type)) {
    case 0 :
        $obj5, $int4 = ~script8234($struct0, $inv1, 4, 11, $int3);
    case 1, 2, 4, 5, 8 :
        $obj5, $int4 = ~script8234($struct0, $inv1, 8, 11, $int3);
        if ($obj5 = null) {
            $obj5, $int4 = ~script8234($struct0, $inv1, 12, 17, $int3);
        }
    case 6, 10 :
        $obj5, $int4 = ~script8234($struct0, $inv1, 12, 17, $int3);
    case 3, 7 :
        $obj5, $int4 = ~script8234($struct0, $inv1, 10, 11, $int3);
    case 9 :
        $obj5, $int4 = ~script8234($struct0, $inv1, 13, 17, $int3);
}
return($obj5, $int4);
