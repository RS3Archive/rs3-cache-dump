// 747
[clientscript,script747](int $int0, int $int1)
def_int $int2 = if_gettrans(tuska_hub_overlay:prog1_m);
def_component $component3 = tuska_hub_overlay:prog1_m;
def_component $component4 = tuska_hub_overlay:main_progress_bar;
if ($int1 = 0) {
    $int2 = if_gettrans(tuska_world_event_info:prog1_m);
    $component3 = tuska_world_event_info:prog1_m;
    $component4 = tuska_world_event_info:main_progress_bar;
}
if ($int2 ! $int0) {
    if ($int2 > $int0) {
        if_settrans(max(0, calc($int2 - 5)), $component3);
    } else {
        if_settrans(min(255, calc($int2 + 5)), $component3);
    }
} else {
    if_setontimer(null, $component4);
}
