// 9000
[clientscript,script9000](component $component0)
def_component $component1 = null;
def_component $component2 = null;
def_component $component3 = null;
switch_component ($component0) {
    case 6awe1_vote:plus10_button :
        $component1 = 6awe1_vote:plus10_left;
        $component2 = 6awe1_vote:plus10_mid;
        $component3 = 6awe1_vote:plus10_right;
    case 6awe1_vote:plus5_button :
        $component1 = 6awe1_vote:plus5_left;
        $component2 = 6awe1_vote:plus5_mid;
        $component3 = 6awe1_vote:plus5_right;
    case 6awe1_vote:plusall_button :
        $component1 = 6awe1_vote:plusall_left;
        $component2 = 6awe1_vote:plusall_mid;
        $component3 = 6awe1_vote:plusall_right;
    case 6awe1_vote:minus10_button :
        $component1 = 6awe1_vote:minus10_left;
        $component2 = 6awe1_vote:minus10_mid;
        $component3 = 6awe1_vote:minus10_right;
    case 6awe1_vote:minus5_button :
        $component1 = 6awe1_vote:minus5_left;
        $component2 = 6awe1_vote:minus5_mid;
        $component3 = 6awe1_vote:minus5_right;
    case 6awe1_vote:minusall_button :
        $component1 = 6awe1_vote:minusall_left;
        $component2 = 6awe1_vote:minusall_mid;
        $component3 = 6awe1_vote:minusall_right;
}
if_setgraphic("aif_button_standard_text_blue,9", $component1);
if_setgraphic("aif_button_standard_text_blue,10", $component2);
if_setgraphic("aif_button_standard_text_blue,11", $component3);
