// 10574
[clientscript,beards_onclick]
if (%trh29_titles1_owned = 1) {
    return;
}
if (inv_total(inv, trh29_doubloons) < 500) {
    return;
}
if (inv_freespace(inv) = 0) {
    return;
}
%trh29_pirate_coins_shop_selection = 9;
if_setgraphic(trh29_pirate_icon_beard, trh29_pirate_coins_shop:popup_icon);
if_settext("A set of fake pirate beards, wearable by men and women.", trh29_pirate_coins_shop:popup_description);
if_settext("Buy the fake pirate beards?", trh29_pirate_coins_shop:popup_question);
if_sethide(false, trh29_pirate_coins_shop:popup_layer);
