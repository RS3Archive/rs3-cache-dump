// 12796
[proc,script12796]()(int)
if (~death_get_type = 2) {
    if (%deathkeep_info_dangermode = 1 | %deathkeep_info_dangermode = 3) {
        return(0);
    }
    if (bitcount(getbit_range(%death_item_protection_bitmask, 1, 9)) = 0) {
        return(3);
    }
    return(0);
}
return(%death_last_protect_base);
