// 13437
[proc,script13437]
def_component $component0 = repmodal:side_graphic_text_layer;
cc_deleteall($component0);
def_string $string0 = "Increase the standing you have within any of the four factions to unlock city rewards.<br><br>All faction reputation contributes to your overall city ranking and gives you access to additional content.";
cc_create($component0, ^iftype_text, if_getnextsubid($component0));
cc_setsize(120, 400, ^setsize_abs, ^setsize_abs);
cc_setposition(40, 20, ^setpos_abs_left, ^setpos_abs_top);
cc_settextfont(museo_sans_11pt_regular);
cc_settextalign(^settextalign_left, ^settextalign_top, 0);
cc_setcolour(^black);
cc_settext($string0);
