// 966
[proc,fairyrings_rotate_component](component $component0, component $component1, int $int2, int $int3)
def_int $int4 = calc(if_getx($component0) + if_getwidth($component0) / 2);
def_int $int5 = calc(if_gety($component0) + if_getheight($component0) / 2);
def_int $int6 = 0;
def_int $int7 = 0;
def_int $int8 = 0;
def_int $int9 = 0;
def_int $int10 = 0;
if (if_find($component1) = true) {
    $int6 = cc_param(fairyring_start_angle);
    $int7 = cc_param(fairyring_current_angle);
    $int10 = calc(($int6 + $int2) % 360);
    if ($int7 = $int10) {
        return;
    }
    $int7 = calc($int7 + 5 * $int3);
    if ($int7 >= 360) {
        $int7 = calc($int7 - 360);
    }
    if ($int7 < 0) {
        $int7 = calc($int7 + 360);
    }
    $int8, $int9 = ~script2106($int4, $int5, %fairyrings_radius, $int7);
    $int8 = calc($int8 - cc_getwidth / 2);
    $int9 = calc($int9 - cc_getheight / 2);
    cc_setposition($int8, $int9, ^setpos_abs_left, ^setpos_abs_top);
    cc_setparam(fairyring_current_angle, $int7);
}
