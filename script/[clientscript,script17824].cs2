// 17824
[clientscript,script17824]
switch_int (map_lang) {
    case 0 :
        if_setgraphic(trh187_assassin_title_en, trh187_overlay:title);
    case 1 :
        if_setgraphic(trh187_assassin_title_de, trh187_overlay:title);
    case 2 :
        if_setgraphic(trh187_assassin_title_fr, trh187_overlay:title);
    case 3 :
        if_setgraphic(trh187_assassin_title_pt, trh187_overlay:title);
}
if_sethide(false, trh187_overlay:splash_screen);
if_sethide(true, trh187_overlay:universe);
if_settext("<col=00FFFF>NEW Deadly Highwayman's (Master) Outfit</col> and <col=89CFF0>Deadly Highwayman's Outfits</col>. Available from the Assassin Chest!", trh187_overlay:splash_screen_desc);
if_settext("", trh187_overlay:wildcards_desc);
if_settext("Find the <col=8d52e5>Deadly Highwayman</col> for <col=8d52e5>Rare Walk Override, Auras and more!", trh187_overlay:splash_reward_desc);
if_setnpcmodel(trh187_highwayman_blue, trh187_overlay:assassin_1);
if_setmodelangle(0, 0, 0, 150, 0, 500, trh187_overlay:assassin_1);
if_setmodelanim(mtx_ats_player_angry_idle, trh187_overlay:assassin_1);
if_setmodelzoom(600, trh187_overlay:assassin_1);
if_setnpcmodel(trh187_highwayman_master, trh187_overlay:assassin_3);
if_setmodelangle(-80, -10, 0, 0, 0, 500, trh187_overlay:assassin_3);
if_setmodelanim(trh132_faceless_assassin_idle, trh187_overlay:assassin_3);
if_setmodelzoom(calc(600 - 25), trh187_overlay:assassin_3);
if_setnpcmodel(trh187_highwayman_purple, trh187_overlay:assassin_4);
if_setmodelangle(0, 0, 0, 1900, 0, 500, trh187_overlay:assassin_4);
if_setmodelanim(mtx_ats_player_proud_idle, trh187_overlay:assassin_4);
if_setmodelzoom(600, trh187_overlay:assassin_4);
