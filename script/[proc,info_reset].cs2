// 5500
[proc,info_reset]
cc_deleteall(info_box:mainlayer);
def_component $component0 = ~script15709(1);
def_component $component1 = ~script15709(0);
cc_deleteall($component0);
cc_deleteall($component1);
if_sethide(true, info_box:offset_line);
if_setontimer(null, info_box:mainlayer);
if_setontimer(null, $component0);
if_setontimer(null, $component1);
%info_box_height = -1;
