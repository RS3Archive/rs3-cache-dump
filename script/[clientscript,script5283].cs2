// 5283
[clientscript,script5283]
if (if_getx(mah5_collarpuzzle:collar_bobside) < 455) {
    sound_vorbis_rate(mah5_bobs_collar_3, 1, 0, 200, random_sound_pitch(20, 20));
    if_setposition(calc(if_getx(mah5_collarpuzzle:collar_bobside) + 10), if_gety(mah5_collarpuzzle:collar_bobside), ^setpos_abs_left, ^setpos_abs_top, mah5_collarpuzzle:collar_bobside);
    if_setposition(calc(if_getx(mah5_collarpuzzle:collar_diraksside) + 10), if_gety(mah5_collarpuzzle:collar_diraksside), ^setpos_abs_left, ^setpos_abs_top, mah5_collarpuzzle:collar_diraksside);
}
