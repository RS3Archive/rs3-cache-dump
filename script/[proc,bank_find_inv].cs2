// 14343
[proc,bank_find_inv](inv $inv0, obj $obj1, int $int2)(int)
def_int $int3 = inv_size($inv0);
def_component $component4 = ~bank_get_inv_component($inv0);
while ($int2 < $int3) {
    if (cc_find($component4, $int2) = true & cc_getinvobject = $obj1) {
        return($int2);
    }
    $int2 = calc($int2 + 1);
}
return(-1);
