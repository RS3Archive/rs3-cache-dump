            case combatv2_ability_necromancy_conjure_phantom_guardian :
                $string0 = "<$string0><sprite=34175><nbsp>";
        }
        $string0 = "<$string0><col=ffffff><struct_param($struct6, combatv2_ability_name)></col>";
        if (~script18287($struct6) = true) {
            $string0 = "<$string0> (active)";
        } else if (~script17694($struct6) > clientclock) {
            $string0 = "<$string0> (unavailable)";
        }
    }
}
return($string0);
