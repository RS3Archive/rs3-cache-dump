// 20310
[proc,script20310](component $component0, int $int1, int $int2)(boolean)
if ($component0 = league_parent_tasks:task_panel | %league_task_child_filter_depth >= 8 | %league_task_child_filter_depth = -1) {
    return(false);
}
if ($int1 = $int2) {
    return(true);
}
if (calc($int1 - $int2) <= 2) {
    return(true);
}
if ($int2 <= 0 & %league_task_child_filter_depth <= 1) {
    return(true);
}
return(false);
