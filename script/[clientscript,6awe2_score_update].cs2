// 9500
[clientscript,6awe2_score_update]
if_settext(tostring_localised(%6awe2_armadyl_score, true), 6awe2_hud:armadyl_score);
if_settext(tostring_localised(%6awe2_bandos_score, true), 6awe2_hud:bandos_score);
if_settext(tostring_localised(%6awe2_lifetime_contribution_currency, true), 6awe2_hud:player_score);
def_int $int0 = 0;
def_int $int1 = 0;
$int0, $int1 = ~6awe2_get_winner;
def_string $string0 = "Armadyl leads by ";
if ($int0 = 4) {
    $string0 = "Bandos leads by ";
} else if ($int0 = 0) {
    $string0 = "";
}
def_string $string1 = "<$string0><tostring_localised($int1, true)>";
def_int $int2 = stringwidth($string1, if_getfontmetrics(6awe2_hud:difference_score));
if_setsize(calc($int2 + 30), if_getheight(6awe2_hud:difference_score), ^setsize_abs, ^setsize_abs, 6awe2_hud:difference_score);
if_settext($string1, 6awe2_hud:difference_score);
if ($int0 = 3) {
    if_setcolour(0xdcdbd6, 6awe2_hud:difference_score);
} else if ($int0 = 4) {
    if_setcolour(0xd66e1f, 6awe2_hud:difference_score);
} else {
    if_setcolour(^white, 6awe2_hud:difference_score);
}
def_int $int3 = calc(%6awe2_armadyl_score + %6awe2_bandos_score);
if ($int3 = 0) {
    return;
}
def_int $int4 = scale(%6awe2_armadyl_score, $int3, 100);
def_int $int5 = scale($int4, 100, 352);
if_setsize($int5, 32, ^setsize_abs, ^setsize_abs, 6awe2_hud:armadyl_fill);
if_setsize($int5, 32, ^setsize_abs, ^setsize_abs, 6awe2_hud:armadyl_dark);
if_setsize($int5, 32, ^setsize_abs, ^setsize_abs, 6awe2_hud:armadyl_glow);
def_int $int6 = calc(352 - $int5);
if_setsize($int6, 32, ^setsize_abs, ^setsize_abs, 6awe2_hud:bandos_fill);
if_setsize($int6, 32, ^setsize_abs, ^setsize_abs, 6awe2_hud:bandos_dark);
if_setsize($int6, 32, ^setsize_abs, ^setsize_abs, 6awe2_hud:bandos_glow);
