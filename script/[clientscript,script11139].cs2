// 11139
[clientscript,script11139](component $component0, component $component1, component $component2)
cc_deleteall($component0);
cc_deleteall($component1);
if ($component2 ! null) {
    cc_deleteall($component2);
}
if_setsize(0, 0, ^setsize_minus, ^setsize_minus, $component0);
if_setposition(0, 0, ^setpos_abs_left, ^setpos_abs_top, $component0);
def_int $int3 = 0;
while ($int3 < 6) {
    cc_create($component0, ^iftype_rectangle, if_getnextsubid($component0));
    cc_setposition(0, calc($int3 * 30 + 50), ^setpos_abs_left, ^setpos_abs_top);
    cc_setsize(0, 30, ^setsize_minus, ^setsize_abs);
    cc_setfill(true);
    if (calc($int3 % 2) = 0) {
        ~script10010(rs3_rect_light);
    } else {
        ~script10010(rs3_rect_dark);
    }
    $int3 = calc($int3 + 1);
}
$int3 = 0;
while ($int3 < 6) {
    cc_create($component0, ^iftype_text, if_getnextsubid($component0));
    cc_setposition(10, calc($int3 * 30 + 50), ^setpos_abs_left, ^setpos_abs_top);
    cc_setsize(100, 30, ^setsize_abs, ^setsize_abs);
