// 19852
[proc,script19852](achievement $achievement0)(int)
switch_achievement ($achievement0) {
    case combat_mastery_easy :
        return(%combat_mastery_global_easy_completion_count_client);
    case combat_mastery_medium :
        return(%combat_mastery_global_medium_completion_count_client);
    case combat_mastery_hard :
        return(%combat_mastery_global_hard_completion_count_client);
    case combat_mastery_elite :
        return(%combat_mastery_global_elite_completion_count_client);
    case combat_mastery_master :
        return(%combat_mastery_global_master_completion_count_client);
    case combat_mastery_grandmaster :
        return(%combat_mastery_global_grandmaster_completion_count_client);
}
return(0);
