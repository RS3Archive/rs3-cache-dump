// 9914
[proc,script9914](int $int0, int $int1, int $int2)
switch_int ($int0) {
    case 0 :
        %toplevel_v2_chat1_game = $int1;
        %toplevel_v2_chat1_game_spam = $int2;
    case 1 :
        %toplevel_v2_chat1_local = $int1;
        %toplevel_v2_chat1_local_friendsonly = $int2;
        if (%chat_v2_hide_public = 1) {
            chat_setfilter(^chatfilter_hide, chat_getfilter_private, chat_getfilter_trade);
        } else if ($int1 = 0) {
            chat_setfilter(^chatfilter_off, chat_getfilter_private, chat_getfilter_trade);
        } else if ($int2 = 0) {
            chat_setfilter(^chatfilter_on, chat_getfilter_private, chat_getfilter_trade);
        } else {
            chat_setfilter(^chatfilter_friends, chat_getfilter_private, chat_getfilter_trade);
        }
    case 2 :
        %toplevel_v2_chat1_private = $int1;
        %toplevel_v2_chat1_private_friendsonly = $int2;
        chat_setfilter(chat_getfilter_public, $int2, chat_getfilter_trade);
    case 3 :
        %toplevel_v2_chat1_friends = $int1;
        %toplevel_v2_chat1_friends_friendsonly = $int2;
    case 4 :
        %toplevel_v2_chat1_clan = $int1;
        %toplevel_v2_chat1_clan_friendsonly = $int2;
    case 5 :
        %toplevel_v2_chat1_otherclan = $int1;
        %toplevel_v2_chat1_clan_friendsonly = $int2;
    case 6 :
        %toplevel_v2_chat1_requests = $int1;
        %toplevel_v2_chat1_requests_friendsonly = $int2;
    case 15 :
        %toplevel_v2_chat1_group = $int1;
        %toplevel_v2_chat1_group_teamonly = $int2;
        %message_group_send_to_team = $int2;
    case 16 :
        %toplevel_v2_chat1_group_ironman = $int1;
        %toplevel_v2_chat1_group_ironman_filter = $int2;
}
