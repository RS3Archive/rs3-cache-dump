// 5106
[proc,script5106]
if_sethide(true, clan_signpost:clan_selected_layer1);
if_sethide(true, clan_signpost:clan_selected_layer2);
if_sethide(true, clan_signpost:clan_selected_layer3);
if_sethide(true, clan_signpost:clan_selected_layer4);
