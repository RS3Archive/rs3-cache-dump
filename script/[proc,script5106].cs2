    case 6 :
        if_sethide(false, clan_signpost:clan_selected_layer6);
        ~script5107(%clan_rel_6_varp);
    case 7 :
        if_sethide(false, clan_signpost:clan_selected_layer7);
        ~script5107(%clan_rel_7_varp);
    case 8 :
        if_sethide(false, clan_signpost:clan_selected_layer8);
        ~script5107(%clan_rel_8_varp);
    case 9 :
        if_sethide(false, clan_signpost:clan_selected_layer9);
        ~script5107(%clan_rel_9_varp);
}
