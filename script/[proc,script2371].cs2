// 2371
[proc,script2371](int $int0)
def_int $int1 = calc(100 + random(25));
def_int $int2 = if_getwidth(wheel_of_fortune:advert_0);
def_int $int3 = calc(clientclock + 800);
sound_vorbis_rate(tli_click_01, 1, 0, $int1, random_sound_pitch(15, 15));
if_setontimer(null, wheel_of_fortune:advert_layer);
if_setontimer("script1549($int3)", wheel_of_fortune:advert_button_container);
if_setgraphic(rs3_btn_radio_small_off, wheel_of_fortune:show_advert_0);
if_setgraphic(rs3_btn_radio_small_off, wheel_of_fortune:show_advert_1);
if_setgraphic(rs3_btn_radio_small_off, wheel_of_fortune:show_advert_2);
switch_int ($int0) {
    case 0 :
        if_setposition(0, 0, ^setpos_abs_left, ^setpos_abs_top, wheel_of_fortune:advert_2);
        if_setposition($int2, 0, ^setpos_abs_left, ^setpos_abs_top, wheel_of_fortune:advert_0);
        if_setposition(calc($int2 * 2), 0, ^setpos_abs_left, ^setpos_abs_top, wheel_of_fortune:advert_1);
        if_setgraphic(rs3_btn_radio_small_on, wheel_of_fortune:show_advert_0);
    case 1 :
        if_setposition(0, 0, ^setpos_abs_left, ^setpos_abs_top, wheel_of_fortune:advert_0);
        if_setposition($int2, 0, ^setpos_abs_left, ^setpos_abs_top, wheel_of_fortune:advert_1);
        if_setposition(calc($int2 * 2), 0, ^setpos_abs_left, ^setpos_abs_top, wheel_of_fortune:advert_2);
        if_setgraphic(rs3_btn_radio_small_on, wheel_of_fortune:show_advert_1);
    case 2 :
        if_setposition(0, 0, ^setpos_abs_left, ^setpos_abs_top, wheel_of_fortune:advert_1);
        if_setposition($int2, 0, ^setpos_abs_left, ^setpos_abs_top, wheel_of_fortune:advert_2);
        if_setposition(calc($int2 * 2), 0, ^setpos_abs_left, ^setpos_abs_top, wheel_of_fortune:advert_0);
        if_setgraphic(rs3_btn_radio_small_on, wheel_of_fortune:show_advert_2);
}
