// 6242
[clientscript,script6242]
def_int $int0 = if_gettrans(qbd2_energybar:red_middle);
if ($int0 >= 243) {
    if_sethide(true, qbd2_energybar:layer_bar_red);
    if_setontimer(null, qbd2_energybar:layer_bar_green);
} else {
    if_settrans(calc($int0 + 11), qbd2_energybar:red_left);
    if_settrans(calc($int0 + 11), qbd2_energybar:red_middle);
    if_settrans(calc($int0 + 11), qbd2_energybar:red_right);
}
