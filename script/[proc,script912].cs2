// 912
[proc,script912](obj $obj0)(string)
def_string $string0 = enum(obj, string, obj_objstring_requires_object, $obj0);
if (compare($string0, "") ! 0) {
    return("<br><$string0>");
}
switch_int (%objreq_obj_category) {
    case 0 :
        if (oc_param($obj0, rand_item) ! 1) {
            return("<br><enum(int, string, obj_intstring_requires_arrows, oc_param($obj0, levelrequire))>");
        }
    case 1 :
        return("<br><enum(int, string, obj_intstring_requires_bolts, oc_param($obj0, levelrequire))>");
    case 2, 5 :
        return("<br><enum(int, string, obj_intstring_requires_bow, oc_param($obj0, levelrequire))>");
    case 3 :
        return("<br><enum(int, string, obj_intstring_requires_xbow, oc_param($obj0, levelrequire))>");
    case 4 :
        return("<br>Requires an ogre composite bow.");
}
return("");
