// 10146
[clientscript,script10146](int $int0)
def_int $int1 = -1;
def_string $string0 = "";
def_string $string1 = "";
def_int $int2 = 0;
def_int $int3 = 0;
def_int $int4 = -1;
def_int $int5 = -1;
def_int $int6 = -1;
def_int $int7 = -1;
def_int $int8 = -1;
$int1, $string0, $string1 = ttv_webcam_getdevice_byuniquename(%twitch_webcam_idname);
if ($int1 = -1) {
    ~script10145;
    sound_vorbis_volume(omge_error, 1, 0, 150);
