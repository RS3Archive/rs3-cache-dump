// 3663
[clientscript,runepass_open_shop]
def_dbrow $dbrow0 = ~runepass_get_current;
if (~runepass_get_state($dbrow0) = 1) {
    ~runepass_sound_open;
    if_triggerop(runepass:close_listener, -1, 1);
    if_sethide(false, runepass:shop);
    if_setonop("runepass_close_shop", runepass:back);
} else {
    ~script3686("The event is no longer active.");
}
