// 3663
[clientscript,runepass_open_shop]
def_dbrow $dbrow0 = ~runepass_get_current;
if (~runepass_get_state($dbrow0) = 1) {
    ~runepass_sound_open;
    if_triggerop(interface_634:com_6, -1, 1);
    if_sethide(false, interface_634:com_204);
    if_setonop("runepass_close_shop", interface_634:com_243);
} else {
    ~script3686("The event is no longer active.");
}
