// 744
[clientscript,script744](int $int0)
def_int $int1 = calc(date_minutes % 60);
if ($int1 <= 20) {
    if_setposition(0, 35, ^setpos_abs_centre, ^setpos_abs_top, interface_17:com_7);
    if_setposition(0, 35, ^setpos_abs_centre, ^setpos_abs_top, interface_1630:com_46);
    if_setontimer(null, interface_17:com_9);
    if_sendtoback(interface_17:com_7);
    if_sendtoback(interface_1630:com_46);
    if_sethide(true, interface_17:com_7);
} else {
    $int1 = max(0, calc(60 - $int1 - 1));
    $int0 = calc(60 - $int0);
    if_setposition(0, 60, ^setpos_abs_centre, ^setpos_abs_top, interface_17:com_7);
    if_setposition(0, 60, ^setpos_abs_centre, ^setpos_abs_top, interface_1630:com_46);
    if_setontimer("script745($int1, $int0, 1)", interface_17:com_9);
    if_setontimer("script745($int1, $int0, 0)", interface_1630:com_205);
    if_sendtofront(interface_17:com_7);
    if_sendtofront(interface_1630:com_46);
    if_sethide(false, interface_17:com_7);
}
