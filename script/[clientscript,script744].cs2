// 744
[clientscript,script744](int $int0)
def_int $int1 = calc(date_minutes % 60);
if ($int1 <= 20) {
    if_setposition(0, 35, ^setpos_abs_centre, ^setpos_abs_top, tuska_hub_overlay:time_panel);
    if_setposition(0, 35, ^setpos_abs_centre, ^setpos_abs_top, tuska_world_event_info:time_panel);
    if_setontimer(null, tuska_hub_overlay:time_text);
    if_sendtoback(tuska_hub_overlay:time_panel);
    if_sendtoback(tuska_world_event_info:time_panel);
    if_sethide(true, tuska_hub_overlay:time_panel);
} else {
    $int1 = max(0, calc(60 - $int1 - 1));
    $int0 = calc(60 - $int0);
    if_setposition(0, 60, ^setpos_abs_centre, ^setpos_abs_top, tuska_hub_overlay:time_panel);
    if_setposition(0, 60, ^setpos_abs_centre, ^setpos_abs_top, tuska_world_event_info:time_panel);
    if_setontimer("script745($int1, $int0, 1)", tuska_hub_overlay:time_text);
    if_setontimer("script745($int1, $int0, 0)", tuska_world_event_info:time_text);
    if_sendtofront(tuska_hub_overlay:time_panel);
    if_sendtofront(tuska_world_event_info:time_panel);
    if_sethide(false, tuska_hub_overlay:time_panel);
}
