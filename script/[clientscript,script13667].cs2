// 13667
[clientscript,script13667](component $component0, int $int1)
if (%invent_machine_id = 0) {
    return;
}
db_find(invent_machine_table:col0, %invent_machine_id);
def_dbrow $dbrow2 = db_findnext;
def_obj $obj3 = null;
def_int $int4 = 0;
if (db_getfieldcount($dbrow2, invent_machine_table:col19) > $int1) {
    $obj3, $int4 = db_getfield($dbrow2, invent_machine_table:col19, $int1);
    if ($int1 = 0 & %invent_machine_secondary_1 >= calc(%invent_machine_amount_stored * $int4)) {
        if_setcolour(^green, $component0);
    } else if ($int1 = 1 & %invent_machine_secondary_2 >= calc(%invent_machine_amount_stored * $int4)) {
        if_setcolour(^green, $component0);
    } else {
        if_setcolour(^red, $component0);
    }
}
