// 5600
[clientscript,script5600](component $component0, int $int1, int $int2, int $int3)
if ($int1 < 3) {
    cam_movealong(0, $int1, $int2, $int3, 1, $int1);
}
if ($int1 = 3) {
    if_setoncamfinished(null, $component0);
} else {
    $int1 = calc($int1 + 1);
    if_setoncamfinished("script5600(event_com, $int1, 800, 800)", $component0);
}
