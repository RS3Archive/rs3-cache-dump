// 14250
[clientscript,boardgames_options_time_op](int $int0)
switch_int ($int0) {
    case 49545228, 49545229 :
        %boardgames_timepermove = 0;
    case 49545226, 49545227 :
        %boardgames_timepermove = 1;
    case 49545222, 49545225 :
        %boardgames_timepermove = 2;
    case 49545223, 49545224 :
        %boardgames_timepermove = 3;
}
~boardgames_options_time;
