// 14250
[clientscript,boardgames_options_time_op](component $component0)
switch_component ($component0) {
    case boardgames_options:15seconds1, boardgames_options:15seconds2 :
        %boardgames_timepermove = 0;
    case boardgames_options:30seconds1, boardgames_options:30seconds2 :
        %boardgames_timepermove = 1;
    case boardgames_options:1minute1, boardgames_options:1minute2 :
        %boardgames_timepermove = 2;
    case boardgames_options:2minutes1, boardgames_options:2minutes2 :
        %boardgames_timepermove = 3;
}
~boardgames_options_time;
