// 15382
[proc,script15382](component $component0, string $string0, string $string1)
cc_create($component0, ^iftype_text, if_getnextsubid($component0));
cc_setsize(60, 0, ^setsize_minus, ^setsize_minus);
cc_setposition(50, 0, ^setpos_abs_left, ^setpos_abs_top);
cc_settext(~mobile_text($string0, $string1));
cc_setcolour(~script10495(2));
cc_settextfont(museo_sans_13pt_regular);
cc_settextalign(^settextalign_left, ^settextalign_centre, 17);
cc_settextshadow(true);
cc_setnoclickthrough(false);
