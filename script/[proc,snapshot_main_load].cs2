// 7675
[proc,snapshot_main_load]
%snapshot_mute = false;
~static_checkbox_create(snapshot_main_v2:name_list_mute_checkbox_build, snapshot_main_v2:name_list_mute_checkbox_click, "", "", "", ~bool_to_int(%snapshot_mute));
~static_checkbox_create(snapshot_main_v2:offence_mute_checkbox_build, snapshot_main_v2:offence_mute_checkbox_click, "", "", "", ~bool_to_int(%snapshot_mute));
if (playermodlevel = 5 | playermodlevel = 6) {
    if_settext("Suggest to temporarily mute this player", snapshot_main_v2:mutetoggle);
    if_settext("Suggest to temporarily mute this player", snapshot_main_v2:mutetoggle_offence);
} else {
    if_settext("Temporarily mute this player", snapshot_main_v2:mutetoggle);
    if_settext("Temporarily mute this player", snapshot_main_v2:mutetoggle_offence);
}
%snapshot_open = true;
if_setonvarcstrtransmit("snapshot_name_update{snapshot_name}", snapshot_main_v2:control_layer);
%snapshot_last_selected_highlight = -1;
~script224;
~script216;
