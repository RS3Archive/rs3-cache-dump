// 7409
[clientscript,mtx_pet_highlight_item]
if (cc_find(pet_bank:pets_bank_area, %mtx_pet_bank_option) = true) {
    if_setposition(calc(if_getx(pet_bank:pets_bank_area) + cc_getx), calc(cc_gety + if_gety(pet_bank:pets_bank_area) - 2), ^setpos_abs_left, ^setpos_abs_top, pet_bank:select_reticule);
    if_sethide(false, pet_bank:select_reticule);
}
