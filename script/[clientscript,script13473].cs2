// 13473
[clientscript,script13473]
if_settext("<tostring(min(%tomb_temp_tombs_collected, %tomb_temp_tombs_required))> / <tostring(%tomb_temp_tombs_required)>", tomb_overlay:sarcophagus_text);
if_settext("<tostring(min(%tomb_chests_looted, %tomb_chests_required))> / <tostring(%tomb_chests_required)>", tomb_overlay:chest_text);
if_settext("<tostring(min(%tomb_corruption_cleansed, %tomb_corruption_required))> / <tostring(%tomb_corruption_required)>", tomb_overlay:corruption_bar_text);
if (%tomb_corruption_required > 0) {
    if_setsize(scale(%tomb_corruption_cleansed, %tomb_corruption_required, 90), 14, ^setsize_abs, ^setsize_abs, tomb_overlay:progress_bar);
} else {
    if_setsize(0, 14, ^setsize_abs, ^setsize_abs, tomb_overlay:progress_bar);
}
if_settext("<tostring(%tomb_level_band)> / 3", tomb_overlay:tier_text);
if (%tomb_imperial_greater_enabled = 1) {
    if_settrans(0, tomb_overlay:dungeoneering_icon);
} else {
    if_settrans(200, tomb_overlay:dungeoneering_icon);
}
if (%tomb_imperial_lesser_enabled = 1) {
    if_settrans(0, tomb_overlay:divination_icon);
} else {
    if_settrans(200, tomb_overlay:divination_icon);
}
if (%tomb_port_greater_enabled = 1) {
    if_settrans(0, tomb_overlay:construction_icon);
} else {
    if_settrans(200, tomb_overlay:construction_icon);
}
if (%tomb_port_lesser_enabled = 1) {
    if_settrans(0, tomb_overlay:crafting_icon);
} else {
    if_settrans(200, tomb_overlay:crafting_icon);
}
if (%tomb_worker_greater_enabled = 1) {
    if_settrans(0, tomb_overlay:agility_icon);
} else {
    if_settrans(200, tomb_overlay:agility_icon);
}
if (%tomb_worker_lesser_enabled = 1) {
    if_settrans(0, tomb_overlay:prayer_icon);
} else {
    if_settrans(200, tomb_overlay:prayer_icon);
}
if (%tomb_merchant_greater_enabled = 1) {
    if_settrans(0, tomb_overlay:thieving_icon);
} else {
    if_settrans(200, tomb_overlay:thieving_icon);
}
if (%tomb_merchant_lesser_enabled = 1) {
    if_settrans(0, tomb_overlay:runecrafting_icon);
} else {
    if_settrans(200, tomb_overlay:runecrafting_icon);
}
