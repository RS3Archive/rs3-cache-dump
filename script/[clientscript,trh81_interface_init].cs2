// 12209
[clientscript,trh81_interface_init]
if (%trh81_easy_one_complete = 1) {
    if_sethide(false, trh81_zodiac:easy_task_1_stamped);
}
if (%trh81_easy_two_complete = 1) {
    if_sethide(false, trh81_zodiac:easy_task_2_stamped);
}
if (%trh81_easy_three_complete = 1) {
    if_sethide(false, trh81_zodiac:easy_task_3_stamped);
}
if (%trh81_easy_four_complete = 1) {
    if_sethide(false, trh81_zodiac:easy_task_4_stamped);
}
if (%trh81_medium_one_complete = 1) {
    if_sethide(false, trh81_zodiac:medium_task_1_stamped);
}
if (%trh81_medium_two_complete = 1) {
    if_sethide(false, trh81_zodiac:medium_task_2_stamped);
}
if (%trh81_medium_three_complete = 1) {
    if_sethide(false, trh81_zodiac:medium_task_3_stamped);
}
if (%trh81_medium_four_complete = 1) {
    if_sethide(false, trh81_zodiac:medium_task_4_stamped);
}
if (%trh81_hard_one_complete = 1) {
    if_sethide(false, trh81_zodiac:hard_task_1_stamped);
}
if (%trh81_hard_two_complete = 1) {
    if_sethide(false, trh81_zodiac:hard_task_2_stamped);
}
if (%trh81_hard_three_complete = 1) {
    if_sethide(false, trh81_zodiac:hard_task_3_stamped);
}
if (%trh81_hard_four_complete = 1) {
    if_sethide(false, trh81_zodiac:hard_task_4_stamped);
}
if (%trh81_elite_one_complete = 1) {
    if_sethide(false, trh81_zodiac:elite_task_1_stamped);
}
if (%trh81_elite_two_complete = 1) {
    if_sethide(false, trh81_zodiac:elite_task_2_stamped);
}
if (%trh81_elite_three_complete = 1) {
    if_sethide(false, trh81_zodiac:elite_task_3_stamped);
}
if (%trh81_elite_four_complete = 1) {
    if_sethide(false, trh81_zodiac:elite_task_4_stamped);
}
if (%trh81_row_one_complete = 1) {
    if_sethide(false, trh81_zodiac:line_prize_1_stamped);
}
if (%trh81_row_two_complete = 1) {
    if_sethide(false, trh81_zodiac:line_prize_2_stamped);
}
if (%trh81_row_three_complete = 1) {
    if_sethide(false, trh81_zodiac:line_prize_3_stamped);
}
if (%trh81_row_four_complete = 1) {
    if_sethide(false, trh81_zodiac:line_prize_4_stamped);
}
if (%trh81_column_one_complete = 1) {
    if_sethide(false, trh81_zodiac:column_prize_1_stamped);
}
if (%trh81_column_two_complete = 1) {
    if_sethide(false, trh81_zodiac:column_prize_2_stamped);
}
if (%trh81_column_three_complete = 1) {
    if_sethide(false, trh81_zodiac:column_prize_3_stamped);
}
if (%trh81_column_four_complete = 1) {
    if_sethide(false, trh81_zodiac:column_prize_4_stamped);
}
if (%trh81_card_complete = 1 & %trh81_prestige_level = %trh81_prestige_level_claimed & %trh81_prestige_level > 0) {
    if_sethide(false, trh81_zodiac:complete_prize_stamped);
}
if_settext(tostring(inv_total(inv, trh81_envelope)), trh81_zodiac:total_envelopes_number);
if (%trh81_prestige_level_claimed ! 0) {
    if_sethide(false, trh81_zodiac:column_one_prestige_prize);
    if_sethide(false, trh81_zodiac:column_one_prestige_charges);
    if_sethide(true, trh81_zodiac:column_one_prize);
    if_sethide(false, trh81_zodiac:column_two_prestige_prize);
    if_sethide(false, trh81_zodiac:column_two_prestige_charges);
    if_sethide(true, trh81_zodiac:column_two_prize);
    if_sethide(false, trh81_zodiac:column_three_prestige_prize);
    if_sethide(false, trh81_zodiac:column_three_prestige_charges);
    if_sethide(true, trh81_zodiac:column_three_prize);
    if_sethide(false, trh81_zodiac:column_four_prestige_prize);
    if_sethide(false, trh81_zodiac:column_four_prestige_charges);
    if_sethide(true, trh81_zodiac:column_four_prize);
}
if_settext("Prestige <tostring(%trh81_prestige_level)>/5", trh81_zodiac:prestige_level);
~trh81_prize_setup;
