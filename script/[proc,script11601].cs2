// 11601
[proc,script11601](int $int0, boolean $boolean1)(string)
if ($int0 < 0) {
    return("");
} else if ($int0 < 10000) {
    return(tostring_localised($int0, $boolean1));
} else if ($int0 < 10000000) {
    return("<tostring_localised(calc($int0 / 1000), $boolean1)>K");
} else {
    return("<tostring_localised(calc($int0 / 1000000), $boolean1)>M");
