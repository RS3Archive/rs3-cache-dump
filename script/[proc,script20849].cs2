// 20849
[proc,script20849](dbrow $dbrow0)(boolean, boolean)
def_boolean $boolean1 = db_getfield($dbrow0, marketplace_store_item:col20, 0);
def_boolean $boolean2 = false;
if ($boolean1 = true) {
    switch_dbrow ($dbrow0) {
        case marketplace_store_earned_infernal_cape, marketplace_store_earned_obsidian_zuk_cape :
            $boolean2 = ~script205;
        case marketplace_store_earned_obsidian_capes :
            $boolean2 = ~script584;
        case marketplace_store_earned_abyssal_crabbe :
            $boolean2 = ~int_to_bool(%skillpets_slayer_unlocked);
        case marketplace_store_earned_infernal_archie :
            $boolean2 = ~int_to_bool(%skillpets_archaeology_unlocked);
        case marketplace_store_earned_beekeeper_brains :
            $boolean2 = ~int_to_bool(%skillpets_farming_unlocked);
        case marketplace_store_earned_mtx164_pet_bundle :
            if (%skillpets_slayer_unlocked = 1 | %skillpets_archaeology_unlocked = 1 | %skillpets_farming_unlocked = 1) {
                $boolean2 = true;
            } else {
                $boolean2 = false;
            }
    }
}
return($boolean1, $boolean2);
