// 19191
[proc,script19191](struct $struct0, component $component1)
switch_struct ($struct0) {
    case trh182_promo :
        if_setnpcmodel(~script16765(%trh182_character_level), $component1);
    case trh203_promo :
        ~script19162($component1);
    case trh207_promo :
        ~script19873($component1);
    case default :
        ~error("Missed plugin point for promo ID <tostring(struct_param($struct0, trh_promo_id))>");
}
