// 12830
[proc,script12830](int $int0, int $int1)
if_sethide(true, elrc:dynamic_layer);
if_sethide(true, elrc:guide_layer);
if_sethide(true, elrc:home_layer);
switch_int ($int0) {
    case 2 :
        switch_int ($int1) {
            case 1 :
                if_setgraphic("elr_journal_tab_birds,0", elrc:tab_active_tab_graphic);
                if_setposition(88, 0, ^setpos_abs_left, ^setpos_abs_top, elrc:tab_active_tab);
            case 2 :
                if_setgraphic("elr_journal_tab_mushrooms,0", elrc:tab_active_tab_graphic);
                if_setposition(139, 0, ^setpos_abs_left, ^setpos_abs_top, elrc:tab_active_tab);
            case 3 :
                if_setgraphic("elr_journal_tab_berries,0", elrc:tab_active_tab_graphic);
                if_setposition(190, 0, ^setpos_abs_left, ^setpos_abs_top, elrc:tab_active_tab);
            case 4 :
                if_setgraphic("elr_journal_tab_implings,0", elrc:tab_active_tab_graphic);
                if_setposition(241, 0, ^setpos_abs_left, ^setpos_abs_top, elrc:tab_active_tab);
            case 5 :
                if_setgraphic("elr_journal_tab_castaways,0", elrc:tab_active_tab_graphic);
                if_setposition(292, 0, ^setpos_abs_left, ^setpos_abs_top, elrc:tab_active_tab);
        }
        if_sethide(false, elrc:dynamic_layer);
    case 3 :
        if_setgraphic("elr_journal_tab_miniquests,0", elrc:tab_active_tab_graphic);
        if_setposition(412, 0, ^setpos_abs_left, ^setpos_abs_top, elrc:tab_active_tab);
        if_sethide(false, elrc:dynamic_layer);
    case 5 :
        if_setgraphic("elr_journal_tab_overview,0", elrc:tab_active_tab_graphic);
        if_setposition(37, 0, ^setpos_abs_left, ^setpos_abs_top, elrc:tab_active_tab);
        if_sethide(false, elrc:home_layer);
    case 6 :
        if_setgraphic("elr_journal_tab_info,0", elrc:tab_active_tab_graphic);
        if_setposition(667, 0, ^setpos_abs_left, ^setpos_abs_top, elrc:tab_active_tab);
        if_sethide(false, elrc:guide_layer);
}
