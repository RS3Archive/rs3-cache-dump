// 1205
[clientscript,script1205](component $component0, component $component1, component $component2)
if (if_find($component0) = true) {
    cc_setparam(rs3tli_component_rotation_type, 1);
    cc_setparam(rs3tli_component_sound_id, -1);
}
if (if_find($component1) = true) {
    cc_setparam(rs3tli_component_rotation_type, 1);
}
if (if_find($component2) = true) {
    cc_setparam(rs3tli_component_rotation_type, 1);
}
