// 19106
[proc,script19106]
switch_int (map_lang) {
    case 0 :
        if_setgraphic(trh199_title_en, trh199_overlay:title);
    case 1 :
        if_setgraphic(trh199_title_de, trh199_overlay:title);
    case 2 :
        if_setgraphic(trh199_title_fr, trh199_overlay:title);
    case 3 :
        if_setgraphic(trh199_title_pt, trh199_overlay:title);
}
if_setnpcmodel(trh199_tier_1_npc, trh199_overlay:npc_outfit_1);
if_setnpcmodel(trh199_tier_2_npc, trh199_overlay:npc_outfit_2);
if_setnpcmodel(trh199_tier_3_npc, trh199_overlay:npc_outfit_3);
if_setmodelanim(combat_2012_casual_unarmed_idle, trh199_overlay:npc_outfit_1);
if_setmodelanim(combat_2012_casual_unarmed_idle, trh199_overlay:npc_outfit_2);
if_setmodelanim(combat_2012_casual_unarmed_idle, trh199_overlay:npc_outfit_3);
~script19104(1);
