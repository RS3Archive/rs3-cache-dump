// 20336
[proc,script20336](int $int0, int $int1)
if (%league_lobby_select_league_worlds = 1) {
    switch_int ($int0) {
        case 1 :
            %league_worldselect_1stfavourite = $int1;
        case 2 :
            %league_worldselect_2ndfavourite = $int1;
        case 3 :
            %league_worldselect_3rdfavourite = $int1;
        case default :
            return;
    }
} else {
    switch_int ($int0) {
        case 1 :
            %worldselect_1stfavourite = $int1;
        case 2 :
            %worldselect_2ndfavourite = $int1;
        case 3 :
            %worldselect_3rdfavourite = $int1;
        case default :
            return;
    }
}
