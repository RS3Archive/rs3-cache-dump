// 9630
[clientscript,script9630](component $component0, int $int1)
def_int $int2 = $int1;
def_int $int3 = 0;
def_int $int4 = -1;
if (cc_find($component0, $int1) = true) {
    if (cc_param(worldmap_category_empty) = 1) {
        return;
    }
    if (cc_getgraphic = "rs3_btn_checkbox_small,2") {
        $int4 = 0;
        cc_setgraphic("rs3_btn_checkbox_small,0");
    } else {
        $int4 = 1;
        cc_setgraphic("rs3_btn_checkbox_small,2");
    }
    while ($int3 = 0) {
        $int2 = calc($int2 + 5);
        if (cc_find($component0, $int2) = true) {
            if (cc_param(worldmap_category_type) ! -1) {
                if (cc_param(worldmap_category_type) = 0) {
                    $int3 = 1;
                } else if (cc_param(worldmap_category_type) = 1 & cc_param(worldmap_category_empty) ! 1) {
                    if ($int4 = 0) {
                        cc_setgraphic("rs3_btn_checkbox_small,0");
                    } else {
                        cc_setgraphic("rs3_btn_checkbox_small,2");
                    }
                }
            } else {
                ~script9628($component0, $int2, $int4);
            }
        } else {
            $int3 = 1;
        }
    }
}
