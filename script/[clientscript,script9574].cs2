// 9574
[clientscript,script9574]
def_int $int0 = 0;
def_int $int1 = 0;
$int0, $int1 = ~script4187;
def_string $string0 = "";
if ($int0 = 0) {
    $string0 = "<tostring($int1)>m";
} else {
    $string0 = "<tostring($int0)>h";
}
def_int $int2 = ~script9575;
if_setgraphic(enum(int, graphic, pop_voyage_reward_icons, %pop_trader_selling), pop_trader:trader_goods_icon);
if_settext("<tostring(%pop_trader_quantity)> <enum(int, string, pop_voyage_rewards, %pop_trader_selling)>", pop_trader:trader_goods_text);
if_settext("Available at <tostring($int2)> <enum(int, string, pop_voyage_rewards, %pop_trader_wanted)> each", pop_trader:trader_price);
if_settext("Buy 1 for <tostring($int2)>", pop_trader:buy_title_1);
if_settext("Buy 5 for <tostring(calc($int2 * 5))>", pop_trader:buy_title_2);
if_settext("Buy 10 for <tostring(calc($int2 * 10))>", pop_trader:buy_title_3);
if_settext("Buy <tostring(%pop_trader_quantity)> for <tostring(calc($int2 * %pop_trader_quantity))>", pop_trader:buy_title_5);
if (%pop_trader_quantity < 1) {
    if_sethide(true, pop_trader:buy_1);
    if_sethide(true, pop_trader:buy_title_1);
    if_sethide(true, pop_trader:buy_2);
    if_sethide(true, pop_trader:buy_title_2);
    if_sethide(true, pop_trader:buy_3);
    if_sethide(true, pop_trader:buy_title_3);
    if_sethide(true, pop_trader:buy_5);
    if_sethide(true, pop_trader:buy_title_5);
    if_settext("New stock available in <$string0>.", pop_trader:buy_none_left);
    if_sethide(false, pop_trader:buy_none_left);
} else if (%pop_trader_quantity = 1) {
    if_sethide(true, pop_trader:buy_2);
    if_sethide(true, pop_trader:buy_title_2);
    if_sethide(true, pop_trader:buy_3);
    if_sethide(true, pop_trader:buy_title_3);
    if_sethide(true, pop_trader:buy_5);
    if_sethide(true, pop_trader:buy_title_5);
} else if (%pop_trader_quantity < 5) {
    if_sethide(true, pop_trader:buy_2);
    if_sethide(true, pop_trader:buy_title_2);
    if_sethide(true, pop_trader:buy_3);
    if_sethide(true, pop_trader:buy_title_3);
} else if (%pop_trader_quantity = 5) {
    if_sethide(true, pop_trader:buy_3);
    if_sethide(true, pop_trader:buy_title_3);
    if_sethide(true, pop_trader:buy_5);
    if_sethide(true, pop_trader:buy_title_5);
} else if (%pop_trader_quantity < 10) {
    if_sethide(true, pop_trader:buy_3);
    if_sethide(true, pop_trader:buy_title_3);
} else if (%pop_trader_quantity = 10) {
    if_sethide(true, pop_trader:buy_5);
    if_sethide(true, pop_trader:buy_title_5);
}
def_int $int3 = 0;
switch_int (%pop_trader_wanted) {
    case 2 :
        $int3 = %pop_port_resource_2;
    case 3 :
        $int3 = %pop_port_resource_3;
    case 4 :
        $int3 = %pop_port_resource_4;
    case 5 :
        $int3 = %pop_port_resource_5;
    case 6 :
        $int3 = %pop_port_resource_6;
    case 7 :
        $int3 = %pop_port_resource_7;
    case 8 :
        $int3 = %pop_port_resource_8;
    case 9 :
        $int3 = %pop_port_resource_9;
}
if ($int3 >= $int2) {
    if_settext("(You currently own <tostring($int3)>)", pop_trader:trader_current);
} else {
    if_settext("<col=FF0000>You do not have enough resources!", pop_trader:trader_current);
}
