// 15290
[proc,script15290]()(int)
switch_int (~trh171_get_modifier(%trh171_active_slot)) {
    case 11 :
        return(min(calc(%trh171_current_prize_rarity + 1), 5));
    case 12 :
        return(min(calc(%trh171_current_prize_rarity + 2), 5));
    case default :
        return(%trh171_current_prize_rarity);
}
