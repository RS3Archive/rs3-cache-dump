// 7706
[clientscript,script7706](component $component0, int $int1, int $int2)
if ($int1 = 1) {
    if_setcolour(0x96ff96, $component0);
} else if ($int1 = 2) {
    if_setcolour(^white, $component0);
} else {
    if_setposition(calc(if_getx($component0) - 2), calc(if_gety($component0) - 2), ^setpos_abs_left, ^setpos_abs_top, mm_tasklist:selected_task);
}
