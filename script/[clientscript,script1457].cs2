// 1457
[clientscript,script1457](component $component0, int $int1)
def_int $int2 = calc(($int1 - clientclock) / 50);
if ($int2 < 0) {
    if_setontimer(null, $component0);
    return;
}
def_int $int3 = calc($int2 / 60);
def_int $int4 = calc($int2 % 60);
if ($int3 > 0) {
    if_settext("Time remaining: <tostring($int3)>m <tostring($int4)>", $component0);
} else {
    if_settext("Time remaining: <tostring($int2)>", $component0);
}
