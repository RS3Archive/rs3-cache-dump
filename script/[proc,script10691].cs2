// 10691
[proc,script10691](int $int0)
def_int $int1 = 0;
def_string $string0 = "";
def_component $component2 = null;
switch_int ($int0) {
    case 101253120 :
        $int1 = %divdnd_charges_double;
        $string0 = "Activate double points.";
        $component2 = divdnd_overlay:memories1_text;
    case 101253122 :
        $int1 = %divdnd_charges_immunity;
        $string0 = "Activate immunity.";
        $component2 = divdnd_overlay:memories2_text;
    case 101253124 :
        $int1 = %divdnd_charges_enemy_points;
        $string0 = "Activate double points.";
        $component2 = divdnd_overlay:robots1_text;
    case 101253127 :
        $int1 = %divdnd_charges_enemy_aoe;
        $string0 = "Subdue all automatons.";
        $component2 = divdnd_overlay:robots2_text;
}
if ($component2 = null) {
    return;
}
if ($int1 = 0) {
    $string0 = append($string0, "<br>0 charges.");
    ~script10692($int0, true);
} else {
    ~script10692($int0, false);
    if ($int1 = 1) {
        $string0 = append($string0, "<br>1 charge.");
    } else {
        $string0 = append($string0, "<br><tostring($int1)> charges.");
    }
}
if_settext($string0, $component2);
