// 3174
[proc,script3174](component $component0, int $int1, string $string0, int $int2, string $string1, string $string2, int $chattype3, int $int4, boolean $boolean5)(int, int)
def_int $int6 = if_getwidth($component0);
def_int $int7 = calc(max(paraheight($string0, $int6, museo_sans_11pt_regular), 1) * 15);
cc_create($component0, ^iftype_text, $int1);
cc_setposition(0, calc($int1 * 15), ^setpos_abs_left, ^setpos_abs_bottom);
cc_setsize(0, $int7, ^setsize_minus, ^setsize_abs);
cc_setcolour(^white);
cc_settextfont(museo_sans_11pt_regular);
cc_settext($string0);
cc_settextalign(^settextalign_left, ^settextalign_top, 15);
def_int $int8 = 0;
def_int $int9 = 0;
while ($int9 < $int1) {
    if (.cc_find($component0, $int9) = true) {
        $int8 = calc($int8 + .cc_getheight);
    }
    $int9 = calc($int9 + 1);
}
if ($boolean5 = false) {
    cc_setposition(0, $int8, ^setpos_abs_left, ^setpos_abs_bottom);
} else {
    cc_setposition(0, $int8, ^setpos_abs_left, ^setpos_abs_top);
}
if ($int2 = 1) {
    cc_setopbase(removetags($string1));
    cc_setonop("script3175(event_op, $string1, $string2, $int4)");
    switch_int ($chattype3) {
        case ^chattype_clanchat, ^chattype_quickchat_clanchat, ^chattype_clanguestchat, ^chattype_quickchat_clanguestchat, ^chattype_friendschat, ^chattype_quickchat_friend_chat :
            if (compare(removetags(chat_playername_unfiltered), removetags($string2)) ! 0) {
                if (friend_test(removetags($string2)) = false & ignore_test(removetags($string2)) = false) {
                    cc_setop(1, "Add friend");
                    cc_setop(2, "Add ignore");
                } else if (friend_test(removetags($string2)) = true & userdetail_quickchat = false) {
                    cc_setop(3, "Message");
                }
                if (%snapshot_right_click_enabled = 1 | staffmodlevel > 0 | %create_country = 1 | playermod > 0) {
                    cc_setop(5, "Report");
                }
                if (~script4467 = 1) {
                    cc_setop(10, "Kick/ban");
                }
            }
        case ^chattype_system_broadcast :
            cc_setop(6, "Open link");
    }
}
return(calc($int1 + 1), calc($int8 + $int7));
