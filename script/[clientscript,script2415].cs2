// 2415
[clientscript,script2415]
if_setmodel(peng_rak_panel_wrench_dark, peng_rak_engine:wrench);
if_setmodel(peng_rak_panel_wire_cutters_dark, peng_rak_engine:wirecutter);
if_setmodel(peng_rak_panel_spare_wire_dark, peng_rak_engine:sparewire);
if_setmodel(peng_rak_panel_tape_dark, peng_rak_engine:tape);
if_setmodel(peng_rak_panel_belows_dark, peng_rak_engine:bellows);
if_setmodel(peng_rak_panel_swordfish_dark, peng_rak_engine:swordfish);
if_setmodel(peng_rak_panel_crab_dark, peng_rak_engine:crab);
if_setmodel(peng_rak_panel_tooth_dark, peng_rak_engine:sharktooth);
if_setmodel(peng_rak_panel_eel_dark, peng_rak_engine:eel);
if_setmodel(peng_rak_panel_seaweed_dark, peng_rak_engine:seaweed);
if_setmodel(peng_rak_panel_puffer_dark, peng_rak_engine:blowfish);
if_setmodel(peng_rak_panel_octopuss_dark, peng_rak_engine:octopus);
if (%peng_rak_eng_tools = 1) {
    if_setmodel(peng_rak_panel_wrench, peng_rak_engine:wrench);
} else if (%peng_rak_eng_tools = 2) {
    if_setmodel(peng_rak_panel_wire_cutters, peng_rak_engine:wirecutter);
} else if (%peng_rak_eng_tools = 3) {
    if_setmodel(peng_rak_panel_spare_wire, peng_rak_engine:sparewire);
} else if (%peng_rak_eng_tools = 4) {
    if_setmodel(peng_rak_panel_tape, peng_rak_engine:tape);
} else if (%peng_rak_eng_tools = 5) {
    if_setmodel(peng_rak_panel_belows, peng_rak_engine:bellows);
} else if (%peng_rak_eng_tools = 6) {
    if_setmodel(peng_rak_panel_swordfish, peng_rak_engine:swordfish);
} else if (%peng_rak_eng_tools = 7) {
    if_setmodel(peng_rak_panel_crab, peng_rak_engine:crab);
} else if (%peng_rak_eng_tools = 8) {
    if_setmodel(peng_rak_panel_tooth, peng_rak_engine:sharktooth);
} else if (%peng_rak_eng_tools = 9) {
    if_setmodel(peng_rak_panel_eel, peng_rak_engine:eel);
} else if (%peng_rak_eng_tools = 10) {
    if_setmodel(peng_rak_panel_seaweed, peng_rak_engine:seaweed);
} else if (%peng_rak_eng_tools = 11) {
    if_setmodel(peng_rak_panel_puffer, peng_rak_engine:blowfish);
} else if (%peng_rak_eng_tools = 12) {
    if_setmodel(peng_rak_panel_octopuss, peng_rak_engine:octopus);
}
