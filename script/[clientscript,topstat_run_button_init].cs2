// 1315
[clientscript,topstat_run_button_init](component $component0)
%option_run_status_varc = %option_run;
if_setonvartransmit("topstat_run_button_vartransmit($component0){option_run}", $component0);
if_setonop("topstat_run_button_op($component0, event_op)", $component0);
~topstat_run_button_update($component0);
