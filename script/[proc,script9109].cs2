// 9109
[proc,script9109]
if (%wishing_well_player_donate_obj = coins) {
    if (%wishing_well_player_donate_count = 1) {
        if_settext("Total Donation Value: <tostring_localised(%wishing_well_player_total_count, true)> coin", donation:total_donation_of_item);
    } else {
        if_settext("Total Donation Value: <tostring_localised(%wishing_well_player_total_count, true)> coins", donation:total_donation_of_item);
    }
} else if (%wishing_well_player_donate_obj = rs_bond | %wishing_well_player_donate_obj = rs_bond_untradeable) {
    if_settext("Total Bonds Donated: <tostring_localised(%wishing_well_player_total_count, true)>", donation:total_donation_of_item);
} else if (%wishing_well_player_total_count = 1) {
    if_settext("Total Donation Value: <tostring_localised(%wishing_well_player_total_count, true)> coin", donation:total_donation_of_item);
} else {
    if_settext("Total Donation Value: <tostring_localised(%wishing_well_player_total_count, true)> coins", donation:total_donation_of_item);
}
