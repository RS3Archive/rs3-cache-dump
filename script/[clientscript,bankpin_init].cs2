// 1107
[clientscript,bankpin_init]
if (%bankpin_keyboard_enabled = 1) {
    ~script8841(110, 1);
}
if (%toplevel_v2_active_skinset ! 2) {
    if_setposition(418, 7, ^setpos_abs_left, ^setpos_abs_top, bankpin_main:digit_1);
    if_setposition(434, 7, ^setpos_abs_left, ^setpos_abs_top, bankpin_main:digit_2);
    if_setposition(450, 7, ^setpos_abs_left, ^setpos_abs_top, bankpin_main:digit_3);
    if_setposition(466, 7, ^setpos_abs_left, ^setpos_abs_top, bankpin_main:digit_4);
}
~bankpin_shuffle(1);
