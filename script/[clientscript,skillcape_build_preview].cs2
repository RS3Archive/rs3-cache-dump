// 4611
[clientscript,skillcape_build_preview]
if_setmodel(blankmodel, skillcape_customise:cape);
if_setmodel(blankmodel, skillcape_customise:model1);
if_setmodel(blankmodel, skillcape_customise:model2);
if_setmodel(blankmodel, skillcape_customise:model3);
if_setmodel(blankmodel, skillcape_customise:model4);
if_setmodel(blankmodel, skillcape_customise:cape_particles);
if_setposition(0, 0, ^setpos_abs_centre, ^setpos_abs_centre, skillcape_customise:model1);
if_setposition(0, 0, ^setpos_abs_centre, ^setpos_abs_centre, skillcape_customise:model2);
if_setposition(0, 0, ^setpos_abs_centre, ^setpos_abs_centre, skillcape_customise:model3);
if_setposition(0, 0, ^setpos_abs_centre, ^setpos_abs_centre, skillcape_customise:model4);
if_setmodelangle(0, 0, 0, 1024, 0, 440, skillcape_customise:cape);
if_setmodelangle(0, 0, 0, 1024, 0, 440, skillcape_customise:model1);
if_setmodelangle(0, 0, 0, 1024, 0, 440, skillcape_customise:model2);
if_setmodelangle(0, 0, 0, 1024, 0, 440, skillcape_customise:model3);
if_setmodelangle(0, 0, 0, 1024, 0, 440, skillcape_customise:model4);
cc_deleteall(skillcape_customise:particles_colour_buttons);
cc_deleteall(skillcape_customise:particles_colour_buttons_inactive);
switch_obj (%current_cape_customising) {
    case skillcape_max, skillcape_max_hood, skillcape_max_hooded :
        if_setmodel(cod_max_cape_male, skillcape_customise:cape);
    case comp_cape_override, skillcape_completionist, skillcape_completionist_hood, skillcape_completionist_hooded :
        if_setmodel(cod_completionist_cape_male, skillcape_customise:cape);
    case trim_comp_cape_override, skillcape_completionist_insane, skillcape_completionist_insane_hood, skillcape_completionist_insane_hooded :
        if_setmodel(cod_completionist_trim_cape_male, skillcape_customise:cape);
    case skillcape_120_all, skillcape_120_all_hood, skillcape_120_all_hooded :
        ~script11511(distinction_cape_120_all_master_max_recolours, skillcape_customise:particles_colour_buttons, skillcape_customise:particles_colour_buttons_inactive);
        if_setmodel(human_accessory_cape_max_noparticles_120, skillcape_customise:cape);
        if_setmodel(enum(int, model, distinction_cape_particle_recolour_options_models_master_max, %skillcape_colour_particles_master_max), skillcape_customise:cape_particles);
    case 120_all_comp_cape_override, 120_all_comp_cape_hooded_override, skillcape_completionist_120_all, skillcape_completionist_120_all_hood, skillcape_completionist_120_all_hooded :
        ~script11511(distinction_cape_120_all_recolours, skillcape_customise:particles_colour_buttons, skillcape_customise:particles_colour_buttons_inactive);
        if_setmodel(human_accessory_cape_completionist_noparticles_120, skillcape_customise:cape);
        if_setmodel(enum(int, model, distinction_cape_particle_recolour_options_models, %skillcape_colour_particles_master_max_comp), skillcape_customise:cape_particles);
    case 120_all_trim_comp_cape_override, 120_all_trim_comp_cape_hooded_override, skillcape_completionist_insane_120_all, skillcape_completionist_insane_120_all_hood, skillcape_completionist_insane_120_all_hooded :
        ~script11511(distinction_cape_120_all_recolours, skillcape_customise:particles_colour_buttons, skillcape_customise:particles_colour_buttons_inactive);
        if_setmodel(human_accessory_cape_completionist_trim_noparticles_120, skillcape_customise:cape);
        if_setmodel(enum(int, model, distinction_cape_particle_recolour_options_models_trim, %skillcape_colour_particles_master_max_trim), skillcape_customise:cape_particles);
    case xmas23_combined_scarf, xmas23_combined_scarf_override :
        if_setmodel(human_novelty_christmas_woolly_4colour_m_scarf_front, skillcape_customise:model1);
        if_setposition(0, 50, ^setpos_abs_centre, ^setpos_abs_centre, skillcape_customise:model1);
        if_setmodelangle(0, 0, 0, 0, 0, 400, skillcape_customise:model1);
    case xmas23_combined_hat, xmas23_combined_hat_override :
        if_setmodel(human_novelty_christmas_woolly_4colour_m_bobblehat, skillcape_customise:model1);
        if_setposition(0, 100, ^setpos_abs_centre, ^setpos_abs_centre, skillcape_customise:model1);
        if_setmodelangle(0, 0, 0, 1024, 0, 400, skillcape_customise:model1);
    case xmas23_peppermint_gloves, xmas23_peppermint_legs, xmas23_peppermint_top, xmas23_peppermint_shoes, xmas23_peppermint_feet_override, xmas23_peppermint_hands_override, xmas23_peppermint_legs_override, xmas23_peppermint_torso_override :
        if_setmodel(human_peasant_casual_preppy_hands, skillcape_customise:model1);
        if_setmodel(human_peasant_casual_preppy_feet, skillcape_customise:model2);
        switch_int (gender) {
            case 1 :
                if_setmodel(human_peasant_casual_preppy_f_torso, skillcape_customise:model3);
                if_setmodel(human_peasant_casual_preppy_f_legs, skillcape_customise:model4);
            case 0 :
                if_setmodel(human_peasant_casual_preppy_m_torso, skillcape_customise:model3);
                if_setmodel(human_peasant_casual_preppy_m_legs, skillcape_customise:model4);
        }
        if_setmodelangle(0, 0, 0, 0, 0, 440, skillcape_customise:model1);
        if_setmodelangle(0, 0, 0, 0, 0, 440, skillcape_customise:model2);
        if_setmodelangle(0, 0, 0, 0, 0, 440, skillcape_customise:model3);
        if_setmodelangle(0, 0, 0, 0, 0, 440, skillcape_customise:model4);
}
if_setonvartransmit("script4612{skillcape_temp, skillcape_colour_interface}", skillcape_customise:cape);
if_setonvartransmit("skillcape_build_preview{distinction_capes_11, distinction_capes_11}", skillcape_customise:cape_particles);
~script4613(skillcape_customise:cape);
