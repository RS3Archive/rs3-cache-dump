// 2326
[proc,script2326](model $model0)
def_int $int1 = clientclock;
switch_model ($model0) {
    case model_32826, model_32828, model_32820 :
        %varclient_767 = 0;
        if_sethide(false, interface_306:com_25);
        if_settext("Incorrect", interface_306:com_26);
        sound_synth(sound_28942, 1, 0);
        if_setcolour(^red, interface_306:com_26);
        if_setontimer("script2327($int1)", interface_306:com_25);
    case default :
        if (++%varclient_767 = 10) {
            if_sethide(false, interface_306:com_27);
            if_setop(1, "Train", interface_306:com_29);
            if_setonclick(null, interface_306:com_24);
        } else {
            if_sethide(false, interface_306:com_25);
            if_settext("Correct", interface_306:com_26);
            sound_synth(sound_30615, 1, 0);
            if_setcolour(^green, interface_306:com_26);
            if_setontimer("script2327($int1)", interface_306:com_25);
        }
}
