// 15330
[proc,script15330](achievement $achievement0, achievement $achievement1)
cc_deleteall(interface_1852:com_35);
if_sethide(true, interface_1852:com_15);
if_sethide(true, interface_1852:com_16);
if ($achievement0 = null & $achievement1 = null) {
    cc_create(interface_1852:com_35, ^iftype_text, 0);
    cc_settext("You have no achievements close to completion.");
    cc_setposition(0, 0, ^setpos_abs_centre, ^setpos_abs_centre);
    cc_setsize(10, 10, ^setsize_minus, ^setsize_minus);
    cc_settextfont(fontmetrics_26);
    cc_settextalign(^settextalign_centre, ^settextalign_centre, 0);
    cc_setcolour(~rgb_to_hex(255, 255, 255));
}
def_int $int2 = 0;
def_string $string0 = "";
def_string $string1 = "";
def_string $string2 = "";
if ($achievement0 ! null) {
    if_sethide(false, interface_1852:com_15);
    $int2 = achievement_reqstate($achievement0);
    %varclient_5993 = $int2;
    ~script13310(interface_1852:com_73, interface_1852:com_67, 2, calc(8 * 1000));
    $string2 = achievement_getname($achievement0);
    if_settext($string2, interface_1852:com_40);
    if_setgraphic(achievement_sprite($achievement0), interface_1852:com_39);
    $string0 = append(tostring(calc($int2 / 100)), "%");
    if_settext($string0, interface_1852:com_41);
    $string1 = ~achievement_description($achievement0);
    if_setonmouserepeat("script8799($string1, event_com, -1)", interface_1852:com_15);
    if_setopbase($string2, interface_1852:com_15);
    if_setopcursor(1, cursor_210, interface_1852:com_15);
}
if ($achievement1 ! null) {
    if_sethide(false, interface_1852:com_16);
    $int2 = achievement_reqstate($achievement1);
    %varclient_5994 = $int2;
    ~script13310(interface_1852:com_78, interface_1852:com_69, 3, calc(8 * 1000));
    $string2 = achievement_getname($achievement1);
    if_settext($string2, interface_1852:com_37);
    if_setgraphic(achievement_sprite($achievement1), interface_1852:com_36);
    $string0 = append(tostring(calc($int2 / 100)), "%");
    if_settext($string0, interface_1852:com_38);
    $string1 = ~achievement_description($achievement1);
    if_setonmouserepeat("script8799($string1, event_com, -1)", interface_1852:com_16);
    if_setopbase($string2, interface_1852:com_16);
    if_setopcursor(1, cursor_210, interface_1852:com_16);
}
