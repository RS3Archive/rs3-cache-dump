// 18487
[proc,script18487]
def_int $int0 = calc(enum_getoutputcount(player_kit_hair_index_to_basecolour) - 1);
def_string $string0 = "";
while ($int0 >= 0) {
    if (cc_find(mtxmgt:colours, calc($int0 * 2 + 1)) = true) {
        $string0 = enum(int, string, player_kit_hair_colour_name, $int0);
        cc_setgraphic("mtx_colourpickerbox,0");
        ~script14990(0, "Set colour to <$string0>.");
    }
    $int0 = calc($int0 - 1);
}
