// 6294
[clientscript,script6294](int $int0)
def_int $int1 = calc($int0 + 1);
if ($int1 >= calc(spline_length(0) - 1)) {
    if_setoncamfinished(null, dom_camera:spline_contol_layer);
    cam_reset;
} else {
    cam_movealong(0, $int1, 100, 100, 1, $int1);
    if_setoncamfinished("script6294($int1)", dom_camera:spline_contol_layer);
}
