// 771
[proc,script771](int $int0, int $int1, int $int2)(graphic, int, int)
def_int $int3 = 10;
def_int $int4 = 10;
if ($int0 = 0) {
    if ($int1 <= 100) {
        return(rs3_tutorial_overlay_circle_100px, 100, 100);
    }
    if ($int1 <= 150) {
        return(rs3_tutorial_overlay_circle_150px, 150, 150);
    }
    if ($int1 <= 200) {
        return(rs3_tutorial_overlay_circle_200px, 200, 200);
    }
    if ($int1 <= 250) {
        return(rs3_tutorial_overlay_circle_250px, 250, 250);
    }
    if ($int1 <= 300) {
        return(rs3_tutorial_overlay_circle_300px, 300, 300);
    }
    if ($int1 <= 350) {
        return(rs3_tutorial_overlay_circle_350px, 350, 350);
    }
    if ($int1 <= 400) {
        return(rs3_tutorial_overlay_circle_400px, 400, 400);
    }
    if ($int1 <= 450) {
        return(rs3_tutorial_overlay_circle_450px, 450, 450);
    } else {
        return(rs3_tutorial_overlay_circle_500px, 500, 500);
    }
} else {
    if ($int1 > $int2) {
        $int3 = max(10, scale($int2, $int1, $int3));
    } else if ($int2 > $int1) {
        $int4 = max(10, scale($int1, $int2, $int4));
    }
    return(rs3_tutorial_overlay_square_500px, scale($int1, 100, calc(100 + $int3)), scale($int2, 100, calc(100 + $int4)));
}
