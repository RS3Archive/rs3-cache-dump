// 14367
[proc,script14367](inv $inv0, obj $obj1, int $int2)
switch_inv ($inv0) {
    case inv, lore_bob :
        if ($int2 <= 0) {
            ~script9240(~bank_get_inv_component($inv0), cc_param(rs3_setup_interface_inv_scrollbar), $inv0, null, 0, 1, "", "", "", "", "", "", "", "", "", "");
        } else {
            ~script9240(~bank_get_inv_component($inv0), cc_param(rs3_setup_interface_inv_scrollbar), $inv0, $obj1, $int2, 1, ~script14419($inv0, $obj1, $int2, "Deposit"));
        }
        if (oc_stackable($obj1) = false) {
            ~script14368($inv0, $obj1, $int2);
        }
    case worn :
        if ($int2 <= 0) {
            ~script9222(null, 0);
        } else {
            ~script9222($obj1, $int2);
        }
}
