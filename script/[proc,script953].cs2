// 953
[proc,script953]
def_int $int0 = if_getheight(crcs_tightrope:emote_default);
if_setscrollsize(0, 555, crcs_tightrope:emote_scroll);
if_setscrollsize(0, 555, crcs_tightrope:juggle_scroll);
~rs3_scrollbar_vertical(crcs_tightrope:emote_scrollbar, crcs_tightrope:emote_scroll);
~rs3_scrollbar_vertical(crcs_tightrope:juggle_scrollbar, crcs_tightrope:juggle_scroll);
if ($int0 >= 550) {
    if_setsize(0, 0, ^setsize_minus, ^setsize_minus, crcs_tightrope:emote_scroll);
    if_setsize(0, 0, ^setsize_minus, ^setsize_minus, crcs_tightrope:juggle_scroll);
    if_sethide(true, crcs_tightrope:emote_scrollbar);
    if_sethide(true, crcs_tightrope:juggle_scrollbar);
} else {
    if_sethide(false, crcs_tightrope:emote_scrollbar);
    if_sethide(false, crcs_tightrope:juggle_scrollbar);
    if_setsize(20, 0, ^setsize_minus, ^setsize_minus, crcs_tightrope:emote_scroll);
    if_setsize(20, 0, ^setsize_minus, ^setsize_minus, crcs_tightrope:juggle_scroll);
}
