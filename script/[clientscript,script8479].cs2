// 8479
[clientscript,script8479](component $component0, component $component1, int $int2)
if (cc_find($component1, $int2) = true | $int2 = -1 & if_find($component1) = true) {
    if_setondrag("script8482($component0, $component1, $int2, -1, 1, 0, 0, 0, 0)", $component0);
    if_setondragcomplete("script9620($component0, $component1, $int2, -1)", $component0);
    setdefaultcursors(cursor_acc_create_rotate_small, cursor_acc_create_rotate_small);
    if_setmouseovercursor(null, $component0);
}
