// 890
[proc,script890](int $int0)
if_sethide(true, combatv2_teleother:teleother_on_selected);
if_sethide(true, combatv2_teleother:teleother_friend_selected);
if_sethide(true, combatv2_teleother:teleother_off_selected);
switch_int ($int0) {
    case 0 :
        if_sethide(false, combatv2_teleother:teleother_on_selected);
    case 1 :
        if_sethide(false, combatv2_teleother:teleother_friend_selected);
    case 2 :
        if_sethide(false, combatv2_teleother:teleother_off_selected);
}
