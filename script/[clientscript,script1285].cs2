// 1285
[clientscript,script1285]
switch_int (%trh139_current_multiplier) {
    case 2 :
        if_setgraphic(trhmar18_gems_4x_inactive, trh139:4x_gem_graphic);
        if_setgraphic(trhmar18_gems_3x_inactive, trh139:3x_gem_graphic);
        if_setgraphic(trhmar18_gems_2x_active, trh139:2x_gem_graphic);
        if_sethide(true, trh139:4x_gem_glow);
        if_sethide(true, trh139:3x_gem_glow);
        if_sethide(false, trh139:2x_gem_glow);
    case 3 :
        if_setgraphic(trhmar18_gems_4x_inactive, trh139:4x_gem_graphic);
        if_setgraphic(trhmar18_gems_3x_active, trh139:3x_gem_graphic);
        if_setgraphic(trhmar18_gems_2x_inactive, trh139:2x_gem_graphic);
        if_sethide(true, trh139:4x_gem_glow);
        if_sethide(false, trh139:3x_gem_glow);
        if_sethide(true, trh139:2x_gem_glow);
    case 4 :
        if_setgraphic(trhmar18_gems_4x_active, trh139:4x_gem_graphic);
        if_setgraphic(trhmar18_gems_3x_inactive, trh139:3x_gem_graphic);
        if_setgraphic(trhmar18_gems_2x_inactive, trh139:2x_gem_graphic);
        if_sethide(false, trh139:4x_gem_glow);
        if_sethide(true, trh139:3x_gem_glow);
        if_sethide(true, trh139:2x_gem_glow);
    case default :
        if_setgraphic(trhmar18_gems_4x_inactive, trh139:4x_gem_graphic);
        if_setgraphic(trhmar18_gems_3x_inactive, trh139:3x_gem_graphic);
        if_setgraphic(trhmar18_gems_2x_inactive, trh139:2x_gem_graphic);
        if_sethide(true, trh139:4x_gem_glow);
        if_sethide(true, trh139:3x_gem_glow);
        if_sethide(true, trh139:2x_gem_glow);
}
switch_int (%trh139_current_rarity) {
    case 2 :
        if_setgraphic(trhmar18_gem_red_inactive, trh139:red_gem_graphic);
        if_setgraphic(trhmar18_gem_orange_inactive, trh139:orange_gem_graphic);
        if_setgraphic(trhmar18_gem_yellow_active, trh139:yellow_gem_graphic);
        if_sethide(true, trh139:red_gem_glow);
        if_sethide(true, trh139:orange_gem_glow);
        if_sethide(false, trh139:yellow_gem_glow);
    case 3 :
        if_setgraphic(trhmar18_gem_red_inactive, trh139:red_gem_graphic);
        if_setgraphic(trhmar18_gem_orange_active, trh139:orange_gem_graphic);
        if_setgraphic(trhmar18_gem_yellow_inactive, trh139:yellow_gem_graphic);
        if_sethide(true, trh139:red_gem_glow);
        if_sethide(false, trh139:orange_gem_glow);
        if_sethide(true, trh139:yellow_gem_glow);
    case 4 :
        if_setgraphic(trhmar18_gem_red_active, trh139:red_gem_graphic);
        if_setgraphic(trhmar18_gem_orange_inactive, trh139:orange_gem_graphic);
        if_setgraphic(trhmar18_gem_yellow_inactive, trh139:yellow_gem_graphic);
        if_sethide(false, trh139:red_gem_glow);
        if_sethide(true, trh139:orange_gem_glow);
        if_sethide(true, trh139:yellow_gem_glow);
    case default :
        if_setgraphic(trhmar18_gem_red_inactive, trh139:red_gem_graphic);
        if_setgraphic(trhmar18_gem_orange_inactive, trh139:orange_gem_graphic);
        if_setgraphic(trhmar18_gem_yellow_inactive, trh139:yellow_gem_graphic);
        if_sethide(true, trh139:red_gem_glow);
        if_sethide(true, trh139:orange_gem_glow);
        if_sethide(true, trh139:yellow_gem_glow);
}
