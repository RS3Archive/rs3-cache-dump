// 775
[proc,script775]()(int, string, int)
switch_obj (%follower_obj) {
    case default :
        return(36, "Bronze Bull Rush", 12461);
    case lore_minotaur :
        return(36, "Bronze Bull Rush", 12461);
    case lore_minotaur_2 :
        return(46, "Iron Bull Rush", 12462);
    case lore_minotaur_3 :
        return(56, "Steel Bull Rush", 12463);
    case lore_minotaur_4 :
        return(66, "Mithril Bull Rush", 12464);
    case lore_minotaur_5 :
        return(76, "Adamant Bull Rush", 12465);
    case lore_minotaur_6 :
        return(86, "Rune Bull Rush", 12466);
}
