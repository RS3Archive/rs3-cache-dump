// 18026
[proc,script18026](component $component0, int $int1, int $int2)
if ($int1 > 0) {
    if_sethide(false, bp3_track_tab:reward_track_fade_left);
} else {
    if_sethide(true, bp3_track_tab:reward_track_fade_left);
}
if ($int1 >= $int2) {
    if_sethide(true, bp3_track_tab:reward_track_fade_right);
} else {
    if_sethide(false, bp3_track_tab:reward_track_fade_right);
}
