// 14982
[proc,script14982](obj $obj0, int $int1, int $int2, int $int3)
cc_clearops;
.cc_setgraphic(rs3_inventory_slot);
.cc_setposition(calc($int2 - 1), calc($int3 + 2 - 1), ^setpos_abs_left, ^setpos_abs_top);
cc_setposition(calc($int2 + 3), calc($int3 + 2 + 1), ^setpos_abs_left, ^setpos_abs_top);
cc_setobject_alwaysnum($obj0, $int1);
cc_setonop("script1620(event_com, event_comsubid, 100, 0, 8)");
cc_setonmouseleave("script5495(null)");
