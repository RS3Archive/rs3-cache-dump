// 7386
[proc,script7386]()(enum, enum, enum)
switch_int (map_lang) {
    case 0 :
        return(pop_ship_prefix, pop_ship_name1, pop_ship_name2);
    case 2 :
        return(pop_ship_prefix_fr, pop_ship_name1_fr, pop_ship_name2_fr);
    case 1 :
        return(pop_ship_prefix_de, pop_ship_name1_de, pop_ship_name2_de);
    case 3 :
        return(pop_ship_prefix_pt, pop_ship_name1_pt, pop_ship_name2_pt);
    case 6 :
        return(pop_ship_prefix_es_mx, pop_ship_name1_es_mx, pop_ship_name2_es_mx);
}
