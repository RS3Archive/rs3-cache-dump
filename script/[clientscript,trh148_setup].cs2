// 1150
[clientscript,trh148_setup]
def_int $int0 = -1;
def_int $int1 = -1;
cc_deleteall(wheel_of_fortune:fake_op);
while (++$int0 < 8) {
    ~script1155($int0);
    cc_create(wheel_of_fortune:fake_op, ^iftype_graphic, $int0);
}
cc_create(wheel_of_fortune:fake_op, ^iftype_graphic, $int0);
if_setonop("script1116($int0)", trh148_overlay:keybind_layer);
if_setonvartransmit("trh148_info_setup{trh148_main1, trh148_main2}", trh148_overlay:gem_info_layer);
switch_int (map_lang) {
    case 0 :
        if_setgraphic(trh148_title_en, trh148_overlay:promo_name_graphic);
    case 1 :
        if_setgraphic(trh148_title_de, trh148_overlay:promo_name_graphic);
    case 2 :
        if_setgraphic(trh148_title_fr, trh148_overlay:promo_name_graphic);
    case 3 :
        if_setgraphic(trh148_title_pt, trh148_overlay:promo_name_graphic);
}
