// 11826
[proc,telemetry_set_scroll](component $component0, int $int1, int $int2)
if ($component0 = telemetry:scroll_layer) {
    %telemetry_lastscrollpos = $int1;
} else if ($component0 = toplevel_v2_parent_suboverlay_telemetry:scroll_layer) {
    %telemetry_suboverlay_lastscrollpos = $int1;
}
if ($int2 = 0) {
    %telemetry_scroll_drag_active = 1;
} else {
    %telemetry_scroll_drag_active = 0;
}
