// 2688
[clientscript,meslayer_mode15]
if (clan_getchatcount > 0 & clan_getchatrank >= clan_getchatminkick) {
    if (%has_displayname_client = false) {
        return;
    }
    if_sethide(false, meslayer:root);
    if (%snapshot_open = true) {
        ~script675;
    }
    if_settext("Enter the player to ban from the channel:", meslayer:mes_text);
    %meslayermode = 15;
    ~meslayer_setupinput("");
    if_setonclick(null, meslayer:mes_layer);
    ~script2026;
}
