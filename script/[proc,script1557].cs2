// 1557
[proc,script1557]
if_setposition(~script1552(%meslayer_caret, %meslayerinput, museo_sans_11pt_regular, meslayer:mes_text2, -1), calc((if_getheight(meslayer:mes_layer) - 60 - 14) / 2 + 60), ^setpos_abs_left, ^setpos_abs_top, meslayer:caret);
if (applet_hasfocus = true) {
    if_sethide(false, meslayer:caret);
} else {
    if_sethide(true, meslayer:caret);
}
if_setontimer("script1400(clientclock, meslayer:caret)", meslayer:mes_text2);
