// 207
[clientscript,script207]
if (if_gethide(pnr_map:pnr_key_dropdown_layer) = true) {
    if_setop(1, "Close key", pnr_map:pnr_key_open_layer);
    if_sethide(false, pnr_map:pnr_key_dropdown_layer);
} else {
    if_setop(1, "Open key", pnr_map:pnr_key_open_layer);
    if_sethide(true, pnr_map:pnr_key_dropdown_layer);
}
