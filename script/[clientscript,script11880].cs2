// 11880
[clientscript,script11880]
if (%hw15_collected_souls >= 20) {
    if_settext("<col=00FF00>Escort souls up the bridge.", hw15_overlay:hw15_soul_progress);
} else {
    if_settext("<col=FFFFFF>Souls Remaining: <tostring(max(0, calc(20 - %hw15_collected_souls)))>", hw15_overlay:hw15_soul_progress);
}
