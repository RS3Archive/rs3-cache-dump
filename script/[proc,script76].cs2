cc_setposition($int1, $int2, ^setpos_abs_left, ^setpos_abs_top);
cc_setsize(calc($int3 - 1), 0, ^setsize_abs, ^setsize_abs);
~script11024(7);
cc_create($component0, ^iftype_line, if_getnextsubid($component0));
cc_setposition(calc($int1 + 1), calc($int2 + 1), ^setpos_abs_left, ^setpos_abs_top);
cc_setsize(calc($int3 - 2), 0, ^setsize_abs, ^setsize_abs);
