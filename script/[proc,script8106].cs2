// 8106
[proc,script8106](component $component0)(int)
switch_component ($component0) {
    case trh116_valentines_shop:staff_of_devotion_button_active :
        return(%trh116_staff_of_devotion_unlocked);
    case trh116_valentines_shop:heart_balloon_button_active :
        return(%trh116_heart_balloon_unlocked);
    case trh116_valentines_shop:loved_up_rest_button_active :
        return(%trh116_rest_anim_unlocked);
    case trh116_valentines_shop:loved_up_walk_button_active :
        return(%trh116_walk_unlocked);
    case trh116_valentines_shop:loved_up_loot_button_active :
        return(%trh116_lootbeam_unlocked);
    case trh116_valentines_shop:bunch_of_flowers_button_active :
        return(%trh116_bunch_of_flowers_unlocked);
}
