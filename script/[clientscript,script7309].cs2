// 7309
[clientscript,script7309](component $component0, int $int1, int $int2)
switch_component ($component0) {
    case pop_crew:recruit_trait_1 :
        if ($int1 = 1) {
            if_setcolour(0xfe9d03, $component0);
        } else {
            if_setcolour(0xc5bcac, $component0);
        }
    case pop_crew:recruit_trait_2 :
