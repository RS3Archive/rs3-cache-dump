// 2497
[proc,trh153_chest_update]
%trh153_chest_clicked = 0;
def_struct $struct0 = null;
def_component $component1 = null;
def_component $component2 = null;
def_component $component3 = null;
def_component $component4 = null;
def_int $int5 = -1;
def_string $string0 = "";
def_int $int6 = -1;
while (++$int5 < 4) {
    switch_int ($int5) {
        case 0 :
            $struct0 = enum(int, struct, trh153_chests, %trh153_chest_1);
            $component1 = trh153_overlay:chest_1_model;
            $component2 = trh153_overlay:chest_1_icon;
            $component3 = trh153_overlay:chest_1_icon_glow;
            $component4 = trh153_overlay:chest_1_icon_container;
        case 1 :
            $struct0 = enum(int, struct, trh153_chests, %trh153_chest_2);
            $component1 = trh153_overlay:chest_2_model;
            $component2 = trh153_overlay:chest_2_icon;
            $component3 = trh153_overlay:chest_2_icon_glow;
