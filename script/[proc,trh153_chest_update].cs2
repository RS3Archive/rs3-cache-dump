    if_setmodelangle(0, 0, 19, 29, 0, 450, $component1);
    if_setmodelanim(struct_param($struct0, trh153_chest_idle), $component1);
    if ($struct0 = trh153_chest_category) {
        $int6 = ~trh_get_slot_category($int5);
        if_setgraphic(enum(int, graphic, trh_category_icon, $int6), $component2);
