// 19511
[proc,script19511]
if (%group_ironman_storage_init_cycle = clientclock | %group_ironman_storage_init_cycle = -1) {
    return;
}
~script19507;
~script19552;
if (%group_ironman_storage_resize_cycle <= clientclock) {
    ~script19518(1);
    %group_ironman_storage_resize_cycle = calc(clientclock + 5);
}
