// 10696
[clientscript,script10696]
if (%divdnd_transmog = 0) {
    if_sethide(false, divdnd_overlay:memories1);
    if_sethide(false, divdnd_overlay:memories2);
    if_sethide(true, divdnd_overlay:robots1);
    if_sethide(true, divdnd_overlay:robots2);
} else {
    if_sethide(true, divdnd_overlay:memories1);
    if_sethide(true, divdnd_overlay:memories2);
    if_sethide(false, divdnd_overlay:robots1);
    if_sethide(false, divdnd_overlay:robots2);
}
