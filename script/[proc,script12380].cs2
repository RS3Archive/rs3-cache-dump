// 12380
[proc,script12380]
def_string $string0 = "";
def_string $string1 = "";
if (%varplayerbit_30930 = 0) {
    $string0 = "No bounty active.";
    $string1 = "Bounty: <col=FF0000>None</col>";
    if_setcolour(^white, interface_1746:com_68);
} else if (%varplayerbit_30926 = 1000) {
    $string0 = "Bounty complete.";
    $string1 = "Bounty: <col=00FF00>Complete</col>";
    if_setcolour(^green, interface_1746:com_68);
} else {
    $string0 = "Bounty progress: <tostring(calc(%varplayerbit_30926 / 10))>/100";
    $string1 = "Bounty: <tostring(calc(%varplayerbit_30926 / 10))>/100";
    if_setcolour(^white, interface_1746:com_68);
}
if_settext($string0, interface_1746:com_68);
if_settext($string1, interface_1746:com_31);
