// 11276
[clientscript,stat_select](component $component0, int $int1)
if (%stat_select > 0 & %stat_select <= enum_getoutputcount(stat_autoint_to_int)) {
    ~script11275($component0, calc(%stat_select * 10), rs3_icon_holder);
}
%stat_select = $int1;
~script11275($component0, calc($int1 * 10), rs3_icon_holder_selected);
if (%stat_select > 0 & %stat_select <= enum_getoutputcount(stat_autoint_to_int)) {
    if_sethide(true, stat_select:confirm_disabled);
} else {
    if_sethide(false, stat_select:confirm_disabled);
}
