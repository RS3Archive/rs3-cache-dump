// 6652
[proc,script6652](component $component0)
~script6653;
switch_int (%clav_current_part_customise_varp) {
    case 1 :
        if_sethide(false, clav_customise:head_selected);
    case 2 :
        if_sethide(false, clav_customise:torso_selected);
    case 4 :
        if_sethide(false, clav_customise:upper_arm_right_selected);
    case 6 :
        if_sethide(false, clav_customise:arm_connect_right_selected);
    case 8 :
        if_sethide(false, clav_customise:lower_arm_right_selected);
    case 5 :
        if_sethide(false, clav_customise:upper_arm_left_selected);
    case 7 :
        if_sethide(false, clav_customise:arm_connect_left_selected);
    case 9 :
        if_sethide(false, clav_customise:lower_arm_left_selected);
    case 3 :
        if_sethide(false, clav_customise:bottom_selected);
}
~script6654($component0);
