// 18075
[proc,script18075](int $int0, component $component1)
def_int $int2 = calc($int0 + if_getheight(bp3_missions_tab:mission_info_chain_layer) + 20);
if_setscrollpos(0, 0, $component1);
if_setscrollsize(if_getwidth($component1), $int2, $component1);
if ($int2 > if_getheight($component1)) {
    ~rs3_scrollbar_vertical(bp3_missions_tab:mission_info_scroll_bar, $component1);
} else {
    cc_deleteall(bp3_missions_tab:mission_info_scroll_bar);
}
