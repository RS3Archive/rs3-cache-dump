// 5018
[clientscript,script5018](component $component0, component $component1, int $int2, int $int3, int $int4)
if ($int4 >= 5) {
    if_setcolour(hsvtorgb($int2), $component0);
    if_setcolour(hsvtorgb($int3), $component1);
} else {
    if_setcolour(hsvtorgb(42550), $component0);
    if_setcolour(hsvtorgb(39382), $component1);
}
