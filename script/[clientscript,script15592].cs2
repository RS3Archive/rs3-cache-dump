// 15592
[clientscript,script15592]
if_setonvarctransmit("script20842{beta_login_imported_client}", lobbyscreen:beta_save_container);
~script13993(lobbyscreen:beta_save_button, null, rs3tli_3x3_button, "Import Save");
if_sethide(false, lobbyscreen:beta_save_container);
def_int $int0 = calc(date_minutes - %beta_login_imported_client);
if ($int0 < 60) {
    if_settext("The import save button will be available in <tostring(calc(60 - $int0))> minute(s).", lobbyscreen:beta_save_text);
    if_sethide(true, lobbyscreen:beta_save_button);
} else {
    if_settext("", lobbyscreen:beta_save_text);
    if_sethide(false, lobbyscreen:beta_save_button);
}
