// 1901
[clientscript,script1901]
if_settext("This override can be accessed from the Wardrobe tab of the Customisations interface.<br><br>Under the Wardrobe's 'Boots' category you will be able to select this cosmetic override, making anything you wear on your feet look like this item.<br><br>If you have claimed all the items, the armour set can also be selected from the 'Full Outfits' category.", interface_68:com_71);
if_sethide(false, interface_68:com_40);
