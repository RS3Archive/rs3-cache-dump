if_settext(%shop_item_description, shop_main:item_description);
def_int $int3 = ~buyprice_total($obj2, %shop_last_viewed_buyamt);
if ($inv0 = inv) {
    if_settext("Value:", shop_main:total_title);
    if_settext("Sell", shop_main:buy_text);
    $int3 = ~sellprice_total($obj2, %shop_last_viewed_buyamt, %shop);
    if (testbit(%shop_inventory_sell_status, $int1) = ^false) {
        $int3 = -1;
    }
} else if ($inv0 = %shopfreebie) {
    if_settext("Price:", shop_main:total_title);
    if_settext("Take", shop_main:buy_text);
} else {
    if_settext("Price:", shop_main:total_title);
    if_settext("Buy", shop_main:buy_text);
}
~script17395;
if ($int3 = -1) {
    if_settext("N/A", shop_main:total_value);
    if_setgraphic("km_shopitems,0", shop_main:total_icon);
} else if ($inv0 = %shopfreebie) {
    if_settext("Free!", shop_main:total_value);
    if_setgraphic(null, shop_main:total_icon);
} else {
    if_settext(~script940($int3), shop_main:total_value);
    if_setgraphic(enum(int, graphic, currency_graphic, %currency), shop_main:total_icon);
