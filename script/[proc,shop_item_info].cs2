        } else {
            cc_setgraphic("rs3_btn_icon_38px,3");
        }
    }
    %shop_previously_viewed_inventory = $inv0;
    %shop_previously_viewed_slot = $int1;
}
def_string $string0 = ~script2706($obj2);
if (compare($string0, "") ! 0) {
    if (compare(%objreq_wearable, "") ! 0) {
        $string0 = append($string0, %objreq_wearable);
    }
    if (compare(%objreq_useable, "") ! 0) {
        $string0 = append($string0, "<br><%objreq_useable>");
    }
    if_setgraphic("km_shopitems,0", shop_main:item_no_use);
    if_setonmouserepeat("script8799($string0, event_com, event_comsubid)", shop_main:item_name);
} else {
    if_setgraphic(null, shop_main:item_no_use);
    if_setonmouserepeat(null, shop_main:item_no_use);
