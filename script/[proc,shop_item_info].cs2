if ($obj2 = null | inv_total($inv0, $obj2) = -1) {
    if_settext("Select an item", shop_main:item_name);
    if_setobject(null, -1, shop_main:item_icon);
    if_settext("N/A", shop_main:total_value);
    if_setgraphic(null, shop_main:total_icon);
    if_setcolour(0x827f79, shop_main:buy_text);
    if_settext("N/A", shop_main:buy_text);
