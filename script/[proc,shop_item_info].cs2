            cc_setgraphic("rs3_btn_icon_38px,0");
        }
    }
}
$component5 = shop_main:list_background;
if (%shop_last_viewed_inventory = %shopfreebie) {
    $component5 = shop_main:free_background;
}
if ($inv0 = %shop_last_viewed_inventory) {
    if ($inv0 = inv & cc_find(shop_side:inventory_layer, $int1) = true) {
        if_setposition(calc(cc_getx + 2 - 2), calc(cc_gety + 2 - 2), ^setpos_abs_left, ^setpos_abs_top, shop_side:select_reticule);
        if_sethide(false, shop_side:select_reticule);
    }
    if (cc_find($component5, $int1) = true & ($inv0 ! inv | %shop_filter = 1)) {
        cc_setonmouseover("shop_item_hover(%shop_verbose_mode, 1, 1, event_com, event_comsubid)");
        cc_setonmouseleave("shop_item_hover(%shop_verbose_mode, 1, 0, event_com, event_comsubid)");
        if (%shop_verbose_mode = 0) {
