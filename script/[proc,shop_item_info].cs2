def_int $int4 = parawidth(if_gettext(shop_main:total_value), if_getwidth(shop_main:total_bounding_layer), museo_sans_11pt_regular);
if ($inv0 ! %shopfreebie) {
    $int4 = calc($int4 + 2 + if_getwidth(shop_main:total_icon));
}
if_setsize($int4, 15, ^setsize_abs, ^setsize_abs, shop_main:total_layer);
if ($int3 ! -1) {
    if_sethide(true, shop_main:quantity_disabled);
    if_sethide(true, shop_main:buy_disabled);
}
def_component $component5 = shop_main:list_background;
if (%shop_previously_viewed_inventory ! null & %shop_previously_viewed_slot ! -1) {
    if_sethide(true, shop_side:select_reticule);
    if (%shop_previously_viewed_inventory = %shopfreebie) {
        $component5 = shop_main:free_background;
    }
    if (cc_find($component5, %shop_previously_viewed_slot) = true) {
