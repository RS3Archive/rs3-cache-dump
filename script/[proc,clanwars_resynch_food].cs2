// 1779
[proc,clanwars_resynch_food]
~static_checkbox(clanwars_setup:food_indicator, ~bool_to_int(~not_bool(%clanwars_rulevarc_nofood)), false);
if (%clanwars_rulevarc_nofood = false) {
    if_settrans(0, clanwars_setup:food);
} else {
    if_settrans(225, clanwars_setup:food);
}
~clanwars_updateside;
