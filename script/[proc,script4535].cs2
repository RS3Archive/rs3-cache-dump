// 4535
[proc,script4535](int $int0, component $component1)
switch_int ($int0) {
    case 0 :
        if (%trh150_plague_doctor_dagger_unlocked = 1) {
            if_sethide(false, $component1);
        } else {
            if_sethide(true, $component1);
        }
    case 1 :
        if (%trh150_plague_doctor_rest_unlocked = 1) {
            if_sethide(false, $component1);
        } else {
            if_sethide(true, $component1);
        }
    case 2 :
        if (%trh150_plague_doctor_staff_unlocked = 1) {
            if_sethide(false, $component1);
        } else {
            if_sethide(true, $component1);
        }
    case 3 :
        if (%trh150_plague_doctor_teleport_unlocked = 1) {
            if_sethide(false, $component1);
        } else {
            if_sethide(true, $component1);
        }
    case 4 :
        if (%trh150_plague_doctor_walk_unlocked = 1 & %trh150_prestige = 5) {
            if_sethide(false, $component1);
        } else {
            if_sethide(true, $component1);
        }
}
