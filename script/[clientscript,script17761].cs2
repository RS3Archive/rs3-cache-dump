// 17761
[clientscript,script17761](int $int0)
def_int $int1 = scale(calc(clientclock - $int0), 300, 300);
if ($int1 > 0 & $int1 <= 100) {
    $int1 = calc(255 - scale(255, 100, $int1));
    if_settrans($int1, activity_progress_bar:activity_backing_left);
    if_settrans($int1, activity_progress_bar:activity_backing_right);
    if_settrans($int1, activity_progress_bar:activity_backing_tile);
    if_settrans($int1, activity_progress_bar:activity_name_text);
    return;
} else if ($int1 > 100) {
    if_setontimer(null, activity_progress_bar:activity_name);
}
