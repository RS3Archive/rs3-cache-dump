// 1661
[proc,script1661](component $component0, int $int1, component $component2)
cc_deleteall($component2);
if (%tutorial_version ! 3 | %tutorial ! 55) {
    if_setontimer(null, $component2);
    return;
}
cc_create($component2, ^iftype_model, 0);
cc_setmodel(toplevel_hint_arrow);
cc_setmodelanim(toplevel_hint_arrow);
cc_setsize(43, 43, ^setsize_abs, ^setsize_abs);
~script1663($component0, $int1, $component2);
if_setontimer("script1662($component0, $int1, $component2)", $component2);
