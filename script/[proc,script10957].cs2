// 10957
[proc,script10957]
if_settext(tostring_localised(inv_total(inv, trh44_valentines15_currency), true), trh44_valentines15_milestones:petals);
if_settext(tostring_localised(200, true), trh44_valentines15_milestones:love_low_cost);
if_settext(tostring_localised(200, true), trh44_valentines15_milestones:hate_low_cost);
if_settext(tostring_localised(400, true), trh44_valentines15_milestones:love_med_cost);
if_settext(tostring_localised(400, true), trh44_valentines15_milestones:hate_med_cost);
if_settext(tostring_localised(600, true), trh44_valentines15_milestones:love_high_cost);
if_settext(tostring_localised(600, true), trh44_valentines15_milestones:hate_high_cost);
if_settext(tostring_localised(1000, true), trh44_valentines15_milestones:love_absurd_cost);
if_settext(tostring_localised(1000, true), trh44_valentines15_milestones:hate_absurd_cost);
if_settext("<tostring_localised(1250, true)> & <tostring_localised(1250, true)>", trh44_valentines15_milestones:insane_cost);
if (%trh44_valentines15_love_points = 1250) {
    if_settext("<tostring_localised(1250, true)> (cap)", trh44_valentines15_milestones:total_love);
    if_sethide(false, trh44_valentines15_milestones:resizable_3x3_button_disabled_layer_add_love);
} else {
    if_settext(tostring_localised(%trh44_valentines15_love_points, true), trh44_valentines15_milestones:total_love);
}
if (%trh44_valentines15_hate_points = 1250) {
    if_settext("<tostring_localised(1250, true)> (cap)", trh44_valentines15_milestones:total_hate);
    if_sethide(false, trh44_valentines15_milestones:resizable_3x3_button_disabled_layer_add_hate);
} else {
    if_settext(tostring_localised(%trh44_valentines15_hate_points, true), trh44_valentines15_milestones:total_hate);
}
return;
