// 1071
[proc,quickchat_phrase](component $component0, chatphrase $chatphrase1, int $int2, int $int3)
~quickchat_focus($int3);
if ($int2 >= 0) {
    ~quickchat_return($component0, $int2, $int3);
}
~script8632($int3, 0);
if (chatphrase_getdynamiccommandcount($chatphrase1) > 0) {
    ~quickchat_phrase_setup($component0, $chatphrase1, $int3);
} else {
    ~quickchat_phrase_send($chatphrase1, $int3);
}
