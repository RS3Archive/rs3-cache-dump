// 12516
[clientscript,script12516]
if_sethide(true, gwd2_overlay:seren_bg);
if_sethide(true, gwd2_overlay:seren_bg_1);
if_sethide(true, gwd2_overlay:sliske_bg);
if_sethide(true, gwd2_overlay:sliske_bg_1);
if_sethide(true, gwd2_overlay:zamorak_bg);
if_sethide(true, gwd2_overlay:zamorak_bg_1);
if_sethide(true, gwd2_overlay:zaros_bg);
if_sethide(true, gwd2_overlay:zaros_bg_1);
if_setcolour(^white, gwd2_overlay:seren_value_1);
if_setcolour(^white, gwd2_overlay:sliske_value_1);
if_setcolour(^white, gwd2_overlay:zamorak_value_1);
if_setcolour(^white, gwd2_overlay:zaros_value_1);
switch_int (%gwd2_rep_task_faction_for) {
    case 1 :
        if_sethide(false, gwd2_overlay:seren_bg);
        if_setcolour(^cyan, gwd2_overlay:seren_bg);
        if_setcolour(^green, gwd2_overlay:seren_value_1);
    case 2 :
        if_sethide(false, gwd2_overlay:sliske_bg);
        if_setcolour(^cyan, gwd2_overlay:sliske_bg);
        if_setcolour(^green, gwd2_overlay:sliske_value_1);
    case 3 :
        if_sethide(false, gwd2_overlay:zamorak_bg);
        if_setcolour(^cyan, gwd2_overlay:zamorak_bg);
        if_setcolour(^green, gwd2_overlay:zamorak_value_1);
    case 4 :
        if_sethide(false, gwd2_overlay:zaros_bg);
        if_setcolour(^cyan, gwd2_overlay:zaros_bg);
        if_setcolour(^green, gwd2_overlay:zaros_value_1);
}
switch_int (%gwd2_rep_task_faction_against) {
    case 1 :
        if_sethide(false, gwd2_overlay:seren_bg);
        if_setcolour(^red, gwd2_overlay:seren_bg);
        if_setcolour(^red, gwd2_overlay:seren_value_1);
    case 2 :
        if_sethide(false, gwd2_overlay:sliske_bg);
        if_setcolour(^red, gwd2_overlay:sliske_bg);
        if_setcolour(^red, gwd2_overlay:sliske_value_1);
    case 3 :
        if_sethide(false, gwd2_overlay:zamorak_bg);
        if_setcolour(^red, gwd2_overlay:zamorak_bg);
        if_setcolour(^red, gwd2_overlay:zamorak_value_1);
    case 4 :
        if_sethide(false, gwd2_overlay:zaros_bg);
        if_setcolour(^red, gwd2_overlay:zaros_bg);
        if_setcolour(^red, gwd2_overlay:zaros_value_1);
}
