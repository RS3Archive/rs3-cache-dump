// 7075
[clientscript,script7075](component $component0, string $string0)
def_int $int1 = stringwidth($string0, if_getfontmetrics($component0));
def_int $int2 = if_getwidth($component0);
if ($int1 < $int2) {
    if_settext($string0, $component0);
    return;
}
def_int $int3 = string_length($string0);
def_int $int4 = 1;
def_string $string1 = "";
while ($int3 > 1) {
    if (calc(string_length($string0) - 1 - $int4) < 1) {
        return;
    }
    $string1 = substring($string0, 0, calc(string_length($string0) - 1 - $int4));
    $string1 = append($string1, "...");
    $int1 = stringwidth($string1, if_getfontmetrics($component0));
    if ($int1 < $int2) {
        if_settext($string1, $component0);
        return;
    }
    $int4 = calc($int4 + 1);
    $int3 = calc($int3 - 1);
}
