// 2125
[proc,script2125](quest $quest0)(boolean)
if ($quest0 = null) {
    ~error("Null .quest.");
    return(false);
}
if (quest_getmembers($quest0) = true & map_members = false) {
    return(false);
}
if (%varplayer_1297 < quest_pointsreq($quest0)) {
    return(false);
}
if (~comlevel < quest_param($quest0, param_7859)) {
    return(false);
}
if (~task_kudos_available < quest_param($quest0, param_7860)) {
    return(false);
}
if (quest_param($quest0, param_7862) = true & ~ql4_special_requirements($quest0) = false) {
    return(false);
}
if (quest_param($quest0, param_7861) = true & %varplayerbit_9663 = 0) {
    return(false);
}
if (~ql4_quest_requirements($quest0) = false) {
    return(false);
}
if (~ql4_skill_requirements($quest0) = false) {
    return(false);
}
return(true);
