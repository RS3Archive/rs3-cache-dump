// 14009
[proc,script14009](component $component0, int $int1)
switch_int ($int1) {
    case 0 :
        if_setgraphic("combat_style_icon_melee,0", $component0);
    case 1 :
        if_setgraphic("combat_style_icon_ranged,0", $component0);
    case 2 :
        if_setgraphic("combat_style_icon_magic,0", $component0);
}
