// 7325
[proc,pop_hud_load_buttons]
if (%pop_tutorial_progress < 11) {
    if_sethide(true, pop_hud:voyages_button);
} else {
    if_sethide(false, pop_hud:voyages_button);
}
if (%pop_tutorial_progress < 13) {
    if_sethide(true, pop_hud:shipyard_button);
} else {
    if_sethide(false, pop_hud:shipyard_button);
}
if (%pop_tutorial_progress < 38) {
    if_sethide(true, pop_hud:crew_button);
} else {
    if_sethide(false, pop_hud:crew_button);
}
if (%pop_tutorial_progress < 31) {
    if_sethide(true, pop_hud:build_button);
} else {
    if_sethide(false, pop_hud:build_button);
}
if (%pop_tutorial_progress < 63) {
    if_sethide(true, pop_hud:workshop_button);
    if_sethide(true, pop_hud:map_button);
} else {
    if_sethide(false, pop_hud:workshop_button);
    if_sethide(false, pop_hud:map_button);
}
