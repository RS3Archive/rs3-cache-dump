// 2896
[clientscript,script2896](component $component0)
if (calc(clientclock % 5) = 0) {
    if (scale(%varclient_1078, calc(20 * 100), 200) > scale(%varplayerbit_5746, calc(20 * 100), 200)) {
        if_setsize(20, scale(%varclient_1078, calc(20 * 100), 200), ^setsize_abs, ^setsize_abs, $component0);
        %varclient_1078 = calc(%varclient_1078 - 1);
    } else {
        if_setontimer(null, $component0);
        %varclient_1079 = 0;
    }
}
