// 2896
[clientscript,script2896](component $component0)
if (calc(clientclock % 5) = 0) {
    if (scale(%sfa_client_time, calc(20 * 100), 200) > scale(%sfa_event_time, calc(20 * 100), 200)) {
        if_setsize(20, scale(%sfa_client_time, calc(20 * 100), 200), ^setsize_abs, ^setsize_abs, $component0);
        %sfa_client_time = calc(%sfa_client_time - 1);
    } else {
        if_setontimer(null, $component0);
        %sfa_client_timer = 0;
    }
}
