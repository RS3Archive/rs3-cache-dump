// 16098
[proc,script16098](npc $npc0)(graphic)
def_int $int1 = 0;
if ($npc0 ! null) {
    $int1 = nc_param($npc0, combatv2_weakness);
    if ($int1 = 21) {
        return(enum(int, graphic, combatv2_combat_triangle_weakness_icons, nc_param($npc0, damagetype)));
    } else {
        return(enum(int, graphic, combatv2_attack_type_icons, $int1));
    }
}
return(null);
