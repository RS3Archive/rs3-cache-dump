// 19850
[proc,script19850](achievement $achievement0)(int)
def_int $int1 = 0;
switch_achievement ($achievement0) {
    case achievement_3625 :
        $int1 = achievement_achievement_req_count($achievement0);
    case achievement_3626, achievement_3627, achievement_3628, achievement_3629, achievement_3630 :
        $int1 = calc(achievement_achievement_req_count($achievement0) - 1);
}
return(calc(enum(achievement, int, enum_7209, $achievement0) * $int1));
