// 485
[clientscript,script485](component $component0)
def_npc $npc1 = null;
def_int $int2 = 0;
if_setcolour(0xff981f, $component0);
switch_int (%conq_current_unit_purchase_slot) {
    case default :
        return;
    case 1 :
        $npc1 = ~script486(%conq_unit_1_type);
    case 2 :
        $npc1 = ~script486(%conq_unit_2_type);
    case 3 :
        $npc1 = ~script486(%conq_unit_3_type);
    case 4 :
        $npc1 = ~script486(%conq_unit_4_type);
    case 5 :
        $npc1 = ~script486(%conq_unit_5_type);
    case 6 :
        $npc1 = ~script486(%conq_unit_6_type);
    case 7 :
        $npc1 = ~script486(%conq_unit_7_type);
    case 8 :
        $npc1 = ~script486(%conq_unit_8_type);
    case 9 :
        $npc1 = ~script486(%conq_unit_9_type);
    case 10 :
        $npc1 = ~script486(%conq_unit_10_type);
}
if ($npc1 = null) {
    if_sethide(false, conq_buy_army:no_unit_selected_text);
    if_sethide(true, conq_buy_army:purchase_current_details_layer);
} else {
    if_setgraphic(nc_param($npc1, conq_unit_icon), conq_buy_army:current_unit_image);
    if_settext(nc_param($npc1, conq_unit_name), conq_buy_army:unit_type_text);
    if_settext("Movement: <col=ffffff><tostring(nc_param($npc1, conq_unit_movement))>", conq_buy_army:unit_movement_text);
    if_settext("Damage: <col=ffffff><tostring(calc(nc_param($npc1, conq_unit_damage) * 100))>", conq_buy_army:unit_damage_text);
    if_settext("Health: <col=ffffff><tostring(calc(nc_param($npc1, conq_unit_health) * 100))>", conq_buy_army:unit_health_text);
    if_settext("Range: <col=ffffff><tostring(nc_param($npc1, conq_unit_range))>", conq_buy_army:unit_range_text);
    if_settext("Cost: <col=ffffff><tostring(nc_param($npc1, conq_unit_cost))>", conq_buy_army:unit_cost_text);
}
