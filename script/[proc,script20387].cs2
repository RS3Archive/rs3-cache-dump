// 20387
[proc,script20387]
if (~script8292(9, 6) = true & (%settings_accessibility_last_master_category = 0 | %settings_accessibility_last_category = 0)) {
    %settings_accessibility_last_master_category = ~settings_find_master(settings_accessibility_category_highcontrastmode);
    %settings_accessibility_last_category = enum_getreverseindex(dbrow, int, settings_all_categories, settings_accessibility_category_highcontrastmode, 0);
}
