// 8993
[clientscript,script8993]
if (%6awe1_votes = 0) {
    if_sethide(false, 6awe1_vote:no_votes);
    mes("You have no votes to spend.");
    return;
}
if_sethide(false, 6awe1_vote:confirm_layer);
if_sethide(true, 6awe1_vote:choice_1);
if_sethide(true, 6awe1_vote:choice_2);
if_settext(tostring(%6awe1_votedisplay), 6awe1_vote:votes_to_spend);
