// 16529
[clientscript,trh180_egg_mouseover](component $component0)
if_setmodelanim(twitch_jun18_chest_shudder, $component0);
switch_int (random(4)) {
    case 0 :
        sound_vorbis_rate(easter22_egg_rattle_01, 1, 0, 50, random_sound_pitch(20, 20));
    case 1 :
        sound_vorbis_rate(easter22_egg_rattle_02, 1, 0, 50, random_sound_pitch(20, 20));
    case 2 :
        sound_vorbis_rate(easter22_egg_rattle_03, 1, 0, 50, random_sound_pitch(20, 20));
    case 3 :
        sound_vorbis_rate(easter22_egg_rattle_04, 1, 0, 50, random_sound_pitch(20, 20));
}
