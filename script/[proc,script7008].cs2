// 7008
[proc,script7008]()(boolean)
switch_obj (inv_getobj(worn, 3)) {
    case staff_of_light, lent_staff_of_light, staff_of_light_red, staff_of_light_blue, staff_of_light_yellow, staff_of_light_green, staff_of_darkness_charged, staff_of_light_augmented, staff_of_darkness_augmented :
        return(true);
}
return(false);
