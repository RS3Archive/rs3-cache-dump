// 5614
[proc,colour_changer](component $component0, int $int1, int $int2, int $int3, int $int4)(int, int, int)
if (clientclock > $int4) {
    $int4 = calc(clientclock + 50);
    if ($int3 = 1) {
        if (calc($int2 + 5) <= 100) {
            $int2 = calc($int2 + 5);
        } else {
            $int2 = 100;
            $int3 = 0;
        }
    } else if (calc($int2 - 5) >= 0) {
        $int2 = calc($int2 - 5);
    } else {
        $int2 = 0;
        $int3 = 1;
    }
    if_setmodeltint($int1, 5, 60, $int2, $component0);
}
return($int2, $int3, $int4);
