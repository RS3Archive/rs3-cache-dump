// 11508
[proc,script11508]
if (~script4158 = false) {
    return;
}
if (if_getheight(lore_stats_side:lore_bounding_box) < 245) {
    if_sethide(true, lore_stats_side:scroll_counter_holder);
    if_sethide(false, lore_stats_side:scroll_counter_holder_small);
    if_setposition(0, 10, ^setpos_abs_centre, ^setpos_abs_bottom, lore_stats_side:lore_spell_points_holder);
    if_setposition(0, 56, ^setpos_abs_centre, ^setpos_abs_bottom, lore_stats_side:lore_health_holder);
} else {
    if_sethide(false, lore_stats_side:scroll_counter_holder);
    if_sethide(true, lore_stats_side:scroll_counter_holder_small);
    if_setposition(0, 56, ^setpos_abs_centre, ^setpos_abs_bottom, lore_stats_side:lore_spell_points_holder);
    if_setposition(0, 98, ^setpos_abs_centre, ^setpos_abs_bottom, lore_stats_side:lore_health_holder);
}
