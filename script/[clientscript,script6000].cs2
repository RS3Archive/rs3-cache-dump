// 6000
[clientscript,script6000]
def_component $component0 = rand_floor_select:info_button_layer;
if (~script6431 = true) {
    if_setposition(calc(if_getx($component0) - 30), if_gety($component0), ^setpos_abs_left, ^setpos_abs_top, $component0);
}
~script2731(rand_floor_select:buff_1_text, -1, 3);
~script2731(rand_floor_select:buff_2_text, -1, 3);
~script2731(rand_floor_select:buff_3_text, -1, 3);
~script2731(rand_floor_select:buff_4_text, -1, 3);
~script2731(rand_floor_select:buff_5_text, -1, 3);
~script5360(rand_floor_select:buff_1_bg, rect_light);
~script5360(rand_floor_select:buff_2_bg, rect_dark);
~script5360(rand_floor_select:buff_3_bg, rect_light);
~script5360(rand_floor_select:buff_4_bg, rect_dark);
~script5360(rand_floor_select:buff_5_bg, rect_light);
if_settext("Death Penalty Reduction +<tostring(1)>%", rand_floor_select:buff_1_text);
if_settext("Extra Resource Chance +<tostring(2)>%", rand_floor_select:buff_2_text);
if_settext("Skilling XP Boost +<tostring(1)>%", rand_floor_select:buff_3_text);
if_settext("Damage Reduction +<tostring(1)>%", rand_floor_select:buff_4_text);
if_settext("Floor XP Boost +<tostring(25)>%", rand_floor_select:buff_5_text);
if_settext("<tostring(calc(max(%rand_floor_buff_death_penalty_reduction, 1) * 1))>%", rand_floor_select:buff_1_active_text);
if_setcolour(0x1eff00, rand_floor_select:buff_1_active_text);
if_settext("<tostring(calc(%rand_floor_buff_extra_resource_chance * 2))>%", rand_floor_select:buff_2_active_text);
if (%rand_floor_buff_extra_resource_chance > 0) {
    if_setcolour(0x1eff00, rand_floor_select:buff_2_active_text);
} else {
    ~script2731(rand_floor_select:buff_2_active_text, -1, 3);
}
if_settext("<tostring(calc(%rand_floor_buff_skilling_xp_boost * 1))>%", rand_floor_select:buff_3_active_text);
if (%rand_floor_buff_skilling_xp_boost > 0) {
    if_setcolour(0x1eff00, rand_floor_select:buff_3_active_text);
} else {
    ~script2731(rand_floor_select:buff_3_active_text, -1, 3);
}
if_settext("<tostring(calc(%rand_floor_buff_damage_reduction * 1))>%", rand_floor_select:buff_4_active_text);
if (%rand_floor_buff_damage_reduction > 0) {
    if_setcolour(0x1eff00, rand_floor_select:buff_4_active_text);
} else {
    ~script2731(rand_floor_select:buff_4_active_text, -1, 3);
}
if_settext("<tostring(calc(%rand_floor_buff_floor_xp_boost * 25))>%", rand_floor_select:buff_5_active_text);
if (%rand_floor_buff_floor_xp_boost > 0) {
    if_setcolour(0x1eff00, rand_floor_select:buff_5_active_text);
} else {
    ~script2731(rand_floor_select:buff_5_active_text, -1, 3);
}
def_int $int1 = min(calc(%rand_current_progress + 1), 60);
if ($int1 = 60) {
    $int1 = 0;
}
switch_int (calc($int1 % 5)) {
    case 0 :
        if_setcolour(^white, rand_floor_select:buff_1_text);
        ~script5360(rand_floor_select:buff_1_bg, rect_highlight);
    case 1 :
        if_setcolour(^white, rand_floor_select:buff_2_text);
        ~script5360(rand_floor_select:buff_2_bg, rect_highlight);
    case 2 :
        if_setcolour(^white, rand_floor_select:buff_3_text);
        ~script5360(rand_floor_select:buff_3_bg, rect_highlight);
    case 3 :
        if_setcolour(^white, rand_floor_select:buff_4_text);
        ~script5360(rand_floor_select:buff_4_bg, rect_highlight);
    case 4 :
        if_setcolour(^white, rand_floor_select:buff_5_text);
        ~script5360(rand_floor_select:buff_5_bg, rect_highlight);
}
