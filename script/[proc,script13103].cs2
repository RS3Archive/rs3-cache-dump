// 13103
[proc,script13103](inv $inv0, int $int1)(int)
def_int $int2 = -1;
if ($int1 < 0 | inv_size($inv0) <= $int1) {
    return($int2);
}
def_obj $obj3 = inv_getobj($inv0, $int1);
if ($obj3 = null) {
    return($int2);
}
if (oc_param($obj3, mtxrecol_set) ! null) {
    $int2 = inv_getvar($inv0, $int1, mtxrecol_recolour);
}
return($int2);
