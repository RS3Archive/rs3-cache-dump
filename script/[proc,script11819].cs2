if ($int4 > 0 & ($int3 = -1 & if_find($component2) = true | cc_find($component2, $int3) = true)) {
    if ($int4 = 1 | $int4 = 3 | $int4 = 4) {
        cc_settrans(0);
        cc_sethide(true);
        cc_setfill(false);
        cc_setontimer(null);
    } else {
        cc_settrans(255);
