// 1955
[clientscript,script1955](component $component0, int $int1, int $int2)
if (calc((clientclock + $int2) % 50) > 0) {
    return;
}
def_int $int3 = if_gettrans($component0);
def_int $int4 = calc(200 / $int1);
if_settrans(min(240, calc($int3 + $int4)), $component0);
if (if_gettrans($component0) = 240) {
    if_settrans(255, $component0);
    if_setontimer(null, $component0);
}
