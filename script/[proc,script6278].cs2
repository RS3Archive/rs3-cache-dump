// 6278
[proc,script6278](int $int0, component $component1, component $component2)
if ($int0 = 0) {
    if_settext("- ACTIVE -", $component1);
    if_setcolour(^red, $component2);
    if_settrans(200, $component2);
} else if ($int0 = 1) {
    if_settext("Activate", $component1);
    if_setcolour(0x9d4e24, $component2);
    if_settrans(200, $component2);
} else if ($int0 = 2) {
    if_settext("Buy", $component1);
} else if ($int0 = 3) {
    if_settext("Bought", $component1);
    if_setcolour(0x9d4e24, $component2);
    if_settrans(200, $component2);
} else if ($int0 = 4) {
    if_settext("Locked", $component1);
}
