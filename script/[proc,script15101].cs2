// 15101
[proc,script15101](int $int0)(int)
switch_int ($int0) {
    case 1, 26, 8, 12 :
        return(~settings_get_state(settings_notify_world_drops));
    case 24, 2, 21, 19, 25 :
        return(~settings_get_state(settings_notify_world_drops_trail));
    case 4, 7 :
        return(~settings_get_state(settings_notify_world_milestone_level));
    case 9, 16 :
