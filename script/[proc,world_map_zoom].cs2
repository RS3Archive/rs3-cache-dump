// 14185
[proc,world_map_zoom](component $component0, component $component1)
if (~swipe_enabled_check($component0) = false) {
    return;
}
if_setpinchdeadzone(5, $component0);
if_setpinchflags(3, $component0);
if_setonpinchvertical("script14204($component1, event_mousey, 1)", $component0);
if_setonpinchhorizontal("script14204($component1, event_mousex, 1)", $component0);
