// 5385
[clientscript,script5385](component $component0)
switch_component ($component0) {
    case hooks3_hood:air_selected :
        if (%hooks3_consumed_air > 0) {
            if_setgraphic("aif_wickhood_button_1,1", $component0);
        }
    case hooks3_hood:mind_selected :
        if (%hooks3_consumed_mind > 0) {
            if_setgraphic("aif_wickhood_button_1,1", $component0);
        }
    case hooks3_hood:water_selected :
        if (%hooks3_consumed_water > 0) {
            if_setgraphic("aif_wickhood_button_1,1", $component0);
        }
    case hooks3_hood:earth_selected :
        if (%hooks3_consumed_earth > 0) {
            if_setgraphic("aif_wickhood_button_1,1", $component0);
        }
    case hooks3_hood:fire_selected :
        if (%hooks3_consumed_fire > 0) {
            if_setgraphic("aif_wickhood_button_1,1", $component0);
        }
    case hooks3_hood:body_selected :
        if (%hooks3_consumed_body > 0) {
            if_setgraphic("aif_wickhood_button_1,1", $component0);
        }
    case hooks3_hood:cosmic_selected :
        if (%hooks3_consumed_cosmic > 0) {
            if_setgraphic("aif_wickhood_button_2,3", $component0);
        }
    case hooks3_hood:chaos_selected :
        if (%hooks3_consumed_chaos > 0) {
            if_setgraphic("aif_wickhood_button_2,3", $component0);
        }
    case hooks3_hood:astral_selected :
        if (%hooks3_consumed_astral > 0) {
            if_setgraphic("aif_wickhood_button_2,3", $component0);
        }
    case hooks3_hood:nature_selected :
        if (%hooks3_consumed_nature > 0) {
            if_setgraphic("aif_wickhood_button_2,3", $component0);
        }
    case hooks3_hood:law_selected :
        if (%hooks3_consumed_law > 0) {
            if_setgraphic("aif_wickhood_button_2,3", $component0);
        }
    case hooks3_hood:death_selected :
        if (%hooks3_consumed_death > 0) {
            if_setgraphic("aif_wickhood_button_2,3", $component0);
        }
    case hooks3_hood:blood_selected :
        if (%hooks3_consumed_blood > 0) {
            if_setgraphic("aif_wickhood_button_2,3", $component0);
        }
    case hooks3_hood:soul_selected :
        if (%hooks3_consumed_soul > 0) {
            if_setgraphic("aif_wickhood_button_2,3", $component0);
        }
    case default :
        return;
}
return;
