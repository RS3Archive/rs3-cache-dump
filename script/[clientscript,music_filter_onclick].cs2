// 13026
[clientscript,music_filter_onclick](component $component0)
~script8808;
switch_int (%music_filter_toggle_varc) {
    case default :
        %music_filter_toggle_varc = 1;
        if_setgraphic("aif_music_filter_buttons,3", $component0);
    case 1 :
        %music_filter_toggle_varc = 2;
        if_setgraphic("aif_music_filter_buttons,5", $component0);
    case 2 :
        %music_filter_toggle_varc = 0;
        if_setgraphic("aif_music_filter_buttons,1", $component0);
}
~music_v3_refresh(music_v3_child:music_search, music_v3_child:music_search_empty, music_v3_child:now_playing_text, music_v3_child:jukebox, music_v3_child:scrollbar, music_v3_child:unlock_counter, music_v3_child:music_shuffle);
~music_v3_refresh(music_v3:music_search, music_v3:music_search_empty, music_v3:now_playing_text, music_v3:jukebox, music_v3:scrollbar, music_v3:unlock_counter, music_v3:music_shuffle);
