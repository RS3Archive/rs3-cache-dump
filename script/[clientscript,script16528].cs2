// 16528
[clientscript,script16528](component $component0, int $int1, boolean $boolean2)
if ($int1 <= 0) {
    if ($boolean2 = true) {
        if_setmodelanim(easter22_egg_chest_idle, $component0);
        $int1 = calc(2 * seqlength(easter22_egg_chest_idle));
    } else {
        if_setmodelanim(null, $component0);
        $int1 = calc(200 + random(200));
    }
    $boolean2 = ~negate_bool($boolean2);
    if_setontimer("script16528($component0, $int1, $boolean2)", $component0);
} else {
    if_setontimer("script16528($component0, --$int1, $boolean2)", $component0);
}
