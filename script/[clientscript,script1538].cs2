// 1538
[clientscript,script1538]
def_int $int0 = calc(25 + 14 * paraheight(if_gettext(tuska_island_overlay:tutorial_text), 340, museo_sans_11pt_regular));
if (if_getheight(tuska_island_overlay:tutorial_panel) = $int0) {
    if_setontimer("script1539(0)", tuska_island_overlay:help_button);
} else {
    if_setontimer("script1539($int0)", tuska_island_overlay:help_button);
}
