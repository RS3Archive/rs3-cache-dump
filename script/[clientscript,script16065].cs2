// 16065
[clientscript,script16065](component $component0)
if (%egwd_wen_boss_current_enrage >= 100) {
    if_sethide(true, $component0);
} else if (%egwd_wen_boss_current_enrage >= 25) {
    if_settext("Unlock GOLD at 100% enrage.", $component0);
} else {
    if_settext("Unlock SILVER at 25% enrage.", $component0);
}
