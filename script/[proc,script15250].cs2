// 15250
[proc,script15250]
switch_int (federated_login_status) {
    case 0, 1, 4 :
        ~script15253;
    case 20 :
        ~script15254;
    case 22 :
        ~script15255;
    case 3 :
        ~script15251(4);
    case 2 :
        ~script15251(3);
    case default :
        ~script15251(9);
}
