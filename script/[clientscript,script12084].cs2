// 12084
[clientscript,script12084](int $rgb0, int $int1, string $string0)
if (if_gethide(toplevel_v2:xp_popup_text_window) = false) {
    cc_create(toplevel_v2:xp_popup_text_window_content, ^iftype_text, if_getnextsubid(toplevel_v2:xp_popup_text_window_content));
    cc_settrans(255);
    cc_setsize(200, 25, ^setsize_abs, ^setsize_abs);
    cc_settextfont(notosans_17);
    cc_setcolour($rgb0);
    cc_settextshadow(true);
    cc_settextalign(^settextalign_centre, ^settextalign_centre, 0);
    cc_settext($string0);
    cc_setposition(0, 0, ^setpos_abs_centre, ^setpos_abs_bottom);
    cc_setontimer("script12085(event_com, cc_getid, calc(clientclock + $int1))");
} else {
    cc_deleteall(toplevel_v2:xp_popup_text_window_content);
}
