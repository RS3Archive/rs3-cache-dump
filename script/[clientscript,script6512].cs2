// 6512
[clientscript,script6512]
if (calc(clientclock % 50) = 0) {
    if_settext(~script6513, vos_weekend:active_voice_countdown);
    if (++%vos_weekend_next_voice_seconds = 60) {
        %vos_weekend_next_voice_minutes = calc(%vos_weekend_next_voice_minutes - 1);
        %vos_weekend_next_voice_seconds = 0;
    }
}
