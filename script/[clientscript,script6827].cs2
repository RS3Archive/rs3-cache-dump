// 6827
[clientscript,script6827](int $int0, component $component1)
def_int $int2 = calc(clientclock - $int0);
def_int $int3 = 0;
if ($int2 < 100) {
    $int3 = calc(15 + scale($int2, 100, 20));
    if_setposition(0, $int3, ^setpos_abs_centre, ^setpos_abs_centre, $component1);
} else if ($int2 < 200) {
    return;
} else if ($int2 < 300) {
    $int3 = calc(35 - scale(calc($int2 - 200), 100, 20));
    if_setposition(0, $int3, ^setpos_abs_centre, ^setpos_abs_centre, $component1);
}
if ($int2 >= 300) {
    ~script6828;
}
