// 15621
[clientscript,script15621]
def_int $int0 = min(0, calc(if_getx(lobbyscreen:mobile_sidemenu) + 10));
def_int $int1 = max(180, calc(if_gettrans(lobbyscreen:mobile_sidemenu_blackout_bg) - 8));
if_setposition($int0, 0, ^setpos_abs_left, ^setpos_abs_bottom, lobbyscreen:mobile_sidemenu);
if_settrans($int1, lobbyscreen:mobile_sidemenu_blackout_bg);
if ($int0 >= 0) {
    if_setontimer(null, lobbyscreen:mobile_sidemenu_timer);
    if_settrans(180, lobbyscreen:mobile_sidemenu_blackout_bg);
}
