// 15621
[clientscript,script15621]
def_int $int0 = min(0, calc(if_getx(interface_906:com_154) + 10));
def_int $int1 = max(180, calc(if_gettrans(interface_906:com_153) - 8));
if_setposition($int0, 0, ^setpos_abs_left, ^setpos_abs_bottom, interface_906:com_154);
if_settrans($int1, interface_906:com_153);
if ($int0 >= 0) {
    if_setontimer(null, interface_906:com_5);
    if_settrans(180, interface_906:com_153);
}
