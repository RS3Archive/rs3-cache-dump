// 12640
[proc,script12640]
def_int $int0 = -1;
def_int $int1 = -1;
def_int $int2 = -1;
switch_int (cc_param(param_5837)) {
    case 0 :
        cc_settrans(scale(calc(enum(int, int, enum_9054, calc((~script12722(cc_param(param_5940), cc_param(param_5403)) + 270) % 360)) + 100), 200, 255));
    case 1 :
        $int1 = min(255, cc_param(param_5938));
        $int2 = min(255, cc_param(param_5939));
        if (cc_param(param_5839) > 0 & cc_gettrans = cc_param(param_3861)) {
            cc_setparam(param_5839, calc(cc_param(param_5839) - 1));
            return;
        }
        if ($int1 > -1 & $int2 > $int1) {
            cc_settrans(calc($int1 + scale(calc(enum(int, int, enum_9054, calc((~script12722(cc_param(param_5940), cc_param(param_5403)) + 270) % 360)) + 100), 200, calc($int2 - $int1))));
            cc_setparam(param_5839, cc_param(param_5402));
        }
    case 2 :
        if (cc_param(param_6407) ! -1) {
            $int0 = calc((100 + clientclock - cc_param(param_6407) * 25) % 100);
            if (calc($int0 / 25) = 0) {
                cc_sendtofront;
            } else if (calc($int0 / 25) = 1) {
                $int0 = 25;
            } else {
                $int0 = 0;
            }
            cc_settrans(scale(calc(100 - scale($int0, 25, 100)), 100, 255));
        }
    case 3 :
        if (cc_param(param_5839) > 0) {
            cc_setparam(param_5839, calc(cc_param(param_5839) - 1));
        } else {
            $int0 = min(255, cc_param(param_5941));
            if ($int0 > -1 & $int0 ! cc_gettrans) {
                if ($int0 < cc_gettrans) {
                    cc_settrans(max(calc(cc_gettrans - abs(cc_param(param_5838))), $int0));
                } else {
                    cc_settrans(min(calc(cc_gettrans + abs(cc_param(param_5838))), $int0));
                }
            }
        }
    case 4 :
        $int0 = min(255, cc_param(param_5941));
        if ($int0 > -1) {
            if ($int0 ! cc_gettrans) {
                if ($int0 < cc_gettrans) {
                    cc_settrans(max(calc(cc_gettrans - abs(cc_param(param_5838))), $int0));
                } else {
                    cc_settrans(min(calc(cc_gettrans + abs(cc_param(param_5838))), $int0));
                }
            } else if (cc_param(param_5839) > 0) {
                cc_setparam(param_5839, calc(cc_param(param_5839) - 1));
            } else {
                $int0 = min(255, cc_param(param_5937));
                if ($int0 > -1) {
                    if ($int0 ! cc_gettrans) {
                        cc_setparam(param_5941, $int0);
                    } else {
                        cc_setparam(param_5941, -1);
                    }
                } else {
                    cc_setparam(param_5937, cc_gettrans);
