// 12640
[proc,script12640]
def_int $int0 = -1;
def_int $int1 = -1;
def_int $int2 = -1;
switch_int (cc_param(rs3tli_component_transparency_type)) {
    case 0 :
        cc_settrans(scale(calc(enum(int, int, sin_deg2percentage_enum, calc((~script12722(cc_param(rs3tli_component_transparency_playback_rate), cc_param(rs3tli_component_transparency_offset)) + 270) % 360)) + 100), 200, 255));
    case 1 :
        $int1 = min(255, cc_param(rs3tli_component_transparency_min));
        $int2 = min(255, cc_param(rs3tli_component_transparency_max));
        if (cc_param(rs3tli_component_transparency_hold) > 0 & cc_gettrans = cc_param(rs3tli_component_transparency_hold_value)) {
            cc_setparam(rs3tli_component_transparency_hold, calc(cc_param(rs3tli_component_transparency_hold) - 1));
            return;
        }
        if ($int1 > -1 & $int2 > $int1) {
            cc_settrans(calc($int1 + scale(calc(enum(int, int, sin_deg2percentage_enum, calc((~script12722(cc_param(rs3tli_component_transparency_playback_rate), cc_param(rs3tli_component_transparency_offset)) + 270) % 360)) + 100), 200, calc($int2 - $int1))));
            cc_setparam(rs3tli_component_transparency_hold, cc_param(rs3tli_component_transparency_hold_max));
        }
    case 2 :
        if (cc_param(rs3tli_component_quarter) ! -1) {
            $int0 = calc((100 + clientclock - cc_param(rs3tli_component_quarter) * 25) % 100);
            if (calc($int0 / 25) = 0) {
                cc_sendtofront;
            } else if (calc($int0 / 25) = 1) {
                $int0 = 25;
            } else {
                $int0 = 0;
            }
            cc_settrans(scale(calc(100 - scale($int0, 25, 100)), 100, 255));
        }
    case 3 :
        if (cc_param(rs3tli_component_transparency_hold) > 0) {
            cc_setparam(rs3tli_component_transparency_hold, calc(cc_param(rs3tli_component_transparency_hold) - 1));
        } else {
            $int0 = min(255, cc_param(rs3tli_component_target_transparency));
            if ($int0 > -1 & $int0 ! cc_gettrans) {
                if ($int0 < cc_gettrans) {
                    cc_settrans(max(calc(cc_gettrans - abs(cc_param(rs3tli_component_transparency_step))), $int0));
                } else {
                    cc_settrans(min(calc(cc_gettrans + abs(cc_param(rs3tli_component_transparency_step))), $int0));
                }
            }
        }
    case 4 :
        $int0 = min(255, cc_param(rs3tli_component_target_transparency));
        if ($int0 > -1) {
            if ($int0 ! cc_gettrans) {
                if ($int0 < cc_gettrans) {
                    cc_settrans(max(calc(cc_gettrans - abs(cc_param(rs3tli_component_transparency_step))), $int0));
                } else {
                    cc_settrans(min(calc(cc_gettrans + abs(cc_param(rs3tli_component_transparency_step))), $int0));
                }
            } else if (cc_param(rs3tli_component_transparency_hold) > 0) {
                cc_setparam(rs3tli_component_transparency_hold, calc(cc_param(rs3tli_component_transparency_hold) - 1));
            } else {
                $int0 = min(255, cc_param(rs3tli_component_transparency_anchor));
                if ($int0 > -1) {
                    if ($int0 ! cc_gettrans) {
                        cc_setparam(rs3tli_component_target_transparency, $int0);
                    } else {
                        cc_setparam(rs3tli_component_target_transparency, -1);
                    }
                } else {
                    cc_setparam(rs3tli_component_transparency_anchor, cc_gettrans);
                    cc_setparam(rs3tli_component_target_transparency, -1);
                }
            }
        } else if (cc_param(rs3tli_component_transparency_anchor) ! cc_gettrans) {
            cc_setparam(rs3tli_component_transparency_anchor, min(255, cc_param(rs3tli_component_transparency_anchor)));
            cc_setparam(rs3tli_component_target_transparency, cc_gettrans);
        }
}
