// 16904
[proc,script16904]
def_int $int0 = 0;
def_int $int1 = 0;
cc_deleteall(lobbyscreen_pane_playerinfo:rotator_buttons);
while ($int0 < 4) {
    if (~script16906($int0) = true) {
        ~if_add_child_layer(lobbyscreen_pane_playerinfo:rotator_buttons, $int0, 0, $int1, 0, ^setpos_abs_left, ^setpos_abs_top, 30, 30, ^setsize_abs, ^setsize_abs);
        cc_setonclick("script16914($int0)");
        ~cc_add_child_graphic($int0, 1, 0, 0, ^setpos_abs_centre, ^setpos_abs_centre, 13, 13, ^setsize_abs, ^setsize_abs, "rs3_icon_lobby_pagination,1");
        $int1 = calc($int1 + 30);
    }
    $int0 = calc($int0 + 1);
}
~if_add_child_layer(lobbyscreen_pane_playerinfo:rotator_buttons, $int0, 0, 0, 0, ^setpos_abs_left, ^setpos_abs_top, 0, 0, ^setsize_minus, ^setsize_minus);
cc_setnoclickthrough(true);
cc_sethide(true);
if_setsize($int1, 30, ^setsize_abs, ^setsize_abs, lobbyscreen_pane_playerinfo:rotator_buttons);
if (if_find(lobbyscreen_pane_playerinfo:rotator_buttons) = true & cc_param(lobbyscreen_playerinfo_page_active) ! -1) {
