// 10695
[clientscript,script10695](component $component0)
if ($component0 = divdnd_overlay:memories_score) {
    if_settext(append("Memories converted: ", tostring(%divdnd_memory_streak)), $component0);
}
if ($component0 = divdnd_overlay:robots_score) {
    if_settext(append("Automatons subdued: ", tostring(%divdnd_enemy_streak)), $component0);
}
if ($component0 = divdnd_overlay:cres_active) {
    if_settext(append("Cres currently active: ", tostring(%divdnd_cres_active)), $component0);
}
