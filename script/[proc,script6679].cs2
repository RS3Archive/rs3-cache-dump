// 6679
[proc,script6679](stat $stat0, int $int1)(boolean)
def_int $int2 = enum(stat, int, clan_plot_type_stat2int, $stat0);
if ($int2 = -1) {
    return(false);
}
def_int $int3 = 0;
def_int $int4 = 0;
$int3, $int4 = ~script10489($int2);
if ($int3 >= 1 & $int4 = 0 & stat_base($stat0) >= 40) {
    return(true);
}
if ($int1 = 1) {
    if ($int3 = 0) {
        mes("You cannot select this as your citadel has not built the relevant skill plot.");
    } else {
        mes("You cannot select this as the skill plot must not be dilapidated and you must be at least level 40 in this skill.");
    }
    sound_vorbis_volume(omge_error, 1, 0, 150);
}
return(false);
