// 11400
[proc,script11400](int $int0)(int)
switch_int (calc($int0 / 32)) {
    case 0 :
        return(testbit(%poh_ownership_1, calc($int0 % 32)));
    case 1 :
        return(testbit(%poh_ownership_2, calc($int0 % 32)));
    case 2 :
        return(testbit(%poh_ownership_3, calc($int0 % 32)));
    case 3 :
        return(testbit(%poh_ownership_4, calc($int0 % 32)));
    case 4 :
        return(testbit(%poh_ownership_5, calc($int0 % 32)));
    case 5 :
        return(testbit(%poh_ownership_6, calc($int0 % 32)));
    case 7 :
