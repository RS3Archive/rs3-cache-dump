// 10571
[clientscript,peglegs_onclick]
if (%trh29_peglegs_owned = 1) {
    return;
}
if (inv_total(inv, trh29_doubloons) < 1000) {
    return;
}
if (inv_freespace(inv) = 0) {
    return;
}
%trh29_pirate_coins_shop_selection = 6;
if_setgraphic(trh29_pirate_icon_pegleg, trh29_pirate_coins_shop:popup_icon);
if_settext("A set of peg legs (left, right and both legs) to help your pirate look.", trh29_pirate_coins_shop:popup_description);
if_settext("Buy pirate peglegs?", trh29_pirate_coins_shop:popup_question);
if_sethide(false, trh29_pirate_coins_shop:popup_layer);
