// 4092
[clientscript,script4092](int $int0)
def_int $int1 = if_gettrans(fmc_darkness:black);
if ($int1 < calc(30 + ($int0 - 1))) {
    if_settrans(30, fmc_darkness:black);
    if_settrans(20, fmc_darkness:fade);
    if_setontimer(null, fmc_darkness:black);
    return;
} else {
    if_settrans(calc($int1 - $int0), fmc_darkness:black);
    if_settrans(calc(($int1 - $int0) / 2), fmc_darkness:fade);
}
