// 1777
[proc,clanwars_resynch_prayer]
~static_checkbox(clanwars_setup:prayer_indicator, ~bool_to_int(~not_bool(%clanwars_rulevarc_noprayer)), false);
if (%clanwars_rulevarc_noprayer = false) {
    if_settrans(0, clanwars_setup:prayer);
} else {
    if_settrans(225, clanwars_setup:prayer);
}
~clanwars_updateside;
