// 7672
[clientscript,script7672](int $int0, component $component1)
if (calc((clientclock - $int0) % 40) < 20 & applet_hasfocus = true) {
    if (%bugreport_input_focus = 1 & $component1 ! bugreport_interface:input_caret | %bugreport_input_focus = 2 & $component1 ! bugreport_interface:repro_caret) {
        if_sethide(true, $component1);
        return;
    }
    if_sethide(false, $component1);
} else {
    if_sethide(true, $component1);
}
