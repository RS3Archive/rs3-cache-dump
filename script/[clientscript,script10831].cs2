// 10831
[clientscript,script10831](component $component0)
def_component $component1 = xmas2014:reward_graphic_bg1;
def_int $int2 = 0;
switch_component ($component0) {
    case xmas2014:presents_reward1 :
        $component1 = xmas2014:reward_graphic_bg1;
        if (%xmas2014_reward_head = 1) {
            $int2 = 1;
        }
    case xmas2014:presents_reward2 :
        $component1 = xmas2014:reward_graphic_bg2;
        if (%xmas2014_reward_body = 1) {
            $int2 = 1;
        }
    case xmas2014:presents_reward3 :
        $component1 = xmas2014:reward_graphic_bg3;
        if (%xmas2014_reward_legs = 1) {
            $int2 = 1;
        }
    case xmas2014:presents_reward4 :
        $component1 = xmas2014:reward_graphic_bg4;
        if (%xmas2014_reward_cape = 1) {
            $int2 = 1;
        }
    case xmas2014:presents_reward5 :
        $component1 = xmas2014:reward_graphic_bg5;
        if (%xmas2014_reward_weapon = 1) {
            $int2 = 1;
        }
}
if ($int2 = 1) {
    if_setcolour(0x32dc32, $component1);
    if_setcolour(0x32dc32, $component0);
} else {
    if_setcolour(0xffdcb4, $component1);
    if_setcolour(0xffdcb4, $component0);
}
