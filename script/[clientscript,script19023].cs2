// 19023
[clientscript,script19023]
if (%varplayer_11775 <= 0 | %varclient_7786 <= clientclock) {
    if_sethide(true, interface_994:com_5);
    if_settrans(255, interface_994:com_5);
    if_setontimer(null, interface_994:com_1);
    return;
}
if_sethide(false, interface_994:com_5);
if (calc(%varclient_7786 - clientclock) < 30) {
    if_settrans(calc(255 - scale(calc(%varclient_7786 - clientclock), 30, 255)), interface_994:com_5);
} else {
    if_settrans(0, interface_994:com_5);
}
if_setontimer("script19023", interface_994:com_1);
