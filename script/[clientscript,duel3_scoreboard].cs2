// 6898
[clientscript,duel3_scoreboard](component $component0, component $component1)
cc_deleteall($component0);
cc_deleteall($component1);
def_int $int2 = calc(~script7593("<%duel3_scoreboard_client><%duel3_scoreboard_client_2>", if_getwidth($component0), museo_sans_11pt_regular_multiline, 12) + 5);
cc_create($component0, ^iftype_text, 0);
cc_setposition(0, 0, ^setpos_abs_centre, ^setpos_abs_top);
cc_setsize(0, $int2, ^setsize_minus, ^setsize_abs);
cc_settextfont(museo_sans_11pt_regular_multiline);
cc_settextalign(^settextalign_centre, ^settextalign_top, 0);
cc_setcolour(^white);
cc_settext("<%duel3_scoreboard_client><%duel3_scoreboard_client_2>");
if ($int2 > if_getheight($component0)) {
    if_setposition(0, 0, ^setpos_abs_left, ^setpos_abs_centre, $component0);
    if_setscrollsize(0, $int2, $component0);
    if_setscrollpos(0, 0, $component0);
    if_sethide(false, $component1);
    ~rs3_scrollbar_vertical($component1, $component0);
} else {
    if_setposition(0, 0, ^setpos_abs_centre, ^setpos_abs_centre, $component0);
    if_setscrollsize(0, 0, $component0);
    if_setscrollpos(0, 0, $component0);
    if_sethide(true, $component1);
}
