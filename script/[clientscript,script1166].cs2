// 1166
[clientscript,script1166](component $component0, component $component1, component $component2)
if (if_find($component0) = true) {
    cc_setparam(rs3tli_component_rotation_type, 4);
    cc_setparam(rs3tli_component_sound_id, 2);
    cc_setparam(rs3tli_component_sound_event, 0);
}
if (if_find($component1) = true) {
    cc_setparam(rs3tli_component_rotation_type, 4);
}
if (if_find($component2) = true) {
    cc_setparam(rs3tli_component_rotation_type, 4);
}
