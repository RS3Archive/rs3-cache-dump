// 8168
[clientscript,script8168](component $component0, int $int1, int $int2)
if ($int2 > -1 & $int2 < 30) {
    if (calc(clientclock % 2) = 0) {
        if_setsize(1, 1, ^setsize_abs, ^setsize_abs, ~script8170($int1));
        if_setsize(0, 0, ^setsize_minus, ^setsize_minus, ~script8170($int2));
        if ($int1 > $int2) {
            if (has_nxt = false & if_gethide(~script8170($int2)) = true) {
                ~script8169($int1, calc($int1 + 10), true);
                ~script8169(calc($int2 - 10), $int2, false);
            }
            $int2 = calc($int2 - 1);
            $int1 = calc($int1 - 1);
        } else {
            if (has_nxt = false & if_gethide(~script8170($int2)) = true) {
                ~script8169(calc($int1 - 10), $int1, true);
                ~script8169($int2, calc($int2 + 10), false);
            }
            $int2 = calc($int2 + 1);
            $int1 = calc($int1 + 1);
        }
        if_setontimer("script8168(event_com, $int1, $int2)", $component0);
    }
} else {
    if_setontimer(null, $component0);
    if_closesubclient(toplevel_v2:state_change_notifications);
    ~script8164;
}
