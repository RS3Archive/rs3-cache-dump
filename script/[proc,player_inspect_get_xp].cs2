// 10783
[proc,player_inspect_get_xp](stat $stat0)(int)
switch_stat ($stat0) {
    case attack :
        return(%player_inspect_xp_attack);
    case hitpoints :
        return(%player_inspect_xp_constitution);
    case mining :
        return(%player_inspect_xp_mining);
    case strength :
        return(%player_inspect_xp_strength);
    case agility :
        return(%player_inspect_xp_agility);
    case smithing :
        return(%player_inspect_xp_smithing);
    case defence :
        return(%player_inspect_xp_defence);
    case herblore :
        return(%player_inspect_xp_herblore);
    case fishing :
        return(%player_inspect_xp_fishing);
    case ranged :
        return(%player_inspect_xp_ranged);
    case thieving :
        return(%player_inspect_xp_thieving);
    case cooking :
        return(%player_inspect_xp_cooking);
    case prayer :
        return(%player_inspect_xp_prayer);
    case crafting :
        return(%player_inspect_xp_crafting);
    case firemaking :
        return(%player_inspect_xp_firemaking);
    case magic :
        return(%player_inspect_xp_magic);
    case fletching :
        return(%player_inspect_xp_fletching);
    case woodcutting :
        return(%player_inspect_xp_woodcutting);
    case runecraft :
        return(%player_inspect_xp_runecrafting);
    case slayer :
        return(%player_inspect_xp_slayer);
    case farming :
        return(%player_inspect_xp_farming);
    case construction :
        return(%player_inspect_xp_construction);
    case hunter :
        return(%player_inspect_xp_hunter);
    case summoning :
        return(%player_inspect_xp_summoning);
    case dungeoneering :
        return(%player_inspect_xp_dungeoneering);
    case divination :
        return(%player_inspect_xp_divination);
    case invention :
        return(%player_inspect_xp_invention);
    case archaeology :
        return(%player_inspect_xp_archaeology);
    case necromancy :
        return(%player_inspect_xp_necromancy);
    case default :
        return(-1);
}
