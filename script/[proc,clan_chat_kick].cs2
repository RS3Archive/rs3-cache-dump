// 4466
[proc,clan_chat_kick](string $string0)
def_int $int0 = activeclanchannel_getuserslot($string0);
if ($int0 < 0) {
    mes_typed(^chattype_clanmessage, 0, "Could not find that guest to kick from your Clan Chat.");
    return;
}
def_int $int1 = activeclanchannel_getuserrank($int0);
def_int $int2 = activeclanchannel_getuserslot(removetags(chat_playername_unfiltered));
if ($int2 = $int0) {
    mes_typed(^chattype_clanmessage, 0, "You cannot temporarily ban yourself.");
    return;
}
if ($int2 = -1) {
    return;
}
def_int $int3 = activeclanchannel_getuserrank($int2);
if ($int3 < activeclanchannel_getrankkick) {
    mes_typed(^chattype_clanmessage, 0, "You do not have sufficient rank to kick.");
    return;
}
if ($int1 > -1) {
    mes_typed(^chattype_clanmessage, 0, "You can only temporarily ban guests.");
    if ($int3 < 100) {
        mes_typed(^chattype_clanmessage, 0, "A clan admin can remove your clanmate.");
    }
} else if ($int3 > $int1) {
    activeclanchannel_kickuser(activeclanchannel_getuserslot($string0));
    activechatphrase_prepare(chatphrase_821);
    chat_setmode_affined_clan(0);
    activechatphrase_send;
} else {
    mes_typed(^chattype_clanmessage, 0, "You can only kick people with a lower rank than yourself.");
}
