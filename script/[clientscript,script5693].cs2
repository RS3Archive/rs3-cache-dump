// 5693
[clientscript,script5693](int $int0, int $int1)
def_int $int2 = 0;
def_int $int3 = 0;
def_string $string0 = "Members only";
if (cc_find(skillguide:image_layer, $int0) = true) {
    if_setposition(cc_getx, cc_gety, ^setpos_abs_left, ^setpos_abs_top, skillguide:members_locked_tooltip);
    if ($int1 = 1) {
        $string0 = "Level up to unlock this item";
    }
    $int2 = calc(stringwidth($string0, museo_sans_11pt_regular) + 20);
    $int3 = calc(paraheight($string0, $int2, museo_sans_11pt_regular) * 15 + 10);
    if_setsize($int2, $int3, ^setsize_abs, ^setsize_abs, skillguide:members_locked_tooltip);
    if_settext($string0, skillguide:members_locked_tooltip_text);
    if_sethide(false, skillguide:members_locked_tooltip);
}
