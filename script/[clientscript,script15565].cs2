// 15565
[clientscript,script15565](component $component0, component $component1)
sound_vorbis_volume(tli_click_01, 1, 0, 100);
if (clientoption_get(^clientoption_volume_main_music) = 0) {
    if (%loginscreen_musicvol_last > 0 & %loginscreen_musicvol_last <= 255) {
        ~script15567($component0, $component1, scale(%loginscreen_musicvol_last, 255, if_getwidth($component0)), 23);
    } else {
        ~script15567($component0, $component1, 127, 23);
    }
} else {
    ~script15567($component0, $component1, 0, 23);
}
