// 18953
[clientscript,script18953](int $int0)
if ($int0 = 1) {
    if (clientoption_get(^clientoption_texturing) ! 0) {
        %accessibility_previous_texture_setting_id = clientoption_get(^clientoption_texturing);
        clientoption_set(^clientoption_texturing, 0);
        ~script15671;
    }
} else if (%accessibility_previous_texture_setting_id > 0) {
    clientoption_set(^clientoption_texturing, %accessibility_previous_texture_setting_id);
    ~script15671;
}
