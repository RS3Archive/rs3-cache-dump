// 9021
[proc,crs_fadein](component $component0, component $component1, component $component2, component $component3, boolean $boolean4, component $component5)
~fadein(50, $component0);
~fadein(50, $component1);
~fadein(50, $component2);
if ($boolean4 = true) {
    ~fadein(50, $component3);
}
cc_deleteall($component5);
