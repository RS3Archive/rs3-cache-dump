// 2735
[proc,script2735](int $int0)(seq)
def_seq $seq1 = mtx116_joker_walk_1h_sword;
def_obj $obj2 = inv_getobj(worn_display_preview, 3);
if ($obj2 ! null) {
    switch_struct (oc_param($obj2, weapon_category)) {
        case combatv2_weapon_dagger, combatv2_weapon_throwndart, combatv2_weapon_thrownknife, combatv2_weapon_thrownaxe, combatv2_weapon_javelin, combatv2_weapon_grenade, combatv2_weapon_fists, combatv2_weapon_claw :
            $seq1 = mtx116_joker_walk;
        case combatv2_weapon_shortsword, combatv2_weapon_longsword, combatv2_weapon_scimitar, combatv2_weapon_mace, combatv2_weapon_warhammer, combatv2_weapon_hatchet, combatv2_weapon_pickaxe, combatv2_weapon_battleaxe, combatv2_weapon_whip, combatv2_weapon_wand :
            $seq1 = mtx116_joker_walk_1h_sword;
        case combatv2_weapon_maul :
            $seq1 = mtx116_joker_walk_2h_maul;
        case combatv2_weapon_spear, combatv2_weapon_halberd, combatv2_weapon_2hsword :
            $seq1 = mtx116_joker_walk_2h_sword;
        case combatv2_weapon_2hxbow :
            $seq1 = mtx116_joker_walk_2h_crossbow;
        case combatv2_weapon_staff :
            $seq1 = mtx116_joker_walk_staff;
        case combatv2_weapon_bow, combatv2_weapon_chargebow :
            $seq1 = mtx116_joker_walk_bow;
        case default :
            $seq1 = mtx116_joker_walk_1h_sword;
    }
}
return($seq1);
