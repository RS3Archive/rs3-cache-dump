// 1989
[clientscript,town_vote](component $component0)
if (%town_has_voted > 0) {
    return;
}
if ($component0 = town_map_vote:vote_1) {
    %town_has_voted = 1;
    %town_votes_map1 = calc(%town_votes_map1 + 1);
} else {
    %town_has_voted = 2;
    %town_votes_map2 = calc(%town_votes_map2 + 1);
}
~town_vote_update;
