// 10162
[proc,script10162]
if (%varclientbit_44897 = 1) {
    if_setgraphic(btn_mobile_activetask, mobile_ribbon_left:activity_tracker_icon);
    if_setop(1, "Open", mobile_ribbon_left:activity_tracker_wrapper);
} else {
    if_setgraphic(btn_mobile_activetask_active, mobile_ribbon_left:activity_tracker_icon);
    if_setop(1, "Close", mobile_ribbon_left:activity_tracker_wrapper);
}
