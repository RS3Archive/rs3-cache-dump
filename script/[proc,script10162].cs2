    if_setgraphic(btn_mobile_activetask, interface_279:com_11);
    if_setop(1, "Open", interface_279:com_10);
} else {
    if_setgraphic(btn_mobile_activetask_active, interface_279:com_11);
    if_setop(1, "Close", interface_279:com_10);
