if_sethide(true, minigames_main:name_wrapper);
if_settext("Select an activity", minigames_main:job_name);
if_settext("Select an activity in the list to view its rewards.", minigames_main:reward_text);
if_settext("Select an activity in the list on the left to view its details.", minigames_main:job_desc);
if_settext("Select an activity to view hints.", minigames_main:job_step_1);
if_sethide(false, minigames_main:job_step_1);
if_settext("", minigames_main:job_step_2);
if_sethide(true, minigames_main:job_step_2);
if_settext("", minigames_main:job_step_3);
if_sethide(true, minigames_main:job_step_3);
if_settext("", minigames_main:job_step_4);
if_sethide(true, minigames_main:job_step_4);
if_settext("", minigames_main:job_step_5);
if_sethide(true, minigames_main:job_step_5);
if_settext("", minigames_main:job_step_6);
if_sethide(true, minigames_main:job_step_6);
if_settext("", minigames_main:job_step_7);
if_sethide(true, minigames_main:job_step_7);
if_settext("", minigames_main:job_step_8);
if_sethide(true, minigames_main:job_step_8);
if_sethide(true, minigames_main:accept_job_button);
if_sethide(true, minigames_main:take_me_there_button);
if_sethide(true, minigames_main:subscribe_layer);
if_sethide(true, minigames_main:switch_world_checkbox_main);
cc_deleteall(minigames_main:right_scroll);
