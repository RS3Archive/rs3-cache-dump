// 15836
[proc,script15836]
def_int $int0 = scale(if_getheight(options_firstrun:base), 9, 16);
if_setsize($int0, 0, ^setsize_abs, ^setsize_minus, options_firstrun:bg_layer);
if_setposition(0, 0, ^setpos_abs_centre, ^setpos_abs_top, options_firstrun:bg_layer);
if_setposition(0, 0, ^setpos_abs_left, ^setpos_abs_top, options_firstrun:bg_0);
if_setposition(if_getwidth(options_firstrun:bg_0), 0, ^setpos_abs_left, ^setpos_abs_top, options_firstrun:bg_1);
if_setposition(calc(if_getwidth(options_firstrun:bg_0) + if_getwidth(options_firstrun:bg_1)), 0, ^setpos_abs_left, ^setpos_abs_top, options_firstrun:bg_2);
def_int $int1 = if_getheight(options_firstrun:bg_0);
if_setposition(0, $int1, ^setpos_abs_left, ^setpos_abs_top, options_firstrun:bg_3);
if_setposition(if_getwidth(options_firstrun:bg_3), $int1, ^setpos_abs_left, ^setpos_abs_top, options_firstrun:bg_4);
if_setposition(calc(if_getwidth(options_firstrun:bg_3) + if_getwidth(options_firstrun:bg_4)), $int1, ^setpos_abs_left, ^setpos_abs_top, options_firstrun:bg_5);
$int1 = calc(if_gety(options_firstrun:bg_3) + if_getheight(options_firstrun:bg_3));
if_setposition(0, $int1, ^setpos_abs_left, ^setpos_abs_top, options_firstrun:bg_6);
if_setposition(if_getwidth(options_firstrun:bg_6), $int1, ^setpos_abs_left, ^setpos_abs_top, options_firstrun:bg_7);
if_setposition(calc(if_getwidth(options_firstrun:bg_6) + if_getwidth(options_firstrun:bg_7)), $int1, ^setpos_abs_left, ^setpos_abs_top, options_firstrun:bg_8);
if_setposition(0, 0, ^setpos_abs_left, ^setpos_abs_top, options_firstrun:progress_fg_l);
if_setposition(if_getwidth(options_firstrun:progress_fg_l), 0, ^setpos_abs_left, ^setpos_abs_top, options_firstrun:progress_fg_m);
if_setposition(calc(if_getwidth(options_firstrun:progress_fg_l) + if_getwidth(options_firstrun:progress_fg_m)), 0, ^setpos_abs_left, ^setpos_abs_top, options_firstrun:progress_fg_r);
