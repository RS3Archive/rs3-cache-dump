// 11059
[clientscript,script11059]
if (%boss_instance_setup_practicemode_temp = 1) {
    if_sethide(false, boss_instance:practicemode_checkbox_selected_layer);
    if_sethide(true, boss_instance:practicemode_checkbox_deselected_layer);
} else {
    if_sethide(true, boss_instance:practicemode_checkbox_selected_layer);
    if_sethide(false, boss_instance:practicemode_checkbox_deselected_layer);
}
