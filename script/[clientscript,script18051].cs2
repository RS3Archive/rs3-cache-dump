// 18051
[clientscript,script18051]
~script18052;
if (%bp3_mission_redraw_delay > 0) {
    %bp3_mission_redraw_delay = calc(%bp3_mission_redraw_delay - 1);
}
if (%bp3_mission_redraw_delay <= 0) {
    if_setontimer(null, bp3_missions_tab:redraw_listener);
    ~script18055;
} else {
    if_setontimer("script18051", bp3_missions_tab:redraw_listener);
}
