// 820
[clientscript,script820]
if (%lore_animal_hunger_percent ! 101) {
    if_settext("<tostring(%lore_animal_hunger_percent)>%", lore_cats_side:hunger);
    if (%lore_animal_hunger_percent > 74) {
        if_setcolour(^red, lore_cats_side:hunger);
    } else {
        if_setcolour(^white, lore_cats_side:hunger);
    }
} else {
    if_settext("NA", lore_cats_side:hunger);
}
if (%lore_animal_size_percent ! 101) {
    if_settext("<tostring(%lore_animal_size_percent)>%", lore_cats_side:size_percentage);
} else {
    if_settext("NA", lore_cats_side:size_percentage);
}
