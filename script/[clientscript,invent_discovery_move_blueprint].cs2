// 12147
[clientscript,invent_discovery_move_blueprint](component $component0, int $int1)
def_int $int2 = calc(if_gety($component0) - 5);
if ($int2 <= $int1) {
    $int2 = $int1;
    if_setontimer(null, $component0);
    if_sethide(false, invent_discovery:workbench_track_layer);
}
if_setposition(if_getx($component0), $int2, ^setpos_abs_left, ^setpos_abs_top, $component0);
