def_fontmetrics $fontmetrics1 = cinzel_18pt_bold_multiline;
if_settext($string0, $component0);
if (paraheight($string0, if_getwidth($component0), cinzel_18pt_bold_multiline) > 2) {
    $fontmetrics1 = cinzel_12pt_bold;
}
if_settextfont($fontmetrics1, $component0);
if_setcolour(~script10495(0), $component0);
