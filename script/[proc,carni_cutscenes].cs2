// 6320
[proc,carni_cutscenes](component $component0, coord $coord1)
if_setoncamfinished(null, $component0);
if_setontimer(null, $component0);
switch_int (%tutorial3_cutscene_tracker) {
    case default :
        cam_smoothreset;
    case 201 :
        cc_deleteall($component0);
        ~tutorial3_fadeout(^black, 50, $component0);
    case 202 :
        spline_new(0, 5);
        spline_new(1, 5);
        spline_addpoint(0, 0, ~carni_dungeon(11, 3, $coord1), 900, ~carni_dungeon(16, 3, $coord1), 900, 0);
