// 21135
[clientscript,script21135](int $int0, int $int1)
switch_int ($int1) {
    case 0, 4 :
    case 3, 6 :
        if ($int0 = %plugin_ribbon_plugin_open_id) {
            %plugin_ribbon_plugin_open_id = -1;
            ~script21137;
        }
    case default :
        return;
}
if (%plugin_api_child_redraw < clientclock) {
    ~script21244(1);
    ~script21139;
    %plugin_api_child_redraw = clientclock;
}
