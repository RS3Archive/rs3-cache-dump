// 1269
[clientscript,script1269](int $int0, int $int1, component $component2)
if (calc($int0 % 3000) = 0 & --$int1 <= 0) {
    if_setontimer(null, $component2);
    if_settext("", clock_wrapper:alert_text);
    if_settext("", toplevel_v2_minimap:alert_text);
    if ($component2 ! clock_wrapper:event_alert_layer) {
        if_sethide(true, $component2);
    }
    if ($component2 ! toplevel_v2_minimap:event_alert_layer) {
        if_sethide(true, $component2);
    }
    return;
}
if_setontimer("script1269(calc($int0 + 1), $int1, $component2)", $component2);
