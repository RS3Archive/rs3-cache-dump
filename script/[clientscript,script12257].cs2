// 12257
[clientscript,script12257](component $component0)
def_int $int1 = if_gettrans($component0);
if ($int1 < 255) {
    if_settrans(min(255, calc($int1 + 6)), $component0);
} else {
    if_sethide(false, quest_nomel_memories:memory_text2);
    if_setontimer("script12255(quest_nomel_memories:memory_text2)", quest_nomel_memories:memory_text2);
    if_sethide(true, quest_nomel_memories:memory_text1);
}
