// 15037
[proc,script15037]
switch_int (%varplayer_139) {
    case 0 :
        if_settext(~mobile_text_get(2), interface_105:com_140);
    case 1 :
        if_settext("Select an item in your inventory to sell.", interface_105:com_140);
    case default :
        if_settext("Loading...", interface_105:com_140);
}
if_settext("0", interface_105:com_215);
if_settext("Loading...", interface_105:com_147);
if_settext("Loading...", interface_105:com_150);
if_settext("0", interface_105:com_170);
if_settext("1", interface_105:com_185);
if_setontimer(null, interface_105:com_141);
if_settext("", interface_105:com_141);
