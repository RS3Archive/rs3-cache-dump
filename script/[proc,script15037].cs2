// 15037
[proc,script15037]
switch_int (%stock_offertype) {
    case 0 :
        if_settext(~mobile_text_get(2), stockmarket:offeritem_desc);
    case 1 :
        if_settext("Select an item in your inventory to sell.", stockmarket:offeritem_desc);
    case default :
        if_settext("Loading...", stockmarket:offeritem_desc);
}
if_settext("0", stockmarket:totalvalue);
if_settext("N/A", stockmarket:offeritem_marketprice);
if_settext("0", stockmarket:quantity_input_display);
if_settext("1", stockmarket:price_input_display);
