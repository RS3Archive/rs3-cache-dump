// 110
[clientscript,meslayer_mode9](string $string0)
if_sethide(false, meslayer:root);
if_settext($string0, meslayer:mes_text);
%meslayermode = 9;
if (compare(null, %stringdialog_init_string) = 0) {
    %stringdialog_init_string = "";
}
if (compare("", %stringdialog_init_string) ! 0) {
    ~meslayer_setupinput(%stringdialog_init_string);
    %stringdialog_init_string = "";
} else {
    ~meslayer_setupinput("");
}
if (compare(null, %stringdialog_suggested_string) = 0) {
    %stringdialog_suggested_string = "";
}
if_setonclick(null, meslayer:mes_layer);
~script2026;
if (compare(%stringdialog_suggested_string, "") ! 0) {
    cc_create(meslayer:mes_layer, ^iftype_text, 0);
    ~meslayer_setupdynamicbutton;
    cc_settext("Last entered: <%stringdialog_suggested_string>");
    cc_setop(1, "Use:");
    cc_setopbase("<col=ff9040><removetags(%stringdialog_suggested_string)></col>");
    cc_setonop("meslayer_lastname(%meslayermode, event_op, event_com, event_comsubid, %stringdialog_suggested_string)");
    %stringdialog_suggested_string = "";
}
