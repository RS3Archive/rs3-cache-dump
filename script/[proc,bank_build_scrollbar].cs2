// 13828
[proc,bank_build_scrollbar](int $int0)
def_int $int1 = if_getheight(bank:bank_items_container);
if_setscrollsize(0, max($int0, $int1), bank:bank_items_container);
if_setscrollpos(0, ~bank_get_tab_scrollpos(%bank_current_tab), bank:bank_items_container);
if ($int0 > $int1) {
    ~scrollbar_resize(bank:scrollbar, bank:bank_items_container, if_getscrolly(bank:bank_items_container));
} else {
    ~scrollbar_resize(bank:scrollbar, bank:bank_items_container, 0);
}
~scrollbar_ondrag_doscroll(bank:scrollbar, bank:bank_items_container, if_getscrolly(bank:bank_items_container), 1);
%bank_last_scrollheight = $int0;
