// 6079
[clientscript,shop_filter_button](component $component0, int $int1)
def_int $int2 = %shop_verbose_mode;
if ($component0 = shop_main:compact_mode) {
    $int2 = calc((%shop_verbose_mode + 1) % 2);
}
if ($int1 = 1) {
    if ($component0 = shop_main:verbose_mode) {
        if ($int2 = 1) {
            if_setgraphic("aif_shop_display_mode_icon,3", $component0);
        } else {
            if_setgraphic("aif_shop_display_mode_icon,3", $component0);
        }
    } else if ($component0 = shop_main:compact_mode) {
        if ($int2 = 1) {
            if_setgraphic("aif_shop_display_mode_icon,1", $component0);
        } else {
            if_setgraphic("aif_shop_display_mode_icon,1", $component0);
        }
    }
} else {
    ~deltooltip_action(shop_main:tooltip_layer);
    if ($component0 = shop_main:verbose_mode) {
        if ($int2 = 1) {
            if_setgraphic("aif_shop_display_mode_icon,3", $component0);
        } else {
            if_setgraphic("aif_shop_display_mode_icon,2", $component0);
        }
    } else if ($component0 = shop_main:compact_mode) {
        if ($int2 = 1) {
            if_setgraphic("aif_shop_display_mode_icon,1", $component0);
        } else {
            if_setgraphic("aif_shop_display_mode_icon,0", $component0);
        }
    }
}
