// 432
[clientscript,script432](component $component0)
def_struct $struct1 = null;
switch_component ($component0) {
    case default :
        return;
    case conq_side_command:ability_layer_1 :
        if (%conq_in_tutorial = 1) {
            $struct1 = conq_command_battle_cry;
        } else {
            $struct1 = ~script488(%conq_command_ability_1);
        }
    case conq_side_command:ability_layer_2 :
        if (%conq_in_tutorial = 1) {
            $struct1 = conq_command_regenerate;
        } else {
            $struct1 = ~script488(%conq_command_ability_2);
        }
    case conq_side_command:ability_layer_3 :
        if (%conq_in_tutorial = 1) {
            $struct1 = conq_command_bloodlust;
        } else {
            $struct1 = ~script488(%conq_command_ability_3);
        }
    case conq_side_command:ability_layer_4 :
        if (%conq_in_tutorial = 1) {
            $struct1 = conq_command_chastise;
        } else {
            $struct1 = ~script488(%conq_command_ability_4);
        }
}
if ($struct1 ! null) {
    ~script3877("<struct_param($struct1, conq_command_name)><br><struct_param($struct1, conq_command_desc)><br>Cost: <tostring(struct_param($struct1, conq_command_cost))><br>Cooldown: <tostring(struct_param($struct1, conq_command_cooldown))>", $component0, -1);
} else {
    ~script8808;
}
