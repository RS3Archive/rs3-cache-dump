// 19262
[clientscript,trh175_chest_mouseover](component $component0)
if_setmodelanim(trh_chest_selected_pumpkin, $component0);
switch_int (random(5)) {
    case 0 :
        sound_vorbis_rate(pumpkin_emote_catch_01, 1, 0, 100, random_sound_pitch(20, 20));
    case 1 :
        sound_vorbis_rate(pumpkin_emote_catch_02, 1, 0, 100, random_sound_pitch(20, 20));
    case 2 :
        sound_vorbis_rate(pumpkin_emote_catch_03, 1, 0, 100, random_sound_pitch(20, 20));
    case 3 :
        sound_vorbis_rate(pumpkin_emote_catch_04, 1, 0, 100, random_sound_pitch(20, 20));
    case 4 :
        sound_vorbis_rate(pumpkin_emote_catch_05, 1, 0, 100, random_sound_pitch(20, 20));
}
