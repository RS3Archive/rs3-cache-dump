    case 1 :
        sound_vorbis_rate(sound_52110, 1, 0, 100, random_sound_pitch(20, 20));
    case 2 :
        sound_vorbis_rate(sound_52111, 1, 0, 100, random_sound_pitch(20, 20));
    case 3 :
        sound_vorbis_rate(sound_52112, 1, 0, 100, random_sound_pitch(20, 20));
    case 4 :
        sound_vorbis_rate(sound_52113, 1, 0, 100, random_sound_pitch(20, 20));
}
