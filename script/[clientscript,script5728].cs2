// 5728
[clientscript,script5728](component $component0)
switch_component ($component0) {
    case omge_hooks_staff_interface:air_button :
        if_setgraphic("aif_wickhood_button_1,1", omge_hooks_staff_interface:air_selected);
        if_setgraphic("aif_wicked_hood_disable_rune_icon,2", omge_hooks_staff_interface:wind_rune);
    case omge_hooks_staff_interface:water_button :
        if_setgraphic("aif_wickhood_button_1,1", omge_hooks_staff_interface:water_selected);
        if_setgraphic("aif_wicked_hood_disable_rune_icon,1", omge_hooks_staff_interface:water_rune);
    case omge_hooks_staff_interface:earth_button :
        if_setgraphic("aif_wickhood_button_1,1", omge_hooks_staff_interface:earth_selected);
        if_setgraphic("aif_wicked_hood_disable_rune_icon,3", omge_hooks_staff_interface:earth_rune);
    case omge_hooks_staff_interface:fire_button :
        if_setgraphic("aif_wickhood_button_1,1", omge_hooks_staff_interface:fire_selected);
        if_setgraphic("aif_wicked_hood_disable_rune_icon,0", omge_hooks_staff_interface:fire_rune);
}
