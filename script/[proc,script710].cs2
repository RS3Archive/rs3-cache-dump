// 710
[proc,script710]
if (~script1038(owen1_saradomin_torso) = 1 & ~script1038(owen1_saradomin_legs) = 1 & ~script1038(owen1_saradomin_head) = 1 & ~script1038(owen1_saradomin_boots) = 1 & ~script1038(owen1_saradomin_hands) = 1) {
    if_settext("Done", owen1_reward_shop:aif_bronze_button_text);
    ~script4211(owen1_reward_shop:aif_bronze_button_text, museo_sans_13pt_regular, 0xefb063, 3156001);
    if_setop(1, "Close", owen1_reward_shop:claim_all_button);
}
