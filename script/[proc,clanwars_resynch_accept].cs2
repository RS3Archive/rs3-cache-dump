// 1782
[proc,clanwars_resynch_accept]
if (%clanwars_challengeuid ! null) {
    ~script1801;
    if (%clanwars_rulevarc_accept = false) {
        if (%clanwars_rulevarc_opponentaccept = false) {
            ~script13993(clanwars_setup:accept_button, null, rs3tli_3x3_button, "Accept");
        } else {
            ~script13993(clanwars_setup:accept_button, null, rs3tli_3x3_button, "Accept -<br>Opponent accepted.");
        }
    } else {
        ~script13993(clanwars_setup:accept_button, null, rs3tli_3x3_button, "Waiting for opponent...");
    }
} else {
    ~script1802;
}
