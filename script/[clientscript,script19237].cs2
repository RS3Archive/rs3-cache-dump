if_settext("<col=<tostring($int1, 16)>>Harvest Hollow</col><br><col=<tostring($int0, 16)>>- Head to the Horseman's camp in <col=<tostring($int1, 16)>>Harvest Hollow</col> <col=<tostring($int0, 16)>>to tackle a variety of activities:</col><br><col=<tostring($int0, 16)>>- Train your <col=<tostring($int1, 16)>>Archaeology, Farming, Firemaking, Prayer, Summoning</col> <col=<tostring($int0, 16)>>and</col> <col=<tostring($int1, 16)>>Thieving</col> <col=<tostring($int0, 16)>>skills in the graveyard.</col><br><col=<tostring($int0, 16)>>- Become an honorary member of <col=<tostring($int1, 16)>>The Horsemen</col> <col=<tostring($int0, 16)>>and join one of their five teams in the quest,</col> <col=<tostring($int1, 16)>>'Field of Screams'</col><col=<tostring($int0, 16)>>.</col><br><col=<tostring($int0, 16)>>- Bring some <col=<tostring($int1, 16)>>bonfire night</col> <col=<tostring($int0, 16)>>and</col> <col=<tostring($int1, 16)>>harvest festival</col> <col=<tostring($int0, 16)>>vibes to</col> <col=<tostring($int1, 16)>>Harvest Hollow</col> <col=<tostring($int0, 16)>>in the quest,</col> <col=<tostring($int1, 16)>>'Guys and Dolls'</col><col=<tostring($int0, 16)>>.</col><br><col=<tostring($int0, 16)>>- Find your way to the centre of the <col=<tostring($int1, 16)>>Maize Maze</col> <col=<tostring($int0, 16)>>to fight spooky bosses and earn rewards.</col><br><col=<tostring($int0, 16)>>- Visit</col> <col=<tostring($int1, 16)>>Reynold's Harvest Boon</col> <col=<tostring($int0, 16)>>shop to spend your</col> <col=<tostring($int1, 16)>>Spooky tokens</col> <col=<tostring($int0, 16)>>on new and returning rewards!</col>", halloween24:event_info_text);
if_settext("<col=<tostring($int1, 16)>>New Miniquest</col><br><col=<tostring($int0, 16)>>- Speak to <col=<tostring($int1, 16)>>Death</col> <col=<tostring($int0, 16)>>to begin and get your very own</col> <col=<tostring($int1, 16)>>Trick or Treat bowl</col><col=<tostring($int0, 16)>>.</col><br><br><col=<tostring($int1, 16)>>Trick or Treating</col><br><col=<tostring($int0, 16)>>- Once per day you can get a <col=<tostring($int1, 16)>>Trick or treat bag</col> <col=<tostring($int0, 16)>>from your</col> <col=<tostring($int1, 16)>>Trick or treat bowl</col><col=<tostring($int0, 16)>>.</col><br><col=<tostring($int0, 16)>>- Take that bag to a friend's house and use it on their <col=<tostring($int1, 16)>>Trick or treat bowl</col> <col=<tostring($int0, 16)>>to fill it with goodies!</col><br><br><col=<tostring($int1, 16)>>Horseclan Confections</col><br><col=<tostring($int0, 16)>>- Once per day you can gain <col=<tostring($int1, 16)>>Horseclan confections</col> <col=<tostring($int0, 16)>>from skilling and</col> <col=<tostring($int1, 16)>>Trick or treating</col><col=<tostring($int0, 16)>>.</col><br><col=<tostring($int0, 16)>>- These can be used to vote in the <col=<tostring($int1, 16)>>Horseclan Competition</col><col=<tostring($int0, 16)>>.</col><br><col=<tostring($int0, 16)>>- New rewards available weekly from the <col=<tostring($int1, 16)>>Horseclan Ceremony</col> <col=<tostring($int0, 16)>>on Sundays.</col>", halloween24:event_new_info_text);
