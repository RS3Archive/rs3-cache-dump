// 16406
[proc,script16406](component $component0)
def_int $int1 = 0;
switch_component ($component0) {
    case uitutorial:arrow_below :
        $int1 = 1;
    case uitutorial:arrow_above :
        $int1 = 2;
    case uitutorial:arrow_right :
        $int1 = 4;
    case uitutorial:arrow_left :
        $int1 = 3;
}
if (%uitutorial_built_direction = 0) {
    %uitutorial_built_direction = $int1;
}
