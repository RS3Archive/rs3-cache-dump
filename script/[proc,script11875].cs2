// 11875
[proc,script11875](int $int0)(stat, stat)
switch_int ($int0) {
    case 0 :
        return(mining, farming);
    case 1 :
        return(woodcutting, herblore);
    case 2 :
        return(prayer, construction);
    case 3 :
        return(runecraft, divination);
    case 4 :
        return(strength, thieving);
}
return(null, null);
