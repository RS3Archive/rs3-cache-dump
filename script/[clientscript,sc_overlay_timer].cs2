// 1941
[clientscript,sc_overlay_timer]
def_int $int0 = calc(%varplayer_1596 + %varplayer_1598 + %varplayer_1601 + 2 * (%varplayer_1597 - %varplayer_1599));
if_settext("Score: <tostring($int0)>", interface_809:com_5);
if (%varclient_556 = 0) {
    return;
}
def_int $int1 = calc(%varclient_556 - clientclock);
def_int $int2 = calc($int1 / 3000);
def_int $int3 = calc($int1 / 50 % 60);
if ($int2 < 0 | $int3 < 0) {
    if_settext("Game ending", interface_809:com_3);
    if_settextshadow(true, interface_809:com_3);
    ~script1942;
} else if ($int2 = 0 & $int3 = 0) {
