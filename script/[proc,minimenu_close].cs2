// 14228
[proc,minimenu_close]
~script3350;
cc_deleteall(minimenu:menu_build_layer);
cc_deleteall(minimenu:menu_scroll_bar_layer);
cc_deleteall(minimenu:menu_background_layer);
cc_deleteall(minimenu:submenu_build_layer);
cc_deleteall(minimenu:submenu_background_layer);
if_setsize(0, 0, ^setsize_abs, ^setsize_abs, minimenu:universe_layer);
if_setposition(0, 0, ^setpos_abs_left, ^setpos_abs_top, minimenu:universe_layer);
if_setscrollpos(0, 0, minimenu:menu_build_layer);
if_sethide(true, minimenu:clickout_and_blocking_layer);
if_sethide(true, minimenu:menu_blocking_layer);
if_sethide(true, minimenu:submenu_blocking_layer);
if_sethide(true, minimenu:pc_mouse_leave_layer);
if_sethide(true, minimenu:menu_scroll_down_layer);
if_sethide(true, minimenu:menu_scroll_up_layer);
if (~script6431 = true) {
    if_setonrelease(null, ~minimenu_get_root);
    unknown_command_26(false);
}
