// 2
[proc,script2](obj $obj0)(obj)
switch_obj ($obj0) {
    case trh191_musketeer_head_token :
        if (~script10881(trh191_musketeer_outfit_head) = 0) {
            $obj0 = trh191_musketeer_direct_unlock_head;
        }
    case trh191_musketeer_body_hands_token :
        if (~script10881(trh191_musketeer_outfit_body) = 0) {
            $obj0 = trh191_musketeer_direct_unlock_body_hands;
        }
    case trh191_musketeer_legs_feet_token :
        if (~script10881(trh191_musketeer_outfit_legs) = 0) {
            $obj0 = trh191_musketeer_direct_unlock_legs_feet;
        }
    case trh191_musketeer_wand_orb_token :
        if (~script10881(trh191_musketeer_wand) = 0) {
            $obj0 = trh191_musketeer_direct_unlock_wand_orb;
        }
}
return($obj0);
