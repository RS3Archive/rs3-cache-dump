// 11418
[clientscript,script11418]
if (%combatv2_poisoned > 0 | %gwd2_sliske_boss_show_poison = 1) {
    ~script10624(combatv2_poisoned_dummy_ability, 1);
    ~script10624(combatv2_anti_poison_dummy_ability, 0);
} else if (%combatv2_poisoned < 0) {
    ~script10624(combatv2_poisoned_dummy_ability, 0);
    ~script10624(combatv2_anti_poison_dummy_ability, 1);
} else {
    ~script10624(combatv2_poisoned_dummy_ability, 0);
    ~script10624(combatv2_anti_poison_dummy_ability, 0);
}
