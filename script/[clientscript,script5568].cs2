// 5568
[clientscript,script5568](component $component0)
switch_int (%unmorph_icon_varc) {
    case default :
        if_setgraphic(null, $component0);
    case 1 :
        if_setgraphic("unmorph_icons,0", $component0);
    case 2 :
        if_setgraphic("unmorph_icons,1", $component0);
    case 3 :
        if_setgraphic("unmorph_icons,2", $component0);
    case 4 :
        if_setgraphic("unmorph_icons,4", $component0);
    case 5 :
        if_setgraphic("unmorph_icons,5", $component0);
    case 6 :
        if_setgraphic("unmorph_icons,6", $component0);
    case 7 :
        if_setgraphic("unmorph_icons,7", $component0);
}
