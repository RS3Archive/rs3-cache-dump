// 5068
[proc,script5068](string $string0, int $int0)(int)
cc_create(clan_field_editor:details, ^iftype_text, if_getnextsubid(clan_field_editor:details));
cc_settextfont(p11_full);
cc_settextalign(^settextalign_left, ^settextalign_centre, 0);
cc_setcolour(0xdfcfbf);
def_int $int1 = calc(paraheight($string0, if_getwidth(clan_field_editor:details), p11_full) * 10 + 2);
cc_setsize(0, $int1, ^setsize_minus, ^setsize_abs);
cc_settext($string0);
cc_setposition(0, $int0, ^setpos_abs_centre, ^setpos_abs_top);
return($int1);
