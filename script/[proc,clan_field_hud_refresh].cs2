// 5092
[proc,clan_field_hud_refresh]
cc_deleteall(clan_field_hud:info);
def_string $string0 = "";
def_string $string1 = "";
def_string $string2 = "";
def_string $string3 = "";
def_string $string4 = "";
def_string $string5 = "";
def_string $string6 = "";
def_string $string7 = "";
def_int $int0 = 0;
def_int $int1 = 0;
def_int $int2 = 0;
def_int $int3 = 0;
def_int $int4 = 0;
def_int $int5 = 0;
def_int $int6 = 0;
def_int $int7 = 0;
def_int $int8 = 0;
if (%clan_field_team ! 3) {
    if (%clan_field_rules_enableteams > 0) {
        $string0 = "<br>Members:<br>Score:";
        $string3 = $string0;
        $string1 = "<br><tostring_localised(calc(%pvpwild_logout & 1023), true)>";
        $string4 = "<br><tostring_localised(calc(%pvpwild_logout / pow(2, 10) & 1023), true)>";
        $string1 = "<$string1><br><tostring_localised(calc(%pvpwild_potential & 65535), true)>";
        $int8 = calc(%pvpwild_potential / pow(2, 16));
        if ($int8 < 0) {
            $int8 = calc(pow(2, 16) + $int8);
        }
        $string4 = "<$string4><br><tostring_localised($int8, true)>";
        $int8 = enum(int, int, clan_field_rules_endcondition_points, %clan_field_rules_endcondition_teampoints);
        if ($int8 < ^max_32bit_int) {
            $string1 = "<$string1> / <tostring_localised($int8, true)>";
            $string4 = "<$string4> / <tostring_localised($int8, true)>";
        }
        if (%clan_field_rules_enableteams < 2) {
            $string6 = "<br><br><br>Neutral players:";
            $string7 = "<br><br><br><tostring_localised(calc(%pvpwild_logout / pow(2, 20)), true)>";
        } else {
            $string6, $string7 = "<br><br><br>", "<br><br><br>";
        }
        if (%clan_field_team = 1) {
            $string2, $string5 = "Your team:", "Blue team:";
        } else if (%clan_field_team = 2) {
            $string2, $string5 = "Red team:", "Your team:";
        } else {
            $string2, $string5 = "Red team:", "Blue team:";
            if (%clan_field_rules_enableteams < 2) {
                $string6 = "<$string6><br>Your score:";
                $string7 = "<$string7><br><tostring_localised(%clan_field_points, true)>";
                $int8 = enum(int, int, clan_field_rules_endcondition_points, %clan_field_rules_endcondition_playerpoints);
                if ($int8 < ^max_32bit_int) {
                    $string7 = "<$string7> / <tostring_localised($int8, true)>";
                }
            }
        }
    } else {
        $string6, $string7 = "Score:", tostring_localised(%clan_field_points, true);
    }
    $int8 = enum(int, int, clan_field_rules_pointsforkilling_int, %clan_field_rules_pointsforkilling);
    if ($int8 ! 0) {
        $string6 = "<$string6><br>Reward for pking:";
        if ($int8 > 0) {
            $string7 = "<$string7><br><tostring($int8)>";
        } else {
            $string7 = "<$string7><br>A key";
        }
    }
    if (%pvpwild_safety < 0) {
        $string6 = "<$string6><br>Scoring begins in:";
        if (%pvpwild_safety <= ^min_32bit_int) {
            $string7 = "<$string7><br>-";
        } else {
            $int6 = calc(0 - %pvpwild_safety);
        }
    }
    if (%clan_field_rules_endcondition_timelimit > 0 & %pvpwild_safety > 0) {
        $string6 = "<$string6><br>Time remaining:";
        $int6 = %pvpwild_safety;
    }
    $int5 = calc(paraheight($string6, ^max_32bit_int, p11_full) * 10 + 2);
    $int0 = calc(parawidth($string0, ^max_32bit_int, p11_full) + 3 + parawidth($string1, ^max_32bit_int, p11_full));
    $int0 = max($int0, parawidth($string2, ^max_32bit_int, p11_full));
    $int1 = calc(parawidth($string3, ^max_32bit_int, p11_full) + 3 + parawidth($string4, ^max_32bit_int, p11_full));
    $int1 = max($int1, parawidth($string5, ^max_32bit_int, p11_full));
    $int3 = calc(parawidth($string6, ^max_32bit_int, p11_full) + 3 + max(parawidth($string7, ^max_32bit_int, p11_full), 40));
    $int2 = calc($int0 + 5 + $int1);
    $int4 = max($int3, $int2);
    $int2 = calc(($int4 - $int2) / 2);
    $int0, $int1 = calc($int0 + $int2), calc($int1 + $int2);
    if_setsize(calc($int4 + 8), calc($int5 + 8), ^setsize_abs, ^setsize_abs, clan_field_hud:info_area);
    cc_create(clan_field_hud:info, ^iftype_text, if_getnextsubid(clan_field_hud:info));
    .cc_create(clan_field_hud:info, ^iftype_text, if_getnextsubid(clan_field_hud:info));
    cc_setsize($int0, 0, ^setsize_abs, ^setsize_minus);
    .cc_setsize($int0, 0, ^setsize_abs, ^setsize_minus);
    cc_setposition(0, 0, ^setpos_abs_left, ^setpos_abs_centre);
    .cc_setposition(0, 0, ^setpos_abs_left, ^setpos_abs_centre);
    cc_settextfont(p11_full);
    .cc_settextfont(p11_full);
    cc_settextshadow(true);
    .cc_settextshadow(true);
    cc_settextalign(^settextalign_left, ^settextalign_top, 0);
    .cc_settextalign(^settextalign_right, ^settextalign_top, 0);
    cc_setcolour(^red);
    .cc_setcolour(^red);
    cc_settext($string0);
    .cc_settext($string1);
    cc_create(clan_field_hud:info, ^iftype_text, if_getnextsubid(clan_field_hud:info));
    cc_setsize($int0, 0, ^setsize_abs, ^setsize_minus);
    cc_setposition(0, 0, ^setpos_abs_left, ^setpos_abs_centre);
    cc_settextfont(p11_full);
    cc_settextshadow(true);
    cc_settextalign(^settextalign_centre, ^settextalign_top, 0);
    cc_setcolour(^red);
    cc_settext($string2);
    cc_create(clan_field_hud:info, ^iftype_text, if_getnextsubid(clan_field_hud:info));
    .cc_create(clan_field_hud:info, ^iftype_text, if_getnextsubid(clan_field_hud:info));
    cc_setsize($int1, 0, ^setsize_abs, ^setsize_minus);
    .cc_setsize($int1, 0, ^setsize_abs, ^setsize_minus);
    cc_setposition(0, 0, ^setpos_abs_right, ^setpos_abs_centre);
    .cc_setposition(0, 0, ^setpos_abs_right, ^setpos_abs_centre);
    cc_settextfont(p11_full);
    .cc_settextfont(p11_full);
    cc_settextshadow(true);
    .cc_settextshadow(true);
    cc_settextalign(^settextalign_left, ^settextalign_top, 0);
    .cc_settextalign(^settextalign_right, ^settextalign_top, 0);
    cc_setcolour(0x7f7fff);
    .cc_setcolour(0x7f7fff);
    cc_settext($string3);
    .cc_settext($string4);
    cc_create(clan_field_hud:info, ^iftype_text, if_getnextsubid(clan_field_hud:info));
    cc_setsize($int1, 0, ^setsize_abs, ^setsize_minus);
    cc_setposition(0, 0, ^setpos_abs_right, ^setpos_abs_centre);
    cc_settextfont(p11_full);
    cc_settextshadow(true);
    cc_settextalign(^settextalign_centre, ^settextalign_top, 0);
    cc_setcolour(0x7f7fff);
    cc_settext($string5);
    if (string_length($string0) > 0) {
        cc_create(clan_field_hud:info, ^iftype_line, if_getnextsubid(clan_field_hud:info));
        .cc_create(clan_field_hud:info, ^iftype_line, if_getnextsubid(clan_field_hud:info));
        cc_setsize(0, 27, ^setsize_abs, ^setsize_abs);
        .cc_setsize(0, 27, ^setsize_abs, ^setsize_abs);
        cc_setposition(calc($int0 + 2), 3, ^setpos_abs_left, ^setpos_abs_top);
        .cc_setposition(calc(cc_getx + 1), calc(cc_gety + 1), ^setpos_abs_left, ^setpos_abs_top);
        cc_setcolour(0x7f7f7f);
        .cc_setcolour(0x3f3f3f);
    }
    cc_create(clan_field_hud:info, ^iftype_text, if_getnextsubid(clan_field_hud:info));
    .cc_create(clan_field_hud:info, ^iftype_text, if_getnextsubid(clan_field_hud:info));
    cc_setsize($int3, 0, ^setsize_abs, ^setsize_minus);
    .cc_setsize($int3, 0, ^setsize_abs, ^setsize_minus);
    cc_setposition(0, 0, ^setpos_abs_centre, ^setpos_abs_centre);
    .cc_setposition(0, 0, ^setpos_abs_centre, ^setpos_abs_centre);
    cc_settextfont(p11_full);
    .cc_settextfont(p11_full);
    cc_settextshadow(true);
    .cc_settextshadow(true);
    cc_settextalign(^settextalign_left, ^settextalign_top, 0);
    .cc_settextalign(^settextalign_right, ^settextalign_top, 0);
    cc_setcolour(0xcfcfcf);
    .cc_setcolour(0xcfcfcf);
    cc_settext($string6);
    .cc_settext($string7);
    if ($int6 > 0) {
        cc_create(clan_field_hud:info, ^iftype_text, if_getnextsubid(clan_field_hud:info));
        cc_setsize($int3, 12, ^setsize_abs, ^setsize_abs);
        cc_setposition(calc(max(calc($int4 - $int3), 0) / 2), 0, ^setpos_abs_right, ^setpos_abs_bottom);
        cc_settextfont(p11_full);
        cc_settextshadow(true);
        cc_settextalign(^settextalign_right, ^settextalign_top, 0);
        cc_setcolour(0xcfcfcf);
        $int7 = calc($int6 * 30);
        if ($int7 > %worldswitcher_pingtimer | calc($int7 + 29) < %worldswitcher_pingtimer) {
            %worldswitcher_pingtimer = calc($int7 + 15);
        }
        cc_settext(~script5094);
        cc_setontimer("script5093(event_com, event_comsubid)");
    }
}
