// 1747
[clientscript,brew_boiler2](component $component0, component $component1)
if (%brew_varc_boiler2 > 2) {
    if_setmodel(game_brew_if_boiler2_on, $component0);
    if_setcolour(0x33ff00, $component1);
} else {
    if_setmodel(game_brew_if_boiler2_off, $component0);
    if_setcolour(0x910000, $component1);
}
if_settext(tostring(%brew_varc_boiler2), $component1);
