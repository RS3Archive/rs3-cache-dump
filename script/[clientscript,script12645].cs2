// 12645
[clientscript,script12645](component $component0)
if ($component0 = null) {
    return;
}
cc_deleteall($component0);
def_int $int1 = -1;
while (++$int1 <= 32) {
    cc_create($component0, ^iftype_text, $int1);
    if (string_length(enum(int, string, telemetry_subcategory_skill, $int1)) ! 0) {
        cc_setposition(0, 0, ^setpos_abs_left, ^setpos_abs_top);
        cc_setsize(1, 27, ^setsize_abs, ^setsize_abs);
        cc_settextfont(museo_sans_11pt_regular);
        cc_settextalign(^settextalign_right, ^settextalign_centre, 0);
        cc_settextshadow(true);
        cc_setcolour(^white);
        cc_setparam(rs3tli_component_target_transparency, 255);
        cc_setparam(rs3tli_component_transparency_step, 5);
        cc_setparam(rs3tli_component_transparency_type, 3);
        cc_setontimer("script12648(event_com, event_comsubid)");
    }
    cc_settrans(255);
    cc_sethide(true);
}
