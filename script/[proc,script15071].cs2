// 15071
[proc,script15071](int $int0)
if ($int0 = %runepass_task_sets_completed) {
    if (~script8229(9, 0) > -1) {
        if_setop(2, "Untrack", runepass:task_a_info);
        if_setgraphic("achievement_icon_pinned_14px,0", runepass:task_a_track_button);
    } else {
        if_setop(2, "Track", runepass:task_a_info);
        if_setgraphic("achievement_icon_pin_14px,0", runepass:task_a_track_button);
    }
    if (~script8229(9, 1) > -1) {
        if_setop(2, "Untrack", runepass:task_b_info);
        if_setgraphic("achievement_icon_pinned_14px,0", runepass:task_b_track_button);
    } else {
        if_setop(2, "Track", runepass:task_b_info);
        if_setgraphic("achievement_icon_pin_14px,0", runepass:task_b_track_button);
    }
} else {
    if_setop(2, "", runepass:task_a_info);
    if_setop(2, "", runepass:task_b_info);
}
