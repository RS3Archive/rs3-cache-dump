// 15385
[clientscript,tut6_controls_timer](int $int0, component $component1)
if ($int0 = 50) {
    if (%tut6_controls_how_many_pages > 1) {
        ~tut6_controls_fade(2, %tut6_controls_page);
    }
} else if ($int0 = calc(50 + 50)) {
    ~tut6_controls_populate(calc(%tut6_controls_page + 1));
    if (%tut6_controls_how_many_pages > 1) {
        ~tut6_controls_fade(1, %tut6_controls_page);
    }
} else if ($int0 = calc(50 + 50 + 400)) {
    $int0 = -1;
}
$int0 = calc($int0 + 1);
if_setontimer("tut6_controls_timer($int0, $component1)", $component1);
