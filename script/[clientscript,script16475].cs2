// 16475
[clientscript,script16475]
switch_int (%trh_prize_rar_cat_1) {
    case 1, 2 :
        if_setmodel(object_astral_star_prismatic_medium, trh174_overlay:option_1_model);
        if_settext("Medium prismatic star", trh174_overlay:option_1_title);
        if_setcolour(^yellow, trh174_overlay:portal_1a);
        if_setcolour(^yellow, trh174_overlay:portal_1b);
    case 3 :
        if_setmodel(object_astral_star_prismatic_large, trh174_overlay:option_1_model);
        if_settext("Large prismatic star", trh174_overlay:option_1_title);
        if_setcolour(0xff6600, trh174_overlay:portal_1a);
        if_setcolour(0xff6600, trh174_overlay:portal_1b);
    case 4 :
        if_setmodel(object_astral_star_prismatic_huge, trh174_overlay:option_1_model);
        if_settext("Huge prismatic star", trh174_overlay:option_1_title);
        if_setcolour(^red, trh174_overlay:portal_1a);
        if_setcolour(^red, trh174_overlay:portal_1b);
    case 5 :
        if_setmodel(object_astral_star_prismatic_giant, trh174_overlay:option_1_model);
        if_settext("Giant prismatic star", trh174_overlay:option_1_title);
        if_setcolour(0xb32ab6, trh174_overlay:portal_1a);
        if_setcolour(0xb32ab6, trh174_overlay:portal_1b);
}
switch_int (%trh_prize_rar_cat_2) {
    case 1, 2 :
        if_setmodel(object_container_lamp_prismatic_medium, trh174_overlay:option_2_model);
        if_settext("Medium prismatic lamp", trh174_overlay:option_2_title);
        if_setcolour(^yellow, trh174_overlay:portal_2a);
        if_setcolour(^yellow, trh174_overlay:portal_2b);
    case 3 :
        if_setmodel(object_container_lamp_prismatic_large, trh174_overlay:option_2_model);
        if_settext("Large prismatic lamp", trh174_overlay:option_2_title);
        if_setcolour(0xff6600, trh174_overlay:portal_2a);
        if_setcolour(0xff6600, trh174_overlay:portal_2b);
    case 4 :
        if_setmodel(object_container_lamp_prismatic_huge, trh174_overlay:option_2_model);
        if_settext("Huge prismatic lamp", trh174_overlay:option_2_title);
        if_setcolour(^red, trh174_overlay:portal_2a);
        if_setcolour(^red, trh174_overlay:portal_2b);
    case 5 :
        if_setmodel(object_container_lamp_prismatic_giant, trh174_overlay:option_2_model);
        if_settext("Giant prismatic lamp", trh174_overlay:option_2_title);
        if_setcolour(0xb32ab6, trh174_overlay:portal_2a);
        if_setcolour(0xb32ab6, trh174_overlay:portal_2b);
}
