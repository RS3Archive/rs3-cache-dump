// 10520
[proc,script10520](component $component0)
switch_int (%p_dialog_mode) {
    case 9 :
        switch_component ($component0) {
            case text_input_dialog:text_input_listen :
                if_sethide(false, text_input_dialog:input_confirm_instructions);
            case bonds_namechange_change:text_input_listen :
                ~script9854;
            case player_inspect_settings:text_input_listen :
                ~script10788;
            case investigate:text_input_listen :
                if_sethide(false, investigate:input_confirm_instructions);
        }
    case 7 :
        switch_component ($component0) {
            case trh30_select_credit:text_input_listen :
                ~script10612;
        }
    case 10 :
        switch_component ($component0) {
            case stockmarket:search_input_listen :
                ~script14084(0);
        }
}
