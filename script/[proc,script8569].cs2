// 8569
[proc,script8569]
if (%prayer_mode = 1) {
    if_sethide(true, prayer_quick_preset_interface:prayerbook_normal_radio_deselected);
    if_sethide(false, prayer_quick_preset_interface:prayerbook_normal_radio_selected);
    if_sethide(false, prayer_quick_preset_interface:prayerbook_curse_radio_deselected);
    if_sethide(true, prayer_quick_preset_interface:prayerbook_curse_radio_selected);
} else {
    if_sethide(true, prayer_quick_preset_interface:prayerbook_curse_radio_deselected);
    if_sethide(false, prayer_quick_preset_interface:prayerbook_curse_radio_selected);
    if_sethide(false, prayer_quick_preset_interface:prayerbook_normal_radio_deselected);
    if_sethide(true, prayer_quick_preset_interface:prayerbook_normal_radio_selected);
}
