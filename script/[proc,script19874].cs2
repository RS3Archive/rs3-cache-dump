// 19874
[proc,script19874]
if_sethide(false, trh_academy_shared_overlay:splash_screen);
if_sethide(true, trh_academy_shared_overlay:universe);
if_sethide(true, trh_academy_shared_overlay:splash_screen_title);
if_sethide(false, trh_academy_shared_overlay:splash_screen_title_graphic);
~script4170(trh_academy_shared_overlay:splash_screen_title_graphic, trh207_title_en, trh207_title_de, trh207_title_fr, trh207_title_pt);
if_setposition(0, 75, ^setpos_abs_centre, ^setpos_abs_top, trh_academy_shared_overlay:splash_screen_desc);
if_setsize(325, 200, ^setsize_abs, ^setsize_abs, trh_academy_shared_overlay:splash_screen_desc);
if_settextfont(notosans_14, trh_academy_shared_overlay:splash_screen_desc);
if_setposition(0, 0, ^setpos_abs_centre, ^setpos_abs_top, trh_academy_shared_overlay:splash_screen_desc_shadow);
if_setsize(325, 450, ^setsize_abs, ^setsize_abs, trh_academy_shared_overlay:splash_screen_desc_shadow);
if_settext("Beat different encounters to increase your mage's level!<br><br>Reach level milestones to unlock<br>new <col=3366FF>Saradominist</col> and <col=E80404>Zamorakian <col=F0BE79>themed capes, amulets,</col> and <col=F0BE79>combat overrides</col>!", trh_academy_shared_overlay:splash_screen_desc);
if_setgraphic(trh207_background_splash, trh_academy_shared_overlay:splash_screen_bg);
if_setposition(0, 4, ^setpos_abs_centre, ^setpos_abs_bottom, trh_academy_shared_overlay:splash_screen_bg);
if_setnpcmodel(trh207_splash_screen_mage, trh_academy_shared_overlay:splash_screen_npc_large_model_1);
if_setposition(-29, -3, ^setpos_abs_centre, ^setpos_abs_centre, trh_academy_shared_overlay:splash_screen_npc_large_model_1);
if_setposition(-29, -3, ^setpos_abs_centre, ^setpos_abs_centre, trh_academy_shared_overlay:reward_preview_player_1_spotanim_model);
if_setnpcmodel(trh207_splash_screen_dark_mage, trh_academy_shared_overlay:splash_screen_npc_large_model_2);
if_setposition(29, -3, ^setpos_abs_centre, ^setpos_abs_centre, trh_academy_shared_overlay:splash_screen_npc_large_model_2);
if_setposition(29, -3, ^setpos_abs_centre, ^setpos_abs_centre, trh_academy_shared_overlay:reward_preview_player_2_spotanim_model);
if_sethide(false, trh_academy_shared_overlay:reward_preview_grid);
if_setopbase("<col=FF00>Amulets", trh_academy_shared_overlay:reward_preview_1_layer);
if_setopbase("<col=FF00>Concentrated Blast", trh_academy_shared_overlay:reward_preview_2_layer);
if_setopbase("<col=FF00>Chain", trh_academy_shared_overlay:reward_preview_3_layer);
if_setopbase("<col=FF00>Wild Magic", trh_academy_shared_overlay:reward_preview_4_layer);
if_setopbase("<col=FF00>Capes", trh_academy_shared_overlay:reward_preview_5_layer);
~script19876(1);
