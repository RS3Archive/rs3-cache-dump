// 8757
[proc,script8757]
if (%oct13_isrunefest = 1 & cc_find(oct13_therm:oct13_therm, 0) = true) {
    if (%oct13_memorialpercent < 200) {
        if (cc_getheight ! %oct13_memorialpercent) {
            cc_setsize(18, calc(200 - %oct13_memorialpercent), ^setsize_abs, ^setsize_abs);
        }
    } else {
        cc_setposition(25, calc(17 - 1), ^setpos_abs_left, ^setpos_abs_top);
        cc_setsize(18, 1, ^setsize_abs, ^setsize_abs);
    }
    cc_settext("<tostring(calc(%oct13_memorialpercent / 2))>%");
}
