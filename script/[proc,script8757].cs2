// 8757
[proc,script8757]
if (%varplayerbit_20723 = 1 & cc_find(interface_247:com_21, 0) = true) {
    if (%varplayerbit_20715 < 200) {
        if (cc_getheight ! %varplayerbit_20715) {
            cc_setsize(18, calc(200 - %varplayerbit_20715), ^setsize_abs, ^setsize_abs);
        }
    } else {
        cc_setposition(25, calc(17 - 1), ^setpos_abs_left, ^setpos_abs_top);
        cc_setsize(18, 1, ^setsize_abs, ^setsize_abs);
    }
    cc_settext("<tostring(calc(%varplayerbit_20715 / 2))>%");
}
