// 3811
[clientscript,script3811](component $component0)
if (if_getgraphic($component0) = xmas2019_advent_button) {
    if_setgraphic(xmas2019_advent_button_over, $component0);
}
if (if_getgraphic($component0) = xmas2019_advent_right_button) {
    if_setgraphic(xmas2019_advent_right_button_over, $component0);
}
