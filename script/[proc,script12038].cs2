// 12038
[proc,script12038](stat $stat0)(int)
if (map_members = false) {
    if (enum_hasoutput(stat, stat_elite_list, $stat0) = true) {
        return(1);
    } else if (enum_hasoutput(stat, stat_p2p_list, $stat0) = true) {
        if ($stat0 = archaeology | $stat0 = necromancy | $stat0 = construction) {
            return(20);
        }
        return(5);
    }
}
return(enum(stat, int, stat_to_statcap, $stat0));
