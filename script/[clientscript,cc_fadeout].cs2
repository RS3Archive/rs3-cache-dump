// 15372
[clientscript,cc_fadeout](component $component0, int $int1, int $int2, component $component3)
def_int $int4 = calc($int2 - clientclock);
def_int $int5 = 0;
if (cc_find($component0, $int1) = true) {
    if ($int4 <= 0) {
        cc_settrans(255);
        cc_setontimer(null);
        if ($component3 ! null) {
            if_sethide(false, $component3);
        }
        return;
    }
    $int5 = calc(255 - cc_gettrans);
    cc_settrans(min(calc(cc_gettrans + $int5 / $int4), 254));
}
