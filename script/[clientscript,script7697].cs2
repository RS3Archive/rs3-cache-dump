// 7697
[clientscript,script7697](int $int0)
if (cc_find(mtx_pack:gold_window_content_layer, $int0) = true) {
    switch_int (--%mtx_pack_flash_counter) {
        case 29 :
            cc_setoutline(2);
        case 27 :
            cc_setoutline(0);
        case 19 :
            cc_setoutline(2);
        case 17 :
            cc_setoutline(0);
        case default :
            if (%mtx_pack_flash_counter < 17) {
                cc_setontimer(null);
                %mtx_pack_flash_counter = 30;
            }
    }
}
