// 17371
[proc,script17371](long $long0)(string)
if ($long0 < 0) {
    return("");
} else if ($long0 < 100000) {
    return("<col=FFFF00><tostring_localised_long($long0, true)></col>");
} else if ($long0 < 10000000) {
    return("<col=FFFFFF><tostring_localised_long(calc($long0 / 1000), true)>K</col>");
} else if ($long0 < 10000000000) {
    return("<col=1EFF00><tostring_localised_long(calc($long0 / 1000000), true)>M</col>");
} else if ($long0 < 10000000000000) {
    return("<col=6698FF><tostring_localised_long(calc($long0 / 1000000000), true)>B</col>");
} else if ($long0 < 10000000000000000) {
    return("<col=A335EE><tostring_localised_long(calc($long0 / 1000000000000), true)>T</col>");
} else {
    return("<col=FF8000><tostring_localised_long(calc($long0 / 1000000000000000), true)>Q</col>");
}
