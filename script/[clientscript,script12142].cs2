// 12142
[clientscript,script12142](int $int0)
%invent_discovery_state_0 = $int0;
def_string $string0 = "";
switch_int (random(5)) {
    case default :
        $string0 = "Something didn't work correctly in your prototype.";
    case 1 :
        $string0 = "Your prototype exploded!";
    case 2 :
        $string0 = "You narrowly avoid the parts that fly off your prototype.";
    case 3 :
        $string0 = "Your prototype flies off the workbench and smashes on the floor.";
    case 4 :
        $string0 = "This prototype doesn't seem to do anything at all.";
}
if_settext($string0, invent_discovery:refine_continue_text);
if_setontimer("script12143(1, calc(clientclock + 10))", invent_discovery:workbench_overlay);
~script12128;
