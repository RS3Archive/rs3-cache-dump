// 4809
[proc,clan_custom_bottom_section]
if_sethide(true, clan_stronghold_main_decor:custom_buy_layer_1);
if_sethide(true, clan_stronghold_main_decor:custom_buy_layer_2);
if_sethide(true, clan_stronghold_main_decor:custom_buy_layer_3);
if_sethide(true, clan_stronghold_main_decor:custom_cancel_layer_1);
if_sethide(true, clan_stronghold_main_decor:custom_cancel_layer_2);
if_sethide(true, clan_stronghold_main_decor:custom_cancel_layer_3);
if (~script4828(%clan_custom_stronghold_current_slot_varp) = true) {
    if_sethide(false, clan_stronghold_main_decor:custom_cancel_layer_1);
    if_sethide(false, clan_stronghold_main_decor:custom_cancel_layer_2);
    if_sethide(false, clan_stronghold_main_decor:custom_cancel_layer_3);
} else {
    if_sethide(false, clan_stronghold_main_decor:custom_buy_layer_1);
    if_sethide(false, clan_stronghold_main_decor:custom_buy_layer_2);
    if_sethide(false, clan_stronghold_main_decor:custom_buy_layer_3);
}
~clan_custom_update_prices;
~script4814;
