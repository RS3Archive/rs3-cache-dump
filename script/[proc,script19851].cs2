// 19851
[proc,script19851](achievement $achievement0)(int, int)
def_int $int1 = achievement_achievement_req_count($achievement0);
def_int $int2 = 0;
def_int $int3 = $int1;
def_achievement $achievement4 = null;
def_int $int5 = -1;
while (++$int5 < $int1) {
    $achievement4 = achievement_achievement_req($achievement0, $int5);
    switch_achievement ($achievement4) {
        case achievement_3625, achievement_3626, achievement_3627, achievement_3628, achievement_3629, achievement_3630 :
            $int3 = calc($int3 - 1);
        case default :
            if (achievement_reqstate($achievement4) = -2) {
                $int2 = calc($int2 + 1);
            }
    }
}
return($int2, $int3);
