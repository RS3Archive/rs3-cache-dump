// 4570
[clientscript,script4570](int $int0, component $component1, component $component2)
if (clan_getchatcount = 0) {
    mes_typed(^chattype_friendschatnotification, 0, "You need to be in a Friends Chat channel to do that.");
    return;
}
if (~is_mobile_client = true) {
    %lobby_caret_friendschat = string_length(%lobbyscreen_input_friendschat);
} else {
    %lobby_caret_friendschat = ~script1401($int0, %lobbyscreen_input_friendschat, museo_sans_11pt_regular, if_getx($component1));
}
~script1566(0, %lobbyscreen_input_friendschat, 80);
~script4571($component1, $component2, %lobbyscreen_input_friendschat);
