// 1979
[clientscript,script1979](component $component0)
def_int $int1 = 0;
def_int $int2 = 0;
if ($component0 = town_rewards:guard_progress_bar) {
    $int2 = min(250, %town_reward_points);
} else {
    $int2 = min(250, %town_reward_points);
}
$int1 = scale(if_getheight(if_getlayer(town_rewards:guard_progress_bar)), 250, $int2);
if (if_getheight($component0) ! $int1) {
    if_setontimer("script1980($int1, $component0)", if_getlayer($component0));
}
