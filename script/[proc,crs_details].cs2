// 9028
[proc,crs_details](struct $struct0, quest $quest1, achievement $achievement2)(string)
if ($struct0 = null & $quest1 = null & $achievement2 = null) {
    return("");
}
def_string $string0 = "";
if ($quest1 ! null) {
    return(quest_param($quest1, quest_description));
} else if ($achievement2 ! null) {
    return(~achievement_description($achievement2));
} else if ($struct0 ! null) {
    if (struct_param($struct0, task_struct) ! null) {
        $struct0 = struct_param($struct0, task_struct);
    }
    if ($struct0 = crs_slayer_assignment) {
        $struct0 = ~script16091;
        if ($struct0 ! null & %slayer_count > 0 & string_length(struct_param($struct0, slayer_description)) > 0) {
            return(struct_param($struct0, slayer_description));
        }
    } else if (struct_param($struct0, quest_id) > 0) {
        $quest1 = enum(int, quest, ql4_quests, struct_param($struct0, quest_id));
        if ($quest1 ! null) {
            return(quest_param($quest1, quest_description));
        }
    } else if (struct_param($struct0, bslay_id) > 0 & string_length(struct_param($struct0, cheevo_details)) > 0) {
        return(struct_param($struct0, cheevo_details));
    }
    if (string_length(struct_param($struct0, dndtracker_full_description)) > 0) {
        return(struct_param($struct0, dndtracker_full_description));
    }
    $string0 = ~cheevo_details($struct0, 0);
    if (string_length($string0) = 0 & string_length(struct_param($struct0, task_details)) > 0) {
        $string0 = struct_param($struct0, task_details);
    }
    if (struct_param($struct0, challenge_target) > 0) {
        $string0 = "<$string0>.";
    }
}
return($string0);
