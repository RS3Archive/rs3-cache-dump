// 14066
[proc,trh141_update_button](int $int0, component $component1)
def_enum $enum2 = ~trh141_get_category($int0);
def_int $int3 = 0;
def_string $string0 = "Skills : ";
def_int $int4 = -1;
def_stat $stat5 = null;
if (%trh141_category = $int0) {
    ~rs3_background_panel($component1, rs3_icon_holder_selected);
    if_setonmouseover(null, $component1);
    if_setonmouseleave(null, $component1);
    while ($int3 < enum_getoutputcount($enum2)) {
        $int4 = enum(int, int, $enum2, $int3);
        $stat5 = enum(int, stat, int_to_stat, $int4);
        if ($int3 = calc(enum_getoutputcount($enum2) - 1)) {
            $string0 = append($string0, "<enum(stat, string, stat_to_string, $stat5)>.");
        } else {
            $string0 = append($string0, "<enum(stat, string, stat_to_string, $stat5)>, ");
        }
        $int3 = calc($int3 + 1);
    }
    if_settext($string0, trh141_xp_reward:output);
} else {
    ~rs3_background_panel($component1, rs3_icon_holder);
    if_setonmouseover("rs3_background_panel(event_com, rs3_icon_holder_over)", $component1);
    if_setonmouseleave("rs3_background_panel(event_com, rs3_icon_holder)", $component1);
}
