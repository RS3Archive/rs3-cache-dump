// 16638
[clientscript,script16638](string $string0)
def_string $string1 = "Press here to hide the Yak Track notification.<br>You can open Yak Track at any time from the Events Tab.<br>Drag this button anywhere on the screen.";
if_setonmouserepeat("script8799($string0, wheel_of_fortune_button:content_layer, -1)", wheel_of_fortune_button:content_layer);
if_setonmouseover("script1093(wheel_of_fortune_button:runepass_icon, icon_summerskill_32px)", wheel_of_fortune_button:content_layer);
if_setonmouseleave("script1093(wheel_of_fortune_button:runepass_icon, icon_summerskill_notification_32px)", wheel_of_fortune_button:content_layer);
if_setonmouserepeat("script8799($string1, wheel_of_fortune_button:wof_tick, -1)", wheel_of_fortune_button:wof_tick);
