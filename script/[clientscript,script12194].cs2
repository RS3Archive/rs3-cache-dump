// 12194
[clientscript,script12194]
if_sethide(false, invent_gizmo:create_button_disabled_layer);
if_sethide(false, invent_gizmo:repeat_button_disabled_layer);
if_sethide(false, invent_gizmo:restart_button_disabled_layer);
~script12196(false);
def_component $component0 = invent_gizmo:result_feedback;
cc_deleteall($component0);
def_int $int1 = 0;
$int1, $int1 = ~script12086($component0, 0, 5, 5, if_getwidth($component0), "Creating new gizmo...", rs3tli_font_13pt_title);
def_int $int2 = 0;
while (cc_find(invent_gizmo:repeat_layer, $int2) = true) {
    cc_setcolour(0x808080);
    $int2 = calc($int2 + 1);
}
$int2 = 0;
while (cc_find(invent_gizmo:restart_layer, $int2) = true) {
    cc_setcolour(0x808080);
    $int2 = calc($int2 + 1);
}
