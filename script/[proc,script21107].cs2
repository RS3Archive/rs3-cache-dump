// 21107
[proc,script21107](obj $obj0, boolean $boolean1)(int)
def_int $int2 = 0;
def_int $int3 = -1;
if (map_members = false & oc_members($obj0) = 1) {
    $int2 = 0;
} else if (oc_param($obj0, recipe_fully_charged) = 1) {
    if (oc_param($obj0, item_degrade_use_alternate_var) = 1) {
        $int2 = 0;
    } else {
        $int3 = ~inv_find(inv, $obj0, 0);
        if ($int3 = -1) {
            $int2 = 0;
        } else if (inv_getvar(inv, $int3, item_degrade_state) ! 0) {
            $int2 = 0;
        } else {
            $int2 = 1;
        }
    }
} else if ($boolean1 = true) {
    $int2 = calc(inv_total(inv, $obj0) + inv_total(lore_bob, $obj0));
} else {
    $int2 = inv_total(inv, $obj0);
}
return($int2);
