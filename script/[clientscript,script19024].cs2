// 19024
[clientscript,script19024]
if (%ring_of_death_iterations <= 0) {
    if_sethide(true, toplevel_v2_status_effects:ring_of_death_graphic);
    if_settrans(255, toplevel_v2_status_effects:ring_of_death_graphic);
    return;
}
if_setgraphic(gradient_vignette_heavy_white_16_9, toplevel_v2_status_effects:ring_of_death_graphic);
if_sethide(false, toplevel_v2_status_effects:ring_of_death_graphic);
if_settrans(38, toplevel_v2_status_effects:ring_of_death_graphic);
