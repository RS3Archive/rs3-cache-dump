// 17671
[proc,script17671](int $int0, int $int1)
if ($int1 = -1) {
    if_settext("-", interface_1490:com_75);
} else {
    if_settext("<~tostring_decimal($int1, 1, 0, 0, 1)>%", interface_1490:com_75);
    if ($int1 < $int0) {
        if_setcolour(^red, interface_1490:com_75);
    } else if ($int1 >= 750) {
        if_setcolour(~rgb_to_hex(calc(255 - scale(calc($int1 - 750), 250, 255)), 255, 0), interface_1490:com_75);
    } else {
        if_setcolour(~rgb_to_hex(255, max(scale(calc($int1 - $int0), calc(750 - $int0), 255), 0), 0), interface_1490:com_75);
    }
}
