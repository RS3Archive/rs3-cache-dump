// 11275
[proc,script11275](component $component0, int $int1, struct $struct2)
if (cc_find($component0, calc($int1 + 1)) = true) {
    cc_setgraphic(struct_param($struct2, rs3tli_button_graphic_top_left));
}
if (cc_find($component0, calc($int1 + 2)) = true) {
    cc_setgraphic(struct_param($struct2, rs3tli_button_graphic_top));
}
if (cc_find($component0, calc($int1 + 3)) = true) {
    cc_setgraphic(struct_param($struct2, rs3tli_button_graphic_top_right));
}
if (cc_find($component0, calc($int1 + 4)) = true) {
    cc_setgraphic(struct_param($struct2, rs3tli_button_graphic_left));
}
if (cc_find($component0, calc($int1 + 5)) = true) {
    cc_setgraphic(struct_param($struct2, rs3tli_button_graphic_middle));
}
if (cc_find($component0, calc($int1 + 6)) = true) {
    cc_setgraphic(struct_param($struct2, rs3tli_button_graphic_right));
}
if (cc_find($component0, calc($int1 + 7)) = true) {
    cc_setgraphic(struct_param($struct2, rs3tli_button_graphic_bottom_left));
}
if (cc_find($component0, calc($int1 + 8)) = true) {
    cc_setgraphic(struct_param($struct2, rs3tli_button_graphic_bottom));
}
if (cc_find($component0, calc($int1 + 9)) = true) {
    cc_setgraphic(struct_param($struct2, rs3tli_button_graphic_bottom_right));
}
