// 1061
[proc,quickchat_menu_select](component $component0, component $component1, int $int2, component $component3, int $int4, chatcat $chatcat5, int $int6)
~quickchat_focus($int6);
~script8676($int6, 0);
~script8674($int6, 0);
def_int $int7 = 0;
while (cc_find($component0, $int7) = true) {
    if ($int7 = $int2) {
        cc_setonmouseover(null);
        cc_setonmouseleave(null);
        if (.cc_find($component1, $int7) = true) {
            .cc_sethide(false);
            .cc_setcolour(0x969777);
        }
    } else {
        cc_setonmouseover("script1082(calc($int4 - 1), $component1, $int7, $int6)");
        cc_setonmouseleave("script1083(calc($int4 - 1), $component1, $int7, $int6)");
        if (.cc_find($component1, $int7) = true) {
            .cc_sethide(true);
        }
    }
    $int7 = calc($int7 + 1);
}
~quickchat_menu_add($component3, $int4, $chatcat5, null, 0, $int6);
