// 11326
[clientscript,script11326]
if (%overload_type = 0) {
    if (stat(attack) > stat_base(attack)) {
        ~script10624(combatv2_attack_boosted_dummy_ability, 1);
        ~script10624(combatv2_attack_nerfed_dummy_ability, 0);
        return;
    } else if (stat(attack) < stat_base(attack)) {
        ~script10624(combatv2_attack_boosted_dummy_ability, 0);
        ~script10624(combatv2_attack_nerfed_dummy_ability, 1);
        return;
    }
}
~script10624(combatv2_attack_boosted_dummy_ability, 0);
~script10624(combatv2_attack_nerfed_dummy_ability, 0);
