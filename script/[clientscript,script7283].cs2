// 7283
[clientscript,script7283](int $int0)
if ($int0 = 1) {
    if (%pop_ship_voyage_state ! 0) {
        mes("You cannot currently edit the crew.");
        return;
    }
    if_sethide(true, pop_ship:list_layer);
    if_sethide(true, pop_ship:active_voyage_send_layer);
    if_sethide(false, pop_ship:crew_manager_layer);
    if_sethide(false, pop_ship:crew_compare_layer);
    if_sethide(true, pop_ship:crew_roster_open);
    if_sethide(false, pop_ship:crew_roster_close);
} else {
    if_sethide(false, pop_ship:crew_roster_open);
    if_sethide(true, pop_ship:crew_manager_layer);
    if_sethide(true, pop_ship:crew_compare_layer);
    if_sethide(true, pop_ship:active_voyage_send_layer);
}
