// 5514
[clientscript,bslay_update_points]
if_settext(tostring(%bslay_points), bslay_shop:points_boss);
if_settext(tostring(%smki_slayer_points), bslay_shop:points_slayer);
if (%bslay_points = 0) {
    if_setcolour(0xca2d25, bslay_shop:points_boss);
}
if (%smki_slayer_points = 0) {
    if_setcolour(0xca2d25, bslay_shop:points_slayer);
}
