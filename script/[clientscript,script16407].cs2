// 16407
[clientscript,script16407](component $component0, int $int1, int $int2, int $int3)
if (calc($int2 % 40) < 20) {
    $int1 = calc($int1 + 1);
} else {
    $int1 = calc($int1 - 1);
}
$int2 = calc($int2 + 1);
if ($int3 = 1) {
    if_setposition($int1, 0, ^setpos_abs_left, ^setpos_abs_top, $component0);
} else {
    if_setposition(0, $int1, ^setpos_abs_left, ^setpos_abs_top, $component0);
}
if_setontimer("script16407($component0, $int1, $int2, $int3)", $component0);
