// 18440
[proc,script18440](struct $struct0)
switch_int (map_lang) {
    case 0 :
        if_sethide(false, buff_select_event:event_title_text_1);
        if_sethide(false, buff_select_event:event_title_text_2);
        if_sethide(true, buff_select_event:event_title_text);
        if_settext("Birthday Buff", buff_select_event:event_title_text_1);
        if_settext("Bonanza", buff_select_event:event_title_text_2);
    case default :
        if_sethide(true, buff_select_event:event_title_text_1);
        if_sethide(true, buff_select_event:event_title_text_2);
        if_sethide(false, buff_select_event:event_title_text);
        if_settext(struct_param($struct0, timed_event_name), buff_select_event:event_title_text);
        if (map_lang = 1) {
            if_settextfont(cinzel_18pt_bold, buff_select_event:event_title_text);
        } else {
            ~kr_arrow_toplevel(buff_select_event:event_title_text, fonts_cinzel_bold, 3, 28, 14);
        }
}
