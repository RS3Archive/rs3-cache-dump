[proc,script18440](struct $struct0)
switch_int (map_lang) {
    case 0 :
        if_sethide(false, interface_1280:com_3);
        if_sethide(false, interface_1280:com_4);
        if_sethide(true, interface_1280:com_5);
        if_settext("Birthday Buff", interface_1280:com_3);
        if_settext("Bonanza", interface_1280:com_4);
    case default :
        if_sethide(true, interface_1280:com_3);
        if_sethide(true, interface_1280:com_4);
        if_sethide(false, interface_1280:com_5);
        if_settext(struct_param($struct0, param_6135), interface_1280:com_5);
        if (map_lang = 1) {
            if_settextfont(fontmetrics_58, interface_1280:com_5);
        } else {
            ~kr_arrow_toplevel(interface_1280:com_5, enum_16355, 3, 28, 14);
