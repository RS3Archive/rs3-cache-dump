// 10338
[proc,script10338]
def_string $string0 = "Open matchmaking interface.";
def_string $string1 = "Open Grouping System";
def_graphic $graphic0 = black_placeholder;
if (%group_type ! 999999) {
    if (%group_wants_members = 0) {
        $graphic0, $string0, $string1 = "rs3_icon_grouping_system,12", "Your group is not registered for matchmaking.", "Toggle Matchmaking";
    } else {
        $graphic0, $string0, $string1 = "rs3_icon_grouping_system,11", "Your group is registered for matchmaking.", "Toggle Matchmaking";
    }
}
~script10339($graphic0, $string0, $string1);
