// 1509
[clientscript,player_kit_body_initialise]
cc_deleteall(player_kit_tailor:menu_graphics);
~rs3_background_panel(player_kit_tailor:menu_graphics, rs3_content_container_active);
cc_deleteall(player_kit_tailor:player_container);
~player_kit_player_create(player_kit_tailor:player_container, 380, 100);
cc_deleteall(player_kit_tailor:colours_graphics);
~rs3_background_panel(player_kit_tailor:colours_graphics, rs3_content_container_active);
%player_kit_body_layer = %player_kit_body_viewing;
~player_kit_body_redraw;
if_setonvartransmit("player_kit_body_vartransmit{gimp_temp_var}", player_kit_tailor:universe);
if_setonvarctransmit("player_kit_body_varctransmit{playerdesign3_torso, playerdesign3_arms, playerdesign3_hands, playerdesign3_legs, playerdesign3_torsocol, playerdesign3_legscol}", player_kit_tailor:universe);
if_setonop("script1512(event_op, 0)", player_kit_tailor:torso_tab);
if_setonop("script1512(event_op, 1)", player_kit_tailor:arms_tab);
if_setonop("script1512(event_op, 2)", player_kit_tailor:hands_tab);
if_setonop("script1512(event_op, 3)", player_kit_tailor:legs_tab);
def_string $string0 = "Choose a top";
if_setonmouserepeat("script8799($string0, event_com, event_comsubid)", player_kit_tailor:torso_tab);
$string0 = "Choose some sleeves";
if_setonmouserepeat("script8799($string0, event_com, event_comsubid)", player_kit_tailor:arms_tab);
$string0 = "Decorate your wrists";
if_setonmouserepeat("script8799($string0, event_com, event_comsubid)", player_kit_tailor:hands_tab);
$string0 = "Choose some leggings";
if_setonmouserepeat("script8799($string0, event_com, event_comsubid)", player_kit_tailor:legs_tab);
