    case combatv2_egwd_zamorak_boss_buff_e1 :
        $string0 = "<col=FF0000>Hex: Smite - If Zamorak's targets are hit below <tostring(5)>% of their Constitution level, per stack, they'll be executed instantly.<br><br><col=FF00>Edict: Haste - Your ability cooldowns are reduced by <tostring(8)>% of their original cooldown per stack.";
    case combatv2_egwd_zamorak_boss_buff_h :
