    case combatv2_egwd_zamorak_boss_buff_rune_haste :
        $string0 = "You have access to the Haste Edict<br><br>With <tostring(%egwd_zamorak_boss_edict_haste_stacks)> <~text_plural(%egwd_zamorak_boss_edict_haste_stacks, "stack", "stacks")>, your ability cooldowns are reduced by <tostring(calc(%egwd_zamorak_boss_edict_haste_stacks * 8))>%.";
    case combatv2_egwd_zamorak_boss_buff_hex_execute :
        $string0 = "Zamorak has access to the Smite Hex<br><br>With <tostring(%combatv2_debuff_egwd_zamorak_boss_hex_execute_stacks_client)> <~text_plural(%combatv2_debuff_egwd_zamorak_boss_hex_execute_stacks_client, "stack", "stacks")>, if Zamorak's targets are hit below  <tostring(calc(%combatv2_debuff_egwd_zamorak_boss_hex_execute_stacks_client * 5))>% of their total maximum life points, they'll be killed instantly.";
    case combatv2_egwd_zamorak_boss_buff_hex_healing_reduction :
