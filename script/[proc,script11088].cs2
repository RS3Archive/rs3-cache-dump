    case combatv2_egwd_zamorak_boss_buff_a :
        $string0 = "<col=FF0000>Hex: Disintegrate - Zamorak's attacks will push <tostring(7)>% of damage through any shielding effects, per stack.<br><br><col=FF00>Edict: Guardian's Triumph - After casting an ultimate ability, your next basic ability consumes Guardian's Triumph, increasing the damage it deals by <tostring(20)>% extra damage, and heals you for <tostring(8)>% of your missing life points per stack.";
    case combatv2_egwd_zamorak_boss_buff_v :
