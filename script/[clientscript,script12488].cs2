// 12488
[clientscript,script12488]
db_find(mm16_task:col0, %mm16_active_task);
def_dbrow $dbrow0 = db_findnext;
def_string $string0 = "None.";
def_string $string1 = "";
if ($dbrow0 ! null) {
    $string0 = db_getfield($dbrow0, mm16_task:col2, 0);
    $string1 = %mm16_task_steps;
}
if_settext($string0, mm16_tracking:task_name);
if_settext($string1, mm16_tracking:task_progress);
~script12489;
