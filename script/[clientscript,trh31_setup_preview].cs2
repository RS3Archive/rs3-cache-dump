// 10681
[clientscript,trh31_setup_preview](int $int0, struct $struct1)
if_sethide(true, trh31_costume:main_layer);
if_sethide(false, trh31_costume:preview_layer);
if_sethide(true, trh31_costume:info_layer);
if_setonop("script10682(1)", trh31_costume:help_button);
def_npc $npc2 = null;
if (gender = 0) {
    $npc2 = struct_param($struct1, trh31_male_preview);
} else {
    $npc2 = struct_param($struct1, trh31_female_preview);
}
if_setnpcmodel($npc2, trh31_costume:preview_model);
if_settext(struct_param($struct1, trh31_name), trh31_costume:preview_title);
def_string $string0 = "Cost: <tostring_localised(struct_param($struct1, trh31_cost), true)> ghostweave.<br>Allows <tostring(struct_param($struct1, trh31_sweets_total))> sweets (<tostring(struct_param($struct1, trh31_sweets_per_day))> per day) from trick or treating.";
if_settext($string0, trh31_costume:preview_text);
if ($int0 = 1) {
    if_settext("Recover", trh31_costume:make_button_text);
    if_sethide(true, trh31_costume:make_button_disabled_layer);
    $string0 = "You already own this costume. Click to recover lost pieces.";
    if_setonmouserepeat("script3876($string0, event_com, -1)", trh31_costume:make_layer);
} else {
    if_settext("Make", trh31_costume:make_button_text);
    if (inv_total(inv, trh31_ghostweave) < struct_param($struct1, trh31_cost)) {
        if_sethide(false, trh31_costume:make_button_disabled_layer);
        $string0 = "You don't have enough ghostweave to make this costume.";
        if_setonmouserepeat("script3876($string0, event_com, -1)", trh31_costume:make_button_disabled_layer);
    } else {
        if_sethide(true, trh31_costume:make_button_disabled_layer);
        $string0 = "Make this costume from <tostring_localised(struct_param($struct1, trh31_cost), true)> ghostweave. You will need 5 free inventory spaces.";
        if_setonmouserepeat("script3876($string0, event_com, -1)", trh31_costume:make_layer);
    }
}
