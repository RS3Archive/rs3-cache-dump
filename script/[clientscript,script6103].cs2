[clientscript,script6103]
if_settext(%shop_item_description, shop_main:item_description);
def_string $string0 = "";
def_string $string1 = "";
switch_int (%shop_item_info) {
    case 0, 1, 3, 4, 5, 6 :
        $string0 = "This is a piece of apparel.";
    case 2, 7 :
        $string0 = "This is a piece of jewellery.";
    case 9 :
        $string0 = "This is a shield.";
    case 11, 17, 14 :
        $string0 = "This is a melee weapon.";
    case 12, 18, 15 :
        $string0 = "This is a ranged weapon.";
    case 13, 19, 16 :
        $string0 = "This is a weapon for mages.";
    case 8 :
        $string0 = "Ammunition for a ranged weapon.";
    case 60 :
        $string0 = "This is an aura focus.";
    case 30, 31, 32 :
        $string0 = "This is a tool.";
    case 33, 34 :
        $string0 = "This is a piece of food.";
    case 90, 91, 92, 93, 94, 95, 96, 97, 98, 99, 100, 101, 102, 103, 104, 105, 106, 107, 108, 109 :
        $string0 = "This is a usable item.";
    case 36 :
        $string0 = "This is a magic rune.";
}
if_settext($string0, shop_main:item_info);
