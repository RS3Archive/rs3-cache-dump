// 49
[clientscript,prayer_varupdate](component $component0, component $component1, int $int2, struct $struct3)
if (~script7083($struct3) = 1) {
    if (cc_find($component0, $int2) = true) {
        cc_setop(1, "Deactivate <col=FF00><struct_param($struct3, combatv2_ability_name)></col>");
    }
    if (cc_find($component1, $int2) = true) {
        cc_setgraphic(combatv2_prayerglow);
    }
} else {
    if (cc_find($component0, $int2) = true) {
        cc_setop(1, "Activate <col=FF00><struct_param($struct3, combatv2_ability_name)></col>");
    }
    if (cc_find($component1, $int2) = true) {
        cc_setgraphic(null);
    }
}
