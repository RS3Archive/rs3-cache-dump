// 9165
[clientscript,script9165]
def_int $int0 = 0;
if (if_gethide(toplevel_v2_hover_target:universe) = true) {
    return;
}
if (if_find(toplevel_v2_targeting:hover_info) = true) {
    $int0 = cc_param(toplevel_v2_hover_info_timeout);
    if (--$int0 = 0) {
        ~script8880;
    } else {
        cc_setparam_int(toplevel_v2_hover_info_timeout, $int0);
    }
}
