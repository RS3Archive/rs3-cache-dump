// 11665
[clientscript,script11665]
if (%dov_bard_spoken = 0 | %dov_swensen_spoken = 0 | %dov_peer_spoken = 0 | %dov_manni_spoken = 0 | %dov_brundt_spoken = 0 | %dov_sigmund_spoken = 0 | %dov_yrsa_spoken = 0) {
    if_sethide(false, dov_preparing_the_celebration:confirm_button_disabled_layer);
    if_sethide(true, dov_preparing_the_celebration:confirm_button_active_layer);
}
