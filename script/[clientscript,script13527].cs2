// 13527
[clientscript,script13527]
if_setcolour(~script10495(0), slayer_count:slayer_task_streak);
def_string $string0 = "Task streak: <tostring_localised(%smki_mission_count, true)>";
if (%slayer_counter_display_mode = 1) {
    $string0 = "Task streak: <tostring_localised(%bslay_task_streak, true)>";
    if_settext(tostring_localised(%bslay_task_streak, true), slayer_count:slayer_task_streak);
} else {
    if_settext(tostring_localised(%smki_mission_count, true), slayer_count:slayer_task_streak);
}
if_setonmouserepeat("script8799($string0, event_com, -1)", slayer_count:slayer_task_streak_text);
