// 20006
[proc,script20006](obj $obj0)(int)
def_int $int1 = 5;
if (oc_category($obj0) = crafting_armour_adorn) {
    $int1 = 3;
}
if (oc_param($obj0, recipe_requirement_value_1) >= 100 | oc_param($obj0, recipe_requirement_value_1) >= 100) {
    if (stat_base(crafting) >= struct_param(skillguide_crafting_armour_100_miscuts_2, skillguide_level)) {
        $int1 = calc($int1 + 2);
    } else if (stat_base(crafting) >= struct_param(skillguide_crafting_armour_100_miscuts_1, skillguide_level)) {
        $int1 = calc($int1 + 1);
    }
}
return($int1);
