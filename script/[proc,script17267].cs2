// 17267
[proc,script17267](obj $obj0, obj $obj1)(bas)
def_struct $struct2 = oc_param($obj0, weapon_category);
def_bas $bas3 = combat_2012_casual_unarmed;
if ($obj0 ! null) {
    if ($struct2 ! null) {
        $bas3 = struct_param($struct2, combatv2_casual_bas);
    }
    if (oc_param($obj0, combatv2_override_weapon_setup) = 1 & oc_param($obj0, combatv2_casual_bas) ! null) {
        $bas3 = oc_param($obj0, combatv2_casual_bas);
    }
}
$struct2 = oc_param($obj1, weapon_category);
if ($obj1 ! null) {
    if ($struct2 ! null) {
        $bas3 = struct_param($struct2, combatv2_casual_bas);
    }
    if (oc_param($obj1, combatv2_override_weapon_setup) = 1 & oc_param($obj1, wof_over_override) = 1 & oc_param($obj1, combatv2_casual_bas) ! null) {
        $bas3 = oc_param($obj1, combatv2_casual_bas);
    }
    if (oc_param($obj0, combatv2_override_weapon_setup) = 1 & oc_param($obj0, combatv2_casual_bas) ! null) {
        $bas3 = oc_param($obj0, combatv2_casual_bas);
    }
}
if (gender = 1) {
    switch_bas ($bas3) {
        case combat_2012_casual_armed :
            $bas3 = combat_2012_casual_armed_female;
        case combat_2012_casual_two_handed_sword :
            $bas3 = combat_2012_casual_two_handed_sword_female;
        case combat_2012_casual_spear :
            $bas3 = combat_2012_casual_spear_female;
        case combat_2012_casual_maul :
            $bas3 = combat_2012_casual_maul_female;
        case combat_2012_casual_unarmed :
            $bas3 = combat_2012_casual_unarmed_female;
        case combat_2012_casual_two_handed_crossbow :
            $bas3 = combat_2012_casual_two_handed_crossbow_female;
        case combat_2012_casual_shield :
            $bas3 = combat_2012_casual_shield_female;
        case human_actor_player_casual_unarmed_heroic :
            $bas3 = human_actor_player_casual_unarmed_female_heroic;
        case human_actor_player_casual_armed_heroic :
            $bas3 = human_actor_player_casual_armed_female_heroic;
        case human_actor_player_casual_armed_two_handed_sword_heroic :
            $bas3 = human_actor_player_casual_armed_two_handed_sword_heroic_female;
        case human_actor_player_casual_armed_maul_heroic :
            $bas3 = human_actor_player_casual_armed_maul_heroic_female;
        case human_actor_player_casual_armed_spear_heroic :
            $bas3 = human_actor_player_casual_armed_spear_heroic_female;
        case human_actor_player_casual_armed_two_handed_crossbow_heroic :
            $bas3 = human_actor_player_casual_armed_two_handed_crossbow_heroic_female;
        case human_actor_player_casual_armed_bow_heroic :
            $bas3 = human_actor_player_casual_armed_bow_heroic_female;
        case human_actor_player_casual_armed_shield_heroic :
            $bas3 = human_actor_player_casual_armed_shield_heroic_female;
        case human_actor_player_casual_armed_whip_heroic :
            $bas3 = human_actor_player_casual_armed_whip_heroic_female;
    }
}
return($bas3);
