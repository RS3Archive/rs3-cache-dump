        cc_triggerop(1);
    } else if (if_hassuboverlay(toplevel_v2:moveable_modal_overlay, snapshot_main_v2) = true & (if_find(snapshot_main_v2:offence_window_close_button_layer) = true | if_find(snapshot_main_v2:name_list_window_close_button_layer) = true | if_find(snapshot_main_v2:ignore_window_close_button_layer) = true)) {
