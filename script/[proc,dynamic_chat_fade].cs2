// 6060
[proc,dynamic_chat_fade](int $int0)
def_boolean $boolean1 = false;
if ($int0 = 255) {
    $boolean1 = true;
}
if_settrans($int0, chatdefault:mobile_listener_graphic);
def_int $int2 = calc(if_getnextsubid(chatdefault:scrollarea) - 1);
while ($int2 >= 0) {
    if (cc_find(chatdefault:scrollarea, $int2) = true) {
        cc_settrans($int0);
        cc_sethide($boolean1);
    }
    $int2 = calc($int2 - 1);
}
if_sethide($boolean1, chatdefault:scrollarea);
$int2 = calc(if_getnextsubid(chatdefault:scrollbar) - 1);
while ($int2 >= 0) {
    if (cc_find(chatdefault:scrollbar, $int2) = true) {
        cc_settrans($int0);
        cc_sethide($boolean1);
    }
    $int2 = calc($int2 - 1);
}
if ($boolean1 = true) {
    if_setnoclickthrough(false, toplevel_v2:chat_window);
    if_setnoclickthrough(false, chatdefault:scrollbar);
    ~script3415(true, toplevel_v2:chat_window_border);
} else {
    if_setnoclickthrough(true, chatdefault:scrollbar);
    ~script1850(18, %toplevel_v2_allow_window_clickthrough);
}
if_sethide($boolean1, chatdefault:mobile_render_background);
