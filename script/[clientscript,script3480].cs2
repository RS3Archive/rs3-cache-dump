// 3480
[clientscript,script3480](component $component0, component $component1, component $component2, int $int3, int $int4)
def_int $int5 = if_getscrolly($component0);
if ($int3 = 1) {
    if ($int5 ! 0) {
        $int5 = max(calc($int5 - 6), 0);
        if_setscrollpos(0, $int5, $component0);
    }
    if ($int5 <= 0) {
        if_setscrollpos(0, 0, $component0);
        if_setontimer(null, $component0);
        if_sethide(false, $component1);
        if_sethide(false, $component2);
        return;
    }
} else {
    if ($int5 ! 300) {
        $int5 = min(calc($int5 + 6), 300);
        if_setscrollpos(0, $int5, $component0);
    }
    if ($int5 >= 300) {
        if_setscrollpos(0, 300, $component0);
        if_setontimer(null, $component0);
        if_sethide(false, $component1);
        if_sethide(false, $component2);
        return;
    }
}
if_sethide(true, $component1);
if_sethide(true, $component2);
if (calc(clientclock - $int4) >= 10) {
    sound_synth(ft_fairyrings, 1, 0);
    if_setontimer("script3480($component0, $component1, $component2, $int3, clientclock)", $component0);
}
