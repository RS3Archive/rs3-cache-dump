// 11927
[proc,script11927](stat $stat0)(int)
def_int $int1 = 1;
if (%pow_opportunity_active = 1) {
    switch_stat ($stat0) {
        case archaeology, mining :
            $int1 = calc($int1 + 1);
        case default :
            ~error("Invalid skill attempting to multiply - <enum(stat, string, stat_to_string, $stat0)>");
    }
}
return($int1);
