// 13153
[proc,script13153](component $component0)
if_list_setisselected(%emotes2_last_type, true, false, $component0);
def_component $component1 = emotes2:main;
def_component $component2 = emotes2:transmog;
def_component $component3 = emotes2:overhead;
if ($component0 = toplevel_v2_parent_suboverlay_emotes:emotes_category) {
    $component1 = toplevel_v2_parent_suboverlay_emotes:main;
    $component2 = toplevel_v2_parent_suboverlay_emotes:transmog;
    $component3 = toplevel_v2_parent_suboverlay_emotes:overhead;
}
if_sethide(true, $component1);
if_sethide(true, $component2);
if_sethide(true, $component3);
switch_int (%emotes2_last_type) {
    case 0 :
        if_sethide(false, $component1);
    case 1 :
        if_sethide(false, $component2);
    case 2 :
        if_sethide(false, $component3);
}
