// 5464
[proc,script5464]
if (%dom_battle_current_z >= 48) {
    if_setsize(if_getwidth(dom_battle_overlay:stats_layer), 105, ^setsize_abs, ^setsize_abs, dom_battle_overlay:stats_layer);
    if_setsize(if_getwidth(dom_battle_overlay:handicap_icons_layer), 72, ^setsize_abs, ^setsize_abs, dom_battle_overlay:handicap_icons_layer);
} else if (%dom_battle_current_z >= 24) {
    if_setsize(if_getwidth(dom_battle_overlay:stats_layer), 79, ^setsize_abs, ^setsize_abs, dom_battle_overlay:stats_layer);
    if_setsize(if_getwidth(dom_battle_overlay:handicap_icons_layer), 48, ^setsize_abs, ^setsize_abs, dom_battle_overlay:handicap_icons_layer);
} else if (%dom_battle_current_x > 0) {
    if_setsize(if_getwidth(dom_battle_overlay:stats_layer), 55, ^setsize_abs, ^setsize_abs, dom_battle_overlay:stats_layer);
    if_setsize(if_getwidth(dom_battle_overlay:handicap_icons_layer), 24, ^setsize_abs, ^setsize_abs, dom_battle_overlay:handicap_icons_layer);
} else {
    if_setsize(if_getwidth(dom_battle_overlay:stats_layer), 37, ^setsize_abs, ^setsize_abs, dom_battle_overlay:stats_layer);
    if_setsize(if_getwidth(dom_battle_overlay:handicap_icons_layer), 1, ^setsize_abs, ^setsize_abs, dom_battle_overlay:handicap_icons_layer);
}
