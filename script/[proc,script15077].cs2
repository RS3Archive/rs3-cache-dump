    case 2 :
        $string0 = "<$string0><br>- <col=ffffff>2h <sprite=14903>:</col> Swipe your weapon in front of you.";
        $string0 = "<$string0><br><col=969696>- 2x <sprite=14904>: Strike at the target with both weapons.</col>";
