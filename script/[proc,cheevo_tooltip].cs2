// 13319
[proc,cheevo_tooltip]
def_component $component0 = text_tooltip:tooltip_dynamic_text;
def_string $string0 = cc_param(toplevel_v2_tooltip_param_str0);
def_string $string1 = cc_param(toplevel_v2_tooltip_param_str1);
def_int $int1 = 0;
def_int $int2 = 490;
def_int $int3 = 0;
cc_create($component0, ^iftype_text, $int1);
cc_setposition(0, $int3, ^setpos_abs_centre, ^setpos_abs_top);
cc_setsize(parawidth($string0, $int2, museo_sans_13pt_bold), ~script7593($string0, $int2, museo_sans_13pt_bold, 0), ^setsize_abs, ^setsize_abs);
cc_settext($string0);
cc_settextfont(museo_sans_13pt_bold);
cc_setcolour(0xf0be79);
cc_settextalign(^settextalign_centre, ^settextalign_centre, 0);
$int1 = calc($int1 + 1);
$int3 = calc($int3 + cc_getheight + 2);
.cc_create($component0, ^iftype_text, $int1);
.cc_setposition(0, $int3, ^setpos_abs_centre, ^setpos_abs_top);
.cc_setsize(parawidth($string1, $int2, museo_sans_11pt_regular), ~script7593($string1, $int2, museo_sans_11pt_regular, 0), ^setsize_abs, ^setsize_abs);
.cc_settext($string1);
.cc_settextfont(museo_sans_11pt_regular);
.cc_setcolour(^white);
.cc_settextalign(^settextalign_centre, ^settextalign_centre, 0);
$int1 = calc($int1 + 1);
$int3 = calc($int3 + .cc_getheight + 2);
if_setsize(max(cc_getwidth, .cc_getwidth), $int3, ^setsize_abs, ^setsize_abs, $component0);
