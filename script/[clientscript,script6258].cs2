// 6258
[clientscript,script6258](component $component0, component $component1)
if (worldlist_fetch = true) {
    %friends_last_worldlist_fetch = clientclock;
    if_setontimer(null, $component0);
    if (activeclanchannel_find_affined(0) = true) {
        ~script4436(%clan_line_pos, $component1);
    }
    if (activeclanchannel_find_listened = true) {
        ~script6259(-1, $component1);
    }
}
