// 6766
[clientscript,script6766]
switch_int (map_lang) {
    case 0 :
        if_setgraphic(trh178_title_en, trh196_overlay:title);
    case 1 :
        if_setgraphic(trh178_title_de, trh196_overlay:title);
    case 2 :
        if_setgraphic(trh178_title_fr, trh196_overlay:title);
    case 3 :
        if_setgraphic(trh178_title_pt, trh196_overlay:title);
}
if_sethide(false, trh196_overlay:splash_screen);
if_sethide(true, trh196_overlay:universe);
~mtx_anim_preview(trh196_teleport_override_struct, trh196_overlay:dragger_layer, trh196_overlay:anim_layer, trh196_overlay:preview_layer, trh196_overlay:load_layer, 50, null);
if_setnpcmodel(trh196_peter_autumn, trh196_overlay:npc_model_1);
if_setmodelangle(0, 0, 0, 0, 0, 550, trh196_overlay:npc_model_1);
if_setmodelanim(combat_2012_casual_unarmed_idle, trh196_overlay:npc_model_1);
if_setnpcmodel(trh71_pet_of_autumn, trh196_overlay:npc_model_2);
if_setmodelangle(0, 0, 0, 0, 0, 300, trh196_overlay:npc_model_2);
if_setmodelanim(trh71_pet_of_seasons_idle, trh196_overlay:npc_model_2);
