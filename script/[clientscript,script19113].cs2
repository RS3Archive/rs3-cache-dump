[clientscript,script19113]
switch_int (map_lang) {
    case 0 :
        if_setgraphic(trh199_crafting_button_en, trh199_overlay:crafting_button_graphic);
    case 1 :
        if_setgraphic(trh199_crafting_button_de, trh199_overlay:crafting_button_graphic);
    case 2 :
        if_setgraphic(trh199_crafting_button_fr, trh199_overlay:crafting_button_graphic);
    case 3 :
        if_setgraphic(trh199_crafting_button_pt, trh199_overlay:crafting_button_graphic);
}
