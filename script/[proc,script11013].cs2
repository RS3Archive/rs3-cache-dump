// 11013
[proc,script11013](int $int0)(seq)
def_seq $seq1 = mtx83_player_nomad_outfit_idle_unarmed;
def_obj $obj2 = inv_getobj(worn_display_preview, 3);
if (%mtx_skill_anim_walk_override ! 1 & $int0 = 0 | %mtx_skill_anim_walk_override = 1 & $int0 = 1) {
    if ($int0 = 1) {
        if ($obj2 ! null) {
            return(bas_getanim_ready(struct_param(oc_param($obj2, weapon_category), combatv2_casual_bas)));
        } else {
            return(bas_getanim_ready(default_human));
        }
    }
    return(null);
}
if ($obj2 ! null) {
    switch_struct (oc_param($obj2, weapon_category)) {
        case combatv2_weapon_dagger, combatv2_weapon_shortsword, combatv2_weapon_longsword, combatv2_weapon_scimitar, combatv2_weapon_mace, combatv2_weapon_warhammer, combatv2_weapon_hatchet, combatv2_weapon_pickaxe, combatv2_weapon_battleaxe, combatv2_weapon_wand, combatv2_weapon_xbow, combatv2_weapon_throwndart, combatv2_weapon_thrownknife, combatv2_weapon_thrownaxe, combatv2_weapon_javelin, combatv2_weapon_grenade, combatv2_weapon_whip, combatv2_weapon_fists, combatv2_weapon_claw, combatv2_weapon_blowpipe :
            $seq1 = mtx83_player_nomad_outfit_idle_shield;
        case combatv2_weapon_2hsword, combatv2_weapon_spear, combatv2_weapon_halberd, combatv2_weapon_maul :
            $seq1 = mtx83_player_nomad_outfit_idle_2h_sword;
        case combatv2_weapon_bow, combatv2_weapon_chargebow, combatv2_weapon_2hxbow :
            $seq1 = mtx83_player_nomad_outfit_idle_bow;
        case combatv2_weapon_staff :
            $seq1 = mtx83_player_nomad_outfit_idle_staff;
    }
}
if (oc_param(inv_getobj(worn_display_preview, 5), combatv2_item_is_shield) = 1) {
    $seq1 = mtx83_player_nomad_outfit_idle_shield;
}
return($seq1);
