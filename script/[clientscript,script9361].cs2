// 9361
[clientscript,script9361](component $component0)
if (activeclansettings_find_affined(0) = true) {
    switch_component ($component0) {
        case clan_noticeboard_broadcast:event_1 :
            %clan_event_current_varp = 1;
        case clan_noticeboard_broadcast:event_2 :
            %clan_event_current_varp = 2;
        case clan_noticeboard_broadcast:event_3 :
            %clan_event_current_varp = 3;
        case clan_noticeboard_broadcast:event_4 :
            %clan_event_current_varp = 4;
        case clan_noticeboard_broadcast:event_5 :
            %clan_event_current_varp = 5;
        case clan_noticeboard_broadcast:event_6 :
            %clan_event_current_varp = 6;
        case clan_noticeboard_broadcast:event_7 :
            %clan_event_current_varp = 7;
        case clan_noticeboard_broadcast:event_8 :
            %clan_event_current_varp = 8;
    }
    if_settext("", clan_noticeboard_broadcast:broadcast_text);
    if_settext("", clan_noticeboard_broadcast:phrase);
    if_settext("", clan_noticeboard_broadcast:reltime_text);
    ~script9363;
}
