    cc_setonmouseover("graphic_swapper_dynamic(event_com, event_comsubid, $graphic9)");
    $graphic9 = "aif_audio_buttons_1,0";
    cc_setonmouseleave("graphic_swapper_dynamic(event_com, event_comsubid, $graphic9)");
    cc_create($component4, ^iftype_graphic, $int5);
