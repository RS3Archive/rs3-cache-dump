// 4552
[proc,friend_init](component $component0)
def_component $component1 = ~script3099($component0);
if_settext("Friends List<br>RuneScape <tostring(map_world)>", ~friends_title_text($component0));
if_setonfriendtransmit("friend_transmit($component0)", $component1);
if_setonplayergrouptransmit("friend_transmit($component0)", $component1);
if (worldlist_fetch = false) {
    if_setontimer("script6260($component0)", $component1);
}
%friend_lastfilter = "";
cc_deleteall(~script3099($component0));
cc_deleteall(~script10588($component0));
cc_deleteall(~friends_world_layer($component0));
cc_deleteall(~script11297($component0));
cc_deleteall(~script3098($component0));
