// 10126
[proc,script10126]
if (%varclientbit_23079 = 1) {
    if_setgraphic("rs3_btn_twitch_stop,0", interface_231:com_15);
} else {
    if_sethide(true, interface_231:com_5);
    if_setgraphic("rs3_btn_twitch_play,0", interface_231:com_15);
}
def_int $int0 = if_getwidth(interface_231:com_4);
if (parawidth(chat_playername, 2000, fontmetrics_28) > calc($int0 - (95 + parawidth(if_gettext(interface_231:com_13), 2000, fontmetrics_28)))) {
    if (if_gethide(interface_231:com_11) = false & %varclientbit_23071 = 0) {
        if_settrans(0, interface_231:com_11);
        if_setontimer("twitch_fade_text(interface_231:com_11, 1)", interface_231:com_11);
    }
} else if (if_gethide(interface_231:com_11) = true) {
    if_settrans(255, interface_231:com_11);
    if_sethide(false, interface_231:com_11);
    if_setontimer("twitch_fade_text(interface_231:com_11, 0)", interface_231:com_11);
}
