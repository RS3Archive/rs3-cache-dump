// 19112
[clientscript,script19112]
switch_int (map_lang) {
    case 0 :
        if_setgraphic(trh199_crafting_button_over_en, trh199_overlay:crafting_button_graphic);
    case 1 :
        if_setgraphic(trh199_crafting_button_over_de, trh199_overlay:crafting_button_graphic);
    case 2 :
        if_setgraphic(trh199_crafting_button_over_fr, trh199_overlay:crafting_button_graphic);
    case 3 :
        if_setgraphic(trh199_crafting_button_over_pt, trh199_overlay:crafting_button_graphic);
}
