// 3155
[clientscript,script3155](int $int0, int $int1)
switch_int ($int0) {
    case 1 :
        %incense_guam_potency = $int1;
    case 2 :
        %incense_tarromin_potency = $int1;
    case 3 :
        %incense_marrentill_potency = $int1;
    case 4 :
        %incense_harralander_potency = $int1;
    case 5 :
        %incense_ranarr_potency = $int1;
    case 6 :
        %incense_toadflax_potency = $int1;
    case 7 :
        %incense_spirit_potency = $int1;
    case 8 :
        %incense_irit_potency = $int1;
    case 9 :
        %incense_wergali_potency = $int1;
    case 10 :
        %incense_avantoe_potency = $int1;
    case 11 :
        %incense_kwuarm_potency = $int1;
    case 12 :
        %incense_bloodweed_potency = $int1;
    case 13 :
        %incense_snapdragon_potency = $int1;
    case 14 :
        %incense_cadantine_potency = $int1;
    case 15 :
        %incense_lantadyme_potency = $int1;
    case 16 :
        %incense_dwarf_potency = $int1;
    case 17 :
        %incense_torstol_potency = $int1;
    case 18 :
        %incense_fellstalk_potency = $int1;
    case default :
        ~error("Attempted to set potency for unexpected burner type: <tostring($int0)>");
}
