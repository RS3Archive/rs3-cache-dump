// 11134
[clientscript,script11134](component $component0)
if (%easter15_hatching_distraction >= 30) {
    if_setcolour(~script10495(6), $component0);
    if_settext("There are too many distractions!", $component0);
    return;
}
if (%easter15_hatching_angle > 700 | %easter15_hatching_angle < 300) {
    if_setcolour(~script10495(6), $component0);
    if_settext("The egg is leaning too far!", $component0);
    return;
}
if_setcolour(^white, $component0);
if (%easter15_hatching_distraction > 0) {
    if_settext("The imp has become distracted.", $component0);
    return;
}
if (%easter15_hatching_angle > 575 | %easter15_hatching_angle < 425) {
    if_settext("The egg is leaning.", $component0);
    return;
}
if_settext("The imp is making good progress.", $component0);
