// 20036
[proc,script20036]
switch_int (map_lang) {
    case 0 :
        if_setgraphic(trh210_title_en, interface_1340:com_2);
    case 1 :
        if_setgraphic(trh210_title_de, interface_1340:com_2);
    case 2 :
        if_setgraphic(trh210_title_fr, interface_1340:com_2);
    case 3 :
        if_setgraphic(trh210_title_pt, interface_1340:com_2);
}
if_sethide(false, interface_1340:com_0);
if_sethide(true, interface_1340:com_27);
if_sethide(true, interface_1253:com_8);
~script20039(interface_1340:com_19);
~script20039(interface_1340:com_11);
~script20039(interface_1340:com_112);
if_settext("Gather and spend <col=89CFF0>Loot</col> to choose between <col=89CFF0>Bonuses</col>.<br><br>These increase the <col=FF00>multipliers</col> or <col=8d52e5>rarities</col> of your prizes on the trail!<br><br>Multipliers can be increased to a maximum of <col=FF00>x4</col> and rarities to a maximum of <col=8d52e5>purple rarity</col>.", interface_1340:com_3);
