// 20036
[proc,script20036]
switch_int (map_lang) {
    case 0 :
        if_setgraphic(trh210_title_en, trh210_overlay:title);
    case 1 :
        if_setgraphic(trh210_title_de, trh210_overlay:title);
    case 2 :
        if_setgraphic(trh210_title_fr, trh210_overlay:title);
    case 3 :
        if_setgraphic(trh210_title_pt, trh210_overlay:title);
}
if_sethide(false, trh210_overlay:splash_screen);
if_sethide(true, trh210_overlay:universe);
if_sethide(true, wheel_of_fortune:chests_layer);
~script20039(trh210_overlay:min_tooltip_layer);
~script20039(trh210_overlay:plus_tooltip_layer);
~script20039(trh210_overlay:rarity_tooltip_layer);
if_settext("Gather and spend <col=89CFF0>Loot</col> to choose between <col=89CFF0>Bonuses</col>.<br><br>These increase the <col=FF00>multipliers</col> or <col=8d52e5>rarities</col> of your prizes on the trail!<br><br>Multipliers can be increased to a maximum of <col=FF00>x4</col> and rarities to a maximum of <col=8d52e5>purple rarity</col>.", trh210_overlay:desc);
