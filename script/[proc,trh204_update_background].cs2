// 19730
[proc,trh204_update_background]
if (~script19698 = 1) {
    if_setgraphic(trh204_background_bonus, wheel_of_fortune:background);
} else if (%trh204_reset > 1) {
    if_setgraphic(trh204_background_bonus, wheel_of_fortune:background);
} else {
    if_setgraphic(trh204_background, wheel_of_fortune:background);
}
