// 6713
[clientscript,script6713]
if (calc(%varclient_2016 + 3000) <= clientclock) {
    %varclient_2016 = clientclock;
    resend_uid_passport_request;
    if_settext("Another email has been sent to your registered address. Please follow the link to authorise your current device.", interface_744:com_343);
} else {
    if_settext("An email was sent to your registered address recently. Please wait a minute before trying to resend.", interface_744:com_343);
}
