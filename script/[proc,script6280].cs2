// 6280
[proc,script6280](int $int0)
if_sethide(true, cruc_rewards:jingles_layer);
if_sethide(true, cruc_rewards:titles_layer);
if_sethide(true, cruc_rewards:extra_layer);
if_sethide(true, cruc_rewards:titles_scroll_layer);
if_sethide(true, cruc_rewards:jingles_scroll_layer);
if_sethide(true, cruc_rewards:jingles_selected);
if_sethide(true, cruc_rewards:titles_selected);
if_sethide(true, cruc_rewards:extra_selected);
if ($int0 = 1) {
    if_settext("Taunt", cruc_rewards:reward_title);
    if_sethide(false, cruc_rewards:jingles_layer);
    if_sethide(false, cruc_rewards:jingles_scroll_layer);
    if_sethide(false, cruc_rewards:jingles_selected);
} else if ($int0 = 2) {
    if_settext("Title", cruc_rewards:reward_title);
    if_sethide(false, cruc_rewards:titles_layer);
    if_sethide(false, cruc_rewards:titles_scroll_layer);
    if_sethide(false, cruc_rewards:titles_selected);
} else {
