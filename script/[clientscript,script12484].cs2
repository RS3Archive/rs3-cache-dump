                $component9, $component10 = mm16_cases:build_misc, mm16_cases:click_misc;
            case 3 :
                $component9, $component10 = mm16_cases:build_people, mm16_cases:click_people;
            case 4 :
                $component9, $component10 = mm16_cases:build_item, mm16_cases:click_item;
            case default :
                return;
        }
        if (~date_runeday < $int7) {
            $graphic11 = db_getfield($dbrow8, mm16_task:col6, 0);
            if ($graphic11 = null) {
                $graphic11 = "mad_may_16_icon_case_generic,0";
            }
            $graphic12 = mad_may_16_icon_case_locked;
            $string0 = "You have not yet received enough details on this case.";
        } else if (~script12473($int2) = false) {
            $graphic11 = db_getfield($dbrow8, mm16_task:col6, 0);
            if ($graphic11 = null) {
                $graphic11 = "mad_may_16_icon_case_generic,0";
            }
            $graphic12 = mad_may_16_icon_case_locked;
            $string0 = "<$string1><br><br><~script12474($int2)>";
        } else if (~script12475($int2) = 1) {
            $graphic11 = db_getfield($dbrow8, mm16_task:col8, 0);
            if ($graphic11 = null) {
                $graphic11 = "mad_may_16_icon_case_generic,2";
            }
            $graphic12 = mad_may_16_icon_case_complete;
            $string0 = "<$string1><br><br>You have completed this case!";
        } else if ($int2 = %mm16_active_task) {
            $graphic11 = db_getfield($dbrow8, mm16_task:col7, 0);
            if ($graphic11 = null) {
                $graphic11 = "mad_may_16_icon_case_generic,1";
            }
            $graphic12 = null;
            $string0 = "<$string1><br><br>You are currently investigating this case.";
        } else {
            $graphic11 = db_getfield($dbrow8, mm16_task:col8, 0);
            if ($graphic11 = null) {
                $graphic11 = "mad_may_16_icon_case_generic,2";
            }
            $graphic12 = null;
            $string0 = "<$string1><br><br>This case is available to be investigated.";
        }
        $int5 = if_getnextsubid($component10);
        $int4 = calc($int5 / 6 * 60);
        $int3 = calc($int5 % 6 * 60);
        cc_create($component9, ^iftype_graphic, if_getnextsubid($component9));
        cc_setsize(50, 50, ^setsize_abs, ^setsize_abs);
        cc_setposition($int3, $int4, ^setpos_abs_left, ^setpos_abs_top);
        cc_setgraphic($graphic11);
        cc_create($component10, ^iftype_text, $int5);
        cc_setsize(50, 50, ^setsize_abs, ^setsize_abs);
