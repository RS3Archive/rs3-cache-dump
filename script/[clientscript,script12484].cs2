cc_deleteall(mm16_cases:build_item);
cc_deleteall(mm16_cases:click_pet);
cc_deleteall(mm16_cases:click_misc);
cc_deleteall(mm16_cases:click_people);
cc_deleteall(mm16_cases:click_item);
def_int $int0 = 0;
def_int $int1 = enum_getoutputcount(mm16_tasks);
def_int $int2 = 0;
def_int $int3 = 0;
def_int $int4 = 0;
def_int $int5 = 0;
def_int $int6 = 0;
def_int $int7 = 0;
def_dbrow $dbrow8 = null;
def_component $component9 = null;
def_component $component10 = null;
def_graphic $graphic11 = null;
def_graphic $graphic12 = null;
def_string $string0 = "";
def_string $string1 = "";
while ($int0 < $int1) {
    $int2 = enum(int, int, mm16_tasks, $int0);
    db_find(mm16_task:col0, $int2);
    $dbrow8 = db_findnext;
    if ($dbrow8 ! null) {
        $int6 = db_getfield($dbrow8, mm16_task:col1, 0);
