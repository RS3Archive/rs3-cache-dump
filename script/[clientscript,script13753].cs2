cc_create($component0, ^iftype_text, if_getnextsubid($component0));
cc_settext("In Autumn 2017 a new dimension rose, and many adventurers died. Here lies the names of the final 10 warriors left standing, who withstood the horde until the end.");
cc_settextfont(museo_sans_11pt_regular);
