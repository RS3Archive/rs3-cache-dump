// 4391
[proc,script4391](component $component0)
def_material $material1 = null;
def_material $material2 = null;
if (activeclansettings_find_affined(0) = true) {
    $material1, $material2 = ~clan_motif_decode(%clan_custom_motif_a_varp, %clan_custom_motif_b_varp, 0);
    if_setretex(0, clan_icon_generic_runestone_r, $material1, $component0);
    if_setretex(1, clan_icon_generic_runestone_s, $material2, $component0);
}
