// 4391
[proc,script4391](component $component0)
def_material $material1 = null;
def_material $material2 = null;
if (activeclansettings_find_affined(0) = true) {
    $material1, $material2 = ~clan_motif_decode(%varplayerbit_8965, %varplayerbit_8966, 0);
    if_setretex(0, material_735, $material1, $component0);
    if_setretex(1, material_642, $material2, $component0);
}
