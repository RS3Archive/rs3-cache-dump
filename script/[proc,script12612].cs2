// 12612
[proc,script12612](struct $struct0)(boolean)
def_component $component1 = null;
if (struct_param($struct0, toplevel_v2_window_allow_lightweight) = true) {
    $component1 = struct_param($struct0, toplevel_v2_window_layer);
    if ($component1 = null) {
        return(false);
    } else if (if_gettrans($component1) = 0) {
        return(struct_param($struct0, toplevel_v2_window_allow_tabs));
    } else {
        return(false);
    }
}
return(struct_param($struct0, toplevel_v2_window_allow_tabs));
