// 2467
[clientscript,script2467](component $component0, int $int1)
def_int $int2 = %friend_sort_mode;
switch_int ($int1) {
    case 1 :
        $int2 = calc(($int2 + 1) % (2 + 1));
    case 2 :
        $int2 = 0;
    case 3 :
        $int2 = 1;
    case 4 :
        $int2 = 2;
    case 5 :
        return;
}
%friend_sort_mode = $int2;
~script2470($component0, $int2, %friend_lastfilter);
