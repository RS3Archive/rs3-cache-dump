// 17522
[proc,script17522](npc $npc0)(string)
switch_npc ($npc0) {
    case default :
        ~error("necro_ritual_component_npc_to_name_get - no NPC name specified!");
        return("");
    case necro_ritual_glyph_elemental_i :
        return("Elemental I");
    case necro_ritual_glyph_elemental_ii :
        return("Elemental II");
    case necro_ritual_glyph_elemental_iii :
        return("Elemental III");
    case necro_ritual_glyph_reagent_i :
        return("Reagent I");
    case necro_ritual_glyph_reagent_ii :
        return("Reagent II");
    case necro_ritual_glyph_reagent_iii :
        return("Reagent III");
    case necro_ritual_glyph_commune_i :
        return("Commune I");
    case necro_ritual_glyph_commune_ii :
        return("Commune II");
    case necro_ritual_glyph_commune_iii :
        return("Commune III");
    case necro_ritual_glyph_change_i :
        return("Change I");
    case necro_ritual_glyph_change_ii :
        return("Change II");
    case necro_ritual_glyph_change_iii :
        return("Change III");
    case necro_ritual_glyph_multiply_i :
        return("Multiply I");
    case necro_ritual_glyph_multiply_ii :
        return("Multiply II");
    case necro_ritual_glyph_multiply_iii :
        return("Multiply III");
    case necro_ritual_glyph_speed_i :
        return("Speed I");
    case necro_ritual_glyph_speed_ii :
        return("Speed II");
    case necro_ritual_glyph_speed_iii :
        return("Speed III");
    case necro_ritual_glyph_protection_i :
        return("Protection I");
    case necro_ritual_glyph_protection_ii :
        return("Protection II");
    case necro_ritual_glyph_protection_iii :
        return("Protection III");
    case necro_ritual_glyph_attraction_i :
        return("Attraction I");
    case necro_ritual_glyph_attraction_ii :
        return("Attraction II");
    case necro_ritual_glyph_attraction_iii :
        return("Attraction III");
}
