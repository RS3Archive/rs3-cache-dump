// 17522
[proc,script17522](npc $npc0)(string)
switch_npc ($npc0) {
    case default :
        ~error("necro_ritual_component_npc_to_name_get - no NPC name specified!");
        return("");
    case npc_30434 :
        return("Elemental I");
    case npc_30436 :
        return("Elemental II");
    case npc_30438 :
        return("Elemental III");
    case npc_30440 :
        return("Reagent I");
    case npc_30442 :
        return("Reagent II");
    case npc_30444 :
        return("Reagent III");
    case npc_30446 :
        return("Commune I");
    case npc_30448 :
        return("Commune II");
    case npc_30450 :
        return("Commune III");
    case npc_30452 :
        return("Change I");
    case npc_30454 :
        return("Change II");
    case npc_30456 :
        return("Change III");
    case npc_30458 :
        return("Multiply I");
    case npc_30460 :
        return("Multiply II");
    case npc_30462 :
        return("Multiply III");
    case npc_30464 :
        return("Speed I");
    case npc_30466 :
        return("Speed II");
    case npc_30468 :
        return("Speed III");
    case npc_30470 :
        return("Protection I");
    case npc_30472 :
        return("Protection II");
    case npc_30474 :
        return("Protection III");
    case npc_30476 :
        return("Attraction I");
    case npc_30478 :
        return("Attraction II");
    case npc_30480 :
        return("Attraction III");
}
