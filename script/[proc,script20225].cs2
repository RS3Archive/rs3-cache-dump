// 20225
[proc,script20225]
~script20209(1, "League progression is separate to your regular RuneScape save. When the League ends, points and untradeable rewards will be transferred to your nominated RuneScape save.");
~script20211(0);
cc_deleteall(league_onboarding:contents_linking_l_scrolling);
cc_deleteall(league_onboarding:contents_linking_r_scrolling);
def_int $int0 = calc(if_getwidth(league_onboarding:contents_linking_l_inner) - 16);
def_int $int1 = 4;
def_int $int2 = 0;
if (if_find(league_onboarding:contents_linking_l_scrolling) = true) {
    ~script20226(league_onboarding:contents_linking_l_scrollbar, league_onboarding:contents_linking_l_scrolling, $int0, 1, 0, 44);
}
if (if_find(league_onboarding:contents_linking_r_scrolling) = true) {
    ~script20227(league_onboarding:contents_linking_r_scrollbar, league_onboarding:contents_linking_r_scrolling, $int0, 1, 0, 44);
}
