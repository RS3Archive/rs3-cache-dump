// 2889
[clientscript,script2889]
def_npc $npc0 = enum(int, npc, sfa_rogues, %sfa_rogue_type);
def_int $int1 = -1;
def_int $int2 = -1;
if ($npc0 ! null) {
    if (nc_param($npc0, sfa_huntedby1) ! null) {
        if_setmodel(enum(npc, model, sfa_fam_models, nc_param($npc0, sfa_huntedby1)), sfa:fam1);
        if_setmodelanim(enum(npc, seq, sfa_fam_anims, nc_param($npc0, sfa_huntedby1)), sfa:fam1);
        if_setgraphic(enum(npc, graphic, sfa_fam_graphic, nc_param($npc0, sfa_huntedby1)), sfa:graphic_fam1);
        if_settext(enum(npc, string, sfa_fam2string, nc_param($npc0, sfa_huntedby1)), sfa:fam1_text);
    }
    if (nc_param($npc0, sfa_huntedby2) ! null) {
        if_setmodel(enum(npc, model, sfa_fam_models, nc_param($npc0, sfa_huntedby2)), sfa:fam2);
        if_setmodelanim(enum(npc, seq, sfa_fam_anims, nc_param($npc0, sfa_huntedby2)), sfa:fam2);
        if_setgraphic(enum(npc, graphic, sfa_fam_graphic, nc_param($npc0, sfa_huntedby2)), sfa:graphic_fam2);
        if_settext(enum(npc, string, sfa_fam2string, nc_param($npc0, sfa_huntedby2)), sfa:fam2_text);
    }
    if_setgraphic(enum(npc, graphic, sfa_rogue_graphic, $npc0), sfa:graphic_you);
    if_setmodel(enum(npc, model, sfa_fam_models, $npc0), sfa:player);
    if_setmodelanim(enum(npc, seq, sfa_fam_anims, $npc0), sfa:player);
}
