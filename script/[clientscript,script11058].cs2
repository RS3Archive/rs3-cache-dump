// 11058
[clientscript,script11058]
if (%boss_instance_setup_protection_temp > 0 & struct_param(%boss_instance_struct, boss_instance_max_players) > 1) {
    if (%boss_instance_setup_protection_temp = 10000) {
        if_settext("Friends only", boss_instance:protection_text);
    } else if (%boss_instance_setup_protection_temp = 15000) {
        if_settext("Friends Chat only", boss_instance:protection_text);
    } else {
        if_settext("PIN: <tostring(%boss_instance_setup_protection_temp)>", boss_instance:protection_text);
    }
} else {
    if_settext("FFA", boss_instance:protection_text);
}
