// 16332
[clientscript,script16332]
if (calc(clientclock % 50) = 0) {
    if (++%trh164_promo_time_minuteseconds = 60) {
        %trh164_promo_time_minutes = calc(%trh164_promo_time_minutes - 1);
        %trh164_promo_time_minuteseconds = 0;
    }
    if_settext(~trh_promo_info_countdown_time(%trh164_promo_time_minutes, %trh164_promo_time_minuteseconds), wheel_of_fortune:countdown_text);
}
