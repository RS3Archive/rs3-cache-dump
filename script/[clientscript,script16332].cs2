// 16332
[clientscript,script16332]
if (calc(clientclock % 50) = 0) {
    if (++%varclient_7040 = 60) {
        %varclient_7039 = calc(%varclient_7039 - 1);
        %varclient_7040 = 0;
    }
    if_settext(~trh_promo_info_countdown_time(%varclient_7039, %varclient_7040), interface_1253:com_72);
}
