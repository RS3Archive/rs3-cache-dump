// 12217
[clientscript,trh82_update_display]
if (%trh82_currency >= 100) {
    if_setgraphic("trh82_icon_masquerade_mask,1", trh82_valentines:current_prize_unlocked_1);
    if_sethide(true, trh82_valentines:prize_1_fill);
}
if (%trh82_currency >= 300) {
    if_setgraphic("trh82_icon_masquerade_outfit,1", trh82_valentines:current_prize_unlocked_2);
    if_sethide(true, trh82_valentines:prize_2_fill);
}
if (%trh82_currency >= 600) {
    if_setgraphic("trh82_icon_masquerade_mask_wielded,1", trh82_valentines:current_prize_unlocked_3);
    if_sethide(true, trh82_valentines:prize_3_fill);
}
if (%trh82_currency >= 1000) {
    if_setgraphic("trh82_icon_goblin_butler,1", trh82_valentines:current_prize_unlocked_4);
    if_sethide(true, trh82_valentines:prize_4_fill);
}
if (%trh82_currency >= 2000) {
    if_setgraphic("trh82_icon_valentines_emote,1", trh82_valentines:current_prize_unlocked_5);
    if_sethide(true, trh82_valentines:prize_5_fill);
}
if (%trh82_currency >= 2500) {
    if_setgraphic("trh82_icon_valentines_staff,1", trh82_valentines:current_prize_unlocked_6);
    if_sethide(true, trh82_valentines:prize_6_fill);
}
