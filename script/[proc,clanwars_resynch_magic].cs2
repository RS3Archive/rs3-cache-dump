// 1775
[proc,clanwars_resynch_magic]
switch_int (%clanwars_rulevarc_nomagic) {
    case 0 :
        ~static_checkbox(clanwars_setup:magic_indicator, 1, false);
        if_setgraphic("options_radio_buttons,2", clanwars_setup:magic_indicator);
        if_sethide(false, clanwars_setup:magic_seren);
        if_sethide(false, clanwars_setup:magic_zaros);
        if_sethide(false, clanwars_setup:magic_lunar);
        if_sethide(false, clanwars_setup:magic_normal);
        if_sethide(false, clanwars_setup:magic_bse);
        if_settrans(0, clanwars_setup:magic);
    case 1 :
        ~static_checkbox(clanwars_setup:magic_indicator, 1, false);
        if_sethide(true, clanwars_setup:magic_seren);
        if_sethide(true, clanwars_setup:magic_zaros);
        if_sethide(true, clanwars_setup:magic_lunar);
        if_sethide(false, clanwars_setup:magic_normal);
        if_sethide(false, clanwars_setup:magic_bse);
        if (map_members = true) {
            if_settrans(225, clanwars_setup:magic);
        } else {
            if_settrans(0, clanwars_setup:magic);
        }
    case 2 :
        ~static_checkbox(clanwars_setup:magic_indicator, 1, false);
        if_sethide(true, clanwars_setup:magic_seren);
        if_sethide(true, clanwars_setup:magic_zaros);
        if_sethide(true, clanwars_setup:magic_lunar);
        if_sethide(true, clanwars_setup:magic_normal);
        if_sethide(false, clanwars_setup:magic_bse);
        if_settrans(225, clanwars_setup:magic);
    case 3 :
        ~static_checkbox(clanwars_setup:magic_indicator, 0, false);
        if_sethide(true, clanwars_setup:magic_seren);
        if_sethide(true, clanwars_setup:magic_zaros);
        if_sethide(true, clanwars_setup:magic_lunar);
        if_sethide(true, clanwars_setup:magic_normal);
        if_sethide(true, clanwars_setup:magic_bse);
        if_settrans(225, clanwars_setup:magic);
}
~script13529;
