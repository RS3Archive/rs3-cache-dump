// 3881
[clientscript,script3881]
if (stat(woodcutting) > stat_base(woodcutting)) {
    ~script10624(combatv2_woodcutting_nerfed_dummy_ability, 0);
    return;
} else if (stat(woodcutting) < stat_base(woodcutting)) {
    ~script10624(combatv2_woodcutting_nerfed_dummy_ability, 1);
    return;
}
~script10624(combatv2_woodcutting_nerfed_dummy_ability, 0);
