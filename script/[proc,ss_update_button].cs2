// 13782
[proc,ss_update_button](component $component0)
switch_component ($component0) {
    case ss_rework:slayer_xp_layer, ss_rework:slayer_ring_layer, ss_rework:runes_layer, ss_rework:bolts_layer, ss_rework:arrows_layer, ss_rework:upgrade1_layer, ss_rework:upgrade2_layer, ss_rework:upgrade3_layer, ss_rework:upgrade4_layer, ss_rework:soul_catcher_layer :
        ~script6406;
    case ss_rework:elf_fero_ring_layer :
        if (%elfcity_fero_ring_upgraded = 1) {
            ~script6406;
            ~ss_disable_button($component0, 1);
        }
    case ss_rework:fletch_layer :
        if (%smki_missile_make = 1) {
            ~script6408;
            ~ss_disable_button($component0, 1);
        }
    case ss_rework:craft_ring_layer :
        if (%smki_ring_make = 1) {
            ~script6408;
            ~ss_disable_button($component0, 1);
        }
    case ss_rework:helmet_layer :
        if (%smki_head_make = 1) {
            ~script6408;
            ~ss_disable_button($component0, 1);
        }
    case ss_rework:aquanites_layer :
        if (%smki_kuradal_aquanite = 1) {
            ~script6408;
        }
    case ss_rework:muspah_layer :
        if (%slayer_kuradel_muspah = 1) {
            ~script6408;
        }
    case ss_rework:nihil_layer :
        if (%slayer_kuradel_nihil = 1) {
            ~script6408;
        }
    case ss_rework:glacor_layer :
        if (%bslay_unlocked_glacors = 1) {
            ~script6408;
        }
    case ss_rework:tdemon_layer :
        if (%bslay_unlocked_tdemons = 1) {
            ~script6408;
        }
    case ss_rework:nightmare_layer :
        if (%fotg2_nightmare_task_unlocked = 1) {
            ~script6408;
        }
    case ss_rework:killing_blow_layer :
        if (%smki_autosmash_gargoyle = 1) {
            ~script6408;
            ~ss_disable_button($component0, 1);
        }
    case ss_rework:ice_strykewyrm_layer :
        if (%smki_ice_strykewyrm_nofire = 1) {
            ~script6408;
            ~ss_disable_button($component0, 1);
        }
    case ss_rework:fuse_layer :
        if (%njslay_bought_fused = 1) {
            ~script6408;
            ~ss_disable_button($component0, 1);
        }
    case ss_rework:food_layer :
        if (%ss_bought_food = 1) {
            ~script6413;
            ~ss_disable_button($component0, 1);
        }
    case ss_rework:aquanite_pet_layer :
        if (~script10881(lore_ss_aquanite_pet) = 1) {
            ~script6413;
            ~ss_disable_button($component0, 1);
        }
    case ss_rework:potion_layer :
        if (%ss_bought_potion = 1) {
            ~script6413;
            ~ss_disable_button($component0, 1);
        }
    case ss_rework:ice_pet_layer :
        if (testbit(%lore_followers_owned_2, calc(34 % 32)) = ^true) {
            ~script6413;
            ~ss_disable_button($component0, 1);
        }
    case ss_rework:recharge_ring_layer, ss_rework:recharge_helm_layer :
        ~script6413;
    case ss_rework:teleport_layer :
        if (%njslay_bought_teleports = 1) {
            ~script6413;
            ~ss_disable_button($component0, 1);
        }
    case ss_rework:divine_layer :
        if (%njslay_bought_divine = 1) {
            ~script6413;
            ~ss_disable_button($component0, 1);
        }
    case ss_rework:runt_pet_layer :
        if (~script10881(lore_ganodermic_runt_pet) = 1) {
            ~script6413;
            ~ss_disable_button($component0, 1);
        }
    case ss_rework:freezy_skin1_layer :
        if (%njslay_desert_skin = 1) {
            ~script6413;
            ~ss_disable_button($component0, 1);
        }
    case ss_rework:freezy_skin2_layer :
        if (%njslay_jungle_skin = 1) {
            ~script6413;
            ~ss_disable_button($component0, 1);
        }
    case ss_rework:freezy_skin3_layer :
        if (%njslay_wildy_skin = 1) {
            ~script6413;
            ~ss_disable_button($component0, 1);
        }
    case ss_rework:equip_share_layer :
        if (%njslay_bought_equipshare = 1) {
            ~script6413;
            ~ss_disable_button($component0, 1);
        }
    case ss_rework:cancel_current_layer :
        if (%slayer_count = 0 & %slayc_current_challenge = 0 & %slayc_morvran_challenge = 0 & %slayc_laniakea_challenge = 0) {
            ~script6410;
            ~ss_disable_button($component0, 1);
        }
    case ss_rework:never_again_layer :
        if (%slayer_count = 0) {
            ~script6410;
            ~ss_disable_button($component0, 1);
        }
    case ss_rework:extend_current_layer :
        if (%elfcity_slayer_task_extended = 1) {
            ~script6410;
            ~ss_disable_button($component0, 1);
        }
    case ss_rework:prefer_task_layer :
        if (%slayer_count = 0) {
            ~script6410;
            ~ss_disable_button($component0, 1);
            ~ss_disable_button(ss_rework:extend_current_layer, 1);
        }
    case ss_rework:removed_1 :
        if (%smki_ignore_flag_1 = 0) {
            ~script6410;
            ~script6415($component0);
        }
    case ss_rework:removed_2 :
        if (%smki_ignore_flag_2 = 0) {
            ~script6410;
            ~script6415($component0);
        }
    case ss_rework:removed_3 :
        if (%smki_ignore_flag_3 = 0) {
            ~script6410;
            ~script6415($component0);
        }
    case ss_rework:removed_4 :
        if (%smki_ignore_flag_4 = 0) {
            ~script6410;
            ~script6415($component0);
        }
    case ss_rework:removed_5 :
        if (%smki_ignore_flag_5 = 0) {
            ~script6410;
            ~script6415($component0);
        }
    case ss_rework:removed_6 :
        if (%smki_ignore_flag_6 = 0) {
            ~script6410;
            ~script6415($component0);
        }
    case ss_rework:removed_7 :
        if (%smki_ignore_flag_7 = 0) {
            ~script6410;
            ~script6415($component0);
        }
    case ss_rework:removed_8 :
        if (%smki_ignore_flag_8 = 0) {
            ~script6410;
            ~script6415($component0);
        }
    case ss_rework:preferred_1 :
        if (%smki_prefer_flag_1 = 0) {
            ~script6410;
            ~script6415($component0);
        }
    case ss_rework:preferred_2 :
        if (%smki_prefer_flag_2 = 0) {
            ~script6410;
            ~script6415($component0);
        }
    case ss_rework:preferred_3 :
        if (%smki_prefer_flag_3 = 0) {
            ~script6410;
            ~script6415($component0);
        }
    case ss_rework:preferred_4 :
        if (%smki_prefer_flag_4 = 0) {
            ~script6410;
            ~script6415($component0);
        }
    case ss_rework:preferred_5 :
        if (%smki_prefer_flag_5 = 0) {
            ~script6410;
            ~script6415($component0);
        }
    case ss_rework:preferred_6 :
        if (%smki_prefer_flag_6 = 0) {
            ~script6410;
            ~script6415($component0);
        }
    case ss_rework:preferred_7 :
        if (%smki_prefer_flag_7 = 0) {
            ~script6410;
            ~script6415($component0);
        }
    case ss_rework:preferred_8 :
        if (%smki_prefer_flag_8 = 0) {
            ~script6410;
            ~script6415($component0);
        }
    case ss_rework:bonecrusher_layer :
        if (%toolbelt_bonecrusher_bought = 1) {
            ~script6408;
            ~ss_disable_button($component0, 1);
        }
    case ss_rework:herbicide_layer :
        if (%toolbelt_herbicide_bought = 1) {
            ~script6408;
            ~ss_disable_button($component0, 1);
        }
    case ss_rework:seedicide_layer :
        if (%toolbelt_seedicide_bought = 1) {
            ~script6408;
            ~ss_disable_button($component0, 1);
        }
    case ss_rework:charming_imp_layer :
        if (%toolbelt_charming_imp_bought = 1) {
            ~script6408;
            ~ss_disable_button($component0, 1);
        }
    case ss_rework:gold_acc_layer :
        if (%toolbelt_gold_acc_bought = 1) {
            ~script6408;
            ~ss_disable_button($component0, 1);
        }
    case ss_rework:slayer_pod_management_layer :
        if (%slayer_pod_management_purchased = 1) {
            ~script6408;
            ~ss_disable_button($component0, 1);
        }
}
