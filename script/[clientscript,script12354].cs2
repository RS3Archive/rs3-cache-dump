// 12354
[clientscript,script12354]
if (%login_driverwarn_date >= date_runeday) {
    %login_driverwarn_date = 0;
    if_sethide(true, loginscreen:dont_show_again_checkbox);
} else {
    %login_driverwarn_date = calc(date_runeday + 90);
    if_sethide(false, loginscreen:dont_show_again_checkbox);
}
