// 1754
[clientscript,brew_buckets](component $component0, component $component1)
if (%brew_varc_buckets > 4) {
    if_setmodel(game_brew_if_bucket_on, $component0);
    if_setcolour(0x33ff00, $component1);
} else {
    if_setmodel(game_brew_if_bucket_off, $component0);
    if_setcolour(0x910000, $component1);
}
if_settext(tostring(%brew_varc_buckets), $component1);
