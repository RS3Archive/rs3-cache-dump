// 14090
[proc,script14090](obj $obj0)(obj)
switch_obj ($obj0) {
    case bronze_pickaxe :
        return(enum(int, obj, toolbelt_pickaxes, %toolbelt_pickaxe_level));
    case bronze_axe :
        return(enum(int, obj, toolbelt_hatchets, %toolbelt_hatchet_level));
    case bronze_mattock :
        return(enum(int, obj, toolbelt_mattocks, max(0, calc(%toolbelt_mattock - 1))));
    case arch_wingsuit_v1 :
        return(enum(int, obj, tool_priority_wingsuit, max(0, calc(%toolbelt_wingsuit - 1))));
    case machette :
        switch_int (%toolbelt_machette_level) {
            case 0 :
                return(machette);
            case 1 :
                return(machette_opal);
            case 2 :
                return(machette_jade);
            case 3 :
                return(machette_redtopaz);
        }
    case secateurs :
        if (%toolbelt_fairy_secateurs = 1) {
            return(fairy_enchanted_secateurs);
        } else {
            return(secateurs);
        }
    case slayerbelt_explosiveshaker :
        if (%toolbelt_fishing_explosive = 2) {
            return(slayerbelt_superexplosiveshaker);
        } else {
            return(slayerbelt_explosiveshaker);
        }
    case rand_pickaxe_1 :
        switch_int (%toolbelt_rand_pickaxe) {
            case 1 :
                return(rand_pickaxe_1);
            case 2 :
                return(rand_pickaxe_2);
            case 3 :
                return(rand_pickaxe_3);
            case 4 :
                return(rand_pickaxe_4);
            case 5 :
                return(rand_pickaxe_5);
            case 6 :
                return(rand_pickaxe_6);
            case 7 :
                return(rand_pickaxe_7);
            case 8 :
                return(rand_pickaxe_8);
            case 9 :
                return(rand_pickaxe_9);
            case 10 :
                return(rand_pickaxe_10);
            case 11 :
                return(rand_pickaxe_11);
        }
    case rand_hatchet_1 :
        switch_int (%toolbelt_rand_hatchet) {
            case 1 :
                return(rand_hatchet_1);
            case 2 :
                return(rand_hatchet_2);
            case 3 :
                return(rand_hatchet_3);
            case 4 :
                return(rand_hatchet_4);
            case 5 :
                return(rand_hatchet_5);
            case 6 :
                return(rand_hatchet_6);
            case 7 :
                return(rand_hatchet_7);
            case 8 :
                return(rand_hatchet_8);
            case 9 :
                return(rand_hatchet_9);
            case 10 :
                return(rand_hatchet_10);
            case 11 :
                return(rand_hatchet_11);
        }
    case incense_burner :
        switch_int (%toolbelt_incense_burner) {
            case 0 :
                return(incense_burner);
        }
}
return($obj0);
