// 9831
[proc,diango_search_timer](string $string0, int $int0, component $component1, component $component2, int $int3)
if ($int0 <= clientclock) {
    if (compare(%p_dialog_input, $string0) ! 0) {
        if (string_length(%p_dialog_input) > 0) {
            if ($int3 = 1) {
                if_sethide(false, bank:diango_inv);
            }
            if_setontimer(null, $component1);
            ~diango_search_item(%p_dialog_input, $component2);
        } else if ($int3 = 0) {
            ~diango_items($component2);
        }
    }
    $string0 = %p_dialog_input;
    $int0 = calc(clientclock + 10);
}
if_setontimer("diango_search_timer($string0, $int0, $component1, $component2, $int3)", $component1);
