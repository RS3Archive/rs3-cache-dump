// 9872
[proc,script9872](component $component0)
def_string $string0 = "";
if (%comlevel_potential_varc > comlevel_active) {
    $string0 = "<tostring(comlevel_active)>+<tostring(calc(%comlevel_potential_varc - comlevel_active))>";
} else {
    $string0 = tostring(comlevel_active);
}
$string0 = "Combat Lvl: <$string0>";
if (if_find($component0) = true) {
    if (paraheight($string0, cc_getwidth, cc_getfontmetrics) > 1 | parawidth($string0, cc_getwidth, cc_getfontmetrics) > cc_getwidth) {
        cc_settext("");
    } else {
        cc_settext($string0);
    }
}
