// 10863
[clientscript,script10863]
~elfcity_tele_hover(atelf_teleports:elfcity_tele_lletya, 0);
~elfcity_tele_hover(atelf_teleports:elfcity_tele_eluned, 0);
~elfcity_tele_hover(atelf_teleports:elfcity_tele_tyras, 0);
~elfcity_tele_hover(atelf_teleports:elfcity_tele_poison, 0);
~elfcity_tele_hover(atelf_teleports:elfcity_tele_death, 0);
~elfcity_tele_hover(atelf_teleports:elfcity_tele_elfcamp, 0);
~elfcity_tele_hover(atelf_teleports:elfcity_tele_resource, 0);
~elfcity_tele_hover(atelf_teleports:elfcity_tele_mushroom, 0);
def_string $string0 = "You can teleport to locations in the elven lands <tostring(%atelf_tele_charges)> more times today.";
if (%atelf_tele_charges = 1) {
    $string0 = "You can teleport to locations in the elven lands 1 more time today.";
}
if_settext($string0, atelf_teleports:elfcity_tele_charges);
~script8841(84, 1);
