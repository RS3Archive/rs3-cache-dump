// 6088
[proc,shop_blank_item](int $int0, int $int1)
def_component $component2 = shop_main:list_background;
def_component $component3 = shop_main:list_name;
def_component $component4 = shop_main:list_icon;
def_component $component5 = shop_main:list_currency;
def_component $component6 = shop_main:list_price;
def_component $component7 = shop_main:list_extra_icon;
if ($int1 = 1) {
    $component2 = shop_main:free_background;
    $component3 = shop_main:free_name;
    $component4 = shop_main:free_icon;
    $component5 = null;
    $component6 = shop_main:free_price;
    $component7 = shop_main:free_extra_icon;
}
cc_create($component2, ^iftype_graphic, $int0);
cc_create($component3, ^iftype_text, $int0);
cc_create($component4, ^iftype_graphic, $int0);
cc_create($component6, ^iftype_text, $int0);
if ($component5 ! null) {
    cc_create($component5, ^iftype_graphic, $int0);
}
cc_create($component7, ^iftype_graphic, $int0);
