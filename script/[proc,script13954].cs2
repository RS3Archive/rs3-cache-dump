// 13954
[proc,script13954]()(int)
switch_int (%trh72_sword_level) {
    case default :
        return(0);
    case 2 :
        return(1);
    case 3 :
        return(2);
    case 4 :
        if (stat_base(attack) >= 70) {
            return(3);
        }
        return(0);
    case 5 :
        if (stat_base(attack) >= 75) {
            return(4);
        } else if (stat_base(attack) >= 70) {
            return(3);
        }
        return(0);
}
