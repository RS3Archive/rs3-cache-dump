// 10093
[clientscript,sb_overlay_onload](component $component0)
if_settrans(255, $component0);
if_sethide(true, sb_overlay:qte_controls);
if_sethide(true, sb_overlay:progress_holder);
if_sethide(false, sb_overlay:buff_layer);
if_sethide(true, sb_overlay:buff_adds);
if_sethide(true, sb_overlay:buff_acid);
if_sethide(true, sb_overlay:buff_heal);
if_settrans(255, sb_overlay:low_detail_darkness);
