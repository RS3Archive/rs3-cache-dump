// 17195
[clientscript,script17195](component $component0, int $int1)
def_int $int2 = if_gettrans($component0);
if ($int1 = 0 & $int2 = 255) {
    if_setontimer(null, $component0);
    return;
}
if ($int1 = 1) {
    $int2 = max(calc($int2 - 5), 0);
} else {
    $int2 = min(calc($int2 + 5), 255);
}
if_settrans($int2, $component0);
if ($int1 = 1 & $int2 = 0) {
    if_setontimer("script17195($component0, 0)", $component0);
}
