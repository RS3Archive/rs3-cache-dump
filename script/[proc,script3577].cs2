// 3577
[proc,script3577](obj $obj0)(string)
switch_obj ($obj0) {
    case barrows_torag_head :
        return("A Barrows item");
    case sniper_bolts_op_e :
        return("Some Opal - Ruby bakriminel bolts");
    case sniper_bolts_di_e :
        return("Some Diamond - Hydrix bakriminel bolts");
    case white_platebody :
        return("Some White knight armour");
    case dagganoth_melee_helm :
        return("A Rock-shell, Spined, or Skeletal armour piece");
    case viking_helmet :
        return("One of the Fremennik helms");
    case onyx :
        return("A chance at obtaining an onyx");
    case lore_pest_shifter_token :
        return("Shifter, Ravager, Torcher or Spinner Charms");
    case banana :
        return("A chance at obtaining a banana themed cosmetic");
    case default :
        return(oc_name($obj0));
}
