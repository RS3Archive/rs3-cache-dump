// 20207
[proc,script20207]
if_sethide(true, league_parent_areas:area_list);
if_sethide(true, league_parent_areas:map);
if_sethide(true, league_parent_areas:map_overview);
~cc_add_text(league_parent_areas:map_area, 0, 0, 0, ^setpos_abs_left, ^setpos_abs_top, 0, 0, ^setsize_minus, ^setsize_minus, text_title_section, "Area selection unavailable.");
if_setontimer(null, league_parent_areas:locality_highlight);
if_setparam_int(league_area_last_mouserepeat, -1, league_parent_areas:locality_highlight);
