// 4672
[proc,fremsaga_reward_setup_head](int $int0)
def_npc $npc1 = null;
switch_int ($int0) {
    case 1 :
        $npc1 = npc_7820;
    case 2 :
        $npc1 = npc_9051;
        if_setmodelanim(seq_9804, interface_102:com_31);
        if_setmodelzoom(2500, interface_102:com_31);
    case 4, 6 :
        $npc1 = npc_4897;
    case 3 :
        $npc1 = npc_15373;
        if_setmodelanim(seq_9804, interface_102:com_31);
}
if_setnpchead($npc1, interface_102:com_31);
