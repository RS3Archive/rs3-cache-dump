// 4672
[proc,fremsaga_reward_setup_head](int $int0)
def_npc $npc1 = null;
switch_int ($int0) {
    case 1 :
        $npc1 = fremsaga_signature_ozan;
    case 2 :
        $npc1 = fremsaga_forgotten_warrior_player;
        if_setmodelanim(human_update_chathead_neutral_idle, fremsaga_reward:face);
        if_setmodelzoom(2500, fremsaga_reward:face);
    case 4, 6 :
        $npc1 = fremsaga_thok;
    case 3 :
        $npc1 = fremsaga_npc_moia_uncharged;
        if_setmodelanim(human_update_chathead_neutral_idle, fremsaga_reward:face);
}
if_setnpchead($npc1, fremsaga_reward:face);
