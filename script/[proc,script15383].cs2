// 15383
[proc,script15383](component $component0, graphic $graphic1, graphic $graphic2)
cc_create($component0, ^iftype_graphic, if_getnextsubid($component0));
if (~script6431 = true) {
    cc_setsize(50, 50, ^setsize_abs, ^setsize_abs);
    cc_setposition(0, -1, ^setpos_abs_left, ^setpos_abs_centre);
    cc_setgraphic($graphic1);
} else {
    switch_graphic ($graphic2) {
        case rs3_tutsys_mouse_wheel :
            cc_setsize(30, 40, ^setsize_abs, ^setsize_abs);
            cc_setposition(8, -1, ^setpos_abs_left, ^setpos_abs_centre);
        case "rs3_tutsys_mouse_buttons,0", "rs3_tutsys_mouse_buttons,1", "rs3_tutsys_mouse_buttons,2", "rs3_tutsys_mouse_buttons,3", "rs3_tutsys_mouse_buttons,4" :
            cc_setsize(31, 40, ^setsize_abs, ^setsize_abs);
            cc_setposition(8, 0, ^setpos_abs_left, ^setpos_abs_centre);
        case default :
            cc_setsize(50, 50, ^setsize_abs, ^setsize_abs);
            cc_setposition(0, -1, ^setpos_abs_left, ^setpos_abs_centre);
    }
    cc_setgraphic($graphic2);
}
cc_setnoclickthrough(false);
