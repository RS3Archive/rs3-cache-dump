// 20419
[proc,script20419](quest $quest0, int $int1)(int)
if (quest_param($quest0, quest_timeline_category) ! -1) {
    return(quest_param($quest0, quest_timeline_category));
} else if (quest_param($quest0, quest_age) = 3 & quest_param($quest0, quest_id) <= 321) {
    return(7);
} else if (quest_param($quest0, quest_release_year) >= 2022 & quest_param($quest0, quest_age) ! 2) {
    return(8);
} else {
    switch_int ($int1) {
        case 0 :
            if (quest_statreq_count($quest0) = 0 & quest_questreq_count($quest0) = 0 & quest_param($quest0, quest_requires_comlevel) = 0 & quest_pointsreq($quest0) = 0 | $quest0 = ozan2 | $quest0 = ariane2) {
                return(1);
            } else {
                return(2);
            }
        case 1 :
            return(3);
        case 2, 5 :
            return(4);
        case 3 :
            return(5);
        case 4 :
            return(6);
    }
}
