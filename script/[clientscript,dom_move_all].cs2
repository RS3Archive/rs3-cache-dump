// 5430
[clientscript,dom_move_all]
def_int $int0 = 0;
if (%dom_move_mode = 1) {
    if (%dom_start_slowdown = 1 & calc(clientclock % 50) = 0) {
        %dom_spin_speed = calc(%dom_spin_speed + 1);
    }
    if (calc(clientclock % %dom_spin_speed) = 0) {
        $int0 = ~dom_move_icon(0);
        if ($int0 = 0) {
            return;
        }
        $int0 = ~dom_move_icon(1);
        if ($int0 = 0) {
            return;
        }
        $int0 = ~dom_move_icon(2);
        if ($int0 = 0) {
            return;
        }
    }
} else if (%dom_move_mode = 2 & calc(clientclock % %dom_spin_speed) = 0) {
    $int0 = ~dom_move_icon(0);
    if ($int0 = 0) {
        return;
    }
    $int0 = ~dom_move_icon(1);
    if ($int0 = 0) {
        return;
    }
    $int0 = ~dom_move_icon(2);
    if ($int0 = 0) {
        return;
    }
}
