// 2576
[clientscript,script2576](component $component0)
def_string $string0 = "";
switch_component ($component0) {
    case interface_781:com_21, interface_781:com_29 :
        $string0 = "How much time is left for this round.";
    case interface_781:com_22, interface_781:com_30 :
        $string0 = "How many orbs the green team have captured this round.";
    case interface_781:com_31, interface_781:com_23 :
        $string0 = "How many orbs the yellow team have captured this round.";
    case interface_781:com_25, interface_781:com_33 :
        $string0 = "How active you have been during this round.";
    case default :
        return;
}
~script8800($string0, $component0, -1);
