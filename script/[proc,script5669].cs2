// 5669
[proc,script5669]
if_settext(struct_param(%investigation, investigate_info_text_general), investigate:info_text);
cc_deleteall(investigate:information);
cc_create(investigate:information, ^iftype_text, 0);
cc_setsize(0, 0, ^setsize_minus, ^setsize_minus);
cc_setposition(0, 0, ^setpos_abs_left, ^setpos_abs_top);
cc_settext(struct_param(%investigation, investigate_instructions));
cc_settextfont(museo_sans_11pt_regular_multiline);
cc_setcolour(~script10495(3));
cc_settextalign(^settextalign_left, ^settextalign_top, 0);
if_settext(struct_param(%investigation, investigate_info_text_secondary), investigate:secondary_info_text);
