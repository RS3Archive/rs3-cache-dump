// 6596
[clientscript,peng_pow_update_overlay](int $int0)
def_int $int1 = clientclock;
def_int $int2 = 0;
if ($int1 >= calc($int0 + 200) | $int0 = 0) {
    $int0 = $int1;
    ~script6598(peng_pow_sub_overlay:healthbar_gradient_1, %peng_pow_guns_client, 100);
    ~script6598(peng_pow_sub_overlay:healthbar_gradient_2, %peng_pow_engine_client, 100);
    ~script6598(peng_pow_sub_overlay:healthbar_gradient_3, %peng_pow_windows_client, 100);
    ~script6598(peng_pow_sub_overlay:healthbar_gradient_4, %peng_pow_pump_client, 100);
    ~script6598(peng_pow_sub_overlay:healthbar_gradient_5, %peng_pow_sonar_client, 100);
    ~script6599(peng_pow_sub_overlay:healthbar_gradient_6, %peng_pow_sub_health_client, %peng_pow_sub_health_max_client);
}
if_setontimer("peng_pow_update_overlay($int0)", peng_pow_sub_overlay:health);
