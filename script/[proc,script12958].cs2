// 12958
[proc,script12958](component $component0)
if (~script12950 = true) {
    if_settext("This weekend you can reset the Mazcab raid once every 24 hours instead of every 48 hours.<br>Ensure you wish to reset your progress before you continue!", $component0);
} else {
    if_settext("You can only reset the Mazcab raid once every 48 hours.<br>Ensure you wish to reset your progress before you continue!", $component0);
}
