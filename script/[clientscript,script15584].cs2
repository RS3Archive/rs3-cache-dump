// 15584
[clientscript,script15584]
sound_vorbis_volume(tut7_login_difficulty_set_mode, 1, 0, 255);
if (%ironman_comsubid = 1 & %ironman_difficulty_select = 0) {
    %ironman_difficulty_select = 1;
} else {
    %ironman_selection_temp = %ironman_comsubid;
    if_sethide(true, acc_create:game_mode);
}
~script15585;
