// 3202
[proc,script3202](int $int0)(string)
switch_int ($int0) {
    case 1 :
        return("White reward or higher!");
    case 2 :
        return("Yellow reward or higher!");
    case 3 :
        return("Orange reward or higher!");
    case 4 :
        return("Red reward or higher!");
    case 5 :
        return("Purple or Ultra-Rare reward!");
    case 7 :
        return("Ultra-Rare reward!");
}
