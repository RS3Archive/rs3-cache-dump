// 20182
[clientscript,script20182](int $int0)
def_int $int1 = calc(clientclock - $int0);
if_sethide(true, league_info_popup:flash);
if ($int1 < 50) {
    ~script20183(calc(255 - scale(255, 50, $int1)));
} else if ($int1 >= 50 & $int1 < 150) {
    if_sethide(true, league_info_popup:flash);
} else if ($int1 >= 150 & $int1 < 200) {
    $int1 = calc(255 - scale(255, 50, calc(200 - $int1)));
    ~script20183($int1);
}
