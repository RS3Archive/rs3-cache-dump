// 3109
[proc,script3109](int $int0, int $int1, int $int2)(string)
def_string $string0 = "Fairy Ring";
def_string $string1 = "Code: ? ? ?";
if (~script20175 = false) {
    $string1 = "Gain access to the Fairy Ring network by completing the quest:<br>'Fairy Tale II - Cure a Queen'";
} else if ($int0 = 500) {
    $string1 = "";
} else if ($int0 = 330 & %player_fort_building_grove < 2) {
    $string1 = "Requires tier <tostring(2)> Grove Cabin.";
} else if (~script3104($int0) = true & ~script3101($int0) = 1) {
    $string1 = "Code: <enum(int, string, fairyring_id_to_code, $int0)>";
}
if (string_length($string1) > 0) {
    return("<$string0><br><$string1>");
}
return($string0);
