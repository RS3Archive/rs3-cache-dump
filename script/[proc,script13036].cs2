// 13036
[proc,script13036]
def_int $int0 = calc(%bxp_tailoff_xp_gained / 500000);
def_int $int1 = calc(200 - $int0 * 5);
if (~script13083 = false) {
    if (map_members = true) {
        $int1 = 200;
    } else {
        $int1 = 120;
    }
    if (%gameblast18_boost_end_client > date_minutes) {
        if (map_members = true) {
            $int1 = 220;
        } else {
            $int1 = 125;
        }
    }
}
if_setgraphic(~script13037(calc($int1 / 100)), bxp_countdown:bxp_number_x00);
if_setgraphic(~script13037(calc($int1 / 10 % 10)), bxp_countdown:bxp_number_0x0);
