// 15506
[proc,trh173_get_op_text](component $component0, int $int1)(string)
def_int $int2 = enum(component, int, trh173_mosaic_crystals_click_layer_to_id, $component0);
def_obj $obj3 = null;
def_int $int4 = -1;
switch_component ($component0) {
    case trh173_overlay:gem_click_layer_1, trh173_overlay:gem_click_layer_2, trh173_overlay:gem_click_layer_3, trh173_overlay:gem_click_layer_4, trh173_overlay:gem_click_layer_5, trh173_overlay:gem_click_layer_6, trh173_overlay:gem_click_layer_7, trh173_overlay:gem_click_layer_8, trh173_overlay:gem_click_layer_9, trh173_overlay:gem_click_layer_10 :
        $obj3 = ~script15472($int2);
        if ($obj3 ! null & ~trh173_get_gem_claim_state($int2) = false) {
            return("Select <oc_name($obj3)>");
        } else {
            return("Select Gem (Already claimed)");
        }
    case trh173_overlay:line_reward_holder_1, trh173_overlay:line_reward_holder_2, trh173_overlay:line_reward_holder_3, trh173_overlay:line_reward_holder_4, trh173_overlay:line_reward_holder_5, trh173_overlay:line_reward_holder_6, trh173_overlay:line_reward_holder_7 :
        if (~script15476($int2) = true) {
            return("View reward (Already claimed)");
        } else {
            return("View reward");
        }
    case trh173_overlay:reset_button_click, trh173_overlay:refresh_confirmation_button :
        return("Refresh prizes");
    case trh173_overlay:refresh_confirmation_close_button, trh173_overlay:refresh_abort_button, trh173_overlay:refresh_confirmation_transparency :
        return("Cancel refresh");
    case trh173_overlay:progression_holder_click_layer_1, trh173_overlay:progression_holder_click_layer_2, trh173_overlay:progression_holder_click_layer_3, trh173_overlay:progression_holder_click_layer_4, trh173_overlay:progression_holder_click_layer_5, trh173_overlay:progression_holder_click_layer_6, trh173_overlay:progression_holder_click_layer_7, trh173_overlay:progression_holder_click_layer_8, trh173_overlay:progression_holder_click_layer_9, trh173_overlay:progression_holder_click_layer_10 :
        if (~script15473(calc($int2 - 1)) = 1) {
            return("View reward (Already claimed)");
        } else {
            return("View reward");
        }
}
return("");
