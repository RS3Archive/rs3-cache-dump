// 941
[clientscript,ariane1_organ_interface_setup](int $int0)
if_sethide(true, ariane1_organ_keyboard:basement_key);
%ariane1_organ_note_1 = 0;
%ariane1_organ_note_2 = 0;
%ariane1_organ_note_3 = 0;
%ariane1_organ_note_4 = 0;
%ariane1_organ_note_5 = 0;
%ariane1_organ_note_6 = 0;
%ariane1_organ_note_7 = 0;
%ariane1_organ_note_8 = 0;
%ariane1_organ_note_9 = 0;
%ariane1_organ_note_10 = 0;
%ariane1_organ_note_11 = 0;
%ariane1_organ_note_12 = 0;
%ariane1_organ_note_13 = 0;
%ariane1_organ_note_14 = 0;
%ariane1_organ_note_15 = 0;
%ariane1_organ_note_16 = 0;
%ariane1_organ_note_17 = 0;
%ariane1_organ_note_18 = 0;
%ariane1_organ_note_19 = 0;
if (%ariane1_quest >= 70 & %ariane1_quest < 100 & inv_total(inv, ariane1_magic_music_book) > 0 & inv_total(inv, ariane1_magic_music_book) > 0) {
    if_sethide(false, ariane1_organ_keyboard:pages_layer);
    switch_int (map_lang) {
        case 1 :
            if_setgraphic(aif_ariane_organ_notes_de, ariane1_organ_keyboard:pages_graphic);
        case 2 :
            if_setgraphic(aif_ariane_organ_notes_fr, ariane1_organ_keyboard:pages_graphic);
        case default :
            if_setgraphic(aif_ariane_organ_notes, ariane1_organ_keyboard:pages_graphic);
    }
} else {
    if_sethide(true, ariane1_organ_keyboard:pages_layer);
}
