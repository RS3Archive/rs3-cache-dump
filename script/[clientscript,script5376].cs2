// 5376
[clientscript,script5376]
def_int $int0 = 0;
while ($int0 < 8) {
    if (cc_find(agidad_overlay:foreground, calc($int0 * 6 + 3)) = true) {
        cc_setontimer(null);
    }
    if (cc_find(agidad_overlay:foreground, calc($int0 * 6 + 4)) = true) {
        cc_setontimer(null);
    }
    if (cc_find(agidad_overlay:foreground, calc($int0 * 6 + 5)) = true) {
        cc_setontimer(null);
    }
    $int0 = calc($int0 + 1);
}
