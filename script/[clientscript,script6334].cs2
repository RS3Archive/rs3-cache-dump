// 6334
[clientscript,script6334](component $component0)
def_int $int1 = inv_size(inv);
def_int $int2 = calc((if_getwidth($component0) - 4 * 36) / 3);
def_int $int3 = calc((if_getheight($component0) - 7 * 32) / 6);
def_int $int4 = 0;
while ($int4 < $int1) {
    cc_create($component0, ^iftype_graphic, $int4);
    cc_setsize(36, 32, ^setsize_abs, ^setsize_abs);
    cc_setposition(calc($int4 % 4 * (36 + $int2)), calc($int4 / 4 * (32 + $int3)), ^setpos_abs_left, ^setpos_abs_top);
    cc_setoutline(1);
    $int4 = calc($int4 + 1);
}
if_setoninvtransmit("script6335(event_com, $int1){inv}", $component0);
~script6336($component0, $int1);
