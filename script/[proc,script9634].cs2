// 9634
[proc,script9634](component $component0, int $int1, int $int2)
cc_setposition(cc_getx, calc(cc_gety + $int2), ^setpos_abs_left, ^setpos_abs_top);
def_int $int3 = 1;
while ($int3 < 5 & cc_find($component0, calc($int1 + $int3)) = true) {
    cc_setposition(cc_getx, calc(cc_gety + $int2), ^setpos_abs_left, ^setpos_abs_top);
    $int3 = calc($int3 + 1);
}
