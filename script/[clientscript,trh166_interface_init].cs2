    $obj1, $int2, $int3 = ~trh166_get_gem_info($int0);
    if_setobject($obj1, $int2, enum(int, component, trh166_id_to_prize_component, $int0));
    if_setgraphic(enum(int, graphic, trh_rarity_to_gem_graphic, $int3), enum(int, component, trh166_id_to_gem_component, $int0));
    ~script3923($int0);
    cc_create(wheel_of_fortune:fake_op, ^iftype_graphic, $int0);
