// 14777
[clientscript,script14777](component $component0, component $component1)
def_int $int2 = 0;
switch_component ($component0) {
    case collection_log:share_local_checkbox_selected_layer :
        $int2 = %itemlog_share_local;
    case collection_log:share_friends_checkbox_selected_layer :
        $int2 = %itemlog_share_friends;
    case collection_log:share_clan_checkbox_selected_layer :
        $int2 = %itemlog_share_clan;
    case collection_log:share_guest_clan_checkbox_selected_layer :
        $int2 = %itemlog_share_guest_clan;
}
if ($int2 = 1) {
    if_sethide(false, $component0);
    if_sethide(true, $component1);
} else {
    if_sethide(true, $component0);
    if_sethide(false, $component1);
}
