// 18178
[proc,script18178](int $int0)
def_dbrow $dbrow1 = db_findnext;
mes_typed(^chattype_console, 0, "Found <tostring($int0)> cosmetics.");
mes_typed(^chattype_console, 0, "The first <tostring(min(10, $int0))> found are:");
def_int $int2 = 10;
while ($int2-- > 0 & $dbrow1 ! null) {
    mes_typed(^chattype_console, 0, db_getfield($dbrow1, mtxmgt_cosmetic:col2, 0));
    $dbrow1 = db_findnext;
}
