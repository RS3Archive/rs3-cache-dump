            case 165 :
                if (~map_members = true & %combatv2_ability_magic_greater_sonic_wave_unlocked = 1 & stat_base(magic) >= struct_param(combatv2_ability_magic_greater_sonic_wave, combatv2_ability_level_req)) {
                    return(2);
                } else {
                    return(1);
                }
            case 1 :
                if (~map_members = true & ~script15411(combatv2_ability_magic_blood_tithe_wrack) = 1) {
