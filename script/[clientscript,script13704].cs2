// 13704
[clientscript,script13704](component $component0)
if (if_find($component0) = true) {
    switch_int (%trh128_golden_glow_rarity) {
        case 1 :
            cc_setcolour(0xfdff00);
        case 2 :
            cc_setcolour(0xffa700);
        case 3 :
            cc_setcolour(^red);
    }
    cc_setontimer("script12631(event_com, event_comsubid)");
    cc_setparam(rs3tli_component_transparency_type, 1);
    cc_setparam(rs3tli_component_transparency_playback_rate, 150);
    cc_setparam(rs3tli_component_transparency_min, 30);
    cc_setparam(rs3tli_component_transparency_max, 100);
}
