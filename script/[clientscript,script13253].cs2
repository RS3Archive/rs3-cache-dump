[clientscript,script13253]
def_int $intarray0(400);
def_int $intarray1(400);
def_int $int0 = 0;
def_int $int1 = friend_count;
if ($int1 <= 0) {
    return;
}
def_int $int2 = 0;
while ($int2 < 400) {
    $intarray0($int2) = $int2;
    if (friend_getworld($int2) > 0) {
        $intarray1($int2) = 1;
        $int0 = calc($int0 + 1);
    } else {
        $intarray1($int2) = 0;
    }
    $int2 = calc($int2 + 1);
}
def_string $string0 = "";
def_string $string1 = "";
if ($int0 > 0) {
    $int1 = $int0;
    array_sort(400, 1, 0);
    $string0, $string1 = friend_getname($intarray0(calc(400 - random($int1) - 1)));
} else {
    $string0, $string1 = friend_getname(random($int1));
}
def_string $string2 = "";
