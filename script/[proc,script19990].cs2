// 19990
[proc,script19990]
def_string $string0 = "Your Android device is running a 32-bit version of RuneScape. We will be dropping support for this architecture by the end of Q3 2025. By shifting our attention to 64-bit devices, we can unlock improved performance, increase efficiency and an overall smoother experience for players.";
if_settext($string0, loginscreen:32bit_warning_text);
if_settext("Okay", loginscreen:32bit_warning_okay);
%login_32bit_warning_date = ~date_runeday;
