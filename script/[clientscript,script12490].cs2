// 12490
[clientscript,script12490](component $component0, component $component1)
def_string $string0 = "";
switch_component ($component1) {
    case mm16_cases:item_graphic_1 :
        if_setobject_nonum(mm16_sock_puppet, 1, $component1);
        $string0 = "You will receive:<br>A sock puppet. When worn, this has a random chance to replace your chathead in dialogue boxes.";
    case mm16_cases:item_graphic_2 :
        if_setobject_nonum(mm16_ports_resource_pack, 1, $component1);
        $string0 = "You will receive:<br>1 x Player Owned Ports resource pack<br>2 x Captain reroll token<br>2 x Voyage reroll token<br>2 x Crew reroll token";
    case mm16_cases:item_graphic_3 :
        if_setobject_nonum(mm16_investigator_head, 1, $component1);
        $string0 = "You will receive:<br>An investigator outfit, complete with fedora and trenchcoat.";
    case mm16_cases:item_graphic_4 :
        if_setobject_nonum(mm16_turoth_pet, 1, $component1);
        $string0 = "You will receive:<br>A turoth pet - wearing socks. It can be activated from your pets window.";
    case mm16_cases:item_graphic_5 :
        if_setobject_nonum(generic_lamp_large, 1, $component1);
        $string0 = "You will receive:<br>1 x Large XP lamp<br>1 x Large XP star";
    case mm16_cases:item_graphic_6 :
        if_setobject_nonum(generic_lamp_huge, 1, $component1);
        $string0 = "You will receive:<br>1 x Huge XP lamp<br>1 x Huge XP star";
}
if_setonmouserepeat("script8799($string0, event_com, event_comsubid)", $component0);
