// 2754
[clientscript,script2754]
if (%stock_offeritem = null | %stock_offeritem ! %stock_buylimit_offeritem) {
    return;
} else if (%stock_offertype = 0 & %stock_offercount_visible <= calc(^max_32bit_int - %stock_buylimit)) {
    %stock_offercount_visible = calc(%stock_offercount_visible + %stock_buylimit);
}
~script15038(%stock_offercount_visible, %stock_offerprice_visible, 1);
