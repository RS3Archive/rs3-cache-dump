[proc,script6731](int $int0, int $int1)
if ($int0 = 0) {
    if_sethide(true, toplevel_v2:debuffs_window);
    if_sethide(true, toplevel_v2:debuffs_window_content);
    if_sethide(true, toplevel_v2:combat_status_window);
    if_sethide(true, toplevel_v2:combat_status_window_content);
    if ($int1 = 1) {
        mes("Buff timers will no longer be displayed.");
