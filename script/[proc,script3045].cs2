// 3045
[proc,script3045]
def_component $component0 = lobbyscreen_pane_friendslist:pm_radio_buttons;
def_int $int1 = chat_getfilter_private;
def_int $int2 = 0;
def_int $int3 = 2;
while ($int2 < 3) {
    if (cc_find($component0, calc($int2 * $int3)) = true) {
        if ($int1 = $int2) {
            cc_setgraphic(rs3_btn_radio_on);
            cc_setop(1, "");
            cc_setonop(null);
            cc_setonclick(null);
        } else {
            cc_setgraphic(rs3_btn_radio_off);
            cc_setop(1, "Select");
            cc_setonop("script3046(calc($int2 + 2))");
            cc_setonclick("script10036");
        }
    }
    $int2 = calc($int2 + 1);
}
