// 4435
[clientscript,clan_chat_list_refresh](int $int0, component $component1)
~clan_chat_list_refresh($int0, $component1);
if ($component1 = clan_chat:main_content_layer) {
    if (~script6354(toplevel_v2_parent_suboverlay_clan_chat:main_content_layer) = true) {
        ~clan_chat_list_refresh(%clan_line_pos, toplevel_v2_parent_suboverlay_clan_chat:main_content_layer);
    }
} else if (~script6354(clan_chat:main_content_layer) = true) {
    ~clan_chat_list_refresh(%clan_line_pos, clan_chat:main_content_layer);
}
