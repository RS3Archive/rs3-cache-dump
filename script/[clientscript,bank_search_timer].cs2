// 13905
[clientscript,bank_search_timer](string $string0, int $int0)
if ($int0 <= clientclock) {
    if (compare(%varclient_2250, $string0) ! 0) {
        %varclient_6711 = %varclient_2250;
        ~bank_show_search(%varclient_6711, 1);
        $string0 = %varclient_2250;
    }
    $int0 = calc(clientclock + 10);
