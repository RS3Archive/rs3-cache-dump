// 13905
[clientscript,bank_search_timer](string $string0, int $int0)
if ($int0 <= clientclock) {
    if (compare(%p_dialog_input, $string0) ! 0) {
        %bank_lastsearchstring = %p_dialog_input;
        ~bank_show_search(%bank_lastsearchstring, 1);
        $string0 = %p_dialog_input;
    }
    $int0 = calc(clientclock + 10);
    if_setontimer("bank_search_timer($string0, $int0)", bank:bank_search_button_layer);
}
