// 6695
[proc,bigchinchompa_hud_score](component $component0, component $component1, component $component2)
if (%bigchinchompa_currentscore ! 2047) {
    if_sethide(false, $component0);
    if_settext(~bigchinchompa_hud_scoretext(%bigchinchompa_currentscore), $component1);
} else {
    if_sethide(true, $component0);
    ~deltooltip_action($component2);
}
