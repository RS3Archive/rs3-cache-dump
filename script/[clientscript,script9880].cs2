// 9880
[clientscript,script9880](component $component0, int $int1)
def_obj $obj2 = inv_getobj(worn, 3);
def_int $int3 = 1;
def_int $int4 = 0;
if (oc_param($obj2, combatv2_melee_weapon) = 1) {
    $int3 = 1;
} else if (oc_param($obj2, combatv2_ranged_weapon) = 1) {
    $int3 = 2;
} else if (oc_param($obj2, combatv2_magic_weapon) = 1) {
    $int3 = 3;
} else if (oc_param($obj2, combatv2_necromancy_weapon) = 1) {
    $int3 = 4;
}
if ($int3 > 1 & $int1 = 2) {
    $int1 = 1;
}
switch_int ($int3) {
    case 1 :
        if (testbit(%combatv2_melee_xp_option, $int1) = ^true) {
            $int4 = 1;
        }
    case 2 :
        if (testbit(%combatv2_range_xp_option, $int1) = ^true) {
            $int4 = 1;
        }
    case 3 :
        if (testbit(%combatv2_magic_xp_option, $int1) = ^true) {
            $int4 = 1;
        }
    case 4 :
        if (testbit(%combatv2_necromancy_xp_option, $int1) = ^true) {
            $int4 = 1;
        }
}
if ($int4 = 1) {
    if_setgraphic("combatboxes_large,1", $component0);
} else {
    if_setgraphic("combatboxes_large,0", $component0);
}
if_setonmouseover("script9881($component0, $int4, 1)", $component0);
if_setonmouseleave("script9881($component0, $int4, 0)", $component0);
