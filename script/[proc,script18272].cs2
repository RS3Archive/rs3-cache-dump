// 18272
[proc,script18272](component $component0)
if (%emote_display_mode = 0) {
    if_grid_setlayoutparams(true, 40, 40, $component0);
} else if (%toplevel_v2_mobile_interface = 1) {
    if_grid_setlayoutparams(true, 150, 30, $component0);
} else {
    if_grid_setlayoutparams(true, 150, 13, $component0);
}
