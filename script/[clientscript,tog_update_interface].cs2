// 1443
[clientscript,tog_update_interface]
if_settext(tostring(%tog_tears_collected), tog_water_bowl:count);
if (%tog_tears_collected = 0) {
    if_setmodel(null, tog_water_bowl:drip);
} else if (%tog_tears_collected = 1) {
    if_setmodel(if_game_tog_drip1, tog_water_bowl:drip);
} else if (%tog_tears_collected < 4) {
    if_setmodel(if_game_tog_drip2, tog_water_bowl:drip);
} else if (%tog_tears_collected < 7) {
    if_setmodel(if_game_tog_drip3, tog_water_bowl:drip);
} else if (%tog_tears_collected < 11) {
    if_setmodel(if_game_tog_drip4, tog_water_bowl:drip);
} else if (%tog_tears_collected < 16) {
    if_setmodel(if_game_tog_drip5, tog_water_bowl:drip);
} else if (%tog_tears_collected < 22) {
    if_setmodel(if_game_tog_drip6, tog_water_bowl:drip);
} else if (%tog_tears_collected < 29) {
    if_setmodel(if_game_tog_drip7, tog_water_bowl:drip);
} else if (%tog_tears_collected < 37) {
    if_setmodel(if_game_tog_drip8, tog_water_bowl:drip);
} else if (%tog_tears_collected < 46) {
    if_setmodel(if_game_tog_drip9, tog_water_bowl:drip);
} else {
    if_setmodel(if_game_tog_drip10, tog_water_bowl:drip);
}
if (%tog_time_left_tenths = 0) {
    if_setmodel(null, tog_water_bowl:time_bar);
} else if (%tog_time_left_tenths = 1) {
    if_setmodel(if_game_tog_time_bar1, tog_water_bowl:time_bar);
} else if (%tog_time_left_tenths = 2) {
    if_setmodel(if_game_tog_time_bar2, tog_water_bowl:time_bar);
} else if (%tog_time_left_tenths = 3) {
    if_setmodel(if_game_tog_time_bar3, tog_water_bowl:time_bar);
} else if (%tog_time_left_tenths = 4) {
    if_setmodel(if_game_tog_time_bar4, tog_water_bowl:time_bar);
} else if (%tog_time_left_tenths = 5) {
    if_setmodel(if_game_tog_time_bar5, tog_water_bowl:time_bar);
} else if (%tog_time_left_tenths = 6) {
    if_setmodel(if_game_tog_time_bar6, tog_water_bowl:time_bar);
} else if (%tog_time_left_tenths = 7) {
    if_setmodel(if_game_tog_time_bar7, tog_water_bowl:time_bar);
} else if (%tog_time_left_tenths = 8) {
    if_setmodel(if_game_tog_time_bar8, tog_water_bowl:time_bar);
} else if (%tog_time_left_tenths = 9) {
    if_setmodel(if_game_tog_time_bar9, tog_water_bowl:time_bar);
} else {
    if_setmodel(if_game_tog_time_bar10, tog_water_bowl:time_bar);
}
