// 3006
[clientscript,script3006]
switch_int (%pop_randomevent_eventrunning) {
    case 1 :
        ~static_checkbox_create(pop_randomevent_tutorial:never_show_again_build, pop_randomevent_tutorial:never_show_again_click, "Never show tutorial again.", "Show tutorial again.", "Never show tutorial again.", %pop_tutorial_hide_assasin);
    case 2 :
        ~static_checkbox_create(pop_randomevent_tutorial:never_show_again_build, pop_randomevent_tutorial:never_show_again_click, "Never show tutorial again.", "Show tutorial again.", "Never show tutorial again.", %pop_tutorial_hide_barmaid);
    case 3 :
        ~static_checkbox_create(pop_randomevent_tutorial:never_show_again_build, pop_randomevent_tutorial:never_show_again_click, "Never show tutorial again.", "Show tutorial again.", "Never show tutorial again.", %pop_tutorial_hide_seasinger);
}
