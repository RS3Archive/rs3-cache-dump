// 7642
[clientscript,script7642](component $component0, component $component1)
if (%music_shuffle_delay = 0) {
    if (%music_shuffle_toggle_varc = 1) {
        %music_shuffle_toggle_varc = 0;
    } else {
        %music_shuffle_toggle_varc = 1;
    }
    ~script7643($component0, $component1, 0);
}
~script8808;
