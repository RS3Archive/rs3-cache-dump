// 20278
[clientscript,script20278]
%league_task_filters_client = %league_task_filters;
if (string_length(%league_task_search_client) > 0) {
    if_settext(%league_task_search_client, league_parent_tasks:search_input);
}
if_setparam_int(league_task_scroll_pos, 0, league_parent_tasks:task_panel);
cc_deleteall(league_child_tasks:tasks_progress_popup_contents);
if_settrans(255, league_child_tasks:tasks_progress_popup_bg);
if_settrans(255, league_child_tasks:tasks_progress_popup_bg_outline);
if_settrans(255, league_child_tasks:tasks_progress_popup_icon);
~script20291;
~script20321;
