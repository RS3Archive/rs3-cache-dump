// 9020
[proc,crs_fadeout](int $int0, component $component1, component $component2, component $component3, component $component4, boolean $boolean5, component $component6)
~fadeout($int0, 50, $component1);
~fadeout($int0, 50, $component2);
~fadeout($int0, 50, $component3);
if ($boolean5 = true) {
    ~fadeout($int0, 50, $component4);
}
~spinner_create($component6, 1, -1);
