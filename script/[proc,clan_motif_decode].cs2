// 4383
[proc,clan_motif_decode](int $int0, int $int1, int $int2)(material, material)
def_material $material3 = enum(int, material, clan_motif_int2tex, $int0);
def_material $material4 = enum(int, material, clan_motif_int2tex, $int1);
if ($int2 = 1 & (%clan_motif_sanction_varclan = 1 | activeclansettings_getaffinedcount < 5)) {
    $material3 = clan_icon_runestone_r;
    $material4 = clan_icon_runestone_s;
} else {
    if ($material3 = null) {
        $material3 = clan_icon_runestone_r;
    }
    if ($material4 = null) {
        $material4 = clan_icon_runestone_s;
    }
}
return($material3, $material4);
