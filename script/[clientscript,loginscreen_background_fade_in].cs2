// 13391
[clientscript,loginscreen_background_fade_in](component $component0, int $int1, struct $struct2)
def_int $int3 = min(255, calc(max(0, calc(clientclock - $int1)) * 4));
def_struct $struct4 = enum(int, struct, loginscreen_backgrounds, %loginscreen_background);
def_int $int5 = -1;
if ($struct2 ! null) {
    if_settrans($int3, loginscreen:nxt_background_graphic_fade_0);
    if_settrans($int3, loginscreen:nxt_background_graphic_fade_1);
    if_settrans($int3, loginscreen:nxt_background_graphic_fade_2);
    if_settrans($int3, loginscreen:nxt_background_graphic_fade_3);
    if_settrans($int3, loginscreen:nxt_background_graphic_fade_4);
    if_settrans($int3, loginscreen:nxt_background_graphic_fade_5);
    if_settrans($int3, loginscreen:nxt_background_graphic_fade_6);
    if_settrans($int3, loginscreen:nxt_background_graphic_fade_7);
    if_settrans($int3, loginscreen:nxt_background_graphic_fade_8);
