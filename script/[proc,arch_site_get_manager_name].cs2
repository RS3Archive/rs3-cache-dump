// 14593
[proc,arch_site_get_manager_name](dbrow $dbrow0)(string)
switch_dbrow ($dbrow0) {
    case arch_site_kharidet :
        return("Dr Nabanik");
    case arch_site_everlight :
        return("Vanescula Drakan");
    case arch_site_infernalsource :
        return("Movario");
    case arch_site_stormguard :
        return("Gee'ka");
    case arch_site_warforge :
        return("Zanik");
    case arch_site_orthen :
        return("Mr Mordaut");
    case arch_site_senntisten :
        return("Jimmy");
    case arch_site_daemonheim :
        return("Skaldrun");
    case arch_site_moonrise :
        return("Utu");
}
return("");
