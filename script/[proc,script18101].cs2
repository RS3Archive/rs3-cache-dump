// 18101
[proc,script18101](int $int0)(string)
def_string $string0 = "";
switch_int ($int0) {
    case 1 :
        $string0 = "Purchase Premier<br>Hero Pass";
    case 3 :
        $string0 = "Purchase Premier Hero Pass Bundle";
    case 13 :
        $string0 = "625<br>Emblems";
    case 15 :
        $string0 = "1250<br>Emblems";
    case 17 :
        $string0 = "2500<br>Emblems";
    case 5 :
        $string0 = "5 Levels";
    case 7 :
        $string0 = "10 Levels";
    case 9 :
