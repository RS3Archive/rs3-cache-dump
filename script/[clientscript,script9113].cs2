// 9113
[clientscript,script9113](int $int0)
if (cc_find(donation:build_inv_layer, $int0) = true) {
    if_setsize(cc_getwidth, cc_getheight, ^setsize_abs, ^setsize_abs, donation:highlight);
    if_setposition(calc(if_getx(donation:build_inv_layer) + cc_getx), calc(if_gety(donation:build_inv_layer) + cc_gety), ^setpos_abs_left, ^setpos_abs_top, donation:highlight);
    if_sethide(false, donation:highlight);
} else {
    if_sethide(true, donation:highlight);
}
