// 11781
[clientscript,script11781](component $component0)
if (++%seren_coeden_instructions < 150) {
    return;
} else if (if_gettrans($component0) = 255) {
    if_setontimer(null, $component0);
    if_sethide(true, $component0);
    if_sethide(true, seren_coeden:text);
    return;
} else if (calc(%seren_coeden_instructions % 2) = 0) {
    if_settrans(min(255, calc(if_gettrans($component0) + 4)), $component0);
}
