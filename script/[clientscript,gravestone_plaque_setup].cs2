// 663
[clientscript,gravestone_plaque_setup](component $component0, component $component1, component $component2, component $component3)
if_settextfont(barbassault_font, $component0);
if_settextalign(^settextalign_centre, ^settextalign_centre, 0, $component0);
if (%gravestone_transmit = 0) {
    if_setgraphic("aif_grave_wood_1,0", $component1);
    if_setgraphic("aif_grave_wood_1,1", $component2);
    if_setgraphic("aif_grave_wood_1,2", $component3);
    if_setcolour(~rgb_to_hex(242, 242, 242), $component0);
} else if (%gravestone_transmit = 1) {
    if_setgraphic("aif_grave_stone_1,0", $component1);
    if_setgraphic("aif_grave_stone_1,1", $component2);
    if_setgraphic("aif_grave_stone_1,2", $component3);
    if_setcolour(~rgb_to_hex(242, 242, 242), $component0);
}
