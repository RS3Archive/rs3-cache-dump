if ($struct1 = dom_boss_special_it_burns | $struct1 = dom_boss_special_it_burns_easy) {
    if (cc_find(dom_special:info_layer, 0) = false) {
        cc_create(dom_special:info_layer, ^iftype_graphic, 0);
