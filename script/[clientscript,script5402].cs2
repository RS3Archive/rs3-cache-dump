$string2 = "If you win you'll get a dominion factor of: <col=F5B241><tostring(enum(int, int, dom_dom_fact_boss_special_mod, $int0))></col>. You will get no dominion factor for dying.";
if (struct_param($struct1, dom_arena_type) = 1) {
    $string3 = "<col=F5B241>Arena</col>: Single-way combat.";
} else if (struct_param($struct1, dom_arena_type) = 2) {
    $string3 = "<col=F5B241>Arena</col>: Multi-way combat.";
} else if (struct_param($struct1, dom_arena_type) = 3) {
