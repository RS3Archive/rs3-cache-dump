// 19184
[proc,script19184](struct $struct0, component $component1)
def_seq $seq2 = null;
switch_struct ($struct0) {
    case trh182_promo :
        if (%trh182_character_level >= 138) {
            if_setmodelanim(emote_2013_cheer, $component1);
        } else {
            if_setmodelanim(combat_2012_combat_ready, $component1);
        }
    case trh207_promo :
        $seq2 = db_getfield(~script19150($struct0), trh207_nodes:col16, 0);
        if_setmodelanim($seq2, $component1);
    case default :
        if_setmodelanim(combat_2012_casual_unarmed_idle, $component1);
}
