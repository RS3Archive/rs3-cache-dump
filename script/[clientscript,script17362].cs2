// 17362
[clientscript,script17362]
def_graphic $graphic0 = null;
if (%variety_task_events_active_event ! null) {
    switch_int (map_lang) {
        case 0 :
            $graphic0 = struct_param(%variety_task_events_active_event, timed_event_banner_en);
        case 1 :
            $graphic0 = struct_param(%variety_task_events_active_event, timed_event_banner_de);
        case 2 :
            $graphic0 = struct_param(%variety_task_events_active_event, timed_event_banner_fr);
        case 3 :
            $graphic0 = struct_param(%variety_task_events_active_event, timed_event_banner_pt);
    }
    if_setgraphic($graphic0, timed_event:variety_task_events_keyart_graphic);
    if_setsize(200, 364, ^setsize_abs, ^setsize_abs, timed_event:variety_task_events_keyart_graphic);
}
