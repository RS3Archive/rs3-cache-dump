// 12710
[proc,script12710]
if (%trh54_activated_rarity > 0) {
    if_sethide(false, trh54_guaranteed_quality:activate_button_disabled_layer);
} else if (%trh54_key_progress < 5 | %trh54_activated_super_rarity = 1) {
    if_sethide(false, trh54_guaranteed_quality:activate_button_disabled_layer);
} else {
    if_sethide(true, trh54_guaranteed_quality:activate_button_disabled_layer);
}
