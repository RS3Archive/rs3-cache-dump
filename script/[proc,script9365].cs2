    $int0 = calc(%clan_noticeboard_broadcast_reltime_varc / 1440);
    $int1 = calc(%clan_noticeboard_broadcast_reltime_varc % 1440 / 60);
    $int2 = calc(%clan_noticeboard_broadcast_reltime_varc % 60);
    if ($int0 > 0) {
