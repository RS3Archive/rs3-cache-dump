// 14586
[proc,arch_mystery_get_state_graphic](dbrow $dbrow0)(graphic)
if (~arch_mystery_get_complete_state($dbrow0) = ^true) {
    return("arch_journal_mystery_progress,2");
}
switch_int (~arch_mystery_get_progress($dbrow0)) {
    case 0 :
        return("arch_journal_mystery_progress,0");
}
return("arch_journal_mystery_progress,1");
