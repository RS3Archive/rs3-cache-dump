// 6041
[clientscript,xp_reward_confirm_init](component $component0, component $component1, component $component2)
if_setop(1, "Confirm", $component1);
if_setonop("xp_reward_confirm_invalid", $component1);
if_setonvarctransmit("xp_reward_confirm_update($component0, $component1, $component2){xp_reward_currentchoice, xp_reward_internalxp, xp_reward_item}", $component0);
if_setonvartransmit("xp_reward_confirm_update($component0, $component1, $component2){trh154_main}", $component0);
if_setonstattransmit("xp_reward_confirm_update($component0, $component1, $component2)", $component0);
if_setonresize("xp_reward_confirm_update($component0, $component1, $component2)", $component0);
~xp_reward_confirm_update($component0, $component1, $component2);
