// 14061
[proc,script14061](int $int0)
if ($int0 = 0) {
    if_setgraphic("challenge_skill_icons_35px,21", slayer_count:slayer_graphic);
    if_settext(~script16090, slayer_count:slayer_target);
    if_settext(tostring_localised(~script9031, true), slayer_count:slayer_count);
    if_settext("Slayer points:", slayer_count:slayer_points_text);
    if_settext(tostring_localised(%smki_slayer_points, true), slayer_count:slayer_points);
    if_settext(tostring_localised(%smki_mission_count, true), slayer_count:slayer_task_streak);
    if_setop(2, "Reaper", slayer_count:graphic_layer);
} else {
    if_setgraphic(aif_boss_slayer_points_icon_sml, slayer_count:slayer_graphic);
    if_settext(~script14060, slayer_count:slayer_target);
    if_settext(tostring_localised(%bslay_kills_left, true), slayer_count:slayer_count);
    if_settext("Reaper points:", slayer_count:slayer_points_text);
    if_settext(tostring_localised(%bslay_points, true), slayer_count:slayer_points);
    if_settext(tostring_localised(%bslay_task_streak, true), slayer_count:slayer_task_streak);
    if_setop(2, "Slayer", slayer_count:graphic_layer);
}
if_setonmouserepeat("slayer_window_tooltip(event_com, $int0)", slayer_count:slayer_count);
