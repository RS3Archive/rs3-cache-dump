// 16525
[proc,trh180_update_progressbar]
def_int $int0 = 0;
def_int $int1 = 0;
def_int $int2 = 4;
def_graphic $graphic3 = trh180_progressbar_egg00;
cc_deleteall(interface_970:com_24);
while ($int0 < 2) {
    $int2 = calc(3 + $int0 * 60);
    if ($int0 < %varplayerbit_51243) {
        $graphic3 = trh180_progressbar_egg01;
        ~cc_add_graphic(interface_970:com_24, $int1++, $int2, 2, ^setpos_abs_left, ^setpos_abs_bottom, 55, 42, ^setsize_abs, ^setsize_abs, trh180_progressbar_fill);
    } else {
        $graphic3 = trh180_progressbar_egg00;
    }
    ~cc_add_graphic(interface_970:com_24, $int1++, $int2, 0, ^setpos_abs_left, ^setpos_abs_bottom, 54, 55, ^setsize_abs, ^setsize_abs, $graphic3);
    $int0 = calc($int0 + 1);
}
~script3536("For every 2 bonus eggs opened, you will receive a guaranteed reward.<br>You have currently opened <tostring(%varplayerbit_51243)>/<tostring(2)> bonus eggs for your next reward.", interface_970:com_27, -1);
