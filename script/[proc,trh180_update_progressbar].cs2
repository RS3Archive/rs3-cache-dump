// 16525
[proc,trh180_update_progressbar]
def_int $int0 = 0;
def_int $int1 = 0;
def_int $int2 = 4;
def_graphic $graphic3 = trh180_progressbar_egg00;
cc_deleteall(trh180_overlay:prize_layer);
while ($int0 < 2) {
    $int2 = calc(3 + $int0 * 60);
    if ($int0 < %trh180_egg_hunt_reward_progress) {
        $graphic3 = trh180_progressbar_egg01;
        ~cc_add_graphic(trh180_overlay:prize_layer, $int1++, $int2, 2, ^setpos_abs_left, ^setpos_abs_bottom, 55, 42, ^setsize_abs, ^setsize_abs, trh180_progressbar_fill);
    } else {
        $graphic3 = trh180_progressbar_egg00;
    }
    ~cc_add_graphic(trh180_overlay:prize_layer, $int1++, $int2, 0, ^setpos_abs_left, ^setpos_abs_bottom, 54, 55, ^setsize_abs, ^setsize_abs, $graphic3);
    $int0 = calc($int0 + 1);
}
~script3536("For every 2 bonus eggs opened, you will receive a guaranteed reward.<br>You have currently opened <tostring(%trh180_egg_hunt_reward_progress)>/<tostring(2)> bonus eggs for your next reward.", trh180_overlay:progress_bar_click_layer, -1);
