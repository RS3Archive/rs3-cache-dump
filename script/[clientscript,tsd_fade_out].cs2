// 7574
[clientscript,tsd_fade_out]
def_int $int0 = if_gettrans(tsd_sliske_entrance:black);
if ($int0 <= 30) {
    if_settrans(20, tsd_sliske_entrance:black);
    if_setontimer(null, tsd_sliske_entrance:base);
    if_sethide(false, tsd_sliske_entrance:fog);
} else {
    $int0 = calc($int0 - 8);
    if_settrans($int0, tsd_sliske_entrance:black);
}
