// 3570
[proc,script3570](obj $obj0, category $category1)(boolean)
switch_category ($category1) {
    case potion :
        if (enum_hasoutput(obj, herblore_combination_potions_table, $obj0) = true) {
            return(false);
        }
}
if (oc_category($obj0) = $category1) {
    return(true);
}
return(false);
