// 10525
[clientscript,script10525]
if (%quest_endgame_new_canon = 2) {
    if_sethide(true, quest_endgame_replay:canon_checkbox);
    if_sethide(true, quest_endgame_replay:canon_text);
}
if_sethide(true, quest_endgame_replay:interactions_selected);
if_sethide(false, quest_endgame_replay:options_selected);
if_sethide(true, quest_endgame_replay:choices_selected);
if_sethide(true, quest_endgame_replay:choices);
if_sethide(true, quest_endgame_replay:interaction);
if_sethide(false, quest_endgame_replay:options);
