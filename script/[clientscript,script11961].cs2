// 11961
[clientscript,script11961]
def_component $component0 = tutisland_focus:distractions;
if_setontimer("script11962(event_com)", $component0);
cc_deleteall($component0);
def_int $int1 = 0;
while ($int1 < 3) {
    cc_create($component0, ^iftype_graphic, $int1);
    cc_setop(1, "React to Sense");
    cc_setonop("cc_sethide(true, event_com, $int1)");
    cc_setsize(128, 128, ^setsize_abs, ^setsize_abs);
    cc_sethide(true);
    $int1 = calc($int1 + 1);
}
