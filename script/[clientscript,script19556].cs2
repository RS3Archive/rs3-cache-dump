// 19556
[clientscript,script19556](string $string0, int $int0)
if ($int0 <= clientclock) {
    if (compare(%p_dialog_input, $string0) ! 0) {
        %bank_lastsearchstring = %p_dialog_input;
        ~script19519(%bank_lastsearchstring, 1);
        $string0 = %p_dialog_input;
    }
    $int0 = calc(clientclock + 10);
    if_setontimer("script19556($string0, $int0)", group_ironman_storage:search_button);
}
