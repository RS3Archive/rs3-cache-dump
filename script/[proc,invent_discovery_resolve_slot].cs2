[proc,invent_discovery_resolve_slot](int $int0, component $component1, component $component2)(int)
def_graphic $graphic3 = null;
switch_int ($int0) {
    case 1 :
        $graphic3 = if_getgraphic(invent_discovery:part_icon_0);
    case 2 :
        $graphic3 = if_getgraphic(invent_discovery:part_icon_1);
    case 3 :
        $graphic3 = if_getgraphic(invent_discovery:part_icon_2);
    case 4 :
        $graphic3 = if_getgraphic(invent_discovery:part_icon_3);
