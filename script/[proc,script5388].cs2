    ~script8311(2);
}
if (if_gethide(toplevel_v2_inventory:bonds_pouch_layer) = false | ~script6431 = true) {
    if_sethide(true, toplevel_v2_inventory:bonds_pouch_layer);
    if_sethide(true, toplevel_v2_parent_suboverlay_inventory:bonds_pouch_layer);
} else {
