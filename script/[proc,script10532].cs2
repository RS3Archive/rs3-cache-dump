[proc,script10532]
def_int $int0 = if_getscrolly(bank:tabs_dynamic);
def_int $int1 = max(0, calc(($int0 / 48 - 1) * 48));
if_setscrollpos(0, max(calc($int0 - 4), 0), bank:tabs_dynamic);
if_setscrollpos(0, max(calc($int0 - 4), 0), bank:tabs_spacers);
if_setontimer("script13267($int1)", bank:tabs);
