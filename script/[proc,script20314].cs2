// 20314
[proc,script20314](dbrow $dbrow0)
cc_deleteall(league_child_tasks:tasks_progress_popup_contents);
if (if_gettrans(league_child_tasks:tasks_progress_popup_bg) <= 0) {
    if_setontimer("script20315($dbrow0, calc(clientclock - 50))", league_child_tasks:tasks_progress_popup);
} else {
    if_setontimer("script20315($dbrow0, clientclock)", league_child_tasks:tasks_progress_popup);
}
