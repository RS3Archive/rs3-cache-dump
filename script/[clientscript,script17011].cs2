// 17011
[clientscript,script17011]
if_sethide(true, wheel_of_fortune:splash_screen);
if_sethide(true, wheel_of_fortune:splash_screen_graphic);
if_sethide(false, wheel_of_fortune:countdown_layer);
if_sethide(false, wheel_of_fortune:chests_layer);
if_sethide(false, wheel_of_fortune:banner_layer);
if (if_gethide(wheel_of_fortune:trh_promo_info) = true) {
    ~script16198(true, 82117067);
}
if (struct_param(~script16161, trh_promo_hide_ticker) = false) {
    if_sethide(false, wheel_of_fortune:ticker_tape_viewport);
}
