// 19325
[proc,script19325](int $int0)(string)
if ($int0 < calc(60 * 2)) {
    if ($int0 = 0) {
        return("<lt>1 minute ago");
    }
    if ($int0 = 1) {
        return("<tostring($int0)> minute ago");
    }
    return("<tostring($int0)> minutes ago");
}
if ($int0 < calc(1440 * 2)) {
    return("<tostring(calc($int0 / 60))> hours ago");
}
if ($int0 < calc(10080 * 2)) {
    return("<tostring(calc($int0 / 1440))> days ago");
}
if ($int0 < calc(43200 * 2)) {
    return("<tostring(calc($int0 / 10080))> weeks ago");
}
if ($int0 < calc(525600 * 2)) {
    return("<tostring(calc($int0 / 43200))> months ago");
}
return("<tostring(calc($int0 / 525600))> years ago");
