// 11121
[clientscript,script11121]
if (if_gethide(easter15_combine_overlay:key_layer) = false) {
    mes_typed(^chattype_spam, 0, "The notebook overlay is already open.");
} else {
    if_sethide(false, easter15_combine_overlay:key_layer);
    if_sethide(false, easter15_combine_overlay:notebook_button_selected_layer);
}
