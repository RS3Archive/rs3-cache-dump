// 13500
[proc,script13500]
def_component $component0 = null;
def_int $int1 = 1;
while ($int1 < 5) {
    switch_int ($int1) {
        case 1 :
            $component0 = repoverlay:reputation_favourite_worker;
        case 2 :
            $component0 = repoverlay:reputation_favourite_imperial;
        case 3 :
            $component0 = repoverlay:reputation_favourite_merchants;
        case 4 :
            $component0 = repoverlay:reputation_favourite_port;
        case default :
            return;
    }
    if (%menaphos_currently_selected_faction = $int1) {
        if_sethide(false, $component0);
    } else {
        if_sethide(true, $component0);
    }
    $int1 = calc($int1 + 1);
}
