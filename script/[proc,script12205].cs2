// 12205
[proc,script12205]
if (%trh80_grotesque_head_unlocked = 0) {
    if_settext(tostring_localised(8000, true), trh80_corrupt:helmet_price);
} else {
    if_settext("Owned", trh80_corrupt:helmet_price);
    if_sethide(false, trh80_corrupt:helmet_button_disabled);
}
