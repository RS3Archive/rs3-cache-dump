// 7233
[clientscript,trh132_tooltips](component $component0)
def_string $string0 = "";
switch_component ($component0) {
    case trh132:prestige_level :
        $string0 = "How many times you have completed your contracts.";
    case trh132:use_goldstar_button_layer :
        $string0 = "Use subcontracts to complete training immediately!";
    case trh132:easy_task_1 :
        $string0 = "The Master of Disguise! Steal Party Pete's Wig. It *might* come in handy as a disguise. Have a look in the party room.";
    case trh132:easy_task_2 :
        $string0 = "Dangerous Liasons: Run to the north most part of the Wilderness! (beyond the north-eastern volcano)";
    case trh132:easy_task_3 :
        $string0 = "Now you see me: Change something about your appearance to throw off your enemies.";
    case trh132:easy_task_4 :
        $string0 = "Lock, stock and two beer barrels: Visit the following shady establishments - Blue Moon Inn, Blurberry's bar, Dead Man's Chest, Dragon Inn, Poison Arrow, Forester's Arms, Jolly Boar Inn, Karamja Spirits Bar, Rising Sun Inn and the Rusty Anchor Inn.";
    case trh132:medium_task_1 :
        $string0 = "Inside man: Play a game of Heist on either side of the law to better understand your enemy.";
    case trh132:medium_task_2 :
        $string0 = "Antidote: Make a Super antipoison potion, should someone try to assassinate you.";
    case trh132:medium_task_3 :
        $string0 = "Ratatouille: Make some Tangled Toad's Legs as it's a useful food to disguise poison and feed to your targets.";
    case trh132:medium_task_4 :
        $string0 = "Thank you for smoking: Practice your assassination skills by killing 60 dust devils in the Smoke Dungeon - <tostring(%trh132_dustdevils)>/60";
    case trh132:hard_task_1 :
        $string0 = "Poison Ivy: Harvest a Poison Ivy bush.";
    case trh132:hard_task_2 :
        $string0 = "Dungeons and dragons: complete a medium or large occult or warped Dungeoneering floor to test your skills.";
    case trh132:hard_task_3 :
        $string0 = "The running man: Complete 15 Laps of the Werewolf Agility Course - <tostring(%trh132_agility_laps)>/15";
    case trh132:hard_task_4 :
        $string0 = "Death wish: Complete a Reaper task.";
    case trh132:elite_task_1 :
        $string0 = "The dark night: Change the lighting in your player-owned house to Nighttime, for a more stealthly look.";
    case trh132:elite_task_2 :
        $string0 = "The beach: Profit in hostile environments by gathering some rare resources 100 times from an uncharted isle - <tostring(%trh132_arc_resources)>/100";
    case trh132:elite_task_3 :
        $string0 = "Contagion: Bring The Faceless Assassin the following - 6 dose Overload Salve, Divine Rocktail Bubble, Empty Birds Nest, 134 Harmonic Dust, 10 Basiliskbanite ore and a Sack full of Onions to make his contagion.";
    case trh132:elite_task_4 :
        $string0 = "The Kiln floor: Obtain a TokHaar-Kal cape of your choice or an uncut onyx from the Fight Kiln.";
    case trh132:line_prize_1 :
        $string0 = "Complete this line to get a medium cash bag.";
    case trh132:line_prize_2 :
        $string0 = "Complete this line to get a large cash bag.";
    case trh132:line_prize_3 :
        $string0 = "Complete this line to get a huge prismatic star.";
    case trh132:line_prize_4 :
        $string0 = "Complete this line to get a huge prismatic lamp.";
    case trh132:column_prize_1 :
        switch_int (%trh132_prestige) {
            case 0 :
                $string0 = "Assassin Hands and Feet (blue).";
            case 1 :
                $string0 = "Assassin Cape (blue).";
            case 2 :
                $string0 = "Assassin Head (green)";
            case 3 :
                $string0 = "Assassin Top (red)";
            case 4 :
                $string0 = "Assassin Legs (black)";
        }
    case trh132:column_prize_2 :
        switch_int (%trh132_prestige) {
            case 0 :
                $string0 = "Assassin Legs (blue).";
            case 1 :
                $string0 = "Assassin Hands and Feet (green).";
            case 2 :
                $string0 = "Assassin Cape (green)";
            case 3 :
                $string0 = "Assassin Head (red)";
            case 4 :
                $string0 = "Assassin Top (black)";
        }
    case trh132:column_prize_3 :
        switch_int (%trh132_prestige) {
            case 0 :
                $string0 = "Assassin Top (blue).";
            case 1 :
                $string0 = "Assassin Legs (green).";
            case 2 :
                $string0 = "Assassin Hands and Feet (red)";
            case 3 :
                $string0 = "Assassin Cape (red)";
            case 4 :
                $string0 = "Assassin Head (black)";
        }
    case trh132:column_prize_4 :
        switch_int (%trh132_prestige) {
            case 0 :
                $string0 = "Assassin Head (blue).";
            case 1 :
                $string0 = "Assassin Top (green).";
            case 2 :
                $string0 = "Assassin Legs (red)";
            case 3 :
                $string0 = "Assassin Hands and Feet (black)";
            case 4 :
                $string0 = "Assassin Cape (black)";
        }
    case trh132:prestige_1_layer :
        $string0 = "Crescent Blades Override";
    case trh132:prestige_2_layer :
        $string0 = "Dusk Warbow Override";
    case trh132:prestige_3_layer :
        $string0 = "Eventide Rippers Override";
    case trh132:prestige_4_layer :
        $string0 = "Sundown Daggers Override";
    case trh132:prestige_5_layer :
        $string0 = "Assassin Walk Override.";
}
if_setonmouserepeat("script3876($string0, $component0, -1)", $component0);
