    case interface_999:com_198 :
        $string0 = "Death wish: Complete a Reaper task.";
    case interface_999:com_43 :
        $string0 = "The dark night: Change the lighting in your player-owned house to Nighttime, for a more stealthly look.";
    case interface_999:com_201 :
        $string0 = "The beach: Profit in hostile environments by gathering some rare resources 100 times from an uncharted isle - <tostring(%varplayerbit_39038)>/100";
    case interface_999:com_204 :
