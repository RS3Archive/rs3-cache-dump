// 1162
[proc,ql4_intro_suggested_quest_requirement](quest $quest0)(string)
def_string $string0 = "";
def_int $int1 = -1;
def_int $int2 = 1;
while ($int2 <= 12) {
    $int1 = -1;
    switch_int ($int2) {
        case 1 :
            $int1 = quest_param($quest0, quest_suggested_quest1);
        case 2 :
            $int1 = quest_param($quest0, quest_suggested_quest2);
        case 3 :
            $int1 = quest_param($quest0, quest_suggested_quest3);
        case 4 :
            $int1 = quest_param($quest0, quest_suggested_quest4);
        case 5 :
            $int1 = quest_param($quest0, quest_suggested_quest5);
        case 6 :
            $int1 = quest_param($quest0, quest_suggested_quest6);
        case 7 :
            $int1 = quest_param($quest0, quest_suggested_quest7);
        case 8 :
            $int1 = quest_param($quest0, quest_suggested_quest8);
        case 9 :
            $int1 = quest_param($quest0, quest_suggested_quest9);
        case 10 :
            $int1 = quest_param($quest0, quest_suggested_quest10);
        case 11 :
            $int1 = quest_param($quest0, quest_suggested_quest11);
        case 12 :
            $int1 = quest_param($quest0, quest_suggested_quest12);
    }
    if ($int1 > -1) {
        $string0 = append($string0, "<~script1164(~script7073($int1), 2, ~quest_name(enum(int, quest, ql4_quests, $int1)))><br>");
    }
    $int2 = calc($int2 + 1);
}
return($string0);
