// 677
[clientscript,letter_lj_setscrollpos](int $int0)
if ($int0 <= 9) {
    if_setscrollsize(358, 225, interface_156:com_2);
    if_sethide(true, interface_156:com_1);
} else {
    if_sethide(false, interface_156:com_1);
    if_setscrollsize(358, calc($int0 * 20 + 30), interface_156:com_2);
    ~scrollbar_resize(interface_156:com_1, interface_156:com_2, 0);
}
