// 1198
[clientscript,script1198]
if (inv_total(inv, ra3_rod) > 0 | inv_total(bank, ra3_rod) > 0 | %ra3_quest >= 44) {
    if_sethide(true, ra3_package:handled_rod);
} else {
    if_sethide(false, ra3_package:handled_rod);
}
if (inv_total(inv, ra3_turnscrew) > 0 | inv_total(bank, ra3_turnscrew) > 0) {
    if_sethide(true, ra3_package:turn_screw);
} else {
    if_sethide(false, ra3_package:turn_screw);
}
if (inv_total(inv, ra3_bowl) > 0 | inv_total(bank, ra3_bowl) > 0 | %ra3_quest = 42) {
    if_sethide(true, ra3_package:bowl);
} else {
    if_sethide(false, ra3_package:bowl);
}
if (inv_total(inv, ra3_boot) > 0 | inv_total(bank, ra3_boot) > 0) {
    if_sethide(true, ra3_package:boot);
} else {
    if_sethide(false, ra3_package:boot);
}
if (inv_total(inv, ra3_green_stone) > 0 | inv_total(bank, ra3_green_stone) > 0 | %ra3_quest >= 52 | %ra3_cart_switch = 1) {
    if_sethide(true, ra3_package:green_stone);
} else {
    if_sethide(false, ra3_package:green_stone);
}
if (inv_total(inv, ra3_yellow_stone) > 0 | inv_total(bank, ra3_yellow_stone) > 0 | %ra3_quest >= 52 | %ra3_cart_switch = 2) {
    if_sethide(true, ra3_package:yellow_stone);
} else {
    if_sethide(false, ra3_package:yellow_stone);
}
if (inv_total(inv, ra3_rectangle) > 0 | inv_total(bank, ra3_rectangle) > 0) {
    if_sethide(true, ra3_package:sheet);
} else {
    if_sethide(false, ra3_package:sheet);
}
