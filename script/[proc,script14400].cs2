// 14400
[proc,script14400](component $component0, int $int1, int $int2, int $int3, int $int4, boolean $boolean5, int $int6)
if (calc($int6 % 2) = 0) {
    ~script14401($component0, $int1, $int2, $int3, $int4, $boolean5, rs3_rect_light);
} else {
    ~script14401($component0, $int1, $int2, $int3, $int4, $boolean5, rs3_rect_dark);
}
