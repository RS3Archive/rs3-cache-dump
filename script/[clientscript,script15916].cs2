// 15916
[clientscript,script15916]
if_sethide(true, timed_kill:positive_button_layer);
if_sethide(true, timed_kill:new_record_layer);
if_setcolour(^white, timed_kill:time_text);
%boss_instance_client_timer_elapsed = 0;
%boss_instance_client_start_time = clientclock;
~script4172(%boss_instance_client_timer_elapsed);
switch_int (%boss_instance_current_boss_client) {
    case 999, 2017, 1000, 1001 :
        if_setontimer("script12251(clientclock, %boss_instance_client_fight_length)", timed_kill:time_text);
    case default :
        if_setontimer("script2959(clientclock)", timed_kill:time_text);
}
if_setonvarctransmit("script801{boss_instance_client_timer_elapsed, boss_instance_current_boss_client, boss_instance_client_fight_length}", timed_kill:time_text);
if_setonvarctransmit("script15917{timed_kill_target}", timed_kill:content_layer);
