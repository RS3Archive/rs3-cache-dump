// 16634
[proc,quickchat_open_private](int $int0, string $string0, int $int1)
switch_int (friend_platform($int0)) {
    case 0, 4 :
        ~quickchat_open(1, $string0, $int1);
    case 8 :
        mes("You cannot use Quick Chat to send a message to someone playing Old School RuneScape.");
    case default :
        mes("You cannot use Quick Chat to send a message to that player.");
}
