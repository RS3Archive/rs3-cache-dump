// 5756
[clientscript,script5756](component $component0, int $int1, int $int2)
def_int $int3 = 0;
if (if_find($component0) = true) {
    $int3 = calc(cc_param(sworlds_end_screen_ticker_val) + scale(calc($int2 - $int1), 100, 4));
    if ($int3 >= $int2) {
        $int3 = $int2;
        cc_setontimer(null);
    }
    cc_settext(tostring_localised($int3, true));
    cc_setparam(sworlds_end_screen_ticker_val, $int3);
}
