// 17943
[proc,script17943](component $component0, int $int1, int $int2)
def_int $int3 = 0;
if (cc_find($component0, $int1) = true) {
    $int3 = calc(cc_get2dangle + 65536 / $int2);
    if ($int3 < 0) {
        $int3 = calc(65536 + $int3);
    } else {
        $int3 = calc($int3 % 65536);
    }
    cc_set2dangle($int3);
}
