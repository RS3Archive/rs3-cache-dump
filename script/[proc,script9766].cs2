// 9766
[proc,script9766]
if (%trh17_football_mode = 1) {
    if_setgraphic(rs3_btn_radio_off, trh17_config:mode_selected_free);
    if_setgraphic(rs3_btn_radio_on, trh17_config:mode_selected_rolling);
} else {
    if_setgraphic(rs3_btn_radio_on, trh17_config:mode_selected_free);
    if_setgraphic(rs3_btn_radio_off, trh17_config:mode_selected_rolling);
}
if (%trh17_football_current = 0) {
    if_setgraphic(rs3_btn_radio_on, trh17_config:ball_selected_1);
} else {
    if_setgraphic(rs3_btn_radio_off, trh17_config:ball_selected_1);
}
if (%trh17_football_current = 1) {
    if_setgraphic(rs3_btn_radio_on, trh17_config:ball_selected_2);
} else {
    if_setgraphic(rs3_btn_radio_off, trh17_config:ball_selected_2);
}
if (%trh17_football_current = 2) {
    if_setgraphic(rs3_btn_radio_on, trh17_config:ball_selected_3);
} else {
    if_setgraphic(rs3_btn_radio_off, trh17_config:ball_selected_3);
}
if (%trh17_football_current = 3) {
    if_setgraphic(rs3_btn_radio_on, trh17_config:ball_selected_4);
} else {
    if_setgraphic(rs3_btn_radio_off, trh17_config:ball_selected_4);
}
if (%trh17_football_current = 4) {
    if_setgraphic(rs3_btn_radio_on, trh17_config:ball_selected_5);
} else {
    if_setgraphic(rs3_btn_radio_off, trh17_config:ball_selected_5);
}
if (%trh17_football_current = 5) {
    if_setgraphic(rs3_btn_radio_on, trh17_config:ball_selected_6);
} else {
    if_setgraphic(rs3_btn_radio_off, trh17_config:ball_selected_6);
}
