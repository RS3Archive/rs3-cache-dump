// 2771
[clientscript,script2771](component $component0, int $int1)
def_int $int2 = calc(clientclock - $int1);
if ($int2 >= 181 | %varclient_1007 ! 1) {
    if_setontimer(null, $component0);
    return;
}
if (calc($int2 % 25) = 0) {
    switch_int (randominc(2)) {
        case 0 :
            sound_synth(sound_34529, 1, 0);
        case 1 :
            sound_synth(sound_28132, 1, 0);
        case 2 :
            sound_synth(sound_31092, 1, 0);
    }
}
