// 2771
[clientscript,script2771](component $component0, int $int1)
def_int $int2 = calc(clientclock - $int1);
if ($int2 >= 181 | %tutorial3_cutscene_tracker ! 1) {
    if_setontimer(null, $component0);
    return;
}
if (calc($int2 % 25) = 0) {
    switch_int (randominc(2)) {
        case 0 :
            sound_synth(demon_footstep1, 1, 0);
        case 1 :
            sound_synth(demon_footstep2, 1, 0);
        case 2 :
            sound_synth(demon_footstep3, 1, 0);
    }
}
