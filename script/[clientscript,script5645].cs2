// 5645
[clientscript,script5645](int $int0, int $int1, int $int2)
if (cc_find(pop_ship_names:names_layer, $int0) = true) {
    if ($int2 = 0) {
        if ($int1 = 1) {
            cc_setcolour(0xf7ca30);
        } else {
            cc_setcolour(0xfaf2d6);
        }
    } else if ($int1 = 1) {
        cc_setcolour(0xe0980d);
    } else {
        cc_setcolour(0xf7ca30);
    }
}
