// 2109
[proc,script2109](obj $obj0, int $int1)(int)
def_int $int2 = 0;
switch_int ($int1) {
    case 3 :
        $int2 = oc_param($obj0, magicattack);
    case 1 :
        $int2 = oc_param($obj0, meleeattack);
    case 2 :
        $int2 = oc_param($obj0, rangeattack);
    case 7 :
        $int2 = oc_param($obj0, necromancyattack);
}
return($int2);
