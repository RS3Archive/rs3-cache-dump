// 2801
[proc,fade2_generic](component $component0, int $int1, int $rgb2)
if_setcolour($rgb2, $component0);
if (%fade2_force = 1 & $int1 > 0) {
    %fade2_force = 0;
} else if (%fade2_force = 2 & $int1 < 0) {
    %fade2_force = 0;
}
if ($int1 > 0) {
    ~script14987(true);
}
if (%fade2_force <= 0) {
    if_setontimer("fade2_timer($int1, $component0)", $component0);
    if ($int1 > 0) {
        if_settrans(0, $component0);
    } else {
        if_settrans(255, $component0);
    }
} else {
    if_setontimer(null, $component0);
    if (%fade2_force = 1) {
        if_settrans(0, $component0);
    } else {
        if_settrans(255, $component0);
        ~script14987(true);
    }
    %fade2_force = 0;
}
