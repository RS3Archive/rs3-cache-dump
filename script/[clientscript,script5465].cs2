// 5465
[clientscript,script5465]
def_int $int0 = if_getwidth(dom_battle_overlay:player_health_layer);
def_int $int1 = 0;
$int1 = calc($int0 - 33);
$int1 = scale($int1, 100, %dom_battle_player_health_width);
if_setsize($int1, if_getheight(dom_battle_overlay:player_healthbar), ^setsize_abs, ^setsize_abs, dom_battle_overlay:player_healthbar);
