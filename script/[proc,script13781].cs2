// 13781
[proc,script13781]
if_settext("Current co-op points: <tostring(%ss_points)>", ss_rework:current_points_title);
if_sethide(true, ss_rework:buy_window);
if_sethide(true, ss_rework:learn_window);
if_sethide(true, ss_rework:assignment_window);
if_sethide(false, ss_rework:coop_window);
if_sethide(true, ss_rework:buy_button_selected_layer);
if_sethide(true, ss_rework:learn_button_selected_layer);
if_sethide(true, ss_rework:assignment_button_selected_layer);
if_sethide(false, ss_rework:coop_button_selected_layer);
if_sethide(false, ss_rework:scrollbar);
~rs3_scrollbar_vertical(ss_rework:scrollbar, ss_rework:coop_window);
