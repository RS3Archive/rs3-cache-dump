// 345
[clientscript,script345]
if (%minimal_popup_struct = null) {
    return;
}
if_setgraphic(struct_param(%minimal_popup_struct, minimal_popup_sprite), minimal_popup:minimal_sprite_component);
if_setsize(calc(struct_param(%minimal_popup_struct, minimal_popup_sprite_x) + 4), calc(struct_param(%minimal_popup_struct, minimal_popup_sprite_y) + 4), ^setsize_abs, ^setsize_abs, minimal_popup:universe);
if_setsize(struct_param(%minimal_popup_struct, minimal_popup_sprite_x), struct_param(%minimal_popup_struct, minimal_popup_sprite_y), ^setsize_abs, ^setsize_abs, minimal_popup:minimal_sprite_component);
if_setposition(0, 0, ^setpos_abs_left, ^setpos_abs_top, minimal_popup:minimal_sprite_component);
if_setsize(struct_param(%minimal_popup_struct, minimal_popup_button_x), struct_param(%minimal_popup_struct, minimal_popup_button_y), ^setsize_abs, ^setsize_abs, minimal_popup:invis_button);
if_setposition(struct_param(%minimal_popup_struct, minimal_popup_button_x_pos), struct_param(%minimal_popup_struct, minimal_popup_button_y_pos), ^setpos_abs_left, ^setpos_abs_top, minimal_popup:invis_button);
