// 14371
[proc,bank_shift_tab_scrollpos](int $int0)
while ($int0 < 15) {
    switch_int ($int0) {
        case 1 :
            %bank_lastscrollpos_tab1 = %bank_lastscrollpos_tab2;
        case 2 :
            %bank_lastscrollpos_tab2 = %bank_lastscrollpos_tab3;
        case 3 :
            %bank_lastscrollpos_tab3 = %bank_lastscrollpos_tab4;
        case 4 :
            %bank_lastscrollpos_tab4 = %bank_lastscrollpos_tab5;
        case 5 :
            %bank_lastscrollpos_tab5 = %bank_lastscrollpos_tab6;
        case 6 :
            %bank_lastscrollpos_tab6 = %bank_lastscrollpos_tab7;
        case 7 :
            %bank_lastscrollpos_tab7 = %bank_lastscrollpos_tab8;
        case 8 :
            %bank_lastscrollpos_tab8 = %bank_lastscrollpos_tab9;
        case 9 :
            %bank_lastscrollpos_tab9 = %bank_lastscrollpos_tab10;
        case 10 :
            %bank_lastscrollpos_tab10 = %bank_lastscrollpos_tab11;
        case 11 :
            %bank_lastscrollpos_tab11 = %bank_lastscrollpos_tab12;
        case 12 :
            %bank_lastscrollpos_tab12 = %bank_lastscrollpos_tab13;
        case 13 :
            %bank_lastscrollpos_tab13 = %bank_lastscrollpos_tab14;
        case 14 :
            %bank_lastscrollpos_tab14 = %bank_lastscrollpos_tab15;
        case 15 :
            %bank_lastscrollpos_tab15 = 0;
    }
    $int0 = calc($int0 + 1);
}
