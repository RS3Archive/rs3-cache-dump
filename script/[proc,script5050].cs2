// 5050
[proc,script5050](int $int0, int $int1, int $int2)
$int0 = calc($int0 * $int1);
if ($int2 = 1) {
    if_setscrollpos(if_getscrollx(clan_field_editor:grid_container), max(calc(if_getscrolly(clan_field_editor:grid_container) + $int0), 0), clan_field_editor:grid_container);
} else {
    if_setscrollpos(max(calc(if_getscrollx(clan_field_editor:grid_container) + $int0), 0), if_getscrolly(clan_field_editor:grid_container), clan_field_editor:grid_container);
}
~script5053(0, 0);
