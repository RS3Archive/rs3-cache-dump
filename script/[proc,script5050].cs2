// 5050
[proc,script5050](int $int0, int $int1, int $int2)
$int0 = calc($int0 * $int1);
if ($int2 = 1) {
    if_setscrollpos(if_getscrollx(interface_1111:com_12), max(calc(if_getscrolly(interface_1111:com_12) + $int0), 0), interface_1111:com_12);
} else {
    if_setscrollpos(max(calc(if_getscrollx(interface_1111:com_12) + $int0), 0), if_getscrolly(interface_1111:com_12), interface_1111:com_12);
}
~script5053(0, 0);
