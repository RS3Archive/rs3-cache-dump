// 18529
[proc,script18529](quest $quest0)(string, string)
def_string $string0 = "";
if ($quest0 = null) {
    return("", "");
}
def_string $string1 = "Suggestions:";
if (quest_param($quest0, quest_sublist) = 2) {
    $string1 = "To play the unabridged version:";
}
def_string $string2 = "";
switch_quest ($quest0) {
    case vkq1 :
        $string2 = ~script1164(%pc_played_once, 1, "Complete a Pest Control minigame");
    case vkq3 :
        $string2 = ~script1164(%conq_done_tutorial, 1, "Complete Conquest tutorial");
    case fremsaga_signature :
        $string2 = ~script18526(attack, 30);
        $string2 = append($string2, "<br>");
        $string2 = append($string2, ~script18526(ranged, 30));
        $string2 = append($string2, "<br>");
        $string2 = append($string2, ~script18526(magic, 30));
    case fremsaga_vengeance :
        $string2 = ~script18526(agility, 55);
        $string2 = append($string2, "<br>");
        $string2 = append($string2, ~script18526(thieving, 55));
    case fremsaga_thok :
        $string2 = ~script18526(strength, 70);
    case fremsaga_bilrach :
        $string2 = ~script18526(attack, 60);
        $string2 = append($string2, "<br>");
        $string2 = append($string2, ~script18526(thieving, 45));
        $string2 = append($string2, "<br>");
        $string2 = append($string2, ~script18526(dungeoneering, 55));
    case fremsaga_thok2 :
        $string2 = ~script18526(strength, 75);
    case family_crest :
        $string2 = ~script18526(magic, 59);
    case default :
        $string0 = ~quest_name($quest0);
        ~error("<$string0> has param=quest_suggested_special,^true but no special case in [proc,ql4_suggested_special].");
}
return($string1, $string2);
