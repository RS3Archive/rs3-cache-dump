// 15706
[proc,loginscreen_audio_setup]
if (%loginscreen_musicvol_save >= 0 & %loginscreen_musicvol_save <= 255) {
    clientoption_set(^clientoption_volume_login_music, %loginscreen_musicvol_save);
    clientoption_set(^clientoption_volume_main_effects, %loginscreen_musicvol_save);
} else if (%loginscreen_musicvol_save = -1) {
    %loginscreen_musicvol_save = clientoption_get(^clientoption_volume_login_music);
}
