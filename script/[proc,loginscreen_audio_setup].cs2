// 15706
[proc,loginscreen_audio_setup]
if (%varclient_6888 >= 0 & %varclient_6888 <= 255) {
    clientoption_set(^clientoption_volume_login_music, %varclient_6888);
    clientoption_set(^clientoption_volume_main_effects, %varclient_6888);
} else if (%varclient_6888 = -1) {
    %varclient_6888 = clientoption_get(^clientoption_volume_login_music);
}
