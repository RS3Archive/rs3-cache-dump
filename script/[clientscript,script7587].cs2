// 7587
[clientscript,script7587](component $component0)
def_graphic $graphic1 = null;
switch_component ($component0) {
    case tsd_assigning_overlay:death_icon :
        $graphic1 = "aif_sleeping_dog_guthix_death,0";
    case tsd_assigning_overlay:thaerisk_icon :
        $graphic1 = "aif_sleeping_dog_guthix_chaeldar_thaerisk,0";
    case tsd_assigning_overlay:valluta_icon :
        $graphic1 = "aif_sleeping_dog_guthix_fiara_valluta,0";
    case tsd_assigning_overlay:cres_icon :
        $graphic1 = "aif_sleeping_dog_guthix_cres,0";
}
if_setgraphic($graphic1, $component0);
