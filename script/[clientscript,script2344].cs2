// 2344
[clientscript,script2344]
if (%mah1_tutorial_camera_step < spline_length(0)) {
    switch_int (++%mah1_tutorial_camera_step) {
        case default :
            if_setoncamfinished(null, mah1_tutorialsplines:controller);
            cam_movealong(0, %mah1_tutorial_camera_step, 900, 500, 1, %mah1_tutorial_camera_step);
        case 9, 10, 11 :
            if_setoncamfinished("script2344", mah1_tutorialsplines:controller);
            cam_movealong(0, %mah1_tutorial_camera_step, 900, 900, 1, %mah1_tutorial_camera_step);
        case 12 :
            if_setoncamfinished(null, mah1_tutorialsplines:controller);
            cam_movealong(0, %mah1_tutorial_camera_step, 900, 100, 1, %mah1_tutorial_camera_step);
    }
} else {
    %mah1_tutorial_camera_step = 0;
}
