// 14808
[clientscript,script14808](component $component0)
def_int $int1 = 0;
def_string $string0 = "View";
def_string $string1 = "";
switch_component ($component0) {
    case arch_journal:tab_general_layer :
        $int1 = 0;
        $string0 = "View general notes";
        $string1 = "General.";
    case arch_journal:tab_armadylean_layer :
        $int1 = 1;
        $string0 = "View Armadylean notes";
        $string1 = "Armadylean culture.";
    case arch_journal:tab_bandosian_layer :
        $int1 = 2;
        $string0 = "View Bandosian notes";
        $string1 = "Bandosian culture.";
    case arch_journal:tab_dragonkin_layer :
        $int1 = 3;
        $string0 = "View Dragonkin notes";
        $string1 = "Dragonkin culture.";
    case arch_journal:tab_guthixian_layer :
        $int1 = 4;
        $string0 = "View Guthixian notes";
        $string1 = "Guthixian culture.";
    case arch_journal:tab_saradominist_layer :
        $int1 = 5;
        $string0 = "View Saradominist notes";
        $string1 = "Saradominist culture.";
    case arch_journal:tab_zamorakian_layer :
        $int1 = 6;
        $string0 = "View Zamorakian notes";
        $string1 = "Zamorakian culture.";
    case arch_journal:tab_zarosian_layer :
        $int1 = 7;
        $string0 = "View Zarosian notes";
        $string1 = "Zarosian culture.";
}
if_setop(1, $string0, $component0);
if_setopcursor(1, cursor_use, $component0);
if_setonop("script14809($int1)", $component0);
if_setonmouserepeat("script3876($string1, $component0, -1)", $component0);
