// 7186
[clientscript,subtitles_fadein](int $int0)
def_int $int1 = min(60, calc($int0 / 3));
if (%cutscene_subtitle_timeout > $int1) {
    ~script7187(calc(if_gettrans(cutscene_subtitle_panel:text) - 255 / $int1));
} else {
    ~script7187(calc(if_gettrans(cutscene_subtitle_panel:text) + 255 / $int1));
}
~cutscene_subtitle_timeout;
