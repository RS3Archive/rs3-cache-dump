// 2026
[proc,script2026]
if_settextfont(museo_sans_11pt_regular, meslayer:mes_text);
if_settextfont(museo_sans_11pt_regular, meslayer:mes_text2);
if_setsize(20, 40, ^setsize_minus, ^setsize_abs, meslayer:mes_text);
if_setsize(20, 20, ^setsize_minus, ^setsize_abs, meslayer:mes_text2);
def_int $int0 = calc((if_getheight(meslayer:mes_layer) - 60 - 20) / 2 + 60);
if_setposition(0, calc((if_getheight(meslayer:mes_layer) - 20 - 40 - $int0) / 2 + 20), ^setpos_abs_centre, ^setpos_abs_top, meslayer:mes_text);
if_setposition(0, $int0, ^setpos_abs_centre, ^setpos_abs_top, meslayer:mes_text2);
if_setonmouserepeat(null, meslayer:mes_text2);
if_setonmouseleave(null, meslayer:mes_text2);
if_setonsubchange(null, meslayer:mes_text2);
if_setcolour(0x000080, meslayer:mes_text2);
cc_deleteall(meslayer:mes_layer);
