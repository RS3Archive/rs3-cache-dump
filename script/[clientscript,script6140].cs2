// 6140
[clientscript,script6140](int $int0, int $int1)
def_int $int2 = 10;
def_int $int3 = calc($int0 * 100 - %fremsaga_bilrach_mind_current_x);
def_int $int4 = calc($int1 * 100 - %fremsaga_bilrach_mind_current_y);
def_int $int5 = 100;
if ($int3 <= $int5 & $int3 >= calc(0 - $int5) & $int4 <= $int5 & $int4 >= calc(0 - $int5)) {
    ~script6142($int0, $int1);
    %fremsaga_bilrach_mind_current_x = calc($int0 * 100);
