// 396
[clientscript,xbows_pouch_num]
if_settext(tostring(%xbows_pouch_num1), xbows_pouch:num1);
if_settext(tostring(%xbows_pouch_num2), xbows_pouch:num2);
if_settext(tostring(%xbows_pouch_num3), xbows_pouch:num3);
if_settext(tostring(%xbows_pouch_num4), xbows_pouch:num4);
if (%xbows_pouch_num1 = 0) {
    if_setcolour(0xff0033, xbows_pouch:num1);
} else {
    if_setcolour(0x00c000, xbows_pouch:num1);
}
if (%xbows_pouch_num2 = 0) {
    if_setcolour(0xff0033, xbows_pouch:num2);
} else {
    if_setcolour(0x00c000, xbows_pouch:num2);
}
if (%xbows_pouch_num3 = 0) {
    if_setcolour(0xff0033, xbows_pouch:num3);
} else {
    if_setcolour(0x00c000, xbows_pouch:num3);
}
if (%xbows_pouch_num4 = 0) {
    if_setcolour(0xff0033, xbows_pouch:num4);
} else {
    if_setcolour(0x00c000, xbows_pouch:num4);
}
