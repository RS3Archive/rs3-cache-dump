// 16200
[proc,script16200](int $int0)
if ($int0 = 1) {
    if_setgraphic("rs3_btn_radio_large,2", wheel_of_fortune:single_graphic);
    if_setgraphic("rs3_btn_radio_large,0", wheel_of_fortune:multi_graphic);
} else {
    if_setgraphic("rs3_btn_radio_large,0", wheel_of_fortune:single_graphic);
    if_setgraphic("rs3_btn_radio_large,2", wheel_of_fortune:multi_graphic);
}
