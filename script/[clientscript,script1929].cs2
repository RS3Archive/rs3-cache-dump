// 1929
[clientscript,script1929](component $component0, int $int1)
if (if_find($component0) = true) {
    if ($component0 = qps:tab1_track_right_button) {
        if ($int1 = 1) {
            cc_setgraphic(button_arrow_next_qps_over);
        } else {
            cc_setgraphic(button_arrow_next_qps_default);
        }
    } else if ($int1 = 1) {
        cc_setgraphic(button_shelf_custom_qps_over);
    } else {
        cc_setgraphic(button_shelf_custom_qps_default);
    }
}
