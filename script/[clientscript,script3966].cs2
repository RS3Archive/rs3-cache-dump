// 3966
[clientscript,script3966](int $int0, int $int1, int $int2, int $int3, int $int4, int $int5, int $int6)
def_int $int7 = 0;
%fremsaga_thok2_ending_montage_type = $int0;
def_int $int8 = ~rgb_to_hex($int1, $int2, $int3);
def_int $int9 = ~rgb_to_hex($int4, $int5, $int6);
if_setmaxlines(4, fremsaga_thok2_ending_montage:text_description);
switch_int ($int0) {
    case 0 :
        ~script6118($int8, $int9);
        if_setgraphic("aif_aif_clan_island_layout_04_sml,3", fremsaga_thok2_ending_montage:image_graphic);
        if_settext("And so Thok made good on his word and made Bone Face pay for getting in the way of his next adventure.", fremsaga_thok2_ending_montage:text_description);
    case 1 :
        ~script6118($int8, $int9);
        if_setgraphic("aif_aif_clan_island_layout_04_sml,3", fremsaga_thok2_ending_montage:image_graphic);
        if_settext("Thok returned Mini-Marm and Mrs Mini-Marm to their pool, where they made a start on building a mighty crab army.", fremsaga_thok2_ending_montage:text_description);
    case 2 :
        ~script6118($int8, $int9);
        $int7 = calc(%fremsaga_thok2_killcount_thok - %fremsaga_thok2_killcount_marmaros);
        if ($int7 >= 4) {
            if_setgraphic("aif_aif_clan_island_layout_04_sml,3", fremsaga_thok2_ending_montage:image_graphic);
            if_settext("Thok triumphed over his brother Marmaros, beating him by a mighty <tostring(%fremsaga_thok2_killcount_thok)> kills to Marmaros's <tostring(%fremsaga_thok2_killcount_marmaros)>.<br>Thok is the greatest brother! Marmaros never stood a chance.", fremsaga_thok2_ending_montage:text_description);
        } else if ($int7 > 0) {
            if_setgraphic("aif_aif_clan_island_layout_04_sml,3", fremsaga_thok2_ending_montage:image_graphic);
            if_settext("Thok scraped a close victory over Marmaros, beating him by a mere <tostring(%fremsaga_thok2_killcount_thok)> kills to Marmaros's <tostring(%fremsaga_thok2_killcount_marmaros)>.<br>Can Thok achieve a more decisive win? Play again to find out!", fremsaga_thok2_ending_montage:text_description);
        } else if ($int7 < 0) {
            if_setgraphic("aif_aif_clan_island_layout_04_sml,3", fremsaga_thok2_ending_montage:image_graphic);
            if_settext("Marmaros defeated his brother Thok, barely beating him with <tostring(%fremsaga_thok2_killcount_marmaros)> kills to Thok's <tostring(%fremsaga_thok2_killcount_thok)>.<br>Marmaros is the greatest brother! Play again; maybe you can defeat him next time.", fremsaga_thok2_ending_montage:text_description);
        } else {
            if_setgraphic("aif_aif_clan_island_layout_04_sml,3", fremsaga_thok2_ending_montage:image_graphic);
            if_settext("Thok and Marmaros both killed the same number of enemies, each with a kill count of <tostring(%fremsaga_thok2_killcount_marmaros)>.<br>Who can be the better brother? Play again to find out!", fremsaga_thok2_ending_montage:text_description);
        }
    case 3 :
        ~script6118($int8, $int9);
        if_setgraphic("aif_aif_clan_island_layout_04_sml,3", fremsaga_thok2_ending_montage:image_graphic);
        if_settext("Pretty Lass is quietly waiting for Thok to ask her out on a date.", fremsaga_thok2_ending_montage:text_description);
    case 4 :
        ~script6118($int8, $int9);
        if_setgraphic("aif_aif_clan_island_layout_04_sml,3", fremsaga_thok2_ending_montage:image_graphic);
        if_settext("Bone Face still hasn't woken up yet.", fremsaga_thok2_ending_montage:text_description);
}
%fremsaga_thok2_ending_montage_last_direction = calc((%fremsaga_thok2_ending_montage_last_direction + 1) % 4);
~script6115(1);
