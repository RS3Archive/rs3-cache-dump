        } else {
            $string0 = "<br>- At <col=ffffff><tostring(~script20086)></col> stacks your <sprite=30015><nbsp><col=ffffff><struct_param(combatv2_ability_necromancy_basic_attack, combatv2_ability_name)> is empowered and generates <col=ffffff><tostring(1)> <sprite=30123><nbsp><col=ffffff><struct_param(combatv2_buff_necromancy_residual_soul, combatv2_ability_name)></col>.";
        }
    case combatv2_buff_necromancy_death_essence :
        $string0 = "<br><br>- <sprite=30076><nbsp><col=ffffff><struct_param(combatv2_ability_necromancy_death_touch, combatv2_ability_name)></col>, <sprite=30077><nbsp><col=ffffff><struct_param(combatv2_ability_necromancy_finger_of_death, combatv2_ability_name)></col>, <sprite=30074><nbsp><col=ffffff><struct_param(combatv2_ability_necromancy_death_skulls, combatv2_ability_name)>:</col> Immediately readies <sprite=30127><nbsp><col=ffffff><struct_param(combatv2_buff_necro_rasial_armguard_t95_passive, combatv2_ability_name)></col>.";
    case combatv2_buff_necromancy_soul_crush :
        $string0 = "<br><br>- <sprite=30080><nbsp><col=ffffff><struct_param(combatv2_ability_necromancy_soul_sap, combatv2_ability_name)></col>, <sprite=30082><nbsp><col=ffffff><struct_param(combatv2_ability_necromancy_soul_strike, combatv2_ability_name)></col>, <sprite=30088><nbsp><col=ffffff><struct_param(combatv2_ability_necromancy_volley_of_souls, combatv2_ability_name)>, <sprite=30084><nbsp><col=ffffff><struct_param(combatv2_ability_necromancy_spectral_scythe, combatv2_ability_name)>:</col> Immediately readies <sprite=35068><nbsp><col=ffffff><struct_param(combatv2_buff_necro_devourer_armguard_t95_passive, combatv2_ability_name)></col>.";
    case combatv2_boss_buff_rasial_mainhand_passive :
        if (%combatv2_boss_buff_rasial_mainhand_passive_stacks = 6) {
            $string0 = "<br>- Rasial's basic attack is empowered and will deal <~script17717(200)></col>.";
        } else {
            $string0 = "<br>- At <tostring(6)> stacks Rasial's basic attack is empowered and deals <~script17717(200)></col>.";
        }
    case combatv2_buff_ranged_imbued_shadows :
        $string0 = "<br>- <col=25AD37>Ranged attacks</col> generate <~script11570(50)> with each hit.";
    case combatv2_buff_ranged_searing_winds :
        $string0 = "<br>- <col=25AD37>Ranged attacks</col> deal an additional <~script17719(combatv2_ability_weapon_ranged, -1, 20, 1, 1)> with each hit.";
    case combatv2_buff_magic_flow_stacks, combatv2_buff_magic_greater_flow_stacks :
        $string0 = ~script18624($struct0, $string0);
    case combatv2_buff_magic_wrack :
        $string0 = ~script12618($struct0, $string0);
    case combatv2_buff_magic_wild_magic_infused :
        $string0 = ~script13038($struct0, $string0);
    case combatv2_buff_blood_tithe :
        $string0 = ~script13086($struct0, $string0);
    case combatv2_buff_glacial_embrace :
        $string0 = ~script13790($struct0, $string0);
    case combatv2_buff_weapon_passive_dark_burn :
        $string0 = "<br>- After <col=ffffff><tostring(15)></col> attacks launch an additional attack that deals <col=ffffff><~tostring_decimal(100, 1, 1, 0, 1)>%</col> of the total damage stored.";
    case combatv2_buff_frostblades :
        $string0 = "<br>- <col=FFA11A>Melee abilities</col> deal <~script17719(combatv2_ability_weapon_melee, -1, 24, 1, 1)>.";
    case combatv2_buff_primordial_ice :
        $string0 = "<br><br>Maximum stacks: <col=ffffff><tostring(10)></col>.";
    case combatv2_debuff_resurrection_sickness :
        $string0 = "<br>- Damage is reduced by <col=ffffff><tostring(75)>%</col>.";
    case combatv2_buff_magic_devourer_t95_passive_stacks :
        $string0 = "<br>- <tostring(1)>+ <sprite=33967><nbsp><struct_param(combatv2_buff_magic_devourer_t95_passive_stacks, combatv2_ability_name)> stack: Damage over time abilities have a <tostring(30)>% chance to become empowered, dealing all of their damage immediately and refreshing their cooldown.";
        $string0 = "<$string0><br>- <tostring(10)>+ <sprite=33967><nbsp><struct_param(combatv2_buff_magic_devourer_t95_passive_stacks, combatv2_ability_name)> stacks: <~script17722(3, 1)> deals <tostring(300)>% of <sprite=33967><nbsp><struct_param(combatv2_buff_magic_devourer_t95_passive_stacks, combatv2_ability_name)> stacks + <tostring(100)>% of your <~script18576(6, 1, 1)> as bonus damage.";
        $string0 = "<$string0><br>- <tostring(25)>+ <sprite=33967><nbsp><struct_param(combatv2_buff_magic_devourer_t95_passive_stacks, combatv2_ability_name)> stacks: Basic abilities generate an additional <~script11570(calc(10 * 6))> over <~script15973(6, 1)>.";
    case combatv2_buff_soulfire_combust :
        $string0 = "<br>- Your next <sprite=23401><nbsp><col=ffffff><struct_param(combatv2_ability_magic_combust, combatv2_ability_name)></col> within <col=ffffff><~script15973(25, 1)></col> deals <col=ffffff><tostring(40)>%</col> increased damage.";
    case combatv2_buff_magic_temporal_anomaly :
        $string0 = ~script19867($string0);
    case combatv2_buff_vampyrism :
        $string0 = ~script16254($string0);
    case combatv2_buff_penance :
        $string0 = ~script16256($string0);
    case combatv2_buff_animate_dead :
        $string0 = ~script3939($string0);
