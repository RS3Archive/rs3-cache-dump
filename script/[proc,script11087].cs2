    case combatv2_buff_necromancy_spirit_phantom_guardian :
        $string0 = "<br><br>Maximum stacks: <col=ffffff><tostring(~script6438)></col>.";
    case combatv2_debuff_death_mark :
        $string0 = "<br>- <col=A788DD>Necromancy attacks</col> will execute the mark for fatal damage if life points drop below <col=ffffff><tostring_localised(20, true)>%</col>.";
    case combatv2_buff_necromancy_darkness :
        $string0 = "<br>- <col=ffffff><tostring(calc(200 / 10))>%</col> chance to dodge incoming attacks.";
    case combatv2_debuff_shattering_bones :
        $string0 = "<br>- Reduces <col=ffffff>armour rating</col> for each stack.";
    case combatv2_buff_necro_rasial_armguard_t95_passive :
        if (%combatv2_buff_necro_rasial_armguard_t95_passive_stacks = ~script17464) {
            $string0 = "<br>- Your <sprite=30015><nbsp><col=ffffff><struct_param(combatv2_ability_necromancy_basic_attack, combatv2_ability_name)> is empowered and will deal <~script17717(200)>.";
        } else {
            $string0 = "<br>- At <col=ffffff><tostring(~script17464)></col> stacks your <sprite=30015><nbsp><col=ffffff><struct_param(combatv2_ability_necromancy_basic_attack, combatv2_ability_name)> is empowered and deals <~script17717(200)></col>.";
        }
    case combatv2_buff_necro_devourer_armguard_t95_passive :
        if (%combatv2_buff_necro_devourer_armguard_t95_passive_stacks = ~script20086) {
