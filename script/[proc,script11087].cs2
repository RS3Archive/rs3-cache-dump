// 11087
[proc,script11087](struct $struct0)(string)
def_string $string0 = "";
def_obj $obj1 = null;
def_int $int2 = 0;
switch_struct ($struct0) {
    case combatv2_beach_cocktail_support :
        $string0 = " - <tostring(10)>% Support XP Boost";
    case combatv2_beach_cocktail_gathering :
        $string0 = " - <tostring(10)>% Gatherer XP Boost";
    case combatv2_beach_cocktail_combat :
        $string0 = " - <tostring(10)>% Combat XP Boost";
    case combatv2_beach_cocktail_artisan :
        $string0 = " - <tostring(10)>% Artisan XP Boost";
    case combatv2_god_book_timer_dummy_ability :
        $obj1 = inv_getobj(worn, 17);
        if ($obj1 ! null) {
            $string0 = "<oc_name($obj1)> Active";
        }
    case combatv2_blood_essence_timer_dummy_ability :
        $obj1 = inv_getobj(worn, 17);
        if ($obj1 = myq7_blood_essence_berserk) {
            $string0 = "<oc_name($obj1)> is boosting your combat skills";
        } else {
            $string0 = "<oc_name($obj1)> will activate on your next attack";
        }
    case combatv2_blood_essence_reflect_timer_dummy_ability :
        $obj1 = inv_getobj(worn, 17);
        if ($obj1 ! null) {
            $string0 = "<oc_name($obj1)> is reflecting <tostring(calc(100 / 20))>% of incoming damage";
        }
    case combatv2_crystal_shield_defend_dummy_ability :
        $string0 = "Crystal Shield Defence Active - You have <col=00ff00><tostring_localised(%invent_perk_crystal_shield_hp_pool, true)></col> temporary life points, thanks to your Crystal Shield's absorption.";
    case combatv2_jas_boost :
        $string0 = "The residual energy from the Stone of Jas is empowering you, increasing your damage by <col=33cc33><tostring(%combatv2_jas_boost)>%</col>.";
    case combatv2_cannon_ammo :
        if (%rockthrower = 1) {
            $string0 = "You have 1 cannonball remaining in your cannon.";
        } else {
            $string0 = "You have <tostring(%rockthrower)> cannonballs remaining in your cannon.";
        }
        $string0 = append($string0, "<br>Damage: <col=FF00>100%</col>");
    case combatv2_cannon_ammo_meteorite :
        if (%rockthrower = 1) {
            $string0 = "You have 1 meteorite cannonball remaining in your cannon.";
        } else {
            $string0 = "You have <tostring(%rockthrower)> meteorite cannonballs remaining in your cannon.";
        }
        $string0 = append($string0, "<br>Damage: <col=FF00><tostring(150)>%</col>");
    case combatv2_clan_ava_skillplot_level :
        $int2 = calc(10080 - (date_minutes - %clav_buff_bought_time_varp) + 1);
        if ($int2 > 0) {
            $string0 = "<br>This boost will expire in <~script11479(calc($int2 / 1440), calc($int2 % 1440 / 60), calc($int2 % 60))>.";
        }
        $string0 = append("Attuning to the Avatar Habitat has granted you a <col=33cc33><tostring(%clan_avatar_buff_skillplot)>%</col> boost in resources gathered at Citadel skill plots.", $string0);
    case combatv2_buff_rexkings_ranged_corroded :
        $string0 = " - You are taking an additional <col=33cc33><tostring(calc(%combatv2_buff_rexkings_ranged_corroded_count * 20))>%</col> damage.";
    case combatv2_buff_egwd_bik_magic_armour_shield :
        $string0 = "Fungal Shield Active - You are shielded for <col=00ff00><tostring_localised(%egwd_bik_magic_armour_shield, true)></col> life points, by your Fungal Shield";
    case divination_porter_active, divination_gote_porter_disabled :
        if (inv_getobj(worn, 2) = alch_onyx_skill_necklace_used) {
            $string0 = " Remaining charges: <tostring(inv_getvar(worn, 2, invent_obj_charges))>";
        }
    case combatv2_sworlds_punctured_dummy_ability :
        $string0 = "<br>- <col=ffffff><tostring(calc(50 + 20 + 15 + 10 + 5))>%</col> of the total damage applied over <col=ffffff><~script14945(calc(3 * 5), 1)></col>.";
        $string0 = "<$string0><br>- <col=ffffff><tostring(5)></col> hits.";
        $string0 = "<$string0><br>- <col=ffffff>Damage over time</col>.";
    case combatv2_debuff_necromancy_bloated :
        $string0 = "<br>- <col=ffffff><tostring(25)>%</col> of initial damage per hit every <col=ffffff><~script14945(3, 1)></col>.";
        $string0 = "<$string0><br>- <col=ffffff>Damage over time</col>.";
        $string0 = "<$string0><br>- <col=ffffff>On-death:</col> Applies <sprite=30098><nbsp><col=ffffff><struct_param(combatv2_debuff_necromancy_bloated, combatv2_ability_name)></col> to up to <~script18560(9)> within <col=ffffff><tostring(1)> <~text_plural(1, "tile", "tiles")></col> for <col=ffffff>4</col> hits.";
    case combatv2_buff_necromancy_necrosis :
        $string0 = "<br><br>Maximum stacks: <col=ffffff><tostring(~script17458)></col>.";
    case combatv2_buff_necromancy_residual_soul :
        $string0 = "<br><br>Maximum stacks: <col=ffffff><tostring(~script17459)></col>.";
