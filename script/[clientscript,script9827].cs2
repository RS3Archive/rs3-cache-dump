// 9827
[clientscript,script9827]
if (~script6431 = true) {
    if_sethide(true, toplevel_v2_ribbon_select:parent_wrapper);
    if_setposition(0, 90, ^setpos_abs_centre, ^setpos_abs_bottom, toplevel_v2_ribbon_select:showing_list);
} else {
    if_setposition(0, 50, ^setpos_abs_centre, ^setpos_abs_bottom, toplevel_v2_ribbon_select:showing_list);
}
