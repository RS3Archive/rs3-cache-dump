// 4812
[clientscript,script4812](string $string0, graphic $graphic0, int $int1, int $int2)
if (~tooltip_time($int2) = false) {
    return;
}
if (%tooltip_built ! 1) {
    $string0 = "<$string0><br>Requires tier <tostring($int1)> resources.";
    if_setgraphic($graphic0, clan_stronghold_main_decor:custom_tooltip_graphic);
    if_settext($string0, clan_stronghold_main_decor:custom_tooltip_text);
    if_sethide(false, clan_stronghold_main_decor:custom_tooltip);
    %tooltip_built = 1;
}
