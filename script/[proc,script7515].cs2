// 7515
[proc,script7515](graphic $graphic0)(string)
def_string $string0 = "";
switch_graphic ($graphic0) {
    case aif_mantis_card_sml :
        $string0 = "Trade your chest with the next player.";
    case aif_leech_card_sml :
        $string0 = "Trade your chest with the previous ranked player.";
    case aif_mosquito_card_sml :
        $string0 = "Your chest contain the same as the previous ranked player.";
    case aif_bunnyip_card_sml :
        $string0 = "Randomly generate a new card that will be played immediately.";
    case aif_steel_titan_card_sml :
        $string0 = "Protects your chest from being moved once per game.";
    case aif_locust_card_sml :
        $string0 = "Trade your chest with the player ranked last.";
    case aif_yak_card_sml :
        $string0 = "Whatever is in your chest at the end of the game, you will receive a medium lamp as your reward.";
    case aif_meerkat_card_sml :
        $string0 = "Adds an extra medium lamp to your chest but every player still to play will receive an extra card.";
    case aif_phoenix_card_sml :
        $string0 = "Rise from the ashes by returning chests to the contents from the previous turn.";
    case aif_stork_card_sml :
        $string0 = "Add a piece of gorajo clothing to your chest which can be worn outside of these dungeons.";
    case aif_dust_devil_card_sml :
        $string0 = "Randomise all player's chests.";
}
return($string0);
