}
if ($component0 = assister_interface:construction_layer) {
    return(%assist_construction_xp_on, "Construction");
}
if ($component0 = assister_interface:farming_layer) {
    return(%assist_farming_xp_on, "Farming");
}
if ($component0 = assister_interface:magic_layer) {
    return(%assist_magic_xp_on, "Magic");
}
if ($component0 = assister_interface:smithing_layer) {
    return(%assist_smithing_xp_on, "Smithing");
}
if ($component0 = assister_interface:cooking_layer) {
