// 1749
[clientscript,brew_boiler3](component $component0, component $component1)
if (%brew_varc_boiler3 > 2) {
    if_setmodel(game_brew_if_boiler3_on, $component0);
    if_setcolour(0x33ff00, $component1);
} else {
    if_setmodel(game_brew_if_boiler3_off, $component0);
    if_setcolour(0x910000, $component1);
}
if_settext(tostring(%brew_varc_boiler3), $component1);
