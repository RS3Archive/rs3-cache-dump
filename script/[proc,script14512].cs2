// 14512
[proc,script14512](dbrow $dbrow0)(int)
switch_dbrow ($dbrow0) {
    case collection_log_bosses :
        return(%collection_log_favourite_bosses);
    case collection_log_cluescrolls :
        return(%collection_log_favourite_cluescrolls);
    case collection_log_farm_animals :
        return(%collection_log_favourite_farm_animals);
    case collection_log_slayer :
        return(%collection_log_favourite_slayer);
    case collection_log_arch_restorations :
        return(%collection_log_favourite_arch_restorations);
}
return(0);
