// 1920
[clientscript,script1920]
if_setonvarcstrtransmit("script1921{sc_lobby_clan_leader}", sc_lobby_clan_overlay:clan_leader_text);
if_setonvarcstrtransmit("script1921{sc_lobby_ally_leader_1}", sc_lobby_clan_overlay:ally_1_text);
if_setonvarcstrtransmit("script1921{sc_lobby_ally_leader_2}", sc_lobby_clan_overlay:ally_2_text);
if_setonvarctransmit("script1921{sc_lobby_clan_size}", sc_lobby_clan_overlay:clan_leader_text);
if_setonvarctransmit("script1921{sc_lobby_ally_size_1}", sc_lobby_clan_overlay:ally_1_text);
if_setonvarctransmit("script1921{sc_lobby_ally_size_2}", sc_lobby_clan_overlay:ally_2_text);
%sc_lobby_clan_leader = "You have no clan leader.";
%sc_lobby_ally_leader_1 = "You have no allied clans.";
%sc_lobby_ally_leader_2 = "";
%sc_lobby_clan_size = 0;
%sc_lobby_ally_size_1 = 0;
%sc_lobby_ally_size_2 = 0;
