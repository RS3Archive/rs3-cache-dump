// 4334
[proc,script4334](component $component0, component $component1)
if (activeclansettings_getaffinedcount >= 5) {
    if_setcolour(hsvtorgb(%varclansetting_18), $component0);
    if_setcolour(hsvtorgb(%varclansetting_19), $component1);
} else {
    if_setcolour(hsvtorgb(42550), $component0);
    if_setcolour(hsvtorgb(39382), $component1);
}
