// 8010
[proc,fadeout_comp](int $int0, component $component1, component $component2)
if ($component2 = null) {
    $component2 = $component1;
}
if (if_find($component1) = true) {
    cc_settrans(0);
    if_setontimer("fadeout_comp(calc(clientclock + $int0), $component1, $component2)", $component2);
}
