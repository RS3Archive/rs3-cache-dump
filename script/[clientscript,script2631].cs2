    case 0 :
        mes_typed(^chattype_console, -1, "North");
        ~script8767(1983, 8142, 7600);
    case 1 :
        mes_typed(^chattype_console, -1, "East");
        ~script8767(1983, 4071, 7600);
    case 2 :
