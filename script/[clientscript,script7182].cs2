// 7182
[clientscript,script7182](string $string0, int $int0)
if (calc(clientclock % 2) = 0) {
    ~script7183($string0, max(0, min(string_length($string0), $int0)));
    if_setontimer("script7182($string0, max(0, min(string_length($string0), calc($int0 + 1))))", cutscene_subtitle_panel:main_layer);
}
~cutscene_subtitle_timeout;
