// 6701
[clientscript,bigchinchompa_hud_time_countdown](component $component0, component $component1, int $int2)
if (clientclock < $int2) {
    return;
}
if (%varclient_2012 > 0) {
    %varclient_2012 = calc(%varclient_2012 - 1);
    ~bigchinchompa_hud_time($component0, $component1, 30);
} else {
    if_setontimer(null, $component0);
}
