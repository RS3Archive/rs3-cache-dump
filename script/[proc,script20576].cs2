    case 4 :
        sound_vorbis_rate(sound_59081, 1, 0, 150, 350);
    case 5 :
        sound_vorbis_rate(sound_59082, 1, 0, 150, 350);
}
def_stat $stat0 = enum(int, stat, enum_681, %varplayer_12583);
def_string $string0 = enum(stat, string, enum_680, $stat0);
def_int $int1 = 0;
def_boolean $boolean2 = false;
$int1, $boolean2 = ~script20455(%varplayer_12583, %varplayer_12584);
def_string $string1 = "";
def_string $string2 = "";
def_int $int3 = ~script20568($stat0);
if ($int3 = 2) {
    $string1 = "<col=FA3232>You cannot place Bonus XP in this skill as you have reached the 100m Bonus XP cap.</col>";
