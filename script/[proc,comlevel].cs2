// 1432
[proc,comlevel]()(int)
def_int $int0 = calc(stat_base(attack) + stat_base(strength));
def_int $int1 = calc(stat_base(ranged) * 2);
def_int $int2 = calc(stat_base(magic) * 2);
def_int $int3 = calc(stat_base(necromancy) * 2);
def_int $int4 = max(max(max($int0, $int1), $int2), $int3);
$int4 = calc($int4 * 13 / 10);
def_int $int5 = calc(($int4 + stat_base(defence) + stat_base(hitpoints) + stat_base(prayer) / 2 + stat_base(summoning) / 2) / 4);
def_int $int6 = calc(($int4 + stat_base(defence) + stat_base(hitpoints) + stat_base(prayer) / 2 + 1) / 4);
if (map_members = true) {
    return($int5);
} else {
    return($int6);
}
