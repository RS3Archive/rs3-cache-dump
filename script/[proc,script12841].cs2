// 12841
[proc,script12841](obj $obj0, inv $inv1, int $int2)
%tli_optext_item = $obj0;
if ($inv1 ! null & $int2 >= 0 & invother_getobj($inv1, $int2) = $obj0) {
    %tli_optext_inv = $inv1;
    %tli_optext_slot = $int2;
    %tli_optext_otherplayer_inv = 1;
} else {
    %tli_optext_inv = null;
    %tli_optext_slot = -1;
}
%tli_optext_custom_string = "";
