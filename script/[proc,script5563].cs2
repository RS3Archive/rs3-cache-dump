def_int $int1 = calc(inv_total(inv, rs_bond_untradeable) + %bonds_pouch_untradeable_total);
def_int $int2 = ~script17401;
if_settext(~script17372(~script17400, 9, 1), bonds_repackage:coins_info_count);
