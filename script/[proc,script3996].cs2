// 3996
[proc,script3996](obj $obj0)(boolean)
if (oc_param($obj0, nonbankable) = 1) {
    return(true);
} else if (oc_param($obj0, rand_item) = 1) {
    return(true);
}
switch_obj ($obj0) {
    case abyss_kill_me :
        if (~bank_in_wilderness = 1) {
            return(true);
        }
}
return(false);
