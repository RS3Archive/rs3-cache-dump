// 13669
[proc,script13669]
def_int $int0 = 0;
def_int $int1 = inv_size(inv);
while ($int0 < $int1) {
    if (testbit(%invent_machine_management_slots_to_grey, $int0) = ^true & cc_find(invent_machine_management:inv_inv, $int0) = true) {
        cc_setcolour(0x222222);
        cc_settrans(153);
    }
    $int0 = calc($int0 + 1);
}
