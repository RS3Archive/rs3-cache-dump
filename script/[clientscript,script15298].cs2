~script16706(trh171_overlay:reward_current_prize_layer, $obj0, %trh171_current_prize_count, ~script14580, ~script15290, 0);
if ($obj0 ! null) {
    $string0 = oc_name($obj0);
}
if_settext($string0, trh171_overlay:prize_name);
if ($int4 = 0) {
    if_sethide(true, trh171_overlay:modifier_icon_wrapper);
} else {
    if_sethide(false, trh171_overlay:modifier_icon_wrapper);
}
if_setgraphic(trh171_modifier_icon_blank, trh171_overlay:modifier_icon_gfx);
if_setobject(null, -1, trh171_overlay:modifier_icon_obj);
if_setposition(0, 0, ^setpos_abs_centre, ^setpos_abs_centre, trh171_overlay:modifier_icon_text);
$string1, $string2, $int1, $obj2, $int3 = db_getfield(trh171_modifiers, trh171_modifier_data:col0, $int4);
if ($int3 = 1) {
