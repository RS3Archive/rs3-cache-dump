}
if_settextfont(cinzel_25pt_bold_multiline, trh171_overlay:modifier_icon_text);
if_sethide(true, trh171_overlay:current_item_random);
if_sethide(false, trh171_overlay:reward_current_prize_layer);
switch_int ($int4) {
    case 1 :
        if_setgraphic(trh171_modifier_icon_reroll, trh171_overlay:modifier_icon_gfx);
        if_settext("", trh171_overlay:modifier_icon_text);
