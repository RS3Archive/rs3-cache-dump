// 15407
[proc,script15407]
def_int $int0 = if_getwidth(paint_cannon:clickout_blocker);
def_int $int1 = if_getheight(paint_cannon:clickout_blocker);
def_int $int2 = if_getx(paint_cannon:container);
def_int $int3 = if_gety(paint_cannon:container);
def_int $int4 = if_getwidth(paint_cannon:container);
def_int $int5 = if_getheight(paint_cannon:container);
if_setsize($int2, 0, ^setsize_abs, ^setsize_minus, paint_cannon:bg_left);
if_setsize(calc($int0 - $int2 - $int4), 0, ^setsize_abs, ^setsize_minus, paint_cannon:bg_right);
if_setsize(0, $int3, ^setsize_minus, ^setsize_abs, paint_cannon:bg_top);
if_setsize(0, calc($int1 - $int3 - $int5), ^setsize_minus, ^setsize_abs, paint_cannon:bg_bot);
if_setontimer("script4156($int0, $int1)", paint_cannon:clickout_blocker);
