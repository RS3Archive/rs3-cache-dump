// 10326
[clientscript,script10326](component $component0)
def_component $component1 = group_child_dropdown:content_layer;
if_setonplayergrouptransmit("script10326($component0)", $component1);
if (player_group_find = true) {
    ~script10327($component1, $component0);
} else {
    ~script10328($component1, $component0);
}
