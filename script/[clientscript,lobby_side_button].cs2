// 15624
[clientscript,lobby_side_button](component $component0)
switch_component ($component0) {
    case lobbyscreen_mobile_side_menu:button_settings :
        ~script15622;
        ~lobbyscreen_tabswitch(5);
    case lobbyscreen_mobile_side_menu:button_account :
        ~lobbyscreen_link(2507);
    case lobbyscreen_mobile_side_menu:button_messages :
        ~lobbyscreen_link(2501);
    case lobbyscreen_mobile_side_menu:button_terms :
        ~lobbyscreen_link(2);
    case lobbyscreen_mobile_side_menu:button_logout :
        ~lobbyscreen_leavelobby;
}
