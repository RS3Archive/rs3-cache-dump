// 19335
[proc,script19335](int $int0, int $int1)
switch_int ($int0) {
    case 1 :
        %group_ironman_rules_collapsed_glossary = $int1;
    case 2 :
        %group_ironman_rules_collapsed_normal = $int1;
    case 3 :
        %group_ironman_rules_collapsed_hardcore = $int1;
    case 4 :
        %group_ironman_rules_collapsed_group = $int1;
    case 5 :
        %group_ironman_rules_collapsed_competitive = $int1;
    case 6 :
        %group_ironman_rules_collapsed_downgrade = $int1;
    case default :
        ~error("Unexpected category: <tostring($int0)>");
}
