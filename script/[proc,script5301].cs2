// 5301
[proc,script5301]
if (%clan_keep_theatre_spot1 = 1) {
    if_setcolour(0xaaaa00, clan_keep_theatre_spotlight:onoff_rect_1);
    if_settext("On", clan_keep_theatre_spotlight:onoff_text_1);
} else {
    if_setcolour(^black, clan_keep_theatre_spotlight:onoff_rect_1);
    if_settext("Off", clan_keep_theatre_spotlight:onoff_text_1);
}
if (%clan_keep_theatre_spot2 = 1) {
    if_setcolour(0xaaaa00, clan_keep_theatre_spotlight:onoff_rect_2);
