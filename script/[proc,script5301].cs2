} else {
    if_setcolour(^black, clan_keep_theatre_spotlight:onoff_rect_2);
    if_settext("Off", clan_keep_theatre_spotlight:onoff_text_2);
}
if (%clan_keep_theatre_spot3 = 1) {
    if_setcolour(0xaaaa00, clan_keep_theatre_spotlight:onoff_rect_3);
    if_settext("On", clan_keep_theatre_spotlight:onoff_text_3);
} else {
    if_setcolour(^black, clan_keep_theatre_spotlight:onoff_rect_3);
    if_settext("Off", clan_keep_theatre_spotlight:onoff_text_3);
}
if (%clan_keep_theatre_spot4 = 1) {
    if_setcolour(0xaaaa00, clan_keep_theatre_spotlight:onoff_rect_4);
    if_settext("On", clan_keep_theatre_spotlight:onoff_text_4);
} else {
    if_setcolour(^black, clan_keep_theatre_spotlight:onoff_rect_4);
    if_settext("Off", clan_keep_theatre_spotlight:onoff_text_4);
}
