// 11292
[proc,script11292](int $int0)
if ($int0 = 1) {
    switch_stat (%event18_active_stat) {
        case agility :
            ~script8844(1, 16, 8, event17_minigame:event17_walk_click_1, -1);
            ~script8844(1, 17, 8, event17_minigame:event17_walk_click_2, -1);
            ~script8844(1, 18, 8, event17_minigame:event17_walk_click_3, -1);
