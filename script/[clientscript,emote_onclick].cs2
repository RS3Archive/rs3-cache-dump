// 10568
[clientscript,emote_onclick]
if (%trh29_emote_unlocked = 1) {
    return;
}
if (inv_total(inv, trh29_doubloons) < 3000) {
    return;
}
%trh29_pirate_coins_shop_selection = 2;
if_setgraphic(trh29_pirate_icon_emote, trh29_pirate_coins_shop:popup_icon);
if_settext("Be made to walk the plank by an enraged pirate.", trh29_pirate_coins_shop:popup_description);
if_settext("Buy Walk the Plank emote?", trh29_pirate_coins_shop:popup_question);
if_sethide(false, trh29_pirate_coins_shop:popup_layer);
