// 13024
[clientscript,music_filter_mouseleave](component $component0)
~script8808;
switch_int (%music_filter_toggle_varc) {
    case default :
        if_setgraphic("aif_music_filter_buttons,0", $component0);
    case 1 :
        if_setgraphic("aif_music_filter_buttons,2", $component0);
    case 2 :
        if_setgraphic("aif_music_filter_buttons,4", $component0);
}
