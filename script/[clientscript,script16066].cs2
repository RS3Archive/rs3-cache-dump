// 16066
[clientscript,script16066](component $component0)
if (%egwd_wen_boss_current_enrage >= 100) {
    if_setgraphic(gwd2_gold_tier_icon, $component0);
} else if (%egwd_wen_boss_current_enrage >= 25) {
    if_setgraphic(gwd2_silver_tier_icon, $component0);
} else {
    if_setgraphic(gwd2_bronze_tier_icon, $component0);
}
