// 13344
[proc,script13344](int $int0, int $int1)
def_int $int2 = 0;
def_int $int3 = 0;
def_int $int4 = 0;
while (cc_find(achievements_sub:build_layer, $int2) = true) {
    if (cc_gety > $int0) {
        cc_setposition(cc_getx, calc(cc_gety + $int1), ^setpos_abs_left, ^setpos_abs_top);
        $int3 = calc($int2 + 1);
        $int4 = calc($int2 + 11);
        while ($int3 < $int4 & .cc_find(achievements_sub:build_layer, $int3) = true) {
            .cc_setposition(.cc_getx, calc(.cc_gety + $int1), ^setpos_abs_left, ^setpos_abs_top);
            $int3 = calc($int3 + 1);
        }
    }
    $int2 = calc($int2 + 11);
}
