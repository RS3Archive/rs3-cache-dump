// 6623
[clientscript,script6623](int $int0, int $int1, graphic $graphic2, component $component3)
if (clientclock < $int0) {
    if (calc(clientclock % 11) = 0) {
        if ($int1 = 1) {
            if_setgraphic($graphic2, $component3);
            $int1 = 0;
        } else {
            if_setgraphic(null, $component3);
            $int1 = 1;
        }
    }
    if_setontimer("script6623($int0, $int1, $graphic2, $component3)", $component3);
} else {
    if_setgraphic(null, $component3);
    if_setontimer(null, $component3);
}
