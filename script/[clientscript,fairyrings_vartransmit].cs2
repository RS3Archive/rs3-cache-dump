        %fairyrings_middle_direction = -1;
    }
}
if (if_find(fairyrings:right_s) = true) {
    $int0, $int1 = ~script15524(%fairyrings_right_offset);
    if ($int0 <= $int1) {
        %fairyrings_right_direction = 1;
    } else {
        %fairyrings_right_direction = -1;
    }
}
