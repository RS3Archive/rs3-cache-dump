// 964
[clientscript,fairyrings_vartransmit]
switch_int (%fairyring1) {
    case default :
        %fairyrings_left_offset = 0;
    case 1 :
        %fairyrings_left_offset = 270;
    case 2 :
        %fairyrings_left_offset = 180;
    case 3 :
        %fairyrings_left_offset = 90;
}
switch_int (%fairyring2) {
    case default :
        %fairyrings_middle_offset = 0;
    case 1 :
        %fairyrings_middle_offset = 270;
    case 2 :
        %fairyrings_middle_offset = 180;
    case 3 :
        %fairyrings_middle_offset = 90;
}
switch_int (%fairyring3) {
    case default :
        %fairyrings_right_offset = 0;
    case 1 :
        %fairyrings_right_offset = 270;
    case 2 :
        %fairyrings_right_offset = 180;
    case 3 :
        %fairyrings_right_offset = 90;
}
def_int $int0 = 0;
def_int $int1 = 0;
if (if_find(fairyrings:left_s) = true) {
    $int0, $int1 = ~script15524(%fairyrings_left_offset);
    if ($int0 <= $int1) {
        %fairyrings_left_direction = 1;
    } else {
        %fairyrings_left_direction = -1;
    }
}
if (if_find(fairyrings:mid_s) = true) {
    $int0, $int1 = ~script15524(%fairyrings_middle_offset);
    if ($int0 <= $int1) {
        %fairyrings_middle_direction = 1;
