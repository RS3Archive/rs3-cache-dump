// 16325
[proc,script16325]()(boolean)
if (~script273 = true) {
    return(true);
}
if (calc(oc_param(inv_getobj(worn, 3), combatv2_held_allow_bladed_dive) + oc_param(inv_getobj(worn, 3), combatv2_melee_weapon)) > 0 & calc(oc_param(inv_getobj(worn, 5), combatv2_held_allow_bladed_dive) + oc_param(inv_getobj(worn, 5), combatv2_melee_weapon)) > 0) {
    return(true);
}
return(false);
