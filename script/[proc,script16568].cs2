// 16568
[proc,script16568](dbrow $dbrow0, int $int1)(string, int)
def_string $string0 = db_getfield($dbrow0, child_options:col0, 0);
def_int $rgb2 = ^white;
switch_int ($int1) {
    case 1 :
        $string0, $rgb2 = ~script17399(%money_pouch_display);
    case 2 :
        switch_dbrow ($dbrow0) {
            case worn_weight :
                $string0 = "<tostring_localised(runweight_visible, true)>kg";
            case inv_money_pouch_contents :
                $string0, $rgb2 = ~script17399(%money_pouch_display);
            case notes_count :
                $string0 = ~notes_get_count_string;
        }
    case default :
        switch_dbrow ($dbrow0) {
            case prayer_filter :
                if (%prayer_client_current_filter = 1) {
                    $string0 = "Filter Prayers";
                } else {
                    $string0 = "Show all Prayers";
                }
            case ability_filter :
                if (%ability_book_filter_unavailable = 0) {
                    $string0 = "Filter unavailable abilities";
                } else {
                    $string0 = "Show unavailable abilities";
                }
            case ability_filter_locked :
                if (%ability_book_filter_locked_abilities = 0) {
                    $string0 = "Filter locked abilities";
                } else {
                    $string0 = "Show locked abilities";
                }
            case ability_filter_lodestone :
                if (%ability_book_filter_lodestone_teleports = 0) {
                    $string0 = "Filter lodestone teleports";
                } else {
                    $string0 = "Show lodestone teleports";
                }
            case spell_filter :
                if (%ability_book_filter_unavailable_spells = 0) {
                    $string0 = "Filter spells";
                } else {
                    $string0 = "Show all spells";
                }
        }
}
return($string0, $rgb2);
