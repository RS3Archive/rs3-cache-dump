// 10302
[proc,script10302](component $component0)(component)
if ($component0 = toplevel_v2_parent_suboverlay_group:main_layer) {
    return(toplevel_v2_parent_suboverlay_group:want_members_layer);
} else if ($component0 = group_child_dropdown:content_layer) {
    return(group_child_dropdown:want_members_layer);
} else {
    return(group_child:want_members_layer);
}
