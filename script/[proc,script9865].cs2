// 9865
[proc,script9865](obj $obj0, obj $obj1)(int)
if (oc_param($obj0, combatv2_special_attack_base_item) ! null) {
    $obj0 = oc_param($obj0, combatv2_special_attack_base_item);
}
if ($obj0 ! null & oc_param($obj0, combatv2_special_attack) = 1) {
    return(1);
} else {
    if (oc_param($obj1, combatv2_special_attack_base_item) ! null) {
        $obj1 = oc_param($obj1, combatv2_special_attack_base_item);
    }
    if ($obj1 ! null & oc_param($obj1, combatv2_special_attack) = 1) {
        return(2);
    }
}
return(0);
