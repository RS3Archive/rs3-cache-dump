// 12489
[proc,script12489]
def_int $int0 = calc(12 * paraheight(if_gettext(mm16_tracking:task_progress), if_getwidth(mm16_tracking:task_progress), if_getfontmetrics(mm16_tracking:task_progress)));
if ($int0 > if_getheight(mm16_tracking:progress)) {
    if_setscrollsize(0, $int0, mm16_tracking:progress);
} else {
    if_setscrollsize(0, 0, mm16_tracking:progress);
    if_setscrollpos(0, 0, mm16_tracking:progress);
}
~rs3_scrollbar_vertical(mm16_tracking:scrollbar, mm16_tracking:progress);
