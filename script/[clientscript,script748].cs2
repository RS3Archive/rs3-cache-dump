// 748
[clientscript,script748]
if_setontimer("script749(tuska_island_overlay:progress_1, 0, 1179671)", tuska_island_overlay:top_panel);
if_sethide(true, tuska_effects:ghost_effect);
if_setsize(0, 23, ^setsize_abs, ^setsize_abs, tuska_island_overlay:progress_1);
if_setcolour(^white, tuska_island_overlay:prog1_m);
if_setposition(15, 2, ^setpos_abs_left, ^setpos_abs_top, tuska_island_overlay:position_pulse);
if_setontimer("script936(clientclock)", tuska_island_overlay:position_pulse);
if_setsize(350, 0, ^setsize_abs, ^setsize_abs, tuska_island_overlay:tutorial_panel);
if_sethide(true, tuska_island_overlay:progress_full_power);
if_sethide(true, tuska_island_overlay:percent_complete);
if (%tuska_first_time_islands > 0) {
    if_sethide(true, tuska_island_overlay:help_button_effect);
}
