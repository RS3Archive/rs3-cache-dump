// 7460
[proc,script7460](obj $obj0)(int)
if ($obj0 = null) {
    return(0);
}
if (oc_wearpos($obj0) > 0 & oc_wearpos2($obj0) > 0) {
    return(2);
}
if (oc_param($obj0, combatv2_ranged_weapon) = 1 & inv_totalparam(worn, combatv2_ranged_weapon) = 2) {
    return(1);
}
if (oc_param($obj0, combatv2_melee_weapon) = 1 & inv_totalparam(worn, combatv2_melee_weapon) = 2) {
    return(1);
}
if (oc_param($obj0, combatv2_magic_weapon) = 1 & inv_totalparam(worn, combatv2_magic_weapon) = 2) {
    return(1);
}
if (oc_param($obj0, combatv2_necromancy_weapon) = 1 & inv_totalparam(worn, combatv2_necromancy_weapon) = 2) {
    return(1);
}
return(3);
