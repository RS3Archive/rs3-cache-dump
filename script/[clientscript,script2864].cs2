// 2864
[clientscript,script2864](component $component0)
def_int $int1 = 0;
if ($component0 = egq_tracking:wheel_tl) {
    $int1 = %egq_tracker_tl_rotation;
}
if ($component0 = egq_tracking:wheel_tr) {
    $int1 = %egq_tracker_tr_rotation;
}
if ($component0 = egq_tracking:wheel_b) {
    $int1 = %egq_tracker_b_rotation;
}
def_int $int2 = calc(65535 - $int1 * 10923);
if ($int2 = 65535) {
    $int2 = 0;
}
if_set2dangle($int2, $component0);
