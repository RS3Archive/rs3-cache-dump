// 12497
[proc,script12497]()(int)
if (%atlum_day_tracker < date_runeday_fromdate(4, 4, 2016)) {
    return(0);
} else if (%atlum_day_tracker < date_runeday_fromdate(9, 4, 2016)) {
    return(1);
} else if (%atlum_day_tracker < date_runeday_fromdate(16, 4, 2016)) {
    return(2);
} else if (%atlum_day_tracker < date_runeday_fromdate(23, 4, 2016)) {
    return(3);
} else if (%atlum_day_tracker < date_runeday_fromdate(30, 4, 2016)) {
    return(4);
} else {
    return(-1);
}
