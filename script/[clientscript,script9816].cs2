// 9816
[clientscript,script9816](component $component0)
def_int $int1 = 0;
def_int $int2 = 0;
if (if_find($component0) = true & .if_find(cc_getparentlayer) = true) {
    $int1 = .cc_getwidth;
    $int2 = .cc_getheight;
    if (scale($int1, cc_param(rs3tli_component_initial_width), cc_param(rs3tli_component_initial_height)) < $int2) {
        cc_setsize(scale($int2, cc_param(rs3tli_component_initial_height), cc_param(rs3tli_component_initial_width)), $int2, ^setsize_abs, ^setsize_abs);
    } else {
        cc_setsize($int1, scale($int1, cc_param(rs3tli_component_initial_width), cc_param(rs3tli_component_initial_height)), ^setsize_abs, ^setsize_abs);
    }
    cc_callonresize;
}
