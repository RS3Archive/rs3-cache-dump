// 12758
[clientscript,script12758](int $int0)
if ($int0 > 30000) {
    $int0 = calc($int0 - 1);
    if_setontimer("script12758($int0)", cruc_dm_overlay:game_timer);
    return;
}
def_int $int1 = calc($int0 / 50);
def_int $int2 = calc($int1 / 60);
$int1 = calc($int1 % 60);
if ($int1 > 9) {
    if_settext("<tostring($int2)>:<tostring($int1)>", cruc_dm_overlay:game_time_text);
} else {
    if_settext("<tostring($int2)>:0<tostring($int1)>", cruc_dm_overlay:game_time_text);
}
if ($int2 = 0 & $int1 <= 10) {
    if (calc($int0 / 20 % 2) > 0) {
        if_sethide(true, cruc_dm_overlay:game_time_text);
    } else {
        if_sethide(false, cruc_dm_overlay:game_time_text);
    }
}
if (--$int0 <= 0) {
    if_setontimer(null, cruc_dm_overlay:game_timer);
    if_sethide(true, cruc_dm_overlay:game_timer);
} else {
    if_setontimer("script12758($int0)", cruc_dm_overlay:game_timer);
}
