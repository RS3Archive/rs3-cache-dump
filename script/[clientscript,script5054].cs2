// 5054
[clientscript,script5054](int $int0, int $int1)
$int0 = calc($int0 - if_getscrollx(clan_field_editor:grid_container));
$int1 = calc($int1 - if_getscrolly(clan_field_editor:grid_container));
if ($int0 < 10) {
    ~script5050(-10, 1, 0);
} else if ($int0 > calc(if_getwidth(clan_field_editor:grid_container) - (%hw10_cutscene + 10))) {
    ~script5050(10, 1, 0);
}
if ($int1 < 10) {
    ~script5050(-10, 1, 1);
} else if ($int1 > calc(if_getheight(clan_field_editor:grid_container) - (%hw10_cutscene + 10))) {
    ~script5050(10, 1, 1);
}
