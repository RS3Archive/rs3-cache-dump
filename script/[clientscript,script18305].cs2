// 18305
[clientscript,script18305]
if_settext(tostring(200), dxp_token_info:spirit_tokens_regular);
if_settext(tostring(4), dxp_token_info:protean_tokens_regular);
if_settext(tostring(80), dxp_token_info:dummy_tokens_regular);
if_setobject_nonum(dxp_tokens_currency, 1, dxp_token_info:protean_regular_token_graphic);
if_setobject_nonum(dxp_tokens_currency, 1, dxp_token_info:dummy_regular_token_graphic);
if_setobject_nonum(dxp_tokens_currency, 1, dxp_token_info:spirit_regular_token_graphic);
switch_int (map_lang) {
    case 0 :
        if_setgraphic(dxp_tokens_bg_en, dxp_token_info:background);
    case 1 :
        if_setgraphic(dxp_tokens_bg_de, dxp_token_info:background);
    case 2 :
        if_setgraphic(dxp_tokens_bg_fr, dxp_token_info:background);
    case 3 :
        if_setgraphic(dxp_tokens_bg_pt, dxp_token_info:background);
}
