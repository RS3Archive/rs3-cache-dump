// 7945
[clientscript,script7945]
if (cam2_getpositionmode = 1) {
    %worldmap_v2_player_cam2_angleoffset_x, %worldmap_v2_player_cam2_angleoffset_y = cam2_getpositionentity_angleoffsets;
} else {
    %worldmap_v2_player_cam2_angleoffset_x = 0;
    %worldmap_v2_player_cam2_angleoffset_y = calc(16284 / 2);
}
