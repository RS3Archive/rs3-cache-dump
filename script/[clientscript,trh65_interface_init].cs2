if_settext(tostring(inv_total(inv, trh65_stamp)), trh65_ninja_training:total_stamps_number);
if (%trh65_prestige_level_claimed ! 0) {
    if_setmodel(wof31_cashbag_large_inv, trh65_ninja_training:column_prize_one_hands);
    if_setmodelangle(0, 0, 500, 2002, 0, 325, trh65_ninja_training:column_prize_one_hands);
    if_setposition(0, -40, ^setpos_abs_centre, ^setpos_abs_centre, trh65_ninja_training:column_prize_one_hands);
    if_sethide(false, trh65_ninja_training:column_two_prize_prestige);
    if_sethide(true, trh65_ninja_training:column_two_prize);
    if_setmodel(wof48_lamp_huge, trh65_ninja_training:column_three_prize);
    if_setmodelangle(0, 0, 474, 2040, 121, 1050, trh65_ninja_training:column_three_prize);
    if_setposition(0, -40, ^setpos_abs_centre, ^setpos_abs_centre, trh65_ninja_training:column_three_prize);
    if_setmodel(wof55_shooting_star_huge_inv, trh65_ninja_training:column_four_prize);
    if_setmodelangle(0, 0, 0, 1700, 500, 800, trh65_ninja_training:column_four_prize);
    if_setposition(5, -60, ^setpos_abs_centre, ^setpos_abs_centre, trh65_ninja_training:column_four_prize);
    if_sethide(true, trh65_ninja_training:column_prize_one_feet);
}
if_settext("Prestige <tostring(%trh65_prestige_level)>/4", trh65_ninja_training:prestige_level);
~trh65_prize_setup;
