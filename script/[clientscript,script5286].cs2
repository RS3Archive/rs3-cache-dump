// 5286
[clientscript,script5286]
sound_vorbis_rate(mah5_bobs_collar_2, 1, 0, 200, random_sound_pitch(20, 20));
if (if_gethide(mah5_collarpuzzle:collar_bobside) = true) {
    if_sethide(false, mah5_collarpuzzle:collar_bobside);
    if_sethide(true, mah5_collarpuzzle:collar_diraksside);
} else {
    if_sethide(false, mah5_collarpuzzle:collar_diraksside);
    if_sethide(true, mah5_collarpuzzle:collar_bobside);
}
