// 1595
[proc,script1595](int $int0, string $string0, string $string1)
if (clan_isself($int0) = false) {
    cc_setopbase($string0);
    if (player_group_find = true) {
        cc_setop(4, "Invite to group");
    }
    cc_setop(10, "Join");
    if (friend_test($string1) = true) {
        cc_setop(5, "Message");
        cc_setop(7, "Remove friend");
    } else if (ignore_test($string1) = true) {
        cc_setop(8, "Remove ignore");
    } else {
        cc_setop(5, "Add friend");
        cc_setop(6, "Add ignore");
    }
}
if (clan_getchatrank >= clan_getchatminkick & clan_getchatrank > clan_getchatuserrank($int0)) {
    cc_setop(9, "Kick/ban user");
}
