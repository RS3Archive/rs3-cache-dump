// 1487
[proc,bank_cert_button](component $component0, component $component1)
def_string $string0 = "";
if (%bankcert = 0) {
    ~script13960($component0, rs3tli_30px_button, false, 0);
    if_setgraphic("bank_buttons_new1,5", $component1);
    if_settrans(128, $component1);
    $string0 = "Switch to note withdrawal mode";
} else {
    ~script13960($component0, rs3tli_30px_button, false, 1);
    if_setgraphic("bank_buttons_new1,4", $component1);
    if_settrans(0, $component1);
    $string0 = "Switch to item withdrawal mode";
}
if_setop(1, $string0, $component0);
if_setonmouserepeat("script10009($string0, event_com, event_comsubid)", $component0);
