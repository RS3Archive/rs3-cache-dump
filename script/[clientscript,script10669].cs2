// 10669
[clientscript,script10669](int $int0, int $int1)
if_setontimer(null, hw14_overlay:hw14_points_flash);
if ($int1 = 1) {
    if_settext("+ <tostring($int0)>", hw14_overlay:hw14_points_flash);
    if_setcolour(^green, hw14_overlay:hw14_points_flash);
} else {
    if_settext("- <tostring($int0)>", hw14_overlay:hw14_points_flash);
    if_setcolour(^red, hw14_overlay:hw14_points_flash);
}
if_settrans(0, hw14_overlay:hw14_points_flash);
if_setontimer("script10670(hw14_overlay:hw14_points_flash)", hw14_overlay:hw14_points_flash);
