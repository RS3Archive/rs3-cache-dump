// 6270
[clientscript,script6270]
def_string $string0 = "";
if (~is_mobile_client = false) {
    $string0 = "Subscribe";
}
if (%logincheck_rebill_failed = 1) {
    ~lobby_popup(-3, lobby_popup_warning_positive_close, "Recent Billing Failure", "Your account has recently had a billing failure. Please check that your payment method is valid.", "loadingwheel,9", "", "Continue");
}
if (%logincheck_rebill_failed = 2) {
    ~lobby_popup(12, lobby_popup_warning_positive_action, "Recent Billing Failure", "Your membership has been cancelled due to billing failures. You will need to resubscribe.", "loadingwheel,9", $string0, "Close");
}
