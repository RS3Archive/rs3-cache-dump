// 2780
[clientscript,castlewars_timer](int $int0, component $component1)
if ($int0 > 250) {
    if_setontimer(null, $component1);
    if_settext("", $component1);
    return;
}
if (%castlewars_player_ticket_info = 1) {
    if_settext("There are not enough players on each team (5v5) to reward gold tickets; only silver tickets", $component1);
} else {
    if_settext("There are enough players to award Gold Tickets", $component1);
}
if_setontimer("castlewars_timer(calc($int0 + 1), $component1)", $component1);
