// 9171
[proc,script9171](int $int0, int $int1)(string)
if ($int1 = 1 & $int0 > 1440) {
    if (calc($int0 / 1440) = 1) {
        return("1 day");
    } else {
        return("<tostring(calc($int0 / 1440))> days");
    }
}
def_string $string0 = "";
def_string $string1 = "";
if (calc($int0 / 60) < 10) {
    $string1 = "0<tostring(calc($int0 / 60))>";
} else {
    $string1 = tostring(calc($int0 / 60));
}
if (calc($int0 % 60) < 10) {
    $string0 = "0<tostring(calc($int0 % 60))>";
} else {
    $string0 = tostring(calc($int0 % 60));
}
return("<$string1>:<$string0>");
