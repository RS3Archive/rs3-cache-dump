// 6210
[clientscript,script6210](component $component0)
def_string $string0 = "Join your clan chat channel";
if_setonclanchanneltransmit("script6210(event_com)", $component0);
if (activeclanchannel_find_affined(0) = true) {
    if_setgraphic("aif_clanchat_icons,12", clan_chat_buttons_dropdown:clan_join_affinedchat_button_gfx);
    if_setop(1, "Leave Clan Channel", clan_chat_buttons_dropdown:clan_join_affinedchat_button);
    $string0 = "Temporarily leave your clan chat channel";
} else {
    if_setgraphic("aif_clanchat_icons,13", clan_chat_buttons_dropdown:clan_join_affinedchat_button_gfx);
    if_setop(1, "Join Clan Channel", clan_chat_buttons_dropdown:clan_join_affinedchat_button);
}
if_setonmouserepeat("script8799($string0, event_com, event_comsubid)", clan_chat_buttons_dropdown:clan_join_affinedchat_button);
