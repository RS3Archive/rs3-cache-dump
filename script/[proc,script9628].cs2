    $int3 = cc_param(worldmap_key_data_id);
    $struct4 = enum(int, struct, worldmap_key_data, $int3);
    if ($struct4 ! null & enum_getreversecount(struct, worldmap_mec2data, $struct4) = 1) {
        $category5 = enum_getreverseindex(struct, category, worldmap_mec2data, $struct4, 0);
    }
    $int6 = ~worldmap_key_get_selected_bit($int3);
    if ($int2 ! -1 & $int2 ! calc(1 - $int6)) {
