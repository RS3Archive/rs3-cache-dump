// 1647
[proc,script1647]
if (%wof65_emote_love_unlocked = 1) {
    if_settrans(200, wof65_valentines_shop:love_emote_icon);
}
if (%wof65_emote_hate_unlocked = 1) {
    if_settrans(200, wof65_valentines_shop:hate_emote_icon);
}
if (%wof65_crown_love_owned = 1) {
    if_settrans(200, wof65_valentines_shop:love_crown_icon);
}
if (%wof65_crown_hate_owned = 1) {
    if_settrans(200, wof65_valentines_shop:hate_crown_icon);
}
if (map_members = false) {
    if_settrans(200, wof65_valentines_shop:love_weapon_icon);
    if_settrans(200, wof65_valentines_shop:hate_weapon_icon);
}
