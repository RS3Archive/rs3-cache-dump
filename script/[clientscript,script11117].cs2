// 11117
[clientscript,script11117](component $component0)
def_int $int1 = 0;
cc_deleteall($component0);
while ($int1 < enum_getoutputcount(easter15_egg_lookup)) {
    cc_create($component0, ^iftype_rectangle, $int1);
    cc_sethide(true);
    cc_settrans(255);
    cc_setop(1, "Add to machine");
    ~script10407;
    $int1 = calc($int1 + 1);
}
