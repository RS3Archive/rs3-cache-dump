// 12215
[clientscript,trh82_update_progress_bar]
def_int $int0 = if_getheight(trh82_valentines:progress_bar_graphic);
def_int $int1 = if_getheight(trh82_valentines:progress_bar_layer);
def_int $int2 = calc($int0 * 100 / 2500);
def_int $int3 = max(1, calc($int2 * %trh82_currency / 100));
if (%trh82_currency = 2500) {
    $int3 = $int0;
}
if ($int3 > $int1) {
    if_setsize(if_getwidth(trh82_valentines:progress_bar_layer), calc($int1 + 1), ^setsize_abs, ^setsize_abs, trh82_valentines:progress_bar_layer);
} else {
    %trh82_progress_bar_client = %trh82_currency;
    if_setontimer(null, trh82_valentines:progress_bar_layer);
}
