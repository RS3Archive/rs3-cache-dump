// 12998
[clientscript,script12998]
def_int $int0 = scale(%quest_endgame_phase1_portals_health, 45, 100);
def_int $int1 = scale(350, 100, $int0);
if (if_getwidth(quest_endgame_portal_health:health_bar) ! $int1) {
    if_setsize($int1, 33, ^setsize_abs, ^setsize_abs, quest_endgame_portal_health:health_bar);
    if_setontimer("script12999($int1, $int0)", quest_endgame_portal_health:health_diamond_left);
}
