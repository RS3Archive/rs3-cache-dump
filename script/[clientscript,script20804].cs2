// 20804
[clientscript,script20804](component $component0, int $int1)
if (string_length(%construction_house_furniture_search) >= 2) {
    return;
}
if (cc_findbycategory($component0, 2, 0) = 1) {
    if ($int1 > 0) {
        cc_setscrollpos(0, calc(cc_getscrolly + 20 + 4));
    } else {
        cc_setscrollpos(0, calc(cc_getscrolly - 20 - 4));
    }
}
