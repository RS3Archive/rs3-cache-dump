// 12252
[proc,script12252](int $int0, int $int1)
$int0 = max(0, $int0);
if (calc($int0 % 50) ! 0) {
    return;
}
def_int $int2 = 0;
def_int $int3 = calc($int0 / 3000);
def_int $int4 = calc($int3 / 60);
if ($int4 > 0) {
    $int3 = calc($int3 % 60);
}
$int2 = calc($int0 % 3000);
def_int $int5 = scale(60, 3000, $int2);
def_string $string0 = tostring($int4);
def_string $string1 = tostring($int3);
def_string $string2 = tostring($int5);
if ($int4 < 10) {
    $string0 = append("0", $string0);
}
if ($int3 < 10) {
    $string1 = append("0", $string1);
}
if ($int5 < 10) {
    $string2 = append("0", $string2);
}
if ($int4 > 0) {
    if_settext("<$string0>:<$string1>:<$string2>", timed_kill:time_text);
} else {
    if_settext("<$string1>:<$string2>", timed_kill:time_text);
}
if ($int0 > 1500) {
    if_setcolour(^white, timed_kill:time_text);
} else if ($int0 > 1000) {
    if_setcolour(0xfa6400, timed_kill:time_text);
} else if ($int0 > 500) {
    if_setcolour(0xe65000, timed_kill:time_text);
} else {
    if_setcolour(0xc80000, timed_kill:time_text);
}
