// 19128
[proc,script19128]
sound_vorbis_volume(tli_click_01, 1, 0, 180);
switch_int (map_lang) {
    case 0 :
        if_setgraphic(trh201_title_en, trh201_overlay:title);
    case 1 :
        if_setgraphic(trh201_title_de, trh201_overlay:title);
    case 2 :
        if_setgraphic(trh201_title_fr, trh201_overlay:title);
    case 3 :
        if_setgraphic(trh201_title_pt, trh201_overlay:title);
}
