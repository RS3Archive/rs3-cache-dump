// 209
[clientscript,script209]
if (%pvpwild_bh_potential < 8) {
    if_setgraphic("bounty_hunter_icon_timer,0", pvpwildy_overlay:target_icon);
} else if (%pvpwild_bh_potential < 15) {
    if_setgraphic("bounty_hunter_icon_timer,1", pvpwildy_overlay:target_icon);
} else if (%pvpwild_bh_potential < 23) {
    if_setgraphic("bounty_hunter_icon_timer,2", pvpwildy_overlay:target_icon);
} else if (%pvpwild_bh_potential < 30) {
    if_setgraphic("bounty_hunter_icon_timer,3", pvpwildy_overlay:target_icon);
} else if (%pvpwild_bh_potential < 38) {
    if_setgraphic("bounty_hunter_icon_timer,4", pvpwildy_overlay:target_icon);
} else if (%pvpwild_bh_potential < 45) {
    if_setgraphic("bounty_hunter_icon_timer,5", pvpwildy_overlay:target_icon);
} else if (%pvpwild_bh_potential < 53) {
    if_setgraphic("bounty_hunter_icon_timer,6", pvpwildy_overlay:target_icon);
} else if (%pvpwild_bh_potential < 60) {
    if_setgraphic("bounty_hunter_icon_timer,7", pvpwildy_overlay:target_icon);
} else {
    if_setgraphic("bounty_hunter_icon_timer,8", pvpwildy_overlay:target_icon);
}
