// 1165
[clientscript,script1165](component $component0, int $int1)
def_int $int2 = 0;
def_int $int3 = 0;
def_int $int4 = 0;
def_int $int5 = 0;
def_int $int6 = 0;
def_int $int7 = 0;
if ($int1 = -1) {
    $int2 = if_getmodelxof(bslay_boss_info:boss_model);
    $int3 = if_getmodelyof(bslay_boss_info:boss_model);
    $int4 = if_getmodelzoom(bslay_boss_info:boss_model);
    $int5 = if_getmodelangle_x(bslay_boss_info:boss_model);
    $int6 = calc(if_getmodelangle_y(bslay_boss_info:boss_model) + 2);
    $int7 = if_getmodelangle_z(bslay_boss_info:boss_model);
    if_setmodelangle($int2, $int3, $int5, $int6, $int7, $int4, $component0);
} else if (cc_find($component0, $int1) = true) {
