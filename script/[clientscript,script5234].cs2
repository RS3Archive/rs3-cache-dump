// 5234
[clientscript,script5234](component $component0)
switch_component ($component0) {
    case tt2_noticeboard:advert_1 :
        if_sethide(false, tt2_noticeboard:advert_1_overlay);
    case tt2_noticeboard:advert_2 :
        if_sethide(false, tt2_noticeboard:advert_2_overlay);
    case tt2_noticeboard:advert_3 :
        if_sethide(false, tt2_noticeboard:advert_3_overlay);
}
