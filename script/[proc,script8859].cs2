// 8859
[proc,script8859]
if (%wishing_well_player_bond_donation_tracker = 1) {
    if_settext("<tostring_localised(%wishing_well_player_bond_donation_tracker, true)> Bond", donation:player_bond_donation_so_far);
} else {
    if_settext("<tostring_localised(%wishing_well_player_bond_donation_tracker, true)> Bonds", donation:player_bond_donation_so_far);
}
