// 13736
[clientscript,trh131_setup_preview](int $int0, struct $struct1)
if_sethide(true, trh131_costume:main_layer);
if_sethide(false, trh131_costume:preview_layer);
if_sethide(true, trh131_costume:info_layer);
if_setonop("script13737(1)", trh131_costume:help_button);
def_npc $npc2 = struct_param($struct1, trh131_female_preview);
if (gender = 0) {
    $npc2 = struct_param($struct1, trh131_male_preview);
}
if_setnpcmodel($npc2, trh131_costume:preview_model);
if_settext(struct_param($struct1, trh131_name), trh131_costume:preview_title);
def_string $string0 = "Cost: <tostring_localised(struct_param($struct1, trh131_cost), true)> ghostweave.";
if_settext($string0, trh131_costume:preview_text);
if ($int0 = 1) {
    if_settext("Recover", trh131_costume:make_button_text);
    if_sethide(true, trh131_costume:make_button_disabled_layer);
    $string0 = "You already own this costume. Click to recover lost pieces.";
    if_setonmouserepeat("script3876($string0, event_com, -1)", trh131_costume:make_layer);
} else {
    if_settext("Make", trh131_costume:make_button_text);
    if (inv_total(inv, trh131_ghostweave) < struct_param($struct1, trh131_cost)) {
        if_sethide(false, trh131_costume:make_button_disabled_layer);
        $string0 = "You don't have enough ghostweave to make this costume.";
        if_setonmouserepeat("script3876($string0, event_com, -1)", trh131_costume:make_button_disabled_layer);
    } else {
        if_sethide(true, trh131_costume:make_button_disabled_layer);
        $string0 = "Make this costume from <tostring_localised(struct_param($struct1, trh131_cost), true)> ghostweave. You will need 5 free inventory spaces.";
        if_setonmouserepeat("script3876($string0, event_com, -1)", trh131_costume:make_layer);
    }
}
