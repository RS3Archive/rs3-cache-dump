// 17249
[proc,script17249](dbrow $dbrow0)(boolean)
def_int $int1 = 0;
def_int $int2 = db_getfieldcount($dbrow0, requirements:col1);
def_stat $stat3 = null;
def_int $int4 = 0;
while ($int1 < $int2) {
    $stat3, $int4 = db_getfield($dbrow0, requirements:col1, $int1);
    if (stat($stat3) < $int4) {
        return(false);
    }
    $int1 = calc($int1 + 1);
}
return(true);
