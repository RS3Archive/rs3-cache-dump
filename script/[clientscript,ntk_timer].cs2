// 324
[clientscript,ntk_timer](component $component0, component $component1, component $component2)
def_int $int3 = min(%ntk_player_timer_count, 500);
if_setsize(0, scale(calc(500 - $int3), 500, 16384), ^setsize_minus, ^setsize_rel, $component0);
def_int $int4 = calc(164 + scale($int3, 500, 91));
def_int $int5 = calc(164 - scale($int3, 500, 164));
def_int $int6 = calc(41 - scale($int3, 500, 41));
def_int $int7 = ~rgb_to_hex($int4, $int5, $int6);
if_setcolour($int7, $component0);
if_setcolour($int7, $component1);
switch_int (scale(calc($int3 + 5), 500, 25)) {
    case 0 :
        if_setmodel(if_game_ntk_sand_01, $component2);
    case 1 :
        if_setmodel(if_game_ntk_sand_02, $component2);
