// 20662
[proc,script20662](dbrow $dbrow0)(string)
switch_dbrow ($dbrow0) {
    case mobile_shop_membership_1_month_v2, mobile_shop_premier_membership_12_month_v2 :
        return("<col=E0D471>Terms and Conditions:</col>");
    case default :
        return(db_getfield($dbrow0, mobile_shop_feature_information:col10, 0));
}
