// 10909
[clientscript,script10909](int $int0, int $int1)
def_int $int2 = calc($int1 - $int0);
def_int $int3 = calc(clientclock - $int0);
def_int $int4 = min(100, scale($int3, $int2, 100));
if ($int4 < 10) {
    if_settextfont(museo_sans_11pt_regular, thedrop:text_answer1);
    if_settextfont(museo_sans_11pt_regular, thedrop:text_answer2);
    if_settextfont(museo_sans_11pt_regular, thedrop:text_answer3);
    if_settextfont(museo_sans_11pt_regular, thedrop:text_answer4);
    if_settextfont(museo_sans_11pt_regular, thedrop:text_answer5);
}
def_int $int5 = scale(320, 100, $int4);
def_int $int6 = if_getwidth(thedrop:progress_bar);
if ($int6 < $int5) {
    if_setsize(calc($int6 + 1), 5, ^setsize_abs, ^setsize_abs, thedrop:progress_bar);
}
if ($int4 = 100) {
    if_setontimer(null, thedrop:progress_bar_layer);
}
