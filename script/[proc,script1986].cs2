// 1986
[proc,script1986](component $component0, int $int1)
switch_component ($component0) {
    case town_rewards:buy_reward_1 :
        if (%town_good_perk_1 = 1) {
            if_settext("Owned", town_rewards:positive_button_text_1);
            if_sethide(false, town_rewards:positive_button_disabled_layer_1);
            sound_vorbis_volume(buy_shop_item, 1, 0, 150);
        } else {
            if_settext("Unlock", town_rewards:positive_button_text_1);
            sound_vorbis_volume(tli_unlock, 1, 0, 150);
        }
    case town_rewards:buy_reward_2 :
        if (%town_good_perk_2 = 1) {
            if_settext("Owned", town_rewards:positive_button_text_2);
            if_sethide(false, town_rewards:positive_button_disabled_layer_2);
