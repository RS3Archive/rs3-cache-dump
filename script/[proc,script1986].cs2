        } else {
            if_settext("Unlock", town_rewards:positive_button_text_11);
            sound_vorbis_volume(tli_unlock, 1, 0, 150);
        }
    case town_rewards:current_points_text :
        if_settext("Wins: <tostring(%town_wins)>    Reward points: <tostring(%town_reward_points)>", town_rewards:current_points_text);
    case town_rewards:robber_level :
        if_settext("Level: <tostring(%town_robber_level)>", town_rewards:robber_level);
    case town_rewards:guard_level :
        if_settext("Level: <tostring(%town_guard_level)>", town_rewards:guard_level);
