        } else {
            if_settext("Unlock", town_rewards:positive_button_text_2);
            sound_vorbis_volume(tli_unlock, 1, 0, 150);
        }
    case town_rewards:buy_reward_3 :
        if (%town_good_perk_3 = 1) {
            if_settext("Owned", town_rewards:positive_button_text_3);
            if_sethide(false, town_rewards:positive_button_disabled_layer_3);
            sound_vorbis_volume(buy_shop_item, 1, 0, 150);
        } else {
            if_settext("Unlock", town_rewards:positive_button_text_3);
            sound_vorbis_volume(tli_unlock, 1, 0, 150);
        }
    case town_rewards:buy_reward_4 :
        if (%town_good_perk_4 = 1) {
            if_settext("Owned", town_rewards:positive_button_text_4);
            if_sethide(false, town_rewards:positive_button_disabled_layer_4);
            sound_vorbis_volume(buy_shop_item, 1, 0, 150);
        } else {
            if_settext("Unlock", town_rewards:positive_button_text_4);
            sound_vorbis_volume(tli_unlock, 1, 0, 150);
        }
    case town_rewards:buy_reward_8 :
        if (%town_bad_perk_1 = 1) {
            if_settext("Owned", town_rewards:positive_button_text_8);
            if_sethide(false, town_rewards:positive_button_disabled_layer_8);
            sound_vorbis_volume(buy_shop_item, 1, 0, 150);
        } else {
            if_settext("Unlock", town_rewards:positive_button_text_8);
            sound_vorbis_volume(tli_unlock, 1, 0, 150);
        }
    case town_rewards:buy_reward_9 :
        if (%town_bad_perk_2 = 1) {
            if_settext("Owned", town_rewards:positive_button_text_9);
            if_sethide(false, town_rewards:positive_button_disabled_layer_9);
            sound_vorbis_volume(buy_shop_item, 1, 0, 150);
        } else {
            if_settext("Unlock", town_rewards:positive_button_text_9);
            sound_vorbis_volume(tli_unlock, 1, 0, 150);
        }
    case town_rewards:buy_reward_10 :
        if (%town_bad_perk_3 = 1) {
            if_settext("Owned", town_rewards:positive_button_text_10);
            if_sethide(false, town_rewards:positive_button_disabled_layer_10);
            sound_vorbis_volume(buy_shop_item, 1, 0, 150);
        } else {
            if_settext("Unlock", town_rewards:positive_button_text_10);
            sound_vorbis_volume(tli_unlock, 1, 0, 150);
        }
    case town_rewards:buy_reward_11 :
        if (%town_bad_perk_4 = 1) {
