// 10102
[clientscript,sb_setup_progressbar]
if_setonmouserepeat("script10103(sb_overlay:progress_bar, 0)", sb_overlay:progress_bar_layer);
if_setonmouseleave("script10103(sb_overlay:progress_bar, 1)", sb_overlay:progress_bar_layer);
if_setsize(0, if_getheight(sb_overlay:progress_bar), ^setsize_abs, ^setsize_abs, sb_overlay:progress_bar);
