// 10572
[clientscript,titles1_onclick]
if (%trh29_titles1_owned = 1) {
    return;
}
if (inv_total(inv, trh29_doubloons) < 500) {
    return;
}
%trh29_pirate_coins_shop_selection = 7;
if_setgraphic(trh29_pirate_icon_title_1, trh29_pirate_coins_shop:popup_icon);
if_settext("Pirate titles: Peg Leg, Cutthroat, Swashbuckler, One-Eyed and Dread Pirate.", trh29_pirate_coins_shop:popup_description);
if_settext("Buy the first set of pirate titles?", trh29_pirate_coins_shop:popup_question);
if_sethide(false, trh29_pirate_coins_shop:popup_layer);
