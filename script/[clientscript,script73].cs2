// 73
[clientscript,script73](component $component0, graphic $graphic1, graphic $graphic2, component $component3, graphic $graphic4, graphic $graphic5)
if (%combatv2_poisoned < 1) {
    if_setgraphic($graphic1, $component0);
    if_setgraphic($graphic4, $component3);
} else {
    if_setgraphic($graphic2, $component0);
    if_setgraphic($graphic5, $component3);
}
