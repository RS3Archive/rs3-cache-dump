// 2719
[clientscript,div_map_mouseover](component $component0)
def_graphic $graphic1 = if_getgraphic($component0);
def_graphic $graphic2 = null;
switch_graphic ($graphic1) {
    case "aif_skill1_map_icons,0" :
        $graphic2 = "aif_skill1_map_icons,3";
    case "aif_skill1_map_icons,1" :
        $graphic2 = "aif_skill1_map_icons,4";
    case "aif_skill1_map_icons,2" :
        $graphic2 = "aif_skill1_map_icons,5";
}
if ($graphic2 = null) {
    return;
}
if_setgraphic($graphic2, $component0);
