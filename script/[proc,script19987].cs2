// 19987
[proc,script19987](int $int0)(graphic)
switch_int ($int0) {
    case 1 :
        return(trh204_rarity_white_corner);
    case 2 :
        return(trh204_rarity_yellow_corner);
    case 3 :
        return(trh204_rarity_orange_corner);
    case 4 :
        return(trh204_rarity_red_corner);
    case 5 :
        return(trh204_rarity_purple_corner);
    case 7 :
