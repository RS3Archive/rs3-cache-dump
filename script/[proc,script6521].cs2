// 6521
[proc,script6521]
def_string $string0 = "";
if (%bank_prevent_force_tab = 0) {
    ~script13960(bank:tab_switching_button, rs3tli_30px_button, false, 0);
    if_setgraphic(rs3_icon_bank_tab_switch_auto, bank:tab_switching_icon);
    $string0 = "Toggle to prevent automatic tab switching";
} else {
    ~script13960(bank:tab_switching_button, rs3tli_30px_button, false, 1);
    if_setgraphic(rs3_icon_bank_tab_switch_lock, bank:tab_switching_icon);
    $string0 = "Toggle to allow automatic tab switching";
}
if_setop(1, $string0, bank:tab_switching_button);
if_setonmouserepeat("script10009($string0, event_com, event_comsubid)", bank:tab_switching_button);
