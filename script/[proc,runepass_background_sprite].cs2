// 3659
[proc,runepass_background_sprite](component $component0, int $int1, graphic $graphic2, int $int3, int $int4, boolean $boolean5, boolean $boolean6, int $rgb7, int $int8, int $int9, int $int10)
cc_create($component0, ^iftype_graphic, $int1);
cc_setgraphic($graphic2);
cc_setposition($int3, $int4, ^setpos_abs_left, ^setpos_abs_top);
cc_setsize($int9, $int10, ^setsize_abs, ^setsize_abs);
cc_sethflip($boolean5);
cc_setvflip($boolean6);
cc_setcolour($rgb7);
cc_set2dangle($int8);
