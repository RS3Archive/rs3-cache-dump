// 6245
[clientscript,script6245]
switch_int (%qbd2_artifacts_state) {
    case -1, 0 :
        if_sethide(false, qbd2_energybar:artifact1_deactivated);
        if_sethide(false, qbd2_energybar:artifact2_deactivated);
        if_sethide(false, qbd2_energybar:artifact3_deactivated);
        if_sethide(false, qbd2_energybar:artifact4_deactivated);
        if_sethide(true, qbd2_energybar:artifact1_activated);
        if_sethide(true, qbd2_energybar:artifact2_activated);
        if_sethide(true, qbd2_energybar:artifact3_activated);
        if_sethide(true, qbd2_energybar:artifact4_activated);
        if_sethide(true, qbd2_energybar:artifact1_ready);
        if_sethide(true, qbd2_energybar:artifact2_ready);
        if_sethide(true, qbd2_energybar:artifact3_ready);
        if_sethide(true, qbd2_energybar:artifact4_ready);
    case 1 :
        if_sethide(false, qbd2_energybar:artifact1_ready);
        if_sethide(false, qbd2_energybar:artifact2_deactivated);
        if_sethide(false, qbd2_energybar:artifact3_deactivated);
        if_sethide(false, qbd2_energybar:artifact4_deactivated);
        if_sethide(true, qbd2_energybar:artifact1_activated);
        if_sethide(true, qbd2_energybar:artifact2_activated);
        if_sethide(true, qbd2_energybar:artifact3_activated);
        if_sethide(true, qbd2_energybar:artifact4_activated);
        if_sethide(true, qbd2_energybar:artifact2_ready);
        if_sethide(true, qbd2_energybar:artifact3_ready);
        if_sethide(true, qbd2_energybar:artifact4_ready);
        if_sethide(true, qbd2_energybar:artifact1_deactivated);
        if_sethide(true, qbd2_energybar:layer_bar_text);
    case 2 :
        if_sethide(false, qbd2_energybar:artifact1_activated);
        if_sethide(false, qbd2_energybar:artifact2_deactivated);
        if_sethide(false, qbd2_energybar:artifact3_deactivated);
        if_sethide(false, qbd2_energybar:artifact4_deactivated);
        if_sethide(true, qbd2_energybar:artifact2_activated);
        if_sethide(true, qbd2_energybar:artifact3_activated);
        if_sethide(true, qbd2_energybar:artifact4_activated);
        if_sethide(true, qbd2_energybar:artifact1_deactivated);
        if_sethide(true, qbd2_energybar:artifact1_ready);
        if_sethide(true, qbd2_energybar:artifact2_ready);
        if_sethide(true, qbd2_energybar:artifact3_ready);
        if_sethide(true, qbd2_energybar:artifact4_ready);
        if_sethide(true, qbd2_energybar:layer_bar_text);
    case 3 :
        if_sethide(false, qbd2_energybar:artifact1_activated);
        if_sethide(false, qbd2_energybar:artifact2_ready);
        if_sethide(false, qbd2_energybar:artifact3_deactivated);
        if_sethide(false, qbd2_energybar:artifact4_deactivated);
        if_sethide(true, qbd2_energybar:artifact2_activated);
        if_sethide(true, qbd2_energybar:artifact3_activated);
        if_sethide(true, qbd2_energybar:artifact4_activated);
        if_sethide(true, qbd2_energybar:artifact1_deactivated);
        if_sethide(true, qbd2_energybar:artifact2_deactivated);
        if_sethide(true, qbd2_energybar:artifact1_ready);
        if_sethide(true, qbd2_energybar:artifact3_ready);
        if_sethide(true, qbd2_energybar:artifact4_ready);
        if_sethide(true, qbd2_energybar:layer_bar_text);
    case 4 :
        if_sethide(false, qbd2_energybar:artifact1_activated);
        if_sethide(false, qbd2_energybar:artifact2_activated);
        if_sethide(false, qbd2_energybar:artifact3_deactivated);
        if_sethide(false, qbd2_energybar:artifact4_deactivated);
        if_sethide(true, qbd2_energybar:artifact3_activated);
        if_sethide(true, qbd2_energybar:artifact4_activated);
        if_sethide(true, qbd2_energybar:artifact1_deactivated);
        if_sethide(true, qbd2_energybar:artifact2_deactivated);
        if_sethide(true, qbd2_energybar:artifact1_ready);
        if_sethide(true, qbd2_energybar:artifact2_ready);
        if_sethide(true, qbd2_energybar:artifact3_ready);
        if_sethide(true, qbd2_energybar:artifact4_ready);
        if_sethide(true, qbd2_energybar:layer_bar_text);
    case 5 :
        if_sethide(false, qbd2_energybar:artifact1_activated);
        if_sethide(false, qbd2_energybar:artifact2_activated);
        if_sethide(false, qbd2_energybar:artifact3_ready);
        if_sethide(false, qbd2_energybar:artifact4_deactivated);
        if_sethide(true, qbd2_energybar:artifact3_activated);
        if_sethide(true, qbd2_energybar:artifact4_activated);
        if_sethide(true, qbd2_energybar:artifact1_deactivated);
        if_sethide(true, qbd2_energybar:artifact2_deactivated);
        if_sethide(true, qbd2_energybar:artifact3_deactivated);
        if_sethide(true, qbd2_energybar:artifact1_ready);
        if_sethide(true, qbd2_energybar:artifact2_ready);
        if_sethide(true, qbd2_energybar:artifact4_ready);
        if_sethide(true, qbd2_energybar:layer_bar_text);
    case 6 :
        if_sethide(false, qbd2_energybar:artifact1_activated);
        if_sethide(false, qbd2_energybar:artifact2_activated);
        if_sethide(false, qbd2_energybar:artifact3_activated);
        if_sethide(false, qbd2_energybar:artifact4_deactivated);
        if_sethide(true, qbd2_energybar:artifact4_activated);
        if_sethide(true, qbd2_energybar:artifact1_deactivated);
        if_sethide(true, qbd2_energybar:artifact2_deactivated);
        if_sethide(true, qbd2_energybar:artifact3_deactivated);
        if_sethide(true, qbd2_energybar:artifact1_ready);
        if_sethide(true, qbd2_energybar:artifact2_ready);
        if_sethide(true, qbd2_energybar:artifact3_ready);
        if_sethide(true, qbd2_energybar:artifact4_ready);
        if_sethide(true, qbd2_energybar:layer_bar_text);
    case 7 :
        if_sethide(false, qbd2_energybar:artifact1_activated);
        if_sethide(false, qbd2_energybar:artifact2_activated);
        if_sethide(false, qbd2_energybar:artifact3_activated);
        if_sethide(false, qbd2_energybar:artifact4_ready);
        if_sethide(true, qbd2_energybar:artifact4_activated);
        if_sethide(true, qbd2_energybar:artifact1_deactivated);
        if_sethide(true, qbd2_energybar:artifact2_deactivated);
        if_sethide(true, qbd2_energybar:artifact3_deactivated);
        if_sethide(true, qbd2_energybar:artifact4_deactivated);
        if_sethide(true, qbd2_energybar:artifact1_ready);
        if_sethide(true, qbd2_energybar:artifact2_ready);
        if_sethide(true, qbd2_energybar:artifact3_ready);
        if_sethide(true, qbd2_energybar:layer_bar_text);
    case 8 :
        if_sethide(false, qbd2_energybar:artifact1_activated);
        if_sethide(false, qbd2_energybar:artifact2_activated);
        if_sethide(false, qbd2_energybar:artifact3_activated);
        if_sethide(false, qbd2_energybar:artifact4_activated);
        if_sethide(true, qbd2_energybar:artifact1_deactivated);
        if_sethide(true, qbd2_energybar:artifact2_deactivated);
        if_sethide(true, qbd2_energybar:artifact3_deactivated);
        if_sethide(true, qbd2_energybar:artifact4_deactivated);
        if_sethide(true, qbd2_energybar:artifact1_ready);
        if_sethide(true, qbd2_energybar:artifact2_ready);
        if_sethide(true, qbd2_energybar:artifact3_ready);
        if_sethide(true, qbd2_energybar:artifact4_ready);
        if_sethide(true, qbd2_energybar:layer_bar_text);
    case default :
        mes("ERROR: %qbd2_artifacts_state should only be between -1 and 8, was <tostring(%qbd2_artifacts_state)>");
}
