// 17561
[clientscript,script17561](component $component0, component $component1, int $int2, int $int3)
if ($component0 = activity_progress_bar:container) {
    ~script8800("<tostring(scale($int2, $int3, 100))>%: <tostring_localised(scale(%activity_progress_bar_active_max_progress, $int3, $int2), true)> HP", $component1, -1);
} else {
    ~script8800("<tostring(scale($int2, $int3, 100))>%: <tostring_localised(scale(%activity_progress_bar_extension_second_health_bar_max_progress, $int3, $int2), true)> HP", $component1, -1);
}
