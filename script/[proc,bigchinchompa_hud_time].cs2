// 6700
[proc,bigchinchompa_hud_time](component $component0, component $component1, int $int2)
if_settext(~bigchinchompa_hud_timetext(%varclient_2012), $component1);
if (%varclient_2012 > 0) {
    if_setontimer("bigchinchompa_hud_time_countdown($component0, $component1, calc(clientclock + $int2))", $component0);
} else {
    if_setontimer(null, $component0);
}
