// 4329
[proc,script4329](component $component0)
if (%varclansetting_2 ! null) {
    if_settext(append("<u=A0B6C0>", clanforumqfc_tostring(%varclansetting_2)), $component0);
    if_setcolour(0xa0b6c0, $component0);
    if_setonmouseover("clan_on_mouse_over($component0)", $component0);
    if_setonmouseleave("script12225($component0)", $component0);
    if_setmouseovercursor(cursor_175, $component0);
    if_setonclick("script4330(%varclansetting_2)", $component0);
    if_setopbase("Visit Clan Forum", $component0);
} else {
    if_settext("", $component0);
}
