// 11023
[proc,script11023](component $component0)(int)
switch_component ($component0) {
    case whop:graphic_world, lobbyscreen_pane_worldselect:sort_world :
        return(0);
    case whop:graphic_players, lobbyscreen_pane_worldselect:sort_player :
        return(2);
    case whop:graphic_activity, lobbyscreen_pane_worldselect:sort_activity :
        return(4);
    case whop:graphic_location, lobbyscreen_pane_worldselect:sort_location :
        return(6);
    case whop:graphic_type, lobbyscreen_pane_worldselect:sort_type :
        return(10);
    case whop:graphic_loot, lobbyscreen_pane_worldselect:sort_lootshare :
        return(8);
    case lobbyscreen_pane_worldselect:sort_ping :
        return(12);
}
return(0);
