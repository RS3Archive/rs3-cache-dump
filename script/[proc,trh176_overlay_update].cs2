            $dbrow0 = ~trh_chest_get_dbrow(%trh176_chest_1);
            $component1 = trh176_overlay:chest_1_model;
            $component4 = trh176_overlay:chest_1_rarity;
            $int3 = db_getfield(~trh_chest_get_dbrow(%trh176_chest_1), trh_chest:col12:0, 0);
        case 2 :
            $dbrow0 = ~trh_chest_get_dbrow(%trh176_chest_2);
