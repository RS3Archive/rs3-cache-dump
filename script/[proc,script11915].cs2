// 11915
[proc,script11915](int $int0, int $int1)
if (if_gethide(lore_stats_side:scroll_counter_holder_small) = true) {
    return;
}
def_int $int2 = 0;
if (cc_find(lore_stats_side:lore_familiar_specbar_button, 8) = true) {
    $int2 = parawidth(cc_gettext, 1000, cc_getfontmetrics);
    if (calc(cc_getx + $int2) >= calc(if_getx(if_getparentlayer(lore_stats_side:scroll_counter_graphic_small)) + if_getx(lore_stats_side:scroll_counter_graphic_small))) {
        cc_settext(tostring($int0));
    } else {
        cc_settext("<tostring($int0)>/<tostring($int1)>");
    }
}
