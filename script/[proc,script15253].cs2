// 15253
[proc,script15253]
switch_int (%loginscreen_steam_federated_request_type) {
    case 0 :
        ~script15251(0);
    case 2 :
        ~loginscreen_steam_spinner("Account linking in progress...");
    case 1 :
        ~loginscreen_steam_spinner("Account creation in progress...");
    case 100, 101 :
        ~script15251(8);
}
