// 7577
[clientscript,tsd_flash_out]
def_int $int0 = if_gettrans(tsd_sliske_entrance:black);
if ($int0 <= 20) {
    if_settrans(0, tsd_sliske_entrance:black);
    if_setontimer("tsd_flash_in", tsd_sliske_entrance:base);
} else {
    $int0 = calc($int0 - 20);
    if_settrans($int0, tsd_sliske_entrance:black);
}
