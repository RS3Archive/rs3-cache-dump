// 10104
[clientscript,script10104](int $int0)
if ($int0 = -1337) {
    if_setcolour(0x00c8ff, sb_overlay:progress_graphic);
} else if ($int0 ! -1) {
    if_setcolour(0xffb400, sb_overlay:progress_graphic);
    $int0 = calc(clientclock + $int0 * 50);
} else {
    if_setcolour(^green, sb_overlay:progress_graphic);
}
if_setontimer("script10105(clientclock, $int0)", sb_overlay:progress_bar_layer);
