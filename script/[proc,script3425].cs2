// 3425
[proc,script3425](component $component0, component $component1)
def_obj $obj2 = enum(component, obj, castlewars_images, $component1);
def_int $int3 = enum(obj, int, castlewars_reward_cost, $obj2);
if ($obj2 = castlewars_manual) {
    if_settext("Free!", $component0);
} else {
    if_settext(tostring($int3), $component0);
}
if_setobject($obj2, -1, $component1);
if_setoutline(1, $component1);
if_setgraphicshadow(0x333333, $component1);
