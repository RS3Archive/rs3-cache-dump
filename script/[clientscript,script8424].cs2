// 8424
[clientscript,script8424]
switch_int (%oct13_stagescomplete) {
    case 0 :
        if_settext("Explorer Jack's House", oct13_therm:oct13_current_project_text);
    case 1 :
        if_settext("Hank's Fishing Store", oct13_therm:oct13_current_project_text);
    case 2 :
        if_settext("General Store", oct13_therm:oct13_current_project_text);
    case 3 :
        if_settext("All 3 buildings complete!", oct13_therm:oct13_current_project_text);
}
