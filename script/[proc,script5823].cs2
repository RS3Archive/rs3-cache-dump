// 5823
[proc,script5823](component $component0)
switch_component ($component0) {
    case bank:inventory_click, bank:bob_click :
        cc_setonop("bank_onop_side(event_op, cc_getid, event_com)");
    case group_ironman_storage:inventory_click :
        cc_setonop("script19476(event_op, cc_getid, event_com)");
}
