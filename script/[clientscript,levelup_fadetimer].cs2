// 3336
[clientscript,levelup_fadetimer](int $int0, int $int1, int $int2, int $int3)
def_int $int4 = if_get2dangle(levelup:wheel);
$int4 = calc($int4 - 800);
if ($int4 < 0) {
    $int4 = 65000;
}
if_set2dangle($int4, levelup:wheel);
def_int $int5 = max(1, calc($int1 - $int0));
def_int $int6 = calc(255 / $int5 + 1);
if_sethide(false, levelup:firework_effect);
if_sethide(false, levelup:firework_effect_delayed);
if (clientclock < $int1 & clientclock > $int0) {
    if_settrans(min(175, calc(if_gettrans(levelup:levelup_icon) + $int6)), levelup:levelup_icon);
    if_settrans(max(0, calc(if_gettrans(levelup:number_left) - $int6)), levelup:number_left);
    if_settrans(max(0, calc(if_gettrans(levelup:number_left) - $int6)), levelup:number_right);
    if_settrans(max(0, calc(if_gettrans(levelup:number_left) - $int6)), levelup:number_centre);
    return;
} else if (clientclock < $int2 & clientclock >= $int1) {
    if (clientclock >= calc($int1 + 25)) {
        if_sethide(true, levelup:firework_effect);
        if_sethide(true, levelup:max_firework);
        if_sethide(true, levelup:firework_effect_delayed);
    }
    if (clientclock = $int1) {
        ~levelup_unlocks($int3, calc($int2 - $int1));
    }
} else if (clientclock >= $int2) {
    if (if_gethide(levelup:firework_effect) = false) {
        if_sethide(true, levelup:firework_effect);
    }
    if (if_gethide(levelup:max_firework) = false) {
        if_sethide(true, levelup:max_firework);
    }
    if (if_gethide(levelup:firework_effect_delayed) = false) {
        if_sethide(true, levelup:firework_effect_delayed);
    }
    if (if_gettrans(levelup:levelup_bg) < 255) {
        if_settrans(min(255, calc(if_gettrans(levelup:levelup_icon) + 10)), levelup:levelup_icon);
        if_settrans(min(255, calc(if_gettrans(levelup:levelup_bg) + 10)), levelup:trim_left);
        if_settrans(min(255, calc(if_gettrans(levelup:levelup_bg) + 10)), levelup:trim_right);
        if_settrans(min(255, calc(if_gettrans(levelup:levelup_bg) + 10)), levelup:trim_centre);
        if_settrans(min(255, calc(if_gettrans(levelup:levelup_bg) + 10)), levelup:levelup_text);
        if_settrans(min(255, calc(if_gettrans(levelup:levelup_bg) + 10)), levelup:number_left);
        if_settrans(min(255, calc(if_gettrans(levelup:levelup_bg) + 10)), levelup:number_right);
        if_settrans(min(255, calc(if_gettrans(levelup:levelup_bg) + 10)), levelup:number_centre);
        if_settrans(min(255, calc(if_gettrans(levelup:levelup_bg) + 10)), levelup:wheel);
        if_settrans(min(255, calc(if_gettrans(levelup:levelup_bg) + 10)), levelup:levelup_bg);
    } else {
        cc_deleteall(levelup:unlocks_layer);
        cc_deleteall(levelup:firework_layer);
        if_setontimer(null, levelup:levelup_layer);
        if_sethide(true, levelup:info);
        if_sethide(~int_to_bool(%xpdisplay_dont_show_popups), xp_popup:xp_ring_layer);
    }
}
