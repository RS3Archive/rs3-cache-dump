// 3336
[clientscript,levelup_fadetimer](int $int0, int $int1, int $int2, int $int3)
def_int $int4 = if_get2dangle(interface_1216:com_8);
$int4 = calc($int4 - 800);
if ($int4 < 0) {
    $int4 = 65000;
}
if_set2dangle($int4, interface_1216:com_8);
def_int $int5 = max(1, calc($int1 - $int0));
def_int $int6 = calc(255 / $int5 + 1);
if_sethide(false, interface_1216:com_2);
if_sethide(false, interface_1216:com_4);
if (clientclock < $int1 & clientclock > $int0) {
    if_settrans(min(175, calc(if_gettrans(interface_1216:com_17) + $int6)), interface_1216:com_17);
    if_settrans(max(0, calc(if_gettrans(interface_1216:com_14) - $int6)), interface_1216:com_14);
    if_settrans(max(0, calc(if_gettrans(interface_1216:com_14) - $int6)), interface_1216:com_16);
    if_settrans(max(0, calc(if_gettrans(interface_1216:com_14) - $int6)), interface_1216:com_15);
    return;
} else if (clientclock < $int2 & clientclock >= $int1) {
    if (clientclock >= calc($int1 + 25)) {
        if_sethide(true, interface_1216:com_2);
        if_sethide(true, interface_1216:com_3);
        if_sethide(true, interface_1216:com_4);
    }
    if (clientclock = $int1) {
        ~levelup_unlocks($int3, calc($int2 - $int1));
