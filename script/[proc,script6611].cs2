// 6611
[proc,script6611](int $int0, int $int1)
def_int $int2 = 0;
def_int $int3 = 0;
if ($int0 = 1) {
    if (enum(int, int, bship_gamepiece, $int1) = 1) {
        cc_setgraphic(aif_penguin_fish_tiny);
        $int2, $int3 = 20, 20;
    }
    if (enum(int, int, bship_gamepiece, $int1) = 2) {
        cc_setgraphic(aif_penguin_fish_small);
        $int2, $int3 = 40, 20;
    }
    if (enum(int, int, bship_gamepiece, $int1) = 3) {
        cc_setgraphic(aif_penguin_fish_medium);
        $int2, $int3 = 60, 20;
    }
    if (enum(int, int, bship_gamepiece, $int1) = 4) {
        cc_setgraphic(aif_penguin_fish_large);
        $int2, $int3 = 80, 20;
    }
    cc_setsize($int2, $int3, ^setsize_abs, ^setsize_abs);
} else {
    if (enum(int, int, bship_gamepiece, $int1) = 1) {
        cc_setgraphic(aif_penguin_fish_tiny_vertical);
        $int2, $int3 = 20, 20;
    }
    if (enum(int, int, bship_gamepiece, $int1) = 2) {
        cc_setgraphic(aif_penguin_fish_small_vertical);
        $int2, $int3 = 20, 40;
    }
    if (enum(int, int, bship_gamepiece, $int1) = 3) {
        cc_setgraphic(aif_penguin_fish_medium_vertical);
        $int2, $int3 = 20, 60;
    }
    if (enum(int, int, bship_gamepiece, $int1) = 4) {
        cc_setgraphic(aif_penguin_fish_large_vertical);
        $int2, $int3 = 20, 80;
    }
    cc_setsize($int2, $int3, ^setsize_abs, ^setsize_abs);
}
