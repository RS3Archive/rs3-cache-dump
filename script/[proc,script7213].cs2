// 7213
[proc,script7213](component $component0, component $component1)
if_setposition(~script1552(%meslayer_caret, %p_dialog_input, museo_sans_11pt_regular, $component0, -1), if_gety($component1), ^setpos_abs_left, ^setpos_abs_top, $component1);
if (applet_hasfocus = true) {
    if_sethide(false, $component1);
} else {
    if_sethide(true, $component1);
}
if_setontimer("script1400(clientclock, $component1)", $component0);
