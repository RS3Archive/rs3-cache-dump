// 7650
[clientscript,script7650](component $component0)
if (%music_v3_protect = 1 | %cutscene_status = 1) {
    return;
}
if (%music_shuffle_toggle_varc = 1) {
    if (if_getgraphic($component0) ! "aif_skip_button,1" & if_getgraphic($component0) ! "aif_skip_button,3") {
        if_setgraphic("aif_skip_button,1", $component0);
    }
    ~script8800("Skip button", $component0, -1);
}
