// 15730
[proc,script15730]
if (if_gethide(wheel_of_fortune:trh_promo_info) = false) {
    if (if_gethide(wheel_of_fortune:trh_promo_info_popup_layer) = false) {
        if_triggerop(wheel_of_fortune:trh_promo_info_popup_layer_close, -1, 1);
    } else {
        if_triggerop(wheel_of_fortune:countdown_layer, -1, 1);
    }
    return;
}
switch_struct (~trh_promo_current) {
    case trh183_promo :
        if (~script19039 = true) {
            return;
        }
}
if_triggerop(wheel_of_fortune:wheel_close_button_layer, -1, 1);
