[proc,trh_get_reward_per_key_item_count](struct $struct0, dbrow $dbrow1)(int)
switch_struct ($struct0) {
    case trh177_promo :
        return(db_getfieldcount($dbrow1, trh177_promo_bonus:col6));
    case trh196_promo :
        return(db_getfieldcount($dbrow1, trh196_promo_bonus:col6));
    case trh205_promo :
        return(db_getfieldcount($dbrow1, trh205_promo_bonus:col6));
    case default :
        ~error("Unexpected promo in trh_get_reward_per_key_item_count - returning 0");
}
return(0);
