// 14102
[clientscript,script14102](component $component0, component $component1, int $int2)
if ($int2 >= 0) {
    if_setontimer("script14102($component0, $component1, calc($int2 - 1))", $component1);
    return;
} else {
    if_setontimer(null, $component1);
    if_setop(1, "Shrink", toolbelt_v2:info_expandarrow);
    if_setvflip(false, $component1);
