// 240
[proc,snapshot_selected_highlight](int $int0)
def_int $int1 = 0;
while ($int1 < if_getnextsubid(snapshot_main_v2:selected_name_layer)) {
    if (cc_find(snapshot_main_v2:selected_name_layer, $int1) = true) {
        cc_settrans(255);
    }
    $int1 = calc($int1 + 1);
}
if (cc_find(snapshot_main_v2:selected_name_layer, $int0) = true) {
    cc_settrans(110);
}
