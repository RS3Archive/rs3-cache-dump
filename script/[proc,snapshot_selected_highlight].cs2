// 240
[proc,snapshot_selected_highlight](int $int0)
def_int $int1 = 0;
while ($int1 < if_getnextsubid(interface_594:com_10)) {
    if (cc_find(interface_594:com_10, $int1) = true) {
        cc_settrans(255);
    }
    $int1 = calc($int1 + 1);
}
if (cc_find(interface_594:com_10, $int0) = true) {
    cc_settrans(110);
}
