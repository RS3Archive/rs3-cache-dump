// 17084
[clientscript,script17084](component $component0)
def_int $int1 = %death_last_tab;
switch_component ($component0) {
    case death:tab_overview :
        %death_last_tab = 0;
    case death:tab_death :
        %death_last_tab = 1;
    case death:tab_overflow :
        %death_last_tab = 2;
    case death:tab_danger :
        %death_last_tab = 3;
    case default :
        return;
}
if ($int1 = %death_last_tab) {
    ~death_update_tabs(~script12799(~death_get_type, 1, 0, %deathkeep_info_dangermode));
    return;
}
switch_int ($int1) {
    case 0, 1 :
        if (%death_last_tab = 2 | %death_last_tab = 3) {
            %death_price_transmit = 1;
        }
    case 2, 3 :
        %death_price_transmit = 1;
}
~death_build;
