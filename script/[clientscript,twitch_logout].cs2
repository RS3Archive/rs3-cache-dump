// 3103
[clientscript,twitch_logout]
def_int $int0 = 0;
if (%varclientbit_23064 = 1) {
    $int0 = ttv_logout;
    if ($int0 = 0) {
        %varclientbit_23064 = 0;
        ~script3147;
        ~script10118;
        ~script7698;
        if_sethide(false, toplevel_v2_parent_suboverlay_twitch:logout_btn_disable);
        if_sethide(true, toplevel_v2_parent_suboverlay_twitch:logout_btn);
        mes("You have successfully logged out from Twitch.");
        if_setontimer(null, twitch_stream:webcam_buttons);
        if_sethide(true, twitch_stream:quality_warning);
        if_sethide(true, twitch_stream:quality_error);
        if_sethide(true, twitch_stream:countdown_text);
        sound_vorbis_volume(tli_click_01, 1, 0, 100);
    }
} else {
    mes("You are not logged in to Twitch.");
    sound_vorbis_volume(omge_error, 1, 0, 150);
}
