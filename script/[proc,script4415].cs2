// 4415
[proc,script4415]
~script9554(clan_info:mainmodal_window_background, clan_info:mainmodal_window_border, clan_info:mainmodal_window_content, activeclansettings_getclanname, toplevel_v2_default_main_modal_skin_data);
if_settext("Game time:<br><~clan_offset_tostring(%clan_time_offset_varclan)>", clan_info:timezone_text);
if_settext("<col=FFFFFF><activeclansettings_getaffineddisplayname(activeclansettings_getcurrentowner_slot)></col>", clan_info:leader_text);
if (%clan_homeworld_varclan > 0) {
    if_settext("<col=FFFFFF><tostring(%clan_homeworld_varclan)></col>", clan_info:homeworld_text);
}
if_settext("<col=FFFFFF><tostring(activeclansettings_getaffinedcount)></col>", clan_info:clansize_text);
if (%clan_is_recruiting_varclan = 0) {
    if_settext("<col=FFFFFF>This clan is not recruiting.</col>", clan_info:recruiting_text);
} else if (%clan_is_recruiting_varclan = 1) {
    if_settext("<col=FFFFFF>This clan is recruiting.</col>", clan_info:recruiting_text);
}
~script4332(clan_info:logo1_gfx, clan_info:logo2_gfx);
~script4334(clan_info:colour1, clan_info:colour2);
~script4336(clan_info:motto_text);
~script4343(clan_info:keyword_text);
~script4329(clan_info:qfc_text);
~script4328(clan_info:flag);
~script12226(clan_info:clan_home_link);
if_sethide(true, clan_info:clan_data_waiting);
