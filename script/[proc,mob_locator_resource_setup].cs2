// 2490
[proc,mob_locator_resource_setup]
if (%mob_locator_charges < 0) {
    %mob_locator_charges = 0;
}
if (%mob_locator_type < 0) {
    %mob_locator_type = 1;
}
if_settext("Charges left: <tostring(%mob_locator_charges)>", mob_locator:charges);
if_setobject_nonum(copper_ore, 1, mob_locator:ore1);
if_setobject_nonum(tin_ore, 1, mob_locator:ore2);
if_setobject_nonum(iron_ore, 1, mob_locator:ore3);
if (%mob_locator_type < 2) {
    if_setcolour(0x404040, mob_locator:ore4);
    if_setcolour(0x404040, mob_locator:ore5);
} else {
    if_setcolour(^white, mob_locator:ore4);
    if_setcolour(^white, mob_locator:ore5);
}
if_setobject_nonum(silver_ore, 1, mob_locator:ore4);
if_setobject_nonum(clay, 1, mob_locator:ore5);
if (%mob_locator_type < 3) {
    if_setcolour(0x404040, mob_locator:ore6);
    if_setcolour(0x404040, mob_locator:ore7);
} else {
    if_setcolour(^white, mob_locator:ore6);
    if_setcolour(^white, mob_locator:ore7);
}
if_setobject_nonum(gold_ore, 1, mob_locator:ore6);
if_setobject_nonum(mithril_ore, 1, mob_locator:ore7);
if (%mob_locator_type < 4) {
    if_setcolour(0x404040, mob_locator:ore8);
    if_setcolour(0x404040, mob_locator:ore9);
} else {
    if_setcolour(^white, mob_locator:ore8);
    if_setcolour(^white, mob_locator:ore9);
}
if_setobject_nonum(adamantite_ore, 1, mob_locator:ore8);
if_setobject_nonum(runite_ore, 1, mob_locator:ore9);
if_settext(oc_name(copper_ore), mob_locator:oretext1);
if_settext(oc_name(tin_ore), mob_locator:oretext2);
if_settext(oc_name(iron_ore), mob_locator:oretext3);
if (%mob_locator_type < 2) {
    if_settext("<oc_name(silver_ore)> (locked)", mob_locator:oretext4);
    if_settext("<oc_name(clay)> (locked)", mob_locator:oretext5);
} else {
    if_settext(oc_name(silver_ore), mob_locator:oretext4);
    if_settext(oc_name(clay), mob_locator:oretext5);
}
if (%mob_locator_type < 3) {
    if_settext("<oc_name(gold_ore)> (locked)", mob_locator:oretext6);
    if_settext("<oc_name(mithril_ore)> (locked)", mob_locator:oretext7);
} else {
    if_settext(oc_name(gold_ore), mob_locator:oretext6);
    if_settext(oc_name(mithril_ore), mob_locator:oretext7);
}
if (%mob_locator_type < 4) {
    if_settext("<oc_name(adamantite_ore)> (locked)", mob_locator:oretext8);
    if_settext("<oc_name(runite_ore)> (locked)", mob_locator:oretext9);
} else {
    if_settext(oc_name(adamantite_ore), mob_locator:oretext8);
    if_settext(oc_name(runite_ore), mob_locator:oretext9);
}
if_setobject_nonum(oak_logs, 1, mob_locator:wood1);
if_setobject_nonum(willow_logs, 1, mob_locator:wood2);
if (%mob_locator_type < 2) {
    if_setcolour(0x404040, mob_locator:wood3);
    if_setcolour(0x404040, mob_locator:wood4);
} else {
    if_setcolour(^white, mob_locator:wood3);
    if_setcolour(^white, mob_locator:wood4);
}
if_setobject_nonum(maple_logs, 1, mob_locator:wood3);
if_setobject_nonum(eucalyptus_logs, 1, mob_locator:wood4);
if (%mob_locator_type < 3) {
    if_setcolour(0x404040, mob_locator:wood5);
} else {
    if_setcolour(^white, mob_locator:wood5);
}
if_setobject_nonum(yew_logs, 1, mob_locator:wood5);
if (%mob_locator_type < 4) {
    if_setcolour(0x404040, mob_locator:wood6);
    if_setcolour(0x404040, mob_locator:wood7);
} else {
    if_setcolour(^white, mob_locator:wood6);
    if_setcolour(^white, mob_locator:wood7);
}
if_setobject_nonum(magic_logs, 1, mob_locator:wood6);
if_setobject_nonum(elder_logs, 1, mob_locator:wood7);
if_settext(oc_name(oak_logs), mob_locator:woodtext1);
if_settext(oc_name(willow_logs), mob_locator:woodtext2);
if (%mob_locator_type < 2) {
    if_settext("<oc_name(maple_logs)> (locked)", mob_locator:woodtext3);
    if_settext("Special logs (locked)", mob_locator:woodtext4);
} else {
    if_settext(oc_name(maple_logs), mob_locator:woodtext3);
    if_settext("Special logs", mob_locator:woodtext4);
}
if (%mob_locator_type < 3) {
    if_settext("<oc_name(yew_logs)> (locked)", mob_locator:woodtext5);
} else {
    if_settext(oc_name(yew_logs), mob_locator:woodtext5);
}
if (%mob_locator_type < 4) {
    if_settext("<oc_name(magic_logs)> (locked)", mob_locator:woodtext6);
    if_settext("<oc_name(elder_logs)> (locked)", mob_locator:woodtext7);
} else {
    if_settext(oc_name(magic_logs), mob_locator:woodtext6);
    if_settext(oc_name(elder_logs), mob_locator:woodtext7);
}
if_setobject_nonum(raw_shrimp, 1, mob_locator:fish1);
if (%mob_locator_type < 3) {
    if_setcolour(0x404040, mob_locator:fish2);
} else {
    if_setcolour(^white, mob_locator:fish2);
}
if_setobject_nonum(raw_lobster, 1, mob_locator:fish2);
if_settext("Fish 1", mob_locator:fishtext1);
if (%mob_locator_type < 3) {
    if_settext("Fish 2 (locked)", mob_locator:fishtext2);
} else {
    if_settext("Fish 2", mob_locator:fishtext2);
}
if_setobject_nonum(toads_legs, 1, mob_locator:herb1);
if (%mob_locator_type < 3) {
    if_setcolour(0x404040, mob_locator:herb2);
} else {
    if_setcolour(^white, mob_locator:herb2);
}
if_setobject_nonum(white_berries, 1, mob_locator:herb2);
if_settext("Herblore<br>secondaries 1", mob_locator:herbtext1);
if (%mob_locator_type < 3) {
    if_settext("Herblore<br>secondaries 2 (locked)", mob_locator:herbtext2);
} else {
    if_settext("Herblore<br>secondaries 2", mob_locator:herbtext2);
}
