// 5958
[clientscript,script5958]
if (if_getgraphic(clan_stronghold_main_resources:manual_lock_checkbox) = "aif_checkbox_small,1") {
    if_setgraphic("aif_checkbox_small,3", clan_stronghold_main_resources:manual_lock_checkbox);
} else if (if_getgraphic(clan_stronghold_main_resources:manual_lock_checkbox) = "aif_checkbox_small,3") {
    if_setgraphic("aif_checkbox_small,1", clan_stronghold_main_resources:manual_lock_checkbox);
    if_setgraphic("aif_checkbox_small,3", clan_stronghold_main_resources:lock_on_target_checkbox);
}
