// 5958
[clientscript,script5958]
if (if_getgraphic(interface_1260:com_89) = "aif_checkbox_small,1") {
    if_setgraphic("aif_checkbox_small,3", interface_1260:com_89);
} else if (if_getgraphic(interface_1260:com_89) = "aif_checkbox_small,3") {
    if_setgraphic("aif_checkbox_small,1", interface_1260:com_89);
    if_setgraphic("aif_checkbox_small,3", interface_1260:com_87);
}
