// 5945
[proc,wof_position_button](int $int0, int $int1)
def_component $component2 = wheel_of_fortune_button:container;
def_component $component3 = wheel_of_fortune_button:content_layer;
def_int $int4 = max(1, if_getwidth($component2));
def_int $int5 = max(1, if_getheight($component2));
if ($int4 > 0 & $int5 > 0) {
    %wof_button_x = max(1, $int0);
    %wof_button_y = max(1, $int1);
    %wof_button_x = min(%wof_button_x, calc($int4 - if_getwidth($component3)));
    %wof_button_y = min(%wof_button_y, calc($int5 - if_getheight($component3)));
}
if_setposition(scale(%wof_button_x, $int4, 16384), scale(%wof_button_y, $int5, 16384), ^setpos_rel_left, ^setpos_rel_top, $component3);
