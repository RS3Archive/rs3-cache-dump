// 2909
[clientscript,ii_timer_update](component $component0, component $component1)
if (%ii_affinity_time_left = 0) {
    if_sethide(true, $component0);
} else if (%ii_affinity_time_left < 5) {
    if_settext("<lt>1 min", $component1);
} else {
    if_settext("<tostring(calc((%ii_affinity_time_left + 4) / 5))> min", $component1);
}
