// 16531
[proc,trh180_update_bonus_layer]
def_dbrow $dbrow0 = null;
def_string $string0 = "None";
def_graphic $graphic1 = null;
if (%trh180_current_bonus > 0) {
    $dbrow0 = ~script16519(%trh180_current_bonus);
    $string0 = db_getfield($dbrow0, trh180_promo_bonus:col1, 0);
    $graphic1 = db_getfield($dbrow0, trh180_promo_bonus:col7, 0);
    ~script3536(db_getfield($dbrow0, trh180_promo_bonus:col3, 0), trh180_overlay:current_bonus_content_layer, -1);
