// 2250
[proc,script2250](npc $npc0)(int)
def_int $int1 = 0;
def_var_int $var_int2 = nc_param($npc0, quest_wendle_secrets_part_2_puzzle_activity_data_var);
if ($var_int2 = null) {
    error("Invalid $person reached in quest_wendle_secrets_part_2_puzzle_activity_getter");
    return(0);
}
def_int $int3 = var_reference_get($var_int2);
while ($int1 <= 5) {
    if (testbit($int3, $int1) = ^true) {
        return($int1);
    } else {
        $int1 = calc($int1 + 1);
    }
}
if ($int1 < 0 | $int1 > 6) {
    error("Invalid $activity_index reached in quest_wendle_secrets_part_2_puzzle_activity_getter");
}
return(0);
