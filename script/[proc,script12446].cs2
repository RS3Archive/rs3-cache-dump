// 12446
[proc,script12446]
if (~machinima_camera_open = true & has_nxt = true) {
    if_setongamepadbutton("script12449(event_gamepadbutton, event_gamepadvalue)", toplevel_v2:gamepad_listener);
    if_setongamepadaxis("script12450(event_gamepadbutton, event_gamepadvalue)", toplevel_v2:gamepad_listener);
    if_setongamepadtrigger("script12451(event_gamepadbutton, event_gamepadvalue)", toplevel_v2:gamepad_listener);
    if_setongamepadbuttonheld("script12449(event_gamepadbutton, 1)", toplevel_v2:gamepad_listener);
}
