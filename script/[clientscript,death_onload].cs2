// 5389
[clientscript,death_onload]
~death_build;
if (if_find(interface_1626:com_11) = true) {
    cc_setonvartransmit("death_rebuild{varplayer_5435, varplayer_5436, varplayer_5433}");
    cc_setoninvtransmit("death_rebuild{inv_676, inv_930}");
    cc_setonvarctransmit("death_rebuild{varclient_4876, varclient_4877}");
    cc_setonvarcstrtransmit("death_rebuild{varclient_2368, varclient_2369}");
}
