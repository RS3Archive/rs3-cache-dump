// 5389
[clientscript,death_onload]
~death_build;
if (if_find(death:listener) = true) {
    cc_setonvartransmit("death_rebuild{death_temp1, death_temp2, death_unprotected}");
    cc_setoninvtransmit("death_rebuild{grave_gravestone_contents, death_overflow}");
    cc_setonvarctransmit("death_rebuild{death_value_bob, death_gravestone_available}");
    cc_setonvarcstrtransmit("death_rebuild{deathkeep_info_safearea, deathkeep_info_sidepanel}");
}
