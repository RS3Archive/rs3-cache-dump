// 10911
[clientscript,script10911]
def_string $string0 = "Drop in";
if (%thedrop_round_state = 1) {
    if_sethide(false, thedrop:thedrop_panel);
    if_settext("Drop in: 5.00", thedrop:thedrop_timer);
    if_setontimer("script10912(clientclock, calc(clientclock + 250), $string0)", thedrop:thedrop_timer);
} else if (%thedrop_round_state = 2) {
    if_sethide(false, thedrop:thedrop_panel);
    if_settext("Next round in: ", thedrop:thedrop_timer);
    $string0 = "Next round in";
    if_setontimer("script10912(clientclock, calc(clientclock + 500), $string0)", thedrop:thedrop_timer);
}
