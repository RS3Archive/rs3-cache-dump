// 6323
[proc,script6323]
def_component $component0 = cc_getlayer;
def_obj $obj1 = inv_getobj(omge_worn_inv_copy, 0);
if ($obj1 ! null) {
    cc_setobject($obj1, inv_getnum(omge_worn_inv_copy, 0));
    cc_settrans(0);
    if_setop(1, "Remove", $component0);
    if_setop(10, "Examine", $component0);
    if_setopbase("<~script4033($obj1)><oc_name($obj1)>", $component0);
    if_setonop("script1620($component0, cc_getid, 150, 0, 10)", $component0);
} else {
    cc_setobject_nonum(carni_treasurechest, 1);
    cc_settrans(100);
    cc_setontimer(null);
    if_clearops($component0);
    if_setop(1, "What is this?", $component0);
    if_setopbase("", $component0);
    if_setonop(null, $component0);
}
