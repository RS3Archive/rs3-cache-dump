// 19624
[proc,script19624](achievement $achievement0, int $int1, string $string0)(string)
switch_achievement ($achievement0) {
    case cheevo_gathering_misthalin :
        switch_int ($int1) {
            case 0 :
                $string0 = append($string0, "(<tostring(min(%cheevo_gathering_misthalin_logs, 10))>/<tostring(10)>)");
            case 1 :
                $string0 = append($string0, "(<tostring(min(%cheevo_gathering_misthalin_shrimp, 10))>/<tostring(10)>)");
