// 3908
[clientscript,script3908]
if (stat(hunter) > stat_base(hunter)) {
    ~script10624(combatv2_hunter_nerfed_dummy_ability, 0);
    return;
} else if (stat(hunter) < stat_base(hunter)) {
    ~script10624(combatv2_hunter_nerfed_dummy_ability, 1);
    return;
}
~script10624(combatv2_hunter_nerfed_dummy_ability, 0);
