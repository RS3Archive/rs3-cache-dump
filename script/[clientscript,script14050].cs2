// 14050
[clientscript,script14050]
if_settext(tostring_localised(%dsf_generic_fish_streak, true), deep_sea_generic_fish_overlay:streak_text);
if_settext("<tostring_localised(min(%dsf_generic_fish_max_bonus, calc(%dsf_generic_fish_streak / max(1, %dsf_generic_fish_bonus_divisor))), true)>%", deep_sea_generic_fish_overlay:bonus_text);
