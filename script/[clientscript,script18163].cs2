// 18163
[clientscript,script18163]
if (calc(clientclock % 50) = 0) {
    if_settext(~script18166, doublexp_week:doublexp_timer);
    ~script18167(0);
    if (%doublexp_prioritise_dxp_personal_buff_time = 0) {
        if (%doublexp_week_seconds_remaining > 0 | %doublexp_week_minutes_remaining > 0) {
            ~script18164;
        } else {
            ~script18165;
        }
    } else if (%doublexp_personal_buff_seconds_remaining > 0 | %doublexp_personal_buff_minutes_remaining > 0) {
        ~script18165;
    } else {
        ~script18164;
    }
}
