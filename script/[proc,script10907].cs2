// 10907
[proc,script10907](obj $obj0)(boolean)
switch_obj ($obj0) {
    case rcguild_hat_blue, rcguild_hat_yellow, rcguild_hat_green, rcguild_robetop_blue, rcguild_robetop_yellow, rcguild_robetop_green, rcguild_robebottom_blue, rcguild_robebottom_yellow, rcguild_robebottom_green, rcguild_gloves_blue, rcguild_gloves_yellow, rcguild_gloves_green :
        return(true);
    case rcguild_tablet_blood :
        if (%atmo_hard_bloodteletab = 0 & ~obj_gettotal(rcguild_tablet_blood) = 0) {
            return(true);
        } else {
            return(false);
        }
    case default :
        return(false);
}
