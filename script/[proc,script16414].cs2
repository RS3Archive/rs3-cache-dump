// 16414
[proc,script16414](graphic $graphic0)(graphic)
switch_graphic ($graphic0) {
    case rs3_tutsys_wasd :
        if (map_lang = 2) {
            return(rs3_tutsys_zqsd);
        }
    case tutsys_combat_experience :
        if (map_lang ! 0) {
            return(null);
        }
    case rs3_tutsys_pageup_pagedwn_buttons :
        switch_int (map_lang) {
            case 1 :
                return(rs3_tutsys_pageup_pagedwn_buttons_de);
            case 2 :
                return(rs3_tutsys_pageup_pagedwn_buttons_fr);
            case 6 :
                return(rs3_tutsys_pageup_pagedwn_buttons_es);
        }
    case "aif_level_up_text_language,3" :
        switch_int (map_lang) {
            case 1 :
                return("aif_level_up_text_language,0");
            case 2 :
                return("aif_level_up_text_language,1");
            case 3 :
                return("aif_level_up_text_language,2");
            case 6 :
                return("aif_level_up_text_language,4");
        }
    case bp3_icon_xp_buff_en_fr_50 :
        switch_int (map_lang) {
            case 1 :
                return(bp3_icon_xp_buff_de_50);
            case 3 :
                return(bp3_icon_xp_buff_pt_50);
        }
}
return($graphic0);
