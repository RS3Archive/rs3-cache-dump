// 8977
[proc,script8977]
if_sethide(true, 6awe1_onboarding:world_event);
if_sethide(true, 6awe1_onboarding:combat_academy);
if_sethide(true, 6awe1_onboarding:combat_actionbar);
if_sethide(true, 6awe1_onboarding:combat_features);
if_sethide(true, 6awe1_onboarding:newui_edit);
if_sethide(true, 6awe1_onboarding:newui_options);
if_sethide(true, 6awe1_onboarding:newui_menu);
if_sethide(true, 6awe1_onboarding:newui_swapping);
if_sethide(true, 6awe1_onboarding:newui_adding);
if_sethide(true, 6awe1_onboarding:newui_moving);
if_sethide(true, 6awe1_onboarding:newui_overview);
if_sethide(true, 6awe1_onboarding:welcome_layer);
if_sethide(true, 6awe1_onboarding:html5_content);
def_component $component0 = null;
switch_int (%6awe1_tab_selected) {
    case 0 :
        if_sethide(false, 6awe1_onboarding:welcome_layer);
    case 1 :
        if_sethide(false, 6awe1_onboarding:html5_content);
    case 2 :
        $component0 = ~script8978(calc(%6awe1_page_selected - 1));
        if ($component0 ! null) {
            if_sethide(false, $component0);
        }
    case 3 :
        $component0 = ~script8979(%6awe1_page_selected);
        if ($component0 ! null) {
            if_sethide(false, $component0);
        }
    case 4 :
        if_sethide(false, 6awe1_onboarding:world_event);
}
