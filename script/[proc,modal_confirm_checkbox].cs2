// 4548
[proc,modal_confirm_checkbox](boolean $boolean0, component $component1, component $component2, component $component3)
if_sethide($boolean0, $component2);
if_sethide($boolean0, $component3);
if ($boolean0 = true) {
    ~static_checkbox($component1, 0, false);
} else {
    ~static_checkbox($component1, 1, false);
}
