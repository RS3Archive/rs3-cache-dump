// 14132
[proc,script14132](int $int0, component $component1)
switch_int ($int0) {
    case 0 :
        if (%trh140_sword_unlocked = 1) {
            if_sethide(false, $component1);
        } else {
            if_sethide(true, $component1);
        }
    case 1 :
        if (%trh140_shield_unlocked = 1) {
            if_sethide(false, $component1);
        } else {
            if_sethide(true, $component1);
        }
    case 2 :
        if (%trh140_spear_unlocked = 1) {
            if_sethide(false, $component1);
        } else {
            if_sethide(true, $component1);
        }
    case 3 :
        if (%trh140_staff_unlocked = 1) {
            if_sethide(false, $component1);
        } else {
            if_sethide(true, $component1);
        }
    case 4 :
        if (%trh140_pet_unlocked = 1 & %trh140_prestige = 5) {
            if_sethide(false, $component1);
        } else {
            if_sethide(true, $component1);
        }
}
