if (if_gethide(pop_manager:zone_layer) = false) {
    if_sethide(true, pop_manager:zone_layer);
    if_sethide(false, pop_manager:scrolls_layer);
} else {
    if_sethide(true, pop_manager:scrolls_layer);
    if_sethide(false, pop_manager:zone_layer);
}
~script7367;
