// 2986
[clientscript,ecosystem_requirements_load]
def_int $int0 = 0;
def_int $int1 = 20;
def_int $int2 = 10;
def_int $int3 = 0;
def_obj $obj4 = null;
def_string $string0 = "";
def_string $string1 = "";
def_int $int5 = 0;
cc_deleteall(ecosystem_creatures:build);
cc_deleteall(ecosystem_creatures:click);
while ($int0 < 10) {
    $int3, $obj4, $string0, $string1 = ~script9614($int0);
    if ($int3 = 0) {
        ~script10410(ecosystem_creatures:build, ecosystem_creatures:click, rs3tli_3x3_button, $int1, $int2, 215, 45, $int0, true, "Undiscovered");
    } else {
        ~script10410(ecosystem_creatures:build, ecosystem_creatures:click, rs3tli_3x3_button, $int1, $int2, 215, 45, $int0, false, "");
        if (cc_find(ecosystem_creatures:click, $int0) = true) {
            cc_setop(1, "Select");
            cc_setonop("ecosystem_show_requirements($obj4)");
        }
        ~script4512(ecosystem_creatures:build, 36, 32, calc($int1 + 4), calc($int2 + 4), null);
        cc_setobject_nonum($obj4, 1);
        ~cc_add_title_text(ecosystem_creatures:build, 165, 15, calc($int1 + 44), calc($int2 + 4), museo_sans_11pt_regular, $string0, 0);
        ~script6201(ecosystem_creatures:build, 165, 24, calc($int1 + 44), calc($int2 + 17), museo_sans_11pt_regular, $string1);
    }
    $int0 = calc($int0 + 1);
    $int1 = calc($int1 + 237);
    if ($int1 > 300) {
        $int1 = 20;
        $int2 = calc($int2 + 55);
    }
}
