// 10617
[proc,featured_content_get_quest]()(string, string, graphic)
def_quest $quest0 = enum(int, quest, ql4_quests, %omge_featured_interface_quest_id);
def_string $string0 = "None available";
def_string $string1 = "Click here to view quests.";
def_graphic $graphic1 = rs3_featured_quest_blood_runs_deep;
if ($quest0 ! null) {
    $string0 = ~quest_name($quest0);
    $string1 = quest_param($quest0, quest_description);
}
return($string0, $string1, $graphic1);
