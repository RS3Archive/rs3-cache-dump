// 12777
[clientscript,currency_draw_tooltip](dbrow $dbrow0, component $component1, int $int2)
def_string $string0 = ~currency_name($dbrow0);
if ($dbrow0 = currency_livid_points) {
    $string0 = append($string0, ": <tostring_localised(calc(~currency_pouch_total($dbrow0) * 10), true)>");
} else {
    $string0 = append($string0, ": <tostring_localised(~currency_pouch_total($dbrow0), true)>");
}
~script3877($string0, $component1, $int2);
