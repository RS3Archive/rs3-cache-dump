// 9685
[clientscript,wof_chest_mouseover](component $component0)
if_setmodelanim(trh_chest_selected, $component0);
switch_int (random(5)) {
    case 0 :
        sound_vorbis_rate(treasure_hunter_interface_mouseover_chest_1, 1, 0, 80, random_sound_pitch(20, 20));
    case 1 :
        sound_vorbis_rate(treasure_hunter_interface_mouseover_chest_2, 1, 0, 80, random_sound_pitch(20, 20));
    case 2 :
        sound_vorbis_rate(treasure_hunter_interface_mouseover_chest_3, 1, 0, 80, random_sound_pitch(20, 20));
    case 3 :
        sound_vorbis_rate(treasure_hunter_interface_mouseover_chest_4, 1, 0, 80, random_sound_pitch(20, 20));
    case 4 :
        sound_vorbis_rate(treasure_hunter_interface_mouseover_chest_5, 1, 0, 80, random_sound_pitch(20, 20));
}
