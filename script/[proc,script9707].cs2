    case wheel_of_fortune:ticker_box_7 :
        return(if_getx(wheel_of_fortune:ticker_box_8));
    case wheel_of_fortune:ticker_box_8 :
        return(if_getx(wheel_of_fortune:ticker_box_9));
    case wheel_of_fortune:ticker_box_9 :
