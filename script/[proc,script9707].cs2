// 9707
[proc,script9707](component $component0)(int)
switch_component ($component0) {
    case wheel_of_fortune:ticker_box_1 :
        return(if_getx(wheel_of_fortune:ticker_box_2));
    case wheel_of_fortune:ticker_box_2 :
