// 9836
[proc,script9836]
if (%rhino_client_question = null) {
    return;
}
if_settext(struct_param(%rhino_client_question, task_name), rhino_awareness:todays_rhino_title);
if_settext(struct_param(%rhino_client_question, rhino_question), rhino_awareness:todays_rhino_question);
if_settext(struct_param(%rhino_client_question, rhino_answer_1), rhino_awareness:answer_1_btn_text);
if_settext(struct_param(%rhino_client_question, rhino_answer_2), rhino_awareness:answer_2_btn_text);
if_settext(struct_param(%rhino_client_question, rhino_answer_3), rhino_awareness:answer_3_btn_text);
if_settext(struct_param(%rhino_client_question, rhino_answer_4), rhino_awareness:answer_4_btn_text);
