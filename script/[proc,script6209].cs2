// 6209
[proc,script6209]
def_int $int0 = if_getwidth(clan_chat:clan_list_parent_layer);
if ($int0 < 210) {
    if_sethide(true, clan_chat:clan_buttons_layer);
} else {
    if_sethide(false, clan_chat:clan_buttons_layer);
}
if ($int0 < 153) {
    ~script7816(clan_chat:main_content_layer, 0);
} else if (~clan_cup_visible = null) {
    ~script7816(clan_chat:main_content_layer, 0);
} else {
    ~script7816(clan_chat:main_content_layer, 1);
}
