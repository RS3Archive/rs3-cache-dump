// 4073
[clientscript,script4073]
sound_vorbis_volume(tut7_login_play_now_button, 1, 0, 185);
if (~script4597 = true) {
    return;
}
if (sso_available = true) {
    ~script380(mobile_analytics_continue_with_existing_acc);
    lobby_enterlobby_sso(%loginscreen_totp_auth, %loginscreen_remember_auth);
    %login_via_social = 1;
    if_sethide(true, loginscreen:login);
    ~script15662("Signing in...", -1, 0);
    %login_reply_last = -3;
    if_setontimer("login_reply(0)", loginscreen:login_progress_popup);
}
