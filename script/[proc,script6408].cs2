    ~ss_disable_button(ss_rework:helmet_layer, 1);
} else if (%smki_slayer_points < 400) {
    ~ss_disable_button(ss_rework:helmet_layer, 0);
} else if (%smki < 250 & ~script1858(8) = false) {
    ~ss_disable_button(ss_rework:helmet_layer, 1);
}
if (%smki_slayer_points < 50) {
    ~ss_disable_button(ss_rework:aquanites_layer, 0);
    ~ss_disable_button(ss_rework:muspah_layer, 0);
    ~ss_disable_button(ss_rework:nihil_layer, 0);
    ~ss_disable_button(ss_rework:glacor_layer, 0);
    ~ss_disable_button(ss_rework:tdemon_layer, 0);
    ~ss_disable_button(ss_rework:nightmare_layer, 0);
}
