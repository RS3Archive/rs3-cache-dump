    if_settext("Already learned", ss_rework:tdemon_cost);
}
if (%fotg2_nightmare_task_unlocked = 1) {
    if_settext("Already learned", ss_rework:nightmare_cost);
}
if (%smki_autosmash_gargoyle = 1) {
