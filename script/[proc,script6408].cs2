// 6408
[proc,script6408]
if (%smki_missile_make = 1) {
    ~ss_disable_button(ss_rework:fletch_layer, 1);
} else if (%smki_slayer_points < 300) {
    ~ss_disable_button(ss_rework:fletch_layer, 0);
}
if (%smki_ring_make = 1) {
    ~ss_disable_button(ss_rework:craft_ring_layer, 1);
} else if (%smki_slayer_points < 300) {
    ~ss_disable_button(ss_rework:craft_ring_layer, 0);
}
