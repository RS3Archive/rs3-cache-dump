} else if (%smki_slayer_points < 500) {
    ~ss_disable_button(ss_rework:fuse_layer, 0);
} else if (%smki < 250 & ~script1858(8) = false) {
    ~ss_disable_button(ss_rework:fuse_layer, 1);
}
if (%toolbelt_bonecrusher_bought = 1) {
