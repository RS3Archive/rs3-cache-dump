// 16054
[clientscript,script16054](component $component0)
cc_deleteall($component0);
def_int $int1 = 0;
while ($int1 < 6) {
    cc_create($component0, ^iftype_graphic, $int1++);
    cc_setgraphic(gwd2_wheel_icon_background);
    cc_setsize(91, 82, ^setsize_abs, ^setsize_abs);
    cc_setposition(calc(cc_getwidth * ($int1 - 2)), 0, ^setpos_abs_left, ^setpos_rel_centre);
}
