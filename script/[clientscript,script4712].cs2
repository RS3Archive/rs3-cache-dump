// 4712
[clientscript,script4712]
def_int $int0 = 134;
def_int $int1 = 70;
def_int $int2 = 6;
def_int $int3 = 0;
def_int $int4 = random(6);
while ($int3 < $int4) {
    if (calc(++$int3 % 2) = 1) {
        $int0 = calc($int0 + $int1);
        $int1 = calc($int0 - $int1);
        $int0 = calc($int0 - $int1);
    } else {
        $int1 = calc($int1 + $int2);
        $int2 = calc($int1 - $int2);
        $int1 = calc($int1 - $int2);
    }
}
if_setposition(0, $int0, ^setpos_abs_centre, ^setpos_abs_bottom, newplayer_prompt:newplayer_new_button_layer);
if_setposition(0, $int1, ^setpos_abs_centre, ^setpos_abs_bottom, newplayer_prompt:newplayer_return_button_layer);
if_setposition(0, $int2, ^setpos_abs_centre, ^setpos_abs_bottom, newplayer_prompt:newplayer_recent_button_layer);
