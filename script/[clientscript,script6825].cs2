// 6825
[clientscript,script6825](int $int0, component $component1)
def_int $int2 = calc(clientclock - $int0);
def_int $int3 = 0;
if ($int2 < 75) {
    $int3 = calc(15 + scale($int2, 75, 10));
    if_setposition(0, $int3, ^setpos_abs_centre, ^setpos_abs_centre, $component1);
} else if ($int2 < 150) {
    $int3 = calc(25 - scale(calc($int2 - 75), 75, 10));
    if_setposition(0, $int3, ^setpos_abs_centre, ^setpos_abs_centre, $component1);
} else if ($int2 < 225) {
    $int3 = calc(15 - scale(calc($int2 - 150), 75, 10));
    if_setposition(0, $int3, ^setpos_abs_centre, ^setpos_abs_centre, $component1);
} else if ($int2 < 300) {
    $int3 = calc(5 + scale(calc($int2 - 225), 75, 10));
    if_setposition(0, $int3, ^setpos_abs_centre, ^setpos_abs_centre, $component1);
}
if ($int2 >= 300) {
    ~script6828;
}
