// 17268
[proc,script17268](stat $stat0, struct $struct1)(int)
switch_stat ($stat0) {
    case agility :
        return(struct_param($struct1, potion_info_stat_bonus_agility));
    case summoning :
        return(struct_param($struct1, potion_info_stat_bonus_animallore));
    case archaeology :
        return(struct_param($struct1, potion_info_stat_bonus_archaeology));
    case attack :
        return(struct_param($struct1, potion_info_stat_bonus_attack));
    case hitpoints :
        return(struct_param($struct1, potion_info_stat_bonus_constitution));
    case construction :
        return(struct_param($struct1, potion_info_stat_bonus_construction));
    case cooking :
        return(struct_param($struct1, potion_info_stat_bonus_cooking));
    case crafting :
        return(struct_param($struct1, potion_info_stat_bonus_crafting));
    case defence :
        return(struct_param($struct1, potion_info_stat_bonus_defence));
    case divination :
        return(struct_param($struct1, potion_info_stat_bonus_divination));
    case dungeoneering :
        return(struct_param($struct1, potion_info_stat_bonus_dungeoneering));
    case farming :
        return(struct_param($struct1, potion_info_stat_bonus_farming));
    case firemaking :
        return(struct_param($struct1, potion_info_stat_bonus_firemaking));
    case fishing :
        return(struct_param($struct1, potion_info_stat_bonus_fishing));
    case fletching :
        return(struct_param($struct1, potion_info_stat_bonus_fletching));
    case herblore :
        return(struct_param($struct1, potion_info_stat_bonus_herblore));
    case hunter :
        return(struct_param($struct1, potion_info_stat_bonus_hunter));
    case invention :
        return(struct_param($struct1, potion_info_stat_bonus_invention));
    case magic :
        return(struct_param($struct1, potion_info_stat_bonus_magic));
    case mining :
        return(struct_param($struct1, potion_info_stat_bonus_mining));
    case necromancy :
        return(struct_param($struct1, potion_info_stat_bonus_necromancy));
    case prayer :
        return(struct_param($struct1, potion_info_stat_bonus_prayer));
    case ranged :
        return(struct_param($struct1, potion_info_stat_bonus_ranged));
    case runecraft :
        return(struct_param($struct1, potion_info_stat_bonus_runecraft));
    case slayer :
        return(struct_param($struct1, potion_info_stat_bonus_slayer));
    case smithing :
        return(struct_param($struct1, potion_info_stat_bonus_smithing));
    case strength :
        return(struct_param($struct1, potion_info_stat_bonus_strength));
    case thieving :
        return(struct_param($struct1, potion_info_stat_bonus_thieving));
    case woodcutting :
        return(struct_param($struct1, potion_info_stat_bonus_woodcutting));
}
~error("Unexpected stat in potion stat lookup");
return(0);
