// 5212
[clientscript,script5212](component $component0)
if (%jaro_reward_points = 2000) {
    if_settext("<col=ff0000><tostring(%jaro_reward_points)>/<tostring(2000)></col>", $component0);
} else {
    if_settext("<col=ff981F><tostring(%jaro_reward_points)>/<tostring(2000)></col>", $component0);
}
