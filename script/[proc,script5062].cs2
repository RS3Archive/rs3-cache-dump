// 5062
[proc,script5062](component $component0, int $int1, int $int2)
def_int $int3 = calc($int1 * 12);
if ($int2 = 1) {
    if (cc_find($component0, calc($int3 + 2)) = true) {
        cc_setgraphic("aif_button_group_2,4");
    }
    if (cc_find($component0, calc($int3 + 3)) = true) {
        cc_setgraphic("aif_button_group_2,3");
    }
    if (cc_find($component0, calc($int3 + 4)) = true) {
        cc_setgraphic("aif_button_group_2,5");
    }
} else {
    if (cc_find($component0, calc($int3 + 2)) = true) {
        cc_setgraphic("aif_button_group_2,1");
    }
    if (cc_find($component0, calc($int3 + 3)) = true) {
        cc_setgraphic("aif_button_group_2,0");
    }
    if (cc_find($component0, calc($int3 + 4)) = true) {
        cc_setgraphic("aif_button_group_2,2");
    }
}
