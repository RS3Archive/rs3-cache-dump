// 951
[proc,script951](struct $struct0, stat $stat1)(int)
switch_stat ($stat1) {
    case agility :
        return(struct_param($struct0, potion_info_stat_bonus_xp_scale_agility));
    case summoning :
        return(struct_param($struct0, potion_info_stat_bonus_xp_scale_animallore));
    case attack :
        return(struct_param($struct0, potion_info_stat_bonus_xp_scale_attack));
    case hitpoints :
        return(struct_param($struct0, potion_info_stat_bonus_xp_scale_constitution));
    case construction :
        return(struct_param($struct0, potion_info_stat_bonus_xp_scale_construction));
    case cooking :
        return(struct_param($struct0, potion_info_stat_bonus_xp_scale_cooking));
    case crafting :
        return(struct_param($struct0, potion_info_stat_bonus_xp_scale_crafting));
    case defence :
        return(struct_param($struct0, potion_info_stat_bonus_xp_scale_defence));
    case divination :
        return(struct_param($struct0, potion_info_stat_bonus_xp_scale_divination));
    case dungeoneering :
        return(struct_param($struct0, potion_info_stat_bonus_xp_scale_dungeoneering));
    case farming :
        return(struct_param($struct0, potion_info_stat_bonus_xp_scale_farming));
    case firemaking :
        return(struct_param($struct0, potion_info_stat_bonus_xp_scale_firemaking));
    case fishing :
        return(struct_param($struct0, potion_info_stat_bonus_xp_scale_fishing));
    case fletching :
        return(struct_param($struct0, potion_info_stat_bonus_xp_scale_fletching));
    case herblore :
        return(struct_param($struct0, potion_info_stat_bonus_xp_scale_herblore));
    case hunter :
        return(struct_param($struct0, potion_info_stat_bonus_xp_scale_hunter));
    case invention :
        return(struct_param($struct0, potion_info_stat_bonus_xp_scale_invention));
    case magic :
        return(struct_param($struct0, potion_info_stat_bonus_xp_scale_magic));
    case mining :
        return(struct_param($struct0, potion_info_stat_bonus_xp_scale_mining));
    case necromancy :
        return(struct_param($struct0, potion_info_stat_bonus_xp_scale_necromancy));
    case prayer :
        return(struct_param($struct0, potion_info_stat_bonus_xp_scale_prayer));
    case ranged :
        return(struct_param($struct0, potion_info_stat_bonus_xp_scale_ranged));
    case runecraft :
        return(struct_param($struct0, potion_info_stat_bonus_xp_scale_runecraft));
    case slayer :
        return(struct_param($struct0, potion_info_stat_bonus_xp_scale_slayer));
    case smithing :
        return(struct_param($struct0, potion_info_stat_bonus_xp_scale_smithing));
    case strength :
        return(struct_param($struct0, potion_info_stat_bonus_xp_scale_strength));
    case thieving :
        return(struct_param($struct0, potion_info_stat_bonus_xp_scale_thieving));
    case woodcutting :
        return(struct_param($struct0, potion_info_stat_bonus_xp_scale_woodcutting));
}
return(0);
