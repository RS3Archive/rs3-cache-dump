// 12804
[clientscript,script12804]
def_int $int0 = 0;
def_int $int1 = 0;
def_string $string0 = "Burthorpe";
$int1, $int1, $int0 = date_runeday_todate(date_runeday);
if_settext("Meet Count Check!", interface_1795:com_6);
if_settext("Count Check has recently appeared in <$string0> and he's hosting Customer Service Week <tostring($int0)>! He's got a bunch of rewards and information for you, so go visit him!", interface_1795:com_23);
if_settext("Count Check's Account Check!", interface_1795:com_24);
if_settext("Count Check is great at checking accounts. He'll tell you all about your account security. If you've got a secure enough account, he'll even give you a reward for it! Check him out!", interface_1795:com_25);
if_settext("The Drop!", interface_1795:com_26);
if_settext("The reappearance of Count Check has also brought back The Drop! Compete against other players for a title and XP lamp rewards.<br>If you complete The Drop and get every question correct, you'll be entered into a raffle too!", interface_1795:com_27);
if_settext("Customer Service Clue Scrolls!", interface_1795:com_28);
if (map_members = true) {
    if_settext("Count Check also has another trick up his sleeve: clue scrolls! Every day during Customer Service Week, you'll be able to ask him for a special Customer Service clue scroll, which will reward you with TWO caskets instead of one! However, one of these caskets is a little bit more secure than the other, so you'll need an Authenticator active AND a bank PIN in order to open it.", interface_1795:com_29);
} else {
    if_settext("Count Check also has another trick up his sleeve: clue scrolls for free players! Every day during Customer Service Week, you'll be able to ask him for a special Customer Service clue scroll, which will reward you with TWO caskets instead of one! However, one of these caskets is a little bit more secure than the other, so you'll need an Authenticator active AND a bank PIN in order to open it.", interface_1795:com_29);
}
return;
