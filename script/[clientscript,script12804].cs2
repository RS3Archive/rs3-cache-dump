// 12804
[clientscript,script12804]
def_int $int0 = 0;
def_int $int1 = 0;
def_string $string0 = "Burthorpe";
$int1, $int1, $int0 = date_runeday_todate(date_runeday);
if_settext("Meet Count Check!", cs_week_2016_seasonal:meet_count_check_title);
if_settext("Count Check has recently appeared in <$string0> and he's hosting Customer Service Week <tostring($int0)>! He's got a bunch of rewards and information for you, so go visit him!", cs_week_2016_seasonal:meet_count_check_text);
if_settext("Count Check's Account Check!", cs_week_2016_seasonal:account_check_title);
if_settext("Count Check is great at checking accounts. He'll tell you all about your account security. If you've got a secure enough account, he'll even give you a reward for it! Check him out!", cs_week_2016_seasonal:account_check_text);
if_settext("The Drop!", cs_week_2016_seasonal:the_drop_title);
if_settext("The reappearance of Count Check has also brought back The Drop! Compete against other players for a title and XP lamp rewards.<br>If you complete The Drop and get every question correct, you'll be entered into a raffle too!", cs_week_2016_seasonal:the_drop_text);
if_settext("Customer Service Clue Scrolls!", cs_week_2016_seasonal:cs_clues_title);
if (map_members = true) {
    if_settext("Count Check also has another trick up his sleeve: clue scrolls! Every day during Customer Service Week, you'll be able to ask him for a special Customer Service clue scroll, which will reward you with TWO caskets instead of one! However, one of these caskets is a little bit more secure than the other, so you'll need an Authenticator active AND a bank PIN in order to open it.", cs_week_2016_seasonal:cs_clues_text);
} else {
    if_settext("Count Check also has another trick up his sleeve: clue scrolls for free players! Every day during Customer Service Week, you'll be able to ask him for a special Customer Service clue scroll, which will reward you with TWO caskets instead of one! However, one of these caskets is a little bit more secure than the other, so you'll need an Authenticator active AND a bank PIN in order to open it.", cs_week_2016_seasonal:cs_clues_text);
}
return;
