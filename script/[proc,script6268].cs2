// 6268
[proc,script6268](quest $quest0, int $int1)(int)
if (quest_param($quest0, quest_release_number) > 0) {
    if ($int1 = 1) {
        return(calc((quest_param($quest0, quest_release_year) - 1999) * 1000 + quest_param($quest0, quest_release_number) + 1));
    } else {
        return(calc(quest_param($quest0, quest_release_number) + 1));
    }
} else if ($int1 = 1) {
    return(calc((quest_param($quest0, quest_release_year) - 1999) * 1000 + quest_param($quest0, quest_id) + 1));
} else {
    return(calc(quest_param($quest0, quest_id) + 1));
}
