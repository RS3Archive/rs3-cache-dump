// 1605
[clientscript,script1605]
if_settext("This override can be accessed from the Wardrobe tab of the Customisations interface.<br><br>Under the Wardrobe's 'Leg Items' category you will be able to select this cosmetic override, making anything you wear on your legs look like this item.<br><br>If you have claimed all the items, the armour set can also be selected from the 'Full Outfits' category.", owen1_reward_shop:info_box_text);
if_sethide(false, owen1_reward_shop:info_box_container);
