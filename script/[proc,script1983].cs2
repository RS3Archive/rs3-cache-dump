// 1983
[proc,script1983](int $int0)
$int0 = max(0, min($int0, 1));
sound_vorbis_volume(select_shop_item, 1, 0, 255);
%rand_player_tab = $int0;
if ($int0 = 0) {
    if_sethide(true, town_rewards:robber_tab_selected_layer);
    if_sethide(true, town_rewards:reward_tab_2);
    if_sethide(false, town_rewards:guards_tab_selected_layer);
    if_sethide(false, town_rewards:reward_tab_1);
    if_settext("Wins: <tostring(%town_wins)>    Reward points: <tostring(%town_reward_points)>", town_rewards:current_points_text);
    if_settext("Level: <tostring(%town_guard_level)>", town_rewards:guard_level);
} else {
    if_sethide(true, town_rewards:guards_tab_selected_layer);
    if_sethide(true, town_rewards:reward_tab_1);
    if_sethide(false, town_rewards:robber_tab_selected_layer);
    if_sethide(false, town_rewards:reward_tab_2);
    if_settext("Wins: <tostring(%town_wins)>    Reward points: <tostring(%town_reward_points)>", town_rewards:current_points_text);
    if_settext("Level: <tostring(%town_robber_level)>", town_rewards:robber_level);
}
