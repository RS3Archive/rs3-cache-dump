// 7367
[proc,script7367]
if (%pop_manager_seen_zones = 0 & if_gethide(pop_manager:zone_layer) = false) {
    if_sethide(false, pop_manager:zone_tutorial);
} else {
    if_sethide(true, pop_manager:zone_tutorial);
}
if (%pop_manager_seen_scrolls = 0 & if_gethide(pop_manager:scrolls_layer) = false) {
    if_sethide(false, pop_manager:scroll_tutorial);
} else {
    if_sethide(true, pop_manager:scroll_tutorial);
}
