if ($int2 = 0 | $dbrow3 = null) {
    ~cc_add_text($component0, if_getnextsubid($component0), 0, 5, ^setpos_abs_centre, ^setpos_abs_top, 20, 60, ^setsize_minus, ^setsize_abs, text_title_section, "Coming Soon");
