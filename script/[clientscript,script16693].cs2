    if (compare($string1, "Coming Soon") ! 0) {
        ~cc_add_text($component0, if_getnextsubid($component0), 5, 65, ^setpos_abs_centre, ^setpos_abs_top, 20, 90, ^setsize_minus, ^setsize_minus, text_body_default, $string1);
