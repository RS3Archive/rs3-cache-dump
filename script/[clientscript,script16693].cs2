if (%season2022_tier_unlocked < 0) {
    return;
}
if ($int1 > %season2022_tier_unlocked) {
    ~cc_add_text($component0, if_getnextsubid($component0), 0, 65, ^setpos_abs_centre, ^setpos_abs_top, 20, 90, ^setsize_minus, ^setsize_minus, text_body_default, "Complete the previous task to unlock this one.");
    cc_settextalign(^settextalign_centre, ^settextalign_top, 0);
    return;
}
def_int $int4 = calc(db_getfieldcount($dbrow3, season2022_task_dbtable:col3) - 1);
def_int $int5 = max(0, min(calc(%season2022_tier_unlocked - $int1), $int4));
