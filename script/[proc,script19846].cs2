// 19846
[proc,script19846](category $category0, category $category1)(int, int)
def_int $int2 = 0;
def_int $int3 = achievement_findsubcat($category0, $category1);
def_achievement $achievement4 = achievement_findnext;
while ($achievement4 ! null) {
    if (achievement_reqstate($achievement4) = -2) {
        $int2 = calc($int2 + 1);
