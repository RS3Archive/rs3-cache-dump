// 19830
[proc,script19830](achievement $achievement0)(obj)
switch_achievement ($achievement0) {
    case combat_mastery_easy :
        return(combat_mastery_amulet_easy);
    case combat_mastery_medium :
        return(combat_mastery_amulet_medium);
    case combat_mastery_hard :
        return(combat_mastery_amulet_hard);
    case combat_mastery_elite :
        return(combat_mastery_amulet_elite);
    case combat_mastery_master :
        return(combat_mastery_aura_master);
    case combat_mastery_grandmaster :
        return(combat_mastery_aura_grandmaster);
}
return(null);
