// 3439
[clientscript,script3439](int $int0, int $int1)
if ($int1 = 0) {
    if ($int0 > 150) {
        $int0 = calc($int0 - 1);
    } else {
        $int1 = 1;
    }
} else if ($int0 < 255) {
    $int0 = calc($int0 + 1);
} else {
    if_setontimer(null, tuska_effects:tuska_face_bl);
    $int1 = 1;
}
if_settrans($int0, tuska_effects:tuska_face_bl);
if_settrans($int0, tuska_effects:tuska_face_br);
if_settrans($int0, tuska_effects:tuska_face_tl);
if_settrans($int0, tuska_effects:tuska_face_tr);
if_setontimer("script3439($int0, $int1)", tuska_effects:tuska_face_bl);
