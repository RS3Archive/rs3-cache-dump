// 18937
[clientscript,script18937](component $component0, component $component1)
if_sethide(~negate_bool(if_gethide($component0)), $component0);
if_sethide(~negate_bool(if_gethide($component1)), $component1);
if (if_gethide($component1) = false) {
    ~script18938(16, 924, false);
    if_setop(1, "Close", mtx58_wealth_evaluator:bank_tab_toggle_layer);
} else {
    ~script18938(0, 0, true);
    if_setop(1, "Expand", mtx58_wealth_evaluator:bank_tab_toggle_layer);
}
