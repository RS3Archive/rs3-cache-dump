// 13775
[proc,script13775]
def_string $string0 = "The gold accumulator is currently disabled.";
if (%toolbelt_gold_acc_enabled = 1) {
    if_setgraphic("aif_tick_cross_icon,0", toolbelt_v2:gold_acc_enabled);
    $string0 = "The gold accumulator is currently enabled.";
} else {
    if_setgraphic("aif_tick_cross_icon,1", toolbelt_v2:gold_acc_enabled);
}
if_setonmouserepeat("script8799($string0, event_com, event_comsubid)", toolbelt_v2:gold_acc_enabled);
