// 21039
[proc,script21039](component $component0)
def_string $string0 = if_getop(1, $component0);
if (compare($string0, "") = 0) {
    error("Op name returned an empty string. Has the order of procs been changed? Ops should be setup first");
    return;
}
if_setonmouserepeat("script8799($string0, $component0, -1)", $component0);
