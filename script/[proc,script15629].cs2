// 15629
[proc,script15629](component $component0, component $component1, component $component2, component $component3)
if (~is_mobile_client = true) {
    if_setposition(0, 0, ^setpos_abs_left, ^setpos_abs_bottom, $component0);
    if_setposition(0, 40, ^setpos_abs_left, ^setpos_abs_top, $component1);
    if_setposition(0, 4, ^setpos_abs_centre, ^setpos_abs_bottom, $component2);
    if_setposition(0, 0, ^setpos_abs_left, ^setpos_abs_top, $component3);
} else {
    if_setposition(0, 40, ^setpos_abs_left, ^setpos_abs_top, $component0);
    if_setposition(0, 0, ^setpos_abs_left, ^setpos_abs_bottom, $component1);
    if_setposition(0, 4, ^setpos_abs_centre, ^setpos_abs_top, $component2);
    if_setposition(0, 0, ^setpos_abs_left, ^setpos_abs_bottom, $component3);
}
