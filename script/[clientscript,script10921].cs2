// 10921
[clientscript,script10921]
def_int $int0 = 0;
def_int $int1 = 0;
def_string $string0 = "";
if (calc(clientclock % 50) = 0) {
    %varclient_7416 = min(calc(%varclient_7416 + 1), calc(3600 - 1));
    $int1 = calc(%varclient_7416 / 60);
    $int0 = calc(%varclient_7416 - $int1 * 60);
    if ($int1 < 10) {
        $string0 = "0<tostring($int1)>m:";
    } else {
        $string0 = "<tostring($int1)>m:";
