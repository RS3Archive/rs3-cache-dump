// 10921
[clientscript,script10921]
def_int $int0 = 0;
def_int $int1 = 0;
def_string $string0 = "";
if (calc(clientclock % 50) = 0) {
    %elfcity_hefin_course_timer_seconds = min(calc(%elfcity_hefin_course_timer_seconds + 1), calc(3600 - 1));
    $int1 = calc(%elfcity_hefin_course_timer_seconds / 60);
    $int0 = calc(%elfcity_hefin_course_timer_seconds - $int1 * 60);
    if ($int1 < 10) {
        $string0 = "0<tostring($int1)>m:";
    } else {
        $string0 = "<tostring($int1)>m:";
    }
    if ($int0 < 10) {
        $string0 = append($string0, "0<tostring($int0)>s");
    } else {
        $string0 = append($string0, "<tostring($int0)>s");
    }
    if_settext($string0, elfcity_hefin_course_overlay:time);
} else if (%elfcity_hefin_course_timer_seconds <= 0) {
    if_settext("--m:--s", elfcity_hefin_course_overlay:time);
}
