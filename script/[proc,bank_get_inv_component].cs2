// 14074
[proc,bank_get_inv_component](inv $inv0)(component)
switch_inv ($inv0) {
    case default :
        return(bank:all);
    case inv :
        return(bank:inventory_click);
    case worn :
        return(bank:item_layer);
    case lore_bob :
        return(bank:bob_click);
    case bank :
        return(bank:bank_inv);
}
