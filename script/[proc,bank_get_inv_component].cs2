// 14074
[proc,bank_get_inv_component](inv $inv0)(component)
switch_inv ($inv0) {
    case default :
        return(interface_517:com_0);
    case inv_93 :
        return(interface_517:com_15);
    case inv_94 :
        return(interface_517:com_28);
    case inv_530 :
        return(interface_517:com_35);
    case inv_95 :
        return(interface_517:com_201);
}
