// 11246
[clientscript,script11246](component $component0, int $int1)
def_string $string0 = "No custom phrase specified.";
if ($int1 = 1) {
    if (compare(%jmod_tool_custom_chat1_client, "") ! 0) {
        $string0 = %jmod_tool_custom_chat1_client;
    }
} else if ($int1 = 2 & compare(%jmod_tool_custom_chat2_client, "") ! 0) {
    $string0 = %jmod_tool_custom_chat2_client;
