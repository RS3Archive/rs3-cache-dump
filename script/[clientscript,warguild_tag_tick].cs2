// 4043
[clientscript,warguild_tag_tick]
if (%warguild_tagged_1st = 0) {
    if_sethide(true, warguild_token_overlay:tick_1);
} else {
    if_sethide(false, warguild_token_overlay:tick_1);
}
if (%warguild_tagged_2nd = 0) {
    if_sethide(true, warguild_token_overlay:tick_2);
} else {
    if_sethide(false, warguild_token_overlay:tick_2);
}
if (%warguild_tagged_3rd = 0) {
    if_sethide(true, warguild_token_overlay:tick_3);
} else {
    if_sethide(false, warguild_token_overlay:tick_3);
}
if (%warguild_tagged_4th = 0) {
    if_sethide(true, warguild_token_overlay:tick_4);
} else {
    if_sethide(false, warguild_token_overlay:tick_4);
}
if (%warguild_tagged_5th = 0) {
    if_sethide(true, warguild_token_overlay:tick_5);
} else {
    if_sethide(false, warguild_token_overlay:tick_5);
}
