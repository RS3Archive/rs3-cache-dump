// 495
[proc,stat_bonus_xp](stat $stat0)(int)
switch_stat ($stat0) {
    case attack :
        return(%bonusxp_attack);
    case strength :
        return(%bonusxp_strength);
    case ranged :
        return(%bonusxp_ranged);
    case magic :
        return(%bonusxp_magic);
    case defence :
        return(%bonusxp_defence);
    case hitpoints :
        return(%bonusxp_hitpoints);
    case prayer :
        return(%bonusxp_prayer);
    case agility :
        return(%bonusxp_agility);
    case herblore :
        return(%bonusxp_herblore);
    case thieving :
        return(%bonusxp_thieving);
    case crafting :
        return(%bonusxp_crafting);
    case runecraft :
        return(%bonusxp_runecrafting);
    case mining :
        return(%bonusxp_mining);
    case smithing :
        return(%bonusxp_smithing);
    case fishing :
        return(%bonusxp_fishing);
    case cooking :
        return(%bonusxp_cooking);
    case firemaking :
        return(%bonusxp_firemaking);
    case woodcutting :
        return(%bonusxp_woodcutting);
    case fletching :
        return(%bonusxp_fletching);
    case slayer :
        return(%bonusxp_slayer);
    case farming :
        return(%bonusxp_farming);
    case construction :
        return(%bonusxp_construction);
    case hunter :
        return(%bonusxp_hunter);
    case summoning :
        return(%bonusxp_summoning);
    case dungeoneering :
        return(%bonusxp_dungeoneering);
    case divination :
        return(%bonusxp_divination);
    case invention :
        return(%bonusxp_invention);
    case archaeology :
        return(%bonusxp_archaeology);
    case necromancy :
        return(%bonusxp_necromancy);
}
return(0);
