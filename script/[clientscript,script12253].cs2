// 12253
[clientscript,script12253]
def_component $component0 = quest_nomel_memories:backgroundrect;
def_int $int1 = if_gettrans($component0);
if ($int1 > 2) {
    if_settrans(calc($int1 - 2), $component0);
} else if ($int1 = 2) {
    if_settrans(0, $component0);
    if_sethide(false, quest_nomel_memories:close_button);
    if_sethide(false, quest_nomel_memories:blockoutface);
    if_sethide(false, quest_nomel_memories:background_model);
    if_setontimer("script12255(quest_nomel_memories:memory_text1)", quest_nomel_memories:memory_text1);
    if_setontimer("script12254(quest_nomel_memories:blockoutface)", quest_nomel_memories:blockoutface);
}
