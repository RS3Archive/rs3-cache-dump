[proc,skilltotal_actual]()(int)
def_int $int0 = 0;
def_int $int1 = 0;
def_int $int2 = 0;
while ($int0 < enum_getoutputcount(stat_autoint_to_int)) {
    $int2 = enum(int, int, stat_autoint_to_int, $int0);
    $int1 = calc($int1 + stat_base_actual(enum(int, stat, int_to_stat, $int2)));
    $int0 = calc($int0 + 1);
}
return($int1);
