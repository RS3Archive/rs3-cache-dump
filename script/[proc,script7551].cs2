// 7551
[proc,script7551](component $component0)(component)
switch_component ($component0) {
    case wof33_valentines_shop:love_pendant_button :
        return(wof33_valentines_shop:lp_rollover);
    case wof33_valentines_shop:love_weapon_button :
        return(wof33_valentines_shop:lw_rollover);
    case wof33_valentines_shop:love_emote_button :
        return(wof33_valentines_shop:le_rollover);
    case wof33_valentines_shop:hate_pendant_button :
        return(wof33_valentines_shop:hp_rollover);
    case wof33_valentines_shop:hate_weapon_button :
        return(wof33_valentines_shop:hw_rollover);
    case wof33_valentines_shop:hate_emote_button :
        return(wof33_valentines_shop:he_rollover);
    case wof33_valentines_shop:random_choccy_button :
        return(wof33_valentines_shop:rc_rollover);
    case wof33_valentines_shop:confirm_button :
        return(wof33_valentines_shop:confirm_rollover);
    case wof33_valentines_shop:cancel_button :
        return(wof33_valentines_shop:cancel_rollover);
}
