// 9898
[proc,script9898](int $int0)
%runepass_previous_task_view_index = max(%runepass_previous_task_view_index, 0);
if (cc_find(runepass:reward_build, calc(%runepass_previous_task_view_index * 11)) = true) {
    cc_setgraphic(prize_windows_default);
}
if (cc_find(runepass:build, calc(%runepass_previous_task_view_index * 2)) = true) {
    cc_setgraphic(rp_node_default);
}
if (cc_find(runepass:reward_build, calc($int0 * 11)) = true) {
    cc_setgraphic(prize_windows_selected);
}
if (cc_find(runepass:build, calc($int0 * 2)) = true) {
    cc_setgraphic(rp_node_active);
}
%runepass_previous_task_view_index = $int0;
