// 5424
[clientscript,script5424]
if_sethide(false, dom_battle_overlay:easter_egg_notification_layer);
if_setontimer("script5425", dom_battle_overlay:global_layer);
%dom_easter_xpos = -60;
if_setposition(%dom_easter_xpos, 0, ^setpos_abs_left, ^setpos_abs_centre, dom_battle_overlay:easter_egg_notification_layer);
