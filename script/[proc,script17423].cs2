// 17423
[proc,script17423](obj $obj0)(boolean)
if (%wisdom_of_anima_enabled = 1 & ~script15809(23) >= 3 & %wisdom_of_anima_in_rangers_workroom_area = 1) {
    switch_obj ($obj0) {
        case dinarrow_bik :
            return(~int_to_bool(%wisdom_of_anima_unlocked_bik));
        case dinarrow_wen :
            return(~int_to_bool(%wisdom_of_anima_unlocked_wen));
        case dinarrow_ful :
            return(~int_to_bool(%wisdom_of_anima_unlocked_ful));
        case dinarrow_jas_dragonbane, dinarrow_jas_demonbane :
            return(~int_to_bool(%wisdom_of_anima_unlocked_jas));
        case default :
            return(false);
    }
}
return(false);
