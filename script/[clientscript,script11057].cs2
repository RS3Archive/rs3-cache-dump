// 11057
[clientscript,script11057]
if (struct_param(%boss_instance_struct, boss_instance_change_spawn_speed) = false) {
    if_settext("Standard", boss_instance:spawnspeed_text);
    return;
}
switch_int (%boss_instance_setup_spawnspeed_temp) {
    case 0 :
        if_settext("Standard", boss_instance:spawnspeed_text);
    case 1 :
        if_settext("Fast", boss_instance:spawnspeed_text);
    case 2 :
        if_settext("Fastest", boss_instance:spawnspeed_text);
}
