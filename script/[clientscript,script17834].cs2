// 17834
[clientscript,script17834](achievement $achievement0, obj $obj1)
if_sethide(false, area_task_sub:popup_window);
if_settext(~oc_name($obj1), area_task_sub:more_information_name);
if_setobject_nonum($obj1, 1, area_task_sub:more_information_icon_graphic);
def_string $string0 = "<~achievement_description($achievement0)><br><br>Reward:<br><~script19862($achievement0)>";
if_settext($string0, area_task_sub:more_information_summary);
def_int $int2 = calc(16 * paraheight($string0, if_getwidth(area_task_sub:more_information_summary), notosans_12));
if_setscrollsize(0, $int2, area_task_sub:more_information_summary_layer);
if_setscrollpos(0, 0, area_task_sub:more_information_summary_layer);
~rs3_scrollbar_vertical(area_task_sub:more_information_scrollbar_layer, area_task_sub:more_information_summary_layer);
