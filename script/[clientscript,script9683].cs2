// 9683
[clientscript,script9683](component $component0, int $int1)
if ($int1 <= 0) {
    if_setmodelanim(null, $component0);
    if_setmodelanim(trh_chest_closed_idle, $component0);
    if_setontimer(null, $component0);
} else {
    $int1 = calc($int1 - 1);
    if ($component0 = trh45_overlay:chest_model_6 & %trh45_letter_count >= 5 & if_gethide(trh45_overlay:crate_graphics_layer) = true) {
        if_sethide(false, trh45_overlay:crate_graphics_layer);
    }
    if_setontimer("script9683($component0, $int1)", $component0);
}
