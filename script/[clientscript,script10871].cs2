// 10871
[clientscript,script10871]
def_int $int0 = calc(10 - %xmas2014_snowboard_grind_power);
def_int $int1 = calc(25486 + scale(14563, 10, $int0));
if (if_get2dangle(xmas2014_grind_balance:balance_pointer) < $int1) {
    if_set2dangle(calc(if_get2dangle(xmas2014_grind_balance:balance_pointer) + 200), xmas2014_grind_balance:balance_pointer);
} else if (if_get2dangle(xmas2014_grind_balance:balance_pointer) > $int1) {
    if_set2dangle(calc(if_get2dangle(xmas2014_grind_balance:balance_pointer) - 200), xmas2014_grind_balance:balance_pointer);
}
switch_int (%xmas2014_snowboard_grind_power) {
    case 0, 10 :
        if_setcolour(^red, xmas2014_grind_balance:balance_border_ring);
        sound_vorbis_rate(drop_glass, 1, 0, 70, 300);
    case 1, 9 :
        if_setcolour(0xff4b00, xmas2014_grind_balance:balance_border_ring);
        sound_vorbis_rate(drop_glass, 1, 0, 60, 280);
    case 2, 8 :
        if_setcolour(0xff9600, xmas2014_grind_balance:balance_border_ring);
        sound_vorbis_rate(drop_glass, 1, 0, 50, 265);
    case 3, 7 :
        if_setcolour(0xc89600, xmas2014_grind_balance:balance_border_ring);
        sound_vorbis_rate(drop_glass, 1, 0, 40, 256);
    case 4, 6 :
        if_setcolour(0x96c800, xmas2014_grind_balance:balance_border_ring);
        sound_vorbis_rate(drop_glass, 1, 0, 30, 250);
    case 5 :
        if_setcolour(0x64ff64, xmas2014_grind_balance:balance_border_ring);
}
