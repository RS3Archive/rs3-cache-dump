// 19675
[proc,script19675]()(string)
def_int $int0 = 5;
def_int $int1 = 3;
def_int $int2 = 1;
def_int $int3 = 10;
if (stat_base(woodcutting) >= struct_param(skillguide_woodcutting_weakside_chopping_improvements, skillguide_level)) {
    $int0 = calc($int0 + 1);
    $int1 = calc($int1 + 1);
    $int2 = calc($int2 + 1);
    $int3 = calc($int3 + 1);
}
return("- <tostring($int0)>% XP when a log is obtained (for only 1 of the logs if multiple are obtained).<br>- <tostring($int1)>% chance to obtain Bird's Nests.<br>- <tostring($int2)>% chance to obtain Enchanted Bird's Nests.<br>- <tostring($int3)>% chance to perform a 'Perfect Cut'.");
