// 6651
[clientscript,script6651](component $component0)
switch_component ($component0) {
    case clav_customise:head_button :
        %clav_current_part_customise_varp = 1;
    case clav_customise:torso_button :
        %clav_current_part_customise_varp = 2;
    case clav_customise:upper_arm_right_button :
        %clav_current_part_customise_varp = 4;
    case clav_customise:arm_connect_right_button :
        %clav_current_part_customise_varp = 6;
    case clav_customise:lower_arm_right_button :
        %clav_current_part_customise_varp = 8;
    case clav_customise:upper_arm_left_button :
        %clav_current_part_customise_varp = 5;
    case clav_customise:arm_connect_left_button :
        %clav_current_part_customise_varp = 7;
    case clav_customise:lower_arm_left_button :
        %clav_current_part_customise_varp = 9;
    case clav_customise:bottom_button :
        %clav_current_part_customise_varp = 3;
}
~script6652($component0);
