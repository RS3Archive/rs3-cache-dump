// 10698
[clientscript,script10698](int $int0, string $string0, int $int1, int $int2)
def_int $int3 = 0;
if (calc($int1 % 50) = 0) {
    if (%divdnd_cres_countdown > clientclock) {
        $int3 = calc(%divdnd_cres_countdown - clientclock);
        $int3 = calc($int3 / 50);
        if_settext(append($string0, tostring($int3)), divdnd_overlay:cres_cooldown);
    } else {
        if_setontimer(null, divdnd_overlay_timer:timer_cres);
        if ($int0 = 1) {
            if_settext("", divdnd_overlay:cres_cooldown);
            return;
        } else {
            if_settext("Cres statue cooldown: Ready", divdnd_overlay:cres_cooldown);
        }
        return;
    }
}
$int1 = calc($int1 + 1);
if_setontimer("script10698($int0, $string0, $int1, $int2)", divdnd_overlay_timer:timer_cres);
