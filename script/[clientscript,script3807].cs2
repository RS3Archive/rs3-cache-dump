// 3807
[clientscript,script3807]
if (%atlum_day_tracker > 8701) {
    if_settext("No free keys available", xmas2019_advent:free_key_text);
    return;
}
if (%trh164_claimed_on_day = 1) {
    if_settext("Free key claimed", xmas2019_advent:free_key_text);
} else {
    if_settext("Free key available", xmas2019_advent:free_key_text);
}
