// 8278
[clientscript,script8278](component $component0, component $component1)
if_settext("<tostring(%cheevo_completed_achievements)> / <tostring(%cheevo_max_achievements)>", $component0);
if (%cheevo_completed_achievements > 0) {
    if_setsize(scale(%cheevo_completed_achievements, %cheevo_max_achievements, 16384), 0, ^setsize_rel, ^setsize_minus, $component1);
} else {
    if_setsize(0, 0, ^setsize_rel, ^setsize_minus, $component1);
}
