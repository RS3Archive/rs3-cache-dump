// 13783
[proc,script13783]()(string)
if (%raid1_goebie_courier_loot_handed_in_today = 10) {
    return("You have already handed enough supplies for today.");
} else {
    return("You can still hand in another <tostring(calc(10 - %raid1_goebie_courier_loot_handed_in_today))> <~text_plural(calc(10 - %raid1_goebie_courier_loot_handed_in_today), "resource", "resources")> today.");
}
