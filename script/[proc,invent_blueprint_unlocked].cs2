// 12059
[proc,invent_blueprint_unlocked](int $int0)(int)
if ($int0 < 0) {
    return(1);
}
switch_int (calc($int0 / 32)) {
    case 0 :
        return(testbit(%invent_blueprint_unlocked_0, calc($int0 % 32)));
    case 1 :
        return(testbit(%invent_blueprint_unlocked_1, calc($int0 % 32)));
    case 2 :
        return(testbit(%invent_blueprint_unlocked_2, calc($int0 % 32)));
    case 3 :
        return(testbit(%invent_blueprint_unlocked_3, calc($int0 % 32)));
    case 4 :
        return(testbit(%invent_blueprint_unlocked_4, calc($int0 % 32)));
    case 5 :
        return(testbit(%invent_blueprint_unlocked_5, calc($int0 % 32)));
    case default :
        ~error("Blueprint ID: <tostring(calc($int0 / 32))> is out of bounds - need to add new %invent_blueprint_unlocked_X var");
        return(0);
}
