// 2724
[clientscript,script2724](component $component0)
def_int $int1 = 0;
def_int $int2 = 0;
def_string $string0 = "";
switch_component ($component0) {
    case div_map:colony1 :
        $int1 = 1;
        $int2 = 1;
    case div_map:colony2 :
        $int1 = 2;
        $int2 = 10;
    case div_map:colony3 :
        $int1 = 3;
        $int2 = 20;
    case div_map:colony4 :
        $int1 = 4;
        $int2 = 30;
    case div_map:colony5 :
        $int1 = 5;
        $int2 = 40;
    case div_map:colony6 :
        $int1 = 6;
        $int2 = 50;
    case div_map:colony7 :
        $int1 = 7;
        $int2 = 60;
    case div_map:colony8 :
        $int1 = 8;
        $int2 = 70;
    case div_map:colony9 :
        $int1 = 9;
        $int2 = 80;
    case div_map:colony10 :
        $int1 = 10;
        $int2 = 85;
    case div_map:colony11 :
        $int1 = 11;
        $int2 = 90;
    case div_map:colony12 :
        $int1 = 12;
        $int2 = 95;
}
~div_map_mouseleave($component0);
if_settext(enum(int, string, div_tier_to_name, $int1), div_map:moreinfo_title);
if (stat_base(divination) < $int2) {
    $string0 = "<col=B52912>You cannot yet use this colony.</col><br>";
}
$string0 = append($string0, enum(int, string, div_tier_to_location, $int1));
if_settext($string0, div_map:moreinfo_desc);
if_sethide(false, div_map:moreinfo_base);
sound_vorbis_volume(tli_click_01, 1, 0, 120);
if_sethide(false, div_map:block_layer);
