// 10962
[proc,script10962]
def_string $string0 = "Unlocked!";
if (~ironman_mode = true) {
    $string0 = "Passed";
}
def_int $int0 = if_getheight(trh44_valentines15_milestones:love_fill);
if ($int0 >= 35) {
    if_settext($string0, trh44_valentines15_milestones:love_low_cost);
    if_sethide(false, trh44_valentines15_milestones:love_low_highlight);
}
if ($int0 >= 105) {
    if_settext($string0, trh44_valentines15_milestones:love_med_cost);
    if_sethide(false, trh44_valentines15_milestones:love_med_highlight);
}
if ($int0 >= 225) {
    if_settext("Unlocked!", trh44_valentines15_milestones:love_high_cost);
    if_sethide(false, trh44_valentines15_milestones:love_high_highlight);
}
if ($int0 >= 325) {
    if_settext("Unlocked!", trh44_valentines15_milestones:love_absurd_cost);
    if_sethide(false, trh44_valentines15_milestones:love_absurd_highlight);
}
if ($int0 >= 398) {
    if_sethide(false, trh44_valentines15_milestones:bubbles);
}
if ($int0 >= 398 & if_getheight(trh44_valentines15_milestones:hate_fill) >= 398) {
    if_settext("Unlocked!", trh44_valentines15_milestones:insane_cost);
    if_sethide(false, trh44_valentines15_milestones:insane_highlight);
}
return;
