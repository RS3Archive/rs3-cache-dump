[proc,script14579](dbrow $dbrow0)(int)
def_int $int1 = 0;
switch_int (%arch_precision_base_upgrade) {
    case 1 :
        if (playermember = true) {
            $int1 = 2;
        }
    case 2 :
        if (playermember = true) {
            $int1 = 4;
        }
    case 3 :
        if (playermember = true) {
            $int1 = 6;
        }
    case 4 :
        if (playermember = true) {
            $int1 = 8;
        }
}
return(calc(db_getfield($dbrow0, arch_tool_stats:col0, 0) + $int1));
