// 6931
[clientscript,script6931](component $component0, int $int1)
def_int $int2 = calc(clientclock - ~script6932($component0));
if ($int2 >= 255 | $int2 < 0) {
    if (.cc_find($component0, $int1) = true) {
        .cc_sethide(true);
    }
    return;
}
if (.cc_find($component0, $int1) = true) {
    .cc_sethide(false);
    if (calc($int2 % 40) > 20) {
        .cc_settrans(255);
    } else {
        .cc_settrans($int2);
    }
}
