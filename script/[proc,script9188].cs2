// 9188
[proc,script9188]
if (%dndtracker_always_switch_world = 1) {
    if_sethide(true, minigames_main:checkbox_deselected_layer);
    if_sethide(false, minigames_main:checkbox_selected_layer);
    if_sethide(true, minigames_main:checkbox_deselected_layer_1);
    if_sethide(false, minigames_main:checkbox_selected_layer_1);
} else {
    if_sethide(false, minigames_main:checkbox_deselected_layer);
    if_sethide(true, minigames_main:checkbox_selected_layer);
    if_sethide(false, minigames_main:checkbox_deselected_layer_1);
    if_sethide(true, minigames_main:checkbox_selected_layer_1);
}
