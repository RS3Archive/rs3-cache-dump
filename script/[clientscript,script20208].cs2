// 20208
[clientscript,script20208]
cc_deleteall(league_onboarding:contents_splash_scrolling);
cc_deleteall(league_onboarding:contents_linking_l_scrolling);
cc_deleteall(league_onboarding:contents_linking_l_scrolling);
cc_deleteall(league_onboarding:contents_linking_r_scrolling);
cc_deleteall(league_onboarding:contents_linking_r_scrolling);
cc_deleteall(league_onboarding:contents_confirm_fixed);
if (~script6431 = true) {
    if_setsize(800, 0, ^setsize_abs, ^setsize_minus, league_onboarding:window_size);
} else {
    if_setsize(800, 600, ^setsize_abs, ^setsize_abs, league_onboarding:window_size);
}
if_setsize(500, 456, ^setsize_abs, ^setsize_aspect, league_onboarding:logo_wrapper);
if_sethide(false, league_onboarding:flash);
if_settrans(0, league_onboarding:flash);
if_settrans(255, league_onboarding:logo);
if_settrans(255, league_onboarding:logo_bg);
if_settrans(255, league_onboarding:subheader_text);
if_setgraphic(league_logo_500x456, league_onboarding:logo);
~script20220(255);
~script20221(255);
%league_onboarding_step = 0;
~script20211(1);
if_setontimer("script20212(clientclock)", league_onboarding:anim_listener);
if_settext("Nominate this Account", league_onboarding:linking_main);
if_settext("Nominate another Account", league_onboarding:linking_alt);
if_settext("Confirm this Account", league_onboarding:confirm_link_main);
if_settext("Confirm Nomination", league_onboarding:confirm_link_alt);
~script20209(0, "You can switch between the League and RuneScape at any time by switching worlds.");
