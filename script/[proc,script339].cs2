// 339
[proc,script339](struct $struct0, int $int1)(int)
if (inv_getobj(worn, 3) = rcsiphonxp_charged_greater_runic_staff | inv_getobj(worn, 3) = rcsiphonxp_charged_runic_staff) {
    if (%rcsiphonxp_staff_spellbook_client ! $int1) {
        return(0);
    }
    if (%rcsiphonxp_staff_spell_client ! struct_param($struct0, combatv2_runic_staff_int_id)) {
        return(0);
    }
    return(%rcsiphonxp_staff_charges_client);
} else {
    return(0);
}
