// 18122
[proc,script18122]
if_sethide(true, interface_891:com_14);
if (%varplayerbit_51272 = 1) {
    if_sethide(true, interface_891:com_11);
    if_sethide(false, interface_891:com_25);
} else {
    switch_int (%varplayerbit_51273) {
        case 0 :
            if_settext("You do not have enough RuneCoins.", interface_891:com_11);
        case 2 :
            if (%varplayer_5148 = null) {
                ~error("Couldn't set the correct Oddments currency name when telling players they don't have enough of it, because %rewardshop_struct was null.");
                if_settext("You cannot afford this item.", interface_891:com_11);
            } else {
                if_settext("You do not have enough <~script17844(%varplayer_5148, 1)>.", interface_891:com_11);
            }
    }
    if_sethide(false, interface_891:com_11);
    if_sethide(true, interface_891:com_25);
}
