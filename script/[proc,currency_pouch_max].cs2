// 3517
[proc,currency_pouch_max](dbrow $dbrow0)(int)
switch_dbrow ($dbrow0) {
    case currency_arc_supplies :
        return(enum(int, int, elr1_supplies_cap_increase, %elr1_supplies_cap_increase));
    case currency_hanky_points :
        return(calc(4 * (10 + stat_base(thieving) / 9)));
    case default :
        return(db_getfield($dbrow0, currency_table:col2, 0));
}
