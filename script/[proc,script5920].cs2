// 5920
[proc,script5920]
def_int $int0 = if_getheight(peng_emote:emote_default);
if_setscrollsize(0, 405, peng_emote:emote_scroll);
~rs3_scrollbar_vertical(peng_emote:emote_scrollbar, peng_emote:emote_scroll);
if ($int0 >= 405) {
    if_setsize(0, 0, ^setsize_minus, ^setsize_minus, peng_emote:emote_scroll);
    if_sethide(true, peng_emote:emote_scrollbar);
} else {
    if_sethide(false, peng_emote:emote_scrollbar);
    if_setsize(20, 0, ^setsize_minus, ^setsize_minus, peng_emote:emote_scroll);
}
