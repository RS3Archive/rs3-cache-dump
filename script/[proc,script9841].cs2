// 9841
[proc,script9841](int $int0)
if (%rhino_client_question = null) {
    return;
}
def_int $int1 = struct_param(%rhino_client_question, rhino_correct_answer);
def_string $string0 = "";
switch_int ($int0) {
    case 0 :
        $string0 = struct_param(%rhino_client_question, rhino_answer_1);
    case 1 :
        $string0 = struct_param(%rhino_client_question, rhino_answer_2);
