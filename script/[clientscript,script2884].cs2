// 2884
[clientscript,script2884](component $component0)
if (%music_v3_protect = 1 | %cutscene_status = 1) {
    return;
}
if (%playlist_random = 0) {
    if (if_getgraphic($component0) ! "aif_shuffle_button,3") {
        if_setgraphic("aif_shuffle_button,3", $component0);
    }
    ~script8800("Shuffle on", $component0, -1);
} else {
    if (if_getgraphic($component0) ! "aif_shuffle_button,1") {
        if_setgraphic("aif_shuffle_button,1", $component0);
    }
    ~script8800("Shuffle off", $component0, -1);
}
