// 12611
[proc,script12611](component $component0)(struct)
~script12610;
def_struct $struct1 = null;
def_component $component2 = $component0;
while (if_getlayer($component2) ! null) {
    $component2 = if_getlayer($component2);
}
if (if_find($component2) = true) {
    $struct1 = cc_param(toplevel_v2_window_data);
}
if ($struct1 ! null) {
    return($struct1);
}
$component2 = if_getparentlayer($component2);
if ($component2 ! null & if_find($component2) = true) {
    $struct1 = cc_param(toplevel_v2_window_data);
}
return($struct1);
