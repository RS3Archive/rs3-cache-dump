    case mom2_looting_spade, leaflet_dropper_flyer :
        return("You have completed Missing My Mummy and no longer need this item.");
    case dwarf_library_book :
        return("You've used the book, you now don't have any need for this.");
    case glo3_blue_almond, glo3_blue_circle, glo3_blue_hexagon, glo3_blue_pentagon, glo3_blue_square, glo3_blue_triangle, glo3_green_almond, glo3_green_circle, glo3_green_hexagon, glo3_green_pentagon, glo3_green_square, glo3_green_triangle, glo3_indigo_almond, glo3_indigo_circle, glo3_indigo_hexagon, glo3_indigo_pentagon, glo3_indigo_square, glo3_indigo_triangle, glo3_orange_almond, glo3_orange_circle, glo3_orange_hexagon, glo3_orange_pentagon, glo3_orange_square, glo3_orange_triangle, glo3_red_almond, glo3_red_circle, glo3_red_hexagon, glo3_red_pentagon, glo3_red_square, glo3_red_triangle, glo3_violet_almond, glo3_violet_circle, glo3_violet_hexagon, glo3_violet_pentagon, glo3_violet_square, glo3_violet_triangle, glo3_yellow_almond, glo3_yellow_circle, glo3_yellow_hexagon, glo3_yellow_pentagon, glo3_yellow_square, glo3_yellow_triangle :
