// 20008
[proc,script20008]()(enum)
switch_int (~date_runeday) {
    case 8525, 8526 :
        return(trh_choosedays_promos_week_1);
    case 8532, 8533 :
        return(trh_choosedays_promos_week_2);
    case 8539, 8540 :
        return(trh_choosedays_promos_week_3);
    case 8546, 8547 :
        return(trh_choosedays_promos_week_4);
    case 8553, 8554 :
        return(trh_choosedays_promos_week_5);
    case default :
