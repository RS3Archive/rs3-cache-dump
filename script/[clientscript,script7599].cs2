// 7599
[clientscript,script7599](component $component0, stat $stat1)
if (map_members = false) {
    if (enum_hasoutput(stat, stat_p2p_list, $stat1) = true) {
        if_setgraphic("stats_background_members_button,1", $component0);
    } else {
        if_setgraphic("stats_background_button,1", $component0);
    }
} else {
    if_setgraphic("stats_background_button,1", $component0);
}
