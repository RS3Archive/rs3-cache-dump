// 20016
[proc,trh210_get_rarity_slot_component](int $int0)(component)
switch_int ($int0) {
    case 1 :
        return(trh210_overlay:rarity_1);
    case 2 :
        return(trh210_overlay:rarity_2);
    case 3 :
        return(trh210_overlay:rarity_3);
    case 4 :
        return(trh210_overlay:rarity_4);
    case 5 :
        return(trh210_overlay:rarity_5);
    case 6 :
        return(trh210_overlay:rarity_6);
    case 7 :
        return(trh210_overlay:rarity_7);
    case 8 :
        return(trh210_overlay:rarity_8);
    case default :
        ~error("No entry for rarity slot <tostring($int0)> in trh210_get_rarity_slot_component.");
}
return(null);
