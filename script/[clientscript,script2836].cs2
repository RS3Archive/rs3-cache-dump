// 2836
[clientscript,script2836]
switch_int (++%nom_spline_step) {
    case default :
        if_setoncamfinished("script2836", nom_cutscene_controller:cutscene_controller);
        cam_movealong(0, %nom_spline_step, 400, 400, 1, %nom_spline_step);
    case 2 :
        if_setoncamfinished("script2836", nom_cutscene_controller:cutscene_controller);
        cam_movealong(0, %nom_spline_step, 400, 0, 1, %nom_spline_step);
    case 3 :
        if_setoncamfinished(null, nom_cutscene_controller:cutscene_controller);
}
