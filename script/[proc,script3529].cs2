// 3529
[proc,script3529](dbrow $dbrow0, int $int1)(component, component)
def_component $component2 = null;
def_component $component3 = null;
switch_dbrow ($dbrow0) {
    case mtx_front_end_info :
        switch_int ($int1) {
            case 0 :
                $component2 = mtx_front_end_spotlight:logout_warning_holder;
                $component3 = mtx_front_end_spotlight:logout_warning_fake_op_layer;
            case 2, 6, 7, 9, 1 :
                $component2 = mtx_front_end_oddments:logout_warning_holder;
                $component3 = mtx_front_end_oddments:logout_warning_fake_op_layer;
            case 3 :
                $component2 = mtx_front_end_bonds:logout_warning_holder;
                $component3 = mtx_front_end_bonds:logout_warning_fake_op_layer;
            case 4 :
            case 5 :
                $component2 = mtx_front_end_pc_currencies:logout_warning_holder;
                $component3 = mtx_front_end_pc_currencies:logout_warning_fake_op_layer;
        }
    case mtx_bp3 :
        switch_int ($int1) {
            case 0 :
                $component2 = bp3_track_tab:logout_warning_holder;
                $component3 = bp3_track_tab:logout_warning_fake_op_layer;
            case 1 :
                $component2 = bp3_missions_tab:logout_warning_holder;
                $component3 = bp3_missions_tab:logout_warning_fake_op_layer;
            case 2 :
                $component2 = mtx_front_end_oddments:logout_warning_holder;
                $component3 = mtx_front_end_oddments:logout_warning_fake_op_layer;
            case 3 :
                $component2 = bp3_buffs_tab:logout_warning_holder;
                $component3 = bp3_buffs_tab:logout_warning_fake_op_layer;
        }
}
return($component2, $component3);
