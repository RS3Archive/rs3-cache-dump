// 3001
[proc,script3001]
def_string $string0 = "";
def_string $string1 = "";
def_string $string2 = "";
def_boolean $boolean0 = false;
def_int $int1 = 0;
def_int $int2 = 0;
def_int $int3 = 0;
$int1, $int2, $boolean0 = userdetail_lobby_membership;
if ($boolean0 = false) {
    if (playermember = true) {
        $int3 = calc($int2 / 1440);
        if_settext("Member", lobbyscreen_mobile_billing_info:members_type);
        if ($int3 = 0) {
