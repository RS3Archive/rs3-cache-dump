// 14997
[clientscript,trh62_interface_update]
~script14998;
switch_int (%trh62_chest_id) {
    case 5 :
        if_setgraphic(trh62_multiplier_single_x2_active, trh62:multiplier_single_x2);
        if_sethide(false, trh62:multiplier_single_x2_glow);
    case 6 :
        if_setgraphic(trh62_multiplier_single_x3_active, trh62:multiplier_single_x3);
        if_sethide(false, trh62:multiplier_single_x3_glow);
    case 7 :
        if_setgraphic(trh62_multiplier_single_x4_active, trh62:multiplier_single_x4);
        if_sethide(false, trh62:multiplier_single_x4_glow);
    case 8 :
        if_setgraphic(trh62_multiplier_single_x5_active, trh62:multiplier_single_x5);
        if_sethide(false, trh62:multiplier_single_x5_glow);
    case 9 :
        if_setgraphic(trh62_multiplier_single_x4_active, trh62:multiplier_single_x4);
        if_sethide(false, trh62:multiplier_single_x4_glow);
    case 10 :
        if_setgraphic(trh62_multiplier_double_x6_active, trh62:multiplier_double_x6);
        if_sethide(false, trh62:multiplier_double_x6_glow);
    case 11 :
        if_setgraphic(trh62_multiplier_double_x8_active, trh62:multiplier_double_x8);
        if_sethide(false, trh62:multiplier_double_x8_glow);
    case 12 :
        if_setgraphic(trh62_multiplier_double_x10_active, trh62:multiplier_double_x10);
        if_sethide(false, trh62:multiplier_double_x10_glow);
}
~trh62_chest_setup;
