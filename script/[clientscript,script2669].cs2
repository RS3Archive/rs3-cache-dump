[clientscript,script2669]
switch_int (%mah3_bigbarrel) {
    case 0 :
        if_setmodel(mah3_base_numberdial_00, mah3_base_decoder_panel2:number_dial_0);
    case 1 :
        if_setmodel(mah3_base_numberdial_01, mah3_base_decoder_panel2:number_dial_0);
    case 2 :
        if_setmodel(mah3_base_numberdial_02, mah3_base_decoder_panel2:number_dial_0);
    case 3 :
        if_setmodel(mah3_base_numberdial_03, mah3_base_decoder_panel2:number_dial_0);
    case 4 :
        if_setmodel(mah3_base_numberdial_04, mah3_base_decoder_panel2:number_dial_0);
    case 5 :
        if_setmodel(mah3_base_numberdial_05, mah3_base_decoder_panel2:number_dial_0);
    case 6 :
        if_setmodel(mah3_base_numberdial_06, mah3_base_decoder_panel2:number_dial_0);
    case 7 :
        if_setmodel(mah3_base_numberdial_07, mah3_base_decoder_panel2:number_dial_0);
    case 8 :
        if_setmodel(mah3_base_numberdial_08, mah3_base_decoder_panel2:number_dial_0);
    case 9 :
        if_setmodel(mah3_base_numberdial_09, mah3_base_decoder_panel2:number_dial_0);
}
