// 6094
[proc,shop_clear_highlights]
def_component $component0 = shop_main:list_background;
def_graphic $graphic1 = "rs3_btn_icon_38px,0";
if (%shop_verbose_mode = 1) {
    $graphic1 = "rs3_btn_icon_38px,0";
}
def_int $int2 = 0;
while ($int2 < 40) {
    if (cc_find($component0, $int2) = true) {
        cc_setgraphic($graphic1);
        cc_setonmouseover("shop_item_hover(%shop_verbose_mode, 0, 1, event_com, event_comsubid)");
        cc_setonmouseleave("shop_item_hover(%shop_verbose_mode, 0, 0, event_com, event_comsubid)");
    }
    $int2 = calc($int2 + 1);
}
$int2 = 0;
$component0 = shop_main:free_background;
while ($int2 < 40) {
    if (cc_find($component0, $int2) = true) {
        cc_setgraphic($graphic1);
        cc_setonmouseover("shop_item_hover(%shop_verbose_mode, 0, 1, event_com, event_comsubid)");
        cc_setonmouseleave("shop_item_hover(%shop_verbose_mode, 0, 0, event_com, event_comsubid)");
    }
    $int2 = calc($int2 + 1);
}
