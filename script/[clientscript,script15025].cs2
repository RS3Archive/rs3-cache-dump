// 15025
[clientscript,script15025]
if (~script4682 = -1 | %stock_buyscreen_viewmode = 1 & ~script15010 = 1) {
    ~script1296("You do not have any offer slots available to make a new purchase.");
} else {
    %p_dialog_input = "";
    %stock_search_save = "";
    ~stockmarket_search_close;
    ~toplevel_v2_tab_click(struct_param(toplevel_v2_window_data_parent, toplevel_v2_window_tabs_layer), calc(1 - 1));
}
