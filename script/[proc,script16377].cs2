// 16377
[proc,script16377](obj $obj0)(int)
switch_obj ($obj0) {
    case amulet_of_ghostspeak :
        return(1);
    case mm_amulet_of_monkey_speak :
        return(1);
    case camulet :
        return(%cramulet_has_camulet);
    case ics_little_amulet_of_catspeak, twocats_amuletofcatspeak :
        if ($obj0 = ics_little_amulet_of_catspeak & %cramulet_has_catspeak = 1 & %cramulet_has_catspeak_enchanted = 1) {
            return(0);
        } else if ($obj0 = ics_little_amulet_of_catspeak) {
            return(%cramulet_has_catspeak);
        } else if ($obj0 = twocats_amuletofcatspeak) {
            return(%cramulet_has_catspeak_enchanted);
        }
    case peng_bttf_amulet :
        return(%cramulet_has_crocspeak);
    case gower_cabbagespeak_amulet :
        return(%cramulet_has_cabbagespeak);
    case crabulet :
        return(%cramulet_has_crabulet);
    case default :
        return(0);
}
