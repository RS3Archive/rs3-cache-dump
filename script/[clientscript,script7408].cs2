// 7408
[clientscript,script7408]
if (%mtx_pet_hunt_coins = 0) {
    if_sethide(false, pet_hunt:coins_checkbox_selected_layer);
    if_sethide(true, pet_hunt:coins_checkbox_deselected_layer);
} else {
    if_sethide(true, pet_hunt:coins_checkbox_selected_layer);
    if_sethide(false, pet_hunt:coins_checkbox_deselected_layer);
}
