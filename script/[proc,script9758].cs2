// 9758
[proc,script9758](component $component0)
def_int $int1 = 0;
def_int $int2 = 100;
switch_component ($component0) {
    case interface_903:com_20 :
        $int1 = %varplayerbit_459;
        $int2 = %varplayerbit_451;
    case interface_903:com_30 :
        $int1 = %varplayerbit_460;
        $int2 = %varplayerbit_452;
    case interface_903:com_40 :
        $int1 = %varplayerbit_461;
        $int2 = %varplayerbit_453;
    case interface_903:com_50 :
        $int1 = %varplayerbit_462;
        $int2 = %varplayerbit_454;
    case interface_903:com_60 :
        $int1 = %varplayerbit_463;
        $int2 = %varplayerbit_455;
    case interface_903:com_70 :
        $int1 = %varplayerbit_465;
        $int2 = %varplayerbit_456;
}
if_settext("x <tostring($int1)>", $component0);
if ($int1 < calc(($int2 + 1) * 5)) {
    if_setcolour(0xff3300, $component0);
} else if ($int1 = calc(($int2 + 1) * 5)) {
    if_setcolour(0xffcd00, $component0);
} else {
    if_setcolour(0x00cc00, $component0);
}
