// 12483
[clientscript,script12483]
def_graphic $graphic0 = mad_may_16_runemetrics;
def_string $string0 = "";
def_string $string1 = "RuneMetrics now available!";
switch_int (~date_runeday) {
    case 5181, 5182, 5183, 5184, 5185 :
        $string0 = "Treasure Hunter";
        $string1 = "New outfit available now!";
        switch_int (map_lang) {
            case 0 :
                $graphic0 = mad_may_16_elitestealth_ad_en;
            case 2 :
                $graphic0 = mad_may_16_elitestealth_ad_fr;
            case 1 :
                $graphic0 = mad_may_16_elitestealth_ad_de;
            case 3 :
                $graphic0 = mad_may_16_elitestealth_ad_pt;
        }
    case 5188, 5189, 5190, 5191, 5192 :
        switch_int (map_lang) {
            case 0 :
                $graphic0 = mad_may_16_proteanmemories_ad_en;
            case 2 :
                $graphic0 = mad_may_16_proteanmemories_ad_fr;
            case 1 :
                $graphic0 = mad_may_16_proteanmemories_ad_de;
            case 3 :
                $graphic0 = mad_may_16_proteanmemories_ad_pt;
        }
        $string1 = "Gain Divination XP with Protean Memories, available now!";
    case 5195, 5196, 5197, 5198, 5199 :
        switch_int (map_lang) {
            case 0 :
                $graphic0 = mad_may_16_bonuschest_ad_en;
            case 2 :
                $graphic0 = mad_may_16_bonuschest_ad_fr;
            case 1 :
                $graphic0 = mad_may_16_bonuschest_ad_de;
            case 3 :
                $graphic0 = mad_may_16_bonuschest_ad_pt;
        }
        $string1 = "Open the bonus chest for double or triple the normal rewards!";
    case 5202, 5203, 5204, 5205, 5206 :
        switch_int (map_lang) {
            case 0 :
                $graphic0 = mad_may_16_lavalanterns_ad_en;
            case 2 :
                $graphic0 = mad_may_16_lavalanterns_ad_fr;
            case 1 :
                $graphic0 = mad_may_16_lavalanterns_ad_de;
            case 3 :
                $graphic0 = mad_may_16_lavalanterns_ad_pt;
        }
        $string1 = "Claim all-new Lava Lanterns which award both XP and bonus XP!";
    case 5209, 5210, 5211, 5212, 5213 :
        switch_int (map_lang) {
            case 0 :
                $graphic0 = mad_may_16_gemerator_ad_en;
            case 2 :
                $graphic0 = mad_may_16_gemerator_ad_fr;
            case 1 :
                $graphic0 = mad_may_16_gemerator_ad_de;
            case 3 :
                $graphic0 = mad_may_16_gemerator_ad_pt;
        }
        $string1 = "Line up 5 gem colours and win an extra prize!";
    case 5216, 5217, 5218, 5219, 5220 :
        $string0 = "Treasure Hunter";
        $string1 = "Complete your elite skill outfits now!";
        switch_int (map_lang) {
            case 0 :
                $graphic0 = mad_may_16_skilloutfitbonanza_ad_en;
            case 2 :
                $graphic0 = mad_may_16_skilloutfitbonanza_ad_fr;
            case 1 :
                $graphic0 = mad_may_16_skilloutfitbonanza_ad_de;
            case 3 :
                $graphic0 = mad_may_16_skilloutfitbonanza_ad_pt;
        }
}
if_setgraphic($graphic0, mm16_summary:mtx_graphic);
if_settext($string1, mm16_summary:mtx_desc);
if_settext($string0, mm16_summary:mtx_title);
