// 8011
[clientscript,fadein_comp](int $int0, component $component1, component $component2)
def_int $int3 = 0;
if (if_find($component1) = true) {
    $int3 = calc($int0 - clientclock);
    if ($int3 <= 0) {
        cc_settrans(0);
        if_setontimer(null, $component2);
        return;
    }
    cc_settrans(max(calc(cc_gettrans - cc_gettrans / $int3), 1));
}
