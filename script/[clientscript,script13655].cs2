// 13655
[clientscript,script13655]
if (if_find(invent_auto_siphon:crystal_tool_siphon_inv_icon_wrapper) = true) {
    cc_create(invent_auto_siphon:crystal_tool_siphon_inv_icon_wrapper, ^iftype_graphic, 0);
    cc_setobject(invent_item_xp_consumer_crystal_tool, -1);
    cc_setsize(0, 0, ^setsize_minus, ^setsize_minus);
    cc_setposition(1, 0, ^setpos_abs_centre, ^setpos_abs_centre);
    cc_sendtofront;
}
cc_create(invent_auto_siphon:normal_siphon_inv_icon_wrapper, ^iftype_graphic, 0);
cc_setobject(invent_item_xp_consumer, -1);
cc_setsize(0, 0, ^setsize_minus, ^setsize_minus);
cc_setposition(1, 0, ^setpos_abs_centre, ^setpos_abs_centre);
cc_sendtofront;
~script13657;
