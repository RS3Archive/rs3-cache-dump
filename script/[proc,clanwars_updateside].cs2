// 1784
[proc,clanwars_updateside]
def_int $int0 = 0;
def_int $int1 = calc(if_getwidth(clanwars_setup_side:contents) - 16);
def_int $int2 = 0;
$int0, $int2 = ~clanwars_updateside_textbox("~ Eligibility ~", $int0, $int2, $int1, 1);
if (%clanwars_rulevarc_clanonly = false) {
    $int0, $int2 = ~clanwars_updateside_textbox("This Clan war is opened to all people in the challengers' friend chats.", $int0, $int2, $int1, 0);
} else {
    $int0, $int2 = ~clanwars_updateside_textbox("This Clan war is opened only to members of the challengers' clans.", $int0, $int2, $int1, 0);
}
$int0 = calc($int0 + 7);
$int0, $int2 = ~clanwars_updateside_textbox("~ Winning ~", $int0, $int2, $int1, 1);
$int0, $int2 = ~clanwars_updateside_textbox("Victory is awarded...", $int0, $int2, $int1, 0);
if (%clanwars_rulevarc_nostragglers = false) {
    $int0, $int2 = ~clanwars_updateside_textbox("...to the team that defeats all its enemies.", $int0, $int2, $int1, 0);
} else {
    $int0, $int2 = ~clanwars_updateside_textbox("...to the team that defeats all its enemies, excluding the last five.", $int0, $int2, $int1, 0);
}
if (%clanwars_rulevarc_endtype > 0 & %clanwars_rulevarc_endtype < 15) {
    $int0, $int2 = ~clanwars_updateside_textbox("OR<br>...to the team that first achieves <tostring(enum(int, int, clanwars_killcount_options, %clanwars_rulevarc_endtype))> kills.", $int0, $int2, $int1, 0);
}
if (%clanwars_rulevarc_timelimit > 0) {
    if (%clanwars_rulevarc_endtype > 0) {
        $int0, $int2 = ~clanwars_updateside_textbox("OR<br>...to the team that scores the most kills <~durationmes(enum(int, int, clanwars_timelimit_options, %clanwars_rulevarc_timelimit))>.", $int0, $int2, $int1, 0);
    } else {
        $int0, $int2 = ~clanwars_updateside_textbox("OR<br>...to the team with the most survivors <~durationmes(enum(int, int, clanwars_timelimit_options, %clanwars_rulevarc_timelimit))>.", $int0, $int2, $int1, 0);
    }
}
$int0 = calc($int0 + 7);
if (%clanwars_rulevarc_endtype = 0) {
    $int0, $int2 = ~clanwars_updateside_textbox("<col=ff981f>Knock-out mode:</col><br>Once war has begun, players may no longer join/rejoin the fight.", $int0, $int2, $int1, 0);
} else {
    $int0, $int2 = ~clanwars_updateside_textbox("<col=ff981f>Run-in mode:</col><br>Players may join/rejoin the fight at any time during the war.", $int0, $int2, $int1, 0);
    if (%clanwars_rulevarc_endtype = 15 & %clanwars_rulevarc_timelimit = 0) {
        $int0 = calc($int0 + 7);
        $int0, $int2 = ~clanwars_updateside_textbox("This war has no time limit or kill target, so it might go on for ages!", $int0, $int2, $int1, 0);
    }
}
$int0 = calc($int0 + 7);
$int0, $int2 = ~clanwars_updateside_textbox("~ Item loss ~", $int0, $int2, $int1, 1);
if (%clanwars_rulevarc_itemloss = false) {
    $int0, $int2 = ~clanwars_updateside_textbox("On death, players keep their items.", $int0, $int2, $int1, 0);
} else {
    $int0, $int2 = ~clanwars_updateside_textbox("<col=ff0000>On death, players DROP their items.</col><br>Players may not teleport.", $int0, $int2, $int1, 0);
}
$int0 = calc($int0 + 7);
$int0, $int2 = ~clanwars_updateside_textbox("~ Combat rules ~", $int0, $int2, $int1, 1);
if (%clanwars_rulevarc_nomelee = false) {
    $int0, $int2 = ~clanwars_updateside_textbox("Melee combat is allowed.", $int0, $int2, $int1, 0);
} else {
    $int0, $int2 = ~clanwars_updateside_textbox("<col=ff0000>Melee combat</col> is forbidden.", $int0, $int2, $int1, 0);
}
switch_int (%clanwars_rulevarc_nomagic) {
    case 0 :
        if (%clanwars_rulevarc_nointercept = true | %varclientbit_37000 = 1) {
            $int0, $int2 = ~clanwars_updateside_textbox("Magical combat is allowed, however the <col=ff0000>Intercept</col> spell is not.", $int0, $int2, $int1, 0);
        } else {
            $int0, $int2 = ~clanwars_updateside_textbox("Magical combat is allowed.", $int0, $int2, $int1, 0);
        }
    case 1 :
        $int0, $int2 = ~clanwars_updateside_textbox("Spells from the <col=ff0000>standard spellbook</col> are allowed.", $int0, $int2, $int1, 0);
    case 2 :
        if (map_members = true) {
            $int0, $int2 = ~clanwars_updateside_textbox("The <col=ff0000>Bind</col>, <col=ff0000>Snare</col> and <col=ff0000>Entangle</col> spells are allowed.", $int0, $int2, $int1, 0);
        } else {
            $int0, $int2 = ~clanwars_updateside_textbox("The <col=ff0000>Bind</col> spell is allowed.", $int0, $int2, $int1, 0);
        }
    case 3 :
        $int0, $int2 = ~clanwars_updateside_textbox("<col=ff0000>Magical combat</col> is forbidden.", $int0, $int2, $int1, 0);
}
if (%clanwars_rulevarc_noranged = false) {
    $int0, $int2 = ~clanwars_updateside_textbox("Ranged combat is allowed.", $int0, $int2, $int1, 0);
} else {
    $int0, $int2 = ~clanwars_updateside_textbox("<col=ff0000>Ranged combat</col> is forbidden.", $int0, $int2, $int1, 0);
}
if (%clanwars_rulevarc_noprayer = false) {
    $int0, $int2 = ~clanwars_updateside_textbox("Prayer is allowed.", $int0, $int2, $int1, 0);
} else {
    $int0, $int2 = ~clanwars_updateside_textbox("<col=ff0000>Prayer</col> is forbidden.", $int0, $int2, $int1, 0);
}
if (map_members = true) {
    if (%clanwars_rulevarc_nosummoning = false) {
        $int0, $int2 = ~clanwars_updateside_textbox("Summoning is allowed.", $int0, $int2, $int1, 0);
    } else {
        $int0, $int2 = ~clanwars_updateside_textbox("<col=ff0000>Summoning</col> is forbidden.<br>Familiars will be dismissed.", $int0, $int2, $int1, 0);
    }
}
if (%clanwars_rulevarc_nofood = false) {
    $int0, $int2 = ~clanwars_updateside_textbox("Food is allowed.", $int0, $int2, $int1, 0);
} else {
    $int0, $int2 = ~clanwars_updateside_textbox("<col=ff0000>Food</col> is forbidden.", $int0, $int2, $int1, 0);
}
if (%clanwars_rulevarc_nopotions = false) {
    $int0, $int2 = ~clanwars_updateside_textbox("Potions are allowed.", $int0, $int2, $int1, 0);
} else {
    $int0, $int2 = ~clanwars_updateside_textbox("<col=ff0000>Potions</col> are forbidden.<br>Boosted stats will be reset (excluding Prayer boosts).", $int0, $int2, $int1, 0);
}
$int0 = calc($int0 + 7);
$int0, $int2 = ~clanwars_updateside_textbox("~ Aid effects ~", $int0, $int2, $int1, 1);
if (%varclientbit_36998 = 0) {
    $int0, $int2 = ~clanwars_updateside_textbox("Aid effects affect all those with Effects Accept aid turned on.", $int0, $int2, $int1, 0);
} else {
    $int0, $int2 = ~clanwars_updateside_textbox("<col=ff0000>Aid effects</col> do not affect other players.", $int0, $int2, $int1, 0);
}
if (%clanwars_rulevarc_nomagic > 0) {
    $int0, $int2 = ~clanwars_updateside_textbox("<col=ff0000>Lunar spells</col> are not allowed.", $int0, $int2, $int1, 0);
} else if (%varclientbit_36999 = 0) {
    $int0, $int2 = ~clanwars_updateside_textbox("Aid Lunar spells affect all those with Lunar Accept aid turned on.", $int0, $int2, $int1, 0);
} else {
    $int0, $int2 = ~clanwars_updateside_textbox("<col=ff0000>Aid Lunar spells</col> do not affect other players.", $int0, $int2, $int1, 0);
}
if (%clanwars_rulevarc_nomagic > 0) {
    $int0, $int2 = ~clanwars_updateside_textbox("<col=ff0000>Seren spells</col> are not allowed.", $int0, $int2, $int1, 0);
} else if (%varclientbit_37000 = 0) {
    $int0, $int2 = ~clanwars_updateside_textbox("Aid Seren spells affect all those with Seren Accept aid turned on.", $int0, $int2, $int1, 0);
} else {
    $int0, $int2 = ~clanwars_updateside_textbox("<col=ff0000>Aid Seren spells</col> do not affect other players.", $int0, $int2, $int1, 0);
}
$int0 = calc($int0 + 7);
$int0, $int2 = ~clanwars_updateside_textbox("~ Arena ~", $int0, $int2, $int1, 1);
$int0, $int2 = ~clanwars_updateside_textbox(struct_param(enum(int, struct, clanwars_arena_options, %clanwars_rulevarc_arenachoice), clanwars_arena_name), $int0, $int2, $int1, 0);
if ($int0 > if_getheight(clanwars_setup_side:contents)) {
    if_sethide(false, clanwars_setup_side:scrollbar);
    if_setposition(7, 46, ^setpos_abs_left, ^setpos_abs_top, clanwars_setup_side:contents);
    if_setscrollsize(0, $int0, clanwars_setup_side:contents);
    ~scrollbar_vertical(clanwars_setup_side:scrollbar, clanwars_setup_side:contents, "scrollbar_dragger_v2,3", "scrollbar_dragger_v2,0", "scrollbar_dragger_v2,1", "scrollbar_dragger_v2,2", "scrollbar_v2,0", "scrollbar_v2,1");
    if (cc_find(clanwars_setup_side:scrollbar, 1) = true) {
        ~scrollbar_vertical_doscroll(clanwars_setup_side:scrollbar, clanwars_setup_side:contents, if_getscrolly(clanwars_setup_side:contents), 1);
    }
} else {
    cc_deleteall(clanwars_setup_side:scrollbar);
    if_sethide(true, clanwars_setup_side:scrollbar);
    if_setposition(15, 46, ^setpos_abs_left, ^setpos_abs_top, clanwars_setup_side:contents);
    if_setscrollsize(0, 0, clanwars_setup_side:contents);
    if_setscrollpos(0, 0, clanwars_setup_side:contents);
}
