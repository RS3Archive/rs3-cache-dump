// 15682
[clientscript,script15682]
if_settext("<db_getfield(~trh_get_monster(%trh187_white_monster), trh_monster:col1, 0)> x <tostring(%trh187_white_contract_amount)>", trh187_overlay:white_monster_text);
if_settext("<db_getfield(~trh_get_monster(%trh187_yellow_monster), trh_monster:col1, 0)> x <tostring(%trh187_yellow_contract_amount)>", trh187_overlay:yellow_monster_text);
if_settext("<db_getfield(~trh_get_monster(%trh187_orange_monster), trh_monster:col1, 0)> x <tostring(%trh187_orange_contract_amount)>", trh187_overlay:orange_monster_text);
if_settext("<db_getfield(~trh_get_monster(%trh187_red_monster), trh_monster:col1, 0)> x <tostring(%trh187_red_contract_amount)>", trh187_overlay:red_monster_text);
~trh187_set_tally(%trh187_white_contract_killed, %trh187_white_contract_amount, trh187_overlay:white_monster_tally);
~trh187_set_tally(%trh187_yellow_contract_killed, %trh187_yellow_contract_amount, trh187_overlay:yellow_monster_tally);
~trh187_set_tally(%trh187_orange_contract_killed, %trh187_orange_contract_amount, trh187_overlay:orange_monster_tally);
~trh187_set_tally(%trh187_red_contract_killed, %trh187_red_contract_amount, trh187_overlay:red_monster_tally);
if (%trh187_white_contract_amount = %trh187_white_contract_killed) {
    if_sethide(false, trh187_overlay:white_monster_line);
} else {
    if_sethide(true, trh187_overlay:white_monster_line);
}
if (%trh187_yellow_contract_amount = %trh187_yellow_contract_killed) {
    if_sethide(false, trh187_overlay:yellow_monster_line);
} else {
    if_sethide(true, trh187_overlay:yellow_monster_line);
}
if (%trh187_orange_contract_amount = %trh187_orange_contract_killed) {
    if_sethide(false, trh187_overlay:orange_monster_line);
} else {
    if_sethide(true, trh187_overlay:orange_monster_line);
}
if (%trh187_red_contract_amount = %trh187_red_contract_killed) {
    if_sethide(false, trh187_overlay:red_monster_line);
} else {
    if_sethide(true, trh187_overlay:red_monster_line);
}
