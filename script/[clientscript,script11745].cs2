// 11745
[clientscript,script11745]
%elfcity_ithell_harp_pitch = calc(256 - %elfcity_ithell_harp_discord / 2);
if (scale(%elfcity_ithell_harp_discord, 10, 100) < 50) {
    %elfcity_ithell_harp_pitch = 256;
}
if (%elfcity_ithell_harp_success = true) {
    %elfcity_ithell_harp_pitch = calc(%elfcity_ithell_harp_pitch * 2);
}
if (%elfcity_ithell_harp_fail = true) {
    sound_vorbis_rate(elfcity2_harp_note_068, 1, 0, 120, calc(%elfcity_ithell_harp_pitch + 10));
}
sound_vorbis_rate(~script5925(elfcity2_harp_note_01), 1, 0, 145, 255);
sound_vorbis_rate(~script5925(elfcity2_harp_note_02), 1, 9, 140, %elfcity_ithell_harp_pitch);
sound_vorbis_rate(~script5925(elfcity2_harp_note_03), 1, 19, 135, %elfcity_ithell_harp_pitch);
sound_vorbis_rate(~script5925(elfcity2_harp_note_04), 1, 28, 130, %elfcity_ithell_harp_pitch);
sound_vorbis_rate(~script5925(elfcity2_harp_note_05), 1, 38, 125, %elfcity_ithell_harp_pitch);
sound_vorbis_rate(~script5925(elfcity2_harp_note_06), 1, 47, 120, %elfcity_ithell_harp_pitch);
sound_vorbis_rate(~script5925(elfcity2_harp_note_07), 1, 56, 115, %elfcity_ithell_harp_pitch);
sound_vorbis_rate(~script5925(elfcity2_harp_note_08), 1, 66, 110, %elfcity_ithell_harp_pitch);
sound_vorbis_rate(~script5925(elfcity2_harp_note_09), 1, 75, 105, %elfcity_ithell_harp_pitch);
sound_vorbis_rate(~script5925(elfcity2_harp_note_10), 1, 84, 105, %elfcity_ithell_harp_pitch);
sound_vorbis_rate(~script5925(elfcity2_harp_note_11), 1, 94, 110, %elfcity_ithell_harp_pitch);
sound_vorbis_rate(~script5925(elfcity2_harp_note_12), 1, 103, 115, %elfcity_ithell_harp_pitch);
sound_vorbis_rate(~script5925(elfcity2_harp_note_13), 1, 113, 120, %elfcity_ithell_harp_pitch);
sound_vorbis_rate(~script5925(elfcity2_harp_note_14), 1, 122, 125, %elfcity_ithell_harp_pitch);
sound_vorbis_rate(~script5925(elfcity2_harp_note_15), 1, 131, 130, %elfcity_ithell_harp_pitch);
sound_vorbis_rate(~script5925(elfcity2_harp_note_16), 1, 141, 135, %elfcity_ithell_harp_pitch);
