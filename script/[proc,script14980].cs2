// 14980
[proc,script14980](component $component0, int $int1)
cc_deleteall($component0);
def_int $int2 = -1;
while (++$int2 < $int1) {
    cc_create($component0, ^iftype_graphic, $int2);
    cc_setsize(40, 36, ^setsize_abs, ^setsize_abs);
    cc_setposition(calc(16 + $int2 % 4 * 45), calc(5 + $int2 / 4 * 41), ^setpos_abs_left, ^setpos_abs_top);
}
