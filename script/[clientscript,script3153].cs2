// 3153
[clientscript,script3153](int $int0, int $int1)
switch_int ($int0) {
    case 1 :
        %incense_guam_active = $int1;
    case 2 :
        %incense_tarromin_active = $int1;
    case 3 :
        %incense_marrentill_active = $int1;
    case 4 :
        %incense_harralander_active = $int1;
    case 5 :
        %incense_ranarr_active = $int1;
    case 6 :
        %incense_toadflax_active = $int1;
    case 7 :
        %incense_spirit_active = $int1;
    case 8 :
        %incense_irit_active = $int1;
    case 9 :
        %incense_wergali_active = $int1;
    case 10 :
        %incense_avantoe_active = $int1;
    case 11 :
        %incense_kwuarm_active = $int1;
    case 12 :
        %incense_bloodweed_active = $int1;
    case 13 :
        %incense_snapdragon_active = $int1;
    case 14 :
        %incense_cadantine_active = $int1;
    case 15 :
        %incense_lantadyme_active = $int1;
    case 16 :
        %incense_dwarf_active = $int1;
    case 17 :
        %incense_torstol_active = $int1;
    case 18 :
        %incense_fellstalk_active = $int1;
    case default :
        ~error("Attempted to set var for unexpected burner type: <tostring($int0)>");
}
