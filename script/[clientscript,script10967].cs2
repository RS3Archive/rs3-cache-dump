// 10967
[clientscript,script10967](component $component0)
if ($component0 = trh44_valentines15_milestones:love_button_active_layer) {
    if (inv_total(inv, trh44_valentines15_currency) = 0) {
        mes("You don't have any rose petals in your inventory to sprinkle.");
        return;
    }
    if (%trh44_valentines15_love_points < 1250) {
        if_setgraphic("aif_valentine_shop_icons_2014,11", trh44_valentines15_milestones:popup_icon);
        if_settext("How many rose petals would you like to add to the love side?", trh44_valentines15_milestones:popup_description);
        if_settext("0", trh44_valentines15_milestones:text_input_display);
        if_sethide(false, trh44_valentines15_milestones:resizable_3x3_button_disabled_layer_accept);
        if_sethide(false, trh44_valentines15_milestones:darkness);
        if_sethide(false, trh44_valentines15_milestones:popup_layer);
    } else {
        mes("You can't sprinkle any more petals.");
    }
} else if ($component0 = trh44_valentines15_milestones:hate_button_active_layer) {
    if (inv_total(inv, trh44_valentines15_currency) = 0) {
        mes("You don't have any rose petals in your inventory to crush.");
        return;
    }
    if (%trh44_valentines15_hate_points < 1250) {
        if_setgraphic("aif_valentine_shop_icons_2014,10", trh44_valentines15_milestones:popup_icon);
        if_settext("How many rose petals would you like to add to the hate side?", trh44_valentines15_milestones:popup_description);
        if_settext("0", trh44_valentines15_milestones:text_input_display);
        if_sethide(false, trh44_valentines15_milestones:resizable_3x3_button_disabled_layer_accept);
        if_sethide(false, trh44_valentines15_milestones:darkness);
        if_sethide(false, trh44_valentines15_milestones:popup_layer);
    } else {
        mes("You can't crush any more petals.");
    }
}
return;
