// 1180
[clientscript,script1180](component $component0)
if (%toplevel_v2_active_skinset = 1 & %doublexp_setupflag = 0) {
    if (map_lang = 1) {
        if_setgraphic("xp_token,2", $component0);
    } else {
        if_setgraphic("xp_token,0", $component0);
    }
} else if (map_lang = 1) {
    if_setgraphic("xp_token_with_plus,2", $component0);
} else {
    if_setgraphic("xp_token_with_plus,0", $component0);
}
~script8808;
