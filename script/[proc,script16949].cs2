// 16949
[proc,script16949]()(dbrow)
switch_int (%trh188_progress_bars_completed) {
    case 0 :
        return(trh188_progress_bar_1);
    case 1 :
        return(trh188_progress_bar_2);
    case 2 :
        return(trh188_progress_bar_3);
    case 3 :
        return(trh188_progress_bar_4);
    case 4 :
        return(trh188_progress_bar_5);
    case 5 :
        return(trh188_progress_bar_6);
    case 6 :
        return(trh188_progress_bar_7);
    case 7 :
        return(trh188_progress_bar_8);
    case 8 :
        return(trh188_progress_bar_9);
    case default :
        switch_int (calc((%trh188_progress_bars_completed - 9) % 6)) {
            case 0 :
                return(trh188_progress_bar_repeatable_1);
            case 1 :
                return(trh188_progress_bar_repeatable_2);
            case 2 :
                return(trh188_progress_bar_repeatable_3);
            case 3 :
                return(trh188_progress_bar_repeatable_4);
            case 4 :
                return(trh188_progress_bar_repeatable_5);
            case 5 :
                return(trh188_progress_bar_repeatable_6);
        }
}
