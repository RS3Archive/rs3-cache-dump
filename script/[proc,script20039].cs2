// 20039
[proc,script20039](component $component0)
def_string $string0 = "";
def_int $int1 = 0;
switch_component ($component0) {
    case trh210_overlay:min_tooltip_layer :
        $string0 = "These bonuses <col=89CFF0>increase any multipliers on the trail to a minimum multiplier</col>, up to <col=FF00>x4</col>!";
    case trh210_overlay:plus_tooltip_layer :
        $string0 = "These bonuses <col=89CFF0>increase any multipliers on the trail by up to +3!";
    case trh210_overlay:rarity_tooltip_layer :
        $string0 = "Rarities can be <col=89CFF0>increased by up to 2 rarity tiers per bonus</col>, or <col=89CFF0>set to a minimum guaranteed rarity, up to purple rarity</col>!";
}
if (~script6431 = false) {
    if_setonmouserepeat("script8801($string0, event_com, event_comsubid, ^settextalign_left, ^settextalign_centre, 12)", $component0);
    if_setonmouseleave("script8805", $component0);
} else {
    if_setop(1, "Info", $component0);
    if_setonop("script7774($string0, event_com, event_comsubid, 0)", $component0);
}
