// 14103
[clientscript,script14103](component $component0, component $component1, int $int2)
if ($int2 >= 0) {
    if_setontimer("script14103($component0, $component1, calc($int2 - 1))", $component1);
    return;
} else {
    if_setontimer(null, $component1);
    if_setvflip(true, $component1);
    if_setop(1, "Expand", toolbelt_v2:info_expandarrow);
    if_sethide(true, $component0);
}
