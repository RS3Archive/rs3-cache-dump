[clientscript,script15803]
def_int $int0 = if_getx(tut7_sandbox_goal:floater);
if ($int0 <= calc(if_getwidth(tut7_sandbox_goal:bounds) - 22 * 2)) {
    if_setposition(calc(if_getx(tut7_sandbox_goal:floater) + 1), if_gety(tut7_sandbox_goal:floater), ^setpos_abs_left, ^setpos_abs_top, tut7_sandbox_goal:floater);
} else {
    if_sethide(true, tut7_sandbox_goal:floater);
}
