// 10301
[proc,script10301](component $component0)(component)
if ($component0 = toplevel_v2_parent_suboverlay_group:main_layer) {
    return(toplevel_v2_parent_suboverlay_group:create_group_layer);
} else if ($component0 = group_child_dropdown:content_layer) {
    return(group_child_dropdown:create_group_layer);
} else {
    return(group_child:create_group_layer);
}
