// 14892
[proc,script14892](enum $enum0)
def_component $component1 = null;
def_component $component2 = arch_research_management:research_scrollbar_layer;
switch_enum ($enum0) {
    case arch_research_general_list :
        ~script13972(arch_research_management:general_research_tab_layer, null, rs3tli_modal_tab, "General Research", 1);
        ~script13972(arch_research_management:special_research_tab_layer, null, rs3tli_modal_tab, "Special Research", 0);
        if_sethide(false, arch_research_management:general_research_scrolling_layer);
        if_sethide(true, arch_research_management:special_research_scrolling_layer);
        $component1 = arch_research_management:general_research_scrolling_layer;
    case arch_research_special_list :
        ~script13972(arch_research_management:general_research_tab_layer, null, rs3tli_modal_tab, "General Research", 0);
        ~script13972(arch_research_management:special_research_tab_layer, null, rs3tli_modal_tab, "Special Research", 1);
        if_sethide(true, arch_research_management:general_research_scrolling_layer);
        if_sethide(false, arch_research_management:special_research_scrolling_layer);
        $component1 = arch_research_management:special_research_scrolling_layer;
}
~script14871($component1, $component2);
