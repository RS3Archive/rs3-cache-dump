// 15779
[clientscript,script15779]
if_setonresize("script15779", arch_journal:overview_layer);
def_int $int0 = if_getheight(arch_journal:mainmodal_window);
def_int $int1 = 25;
def_int $int2 = 110;
def_int $int3 = 292;
def_int $int4 = 15;
if ($int0 <= 550) {
    $int1 = 25;
    $int2 = 85;
    $int3 = 262;
    $int4 = 0;
}
if_setsize(0, $int1, ^setsize_minus, ^setsize_abs, arch_journal:overview_title_text);
if_setposition(0, $int1, ^setpos_abs_centre, ^setpos_abs_top, arch_journal:skill_layer);
if_setsize(0, $int2, ^setsize_minus, ^setsize_abs, arch_journal:skill_layer);
if_setposition(0, calc($int1 + $int2), ^setpos_abs_centre, ^setpos_abs_top, arch_journal:mastery_layer);
if_setsize(0, $int1, ^setsize_minus, ^setsize_abs, arch_journal:overview_relic_title_text);
if_setsize(0, $int3, ^setsize_minus, ^setsize_abs, arch_journal:overview_relic_layer);
if_setposition(0, $int4, ^setpos_abs_centre, ^setpos_abs_bottom, arch_journal:overview_research_layer);
