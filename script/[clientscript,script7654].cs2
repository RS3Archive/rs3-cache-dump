// 7654
[clientscript,script7654](component $component0, int $int1)
if ($int1 = 65535) {
    if_setontimer(null, interface_1253:com_173);
    return;
}
def_int $int2 = calc(if_getx($component0) - $int1);
if ($int2 > 5) {
    if_setontimer("script9705(calc(0 - min(8, calc(abs($int2) / 5))))", interface_1253:com_173);
} else if ($int2 < -5) {
    if_setontimer("script9705(min(8, calc(abs($int2) / 5)))", interface_1253:com_173);
} else {
    if_setontimer(null, interface_1253:com_173);
}
