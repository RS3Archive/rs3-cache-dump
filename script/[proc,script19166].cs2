// 19166
[proc,script19166](struct $struct0)
switch_struct ($struct0) {
    case trh182_promo :
        ~trh182_overlay_onload;
    case trh203_promo :
        ~trh203_overlay_onload;
    case trh207_promo :
        ~trh207_overlay_onload;
    case default :
        ~error("Missed plugin point for promo ID <tostring(struct_param($struct0, trh_promo_id))>");
}
