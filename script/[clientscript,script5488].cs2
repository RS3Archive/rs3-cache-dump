// 5488
[clientscript,script5488]
switch_int (%pop_randomevent) {
    case 1 :
        if_setmodel(pop_original_black_marketeer_chat, pop_rewards:chathead);
        if_settext("The Death Lotus assassins, their contracts fulfilled, left the port. The Black Marketeer was able to return to the warehouse.", pop_rewards:flavour);
    case 2 :
        if_setmodel(pop_original_barmaid_chat, pop_rewards:chathead);
        if_settext("Surula, satisfied with a job well done was able to relax for a whole minute before the next load of customers arrived.", pop_rewards:flavour);
    case 3 :
        if_setmodel(elr2_siren_female_base_chat, pop_rewards:chathead);
        if_settext("Umi successfully helped out in the warehouse. She can go back to learning the ways of the Seasingers now.", pop_rewards:flavour);
}
def_graphic $graphic0 = null;
def_string $string0 = "";
$graphic0, $string0 = ~pop_get_reward_info(%pop_randomevent_reward1);
$string0 = append("1 x ", $string0);
if_settext($string0, pop_rewards:reward_text);
if_setgraphic($graphic0, pop_rewards:item);
$graphic0, $string0 = ~pop_get_reward_info(%pop_randomevent_reward2);
$string0 = append("1 x ", $string0);
if_settext($string0, pop_rewards:reward_text_2);
if_setgraphic($graphic0, pop_rewards:item_2);
$graphic0, $string0 = ~pop_get_reward_info(%pop_randomevent_reward3);
$string0 = append("1 x ", $string0);
if_settext($string0, pop_rewards:reward_text_3);
if_setgraphic($graphic0, pop_rewards:item_3);
