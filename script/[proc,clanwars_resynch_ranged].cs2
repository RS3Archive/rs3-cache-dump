// 1776
[proc,clanwars_resynch_ranged]
~static_checkbox(clanwars_setup:ranged_indicator, ~bool_to_int(~not_bool(%clanwars_rulevarc_noranged)), false);
if (%clanwars_rulevarc_noranged = false) {
    if_settrans(0, clanwars_setup:ranged);
} else {
    if_settrans(225, clanwars_setup:ranged);
}
~clanwars_updateside;
