// 858
[proc,script858](int $int0, int $int1)(int)
switch_int ($int0) {
    case 0 :
        return(testbit($int1, 0));
    case 7 :
        return(testbit($int1, 1));
    case 1 :
        return(testbit($int1, 2));
    case 2 :
        return(testbit($int1, 3));
    case 3 :
        return(testbit($int1, 4));
    case 12, 8, 9, 10, 11, 4 :
        return(testbit($int1, 7));
    case 5 :
        return(testbit($int1, 8));
    case 6 :
        return(^false);
}
return(^false);
