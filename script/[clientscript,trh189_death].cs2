// 17056
[clientscript,trh189_death](component $component0, component $component1, seq $seq2, seq $seq3, seq $seq4)
if_sethide(true, trh189_overlay:right_modifier);
if_sethide(true, trh189_overlay:right_modifiers);
if_sethide(true, trh189_overlay:left_modifier);
if_sethide(true, trh189_overlay:left_modifier_shadow);
if_sethide(true, trh189_overlay:left_modifiers);
if_sethide(true, trh189_overlay:left_modifier_plus);
if_sethide(true, trh189_overlay:skin_select_button);
if_sethide(true, trh189_overlay:shop_button);
if_sethide(true, trh189_overlay:promo_prize_button);
if_setmodelanim($seq4, $component1);
if_setmodelanim($seq2, $component0);
if_setontimer("trh189_reset_anim(seqlength($seq2), $seq3, $component0)", $component0);
if_setontimer("trh189_hide_model(seqlength($seq4), $component1)", $component1);
if_setontimer("script17058(calc(seqlength($seq4) - 60), $component1)", trh189_overlay:lunar_layer);
