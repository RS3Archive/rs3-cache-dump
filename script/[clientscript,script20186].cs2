if_setsize(700, calc($int3 - 20), ^setsize_abs, ^setsize_minus, league_lobby_splash:panels_bg);
if_setsize($int2, $int3, ^setsize_abs, ^setsize_abs, league_lobby_splash:logo_wrapper);
if_setposition(0, $int3, ^setpos_abs_centre, ^setpos_abs_top, league_lobby_splash:subheader);
$int3 = calc($int3 + if_getheight(league_lobby_splash:subheader) + 4 * 2);
if_setposition(0, $int3, ^setpos_abs_centre, ^setpos_abs_top, league_lobby_splash:contents);
if_setsize(640, $int3, ^setsize_abs, ^setsize_minus, league_lobby_splash:contents);
