// 20186
[clientscript,script20186](int $int0)
def_int $int1 = calc(clientclock - $int0);
def_int $int2 = if_getwidth(league_lobby_splash:logo_wrapper);
def_int $int3 = scale($int2, 500, 456);
def_int $int4 = 0;
if ($int1 < 50) {
    if ($int1 < 1) {
        ~script4161(league_lobby_splash:bg, 255);
        ~script4161(league_lobby_splash:border, 255);
    }
    if_settrans(scale(255, 50, $int1), league_lobby_splash:flash);
} else if ($int1 < 150) {
    $int1 = calc($int1 - 50);
    if_settrans(255, league_lobby_splash:flash);
    if_setgraphic(league_logo_500x456, league_lobby_splash:logo);
    if_settrans(calc(255 - scale(255, 100, $int1)), league_lobby_splash:logo);
    if_settrans(calc(255 - scale(255, 100, $int1)), league_lobby_splash:logo_bg);
