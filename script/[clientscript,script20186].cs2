    ~script4161(league_lobby_splash:bg, $int4);
    ~script4161(league_lobby_splash:border, $int4);
} else if ($int1 < 350) {
    if_settrans(0, league_lobby_splash:subheader_text);
    ~script4161(league_lobby_splash:bg, 0);
    ~script4161(league_lobby_splash:border, 0);
    $int1 = calc($int1 - 250);
    $int2 = calc(500 - scale(500, 200, $int1));
} else if ($int1 < 450) {
    if ($int1 = 351) {
        ~script20188;
    }
    $int1 = calc($int1 - 350);
    ~script20187(calc(255 - scale(255, 100, $int1)));
} else {
    ~script20187(0);
    if_setontimer(null, league_lobby_splash:anim_listener);
