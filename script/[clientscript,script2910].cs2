// 2910
[clientscript,script2910](component $component0, component $component1)
if (%ii_overlay_toggle = 0) {
    if_setontimer("ii_resize_if(0, 20, calc(if_getheight(if_getlayer($component0)) - 20), 0, $component0)", $component0);
    if_settext("Show", $component1);
    if_setop(1, "Show", $component1);
} else {
    if_setontimer("ii_resize_if(1, 20, calc(if_getheight(if_getlayer($component0)) - 20), 0, $component0)", $component0);
    if_settext("Hide", $component1);
    if_setop(1, "Hide", $component1);
}
