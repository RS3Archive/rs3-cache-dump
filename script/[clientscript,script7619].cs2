// 7619
[clientscript,script7619](component $component0, component $component1, int $int2)
def_int $int3 = calc(clientclock - $int2);
def_int $int4 = 0;
if ($int3 < 75) {
    $int4 = scale($int3, 75, 255);
    if_setcolour(~rgb_to_hex(255, $int4, $int4), $component1);
} else if ($int3 < 150) {
    $int4 = scale(calc(150 - $int3), 75, 255);
    if_setcolour(~rgb_to_hex(255, $int4, $int4), $component1);
} else {
    if_setontimer(null, $component0);
    if_sethide(true, $component0);
}
