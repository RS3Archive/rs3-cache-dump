// 14703
[proc,script14703](dbrow $dbrow0)(int)
switch_dbrow ($dbrow0) {
    case invent_blueprint_material_shadow :
        if (~script12376(2, 8) = 0) {
            return(0);
        }
    case invent_blueprint_material_avernic :
        if (~script12376(3, 8) = 0) {
            return(0);
        }
    case invent_blueprint_material_ilujankan :
        if (~script12376(4, 8) = 0) {
            return(0);
        }
    case invent_blueprint_material_cywir :
        if (~script12376(1, 8) = 0) {
            return(0);
        }
    case invent_blueprint_item_xp_consumer_crystal_tool :
        return(%elr1_reward_invent_xp_consumer_crystal_tool_unlocked);
    case invent_blueprint_magic_notepaper :
        if (%dungeon_reward_shop_notepaper_unlock = 0) {
            return(0);
        }
    case invent_blueprint_dungeoneering :
        if (%dungeon_reward_shop_elite_dg_outfit_unlock = 0) {
            return(0);
        }
    case invent_blueprint_farming_outfit :
        return(%pof_rewards_trh_outfit_blueprint);
    case invent_blueprint_trapper :
        return(%dino_game_shop_elite_outfit_blueprint);
    case invent_blueprint_dungeon_ulthven_undead_ability_book :
        return(%dungeon_reward_shop_ability_book_undead_unlocked);
    case invent_blueprint_dungeon_ulthven_demon_ability_book :
        return(%dungeon_reward_shop_ability_book_demon_unlocked);
    case invent_blueprint_dungeon_ulthven_dragon_ability_book :
        return(%dungeon_reward_shop_ability_book_dragon_unlocked);
    case invent_blueprint_auto_screener :
        return(%invent_blueprint_auto_screener_acquired);
    case invent_blueprint_ancient_gizmos :
        return(%invent_blueprint_ancient_gizmos_acquired);
    case invent_blueprint_ancient_enhanced_tools :
        return(%invent_blueprint_ancient_enhanced_tools_acquired);
    case invent_blueprint_item_xp_storage :
        return(%invent_blueprint_item_xp_storage_acquired);
}
return(1);
