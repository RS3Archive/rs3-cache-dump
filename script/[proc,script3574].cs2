// 3574
[proc,script3574]()(int)
def_int $int0 = 0;
$int0 = %money_tree_time;
if ($int0 = 0) {
    return(0);
} else if (date_minutes >= calc(2880 + $int0)) {
    return(5);
} else if (date_minutes >= calc(scale(3, 4, 2880) + $int0)) {
    return(4);
} else if (date_minutes >= calc(scale(2, 4, 2880) + $int0)) {
    return(3);
} else if (date_minutes >= calc(scale(1, 4, 2880) + $int0)) {
    return(2);
} else {
    return(1);
}
