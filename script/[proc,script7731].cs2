// 7731
[proc,script7731](int $int0, int $int1, int $int2)(boolean)
switch_int ($int2) {
    case 0 :
        if (calc((date_minutes - date_minutes_fromruneday($int0)) / 60) >= 12 & calc((date_minutes - date_minutes_fromruneday($int1)) / 60) < 12) {
            return(true);
        } else {
            return(false);
        }
    case 2 :
        if (date_runeday >= $int0 & calc((date_minutes - date_minutes_fromruneday($int1)) / 60) < 12) {
            return(true);
        } else {
            return(false);
        }
    case 1 :
        if (date_runeday >= $int0 & date_runeday <= $int1) {
            return(true);
        } else {
            return(false);
        }
}
