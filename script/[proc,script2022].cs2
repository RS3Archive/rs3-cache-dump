            $int5 = %pop_voyage_random_1_id;
        case 2 :
            $int5 = %pop_voyage_random_2_id;
        case 3 :
            $int5 = %pop_voyage_random_3_id;
    }
}
def_struct $struct6 = enum(int, struct, pop_voyage_list, $int5);
if ($struct6 ! null & struct_param($struct6, pop_voyage_type) = 7) {
    if (~script1121(%pop_voyage_list_ship) = 1) {
        if_sethide(false, pop_voyage_list:low_chance_warning);
