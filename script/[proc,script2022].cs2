} else {
    ~aif_progressbar_set(%pop_voyage_list_chance_graft, pop_voyage_list:graft_chance_bar, pop_voyage_list:graft_chance);
    ~aif_progressbar_set(%pop_voyage_list_chance_combat, pop_voyage_list:combat_chance_bar, pop_voyage_list:combat_chance);
    ~aif_progressbar_set(%pop_voyage_list_chance_seafaring, pop_voyage_list:seafaring_chance_bar, pop_voyage_list:seafaring_chance);
    $string0 = tostring(%pop_voyage_list_ship_graft);
    $string2 = tostring(%pop_voyage_list_ship_combat);
    $string4 = tostring(%pop_voyage_list_ship_seafaring);
    $int0 = min(min(%pop_voyage_list_chance_graft, %pop_voyage_list_chance_combat), %pop_voyage_list_chance_seafaring);
}
if (%pop_voyage_list_diff_graft > 0) {
    $string1 = tostring(%pop_voyage_list_diff_graft);
}
if (%pop_voyage_list_diff_combat > 0) {
    $string3 = tostring(%pop_voyage_list_diff_combat);
}
if (%pop_voyage_list_diff_seafaring > 0) {
    $string5 = tostring(%pop_voyage_list_diff_seafaring);
