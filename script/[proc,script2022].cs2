        if_sethide(true, pop_voyage_list:confirm_send);
    } else if ($int0 < 35) {
        if_sethide(false, pop_voyage_list:low_chance_warning);
        if_settext("Warning: Your chances of success are low. You risk harsher penalties if the voyage fails.", pop_voyage_list:low_chance_warning);
        if_sethide(true, pop_voyage_list:confirm_send);
    } else {
        if_sethide(true, pop_voyage_list:low_chance_warning);
        if_sethide(false, pop_voyage_list:confirm_send);
    }
} else if ($struct6 ! null & struct_param($struct6, pop_voyage_type) = 5) {
    if (~script3730 = 0) {
        if_sethide(false, pop_voyage_list:low_chance_warning);
        if_settext("Warning: The Scroll you have focused on is complete. Please view your Port Management page to change the scroll.", pop_voyage_list:low_chance_warning);
        if_sethide(true, pop_voyage_list:confirm_send);
    } else if ($int0 < 35) {
        if_sethide(false, pop_voyage_list:low_chance_warning);
