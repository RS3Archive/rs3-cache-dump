if_settext($string5, pop_voyage_list:seafaring_voyage);
def_int $int1 = scale(10, 6, calc($int0 - 5));
def_int $int2 = scale(200, 100, $int1);
def_int $int3 = calc(200 - $int2);
def_int $int4 = 20;
if_settext("<tostring($int0)>%", pop_voyage_list:voyage_chance_total);
if_setcolour(~rgb_to_hex($int3, $int2, $int4), pop_voyage_list:voyage_chance_total);
def_int $int5 = 0;
if (%pop_voyage_list_mode = 1) {
    switch_int (%pop_voyage_list_selected) {
        case 1 :
            $int5 = %pop_voyage_story_1_id;
        case 2 :
            $int5 = %pop_voyage_story_2_id;
        case 3 :
            $int5 = %pop_voyage_story_3_id;
