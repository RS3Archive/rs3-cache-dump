// 12352
[proc,script12352]
def_int $int0 = os_driver_vendor;
def_string $string0 = "Your graphics card drivers are over 6 months old. Please consider updating your drivers to receive the optimal experience playing RuneScape.";
if ($int0 >= 0) {
    if_sethide(false, interface_744:com_256);
    $string0 = append($string0, "<br><br>Select the button below to be taken to the manufacturer's website.");
} else {
    if_sethide(true, interface_744:com_256);
    if_setposition(0, 10, ^setpos_abs_centre, ^setpos_abs_bottom, interface_744:com_257);
    $string0 = append($string0, "<br><br>Please visit the manufacturer's website for your graphics card to update the drivers.");
}
if_settext($string0, interface_744:com_251);
