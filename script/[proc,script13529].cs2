// 13529
[proc,script13529]
if (%varclientbit_37000 = 1 | %clanwars_rulevarc_nomagic > 0) {
    if_sethide(false, clanwars_setup:intercept_disabled);
} else {
    if_sethide(true, clanwars_setup:intercept_disabled);
}
~static_checkbox(clanwars_setup:intercept_indicator, ~equal_int(0, ~bool_to_int(%clanwars_rulevarc_nointercept)), false);
~static_checkbox(clanwars_setup:nointercept_indicator, ~equal_int(1, ~bool_to_int(%clanwars_rulevarc_nointercept)), false);
~clanwars_updateside;
