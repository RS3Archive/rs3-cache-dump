// 272
[clientscript,script272]
if_setsize(if_getwidth(fishcomp_overlay:fishcomp_right_panel), 215, ^setsize_abs, ^setsize_abs, fishcomp_overlay:fishcomp_right_panel);
if_setscrollsize(0, 0, fishcomp_overlay:history_scrolllayer);
def_int $int0 = if_getheight(fishcomp_overlay:history_habitat_layer);
if ($int0 > if_getheight(fishcomp_overlay:history_scrolllayer)) {
    if_setscrollsize(0, $int0, fishcomp_overlay:history_scrolllayer);
}
~rs3_scrollbar_vertical(fishcomp_overlay:history_scrollbar, fishcomp_overlay:history_scrolllayer);
if_setvflip(false, fishcomp_overlay:show_history_arrow_left);
if_setvflip(false, fishcomp_overlay:show_history_arrow_right);
