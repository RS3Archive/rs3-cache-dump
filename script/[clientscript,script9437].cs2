// 9437
[clientscript,script9437](component $component0)
def_int $int1 = -1;
switch_component ($component0) {
    case 6awe2_golem_construction:panel_tab_head :
        $int1 = 0;
    case 6awe2_golem_construction:panel_tab_torso :
        $int1 = 1;
    case 6awe2_golem_construction:panel_tab_legs :
        $int1 = 2;
    case 6awe2_golem_construction:panel_tab_arms :
        $int1 = 3;
    case default :
        return;
}
if (%6awe2_golem_interface_tab = $int1) {
    return;
}
if_setposition(calc(4 + $int1 * 120), 0, ^setpos_abs_left, ^setpos_abs_top, 6awe2_golem_construction:panel_tab_selected);
if_sethide(false, 6awe2_golem_construction:panel_loading_overlay);
