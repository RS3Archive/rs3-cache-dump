// 14142
[clientscript,scrollbar_horizontal_swipe](component $component0, component $component1, int $int2)
if ($component1 = mtxmgt_store:ragdolls_scrollsize_layer) {
    if ($int2 < 0) {
        $int2 = max($int2, -1);
    } else {
        $int2 = min($int2, 1);
    }
    $int2 = calc($int2 * 8);
    unknown_command_21;
}
~scrollbar_horizontal_doscroll($component0, $component1, calc(if_getscrollx($component1) + $int2 * -1), 0);
