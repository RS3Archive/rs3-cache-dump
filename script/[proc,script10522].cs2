// 10522
[proc,script10522](component $component0)
if (%p_dialog_mode = 8) {
    switch_component ($component0) {
        case diango_items:text_input_listen :
            ~diango_cancel_search;
        case mtxmgt_store:text_input_listen :
            ~script13221;
        case bank:text_input_listen :
            ~script13907;
        case group_ironman_storage:text_input_listen :
            ~script19557;
        case arch_journal:restoration_filter_search_input_listen :
            ~script14838;
        case mtxmgt:search_input_listen :
            ~script15007;
    }
} else if (%p_dialog_mode = 10) {
    switch_component ($component0) {
        case stockmarket:search_input_listen :
            ~stockmarket_search_close;
        case stock_favourites:search_input_listen :
            ~script15016;
    }
} else if (%p_dialog_mode = 7) {
    switch_component ($component0) {
        case chat_input:text_input_listen :
            ~script675;
    }
}
