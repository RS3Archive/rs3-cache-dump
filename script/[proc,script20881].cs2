// 20881
[proc,script20881]
def_string $string0 = "...";
def_string $string1 = "...";
if (%exchange_setting_bigger_inc_percent > 0) {
    $string0 = "+<tostring(%exchange_setting_bigger_inc_percent)>%";
}
if (%exchange_setting_bigger_dec_percent > 0) {
    $string1 = "-<tostring(%exchange_setting_bigger_dec_percent)>%";
}
def_int $int0 = calc(100 - 95);
if_settext($string1, stockmarket:offerprice_biggerdecrease);
if_settext("-<tostring($int0)>%", stockmarket:offerprice_bigdecrease);
if_settext("+<tostring($int0)>%", stockmarket:offerprice_bigraise);
if_settext($string0, stockmarket:offerprice_biggerraise);
