// 12457
[proc,script12457](int $int0, int $int1, int $int2, int $int3)(int)
if ($int0 < calc($int1 / 2)) {
    return(~script12454($int0, calc($int1 / 2), $int2, $int3));
} else {
    if (calc($int1 % 2) = 1) {
        return(~script12455(calc($int0 - $int1 / 2), calc($int1 / 2), calc($int2 + $int3), calc($int3 * -1)));
    }
    return(~script12455(calc($int0 - $int1 / 2 + 1), calc($int1 / 2), calc($int2 + $int3), calc($int3 * -1)));
}
