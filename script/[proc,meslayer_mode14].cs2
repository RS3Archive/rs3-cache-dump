// 3685
[proc,meslayer_mode14]
if (%snapshot_open = true) {
    mes("You can't do that while you're reporting abuse.");
    return;
}
if_sethide(false, meslayer:root);
if_settext("Enter the name of the song you wish to search for:", meslayer:mes_text);
%meslayermode = 14;
~meslayer_setupinput("");
if_setonclick(null, meslayer:mes_layer);
~script2026;
