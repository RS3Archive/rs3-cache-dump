// 5367
[proc,script5367](int $int0, int $int1)
if (cc_find(interface_951:com_24, $int0) = true) {
    switch_int ($int1) {
        case 0 :
            cc_sethide(true);
            cc_setontimer(null);
        case 1 :
            cc_sethide(false);
            cc_setontimer("script5368(event_comsubid)");
        case 2 :
