// 590
[proc,script590](obj $obj0)
def_int $int1 = 0;
def_int $int2 = inv_size(woodcutting_woodbox);
def_obj $obj3 = null;
while ($int1 < $int2) {
    $obj3 = inv_getobj(woodcutting_woodbox, $int1);
    if ($obj3 ! null & oc_category($obj3) ! woodcutting_wood_spirit) {
        ~script1497($obj3, inv_getnum(woodcutting_woodbox, $int1));
    }
    $int1 = calc($int1 + 1);
}
