// 9748
[proc,script9748]
if_sethide(true, rand_entrance:2_recommended);
if_sethide(true, rand_entrance:3_recommended);
if_sethide(true, rand_entrance:4_recommended);
if_sethide(true, rand_entrance:5_recommended);
if_setgraphic(rs3_btn_radio_off, rand_entrance:option_1);
if_setgraphic(rs3_btn_radio_off, rand_entrance:option_2);
if_setgraphic(rs3_btn_radio_off, rand_entrance:option_3);
if_setgraphic(rs3_btn_radio_off, rand_entrance:option_4);
if_setgraphic(rs3_btn_radio_off, rand_entrance:option_5);
switch_int (%rand_temp_player_count) {
    case 1 :
        if_setgraphic(rs3_btn_radio_on, rand_entrance:option_1);
    case 2 :
        if_setgraphic(rs3_btn_radio_on, rand_entrance:option_2);
    case 3 :
        if_setgraphic(rs3_btn_radio_on, rand_entrance:option_3);
    case 4 :
        if_setgraphic(rs3_btn_radio_on, rand_entrance:option_4);
    case 5 :
        if_setgraphic(rs3_btn_radio_on, rand_entrance:option_5);
}
if (%rand_player_enabled_hardmode = 1 | %rand_temp_player_count = 1) {
    if_sethide(false, rand_entrance:option_1_layer_disabled);
    if (if_getgraphic(rand_entrance:option_1) = rs3_btn_radio_on) {
        if_setgraphic(rs3_btn_radio_on_disabled, rand_entrance:option_1_disabled);
    } else {
        if_setgraphic(rs3_btn_radio_off_disabled, rand_entrance:option_1_disabled);
    }
    if_sethide(false, rand_entrance:option_2_layer_disabled);
    if (if_getgraphic(rand_entrance:option_2) = rs3_btn_radio_on) {
        if_setgraphic(rs3_btn_radio_on_disabled, rand_entrance:option_2_disabled);
    } else {
        if_setgraphic(rs3_btn_radio_off_disabled, rand_entrance:option_2_disabled);
    }
    if_sethide(false, rand_entrance:option_3_layer_disabled);
    if (if_getgraphic(rand_entrance:option_3) = rs3_btn_radio_on) {
        if_setgraphic(rs3_btn_radio_on_disabled, rand_entrance:option_3_disabled);
    } else {
        if_setgraphic(rs3_btn_radio_off_disabled, rand_entrance:option_3_disabled);
    }
    if_sethide(false, rand_entrance:option_4_layer_disabled);
    if (if_getgraphic(rand_entrance:option_4) = rs3_btn_radio_on) {
        if_setgraphic(rs3_btn_radio_on_disabled, rand_entrance:option_4_disabled);
    } else {
        if_setgraphic(rs3_btn_radio_off_disabled, rand_entrance:option_4_disabled);
    }
    if_sethide(false, rand_entrance:option_5_layer_disabled);
    if (if_getgraphic(rand_entrance:option_5) = rs3_btn_radio_on) {
        if_setgraphic(rs3_btn_radio_on_disabled, rand_entrance:option_5_disabled);
    } else {
        if_setgraphic(rs3_btn_radio_off_disabled, rand_entrance:option_5_disabled);
    }
    if_setcolour(~rgb_to_hex(125, 125, 125), rand_entrance:option_1_text);
    if_setcolour(~rgb_to_hex(125, 125, 125), rand_entrance:option_2_text);
    if_setcolour(~rgb_to_hex(125, 125, 125), rand_entrance:option_3_text);
    if_setcolour(~rgb_to_hex(125, 125, 125), rand_entrance:option_4_text);
    if_setcolour(~rgb_to_hex(125, 125, 125), rand_entrance:option_5_text);
} else {
    if_sethide(true, rand_entrance:option_1_layer_disabled);
    if_sethide(true, rand_entrance:option_2_layer_disabled);
    if_sethide(true, rand_entrance:option_3_layer_disabled);
    if_sethide(true, rand_entrance:option_4_layer_disabled);
    if_sethide(true, rand_entrance:option_5_layer_disabled);
    if_setcolour(~rgb_to_hex(255, 255, 255), rand_entrance:option_1_text);
    if_setcolour(~rgb_to_hex(255, 255, 255), rand_entrance:option_2_text);
    if_setcolour(~rgb_to_hex(255, 255, 255), rand_entrance:option_3_text);
    if_setcolour(~rgb_to_hex(255, 255, 255), rand_entrance:option_4_text);
    if_setcolour(~rgb_to_hex(255, 255, 255), rand_entrance:option_5_text);
    switch_int (%rand_temp_player_count) {
        case 2 :
            if_sethide(false, rand_entrance:option_3_layer_disabled);
            if_setcolour(~rgb_to_hex(125, 125, 125), rand_entrance:option_3_text);
            if_sethide(false, rand_entrance:option_4_layer_disabled);
            if_setcolour(~rgb_to_hex(125, 125, 125), rand_entrance:option_4_text);
            if_sethide(false, rand_entrance:option_5_layer_disabled);
            if_setcolour(~rgb_to_hex(125, 125, 125), rand_entrance:option_5_text);
            if_sethide(false, rand_entrance:2_recommended);
        case 3 :
            if_sethide(false, rand_entrance:option_4_layer_disabled);
            if_setcolour(~rgb_to_hex(125, 125, 125), rand_entrance:option_4_text);
            if_sethide(false, rand_entrance:option_5_layer_disabled);
            if_setcolour(~rgb_to_hex(125, 125, 125), rand_entrance:option_5_text);
            if_sethide(false, rand_entrance:3_recommended);
        case 4 :
            if_sethide(false, rand_entrance:option_5_layer_disabled);
            if_setcolour(~rgb_to_hex(125, 125, 125), rand_entrance:option_5_text);
            if_sethide(false, rand_entrance:4_recommended);
        case 5 :
            if_sethide(false, rand_entrance:5_recommended);
    }
}
