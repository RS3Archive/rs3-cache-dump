while ($int6 < $int1) {
    $int9 = calc($int7 * $int3);
    $int10 = calc($int8 * $int4);
    $int11 = calc($int6 * 4);
    if (cc_find($component0, $int11) = true) {
        cc_setposition($int9, $int10, ^setpos_abs_left, ^setpos_abs_top);
    }
    if (cc_find($component0, calc($int11 + 1)) = true) {
        cc_setposition(calc($int9 + $int5), calc($int10 + ($int4 - cc_getheight) / 2), ^setpos_abs_left, ^setpos_abs_top);
        if (.cc_find($component0, calc($int11 + 2)) = true) {
