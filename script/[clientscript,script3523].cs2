// 3523
[clientscript,script3523]
cc_deleteall(currency:fav_invslot_layer_1);
cc_deleteall(currency:fav_obj_layer_1);
cc_deleteall(currency:fav_text_layer_1);
def_dbrow $dbrow0 = null;
def_int $int1 = 0;
def_int $int2 = calc($int1 % 2 * 55);
def_int $int3 = calc($int1 / 2 * 63);
def_obj $obj4 = null;
def_string $string0 = "";
def_string $string1 = "";
while ($int1 < 8) {
    $int2 = calc($int1 % 2 * 55);
    $int3 = calc($int1 / 2 * 63);
    $dbrow0 = ~script14968(calc($int1 + 1));
    cc_create(currency:fav_invslot_layer_1, ^iftype_graphic, $int1);
    cc_setsize(40, 40, ^setsize_abs, ^setsize_abs);
    cc_setposition(calc($int2 + 7), $int3, ^setpos_abs_left, ^setpos_abs_top);
    cc_setgraphic("rs3_icon_slot_40px,0");
    if ($dbrow0 ! null) {
        cc_create(currency:fav_obj_layer_1, ^iftype_graphic, $int1);
        cc_setsize(38, 38, ^setsize_abs, ^setsize_abs);
        cc_setposition(calc($int2 + 8), calc($int3 + 1), ^setpos_abs_left, ^setpos_abs_top);
        cc_setonmouserepeat("currency_draw_tooltip($dbrow0, event_com, event_comsubid)");
        cc_setonop("script1620(event_com, event_comsubid, 100, 0, 8)");
        cc_setop(1, "Clear");
        if (string_length(db_getfield($dbrow0, currency_table:col8, 0)) ! 0) {
            cc_setop(2, db_getfield($dbrow0, currency_table:col8, 0));
        } else {
            cc_setop(2, "");
        }
        if (string_length(db_getfield($dbrow0, currency_table:col9, 0)) ! 0) {
            cc_setop(3, db_getfield($dbrow0, currency_table:col9, 0));
        } else {
            cc_setop(3, "");
        }
        if (db_getfield($dbrow0, currency_table:col1, 0) = 1) {
            cc_setop(4, "Withdraw");
            cc_setop(10, "Examine");
        }
        $obj4 = db_getfield($dbrow0, currency_table:col4, 0);
        $string1 = ~currency_name($dbrow0);
        if ($obj4 ! null) {
            cc_setobject_nonum($obj4, 1000);
            cc_setopbase("<~script4033($obj4)><$string1>");
        } else if (db_getfield($dbrow0, currency_table:col3, 0) ! null) {
            cc_setgraphic(db_getfield($dbrow0, currency_table:col3, 0));
            cc_setopbase("<~script4033(currency_pouch_dummy)><$string1>");
        }
        cc_create(currency:fav_text_layer_1, ^iftype_text, $int1);
        cc_setsize(55, 11, ^setsize_abs, ^setsize_abs);
        if ($int2 = 0) {
            cc_setposition(0, calc($int3 + 44), ^setpos_abs_left, ^setpos_abs_top);
        } else {
            cc_setposition(0, calc($int3 + 44), ^setpos_abs_right, ^setpos_abs_top);
        }
        cc_settextfont(museo_sans_13pt_bold);
        cc_settextalign(^settextalign_centre, ^settextalign_bottom, 0);
        cc_setcolour(~script10495(3));
        cc_settextshadow(true);
        if ($dbrow0 = currency_livid_points) {
            cc_settext(~script11601(calc(~currency_pouch_total($dbrow0) * 10), true));
        } else {
            cc_settext(~script11601(~currency_pouch_total($dbrow0), true));
        }
        cc_setonvartransmit("script6719(event_com, event_comsubid, 0){toplevel_v2_skins_varp}");
    }
    $int1 = calc($int1 + 1);
}
