// 10789
[clientscript,player_inspect_status_onload](component $component0, component $component1, component $component2, component $component3)
~script10428($component0, $component1, player_inspect_status_options, calc(enum_getoutputcount(player_inspect_status_options) - 1), "Select a status", %player_inspect_status_id, 0);
~script10428($component2, $component3, player_inspect_privacy_settings, calc(enum_getoutputcount(player_inspect_privacy_settings) - 1), "Prevent other players from viewing your worn items, combat stats and skills.", %player_inspect_privacy, 0);
