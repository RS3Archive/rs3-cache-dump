[proc,script5110](int $int0)
if ($int0 = 1) {
    if_sethide(false, clan_signpost:settings_tab_selected_layer);
    if_sethide(true, clan_signpost:details_tab_selected_layer);
    if_sethide(false, clan_signpost:edit_layer);
