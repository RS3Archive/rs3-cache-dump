// 9498
[proc,script9498]
if (%6awe2_pvp_warning_type = 1) {
    if_settext("War map teleport enabled in <tostring(calc((%6awe2_pvp_warning_state + 49) / 50))>s", 6awe2_hud:popup_text);
} else if (%6awe2_pvp_small_warnings = 1) {
    if_settext("PvP will be enabled in <tostring(calc((%6awe2_pvp_warning_state + 49) / 50))>s", 6awe2_hud:popup_text);
} else {
    if_settext("You have entered a PvP area and have your PvP toggle turned on.<br><br>PvP will be enabled in <tostring(calc((%6awe2_pvp_warning_state + 49) / 50))>s.", 6awe2_hud:popup_text);
}
