// 9498
[proc,script9498]
if (%varclient_3892 = 1) {
    if_settext("War map teleport enabled in <tostring(calc((%varclient_3891 + 49) / 50))>s", interface_749:com_70);
} else if (%varplayerbit_21127 = 1) {
    if_settext("PvP will be enabled in <tostring(calc((%varclient_3891 + 49) / 50))>s", interface_749:com_70);
} else {
    if_settext("You have entered a PvP area and have your PvP toggle turned on.<br><br>PvP will be enabled in <tostring(calc((%varclient_3891 + 49) / 50))>s.", interface_749:com_70);
}
