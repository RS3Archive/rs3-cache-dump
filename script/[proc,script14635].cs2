// 14635
[proc,script14635](dbrow $dbrow0)(graphic)
if ($dbrow0 = null) {
    return(null);
}
def_graphic $graphic1 = db_getfield($dbrow0, arch_research:col5, 0);
if ($graphic1 ! null) {
    return($graphic1);
}
def_dbrow $dbrow2 = db_getfield($dbrow0, arch_research:col2, 0);
switch_dbrow ($dbrow2) {
    case arch_site_kharidet :
        return(arch_research_site_banner_kharidet);
    case arch_site_everlight :
        return(arch_research_site_banner_everlight);
    case arch_site_infernalsource :
        return(arch_research_site_banner_infernalsource);
    case arch_site_stormguard :
        return(arch_research_site_banner_stormguard);
    case arch_site_warforge :
        return(arch_research_site_banner_warforge);
    case arch_site_orthen :
        return(arch_research_site_banner_orthen);
    case arch_site_senntisten :
        return(arch_research_site_banner_senntisten);
    case arch_site_daemonheim :
        return(arch_research_site_banner_daemonheim);
    case arch_site_moonrise :
        return(arch_research_site_banner_moonrise);
}
return(arch_research_site_banner_guild);
