// 10753
[proc,script10753]
def_string $string0 = "";
if (%elfcity_hefin_course_checkpoint > 0) {
    $string0 = append($string0, "Checkpoint: ");
    $string0 = append($string0, "<tostring(%elfcity_hefin_course_checkpoint)>/<tostring(6)><br>");
}
def_string $string1 = tostring(%elfcity_hefin_course_laps);
if (%elfcity_title_hefin = 1) {
    $string1 = "200+";
}
$string0 = append($string0, "Completed laps: ");
$string0 = append($string0, $string1);
if_setonmouserepeat("script8799($string0, event_com, event_comsubid)", elfcity_hefin_course_overlay:time);
if_setontimer("script10921", elfcity_hefin_course_overlay:time);
