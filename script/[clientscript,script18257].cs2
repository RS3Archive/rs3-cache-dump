// 18257
[clientscript,script18257]
def_int $int0 = %omge_job_interface_slot_rerolled;
if ($int0 = 0) {
    return;
}
def_int $int1 = ~script16500($int0);
def_struct $struct2 = ~script16319($int0);
if_settext(~challenge_name($struct2), jobs_main:reroll_confirm_current_name);
if_settext(~challenge_details($struct2, $int1), jobs_main:reroll_confirm_current_desc);
if_setgraphic(struct_param($struct2, task_icon), jobs_main:reroll_confirm_current_skill_icon);
if ($int1 = 1) {
    if_settext("You've extended your current challenge.", jobs_main:reroll_confirm_current_disclaimer);
    if_settext("<col=ff0000>Your new challenge will not be extended.</col>", jobs_main:reroll_confirm_new_disclaimer);
} else {
    if_settext("This is your current challenge.", jobs_main:reroll_confirm_current_disclaimer);
    if_settext("This is the new challenge you rolled for <tostring(10)> vis wax.", jobs_main:reroll_confirm_new_disclaimer);
}
if (%omge_double_daily_challenges_active = 1 & %challenge_returner_active = 0) {
    if_settext("<col=00ff00>Due to a current event, re-rolling this challenge will also extend it.</col>", jobs_main:reroll_confirm_new_disclaimer);
}
