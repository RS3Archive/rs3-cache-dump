// 18307
[proc,script18307](int $int0)(int)
if (%accessibility_high_contrast_enabled = 0) {
    switch_int ($int0) {
        case 0 :
            return(%accessibility_highlight_active_player_colour);
        case 1 :
            return(%accessibility_highlight_other_player_colour);
        case 2 :
            return(%accessibility_highlight_other_player_colour);
        case 3 :
            return(%accessibility_highlight_npc_colour);
        case 4 :
            return(%accessibility_highlight_monster_colour);
        case 5 :
            return(%accessibility_highlight_interactables_colour);
        case 6 :
            return(%accessibility_highlight_loot_colour);
        case 7 :
            return(%accessibility_highlight_loot_colour);
        case default :
            ~error("Invalid highlight ID received when getting highlight colour: <tostring($int0)>");
    }
} else {
    switch_int ($int0) {
        case 0 :
            return(%accessibility_high_contrast_highlight_active_player_colour);
        case 1 :
            return(%accessibility_high_contrast_highlight_other_player_colour);
        case 2 :
            return(%accessibility_high_contrast_highlight_other_player_colour);
        case 3 :
            return(%accessibility_high_contrast_highlight_npc_colour);
        case 4 :
            return(%accessibility_high_contrast_highlight_monster_colour);
        case 5 :
            return(%accessibility_high_contrast_highlight_interactables_colour);
        case 6 :
            return(%accessibility_high_contrast_highlight_loot_colour);
        case 7 :
            return(%accessibility_high_contrast_highlight_loot_colour);
        case default :
            ~error("Invalid highlight ID received when getting highlight colour: <tostring($int0)>");
    }
}
