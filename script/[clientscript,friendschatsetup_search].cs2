// 11982
[clientscript,friendschatsetup_search]
if (%p_dialog_mode <= 0) {
    ~script11983;
    %p_dialog_listener = friendschatsetup:text_input_listener;
    %p_dialog_mode = 8;
    %p_dialog_maxchar = 40;
    ~script11985("", clientclock);
    ~script9833(friendschatsetup:text_input_listener, friendschatsetup:text_input_listen, friendschatsetup:text_input_caret, friendschatsetup:text_input_display, friendschatsetup:text_input_clickout, 0, 0);
    if_setonclick("script7205(friendschatsetup:text_input_listener, friendschatsetup:text_input_listen, friendschatsetup:text_input_caret, friendschatsetup:text_input_display, friendschatsetup:mainmodal_window_close_button)", friendschatsetup:mainmodal_window_close_button);
}
