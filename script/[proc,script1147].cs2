// 1147
[proc,script1147](component $component0)
if (platformtype ! ^platformtype_default & platformtype ! ^platformtype_jagex) {
    return;
}
cc_create($component0, ^iftype_graphic, if_getnextsubid($component0));
cc_setgraphic(rs3_icon_external_link);
cc_settrans(127);
cc_setsize(16, 16, ^setsize_abs, ^setsize_abs);
cc_setposition(calc(cc_getwidth / 2), calc(cc_getwidth / 2), ^setpos_abs_left, ^setpos_abs_bottom);
