if_setondragcomplete("script12133(8, event_com2)", invent_discovery:part_icon_8);
if_setondragcomplete("script12133(9, event_com2)", invent_discovery:part_icon_9);
if_setonop("invent_discovery_clear_slot(0)", invent_discovery:blueprint_icon_layer_0);
if_setonop("invent_discovery_clear_slot(1)", invent_discovery:blueprint_icon_layer_1);
if_setonop("invent_discovery_clear_slot(2)", invent_discovery:blueprint_icon_layer_2);
