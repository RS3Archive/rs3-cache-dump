// 15415
[proc,script15415](component $component0, int $int1, obj $obj2)
def_string $string0 = "";
def_int $int3 = 0;
switch_component ($component0) {
    case trh193_overlay:min_multiplier_tooltip_layer, trh193_overlay:min_tooltip_layer :
        $string0 = "These bonuses <col=FF00>increase any multipliers on the trail to a minimum multiplier</col>, up to <col=FF00>x<tostring($int1)></col>!";
    case trh193_overlay:increase_multiplier_tooltip_layer, trh193_overlay:plus_tooltip_layer :
        $string0 = "These bonuses <col=FF00>increase any multipliers on the trail by up to <tostring($int1)></col>! (max multiplier: x<tostring(8)>).";
    case trh193_overlay:currency_tooltip_layer :
        $string0 = "<col=FFFF00>Curios</col> are obtained with each key.<br>You can buy a <col=FF00>Curio Bonus</col> every <col=FFFF00><tostring(400)> Curios</col>.";
    case trh193_overlay:reward_1 :
        switch_obj ($obj2) {
            case xmas25_wrapping_paper :
                $string0 = "Various quantities of Christmas Wrapping Paper.";
            case default :
                $string0 = oc_name($obj2);
        }
        $int3 = 1;
}
if (~script6431 = false) {
    if ($int3 = 1 & oc_param($obj2, mtxmgt_item_struct) ! null) {
        if (if_find($component0) = true) {
            ~script14994(null, null, -1, $obj2, mtxmgt_store_temp, 1);
        }
    } else {
        if_setonmouserepeat("script8801($string0, event_com, event_comsubid, ^settextalign_left, ^settextalign_centre, 12)", $component0);
        if_setonmouseleave("script8805", $component0);
    }
} else {
    if_setop(1, "Info", $component0);
    if_setonop("script7774($string0, event_com, event_comsubid, 0)", $component0);
}
