// 10569
[clientscript,script10569]
if (%trh29_jolly_roger_owned = 1) {
    return;
}
if (inv_total(inv, trh29_doubloons) < 2000) {
    return;
}
if (inv_freespace(inv) = 0) {
    return;
}
%trh29_pirate_coins_shop_selection = 3;
if_setgraphic(trh29_pirate_icon_cape, trh29_pirate_coins_shop:popup_icon);
if_settext("A cape fashioned from a Jolly Roger flag. (No combat stats)", trh29_pirate_coins_shop:popup_description);
if_settext("Buy Jolly Roger cape?", trh29_pirate_coins_shop:popup_question);
if_sethide(false, trh29_pirate_coins_shop:popup_layer);
