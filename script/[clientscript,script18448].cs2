// 18448
[clientscript,script18448](component $component0)
db_listall(buff_select_interface_components);
def_dbrow $dbrow1 = db_findnext;
def_component $component2 = null;
while ($dbrow1 ! null) {
    $component2 = db_getfield($dbrow1, buff_select_interface_components:col1, 0);
    if (if_find($component2) = true) {
        if ($component2 = $component0) {
            cc_button_settoggled(true);
            %buff_select_event_interface_button_selected = db_getfield($dbrow1, buff_select_interface_components:col0, 0);
        } else {
            cc_button_settoggled(false);
        }
    }
    $dbrow1 = db_findnext;
}
