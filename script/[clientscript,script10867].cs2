// 10867
[clientscript,script10867](component $component0)
def_int $int1 = max(0, calc(if_getwidth(xmas2014_snowboard_presents:presents_layer) / 2 - 180 + randominc(270)));
def_int $int2 = max(0, calc(if_getheight(xmas2014_snowboard_presents:presents_layer) / 2 - 180 + randominc(270)));
if_setsize(1, 1, ^setsize_abs, ^setsize_abs, $component0);
if_setposition($int1, $int2, ^setpos_abs_left, ^setpos_abs_top, $component0);
if_sethide(false, $component0);
if_setontimer("script10868($component0)", $component0);
