// 15326
[clientscript,script15326](component $component0, int $int1, int $int2)
def_int $int3 = 0;
def_string $string0 = "";
def_string $string1 = "";
if (cc_find($component0, $int1) = true) {
    if (calc($int2 % 100) = 0) {
        $int2 = 0;
        $int3 = achievement_total_runescore;
        $string0 = tostring_localised($int3, true);
        $string1 = "Your current RuneScore is <$string0>";
        cc_settext($string0);
        cc_setonmouserepeat("script3876($string1, event_com, event_comsubid)");
    } else {
        $int2 = calc($int2 + 1);
    }
    cc_setontimer("script15326(event_com, cc_getid, $int2)");
}
