// 716
[clientscript,hist_key_over](component $component0)
if ($component0 = hist_interface_key:head_layer) {
    if_setmodel(hist_if_key_complete_head_glow, hist_interface_key:keymodel);
    sound_synth(hist_key_rub_present, 1, 0);
} else if ($component0 = hist_interface_key:shaft_layer) {
    if_setmodel(hist_if_key_complete_shaft_glow, hist_interface_key:keymodel);
    sound_synth(hist_key_rub_past_b, 1, 0);
} else if ($component0 = hist_interface_key:teeth_layer) {
    if_setmodel(hist_if_key_complete_teeth_glow, hist_interface_key:keymodel);
    sound_synth(hist_key_rub_past_a, 1, 0);
}
