// 716
[clientscript,hist_key_over](component $component0)
if ($component0 = interface_774:com_1) {
    if_setmodel(model_41312, interface_774:com_0);
    sound_synth(sound_35321, 1, 0);
} else if ($component0 = interface_774:com_2) {
    if_setmodel(model_41303, interface_774:com_0);
    sound_synth(sound_29288, 1, 0);
} else if ($component0 = interface_774:com_3) {
    if_setmodel(model_41305, interface_774:com_0);
    sound_synth(sound_32773, 1, 0);
}
