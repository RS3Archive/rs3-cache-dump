// 11448
[clientscript,script11448]
if_setsize(stringwidth("Thaler:", museo_sans_13pt_regular), 0, ^setsize_abs, ^setsize_minus, spotlight:rupees_text);
if_setposition(calc(if_getx(spotlight:rupees_text) + if_getwidth(spotlight:rupees_text) + 5), 0, ^setpos_abs_left, ^setpos_abs_centre, spotlight:rupees_icon);
if_setposition(calc(if_getx(spotlight:rupees_icon) + if_getwidth(spotlight:rupees_icon) + 5), 0, ^setpos_abs_left, ^setpos_abs_centre, spotlight:player_currency);
if_settext(tostring(%spotlight_currency), spotlight:player_currency);
