[clientscript,script18450]
if (%buff_select_event_tutorial_seen = 1) {
    sound_vorbis_rate(tli_close_child_01, 1, 0, 255, random_sound_pitch(25, 25));
    if_sethide(true, buff_select_event:popup_layer);
    if_sethide(true, buff_select_event:tutorial_window_layer);
    if_sethide(true, buff_select_event:buff_confirm_window_layer);
}
