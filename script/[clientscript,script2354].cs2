[clientscript,script2354]
switch_int (%email_validation_validated) {
    case 1 :
        if_sethide(true, lobbyscreen:email_validation);
        if_sethide(true, lobbyscreen:input);
        if_setonvartransmit(null, lobbyscreen:base);
    case 2 :
        ~script5940;
    case default :
        return;
}
