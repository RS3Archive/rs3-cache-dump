// 8879
[clientscript,script8879]
if (if_find(toplevel_v2_targeting:hover_info) = true) {
    cc_setparam_int(toplevel_v2_hover_info_timeout, 5);
}
def_int $int0 = 0;
def_int $int1 = 0;
if (%toplevel_v2_hover_layer_npc_in_focus = 0) {
    $int1 = max(calc(if_getx(toplevel_v2_hover_target:level_layer) + if_getwidth(toplevel_v2_hover_target:level_layer)), if_getwidth(toplevel_v2_hover_target:target_health_bar_layer));
    $int0 = calc(if_gety(toplevel_v2_hover_target:target_health_bar_layer) + if_getheight(toplevel_v2_hover_target:target_health_bar_layer));
    if_setsize($int1, $int0, ^setsize_abs, ^setsize_abs, toplevel_v2_targeting:hover_info);
}
