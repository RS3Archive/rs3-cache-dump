// 11193
[clientscript,toolbelt_show_settings]
if_setobject(rand_herb_burner, -1, toolbelt_v2:herbicide_button_graphic);
if_setobject(6awe3_seedicide, -1, toolbelt_v2:seedicide_button_graphic);
if_setobject(rand_reward_charming_imp, -1, toolbelt_v2:charmimp_button_graphic);
if_setobject(rand_reward_bonecrusher, -1, toolbelt_v2:bonecrusher_button_graphic);
if_setobject(rand_reward_gold_acc_adv, -1, toolbelt_v2:gold_acc_button_graphic);
if_setobject(favour_key_ring, -1, toolbelt_v2:keyring_button_graphic);
if (%toolbelt_gold_acc_enabled = 1) {
    if_setgraphic("aif_tick_cross_icon,0", toolbelt_v2:gold_acc_enabled);
} else {
    if_setgraphic("aif_tick_cross_icon,1", toolbelt_v2:gold_acc_enabled);
}
if_sethide(false, toolbelt_v2:settings_choice);
