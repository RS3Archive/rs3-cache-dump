// 19153
[proc,script19153](struct $struct0)(boolean)
switch_struct ($struct0) {
    case trh182_promo :
        if (%trh182_monster_health <= 0) {
            return(true);
        }
    case trh203_promo :
        if (%trh203_node_progress_remaining <= 0) {
            return(true);
        }
    case trh207_promo :
        if (%trh207_node_progress_remaining <= 0) {
            return(true);
        }
    case default :
        ~error("Missed plugin point for promo ID <tostring(struct_param($struct0, trh_promo_id))>");
}
return(false);
