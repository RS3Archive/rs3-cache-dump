// 18322
[clientscript,script18322]
if_sethide(true, activity_progress_bar_extension:container);
if_setposition(0, 40, ^setpos_abs_centre, ^setpos_abs_top, activity_progress_bar:suboverlay_layer);
if_setposition(0, 0, ^setpos_abs_centre, ^setpos_abs_top, activity_progress_bar_extension:main_window);
if_setsize(118, 99, ^setsize_minus, ^setsize_abs, activity_progress_bar:suboverlay_layer);
