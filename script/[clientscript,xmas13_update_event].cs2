// 9563
[clientscript,xmas13_update_event]
switch_int (%xmas13_current_boosted_event) {
    case 0 :
        if_settext("Reindeer petting zoo", xmas13_overlay:event);
    case 1 :
        if_settext("Snowball arena", xmas13_overlay:event);
    case 2 :
        if_settext("Wizards' banquet", xmas13_overlay:event);
}
