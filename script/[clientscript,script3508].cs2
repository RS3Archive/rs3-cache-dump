// 3508
[clientscript,script3508]
if (~is_mobile_client = false & inv_total(inv, rotten_potato) = 0) {
    return;
}
if (%ironman_enabled = 1) {
    if_sethide(true, mobile_founders_pack:layer_day_2);
    if_sethide(true, mobile_founders_pack:layer_day_3);
    if_setposition(0, 0, ^setpos_abs_centre, ^setpos_abs_centre, mobile_founders_pack:layer_day_1);
}
if (%mobile_founders_first_login_runeday > 0) {
    if_settext(~script3507(%mobile_founders_first_login_runeday), mobile_founders_pack:date_day_1);
    if_settext(~script3507(calc(%mobile_founders_first_login_runeday + 7)), mobile_founders_pack:date_day_2);
    if_settext(~script3507(calc(%mobile_founders_first_login_runeday + 14)), mobile_founders_pack:date_day_3);
} else {
    if_settext("Unavailable - Please log out and in.", mobile_founders_pack:date_day_1);
    if_settext("Unavailable - Please log out and in.", mobile_founders_pack:date_day_2);
    if_settext("Unavailable - Please log out and in.", mobile_founders_pack:date_day_3);
}
if_settext("Radiant Dawn Armour<br>Immobile Rest<br>Steel Panther Pet", mobile_founders_pack:rewards_day_1);
if_settext("4x Large Protean Pack", mobile_founders_pack:rewards_day_2);
if_settext("Huge Lamp Chest", mobile_founders_pack:rewards_day_3);
~script3535;
