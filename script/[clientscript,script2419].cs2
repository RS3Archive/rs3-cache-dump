// 2419
[clientscript,script2419]
if (%peng_rak_eng_state > 0) {
    if_sethide(true, peng_rak_engine:wirebox_cover);
}
if (%peng_rak_eng_state > 1) {
    if_setmodel(peng_rak_panel_wires_cut, peng_rak_engine:wirebox);
}
if (%peng_rak_eng_state > 2) {
    if (%peng_rak_quest = 75) {
        if_setmodel(peng_rak_panel_wires_wire, peng_rak_engine:wirebox);
        if_sethide(true, peng_rak_engine:sparewire);
    } else {
        if_setmodel(peng_rak_panel_wires_eel, peng_rak_engine:wirebox);
        if_sethide(true, peng_rak_engine:eel);
    }
}
if (%peng_rak_eng_state > 3) {
    if (%peng_rak_quest = 75) {
        if_setmodel(peng_rak_panel_wires_tape, peng_rak_engine:wirebox);
        if_sethide(true, peng_rak_engine:tape);
    } else {
        if_setmodel(peng_rak_panel_wires_seaweed, peng_rak_engine:wirebox);
        if_sethide(true, peng_rak_engine:seaweed);
        if_setop(1, "Inspect", peng_rak_engine:wirebox);
    }
}
if (%peng_rak_gauge = 0) {
    if_setmodelanim(peng_rak_dial_left_red, peng_rak_engine:gauge);
} else if (%peng_rak_gauge = 1) {
    if_setmodelanim(peng_rak_dial_left_orange, peng_rak_engine:gauge);
} else if (%peng_rak_gauge = 2) {
    if_setmodelanim(peng_rak_dial_left_yellow, peng_rak_engine:gauge);
} else if (%peng_rak_gauge = 3) {
    if_setmodelanim(peng_rak_dial_green, peng_rak_engine:gauge);
} else if (%peng_rak_gauge = 4) {
    if_setmodelanim(peng_rak_dial_right_yellow, peng_rak_engine:gauge);
} else if (%peng_rak_gauge = 5) {
    if_setmodelanim(peng_rak_dial_right_orange, peng_rak_engine:gauge);
} else if (%peng_rak_gauge = 6) {
    if_setmodelanim(peng_rak_dial_right_red, peng_rak_engine:gauge);
}
