// 8407
[proc,script8407](component $component0)(int)
def_int $int1 = if_getx($component0);
def_component $component2 = if_getparentlayer($component0);
if ($component2 = null) {
    return($int1);
}
while (if_getparentlayer($component2) ! null) {
    $int1 = calc($int1 + if_getx($component2) - if_getscrollx($component2));
    $component2 = if_getparentlayer($component2);
}
return($int1);
