// 5582
[clientscript,script5582](component $component0, component $component1, component $component2)
def_int $int3 = 240;
if (string_length(if_gettext($component1)) > 0) {
    $int3 = calc(parawidth(if_gettext($component1), 500, museo_sans_11pt_regular) + 80);
    if ($int3 > if_getwidth($component0)) {
        if_setsize($int3, 18, ^setsize_abs, ^setsize_abs, choice_v2_frem:option_1);
        if_setsize($int3, 18, ^setsize_abs, ^setsize_abs, choice_v2_frem:option_2);
        if_setsize($int3, 18, ^setsize_abs, ^setsize_abs, choice_v2_frem:option_3);
        if_setsize($int3, 18, ^setsize_abs, ^setsize_abs, choice_v2_frem:option_4);
    }
    ~script4481($component1);
    ~script4481($component2);
    if_setontimer(null, $component0);
}
