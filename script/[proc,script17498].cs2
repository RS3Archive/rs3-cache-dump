// 17498
[proc,script17498](int $int0)(string)
switch_int ($int0) {
    case default :
        ~error("necro_ritual_site_tier_to_string_get - no site tier found! %necro_ritual_site_tier is <tostring(%necro_ritual_site_tier)>.");
        return("Tier 1");
    case 0 :
        return("Tier 1");
    case 1 :
        return("Tier 2");
    case 2 :
        return("Tier 3");
}
