// 12395
[clientscript,script12395](component $component0, int $int1)
def_int $int2 = 0;
switch_int ($int1) {
    case 0 :
        $int2 = %gwd2_sliske_boss_buffbar_mania;
    case 2 :
        $int2 = %gwd2_sliske_boss_buffbar_rage;
    case 1 :
        $int2 = %gwd2_sliske_boss_buffbar_delirium;
}
if ($int2 > 0) {
    if_settrans(0, $component0);
