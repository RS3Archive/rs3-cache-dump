// 11425
[proc,script11425](component $component0)(component)
def_component $component1 = null;
def_component $component2 = null;
if ($component0 = null) {
    return(null);
}
if (if_find($component0) = true & cc_param(param_8102) = true) {
    $component1 = cc_param(param_8101);
    if ($component1 = null) {
        return(null);
    }
    if (.if_find($component1) = true) {
        $component2 = .cc_param(param_8105);
        .cc_setparam(param_8103, null);
        .cc_setparam(param_8105, null);
        cc_setparam(param_8101, $component2);
        if (.if_find($component2) = true) {
            .cc_setparam(param_8103, $component0);
        }
    }
}
return($component1);
