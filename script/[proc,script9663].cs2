// 9663
[proc,script9663]()(string)
def_int $int0 = stat_base(slayer);
def_int $int1 = 0;
def_int $int2 = 0;
if ($int0 >= 35) {
    return("Runes for 250 casts of Slayer Dart.");
} else {
    if ($int0 < 5) {
        $int1 = 50;
        $int2 = 450;
    } else if ($int0 < 15) {
        $int1 = 100;
        $int2 = 525;
    } else if ($int0 < 25) {
        $int1 = 150;
        $int2 = 600;
    } else if ($int0 < 35) {
        $int1 = 200;
        $int2 = 675;
    }
    return("<tostring($int1)> death runes and <tostring($int2)> air runes.");
}
