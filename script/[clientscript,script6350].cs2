// 6350
[clientscript,script6350]
if_setgraphic("close_buttons,4", sliske1_riddle:sliske1_shadow_button);
if_setgraphic("close_buttons,4", sliske1_riddle:sliske1_sand_button);
if_setgraphic("close_buttons,4", sliske1_riddle:sliske1_fire_button);
if_setgraphic("close_buttons,4", sliske1_riddle:sliske1_time_button);
if_setgraphic("close_buttons,4", sliske1_riddle:sliske1_water_button);
if_setgraphic("close_buttons,4", sliske1_riddle:sliske1_life_button);
if_setgraphic("close_buttons,4", sliske1_riddle:sliske1_death_button);
if_setgraphic("close_buttons,4", sliske1_riddle:sliske1_light_button);
switch_int (%sliske1_answer_selected) {
    case 1 :
        if_setgraphic("close_buttons,6", sliske1_riddle:sliske1_shadow_button);
        if_settext("Shadow", sliske1_riddle:sliske1_riddle_text);
    case 2 :
        if_setgraphic("close_buttons,6", sliske1_riddle:sliske1_sand_button);
        if_settext("Sand", sliske1_riddle:sliske1_riddle_text);
    case 3 :
        if_setgraphic("close_buttons,6", sliske1_riddle:sliske1_fire_button);
        if_settext("Fire", sliske1_riddle:sliske1_riddle_text);
    case 4 :
        if_setgraphic("close_buttons,6", sliske1_riddle:sliske1_time_button);
        if_settext("Time", sliske1_riddle:sliske1_riddle_text);
    case 5 :
        if_setgraphic("close_buttons,6", sliske1_riddle:sliske1_water_button);
        if_settext("Water", sliske1_riddle:sliske1_riddle_text);
    case 6 :
        if_setgraphic("close_buttons,6", sliske1_riddle:sliske1_life_button);
        if_settext("Life", sliske1_riddle:sliske1_riddle_text);
    case 7 :
        if_setgraphic("close_buttons,6", sliske1_riddle:sliske1_death_button);
        if_settext("Death", sliske1_riddle:sliske1_riddle_text);
    case 8 :
        if_setgraphic("close_buttons,6", sliske1_riddle:sliske1_light_button);
        if_settext("Light", sliske1_riddle:sliske1_riddle_text);
}
