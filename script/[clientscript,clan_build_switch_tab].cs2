// 4772
[clientscript,clan_build_switch_tab](int $int0)
switch_int ($int0) {
    case 1 :
        if_sethide(false, clan_build_jobs:list_downgrade_tab);
        if_sethide(true, clan_build_jobs:list_upkeep_tab);
        if_sethide(true, clan_build_jobs:list_upgrade_tab);
        if_sethide(false, clan_build_jobs:downgrade_front_button);
        if_sethide(true, clan_build_jobs:upkeep_front_button);
        if_sethide(true, clan_build_jobs:upgrade_front_button);
        if_sethide(true, clan_build_jobs:list_downgrade_tab_active_layer);
        if_sethide(false, clan_build_jobs:list_upkeep_tab_active_layer);
        if_sethide(false, clan_build_jobs:list_upgrade_tab_active_layer);
    case 2 :
        if_sethide(true, clan_build_jobs:list_downgrade_tab);
        if_sethide(false, clan_build_jobs:list_upkeep_tab);
        if_sethide(true, clan_build_jobs:list_upgrade_tab);
        if_sethide(true, clan_build_jobs:downgrade_front_button);
        if_sethide(false, clan_build_jobs:upkeep_front_button);
        if_sethide(true, clan_build_jobs:upgrade_front_button);
        if_sethide(false, clan_build_jobs:list_downgrade_tab_active_layer);
        if_sethide(true, clan_build_jobs:list_upkeep_tab_active_layer);
        if_sethide(false, clan_build_jobs:list_upgrade_tab_active_layer);
    case 3 :
        if_sethide(true, clan_build_jobs:list_downgrade_tab);
        if_sethide(true, clan_build_jobs:list_upkeep_tab);
        if_sethide(false, clan_build_jobs:list_upgrade_tab);
        if_sethide(true, clan_build_jobs:downgrade_front_button);
        if_sethide(true, clan_build_jobs:upkeep_front_button);
        if_sethide(false, clan_build_jobs:upgrade_front_button);
        if_sethide(false, clan_build_jobs:list_downgrade_tab_active_layer);
        if_sethide(false, clan_build_jobs:list_upkeep_tab_active_layer);
        if_sethide(true, clan_build_jobs:list_upgrade_tab_active_layer);
}
~clan_build_clear_details;
return;
