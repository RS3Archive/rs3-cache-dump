// 969
[clientscript,script969](component $component0, int $int1)
def_int $int2 = calc(clientclock % 32);
if (cc_find($component0, $int1) = true) {
    if (~script970($int1) = 0) {
        if (cc_gettrans ! 0) {
            cc_settrans(0);
        } else {
            cc_setontimer(null);
        }
    } else if ($int2 < 8) {
        cc_settrans(0);
    } else if ($int2 < 16) {
        cc_settrans(85);
    } else if ($int2 < 24) {
        cc_settrans(255);
    } else {
        cc_settrans(85);
    }
}
