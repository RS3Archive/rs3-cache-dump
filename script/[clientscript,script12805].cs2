// 12805
[clientscript,script12805]
if_settext("Clue Scroll Rewards!", cs_week_2016_seasonal:clue_scroll_reward_title);
if_settext("For the duration of Customer Service Week, you can get a new clue scroll from Count Check every day!<br>Don't worry if you miss a day, though, as you'll be able to complete that clue on the following days!<br><br>The objects below are a small sample of the items you can potentially get from completing these clue scrolls!", cs_week_2016_seasonal:clue_scroll_reward_text);
if_settext("Security Rewards!", cs_week_2016_seasonal:pin_and_auth_reward_title);
if_settext("Throughout Customer Service Week, if you have a Bank PIN and Authenticator, you'll get lots of bonus rewards!<br> -If you have a bank PIN or Authenticator enabled, you'll receive one additional Treasure Hunter key, but if you've got both enabled you'll receive two! You'll also be entered into a competition to win membership, concept art & other prizes! <br> -If you boast your secure account to Count Check and he's impressed, he'll give you an extra XP lamp!<br> -When completing the Customer Service clue scrolls, if you have a secure account, you'll be able to open an extra casket every day!", cs_week_2016_seasonal:pin_and_auth_reward_text);
if_settext("Drop Rewards!", cs_week_2016_seasonal:drop_reward_title);
if_settext("This version of The Drop has customer service-themed questions, so get those security hats on!<br>The rewards you'll be able to get from The Drop are:<br><br> -A 'the Knowledgeable' title!<br> -A large XP lamp<br> -Entry into an exclusive Customer Service Week raffle!", cs_week_2016_seasonal:drop_reward_text);
