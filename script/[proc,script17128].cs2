// 17128
[proc,script17128](component $component0, component $component1, int $int2, int $int3, int $int4)
if ($int2 <= $int3) {
    if_setscrollsize(0, $int4, $component0);
    ~scrollbar_resize($component1, $component0, min(if_getscrolly($component0), $int4));
    if_sethide(false, $component1);
} else {
