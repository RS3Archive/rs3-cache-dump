// 823
[clientscript,trh149_init]
if (%trh149_milestone_progress >= 2) {
    if_setsize(74, 8, ^setsize_abs, ^setsize_abs, trh149:progress_bar_1);
    if_setgraphic(container_unlock_trh149_active, trh149:milestone_bg_1);
}
if (%trh149_milestone_progress >= 5) {
    if_setsize(87, 8, ^setsize_abs, ^setsize_abs, trh149:progress_bar_2);
    if_setgraphic(container_unlock_trh149_active, trh149:milestone_bg_2);
}
if (%trh149_milestone_progress >= 15) {
    if_setsize(126, 8, ^setsize_abs, ^setsize_abs, trh149:progress_bar_3);
    if_setgraphic(container_unlock_trh149_active, trh149:milestone_bg_3);
}
if (%trh149_milestone_progress >= 30) {
    if_setsize(147, 8, ^setsize_abs, ^setsize_abs, trh149:progress_bar_4);
    if_setgraphic(container_unlock_trh149_active, trh149:milestone_bg_4);
    return;
}
~trh149_bar_update;
