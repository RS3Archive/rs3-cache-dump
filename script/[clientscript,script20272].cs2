// 20272
[clientscript,script20272](int $int0)
def_int $int1 = calc((clientclock - $int0) / 50);
if ($int1 >= 5) {
    if_sethide(true, league_parent_relics:overview_confirm_unlock_spinner);
    if_settext("Activate Relic", league_parent_relics:overview_confirm_unlock);
    if_setenabled(true, league_parent_relics:overview_confirm_unlock);
    if_setontimer(null, league_parent_relics:overview_confirm_unlock);
    return;
}
if_settext("<tostring(calc(5 - $int1))>...", league_parent_relics:overview_confirm_unlock);
