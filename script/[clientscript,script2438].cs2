// 2438
[clientscript,script2438]
def_int $int0 = 0;
def_int $int1 = 0;
def_int $int2 = scale(%trawler_activity, 1000, 100);
if ($int2 > 100) {
    $int2 = 100;
}
if_setsize(if_getwidth(trawler_game_overlay:activity_bar_fill), scale($int2, 100, if_getheight(trawler_game_overlay:activity_bar_border)), ^setsize_abs, ^setsize_abs, trawler_game_overlay:activity_bar_fill);
if ($int2 < 25) {
    if_setcolour(0xff9900, trawler_game_overlay:activity_bar_fill);
} else {
    if_setcolour(0x006600, trawler_game_overlay:activity_bar_fill);
}
