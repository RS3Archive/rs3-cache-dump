// 19434
[clientscript,script19434](component $component0, int $int1, int $int2, graphic $graphic3, graphic $graphic4)
if (cc_findbycategory($component0, $int1, $int2) = 1) {
    cc_setgraphic($graphic4);
}
if (cc_findbycategory($component0, $int1, calc($int2 + 1)) = 1) {
    cc_setcolour(~script10495(1));
}
