[proc,script15483]
if (~script15469 = 0) {
    ~script1296("You cannot refresh without claiming at least one gem.");
    %trh173_refresh_confirmation_open = 0;
    ~if_sethide(trh173_overlay:refresh_confirmation, 1);
    return;
}
def_int $int0 = ~script15485;
~if_settext(trh173_overlay:refresh_information_text, "Refreshing will generate new prizes for each gem, and new rewards for completing each line.<br>It'll cost <tostring($int0)> oddments<br><br>Do you want to continue?");
