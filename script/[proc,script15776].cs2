    if_sethide(true, lore_stats_side:lore_pet_growth_button);
}
if (%lore_animal_hunger_percent = 101) {
    if_sethide(true, lore_stats_side:lore_pet_hunger_button);
}
if_setposition(0, ~script14445(-1279), ^setpos_abs_centre, ^setpos_rel_centre, lore_stats_side:lore_chathead);
if_sethide(true, lore_stats_side:time);
if_sethide(true, lore_stats_side:lore_renew_button);
if_sethide(true, lore_stats_side:lore_health_holder);
if_sethide(true, lore_stats_side:lore_spell_points_holder);
~script11727(0);
if_setposition(10, 44, ^setpos_abs_left, ^setpos_abs_top, lore_stats_side:call_animal_button);
