// 2129
[proc,script2129](quest $quest0)(int, string)
def_string $string0 = "";
def_int $int1 = 0;
if (quest_param($quest0, quest_requires_comlevel) > 0) {
    $int1 = 1;
    $string0 = ~script1164(~comlevel, quest_param($quest0, quest_requires_comlevel), "Combat Level <tostring(quest_param($quest0, quest_requires_comlevel))>");
    $string0 = "<$string0><br>";
}
return($int1, $string0);
