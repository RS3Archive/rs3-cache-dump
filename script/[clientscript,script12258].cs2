// 12258
[clientscript,script12258]
def_graphic $graphic0 = null;
def_graphic $graphic1 = null;
def_graphic $graphic2 = null;
def_obj $obj3 = null;
def_string $string0 = "";
def_string $string1 = "";
def_string $string2 = "";
def_string $string3 = "";
def_string $string4 = "";
def_string $string5 = "";
