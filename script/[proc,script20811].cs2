// 20811
[proc,script20811](component $component0, component $component1, component $component2)
switch_component ($component0) {
    case house_furniture_makex:items_bg :
        if_setonresize("script20770($component0, $component1, $component2)", $component0);
        if_callonresize($component0);
    case house_furniture_catalogue:items_bg :
        if_setonresize("script20749($component0, $component1, $component2)", $component0);
        if_callonresize($component0);
    case house_furniture_trunk:items_bg :
        if_setonresize("script20832($component0, $component1, $component2)", $component0);
        if_callonresize($component0);
    case default :
        ~error("Missing selected state plug-in.");
}
