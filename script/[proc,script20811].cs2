// 20811
[proc,script20811](component $component0, component $component1, component $component2, component $component3)
switch_component ($component0) {
    case interface_1516:com_25 :
        if_setonresize("script20770($component0, $component1, $component2)", $component0);
        if_callonresize($component0);
    case interface_1512:com_16 :
        if_setonresize("script20749($component0, $component1, $component2, $component3)", $component0);
        if_callonresize($component0);
    case interface_1518:com_12 :
        if_setonresize("script20832($component0, $component1, $component2)", $component0);
        if_callonresize($component0);
    case default :
        ~error("Missing selected state plug-in.");
}
