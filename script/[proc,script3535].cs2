// 3535
[proc,script3535]
if (%mobile_founders_one_day_received = 1) {
    ~script13971(mobile_founders_pack:button_layer_day_1, null, rs3tli_button_small, "Claimed", true);
} else if (%mobile_founders_first_login_runeday > 0 & %atlum_day_tracker >= %mobile_founders_first_login_runeday) {
    ~script13969(mobile_founders_pack:button_layer_day_1, null, rs3tli_button_small, "Claim");
} else {
    ~script13971(mobile_founders_pack:button_layer_day_1, null, rs3tli_button_small, "Claim", true);
}
if (%mobile_founders_seven_day_received = 1) {
    ~script13971(mobile_founders_pack:button_layer_day_2, null, rs3tli_button_small, "Claimed", true);
} else if (%mobile_founders_first_login_runeday > 0 & %atlum_day_tracker >= calc(%mobile_founders_first_login_runeday + 7)) {
    ~script13969(mobile_founders_pack:button_layer_day_2, null, rs3tli_button_small, "Claim");
} else {
    ~script13971(mobile_founders_pack:button_layer_day_2, null, rs3tli_button_small, "Claim", true);
}
if (%mobile_founders_fourteen_day_received = 1) {
    ~script13971(mobile_founders_pack:button_layer_day_3, null, rs3tli_button_small, "Claimed", true);
} else if (%mobile_founders_first_login_runeday > 0 & %atlum_day_tracker >= calc(%mobile_founders_first_login_runeday + 14)) {
    ~script13969(mobile_founders_pack:button_layer_day_3, null, rs3tli_button_small, "Claim");
} else {
    ~script13971(mobile_founders_pack:button_layer_day_3, null, rs3tli_button_small, "Claim", true);
}
