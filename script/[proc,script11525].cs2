// 11525
[proc,script11525]
if_setcolour(hsvtorgb(~script11527(%mtxmgt_temp_hue, %mtxmgt_temp_sat_val)), mtxmgt_colour_overlay:prismatic_preview);
~script11521(%mtxmgt_temp_hue);
if (%mtxmgt_colour_last_hue ! -1 & cc_find(mtxmgt_colour_overlay:prismatic_wheel_active, %mtxmgt_colour_last_hue) = true) {
    cc_sethide(true);
}
%mtxmgt_colour_last_hue = -1;
