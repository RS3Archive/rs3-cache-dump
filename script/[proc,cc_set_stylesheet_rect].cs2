// 10684
[proc,cc_set_stylesheet_rect](dbrow $dbrow0)
if ($dbrow0 = null) {
    return;
}
def_int $int1 = %toplevel_v2_active_skinset;
if (db_getfieldcount($dbrow0, interface_skin:col0) <= $int1) {
    $int1 = 0;
}
switch_stylesheet (db_getfield($dbrow0, interface_skin:col0, $int1)) {
    case rect_dark :
        cc_setcolour(0x2e2825);
        cc_setfill(true);
    case rect_dark_legacy :
        cc_setcolour(0x1b1915);
        cc_setfill(true);
    case rect_dark_mobile :
        cc_setcolour(0x161e3b);
        cc_setfill(true);
    case rect_light :
        cc_setcolour(0x24211e);
        cc_setfill(true);
    case rect_light_legacy :
        cc_setcolour(0x38312a);
        cc_setfill(true);
    case rect_light_mobile :
        cc_setcolour(0x152648);
        cc_setfill(true);
    case rect_medium :
        cc_setcolour(0x312018);
        cc_setfill(true);
    case rect_medium_legacy :
        cc_setcolour(0x38312a);
        cc_setfill(true);
    case rect_medium_mobile :
        cc_setcolour(0x192e57);
        cc_setfill(true);
    case rect_black :
        cc_setcolour(0x000405);
        cc_setfill(true);
    case rect_highlight :
        cc_setcolour(0x403c39);
        cc_setfill(true);
    case rect_highlight_legacy :
        cc_setcolour(0x3f3224);
        cc_setfill(true);
    case rect_highlight_mobile :
        cc_setcolour(0x292127);
        cc_setfill(true);
    case rect_highlight_outline :
        cc_setcolour(0x403c39);
        cc_setfill(false);
    case rect_highlight_outline_legacy :
        cc_setcolour(0x3f3224);
        cc_setfill(false);
    case rect_highlight_outline_mobile :
        cc_setcolour(0x292127);
        cc_setfill(false);
    case rect_outline :
        cc_setcolour(0x948378);
        cc_setfill(false);
    case rect_outline_legacy :
        cc_setcolour(0x4e3927);
        cc_setfill(false);
    case rect_outline_mobile :
        cc_setcolour(0x292127);
        cc_setfill(false);
    case rect_outline_error :
        cc_setcolour(0xeb2f2f);
        cc_setfill(false);
    case rect_outline_error_legacy :
        cc_setcolour(0xba2d14);
        cc_setfill(false);
    case rect_outline_error_mobile :
        cc_setcolour(0xeb2f2f);
        cc_setfill(false);
    case rect_outline_selected :
        cc_setcolour(0xf0be79);
        cc_setfill(false);
    case rect_outline_selected_legacy :
        cc_setcolour(0xff981f);
        cc_setfill(false);
    case rect_outline_selected_mobile :
        cc_setcolour(0xd9dba9);
        cc_setfill(false);
    case rect_selected :
        cc_setcolour(0x948378);
        cc_setfill(true);
    case rect_selected_legacy :
        cc_setcolour(0x4e3927);
        cc_setfill(true);
    case rect_selected_mobile :
        cc_setcolour(0x292127);
        cc_setfill(true);
    case rect_disabled_overlay_dark :
        cc_setcolour(~script10495(11));
        cc_setfill(true);
        cc_settrans(125);
    case rect_disabled_overlay_light :
        cc_setcolour(~script10495(14));
        cc_setfill(true);
        cc_settrans(125);
    case rect_divider :
        cc_setcolour(0x4b2e26);
        cc_setfill(true);
    case rect_divider_legacy :
        cc_setcolour(0x38312a);
        cc_setfill(true);
    case rect_divider_mobile :
        cc_setcolour(0x152648);
        cc_setfill(true);
    case default :
        cc_setcolour(^white);
        cc_setfill(false);
}
cc_setonvartransmit("stylesheet_skin_update_rect(event_com, event_comsubid, $dbrow0, %toplevel_v2_active_skinset, $int1){toplevel_v2_skins_varp}");
