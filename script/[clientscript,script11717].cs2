// 11717
[clientscript,script11717]
if (%raid1_beastmaster_buff_pet1_dead = 1) {
    if_sethide(false, raid1_beastmaster_buffbar:raid1_beastmaster_pet1_dead);
}
if (%raid1_beastmaster_buff_pet2_dead = 1) {
    if_sethide(false, raid1_beastmaster_buffbar:raid1_beastmaster_pet2_dead);
}
if (%raid1_beastmaster_buff_attackspeed < 6 & %raid1_beastmaster_buff_attackspeed > 0) {
    if_sethide(false, raid1_beastmaster_buffbar:raid1_beastmaster_attackspeed);
}
if (%raid1_beastmaster_buff_attack > 0) {
    if_sethide(false, raid1_beastmaster_buffbar:raid1_beastmaster_distance_text);
    if_settext(tostring(%raid1_beastmaster_buff_attack), raid1_beastmaster_buffbar:raid1_beastmaster_distance_text);
    if_sethide(false, raid1_beastmaster_buffbar:raid1_beastmaster_distance);
}
