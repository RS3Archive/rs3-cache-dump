// 5097
[proc,clan_field_gameover]
switch_int (%clan_field_limbo) {
    case 1 :
        if_settext("Unable to load your clan data.", clan_field_gameover:header);
        if_settext("Sorry!", clan_field_gameover:winner);
        if_setgraphic("aif_clans_battle_game_over_1,2", clan_field_gameover:image);
        if_settext("Please try again later when the system is less busy.", clan_field_gameover:message);
    case 2 :
        if_settext("And the winner is:", clan_field_gameover:header);
        if_settext("<col=ff7f7f>Red Team!</col>", clan_field_gameover:winner);
        if_setgraphic("aif_clans_battle_game_over_1,1", clan_field_gameover:image);
        if (%clan_field_team = 1) {
            if_settext("Congratulations, your team won!", clan_field_gameover:message);
        } else if (%clan_field_team = 2) {
            if_settext("Oh dear, better luck next time.", clan_field_gameover:message);
        } else {
            if_settext("Better luck next time to the Blue Team.", clan_field_gameover:message);
        }
    case 3 :
        if_settext("And the winner is:", clan_field_gameover:header);
        if_settext("<col=7f7fff>Blue Team!</col>", clan_field_gameover:winner);
        if_setgraphic("aif_clans_battle_game_over_1,0", clan_field_gameover:image);
        if (%clan_field_team = 2) {
            if_settext("Congratulations, your team won!", clan_field_gameover:message);
        } else if (%clan_field_team = 1) {
            if_settext("Oh dear, better luck next time.", clan_field_gameover:message);
        } else {
            if_settext("Better luck next time to the Red Team.", clan_field_gameover:message);
        }
    case 5 :
        if_settext("And the result is:", clan_field_gameover:header);
        if_settext("It's a draw!", clan_field_gameover:winner);
        if_setgraphic("aif_clans_battle_game_over_1,2", clan_field_gameover:image);
        if_settext("Well done, everyone!", clan_field_gameover:message);
    case 4 :
        if_settext("And the winner is:", clan_field_gameover:header);
        if (string_length(%clan_field_setup_name) > 0) {
            if_settext(%clan_field_setup_name, clan_field_gameover:winner);
        } else {
            if_settext("... missing!", clan_field_gameover:winner);
        }
        if_setgraphic("aif_clans_battle_game_over_1,2", clan_field_gameover:image);
        if_settext("Better luck next time to everyone else.", clan_field_gameover:message);
    case 6 :
        if_settext("And the winner is:", clan_field_gameover:header);
        if_settext("YOU!", clan_field_gameover:winner);
        if_setgraphic("aif_clans_battle_game_over_1,2", clan_field_gameover:image);
        if_settext("Congratulations!", clan_field_gameover:message);
    case default :
        if_settext("", clan_field_gameover:header);
        if_settext("", clan_field_gameover:winner);
        if_setgraphic(null, clan_field_gameover:image);
        if_settext("", clan_field_gameover:message);
}
