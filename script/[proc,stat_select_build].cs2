// 11270
[proc,stat_select_build](component $component0, component $component1)
if (%stat_select_filter <= 0) {
    return;
}
def_int $int2 = 0;
def_enum $enum3 = null;
def_int $int4 = 0;
$int2, $enum3, $int4 = ~stat_select_build_setup(%stat_select_filter, if_getwidth($component0), 20);
def_int $int5 = 0;
cc_deleteall($component0);
cc_deleteall($component1);
def_int $int6 = 0;
def_int $int7 = 0;
while ($int5 <= enum_getoutputcount(stat_autoint_to_int)) {
    cc_create($component0, ^iftype_graphic, $int5);
    if (testbit(%stat_select_filter, $int5) = ^true) {
        cc_setgraphic(enum(int, graphic, $enum3, $int5));
        cc_setsize($int4, $int4, ^setsize_abs, ^setsize_abs);
        cc_setposition(calc(20 + $int7 % $int2 * $int4 + $int7 % $int2 * 20), calc($int6 * (20 + $int4)), ^setpos_abs_left, ^setpos_abs_top);
        cc_setonop("stat_select($component1, event_comsubid)");
        cc_setop(1, "Select <enum(int, string, statstring, $int5)>");
        ~stat_setup_background($component1, calc($int4 + 4), cc_getx, cc_gety, false);
        if (calc(++$int7 % $int2) = 0) {
            $int6 = calc($int6 + 1);
        }
    } else {
        ~stat_setup_background($component1, calc($int4 + 4), cc_getx, cc_gety, true);
    }
    $int5 = calc($int5 + 1);
}
if_setsize(if_getwidth($component0), calc(($int6 + 1) * (20 + $int4)), ^setsize_abs, ^setsize_abs, $component0);
if_setsize(if_getwidth($component0), calc(($int6 + 1) * (20 + $int4)), ^setsize_abs, ^setsize_abs, $component1);
if_setposition(4, 4, ^setpos_abs_centre, ^setpos_abs_centre, $component0);
if_setposition(0, 0, ^setpos_abs_centre, ^setpos_abs_centre, $component1);
if (%stat_select > 0 & %stat_select <= enum_getoutputcount(stat_autoint_to_int)) {
    if_sethide(true, stat_select:confirm_disabled);
} else {
    if_sethide(false, stat_select:confirm_disabled);
}
