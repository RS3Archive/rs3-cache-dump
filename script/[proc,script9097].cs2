    case 7 :
        cc_setonvartransmit("script9081($component0, cc_getid, $int1, $int2, $achievement3, $int4){activity_tracker_parent_temp, slayer_target, slayer_count, smki_1, slayc_base3, slayc_base, slayc_base3}");
