[clientscript,script19417](int $int0)
def_string $string0 = "Regular";
if ($int0 = 1 | calc(clientclock % 50) = 0) {
    if (%group_ironman_creator = 1 | %group_ironman_member = 1) {
        if_sethide(true, group_ironman_create:info_layer);
        if_sethide(false, group_ironman_create:group_layer);
        if_settext(%group_ironman_cache_clan_name_client, group_ironman_create:group_name);
        if_setmaxlines(1, group_ironman_create:group_name);
        ~script3536(%group_ironman_cache_clan_name_client, group_ironman_create:group_name, -1);
