// 10335
[proc,script10335](player_group_status $player_group_status0)
def_string $string0 = "";
def_graphic $graphic1 = null;
switch_player_group_status ($player_group_status0) {
    case playergroupstatus_1 :
        $graphic1, $string0 = "rs3_icon_grouping_system,1", "You are marked as ready.";
    case playergroupstatus_0 :
        $graphic1, $string0 = "rs3_icon_grouping_system,2", "You are marked as not ready.";
    case playergroupstatus_2 :
        $graphic1, $string0 = "rs3_icon_grouping_system,3", "Your group is waiting for the game to start.";
    case playergroupstatus_3 :
        $graphic1, $string0 = "rs3_icon_grouping_system,4", "Your group has been teleported to the starting area.";
    case default :
        return;
}
~script10336($graphic1, $string0);
