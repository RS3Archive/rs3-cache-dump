// 1461
[clientscript,script1461](component $component0)
if (%music_loop_toggle_varc ! 0 & %music_loop_toggle_varc ! 1) {
    %music_loop_toggle_varc = %music_v3_loop_on;
}
if (%music_loop_toggle_varc = 0) {
    if_setop(1, "Loop", $component0);
} else {
    if_setop(1, "Unloop", $component0);
}
if (if_getgraphic($component0) ! "aif_music_loop_button,1" & if_getgraphic($component0) ! "aif_music_loop_button,3") {
    ~script1453($component0);
} else {
    ~script1450($component0);
}
