// 2481
[clientscript,script2481](component $component0)
def_int $int1 = %lifepoints;
if (%toplevel_v2_legacy_combat = 1) {
    if ($int1 >= 10) {
        $int1 = calc($int1 / 10);
    } else if ($int1 > 0) {
        $int1 = 1;
    } else {
        $int1 = 0;
    }
}
if_settext(tostring($int1), $component0);
