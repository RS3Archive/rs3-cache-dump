// 4200
[proc,script4200](int $int0, component $component1)(int, int)
def_int $int2 = if_getwidth($component1);
def_int $int3 = calc($int2 / 75);
def_int $int4 = calc(($int2 - 5 * 2 - $int3 * 75) / ($int3 - 1));
def_int $int5 = 3;
if ($int2 <= 0) {
    return(0, 0);
}
def_int $int6 = calc($int0 % $int3);
def_int $int7 = calc($int0 / $int3);
$int6 = calc(5 + $int6 * (75 + $int4));
$int7 = calc(5 + $int7 * (75 + $int5));
