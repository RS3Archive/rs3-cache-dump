// 13004
[clientscript,script13004]
def_int $int0 = 0;
if_sethide(true, clan_noticeboard_event_edit:event_button_disabled_layer_1);
if_sethide(true, clan_noticeboard_event_edit:event_button_disabled_layer_2);
if_sethide(true, clan_noticeboard_event_edit:event_button_disabled_layer_3);
if_sethide(true, clan_noticeboard_event_edit:event_button_disabled_layer_4);
if_sethide(true, clan_noticeboard_event_edit:event_button_disabled_layer_5);
if_sethide(true, clan_noticeboard_event_edit:event_button_disabled_layer_6);
if_sethide(true, clan_noticeboard_event_edit:event_button_disabled_layer_7);
if_sethide(true, clan_noticeboard_event_edit:event_button_disabled_layer_8);
switch_int (%clan_event_current_varp) {
    case 1 :
        if_sethide(false, clan_noticeboard_event_edit:event_button_disabled_layer_1);
        $int0 = %clan_event_mandatory_1_varp;
    case 2 :
        if_sethide(false, clan_noticeboard_event_edit:event_button_disabled_layer_2);
        $int0 = %clan_event_mandatory_2_varp;
    case 3 :
        if_sethide(false, clan_noticeboard_event_edit:event_button_disabled_layer_3);
        $int0 = %clan_event_mandatory_3_varp;
    case 4 :
        if_sethide(false, clan_noticeboard_event_edit:event_button_disabled_layer_4);
        $int0 = %clan_event_mandatory_4_varp;
    case 5 :
        if_sethide(false, clan_noticeboard_event_edit:event_button_disabled_layer_5);
        $int0 = %clan_event_mandatory_5_varp;
    case 6 :
        if_sethide(false, clan_noticeboard_event_edit:event_button_disabled_layer_6);
        $int0 = %clan_event_mandatory_6_varp;
    case 7 :
        if_sethide(false, clan_noticeboard_event_edit:event_button_disabled_layer_7);
        $int0 = %clan_event_mandatory_7_varp;
    case 8 :
        if_sethide(false, clan_noticeboard_event_edit:event_button_disabled_layer_8);
        $int0 = %clan_event_mandatory_8_varp;
}
if_sethide(~int_to_bool($int0), clan_noticeboard_event_edit:mandatory_checkbox_deselected_layer);
if_settext("All events relative to game time", clan_noticeboard_event_edit:time_text);
