// 3776
[clientscript,share_open](int $int0, int $int1, string $string0)
if ($int0 = 1) {
    if_setsize(512, 332, ^setsize_abs, ^setsize_abs, share_accept:gold_window_layer);
    if_settext("<$string0> would like to share a bank preset with you. Would you like to overwrite your existing temporary bank preset?", share_accept:info);
    sound_vorbis_volume(loyalty_shop_category, 1, 0, 120);
} else {
    if_setsize(394, 274, ^setsize_abs, ^setsize_abs, share_accept:gold_window_layer);
