// 2232
[clientscript,script2232]
if (%easter10_chocworkers < 15 & ~script2240 < %easter10_totalworkers) {
    sound_synth(easter10_interface, 1, 0);
    %easter10_teggworkers = calc(%easter10_teggworkers + 1);
} else {
    %easter10_resourcegame_errortextflag = 1;
    sound_vorbis_volume(omge_error, 1, 0, 255);
}
~script2220;
