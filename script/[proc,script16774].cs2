// 16774
[proc,script16774](struct $struct0)(int)
def_int $int1 = 150;
switch_struct ($struct0) {
    case trh187_promo :
        if (%trh187_spacebar_used = 0) {
            $int1 = 50;
        } else {
            $int1 = struct_param($struct0, trh_promo_default_custom_reward_delay);
        }
        %trh187_spacebar_used = 0;
    case trh204_promo :
        if (%trh204_hidden_card_selected = 1) {
            $int1 = 40;
        } else {
            $int1 = 0;
        }
        %trh204_hidden_card_selected = 0;
    case default :
        $int1 = struct_param($struct0, trh_promo_default_custom_reward_delay);
}
return($int1);
