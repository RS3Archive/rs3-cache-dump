// 9396
[clientscript,script9396](component $component0)
def_component $component1 = activity_tracker_embedded_options:options_control_build;
def_component $component2 = activity_tracker_embedded_options:options_control_click;
def_component $component3 = activity_tracker_embedded_options:highlight_layer;
def_component $component4 = activity_tracker_embedded_options:vartrans_layer;
cc_deleteall($component1);
cc_deleteall($component2);
cc_deleteall($component3);
if_clearscripthooks($component4);
switch_component ($component0) {
    case activity_tracker_embedded_options:options_close_click :
        if_sethide(true, activity_tracker_embedded_options:options_layer);
    case activity_tracker_embedded_more_info:slayer_tracker_click :
        if_settext(db_getfield(activity_tracker_parent_slayer_options, settings_category:col0, 0), activity_tracker_embedded_options:options_title);
        ~script2970($component1, $component2, $component2, activity_tracker_parent_slayer_options, 0, 0, if_getwidth($component1));
        if_sethide(false, activity_tracker_embedded_options:options_layer);
    case activity_tracker_embedded_more_info:skill_tracker_click :
        ~script9399($component1, $component2, $component3);
        if_setonvartransmit("script9398($component1, $component2, $component3){stats_targ_skill}", $component4);
}
