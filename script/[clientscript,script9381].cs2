// 9381
[clientscript,script9381](component $component0, int $int1)
if_setposition(calc(4 + $int1 * 120), 0, ^setpos_abs_left, ^setpos_abs_top, interface_702:com_92);
sound_vorbis_volume(sound_36972, 1, 0, 120);
switch_int ($int1) {
    case 0, 1 :
        if_sethide(false, interface_702:com_83);
    case 2 :
        if_sethide(true, interface_702:com_79);
        if_sethide(false, interface_702:com_65);
        if_sethide(true, interface_702:com_54);
    case 3 :
        if_sethide(true, interface_702:com_79);
        if_sethide(true, interface_702:com_65);
        if_sethide(false, interface_702:com_54);
        if (%varplayerbit_21122 = 0) {
            if_settext("Enable PvP", interface_702:com_10);
        } else {
            if_settext("Disable PvP", interface_702:com_10);
        }
}
