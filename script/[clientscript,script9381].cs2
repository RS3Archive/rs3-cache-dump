// 9381
[clientscript,script9381](int $int0, int $int1)
if_setposition(calc(4 + $int1 * 120), 0, ^setpos_abs_left, ^setpos_abs_top, 6awe2_pvp_board:panel_tab_selected);
sound_vorbis_volume(tli_select_tab_01, 1, 0, 120);
switch_int ($int1) {
    case 0, 1 :
        if_sethide(false, 6awe2_pvp_board:panel_loading_overlay);
    case 2 :
        if_sethide(true, 6awe2_pvp_board:name_list_layer);
        if_sethide(false, 6awe2_pvp_board:my_score_layer);
        if_sethide(true, 6awe2_pvp_board:pvp_info_layer);
    case 3 :
        if_sethide(true, 6awe2_pvp_board:name_list_layer);
        if_sethide(true, 6awe2_pvp_board:my_score_layer);
        if_sethide(false, 6awe2_pvp_board:pvp_info_layer);
        if (%6awe2_allow_pvp = 0) {
            if_settext("Enable PvP", 6awe2_pvp_board:pvp_toggle_text);
        } else {
            if_settext("Disable PvP", 6awe2_pvp_board:pvp_toggle_text);
        }
}
