// 5437
[clientscript,script5437]
if (++%dom_bottombar_zpos < 0) {
    if_setposition(0, %dom_bottombar_zpos, ^setpos_abs_centre, ^setpos_abs_bottom, dom_endurance:bottom_info_layer);
} else {
    if_setposition(0, 0, ^setpos_abs_centre, ^setpos_abs_bottom, dom_endurance:bottom_info_layer);
    if_setontimer(null, dom_endurance:background_1);
}
