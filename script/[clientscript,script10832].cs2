// 10832
[clientscript,script10832](int $int0)
if ($int0 = 0) {
    if_sethide(true, xmas2014:left_panel_rewards);
    if_sethide(false, xmas2014:left_panel_presents);
    if_sethide(true, xmas2014:right_panel_delivery);
    if_sethide(false, xmas2014:right_panel_default);
    if_settext("Select a delivery target in the left panel for more information", xmas2014:right_panel_default_text);
} else {
    if_sethide(true, xmas2014:left_panel_presents);
    if_sethide(false, xmas2014:left_panel_rewards);
    if_settext("Christmas cheer: <tostring(%xmas2014_unlock_score)>", xmas2014:presents_delivered_text);
    if_sethide(true, xmas2014:right_panel_delivery);
    if_sethide(false, xmas2014:right_panel_default);
    if_settext("Check the left panel for the cosmetic rewards your Christmas cheer can unlock!", xmas2014:right_panel_default_text);
}
