// 7893
[clientscript,script7893](component $component0)
def_int $int1 = 0;
switch_component ($component0) {
    case acc_create:tab_appearance_click :
        $int1 = 0;
    case acc_create:tab_hair_click :
        $int1 = 1;
    case acc_create:tab_torso_click :
        $int1 = 2;
    case acc_create:tab_legs_click :
        $int1 = 3;
    case acc_create:tab_feet_click :
        $int1 = 4;
    case acc_create:tab_beard_click :
        $int1 = 5;
        if (%acc_create_gender = 1) {
            if (%acc_create_current_tab = 5) {
                $int1 = 1;
            } else {
                $int1 = %acc_create_current_tab;
            }
        }
    case default :
        return;
}
sound_vorbis_rate(tli_select_tab_parent_01, 1, 0, 150, 220);
~script7894($int1, 1);
