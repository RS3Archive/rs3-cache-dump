// 2906
[clientscript,ii_storage_update_side](component $component0, obj $obj1, component $component2)
def_component $component3 = if_getlayer($component0);
def_int $int4 = 0;
if ($obj1 = obj_10010) {
    $int4 = calc(inv_total(inv_94, obj_11259) + inv_total(inv_93, obj_11259));
    if ($int4 > 0) {
        $obj1 = obj_11259;
    }
}
switch_obj ($obj1) {
    case obj_10010, obj_11259 :
        if ($int4 = 0) {
            $int4 = calc(inv_total(inv_93, obj_10010) + inv_total(inv_94, obj_10010));
        }
    case default :
        $int4 = inv_total(inv_93, $obj1);
}
if_settext(oc_name($obj1), $component2);
if ($int4 > 0) {
    if_setcolour(^yellow, $component2);
    if_setobject($obj1, $int4, $component0);
} else {
    if_setcolour(0xcc0000, $component2);
    if_setobject($obj1, -1, $component0);
}
if_setoutline(1, $component0);
