// 3369
[clientscript,script3369](int $int0, int $int1, int $int2)
$int2 = calc($int2 + 1);
if (cc_find(levelup:firework_layer, $int0) = true) {
    cc_setontimer("script3369($int0, $int1, $int2)");
    if (clientclock > calc($int1 + 50)) {
        cc_setposition(cc_getx, max(calc(cc_gety - 2), 0), ^setpos_abs_left, ^setpos_abs_top);
    }
    if ($int2 > 100 & cc_gety < 20) {
        cc_delete;
    }
}
