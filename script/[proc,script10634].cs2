// 10634
[proc,script10634](component $component0, int $int1)
switch_component ($component0) {
    case settings:set_build :
        ~settings_slider_update($int1);
    case loginscreen:audio_build, loginscreen:mobile_audio_build :
        ~login_setvalue($int1);
    case acc_create:mobile_audio_build :
        ~script15562($int1);
    case tut_options:mobile_audio_build :
        ~script15876($int1);
}
