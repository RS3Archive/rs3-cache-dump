// 13471
[proc,script13471](int $int0)(int)
switch_int ($int0) {
    case 1 :
        return(.%incense_guam_potency);
    case 2 :
        return(.%incense_tarromin_potency);
    case 3 :
        return(.%incense_marrentill_potency);
    case 4 :
        return(.%incense_harralander_potency);
    case 5 :
        return(.%incense_ranarr_potency);
    case 6 :
        return(.%incense_toadflax_potency);
    case 7 :
        return(.%incense_spirit_potency);
    case 8 :
        return(.%incense_irit_potency);
    case 9 :
        return(.%incense_wergali_potency);
    case 10 :
        return(.%incense_avantoe_potency);
    case 11 :
        return(.%incense_kwuarm_potency);
    case 12 :
        return(.%incense_bloodweed_potency);
    case 13 :
        return(.%incense_snapdragon_potency);
    case 14 :
        return(.%incense_cadantine_potency);
    case 15 :
        return(.%incense_lantadyme_potency);
    case 16 :
        return(.%incense_dwarf_potency);
    case 17 :
        return(.%incense_torstol_potency);
    case 18 :
        return(.%incense_fellstalk_potency);
    case default :
        ~error("Attempted to get potency for unexpected burner type: <tostring($int0)>");
        return(-1);
}
