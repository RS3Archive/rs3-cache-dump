$int1 = calc($int1 + $int2);
if (cc_find(mtxmgt:preview_pane, 0) = true) {
    $int4 = cc_getmodelangle_y;
    $int1 = cc_getmodelzoom;
    $int5 = cc_getmodelyof;
}
cc_create($component0, ^iftype_model, if_getnextsubid($component0));
