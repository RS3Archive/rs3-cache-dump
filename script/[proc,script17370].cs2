// 17370
[proc,script17370](long $long0)(string)
if ($long0 < 0) {
    return("");
} else if ($long0 < 100000) {
    return("<col=FFFF00><tostring_long($long0)></col>");
} else if ($long0 < 10000000) {
    return("<col=FFFFFF><tostring_long(calc($long0 / 1000))>K</col>");
} else if ($long0 < 10000000000) {
    return("<col=1EFF00><tostring_long(calc($long0 / 1000000))>M</col>");
} else if ($long0 < 10000000000000) {
    return("<col=6698FF><tostring_long(calc($long0 / 1000000000))>B</col>");
} else if ($long0 < 10000000000000000) {
    return("<col=A335EE><tostring_long(calc($long0 / 1000000000000))>T</col>");
} else {
    return("<col=FF8000><tostring_long(calc($long0 / 1000000000000000))>Q</col>");
}
