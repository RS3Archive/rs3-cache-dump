// 2739
[proc,script2739](struct $struct0, int $int1)
switch_struct ($struct0) {
    case trh162_pet_cat_struct :
        switch_int ($int1) {
            case 2 :
                cc_npc_setcustomretex(4, cat_biped_ginger);
            case 3 :
                cc_npc_setcustomretex(4, cat_biped_siamese);
            case 4 :
                cc_npc_setcustomretex(4, cat_biped_oriental_shorthair);
            case 5 :
                cc_npc_setcustomretex(4, cat_biped_osd);
        }
}
