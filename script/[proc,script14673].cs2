// 14673
[proc,script14673](dbrow $dbrow0)(int)
switch_dbrow ($dbrow0) {
    case arch_researcher_eduardo :
        return(%arch_researcher_eduardo_unlocked);
    case arch_researcher_katarina :
        return(%arch_researcher_katarina_unlocked);
    case arch_researcher_dorian :
        return(%arch_researcher_dorian_unlocked);
    case arch_researcher_alpheus, arch_researcher_eliza :
        return(%arch_researcher_anachronia_unlocked);
    case arch_researcher_tali :
        if (achievement_reqstate(cheevo_wendle_task_tanner) = -2) {
            return(1);
        }
        return(0);
    case arch_researcher_anna_jones :
        return(%arch_researcher_anna_jones_unlocked);
    case arch_researcher_elissa_giovanni :
        return(%arch_researcher_elissa_giovanni_unlocked);
    case arch_researcher_asgarnia_smith :
        return(%arch_researcher_asgarnia_smith_unlocked);
    case arch_researcher_dr_nabanik :
        if (~cheevo_obtain_progress(cheevo_archaeology_kharidet_mysteries) = -2) {
            return(1);
        }
        return(0);
    case arch_researcher_vanescula :
        if (~cheevo_obtain_progress(cheevo_archaeology_everlight_mysteries) = -2) {
            return(1);
        }
        return(0);
    case arch_researcher_movario :
        if (~cheevo_obtain_progress(cheevo_archaeology_infernalsource_mysteries) = -2) {
            return(1);
        }
        return(0);
    case arch_researcher_geeka :
        if (~cheevo_obtain_progress(cheevo_archaeology_stormguard_mysteries) = -2) {
            return(1);
        }
        return(0);
    case arch_researcher_zanik :
        if (~cheevo_obtain_progress(cheevo_archaeology_warforge_mysteries) = -2) {
            return(1);
        }
        return(0);
    case arch_researcher_mr_mordaut :
        if (~cheevo_obtain_progress(cheevo_archaeology_orthen_mysteries) = -2) {
            return(1);
        }
        return(0);
}
return(1);
