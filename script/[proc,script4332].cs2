// 4332
[proc,script4332](component $component0, component $component1)
def_graphic $graphic2 = null;
def_graphic $graphic3 = null;
$graphic2, $graphic3 = ~script4384(%clan_custom_motif_a_varclan, %clan_custom_motif_b_varclan, 1);
if_setgraphic($graphic2, $component0);
if_setgraphic($graphic3, $component1);
if (activeclansettings_getaffinedcount >= 5) {
    if_setcolour(hsvtorgb(%clan_custom_motif_colour1_varclan), $component0);
    if_setcolour(hsvtorgb(%clan_custom_motif_colour2_varclan), $component1);
} else {
    if_setcolour(hsvtorgb(6716), $component0);
    if_setcolour(hsvtorgb(6716), $component1);
}
