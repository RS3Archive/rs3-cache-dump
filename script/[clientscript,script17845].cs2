// 17845
[clientscript,script17845](struct $struct0, int $int1)
switch_struct ($struct0) {
    case trh125_prismatic_lamp :
        %trh125_lamps_bought_today = $int1;
    case trh125_prismatic_star :
        %trh125_stars_bought_today = $int1;
    case trh125_pulse_core :
        %trh125_pulse_cores_bought_today = $int1;
    case trh125_smouldering_cinder :
