    case necro_hub_thalmund_reward_struct_ensouled_bar, necro_hub_thalmund_reward_struct_ensouled_cloth, necro_hub_thalmund_reward_struct_ensouled_thread, necro_hub_thalmund_reward_struct_greater_ensouled_bar, necro_hub_thalmund_reward_struct_greater_ensouled_cloth, necro_hub_thalmund_reward_struct_greater_ensouled_thread :
        %necro_hub_thalmund_slot_1_bought = min(511, $int1);
    case necro_hub_thalmund_reward_struct_impure_essence, necro_hub_thalmund_reward_struct_spirit_rune, necro_hub_thalmund_reward_struct_bone_rune, necro_hub_thalmund_reward_struct_flesh_rune, necro_hub_thalmund_reward_struct_miasma_rune :
        %necro_hub_thalmund_slot_2_bought = min(511, $int1);
    case necro_hub_thalmund_reward_struct_greater_necroplasm, necro_hub_thalmund_reward_struct_powerful_necroplasm, necro_hub_thalmund_reward_struct_spirit_memento, necro_hub_thalmund_reward_struct_robust_memento, necro_hub_thalmund_reward_struct_powerful_memento, necro_hub_thalmund_reward_struct_greater_ghostly_ink, necro_hub_thalmund_reward_struct_powerful_ghostly_ink, necro_hub_thalmund_reward_struct_greater_ritual_candle :
        %necro_hub_thalmund_slot_3_bought = min(511, $int1);
    case necro_hub_thalmund_reward_struct_greater_flaming_skull, necro_hub_thalmund_reward_struct_uncut_moonstone, necro_hub_thalmund_reward_struct_ghost_impling, necro_hub_thalmund_reward_struct_necromancy_flask :
        %necro_hub_thalmund_slot_4_bought = min(511, $int1);
    case default :
        ~error("No daily purchase cap var for <struct_param($struct0, rewardshop_item_name)>.");
