// 10692
[proc,script10692](component $component0, boolean $boolean1)
switch_component ($component0) {
    case divdnd_overlay:memories1 :
        ~script13991(divdnd_overlay:memories1_build, divdnd_overlay:memories1_click, rs3tli_3x3_button, $boolean1);
    case divdnd_overlay:memories2 :
        ~script13991(divdnd_overlay:memories2_build, divdnd_overlay:memories2_click, rs3tli_3x3_button, $boolean1);
    case divdnd_overlay:robots1 :
        ~script13991(divdnd_overlay:robots1_build, divdnd_overlay:robots1_click, rs3tli_3x3_button, $boolean1);
    case divdnd_overlay:robots2 :
        ~script13991(divdnd_overlay:robots2_build, divdnd_overlay:robots2_click, rs3tli_3x3_button, $boolean1);
}
