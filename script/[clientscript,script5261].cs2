// 5261
[clientscript,script5261](component $component0)
switch_component ($component0) {
    case myq5_vanescula_combat:shriek_attack :
        if_sethide(false, myq5_vanescula_combat:shriek_fade);
        if_settext("4", myq5_vanescula_combat:shriek_count);
        if_sethide(false, myq5_vanescula_combat:shriek_count);
        if_setontimer("script5262(4, 0, myq5_vanescula_combat:shriek_attack)", $component0);
    case myq5_vanescula_combat:melee_attack :
        if_sethide(false, myq5_vanescula_combat:melee_fade);
        if_settext("2", myq5_vanescula_combat:melee_count);
        if_sethide(false, myq5_vanescula_combat:melee_count);
        if_setontimer("script5262(2, 0, myq5_vanescula_combat:melee_attack)", $component0);
}
