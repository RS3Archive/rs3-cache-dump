// 4689
[clientscript,script4689]
if_sethide(false, loy_defence_side:ability_layer_1);
if_settext(enum(int, string, loy_boost_name, 1), loy_defence_side:name_1);
if_setgraphic("aif_loyalty_icon_1,0", loy_defence_side:icon_1);
if_settext(tostring(enum(int, int, loy_boost_cost, 1)), loy_defence_side:cost_1);
if_sethide(false, loy_defence_side:ability_layer_2);
if_settext(enum(int, string, loy_boost_name, 2), loy_defence_side:name_2);
if_setgraphic("aif_loyalty_icon_1,1", loy_defence_side:icon_2);
if_settext(tostring(enum(int, int, loy_boost_cost, 2)), loy_defence_side:cost_2);
if_sethide(false, loy_defence_side:ability_layer_3);
if_settext(enum(int, string, loy_boost_name, 3), loy_defence_side:name_3);
if_setgraphic("aif_loyalty_icon_1,2", loy_defence_side:icon_3);
if_settext(tostring(enum(int, int, loy_boost_cost, 3)), loy_defence_side:cost_3);
if_sethide(false, loy_defence_side:ability_layer_4);
if_settext(enum(int, string, loy_boost_name, 4), loy_defence_side:name_4);
if_setgraphic("aif_loyalty_icon_1,3", loy_defence_side:icon_4);
if_settext(tostring(enum(int, int, loy_boost_cost, 4)), loy_defence_side:cost_4);
if_setonmouserepeat("script4692(event_com)", loy_defence_side:ability_layer_1);
if_setonmouserepeat("script4692(event_com)", loy_defence_side:ability_layer_2);
if_setonmouserepeat("script4692(event_com)", loy_defence_side:ability_layer_3);
if_setonmouserepeat("script4692(event_com)", loy_defence_side:ability_layer_4);
