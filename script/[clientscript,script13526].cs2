// 13526
[clientscript,script13526]
if_setcolour(~script10495(0), slayer_count:slayer_points);
def_string $string0 = "Slayer points: <tostring_localised(%smki_slayer_points, true)>";
if (%slayer_counter_display_mode = 1) {
    $string0 = "Reaper points: <tostring_localised(%bslay_points, true)>";
    if_settext(tostring_localised(%bslay_points, true), slayer_count:slayer_points);
} else {
    if_settext(tostring_localised(%smki_slayer_points, true), slayer_count:slayer_points);
}
if_setonmouserepeat("script8799($string0, event_com, -1)", slayer_count:slayer_points_text);
