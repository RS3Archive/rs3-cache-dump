// 7582
[proc,script7582](component $component0)(graphic)
switch_component ($component0) {
    case tsd_assigning_overlay:death_icon :
        return("aif_sleeping_dog_guthix_death,2");
    case tsd_assigning_overlay:thaerisk_icon :
        return("aif_sleeping_dog_guthix_chaeldar_thaerisk,2");
    case tsd_assigning_overlay:valluta_icon :
        return("aif_sleeping_dog_guthix_fiara_valluta,2");
    case tsd_assigning_overlay:cres_icon :
        return("aif_sleeping_dog_guthix_cres,2");
    case default :
        return(null);
}
