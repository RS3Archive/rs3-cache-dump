// 1971
[proc,seer_varcupdate](int $int0, component $component1)
switch_int ($int0) {
    case 0 :
        if (%seer_a < 0 | %seer_a > 25) {
            %seer_a = 0;
        }
        if_settext(enum(int, string, seer_letters, %seer_a), $component1);
    case 1 :
        if (%seer_b < 0 | %seer_b > 25) {
            %seer_b = 0;
        }
        if_settext(enum(int, string, seer_letters, %seer_b), $component1);
    case 2 :
        if (%seer_c < 0 | %seer_c > 25) {
            %seer_c = 0;
        }
        if_settext(enum(int, string, seer_letters, %seer_c), $component1);
    case 3 :
        if (%seer_d < 0 | %seer_d > 25) {
            %seer_d = 0;
        }
        if_settext(enum(int, string, seer_letters, %seer_d), $component1);
}
