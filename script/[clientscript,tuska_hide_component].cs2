// 5244
[clientscript,tuska_hide_component](component $component0, boolean $boolean1, int $int2)
def_int $int3 = -1;
if ($component0 ! tuska_effects:blur_component) {
    $int2 = calc(clientclock + $int2 * 50);
    $int3 = if_getnextsubid(tuska_effects:universe);
    cc_create(tuska_effects:universe, ^iftype_text, $int3);
    cc_setsize(10, 10, ^setsize_abs, ^setsize_abs);
    cc_setposition(0, 0, ^setpos_abs_left, ^setpos_abs_top);
    cc_setontimer("script5246($component0, $boolean1, $int2, $int3)");
}
