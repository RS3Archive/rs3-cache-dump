// 9462
[proc,script9462](component $component0, component $component1, int $int2, int $int3)
def_string $string0 = "No opinion.";
def_graphic $graphic4 = null;
switch_int ($int2) {
    case 2 :
        if ($int3 = 1) {
            $string0 = "Longer expeditions, faster gatherers.";
            $graphic4 = "aif_6awe2_strategy_buff_icons_large,5";
        } else if ($int3 = 2) {
            $string0 = "Shorter expeditions.";
            $graphic4 = "aif_6awe2_strategy_buff_icons_large,2";
        }
    case 0 :
        if ($int3 = 1) {
            $string0 = "Longer expeditions, construct buildings faster.";
            $graphic4 = "aif_6awe2_strategy_buff_icons_large,6";
        } else if ($int3 = 2) {
            $string0 = "Shorter expeditions.";
            $graphic4 = "aif_6awe2_strategy_buff_icons_large,2";
        }
    case 1 :
        if ($int3 = 1) {
            $string0 = "Larger caravans that can hold more divine energy.";
            $graphic4 = "aif_6awe2_strategy_buff_icons_large,1";
        } else if ($int3 = 2) {
            $string0 = "Tougher bodyguards, to defend the caravans better.";
            $graphic4 = "aif_6awe2_strategy_buff_icons_large,3";
        }
    case 3 :
        if ($int3 = 1) {
            $string0 = "More convoys, attracting more opponent attention.";
            $graphic4 = "aif_6awe2_strategy_buff_icons_large,0";
        } else if ($int3 = 2) {
            $string0 = "Standard convoy frequency, with lower chance of ambush.";
            $graphic4 = "aif_6awe2_strategy_buff_icons_large,4";
        }
}
if_settext($string0, $component0);
if_setgraphic($graphic4, $component1);
