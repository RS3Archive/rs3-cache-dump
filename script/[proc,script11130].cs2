// 11130
[proc,script11130](graphic $graphic0)
switch_graphic ($graphic0) {
    case easter2015_distraction_nut :
        sound_vorbis_rate(drop_metal_small, 1, 0, 120, 512);
    case easter2015_distraction_fireball :
        sound_vorbis_rate(zamorak_siege_pet_emote_hairball_sizzle, 1, 0, 120, 512);
    case easter2015_distraction_cabbage :
        sound_vorbis_rate(we3_cabbage_cauldron_fire_1, 1, 0, 120, 512);
    case easter2015_distraction_bread :
        sound_vorbis_rate(drop_small, 1, 0, 120, 255);
    case default :
        sound_vorbis_rate(drop_small, 1, 0, 120, 512);
}
