// 11130
[proc,script11130](graphic $graphic0)
switch_graphic ($graphic0) {
    case easter2015_distraction_nut :
        sound_vorbis_rate(sound_4176, 1, 0, 120, 512);
    case easter2015_distraction_fireball :
        sound_vorbis_rate(sound_39524, 1, 0, 120, 512);
    case easter2015_distraction_cabbage :
        sound_vorbis_rate(sound_45075, 1, 0, 120, 512);
    case easter2015_distraction_bread :
        sound_vorbis_rate(sound_4166, 1, 0, 120, 255);
    case default :
        sound_vorbis_rate(sound_4166, 1, 0, 120, 512);
}
