// 14873
[proc,script14873](component $component0, component $component1, enum $enum2, int $int3)
if (cc_find($component1, $int3) = true) {
    switch_component ($component1) {
        case arch_research_management:general_research_control_layer, arch_research_management:special_research_control_layer :
            cc_setop(1, "Select");
            cc_setonop("script14886($enum2, $int3)");
    }
}
