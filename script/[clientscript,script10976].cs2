// 10976
[clientscript,script10976](component $component0)
switch_component ($component0) {
    case interface_1583:com_61 :
        mes("<col=00C800>'Efficiency' emote:</col> A love themed emote that can be unlocked from sprinkling <tostring_localised(600, true)> rose petals.");
    case interface_1583:com_65 :
        mes("<col=00C800>'No More!' emote:</col> A hate themed emote that can be unlocked from crushing <tostring_localised(600, true)> rose petals.");
    case interface_1583:com_63 :
        mes("<col=00C800>Aegis of devotion:</col> A love themed shield that can be unlocked from sprinkling <tostring_localised(200, true)> rose petals.");
    case interface_1583:com_67 :
        mes("<col=00C800>Bulwark of revenge:</col> A hate themed shield that can be unlocked from crushing <tostring_localised(200, true)> rose petals.");
    case interface_1583:com_62 :
        mes("<col=00C800>Ardent mace:</col> A pair of love themed maces that can be unlocked from sprinkling <tostring_localised(400, true)> rose petals.");
    case interface_1583:com_66 :
        mes("<col=00C800>Heartseeker crossbow:</col> A pair of hate themed crossbows that can be unlocked from crushing <tostring_localised(400, true)> rose petals.");
    case interface_1583:com_60 :
        mes("<col=00C800>Lovers medallion:</col> A love themed necklace with a particle emitter that can be unlocked from sprinkling <tostring_localised(1000, true)> rose petals. Also, has a chance to cause love hearts to explode out of your dying targets.");
    case interface_1583:com_64 :
        mes("<col=00C800>Haters medallion:</col> A hate themed necklace with a particle emitter that can be unlocked from crushing <tostring_localised(1000, true)> rose petals. Also, has a chance to cause broken hearts to explode out of your dying targets.");
    case interface_1583:com_59 :
        mes("<col=00C800>Crown of the fallen:</col> A headpiece consisting of both Cupid's halo and Demonic horns that can be worn individually or as one item. This can be unlocked from sprinkling and crushing <tostring_localised(1250, true)> rose petals.");
}
return;
