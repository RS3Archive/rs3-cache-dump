// 18117
[proc,script18117](int $int0, int $int1)
def_int $int2 = -1;
def_int $int3 = 0;
while (++$int2 < $int0) {
    ~cc_add_button(mtxmgt:preview_variants_layer, $int2, 0, $int3, ^setpos_abs_left, ^setpos_abs_top, 24, 24, ^setsize_abs, ^setsize_abs, button_default, tostring(calc($int2 + 1)));
    cc_button_setcantoggle(true);
    if ($int2 = $int1) {
        cc_button_settoggled(true);
