// 9168
[proc,script9168]()(string)
if (%warband_last_event_runeday < date_runeday) {
    return("You have taken part in <col=ffffff>0 of 3</col> events today");
} else if (%warband_events_today > 3) {
    return("You have taken part in <col=ffffff>3 of 3</col> events today");
} else {
    return("You have taken part in <col=ffffff><tostring(%warband_events_today)> of 3</col> events today");
}
