[proc,script9168]()(string)
if (%varplayerbit_18267 < date_runeday) {
    return("You have taken part in <col=ffffff>0 of 3</col> events today");
} else if (%varplayerbit_18272 > 3) {
    return("You have taken part in <col=ffffff>3 of 3</col> events today");
} else {
    return("You have taken part in <col=ffffff><tostring(%varplayerbit_18272)> of 3</col> events today");
}
