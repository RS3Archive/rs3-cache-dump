// 10245
[if_process_active_npc,tut5_spotlight]
def_int $int0 = 0;
def_int $int1 = 0;
def_int $int2 = 0;
def_boolean $boolean3 = false;
def_int $int4 = 0;
def_int $int5 = 0;
def_int $int6 = 0;
def_int $int7 = 0;
if (if_find(tut5_spotlight:content_layer) = true) {
    $int0, $int1, $int2 = get_entity_screen_position(get_entity_overlay_height);
    $boolean3, $int4, $int5, $int6, $int7 = get_entity_bounding_box;
    if (%tut5_bound_set = 0 & $boolean3 = true) {
        $boolean3, %tut5_bound_left, %tut5_bound_top, %tut5_bound_right, %tut5_bound_bottom = get_entity_bounding_box;
        %tut5_bound_set = 1;
    }
    if (%tut5_bound_scaler <= 0 | %tut5_bound_scaler >= 300) {
        %tut5_bound_scaler = 100;
    }
    if (%tut5_bound_y_scaler <= 0 | %tut5_bound_scaler >= 200) {
        %tut5_bound_y_scaler = 25;
    }
    ~script770($boolean3, $int0, $int1);
}
