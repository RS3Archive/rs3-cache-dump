// 8051
[proc,script8051](component $component0)
def_int $int1 = 0;
def_string $string0 = "Preset";
while ($int1 < 8) {
    if (~script6799($int1) = %prayer_mode) {
        if ($int1 < %prayer_quick_number_of_presets) {
            $string0 = " - <enum(int, string, share_preset_enum_int_string, ~script2222($int1))>";
        } else {
            $string0 = "";
        }
        if_setop(calc($int1 + 3), $string0, $component0);
    } else {
        if_setop(calc($int1 + 3), "", $component0);
    }
    $int1 = calc($int1 + 1);
}
