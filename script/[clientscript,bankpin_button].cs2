// 1110
[clientscript,bankpin_button](int $int0)
if ($int0 ! 1) {
    return;
}
%bankpin_counter = min(calc(%bankpin_counter + 1), 3);
switch_int (random(4)) {
    case 0 :
        sound_vorbis_volume(bank_pin_press_button_1, 1, 0, 150);
    case 1 :
        sound_vorbis_volume(bank_pin_press_button_2, 1, 0, 150);
    case 2 :
        sound_vorbis_volume(bank_pin_press_button_3, 1, 0, 150);
    case 3 :
        sound_vorbis_volume(bank_pin_press_button_4, 1, 0, 150);
}
~bankpin_shuffle(1);
