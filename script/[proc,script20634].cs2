// 20634
[proc,script20634](int $int0)
if ($int0 > if_getheight(marketplace_store:items_holder)) {
    if_setscrollsize(0, $int0, marketplace_store:items_holder);
    ~rs3_scrollbar_vertical(marketplace_store:scrollbar_layer, marketplace_store:items_holder);
    if_sethide(true, marketplace_store:fade_top);
    if_sethide(false, marketplace_store:fade_bottom);
} else {
    if_setscrollsize(0, 0, marketplace_store:items_holder);
    if_sethide(true, marketplace_store:fade_top);
    if_sethide(true, marketplace_store:fade_bottom);
}
