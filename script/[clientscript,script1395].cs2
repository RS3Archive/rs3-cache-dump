if (%royal_quest >= 30) {
    if_sethide(true, misc_both_manage:miscb_if_rarewood_disable);
    if_sethide(true, misc_both_manage:miscb_if_farm_disable);
    ~rs3_background_panel(misc_both_manage:rarewood_back, rs3_content_container_active);
    ~rs3_background_panel(misc_both_manage:farm_back, rs3_content_container_active);
} else {
    if_sethide(false, misc_both_manage:miscb_if_rarewood_disable);
    if_sethide(false, misc_both_manage:miscb_if_farm_disable);
    ~rs3_background_panel(misc_both_manage:rarewood_back, rs3_content_container_inactive);
    ~rs3_background_panel(misc_both_manage:farm_back, rs3_content_container_inactive);
}
