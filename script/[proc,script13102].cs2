    case mtx86_arrav_upgraded_outfit_struct, mtx86_arrav_upgraded_head_struct, mtx86_arrav_upgraded_torso_struct, mtx86_arrav_upgraded_legs_struct, mtx86_arrav_upgraded_feet_struct, mtx86_arrav_upgraded_hands_struct, mtx86_arrav_upgraded_1h_sword_struct, mtx86_arrav_upgraded_1h_sword_o_struct, mtx86_arrav_upgraded_shield_struct :
        if (%q200_soa_override = 1 & %q200_arrav_outfit_override = 1 & %q200_arrav_sword_override = 1) {
