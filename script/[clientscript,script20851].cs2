// 20851
[clientscript,script20851](component $component0, int $int1)
if (cc_find($component0, $int1) = true) {
    if ($int1 = %marketplace_featured_rotator_index) {
        cc_setgraphic("marketplace_icon_pagination_indicator,0");
    } else {
        cc_setgraphic("marketplace_icon_pagination_indicator,1");
    }
}
