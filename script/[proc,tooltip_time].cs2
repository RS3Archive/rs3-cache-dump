// 4761
[proc,tooltip_time](int $int0)(boolean)
if (%varclient_1 < calc(clientclock + $int0)) {
    if (%varclient_1 < clientclock) {
        %varclient_1 = clientclock;
    }
    %varclient_1 = calc(%varclient_1 + 2);
    return(false);
}
%varclient_1 = calc(clientclock + $int0 + 10);
return(true);
