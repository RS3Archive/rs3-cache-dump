// 4761
[proc,tooltip_time](int $int0)(boolean)
if (%tooltip_time < calc(clientclock + $int0)) {
    if (%tooltip_time < clientclock) {
        %tooltip_time = clientclock;
    }
    %tooltip_time = calc(%tooltip_time + 2);
    return(false);
}
%tooltip_time = calc(clientclock + $int0 + 10);
return(true);
