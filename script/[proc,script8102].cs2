// 8102
[proc,script8102](wma $wma0)
if ($wma0 = main) {
    worldmap_3dview_setloddistance(0, calc((125000 + 167000) / 2));
    worldmap_3dview_setloddistance(1, calc(500000 * 2));
    worldmap_3dview_setloddistance(2, calc(500000 * 3));
} else {
    worldmap_3dview_setloddistance(0, calc(500000 * 2));
    worldmap_3dview_setloddistance(1, calc(500000 * 3));
    worldmap_3dview_setloddistance(2, calc(500000 * 4));
}
