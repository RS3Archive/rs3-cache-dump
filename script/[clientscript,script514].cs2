// 514
[clientscript,script514]
def_int $int0 = 0;
def_int $int1 = 0;
if (getwindowmode >= 2) {
    $int0 = if_getwidth(toplevel_v2:full_client_fade);
    $int1 = if_getheight(toplevel_v2:full_client_fade);
    if (%pog_hatch_zoom_var < $int0) {
        %pog_hatch_zoom_var = calc(%pog_hatch_zoom_var + 15);
        if_setsize(%pog_hatch_zoom_var, $int1, ^setsize_abs, ^setsize_abs, pog_door_hatch_close:shutter);
    }
} else if (%pog_hatch_zoom_var < 512) {
    %pog_hatch_zoom_var = calc(%pog_hatch_zoom_var + 15);
    if_setsize(%pog_hatch_zoom_var, 334, ^setsize_abs, ^setsize_abs, pog_door_hatch_close:shutter);
}
