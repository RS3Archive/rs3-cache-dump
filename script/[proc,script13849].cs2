[proc,script13849]
if_sethide(true, toplevel_v2_ribbon_select:size_display_1);
if_sethide(true, toplevel_v2_ribbon_select:size_display_2);
if_sethide(true, toplevel_v2_ribbon_select:size_display_3);
def_int $int0 = 0;
def_int $int1 = 0;
if (if_find(toplevel_v2_ribbon:ribbon_root) = true) {
    $int0 = cc_param(ribbon_last_drawn_count);
    $int1 = min(cc_param(ribbon_last_drawn_count_max), 30);
}
def_int $int2 = calc(44 * ($int0 % 15) - 7);
switch_int (calc($int0 / 15)) {
    case 0 :
        ~script13850(false, true, true, $int2, 0, 0);
    case 1 :
        ~script13850(false, false, true, 653, $int2, 0);
