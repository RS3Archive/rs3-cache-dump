// 9026
[proc,script9026](struct $struct0, quest $quest1, achievement $achievement2, component $component3)
def_string $string0 = ~crs_name($struct0, $quest1, $achievement2);
if_settext($string0, $component3);
if (string_length($string0) > 20) {
    if_settextfont(fontmetrics_207, $component3);
} else {
    if_settextfont(fontmetrics_168, $component3);
}
