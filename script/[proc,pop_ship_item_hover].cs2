// 7285
[proc,pop_ship_item_hover](int $int0, int $int1, component $component2, int $int3)
if ($int1 = 0) {
    ~deltooltip_action(pop_ship:tooltip_layer);
}
if (cc_find($component2, $int3) = true) {
    if ($int0 = 1) {
        if ($int1 = 1) {
            cc_setgraphic("aif_pop_ship_manager_item_tab,1");
        } else {
            cc_setgraphic("aif_pop_ship_manager_item_tab,2");
        }
    } else if ($int1 = 1) {
        cc_setgraphic("aif_pop_ship_manager_item_tab,1");
    } else {
        cc_setgraphic("aif_pop_ship_manager_item_tab,0");
    }
}
