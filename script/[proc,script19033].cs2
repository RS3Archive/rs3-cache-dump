// 19033
[proc,script19033]
def_string $string0 = "<tostring(calc(%trh183_key_use_tracking % 5))>/<tostring(5)>";
def_string $string1 = "<tostring(calc(%trh183_key_use_tracking % 10))>/<tostring(10)>";
def_string $string2 = "<tostring(%trh183_key_use_tracking)>/<tostring(20)>";
if (%trh183_power_up_1_charges >= 99) {
    $string0 = "MAX";
}
if (%trh183_power_up_2_charges >= 99) {
    $string1 = "MAX";
}
if (%trh183_power_up_3_charges >= 99) {
    $string2 = "MAX";
}
if_settext($string0, trh183_overlay:reroll_charge_progress);
if_settext($string1, trh183_overlay:multiplier_charge_progress);
if_settext($string2, trh183_overlay:freeze_charge_progress);
