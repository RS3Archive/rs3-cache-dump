        %wishing_well_player_donate_count = min(%wishing_well_player_max_amount, calc(%wishing_well_player_donate_count + 1));
    case 1 :
        if (%wishing_well_player_donate_count ! 1) {
            sound_vorbis_volume(tli_click_01, 1, 0, 255);
