// 7340
[clientscript,script7340]
if (%trh160_button_selected = 1) {
    if_setgraphic(container_unlock_qps_active, trh160_overlay:button_head_image);
    if_setgraphic("rs3_icon_wardrobe_item,1", trh160_overlay:button_head_icon);
} else {
    if_setgraphic(container_unlock_qps_inactive, trh160_overlay:button_head_image);
    if_setgraphic("rs3_icon_wardrobe_item,0", trh160_overlay:button_head_icon);
}
if (%trh160_button_selected = 2) {
    if_setgraphic(container_unlock_qps_active, trh160_overlay:button_body_image);
    if_setgraphic("rs3_icon_wardrobe_item,9", trh160_overlay:button_body_icon);
} else {
    if_setgraphic(container_unlock_qps_inactive, trh160_overlay:button_body_image);
    if_setgraphic("rs3_icon_wardrobe_item,8", trh160_overlay:button_body_icon);
}
if (%trh160_button_selected = 3) {
    if_setgraphic(container_unlock_qps_active, trh160_overlay:button_legs_image);
    if_setgraphic("rs3_icon_wardrobe_item,13", trh160_overlay:button_legs_icon);
} else {
    if_setgraphic(container_unlock_qps_inactive, trh160_overlay:button_legs_image);
    if_setgraphic("rs3_icon_wardrobe_item,12", trh160_overlay:button_legs_icon);
}
if (%trh160_button_selected = 4) {
    if_setgraphic(container_unlock_qps_active, trh160_overlay:button_feet_gloves_image);
    if_setgraphic("rs3_icon_wardrobe_item,17", trh160_overlay:button_feet_gloves_icon_1);
    if_setgraphic("rs3_icon_wardrobe_item,15", trh160_overlay:button_feet_gloves_icon_2);
} else {
    if_setgraphic(container_unlock_qps_inactive, trh160_overlay:button_feet_gloves_image);
    if_setgraphic("rs3_icon_wardrobe_item,16", trh160_overlay:button_feet_gloves_icon_1);
    if_setgraphic("rs3_icon_wardrobe_item,14", trh160_overlay:button_feet_gloves_icon_2);
}
if (%trh160_button_selected = 5) {
    if_setgraphic(container_unlock_qps_active, trh160_overlay:button_cloak_image);
    if_setgraphic("rs3_icon_wardrobe_item,3", trh160_overlay:button_cloak_icon);
} else {
    if_setgraphic(container_unlock_qps_inactive, trh160_overlay:button_cloak_image);
    if_setgraphic("rs3_icon_wardrobe_item,2", trh160_overlay:button_cloak_icon);
}
if (%trh160_button_selected = 6) {
    if_setgraphic(container_unlock_qps_active, trh160_overlay:button_lamp_image);
} else {
    if_setgraphic(container_unlock_qps_inactive, trh160_overlay:button_lamp_image);
}
