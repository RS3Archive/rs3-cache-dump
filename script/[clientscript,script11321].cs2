// 11321
[clientscript,script11321](component $component0)
def_graphic $graphic1 = "rs3_btn_checkbox,0";
def_graphic $graphic2 = "rs3_btn_checkbox,2";
if (%toplevel_v2_active_skinset = 1) {
    $graphic1 = "legacy_btn_checkbox,0";
    $graphic2 = "legacy_btn_checkbox,2";
}
if (if_getgraphic($component0) = $graphic1) {
    if_setgraphic($graphic2, $component0);
} else {
    if_setgraphic($graphic1, $component0);
}
