// 3903
[clientscript,script3903]
if (stat(mining) > stat_base(mining)) {
    ~script10624(combatv2_mining_nerfed_dummy_ability, 0);
    return;
} else if (stat(mining) < stat_base(mining)) {
    ~script10624(combatv2_mining_nerfed_dummy_ability, 1);
    return;
}
~script10624(combatv2_mining_nerfed_dummy_ability, 0);
