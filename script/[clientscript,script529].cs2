// 529
[clientscript,script529](int $int0)
if ($int0 = 1) {
    if_sethide(false, mobile_destroy:destroy_yes_all);
    if_setposition(0, 20, ^setpos_abs_centre, ^setpos_abs_bottom, mobile_destroy:destroy_yes);
    if_setposition(150, 20, ^setpos_abs_centre, ^setpos_abs_bottom, mobile_destroy:destroy_no);
} else {
    if_sethide(true, mobile_destroy:destroy_yes_all);
    if_setposition(-80, 20, ^setpos_abs_centre, ^setpos_abs_bottom, mobile_destroy:destroy_yes);
    if_setposition(80, 20, ^setpos_abs_centre, ^setpos_abs_bottom, mobile_destroy:destroy_no);
}
