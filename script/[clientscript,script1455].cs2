// 1455
[clientscript,script1455](component $component0)
if (%music_v3_protect = 1 | %cutscene_status = 1) {
    return;
}
switch_int (%music_loop_toggle_varc) {
    case default :
        ~script8800("Loop the current track", $component0, -1);
        if_setgraphic("aif_music_loop_button,3", $component0);
    case 1 :
        ~script8800("Stop the current track from looping", $component0, -1);
        if_setgraphic("aif_music_loop_button,1", $component0);
}
