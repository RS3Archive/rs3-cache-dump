// 19206
[proc,script19206](dbrow $dbrow0)(int)
switch_dbtable (db_getrowtable($dbrow0)) {
    case trh182_monsters :
        return(db_getfield($dbrow0, trh182_monsters:col4, 0));
    case trh203_nodes :
        return(db_getfield($dbrow0, trh203_nodes:col5, 0));
    case trh207_nodes :
        return(db_getfield($dbrow0, trh207_nodes:col5, 0));
    case default :
        ~error("Missed plugin point for DBTable.");
}
return(0);
