// 19206
[proc,script19206](dbrow $dbrow0)(int)
switch_dbtable (db_getrowtable($dbrow0)) {
    case dbtable_193 :
        return(db_getfield($dbrow0, dbtable_193:col4, 0));
    case dbtable_294 :
        return(db_getfield($dbrow0, dbtable_294:col5, 0));
    case dbtable_315 :
        return(db_getfield($dbrow0, dbtable_315:col5, 0));
    case default :
        ~error("Missed plugin point for DBTable.");
}
return(0);
