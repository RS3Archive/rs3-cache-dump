// 1774
[proc,clanwars_resynch_melee]
~static_checkbox(clanwars_setup:melee_indicator, ~bool_to_int(~not_bool(%clanwars_rulevarc_nomelee)), false);
if (%clanwars_rulevarc_nomelee = false) {
    if_settrans(0, clanwars_setup:melee);
} else {
    if_settrans(225, clanwars_setup:melee);
}
~clanwars_updateside;
