// 9791
[clientscript,script9791](int $int0)
if ($int0 = 5) {
    if_setontimer(null, loginscreen:close_button);
    if_setonop("loginscreen_quit(0)", loginscreen:close_button);
    if_setop(1, "Close", loginscreen:close_button);
} else {
    $int0 = calc($int0 + 1);
    if_setontimer("script9791($int0)", loginscreen:close_button);
}
