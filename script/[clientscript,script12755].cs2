// 12755
[clientscript,script12755](component $component0, component $component1, int $int2)
def_int $int3 = 0;
if (clientclock < $int2) {
    $int3 = min(255, calc(if_gettrans($component0) + 1));
    if_settrans($int3, $component0);
    if_settrans($int3, $component1);
    if ($int3 = 255) {
        if_setontimer(null, $component0);
    } else {
        if_setontimer("script12755($component0, $component1, $int2)", $component0);
    }
}
