// 5177
[clientscript,script5177](int $key0, char $char1)
def_int $int2 = -1;
switch_int ($key0) {
    case ^key_escape :
        ~script675;
        return;
    case ^key_1 :
        $int2 = 0;
    case ^key_2 :
        $int2 = 1;
    case ^key_3 :
        $int2 = 2;
    case ^key_4 :
        $int2 = 3;
    case ^key_5 :
        $int2 = 4;
    case default :
        switch_char ($char1) {
            case '1' :
                $int2 = 0;
            case '2' :
                $int2 = 1;
            case '3' :
                $int2 = 2;
            case '4' :
                $int2 = 3;
            case '5' :
                $int2 = 4;
            case default :
                return;
        }
}
if (cc_find(chat_v3_choice:choice_buttons_click, $int2) = true) {
    cc_resume_pausebutton;
}
