// 9711
[clientscript,script9711](component $component0, int $int1, int $int2)
def_int $int3 = 0;
def_int $int4 = calc(if_getwidth($component0) - $int1);
if ($int1 < 75) {
    $int3 = calc(6 - $int1 / 15);
    if_setontimer("script9705($int3)", wheel_of_fortune:wof_trh_ticker_tape_layer);
} else if ($int4 < 75) {
    $int3 = calc($int4 / 15 - 6);
    if_setontimer("script9705($int3)", wheel_of_fortune:wof_trh_ticker_tape_layer);
} else {
    if_setontimer(null, wheel_of_fortune:wof_trh_ticker_tape_layer);
}
