// 9711
[clientscript,script9711](component $component0, int $int1, int $int2)
def_int $int3 = 0;
def_int $int4 = calc(if_getwidth($component0) - $int1);
if ($int1 < 75) {
    $int3 = calc(6 - $int1 / 15);
    if_setontimer("script9705($int3)", interface_1253:com_173);
} else if ($int4 < 75) {
