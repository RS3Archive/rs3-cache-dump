// 13600
[clientscript,script13600](component $component0, component $component1)
if_settext("Close comparison", $component0);
if_setcolour(~script10495(3), $component0);
if_setsize(stringwidth(if_gettext($component0), if_getfontmetrics($component0)), 0, ^setsize_abs, ^setsize_minus, $component0);
if_setposition(calc(if_getwidth($component0) + 5), 0, ^setpos_abs_left, ^setpos_abs_centre, $component1);
