// 1992
[clientscript,town_hover](component $component0, boolean $boolean1)
if (%town_has_voted > 0) {
    return;
}
switch_component ($component0) {
    case town_map_vote:vote_1 :
        if_sethide($boolean1, town_map_vote:vote_1_highlight);
    case town_map_vote:vote_2 :
        if_sethide($boolean1, town_map_vote:vote_2_highlight);
}
