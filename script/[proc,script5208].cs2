// 5208
[proc,script5208](struct $struct0)(string)
def_int $int1 = struct_param($struct0, potion_info_stat_restore_basic_abs);
def_int $int2 = struct_param($struct0, potion_info_stat_restore_basic_pcent);
def_string $string0 = "";
if ($int1 > 0) {
    $string0 = "Restores negative stat changes in <col=00ffff>Attack, Constitution, Defense, Magic, Necromancy, Prayer, Ranged</col> and <col=00ffff>Strength</col> by <col=00ffff><tostring($int1)></col>";
}
if ($int2 > 0) {
    if ($int1 > 0) {
        $string0 = append($string0, " + <col=00ffff><tostring($int2)>%</col> of total level");
    } else {
        $string0 = "Restores negative stat changes in <col=00ffff>Attack, Constitution, Defense, Magic, Necromancy, Prayer, Ranged</col> and <col=00ffff>Strength</col> by <col=00ffff><tostring($int2)>%</col> of total level";
    }
}
if ($int1 > 0 | $int2 > 0) {
    $string0 = append($string0, ".");
}
return($string0);
