// 608
[proc,script608](component $component0)
if ($component0 ! null) {
    if_setopbase("<col=00FF00><%lore_spell_opbase>", $component0);
    if_settargetverb("Cast", $component0);
    if (%lore_spell_op_binary = 1) {
        if_setop(1, "Cast", $component0);
    }
}
if (if_find(toplevel_v2_combat_bar:spell_icon) = true) {
    cc_setopbase("<col=00FF00><%lore_spell_opbase>");
    cc_settargetverb("Cast");
    if (%lore_spell_op_binary = 1) {
        cc_setop(1, "Cast");
    }
}
if (if_find(topstat_lore:spell_icon) = true) {
    cc_setopbase("<col=00FF00><%lore_spell_opbase>");
    cc_settargetverb("Cast");
    if (%lore_spell_op_binary = 1) {
        cc_setop(1, "Cast");
    }
}
if (if_find(toplevel_v2_combat_bar_mobile:spell_icon) = true) {
    cc_setopbase("<col=00FF00><%lore_spell_opbase>");
    cc_settargetverb("Cast");
    if (%lore_spell_op_binary = 1) {
        cc_setop(1, "Cast");
    }
}
