while ($int0 < 10) {
    while ($int1 < 4) {
        cc_create(interface_1829:com_19, ^iftype_graphic, if_getnextsubid(interface_1829:com_19));
        cc_setsize(20, 20, ^setsize_abs, ^setsize_abs);
