// 20010
[proc,script20010](int $int0)(graphic)
switch_int ($int0) {
    case 1 :
        return(trh_rarity_spiral_white);
    case 2 :
        return(trh_rarity_spiral_yellow);
    case 3 :
        return(trh_rarity_spiral_orange);
    case 4 :
        return(trh_rarity_spiral_red);
    case 5 :
        return(trh_rarity_spiral_purple);
}
return(trh_rarity_spiral_purple);
