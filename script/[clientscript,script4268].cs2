switch_int ($int0) {
    case 1 :
        if_settext("Teleports you to the south of Falador.", interface_1083:com_138);
    case 2 :
        if_settext("Use on a degraded pouch to repair it and improve its strength, so it takes longer to degrade.", interface_1083:com_138);
    case 3 :
        if_settext("Teleports you to the north of Ardougne.", interface_1083:com_138);
    case 4 :
        if_settext("View the status of farming patches and cure any disease from a distance.", interface_1083:com_138);
    case 5 :
        if_settext("Heal your familiar, boost its combat stats and extends its lifetime by 20% of its starting value. Can only be used once per familiar, and once every two minutes.", interface_1083:com_138);
    case 6 :
        if_settext("Magically tans all hides of targeted type in your backpack.", interface_1083:com_138);
    case 7 :
        if_settext("Nullifies the next hit you receive from a player or NPC.", interface_1083:com_138);
    case 8 :
        if_settext("When cast, those nearby get to rebound damage.", interface_1083:com_138);
    case 9 :
        if_settext("Seeds will appear on the floor. Be quick to pick up the ones you want.", interface_1083:com_138);
    case 10 :
        if_settext("Puts a load of grimy herbs in your backpack.", interface_1083:com_138);
    case 11 :
        if_settext("Takes all the clean herbs in your backpack and turns them into unfinished potions of that herb type. This will work on noted herbs of up to 50 at a time.", interface_1083:com_138);
    case 12 :
        if_settext("Turns all lunar lumber in your backpack into runes. You'll need a full backpack of logs.", interface_1083:com_138);
    case 13 :
        if_settext("For the next thirty minutes, you'll find that you burn fewer fish.", interface_1083:com_138);
    case 14 :
        if_settext("This will be active for the next twenty minutes: when casting Plank Make, you will have a chance of receiving additional planks.", interface_1083:com_138);
    case 15 :
        if_settext("Teleports you to the farming patch in Trollheim.", interface_1083:com_138);
    case 16 :
        if_settext("Teleports you and those nearby to the farming patch in Trollheim.", interface_1083:com_138);
    case 17 :
        if_settext("Allows you to store and cast certain spells from the standard spellbook.<br>After learning this last spell, your current produce will be reduced by <~tostring_spacer(calc(enum(int, int, enum_3674, 10) * 10), ",")> and the remainder can be spent on wishes.", interface_1083:com_138);
    case 18 :
        if_settext("High value seeds will appear on the floor. Be quick to pick up the ones you want.", interface_1083:com_138);
    case 19 :
        if_settext("A new allotment patch will become available nearby. It will vanish if the patch is cleared.", interface_1083:com_138);
    case 20 :
        if_settext("Pauline will unset the Borrowed Power spell. Any unused charges will be refunded, but points spent to set the spell will not.", interface_1083:com_138);
    case 21 :
        if_settext("Pauline will set the Borrowed Power spell to a spell of your choice at the cost (in runes) of 1,000 casts of that spell. You will then be able to cast that spell through Borrowed Power 1,000 times.", interface_1083:com_138);
    case 22 :
        if (%varplayerbit_16374 < 11) {
            if_settext("Gives you a scroll which, when used on a fruit tree or tree patch, will protect that patch for the next 10 growths in that patch. ", interface_1083:com_138);
        } else {
            if_settext("Gives you a scroll which, when used on a fruit tree or tree patch, will protect that patch for the next 10 growths in that patch. You will need to use the scroll on a patch that is currently growing something and you must have the produce in your backpack that would cover the cost of protecting that patch normally.", interface_1083:com_138);
        }
}
