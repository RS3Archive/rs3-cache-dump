// 6857
[clientscript,script6857](int $int0, component $component1, int $int2)
def_int $int3 = calc(clientclock - $int0);
if ($int3 = 0 & $int2 = 1) {
    if_setmodelanim(seq_17717, interface_1355:com_1);
}
if ($int3 < 50) {
    if_settrans(calc(255 - scale($int3, 50, 255)), $component1);
} else if ($int3 = 50) {
    if_settrans(0, $component1);
    if_setmodelanim(null, interface_1355:com_1);
    if_setmodel(null, interface_1355:com_1);
} else if ($int3 > 100) {
