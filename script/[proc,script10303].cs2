// 10303
[proc,script10303](component $component0)(component)
if ($component0 = toplevel_v2_parent_suboverlay_group:main_layer) {
    return(toplevel_v2_parent_suboverlay_group:find_content_layer);
} else if ($component0 = group_child_dropdown:content_layer) {
    return(group_child_dropdown:find_content_layer);
} else {
    return(group_child:find_content_layer);
}
