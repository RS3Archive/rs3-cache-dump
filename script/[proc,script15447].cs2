// 15447
[proc,script15447]()(component)
switch_int (%mobile_zoom) {
    case default :
        return(null);
    case 0 :
        return(null);
    case 1 :
        return(~script8072);
    case 2 :
        return(toplevel_v2:parent_wrapper);
    case 3 :
        return(~script14198);
    case 4 :
        return(~script8071);
    case 5 :
        return(~script8074);
    case 6 :
        return(toplevel_v2:bank_window);
}
