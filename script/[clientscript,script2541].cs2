// 2541
[clientscript,script2541]
if (if_gethide(interface_38:com_11) = true) {
    if_settext("About Mining", interface_38:com_21);
    if_sethide(true, interface_38:com_10);
    if_sethide(true, interface_38:com_1);
    if_sethide(false, interface_38:com_11);
    if_sethide(false, interface_38:com_3);
} else {
    if_settext("About Smithing", interface_38:com_21);
    if_sethide(false, interface_38:com_10);
    if_sethide(false, interface_38:com_1);
    if_sethide(true, interface_38:com_11);
    if_sethide(true, interface_38:com_3);
}
