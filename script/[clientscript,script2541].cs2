// 2541
[clientscript,script2541]
if (if_gethide(msrework_beta:smithing_big) = true) {
    if_settext("About Mining", msrework_beta:toggle_button_text);
    if_sethide(true, msrework_beta:mining_big);
    if_sethide(true, msrework_beta:mining_icon);
    if_sethide(false, msrework_beta:smithing_big);
    if_sethide(false, msrework_beta:smithing_icon);
} else {
    if_settext("About Smithing", msrework_beta:toggle_button_text);
    if_sethide(false, msrework_beta:mining_big);
    if_sethide(false, msrework_beta:mining_icon);
    if_sethide(true, msrework_beta:smithing_big);
    if_sethide(true, msrework_beta:smithing_icon);
}
