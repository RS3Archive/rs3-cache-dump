// 18109
[proc,script18109](int $int0)
if ($int0 > if_getheight(bp3_buffs_tab:xp_buff_content_layer)) {
    if_setscrollsize(if_getwidth(bp3_buffs_tab:xp_buff_content_layer), calc($int0 + 10), bp3_buffs_tab:xp_buff_content_layer);
    ~rs3_scrollbar_vertical(bp3_buffs_tab:xp_buff_scroll_bar, bp3_buffs_tab:xp_buff_content_layer);
} else {
    if_setscrollsize(0, 0, bp3_buffs_tab:xp_buff_content_layer);
    cc_deleteall(bp3_buffs_tab:xp_buff_scroll_bar);
}
