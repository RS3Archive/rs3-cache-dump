// 12528
[proc,script12528]
def_int $int0 = 5;
def_int $int1 = 0;
def_component $component2 = null;
def_component $component3 = null;
while ($int1 < 5) {
    $component2, $component3 = ~script12527($int1);
    if (if_gethide($component2) = false) {
        if_setposition(0, $int0, ^setpos_abs_centre, ^setpos_abs_top, $component2);
        $int0 = calc($int0 + if_getheight($component2) + 5);
    }
    $int1 = calc($int1 + 1);
}
