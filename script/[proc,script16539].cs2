// 16539
[proc,script16539]
if (stat_base(magic) >= struct_param(magic_high_alch, combatv2_ability_level_req)) {
    ~script16542(inv_drop_areas:alch_icon, inv_drop_areas:alch_bg, "aif_magic_standard_icons,47", true, 0);
} else if (stat_base(magic) >= struct_param(magic_low_alchemy, combatv2_ability_level_req)) {
    ~script16542(inv_drop_areas:alch_icon, inv_drop_areas:alch_bg, "aif_magic_standard_icons,46", true, 0);
} else {
    ~script16542(inv_drop_areas:alch_icon, inv_drop_areas:alch_bg, "aif_magic_standard_icons,46", false, 0);
}
def_boolean $boolean0 = ~int_to_bool(%invent_has_tools);
~script16542(inv_drop_areas:diss_icon, inv_drop_areas:diss_bg, skill_icon_invention_35px, $boolean0, 0);
