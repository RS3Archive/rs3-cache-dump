// 20487
[proc,script20487](component $component0, component $component1, int $int2)(int)
def_int $int3 = 0;
if ($int2 > 0 & cc_find($component1, calc($int2 - 1)) = true) {
    $int3 = calc(cc_gety + cc_getheight);
}
cc_create(toplevel_v2:optext_content, ^iftype_graphic, if_getnextsubid(toplevel_v2:optext_content));
cc_setsize(0, 2, ^setsize_minus, ^setsize_abs);
