// 3620
[proc,script3620](int $int0, int $int1)
if (cc_find(runepass:click, $int0) = true) {
    %runepass_target_scroll = min(10515, max(0, calc(cc_gety - 400)));
}
if ($int1 = 1) {
    if_setscrollpos(0, %runepass_target_scroll, runepass:scrolling);
    %runepass_last_scroll = %runepass_target_scroll;
    %runepass_target_scroll = 0;
} else {
    %runepass_scroll_start = if_getscrolly(runepass:scrolling);
}
