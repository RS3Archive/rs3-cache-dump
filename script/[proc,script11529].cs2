// 11529
[proc,script11529](int $int0)
if ($int0 = 2) {
    if_sethide(false, mtxmgt_colour_overlay:prismatic_layer);
    if_sethide(true, mtxmgt_colour_overlay:button_layer);
    if_sethide(true, mtxmgt_colour_overlay:premium_colour_layer);
} else {
    if_sethide(true, mtxmgt_colour_overlay:prismatic_layer);
    if_sethide(false, mtxmgt_colour_overlay:button_layer);
    if_sethide(false, mtxmgt_colour_overlay:premium_colour_layer);
}
