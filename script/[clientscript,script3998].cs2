// 3998
[clientscript,script3998](component $component0)
if ($component0 = mtxfair17_bucking_yak:left_button_graphic) {
    if (%mtxfair17_yak_direction = 1) {
        if_setgraphic("mtxfair17_yakaroo_uiarrows,0", $component0);
    } else {
        if_setgraphic("mtxfair17_yakaroo_uiarrows,2", $component0);
    }
} else if (%mtxfair17_yak_direction = 2) {
    if_setgraphic("mtxfair17_yakaroo_uiarrows,0", $component0);
} else {
    if_setgraphic("mtxfair17_yakaroo_uiarrows,2", $component0);
}
