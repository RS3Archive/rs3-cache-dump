// 6962
[proc,script6962](component $component0)
switch_component ($component0) {
    case bank:default_op_1, group_ironman_storage:default_op_1 :
        %bank_customop = 2;
    case bank:default_op_5, group_ironman_storage:default_op_5 :
        %bank_customop = 3;
    case bank:default_op_10, group_ironman_storage:default_op_10 :
        %bank_customop = 4;
    case bank:default_op_x, bank:custom_x_input_display, group_ironman_storage:default_op_x, group_ironman_storage:custom_x_input_display :
        %bank_customop = 5;
    case bank:default_op_all_button, group_ironman_storage:default_op_all_button :
        %bank_customop = 7;
}
