// 7188
[proc,script7188](int $int0)
if ($int0 = 1) {
    if_sethide(false, cutscene_subtitle_panel:text_dropshadow);
    if_setsize(if_getwidth(cutscene_subtitle_panel:text), if_getheight(cutscene_subtitle_panel:text), ^setsize_abs, ^setsize_abs, cutscene_subtitle_panel:text_dropshadow);
    if_setposition(calc(1 + if_getx(cutscene_subtitle_panel:text)), calc(1 + if_gety(cutscene_subtitle_panel:text)), ^setpos_abs_left, ^setpos_abs_top, cutscene_subtitle_panel:text_dropshadow);
    if_settext(if_gettext(cutscene_subtitle_panel:text), cutscene_subtitle_panel:text_dropshadow);
    if_settextalign(^settextalign_left, ^settextalign_centre, 0, cutscene_subtitle_panel:text_dropshadow);
    if_settextfont(museo_sans_15pt_regular, cutscene_subtitle_panel:text_dropshadow);
} else {
    if_sethide(true, cutscene_subtitle_panel:text_dropshadow);
}
