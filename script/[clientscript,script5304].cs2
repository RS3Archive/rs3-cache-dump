// 5304
[clientscript,script5304](component $component0)
if ($component0 = clan_keep_theatre_spotlight:spot_colour_selected_1) {
    switch_int (%clan_keep_theatre_spot1_col) {
        case 0 :
            if_setcolour(^white, $component0);
        case 1 :
            if_setcolour(^yellow, $component0);
        case 2 :
            if_setcolour(^green, $component0);
        case 3 :
            if_setcolour(^blue, $component0);
        case 4 :
            if_setcolour(^red, $component0);
        case default :
            if_setcolour(^white, $component0);
    }
} else if ($component0 = clan_keep_theatre_spotlight:spot_colour_selected_2) {
