// 15007
[proc,script15007]
if_setontimer(null, mtxmgt:search_layer);
if (compare(%p_dialog_input, "") = 0) {
    ~script15002;
} else {
    %mtxmgt_search_save = %p_dialog_input;
    if_settext(escape(%p_dialog_input), mtxmgt:search_input_display);
    if_sethide(false, mtxmgt:search_input_clickout);
    if_sethide(false, mtxmgt:search_cancel);
    if_setonclick("script15005", mtxmgt:search_input_clickout);
    ~script7494;
    ~script7491(%mtxmgt_selected_tab_subcat, %mtxmgt_show_all, 0, %p_dialog_input);
    ~script13965(mtxmgt:search_background, null, rs3tli_text_entry_box);
}
