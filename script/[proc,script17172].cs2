// 17172
[proc,script17172](obj $obj0, int $int1)(int)
switch_int ($int1) {
    case 7, 6, 5, 12 :
        if ((oc_wearpos($obj0) = 0 | oc_wearpos($obj0) = 4 | oc_wearpos($obj0) = 7 | oc_wearpos($obj0) = 9 | oc_wearpos($obj0) = 10) & oc_param($obj0, combatv2_player_armour) > 0 & oc_param($obj0, combatv2_item_is_shield) = 0) {
            if (oc_param($obj0, melee_strength) > 0 | oc_param($obj0, ranged_strength) > 0 | oc_param($obj0, magic_strength) > 0 | oc_param($obj0, necromancy_strength) > 0) {
                return(2);
            } else {
                return(1);
            }
        }
}
return(0);
