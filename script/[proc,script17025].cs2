[proc,script17025](dbrow $dbrow0, int $int1)(int)
switch_dbrow ($dbrow0) {
    case trh_promo_vault_categories_trh178 :
        return(~script16478($int1));
    case trh181_prize_display_screen :
        return(~script13732($int1));
    case trh_promo_bonus_assassin_trh187, trh_promo_bonus_assassin_trh187_no_rare, trh_promo_bonus_assassin_orginal_outfits_only_trh187 :
