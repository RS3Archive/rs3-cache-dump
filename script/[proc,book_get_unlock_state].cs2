// 13039
[proc,book_get_unlock_state](dbrow $dbrow0)(int)
if ($dbrow0 = null) {
    return(1);
}
def_int $int1 = db_getfield($dbrow0, book:col0, 0);
if ($int1 < 0) {
    return(1);
}
switch_int (calc($int1 / 32)) {
    case 0 :
        return(testbit(%book_unlock_1, calc($int1 % 32)));
    case 1 :
        return(testbit(%book_unlock_2, calc($int1 % 32)));
    case 2 :
        return(testbit(%book_unlock_3, calc($int1 % 32)));
    case 3 :
        return(testbit(%book_unlock_4, calc($int1 % 32)));
    case 4 :
        return(testbit(%book_unlock_5, calc($int1 % 32)));
}
return(0);
