// 16957
[proc,trh186_overlay_setup]
cc_deleteall(wheel_of_fortune:fake_op);
def_int $int0 = 0;
while (++$int0 <= 14) {
    cc_create(wheel_of_fortune:fake_op, ^iftype_graphic, $int0);
}
if_setonvartransmit("trh186_overlay_update{trh_promos_var19, trh_promos_var19, trh_promos_var19, trh_promos_var19, trh_promos_var19, trh_promos_var19}", trh186_overlay:universe);
if_setontimer("script16963(0, trh186_overlay:select_genie)", trh186_overlay:genie_anim_timer);
if_setontimer("script16963(0, trh186_overlay:claim_genie)", trh186_overlay:genie_anim_timer);
if_setopcursor(1, cursor_hand, trh186_overlay:wish_click_layer_1);
if_setopcursor(1, cursor_hand, trh186_overlay:wish_click_layer_2);
if_setopcursor(1, cursor_hand, trh186_overlay:wish_click_layer_3);
if_setopcursor(1, cursor_hand, trh186_overlay:wish_1_graphic);
if_setopcursor(1, cursor_hand, trh186_overlay:wish_2_graphic);
if_setopcursor(1, cursor_hand, trh186_overlay:wish_3_graphic);
if_setopcursor(1, cursor_hand, trh186_overlay:claim_wish_layer);
if_setopcursor(1, cursor_hand, trh186_overlay:enhance_wish_layer);
