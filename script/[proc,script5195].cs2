// 5195
[proc,script5195]
if_sethide(true, hcape_interface:progress_block_1);
if_sethide(true, hcape_interface:progress_block_2);
if_sethide(true, hcape_interface:progress_block_3);
if_sethide(true, hcape_interface:progress_block_4);
if_setcolour(0xb59d69, hcape_interface:tier_text_1);
if_setcolour(0x78664b, hcape_interface:tier_text_2);
if_setcolour(0x78664b, hcape_interface:tier_text_3);
if_setcolour(0x78664b, hcape_interface:tier_text_4);
if_setcolour(0x78664b, hcape_interface:tier_text_5);
if_setgraphic("aif_display_number,2", hcape_interface:tier_marker_1);
if_setgraphic("aif_display_number,1", hcape_interface:tier_marker_2);
if_setgraphic("aif_display_number,1", hcape_interface:tier_marker_3);
if_setgraphic("aif_display_number,1", hcape_interface:tier_marker_4);
if_setgraphic("aif_display_number,1", hcape_interface:tier_marker_5);
if_sethide(true, hcape_interface:tier_highlight_1);
if_sethide(true, hcape_interface:tier_highlight_2);
if_sethide(true, hcape_interface:tier_highlight_3);
if_sethide(true, hcape_interface:tier_highlight_4);
if_sethide(true, hcape_interface:tier_highlight_5);
if (%hcape_current_tier >= 1) {
    if_sethide(false, hcape_interface:progress_block_1);
    if_setgraphic("aif_display_number,2", hcape_interface:tier_marker_2);
    if_setcolour(0xb59d69, hcape_interface:tier_text_2);
}
if (%hcape_current_tier >= 2) {
    if_sethide(false, hcape_interface:progress_block_2);
    if_setgraphic("aif_display_number,2", hcape_interface:tier_marker_3);
    if_setcolour(0xb59d69, hcape_interface:tier_text_3);
}
if (%hcape_current_tier >= 3) {
    if_sethide(false, hcape_interface:progress_block_3);
    if_setgraphic("aif_display_number,2", hcape_interface:tier_marker_4);
    if_setcolour(0xb59d69, hcape_interface:tier_text_4);
}
if (%hcape_current_tier >= 4) {
    if_sethide(false, hcape_interface:progress_block_4);
    if_setgraphic("aif_display_number,2", hcape_interface:tier_marker_5);
    if_setcolour(0xb59d69, hcape_interface:tier_text_5);
}
switch_int (%hcape_current_tier) {
    case 0 :
        if_sethide(false, hcape_interface:tier_highlight_1);
    case 1 :
        if_sethide(false, hcape_interface:tier_highlight_2);
    case 2 :
        if_sethide(false, hcape_interface:tier_highlight_3);
    case 3 :
        if_sethide(false, hcape_interface:tier_highlight_4);
    case 4 :
        if_sethide(false, hcape_interface:tier_highlight_5);
}
