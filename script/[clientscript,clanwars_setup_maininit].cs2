// 1796
[clientscript,clanwars_setup_maininit](component $component0)
%clanwars_rulevarc_endtype = 0;
%clanwars_rulevarc_timelimit = 0;
%clanwars_rulevarc_nostragglers = false;
%varclientbit_36998 = 0;
%varclientbit_36999 = 0;
%varclientbit_37000 = 0;
%clanwars_rulevarc_clanonly = false;
%clanwars_rulevarc_itemloss = false;
%clanwars_rulevarc_nomelee = false;
%clanwars_rulevarc_noranged = false;
%clanwars_rulevarc_nointercept = false;
if (map_members = false) {
    %clanwars_rulevarc_nomagic = 1;
    %clanwars_rulevarc_nosummoning = false;
    ~clanwars_resynch_magic;
    ~clanwars_resynch_summoning;
} else {
    %clanwars_rulevarc_nomagic = 0;
    %clanwars_rulevarc_nosummoning = false;
}
%clanwars_rulevarc_nofood = false;
%clanwars_rulevarc_nopotions = false;
%clanwars_rulevarc_noprayer = false;
%clanwars_rulevarc_arenachoice = 0;
%clanwars_rulevarc_accept = false;
%clanwars_rulevarc_opponentaccept = false;
if_setonvartransmit("clanwars_setup_vartransmit{clanwars_rules, clanwars, clanwars_challengeuid}", $component0);
if_setonvarctransmit("clanwars_setup_varctransmit{clanwars_rulevarc_opponentaccept}", $component0);
if_setonvarcstrtransmit("clanwars_setup_varcstrtransmit($component0){clanwars_opponentname}", $component0);
