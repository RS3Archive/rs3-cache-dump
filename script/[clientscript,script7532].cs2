// 7532
[clientscript,script7532](component $component0, component $component1)
if_sethide(true, slayer_contracts_menu:confirm_layer);
if_setonclick("script7540(1)", slayer_contracts_menu:confirm_dismiss);
def_enum $enum2 = null;
if (~inzone(0_53_55_0_0, 3_53_55_63_63, coord) = true) {
    $enum2 = slayer_contracts_list_slayertower;
} else if (~inzone(0_48_55_26_3, 0_48_54_34_60, coord) = true) {
    $enum2 = slayer_contracts_list_wilderness;
}
cc_deleteall($component0);
cc_deleteall($component1);
if_setscrollpos(0, 0, $component0);
if ($enum2 = null) {
    return;
}
def_int $int3 = calc(if_getwidth($component0) / 2);
def_int $int4 = 0;
def_int $int5 = 0;
def_struct $struct6 = enum(int, struct, $enum2, $int5);
while ($struct6 ! null) {
    cc_create($component0, ^iftype_rectangle, $int5);
    cc_setsize($int3, 90, ^setsize_abs, ^setsize_abs);
    cc_setposition(0, 0, ^setpos_abs_left, ^setpos_abs_top);
    cc_settrans(255);
    cc_setop(1, "Select");
    if (calc($int5 % 2) = 0) {
        cc_setontimer("script7533($component0, $int5, $int4, ^setpos_abs_left, $enum2, $struct6)");
    } else {
        cc_setontimer("script7533($component0, $int5, $int4, ^setpos_abs_right, $enum2, $struct6)");
    }
    $int5 = calc($int5 + 1);
    $struct6 = enum(int, struct, $enum2, $int5);
    if ($struct6 ! null) {
        if (calc($int5 % 2) = 0) {
            $int4 = calc($int4 + cc_getheight);
        }
    } else {
        $int4 = calc($int4 + cc_getheight);
    }
}
if ($int4 > if_getheight($component0)) {
    if_setscrollsize(0, calc($int4 + 5), $component0);
} else {
    if_setscrollsize(0, 0, $component0);
}
~rs3_scrollbar_vertical($component1, $component0);
