// 5873
[proc,script5873](component $component0, component $component1, component $component2, component $component3)
if_settext(%rand_progress_bar_title, $component0);
if (%rand_progress_bar_fill_value > 200) {
    %rand_progress_bar_fill_value = 200;
}
def_int $int4 = %rand_progress_bar_fill_value;
$int4 = calc($int4 * 37 / 40 + 14);
if_setsize($int4, 18, ^setsize_minus, ^setsize_abs, $component1);
if_setposition(calc($int4 + 1), 15, ^setpos_abs_left, ^setpos_abs_top, $component2);
if (%rand_progress_bar_fill_value = 200) {
    if_setcolour(0x64ffff, $component3);
} else {
    if_setcolour(^white, $component3);
}
