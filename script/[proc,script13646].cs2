    if_sethide(true, mtxrunefest2017:progress_bar_outer);
    if_sethide(true, mtxrunefest2017:progress);
} else {
    if_sethide(false, mtxrunefest2017:progress_bar_outer);
    if_sethide(false, mtxrunefest2017:progress);
}
switch_int ($int0) {
    case 0 :
        $string0 = "Select a chip";
        $string1 = "Click on a skillchip icon to learn more about the task.";
    case 1 :
        $string0 = "Catherby";
        $string1 = "Throw 8 ripe tomatoes at the JMod on Catherby Beach from the nearby bucket.";
