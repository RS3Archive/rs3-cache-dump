[clientscript,script10333]
def_string $string0 = "";
def_graphic $graphic0 = null;
switch_graphic (if_getgraphic(group_child:set_status_button)) {
    case "rs3_icon_grouping_system,1" :
        $graphic0, $string0 = "rs3_icon_grouping_system,2", "You are marked as ready.";
    case "rs3_icon_grouping_system,2" :
        $graphic0, $string0 = "rs3_icon_grouping_system,1", "You are marked as not ready.";
    case default :
        return;
}
~script10336($graphic0, $string0);
