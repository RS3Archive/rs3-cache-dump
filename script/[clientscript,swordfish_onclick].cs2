// 10575
[clientscript,swordfish_onclick]
if (%trh29_titles1_owned = 1) {
    return;
}
if (inv_total(inv, trh29_doubloons) < 1500) {
    return;
}
if (inv_freespace(inv) = 0) {
    return;
}
%trh29_pirate_coins_shop_selection = 5;
if_setgraphic(trh29_pirate_icon_swordfish, trh29_pirate_coins_shop:popup_icon);
if_settext("Slay your enemies with this stuffed hunter of the seas. (Two-handed sword with level 1 and level 40 versions)", trh29_pirate_coins_shop:popup_description);
if_settext("Buy the two-handed swordfish?", trh29_pirate_coins_shop:popup_question);
if_sethide(false, trh29_pirate_coins_shop:popup_layer);
