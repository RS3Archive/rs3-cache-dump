// 10051
[proc,script10051]
def_component $component0 = lobbyscreen_pane_playerinfo:bottom_left_title_text;
def_component $component1 = lobbyscreen_pane_playerinfo:bottom_centre_title_text;
def_component $component2 = lobbyscreen_pane_playerinfo:bottom_right_title_text;
if (paraheight(if_gettext($component0), if_getwidth($component0), cinzel_18pt_bold) > 1 | paraheight(if_gettext($component1), if_getwidth($component1), cinzel_18pt_bold) > 1 | paraheight(if_gettext($component2), if_getwidth($component2), cinzel_18pt_bold) > 1) {
    if_settextfont(cinzel_15pt_bold, $component0);
    if_settextfont(cinzel_15pt_bold, $component1);
    if_settextfont(cinzel_15pt_bold, $component2);
} else {
    if_settextfont(cinzel_18pt_bold, $component0);
    if_settextfont(cinzel_18pt_bold, $component1);
    if_settextfont(cinzel_18pt_bold, $component2);
}
