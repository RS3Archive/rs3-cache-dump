// 17262
[proc,script17262](int $int0)(int)
if ($int0 <= 0) {
    return(^false);
}
def_int $int1 = calc($int0 % 32);
switch_int (calc($int0 / 32)) {
    case 0 :
        return(testbit(%psr_xpblockskills_0, $int1));
    case 1 :
        return(testbit(%psr_xpblockskills_1, $int1));
    case default :
        ~error("Unable to get xpblock status of skill with ^stat_ #<tostring($int0)>");
}
return(^false);
