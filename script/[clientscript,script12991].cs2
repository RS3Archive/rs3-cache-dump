// 12991
[clientscript,script12991]
switch_int (%quest_endgame_choice_6awe2_choice) {
    case 0 :
        if_sethide(true, quest_endgame_replay:armadyl_checkbox_selected_layer);
        if_sethide(true, quest_endgame_replay:bandos_checkbox_selected_layer);
    case 3 :
        if_sethide(false, quest_endgame_replay:armadyl_checkbox_selected_layer);
        if_sethide(true, quest_endgame_replay:bandos_checkbox_selected_layer);
    case 4 :
        if_sethide(true, quest_endgame_replay:armadyl_checkbox_selected_layer);
        if_sethide(false, quest_endgame_replay:bandos_checkbox_selected_layer);
}
