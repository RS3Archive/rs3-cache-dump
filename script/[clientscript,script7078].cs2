// 7078
[clientscript,script7078](component $component0)
if (%ooak_dragonflight_bob_2 ! 1) {
    if (%ooak_dragonflight_bob < 25) {
        if (calc(%ooak_dragonflight_bob % 1) = 0) {
            if_setposition(if_getx($component0), calc(5 + if_gety($component0)), ^setpos_abs_left, ^setpos_abs_top, $component0);
        }
        %ooak_dragonflight_bob = calc(%ooak_dragonflight_bob + 1);
    } else {
        %ooak_dragonflight_bob_2 = 1;
        %ooak_dragonflight_bob = 0;
    }
} else if (%ooak_dragonflight_bob < 25) {
    if (calc(%ooak_dragonflight_bob % 1) = 0) {
        if_setposition(if_getx($component0), calc(if_gety($component0) - 5), ^setpos_abs_left, ^setpos_abs_top, $component0);
    }
    %ooak_dragonflight_bob = calc(%ooak_dragonflight_bob + 1);
} else {
    %ooak_dragonflight_bob_2 = 0;
    %ooak_dragonflight_bob = 0;
}
