// 5017
[clientscript,script5017](component $component0, component $component1, graphic $graphic2, graphic $graphic3, int $int4, int $int5, int $int6)
if_setgraphic($graphic2, $component0);
if_setgraphic($graphic3, $component1);
if ($int6 >= 5) {
    if_setcolour(hsvtorgb($int4), $component0);
    if_setcolour(hsvtorgb($int5), $component1);
} else {
    if_setcolour(hsvtorgb(6716), $component0);
    if_setcolour(hsvtorgb(6716), $component1);
}
