// 7229
[proc,script7229](int $int0, int $int1, int $int2, int $int3)
$int0 = min($int0, 6);
switch_int (calc(min($int1, $int0) % 6)) {
    case 1 :
        cc_setposition(0, calc($int2 + 35 * ($int3 / $int0)), ^setpos_abs_centre, ^setpos_abs_top);
    case 2 :
        switch_int (calc($int3 % $int0)) {
            case 0 :
                cc_setposition(calc((0 - 36) / 2), calc($int2 + 35 * ($int3 / $int0)), ^setpos_abs_centre, ^setpos_abs_top);
            case 1 :
                cc_setposition(calc(36 / 2), calc($int2 + 35 * ($int3 / $int0)), ^setpos_abs_centre, ^setpos_abs_top);
        }
    case 3 :
        switch_int (calc($int3 % $int0)) {
            case 0 :
                cc_setposition(calc(0 - 36), calc($int2 + 35 * ($int3 / $int0)), ^setpos_abs_centre, ^setpos_abs_top);
            case 1 :
                cc_setposition(0, calc($int2 + 35 * ($int3 / $int0)), ^setpos_abs_centre, ^setpos_abs_top);
            case 2 :
                cc_setposition(36, calc($int2 + 35 * ($int3 / $int0)), ^setpos_abs_centre, ^setpos_abs_top);
        }
    case 4 :
        switch_int (calc($int3 % $int0)) {
            case 0 :
                cc_setposition(scale(calc(0 - 36), 2, 3), calc($int2 + 35 * ($int3 / $int0)), ^setpos_abs_centre, ^setpos_abs_top);
            case 1 :
                cc_setposition(calc((0 - 36) / 2), calc($int2 + 35 * ($int3 / $int0)), ^setpos_abs_centre, ^setpos_abs_top);
            case 2 :
                cc_setposition(calc(36 / 2), calc($int2 + 35 * ($int3 / $int0)), ^setpos_abs_centre, ^setpos_abs_top);
            case 3 :
                cc_setposition(scale(36, 2, 3), calc($int2 + 35 * ($int3 / $int0)), ^setpos_abs_centre, ^setpos_abs_top);
        }
    case 5 :
        switch_int (calc($int3 % $int0)) {
            case 0 :
                cc_setposition(calc((0 - 36) * 2), calc($int2 + 35 * ($int3 / $int0)), ^setpos_abs_centre, ^setpos_abs_top);
            case 1 :
                cc_setposition(calc(0 - 36), calc($int2 + 35 * ($int3 / $int0)), ^setpos_abs_centre, ^setpos_abs_top);
            case 2 :
                cc_setposition(0, calc($int2 + 35 * ($int3 / $int0)), ^setpos_abs_centre, ^setpos_abs_top);
            case 3 :
                cc_setposition(36, calc($int2 + 35 * ($int3 / $int0)), ^setpos_abs_centre, ^setpos_abs_top);
            case 4 :
                cc_setposition(calc(36 * 2), calc($int2 + 35 * ($int3 / $int0)), ^setpos_abs_centre, ^setpos_abs_top);
        }
    case default :
        switch_int (calc($int3 % $int0)) {
            case 0 :
                cc_setposition(scale(calc(0 - 36), 2, 5), calc($int2 + 35 * ($int3 / $int0)), ^setpos_abs_centre, ^setpos_abs_top);
            case 1 :
                cc_setposition(scale(calc(0 - 36), 2, 3), calc($int2 + 35 * ($int3 / $int0)), ^setpos_abs_centre, ^setpos_abs_top);
            case 2 :
                cc_setposition(calc((0 - 36) / 2), calc($int2 + 35 * ($int3 / $int0)), ^setpos_abs_centre, ^setpos_abs_top);
            case 3 :
                cc_setposition(calc(36 / 2), calc($int2 + 35 * ($int3 / $int0)), ^setpos_abs_centre, ^setpos_abs_top);
            case 4 :
                cc_setposition(scale(36, 2, 3), calc($int2 + 35 * ($int3 / $int0)), ^setpos_abs_centre, ^setpos_abs_top);
            case 5 :
                cc_setposition(scale(36, 2, 5), calc($int2 + 35 * ($int3 / $int0)), ^setpos_abs_centre, ^setpos_abs_top);
        }
}
