// 6925
[proc,script6925](int $int0)
def_obj $obj1 = inv_getobj(worn, $int0);
if ($obj1 ! null) {
    cc_setsize(36, 32, ^setsize_abs, ^setsize_abs);
    cc_setobject($obj1, inv_getnum(worn, $int0));
    cc_setoutline(1);
    cc_setposition(2, 0, ^setpos_abs_centre, ^setpos_abs_centre);
} else {
    cc_setsize(32, 32, ^setsize_abs, ^setsize_abs);
    cc_setgraphic(enum(int, graphic, wornitems_emptyslot, $int0));
    cc_setoutline(0);
    cc_setposition(0, 0, ^setpos_abs_centre, ^setpos_abs_centre);
}
