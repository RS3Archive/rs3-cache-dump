// 19144
[proc,script19144](struct $struct0)(inv)
switch_struct ($struct0) {
    case trh182_promo :
        return(trh182_monster_loot);
    case trh203_promo :
        return(trh203_node_loot);
    case trh207_promo :
        return(trh207_node_loot);
    case default :
        ~error("Missed plugin point for promo ID <tostring(struct_param($struct0, trh_promo_id))>");
}
return(null);
