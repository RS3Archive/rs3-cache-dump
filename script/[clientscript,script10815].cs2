// 10815
[clientscript,script10815](int $key0)
switch_int ($key0) {
    case default :
        return;
    case ^key_f2 :
        ~script835;
        return;
    case ^key_escape :
        if (~cancel_targetmode = true) {
            return;
        }
        if_close;
        ~machinima_close(toplevel_v2:machinima_camera);
        return;
    case ^key_space :
        if (if_gethide(machinima_livecamera:ui) = true) {
            if_sethide(false, machinima_livecamera:ui);
        } else {
            if_sethide(true, machinima_livecamera:ui);
        }
        return;
}
