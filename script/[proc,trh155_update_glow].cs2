// 11536
[proc,trh155_update_glow]
if (%trh155_promo_bonus_remaining = 0) {
    if_setgraphic(background_phoenix_rising_smouldering, wheel_of_fortune:background);
    cc_deleteall(wheel_of_fortune:background_holder);
    if_sethide(true, trh155_overlay:bonus_layer);
} else {
    ~script17173;
    if_sethide(false, trh155_overlay:bonus_layer);
}
