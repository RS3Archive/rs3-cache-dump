// 6665
[clientscript,script6665](component $component0, component $component1, int $int2)
if ($int2 = -1) {
    if_setontimer("script6664(event_com, $component1, 0)", $component0);
    if_setonclick("script6665(event_com, $component1, event_mousex)", $component0);
} else {
    $int2 = calc($int2 - if_getwidth($component0) / 2);
    if ($int2 >= 0) {
        if_setontimer("script6664(event_com, $component1, 1)", $component0);
    } else {
        if_setontimer("script6664(event_com, $component1, -1)", $component0);
    }
    if_setonclick("script6665(event_com, $component1, -1)", $component0);
}
