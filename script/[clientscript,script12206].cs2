// 12206
[clientscript,script12206](component $component0)
def_obj $obj1 = null;
switch_component ($component0) {
    case trh80_corrupt:helmet_button_active :
        $obj1 = trh80_grotesque_head;
    case trh80_corrupt:chestplate_button_active :
        $obj1 = trh80_grotesque_torso;
    case trh80_corrupt:legplates_button_active :
        $obj1 = trh80_grotesque_legs;
