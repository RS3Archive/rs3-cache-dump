    case trh80_corrupt:cape_button_active :
        $obj1 = trh80_grotesque_back;
    case trh80_corrupt:wings_button_active :
        $obj1 = trh80_grotesque_wings;
    case trh80_corrupt:soulgem_button_active :
        $obj1 = trh80_soul_gem;
    case trh80_corrupt:gauntlets_button_disabled, trh80_corrupt:boots_button_disabled, trh80_corrupt:helmet_button_disabled, trh80_corrupt:legplates_button_disabled, trh80_corrupt:chestplate_button_disabled, trh80_corrupt:cape_button_disabled, trh80_corrupt:wings_button_disabled :
        mes("You have already unlocked that reward.");
        return;
}
if (~script12207($obj1) >= 1) {
    mes("You have already unlocked that item.");
    return;
}
def_int $int2 = enum(obj, int, trh80_item_cost, $obj1);
if (inv_total(inv, trh80_corrupted_soul) < $int2) {
    mes("You don't have enough grotesque souls to create that item.");
    return;
}
def_string $string0 = enum(obj, string, trh80_name_from_obj, $obj1);
if ($component0 = trh80_corrupt:soulgem_button_active) {
    if_settext("Are you sure you want to create a <$string0> for <tostring_localised($int2, true)> grotesque souls?", trh80_corrupt:confirm_purchase_text);
} else {
    if_settext("Are you sure you want to create the <$string0> for <tostring_localised($int2, true)> grotesque souls? You will receive <tostring(calc(3 * $int2))> Slayer XP.", trh80_corrupt:confirm_purchase_text);
}
if_sethide(false, trh80_corrupt:darkness);
if_sethide(false, trh80_corrupt:confirm_purchase);
