// 16846
[proc,script16846]()(obj)
def_int $int0 = stat_base(attack);
def_int $int1 = stat_base(ranged);
def_int $int2 = stat_base(magic);
if ($int0 >= $int1) {
    if ($int0 >= $int2) {
        return(gamemode_seasonal_fss_weapon_t20_melee);
    } else if ($int2 >= $int1) {
        return(gamemode_seasonal_fss_weapon_t20_magic);
    } else {
        return(gamemode_seasonal_fss_weapon_t20_range);
    }
} else if ($int1 >= $int2) {
    return(gamemode_seasonal_fss_weapon_t20_range);
} else {
    return(gamemode_seasonal_fss_weapon_t20_magic);
}
