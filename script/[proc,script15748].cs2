// 15748
[proc,script15748](string $string0)
def_dbrow $dbrow0 = null;
$dbrow0 = ~script16590(platformtype, $string0);
if ($dbrow0 = null) {
    return;
}
if (db_getfield($dbrow0, mobile_shop_feature_information:col19, 0) = true) {
    %mobile_shop_membership_purchased = 1;
}
switch_dbrow ($dbrow0) {
    case mobile_shop_bundle_runecoins_2400_keys_450 :
        %mobile_shop_launch_currency_pack = 1;
    case mobile_shop_mobile_membership_level_1 :
        %mobile_shop_launch_membership_pack_1 = 1;
    case mobile_shop_mobile_membership_level_2 :
        %mobile_shop_launch_membership_pack_2 = 1;
    case mobile_shop_membership_prem_gold_20_21 :
        %mobile_shop_premier_club_20_21_expiry = calc(%atlum_day_tracker + 365);
    case mobile_shop_membership_prem_21_22 :
        %mobile_shop_membership_prem_21_22 = 1;
    case mobile_shop_returner_pack_small :
        %mobile_shop_returner_pack_small = 1;
    case mobile_shop_returner_pack_medium :
        %mobile_shop_returner_pack_medium = 1;
    case mobile_shop_returner_pack_large :
        %mobile_shop_returner_pack_large = 1;
    case mobile_shop_necro_release_bundle, mobile_shop_necro_release_bundle_sale, mobile_shop_necro_release_bundle_bolt_ons :
        %mobile_shop_necro_release_bundle = 1;
    case mobile_shop_bundle_ultimtate_currency_half_price, mobile_shop_bundle_ultimtate_currency_quarter_price :
        %mobile_shop_bundle_ultimtate_currency_dec_2023 = 1;
    case mobile_shop_small_xmas_bundle_2023 :
        %mobile_shop_small_xmas_bundle_2023 = 1;
    case mobile_shop_medium_xmas_bundle_2023 :
        %mobile_shop_medium_xmas_bundle_2023 = 1;
    case mobile_shop_large_xmas_bundle_2023 :
        %mobile_shop_large_xmas_bundle_2023 = 1;
    case mobile_shop_black_prime_pack, mobile_shop_black_prime_pack_with_membership :
        %mobile_shop_black_primal_pack = 1;
    case mobile_shop_dxp_protean_pack :
        %mobile_shop_dxp_protean_pack = 1;
    case mobile_shop_celestial_pack, mobile_shop_celestial_pack_with_membership :
        %mobile_shop_celestial_pack = 1;
    case mobile_shop_jan25_golden_bundle_small :
        %mobile_shop_jan25_golden_bundle_small = 1;
    case mobile_shop_jan25_golden_bundle_medium :
        %mobile_shop_jan25_golden_bundle_medium = 1;
    case mobile_shop_jan25_golden_bundle_large :
        %mobile_shop_jan25_golden_bundle_large = 1;
    case mobile_shop_mtx_direct_bundle_large_stars_small :
        %mobile_shop_mtx_direct_bundle_large_stars_small = 1;
    case mobile_shop_mtx_direct_bundle_large_stars_medium :
        %mobile_shop_mtx_direct_bundle_large_stars_medium = 1;
    case mobile_shop_mtx_direct_bundle_large_stars_large :
        %mobile_shop_mtx_direct_bundle_large_stars_large = 1;
    case mobile_shop_mtx_direct_bundle_small_xpbombs_small :
        %mobile_shop_mtx_direct_bundle_small_xpbombs_small = 1;
    case mobile_shop_mtx_direct_bundle_small_xpbombs_medium :
        %mobile_shop_mtx_direct_bundle_small_xpbombs_medium = 1;
    case mobile_shop_mtx_direct_bundle_small_xpbombs_large :
        %mobile_shop_mtx_direct_bundle_small_xpbombs_large = 1;
    case mobile_shop_desert_wanderer_bundle_with_membership, mobile_shop_desert_wanderer_bundle :
        %mobile_shop_mtx_desert_wanderer_bundle = 1;
}
