// 19906
[proc,script19906](dbrow $dbrow0, dbrow $dbrow1)
if ($dbrow0 = trh189_solar_mage | $dbrow0 = trh189_evil_pirate_boss) {
    if_setmodelzoom(410, trh189_overlay:solar_armour);
}
if ($dbrow1 = trh189_lunar_mage | $dbrow1 = trh189_good_pirate_boss) {
    if_setmodelzoom(410, trh189_overlay:lunar_armour);
}
