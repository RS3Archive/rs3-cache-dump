// 5396
[proc,script5396](struct $struct0)(string)
def_int $int1 = struct_param($struct0, potion_info_run_energy);
if ($int1 > 0) {
    return("Restores <col=00ff00><tostring($int1)>% run energy</col>.");
} else if ($int1 < 0) {
    return("Removes <col=ff0000><tostring(abs($int1))>% run energy</col>.");
} else {
    return("");
}
