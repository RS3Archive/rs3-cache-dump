// 789
[proc,script789](int $int0)(graphic, graphic)
if (%toplevel_v2_legacy_interface = 1 & %toplevel_v2_mobile_interface = 0) {
    switch_int ($int0) {
        case default :
            return("rs_legacy_icon_worldmap,0", "rs_legacy_icon_worldmap,1");
        case 2 :
            return("rs_legacy_icon_worldmap_citadel,0", "rs_legacy_icon_worldmap_citadel,1");
        case 1 :
            return("aif_toplevel_worldmap_btn,2", "aif_toplevel_worldmap_btn,3");
    }
} else {
    switch_int ($int0) {
        case default :
            if (%toplevel_v2_mobile_interface = 1) {
                return(btn_mobile_worldmap, btn_mobile_worldmap);
            } else {
                return(navigation_icon_worldmap_on, navigation_icon_worldmap_over);
            }
        case 2 :
            return(rs3_navigation_icon_citadel_normal, rs3_navigation_icon_citadel_over);
        case 1 :
            if (%toplevel_v2_mobile_interface = 1) {
                return(btn_mobile_worldmap_dg, btn_mobile_worldmap_dg);
            } else {
                return("aif_toplevel_worldmap_btn,2", "aif_toplevel_worldmap_btn,3");
            }
    }
}
