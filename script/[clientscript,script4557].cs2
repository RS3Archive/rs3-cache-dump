// 4557
[clientscript,script4557]
if (clan_getchatcount > 0) {
    clan_leavechat;
} else if (%friends_chat_allowed = 0) {
    mes_typed(^chattype_friendschatnotification, 0, "You need to be a member or a minimum total level of 150 to join a Friends Chat.");
    return;
} else {
    ~lobbyscreen_input("Join Chat Channel", "", 5, "", "");
}
