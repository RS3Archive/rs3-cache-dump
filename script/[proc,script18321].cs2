// 18321
[proc,script18321](component $component0, component $component1)(component)
if ($component0 = activity_progress_bar:container) {
    return($component1);
}
switch_component ($component1) {
    case activity_progress_bar:container :
        return(activity_progress_bar_extension:container);
    case activity_progress_bar:beam_right :
        return(activity_progress_bar_extension:beam_right);
    case activity_progress_bar:beam_left :
        return(activity_progress_bar_extension:beam_left);
    case activity_progress_bar:lightning_right :
        return(activity_progress_bar_extension:lightning_right);
    case activity_progress_bar:lightning_left :
        return(activity_progress_bar_extension:lightning_left);
    case activity_progress_bar:tooltip_progress_amount :
        return(activity_progress_bar_extension:tooltip_progress_amount);
    case activity_progress_bar:progress_bar_red :
        return(activity_progress_bar_extension:progress_bar_red);
    case activity_progress_bar:red_wave_effect :
        return(activity_progress_bar_extension:red_wave_effect);
    case activity_progress_bar:prog_bg_mid :
        return(activity_progress_bar_extension:prog_bg_mid);
    case activity_progress_bar:prog_bg_left :
        return(activity_progress_bar_extension:prog_bg_left);
    case activity_progress_bar:prog_bg_right :
        return(activity_progress_bar_extension:prog_bg_right);
    case activity_progress_bar:progress_diamond_left :
        return(activity_progress_bar_extension:progress_diamond_left);
    case activity_progress_bar:progress_diamond_right :
        return(activity_progress_bar_extension:progress_diamond_right);
    case activity_progress_bar:progress_bar :
        return(activity_progress_bar_extension:progress_bar);
    case activity_progress_bar:progress_bar_fill :
        return(activity_progress_bar_extension:progress_bar_fill);
    case activity_progress_bar:progress_bar_fill_underlay :
        return(activity_progress_bar_extension:progress_bar_fill_underlay);
    case activity_progress_bar:progress_bar_end :
        return(activity_progress_bar_extension:progress_bar_end);
    case activity_progress_bar:progress_markers :
        return(activity_progress_bar_extension:progress_markers);
    case activity_progress_bar:marker1 :
        return(activity_progress_bar_extension:marker1);
    case activity_progress_bar:marker2 :
        return(activity_progress_bar_extension:marker2);
    case activity_progress_bar:marker3 :
        return(activity_progress_bar_extension:marker3);
    case activity_progress_bar:marker4 :
        return(activity_progress_bar_extension:marker4);
    case activity_progress_bar:marker5 :
        return(activity_progress_bar_extension:marker5);
    case activity_progress_bar:activity_backing_left :
        return(activity_progress_bar_extension:activity_backing_left);
    case activity_progress_bar:activity_backing_right :
        return(activity_progress_bar_extension:activity_backing_right);
    case activity_progress_bar:activity_backing_tile :
        return(activity_progress_bar_extension:activity_backing_tile);
    case activity_progress_bar:activity_name_text :
        return(activity_progress_bar_extension:activity_name_text);
    case activity_progress_bar:activity_name :
        return(activity_progress_bar_extension:activity_name);
}
return($component1);
