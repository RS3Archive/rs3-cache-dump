// 6936
[clientscript,script6936]
def_string $string0 = "Absolutely nothing";
def_string $string1 = $string0;
def_int $int0 = calc(1 - 1);
def_int $int1 = 1;
while ($int0 >= 0) {
    if (invother_getnum(dueloffer, $int0) > 0) {
        $int1 = 0;
        $int0 = 0;
    }
    $int0 = calc($int0 - 1);
}
if (inv_freespace(dueloffer) < 1) {
    if (%worldswitcher_2ndfavfailed >= 0) {
        $string0 = "<tostring_localised(%worldswitcher_2ndfavfailed, true)> gp";
    } else {
        $string0 = "Unknown value";
    }
}
if ($int1 = 0) {
    if (%vkq2_chem_slot >= 0) {
        $string1 = "<tostring_localised(%vkq2_chem_slot, true)> gp";
    } else {
        $string1 = "Unknown value";
    }
}
if (%worldswitcher_2ndfavfailed < 0 | %vkq2_chem_slot < 0) {
    $string0, $string1 = "<col=ff0000><$string0></col>", "<col=ff0000><$string1></col>";
} else if (%worldswitcher_2ndfavfailed > %vkq2_chem_slot) {
    $string1 = "<col=ff0000><$string1></col>";
} else if (%worldswitcher_2ndfavfailed < %vkq2_chem_slot) {
    $string0 = "<col=ff0000><$string0></col>";
}
if_settext($string0, duel3_options:my_stake_value);
if_settext($string1, duel3_options:their_stake_value);
