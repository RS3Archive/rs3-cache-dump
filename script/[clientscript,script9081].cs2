// 9081
[clientscript,script9081](component $component0, int $int1, int $int2, int $int3, achievement $achievement4, int $int5)
if (cc_find($component0, $int1) = true) {
    ~script9082($int2, $int3, $achievement4, $int5);
}
if (cc_find($component0, calc($int1 + 1)) = true) {
    ~script3562($int2, $int3, $achievement4, $int5);
}
