def_boolean $boolean0 = false;
if (%trh193_currency >= 400) {
    $boolean0 = true;
}
if ($boolean0 = true) {
    if_setop(1, "Buy Bonus", trh193_overlay:currency_buy_button);
} else {
    if_setop(1, "", trh193_overlay:currency_buy_button);
}
if_setenabled($boolean0, trh193_overlay:currency_buy_button);
