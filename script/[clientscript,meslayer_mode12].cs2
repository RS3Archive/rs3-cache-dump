[clientscript,meslayer_mode12](int $int0)
if_sethide(false, meslayer:root);
if ($int0 ! 1) {
    return;
}
if (~bool_to_int(%clanwars_caller_init) = 0) {
    %clanwars_caller = "";
    %clanwars_caller_lastusedstring = "";
