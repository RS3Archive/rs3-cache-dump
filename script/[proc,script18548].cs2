~if_settext(interface_1288:com_152, "Each boss returns for <col=F0BE79>2 days</col> alongside a <col=F0BE79>new ability override</col>.<br>On <col=F0BE79>13th March</col>, all bosses and overrides return!");
def_string $string0 = "Echo of Zamorak + Chaotic Overrides<br>";
if (~script18536 = true) {
    $string0 = append($string0, "<col=FF00>Available now</col>");
    if_sethide(false, interface_1288:com_126);
} else {
    $string0 = append($string0, "<col=F0BE79>7th & 8th March</col>");
}
~if_settext(interface_1288:com_129, $string0);
~script3536("Chaotic Assault (NEW!)", interface_1288:com_130, -1);
def_string $string1 = "Echo of Arch-Glacor + Azure Overrides<br>";
if (~script18537 = true) {
    $string1 = append($string1, "<col=FF00>Available now</col>");
    if_sethide(false, interface_1288:com_132);
} else {
    $string1 = append($string1, "<col=F0BE79>9th & 10th March</col>");
}
~if_settext(interface_1288:com_137, $string1);
~script3536("Azure Hurricane (NEW!)", interface_1288:com_138, -1);
def_string $string2 = "Echo of Croesus + Fungal Overrides<br>";
if (~script18538 = true) {
    $string2 = append($string2, "<col=FF00>Available now</col>");
    if_sethide(false, interface_1288:com_140);
} else {
    $string2 = append($string2, "<col=F0BE79>11th & 12th March</col>");
}
~if_settext(interface_1288:com_143, $string2);
~script3536("Fungal Swiftness (NEW!)", interface_1288:com_144, -1);
