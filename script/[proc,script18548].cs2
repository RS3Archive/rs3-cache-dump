// 18548
[proc,script18548]
if_sethide(true, trh_academy_shared_overlay:splash_screen_title);
if_sethide(false, trh_academy_shared_overlay:splash_screen_title_graphic);
~script4170(trh_academy_shared_overlay:splash_screen_title_graphic, trh182_all_stars_title_en, trh182_all_stars_title_de, trh182_all_stars_title_fr, trh182_all_stars_title_pt);
~if_settext(trh_academy_shared_overlay:splash_screen_desc, "Each boss returns for <col=F0BE79>2 days</col> alongside a <col=F0BE79>new ability override</col>.<br>On <col=F0BE79>13th March</col>, all bosses and overrides return!");
def_string $string0 = "Echo of Zamorak + Chaotic Overrides<br>";
if (~script18536 = true) {
    $string0 = append($string0, "<col=FF00>Available now</col>");
    if_sethide(false, trh_academy_shared_overlay:npc_highlight_1);
} else {
    $string0 = append($string0, "<col=F0BE79>7th & 8th March</col>");
}
~if_settext(trh_academy_shared_overlay:splash_screen_npc_text_1, $string0);
~script3536("Chaotic Assault (NEW!)", trh_academy_shared_overlay:npc_tooltip_layer_1, -1);
def_string $string1 = "Echo of Arch-Glacor + Azure Overrides<br>";
if (~script18537 = true) {
    $string1 = append($string1, "<col=FF00>Available now</col>");
    if_sethide(false, trh_academy_shared_overlay:npc_highlight_2);
} else {
    $string1 = append($string1, "<col=F0BE79>9th & 10th March</col>");
}
~if_settext(trh_academy_shared_overlay:splash_screen_npc_text_2, $string1);
~script3536("Azure Hurricane (NEW!)", trh_academy_shared_overlay:npc_tooltip_layer_2, -1);
def_string $string2 = "Echo of Croesus + Fungal Overrides<br>";
if (~script18538 = true) {
    $string2 = append($string2, "<col=FF00>Available now</col>");
    if_sethide(false, trh_academy_shared_overlay:npc_highlight_3);
} else {
    $string2 = append($string2, "<col=F0BE79>11th & 12th March</col>");
}
~if_settext(trh_academy_shared_overlay:splash_screen_npc_text_3, $string2);
~script3536("Fungal Swiftness (NEW!)", trh_academy_shared_overlay:npc_tooltip_layer_3, -1);
