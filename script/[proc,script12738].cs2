// 12738
[proc,script12738]
def_string $string0 = "A wonderful prize!";
def_component $component0 = null;
if_sethide(true, trh104_overlay:prize_model1);
if_sethide(true, trh104_overlay:prize_model2);
if_sethide(true, trh104_overlay:prize_model3);
if_sethide(true, trh104_overlay:prize_model4);
if_sethide(true, trh104_overlay:prize_model5);
if_sethide(true, trh104_overlay:prize_model6);
if_sethide(true, trh104_overlay:prize_model7);
if_sethide(true, trh104_overlay:prize_model8);
if_sethide(true, trh104_overlay:prize_model_default);
switch_int (%trh104_prestige) {
    case 0 :
        $string0 = oc_name(trh104_helm);
        $component0 = trh104_overlay:prize_model1;
    case 1 :
        $string0 = oc_name(trh104_gloves);
        $component0 = trh104_overlay:prize_model2;
    case 2 :
        $string0 = oc_name(trh104_legs);
        $component0 = trh104_overlay:prize_model3;
    case 3 :
        $string0 = oc_name(trh104_boots);
        $component0 = trh104_overlay:prize_model4;
    case 4 :
        $string0 = oc_name(trh104_torso);
        $component0 = trh104_overlay:prize_model5;
    case 5 :
        $string0 = oc_name(trh104_2h_magic);
        $component0 = trh104_overlay:prize_model6;
    case 6 :
        $string0 = oc_name(trh104_2h_range);
        $component0 = trh104_overlay:prize_model7;
    case 7 :
        $string0 = oc_name(trh104_2h_melee);
        $component0 = trh104_overlay:prize_model8;
    case default :
        $string0 = oc_name(trh104_scroll_huge);
        $component0 = trh104_overlay:prize_model_default;
}
if_sethide(false, $component0);
if_setonmouserepeat("script8799($string0, $component0, -1)", $component0);
