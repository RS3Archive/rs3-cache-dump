// 5657
[clientscript,xp_display_text_ontimer](component $component0, int $int1, int $int2)
def_int $int3 = 0;
if (cc_find($component0, $int1) = true) {
    if ($int2 < 10) {
        $int2 = calc($int2 + 1);
        cc_setontimer("xp_display_text_ontimer($component0, $int1, $int2)");
        return;
    }
    $int3 = cc_gettrans;
    if ($int3 < 255) {
        $int3 = min(calc(cc_gettrans + 2), 255);
        cc_settrans($int3);
        cc_setposition(0, max(calc(cc_gety - 4), 0), ^setpos_abs_centre, ^setpos_abs_top);
    }
    if ($int3 >= 255) {
        cc_delete;
    } else {
        cc_setontimer("xp_display_text_ontimer($component0, $int1, $int2)");
    }
}
