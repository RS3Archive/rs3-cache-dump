// 10030
[proc,script10030](string $string0, string $string1, string $string2, boolean $boolean0, int $int1)
if (compare($string0, "") = 0 | compare($string1, "") = 0) {
    return;
}
~lobby_popup(0, lobby_popup_default, "Opening link", "Please Wait", rs3_loading_spinner_default, "", "");
openurl_shim($string0, $string1, $string2, $boolean0);
%lobby_lightbox_clock = clientclock;
if ($int1 = 1) {
    if_setontimer("script6032(0)", lobbyscreen:subscribe_timer);
} else {
    if_setontimer("script12373(0)", lobbyscreen:subscribe_timer);
}
