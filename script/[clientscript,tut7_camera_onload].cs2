// 15791
[clientscript,tut7_camera_onload]
switch_int (%tut7_main) {
    case 10 :
        if (~script6431 = true) {
            if_settext("Pinch to<br>zoom your camera", tut7_camera:heading);
            ~tut7_camera_graphic(tut7_camera_frames_zoom_mobile);
        } else {
            if_settext("Use Scroll-wheel to<br>zoom your camera", tut7_camera:heading);
            ~tut7_camera_graphic(tut7_camera_frames_zoom_desktop);
        }
    case 15 :
        if (~script6431 = true) {
            if_settext("Touch and Drag to<br>rotate your camera", tut7_camera:heading);
            ~tut7_camera_graphic(tut7_camera_frames_rotate_mobile);
        } else {
            if_settext("Press Scroll-wheel and Drag to<br>rotate your camera", tut7_camera:heading);
            ~tut7_camera_graphic(tut7_camera_frames_rotate_desktop);
        }
}
~script13969(tut7_camera:continue_button, null, rs3tli_neutral_button, "Continue");
