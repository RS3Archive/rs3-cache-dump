// 12732
[proc,trh104_update_ui](int $int0)
def_int $int1 = 0;
def_int $int2 = 0;
$int1, $int2 = ~trh104_get_progress;
if_settext(tostring($int1), trh104_overlay:num);
if_settext("/ <tostring($int2)>", trh104_overlay:total);
if_settext("<tostring(calc(%trh104_current_map + 1))> / 8", trh104_overlay:level);
if_settext(tostring(%trh104_tokens), trh104_overlay:tokens);
if_settext("Voyages completed: <tostring(%trh104_prestige)>", trh104_overlay:nextprize);
if_setgraphic(~trh104_get_map_graphic, trh104_overlay:background_map);
~script12736;
~script12733;
~script12738;
~script12749;
