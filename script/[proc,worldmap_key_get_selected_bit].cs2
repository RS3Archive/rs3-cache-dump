// 9635
[proc,worldmap_key_get_selected_bit](int $int0)(int)
def_int $int1 = -1;
def_int $int2 = calc($int0 / 32);
def_int $int3 = calc($int0 % 32);
switch_int ($int2) {
    case 0 :
        $int1 = testbit(%varclient_3928, $int3);
    case 1 :
        $int1 = testbit(%varclient_3929, $int3);
    case 2 :
        $int1 = testbit(%varclient_3930, $int3);
    case 3 :
        $int1 = testbit(%varclient_3931, $int3);
    case 4 :
        $int1 = testbit(%varclient_3932, $int3);
    case 5 :
        $int1 = testbit(%varclient_8300, $int3);
    case default :
        ~error("worldmap_key_get_selected_bit - Hitting default case for mapicon bits, new var needed!");
}
return($int1);
