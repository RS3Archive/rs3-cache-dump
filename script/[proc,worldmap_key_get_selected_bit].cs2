// 9635
[proc,worldmap_key_get_selected_bit](int $int0)(int)
def_int $int1 = -1;
def_int $int2 = calc($int0 / 32);
def_int $int3 = calc($int0 % 32);
switch_int ($int2) {
    case 0 :
        $int1 = testbit(%worldmap_selected_keys_int0, $int3);
    case 1 :
        $int1 = testbit(%worldmap_selected_keys_int1, $int3);
    case 2 :
        $int1 = testbit(%worldmap_selected_keys_int2, $int3);
    case 3 :
        $int1 = testbit(%worldmap_selected_keys_int3, $int3);
    case 4 :
        $int1 = testbit(%worldmap_selected_keys_int4, $int3);
    case 5 :
        $int1 = testbit(%worldmap_selected_keys_int5, $int3);
    case default :
        ~error("worldmap_key_get_selected_bit - Hitting default case for mapicon bits, new var needed!");
}
return($int1);
