// 9023
[clientscript,script9023]
if (if_gethide(featured_main:crs_req_layer) = true) {
    if_sethide(false, featured_main:crs_req_layer);
    if_setgraphic("rs3_icon_info_21px,1", featured_main:crs_reqs_met_icon);
} else {
    if_sethide(true, featured_main:crs_req_layer);
    if_setgraphic("rs3_icon_info_21px,0", featured_main:crs_reqs_met_icon);
}
