// 16675
[clientscript,trh185_update]
if (cc_find(wheel_of_fortune:background_holder, 1) = true & .cc_findbycategory(wheel_of_fortune:background_holder, 1, 3) = 1) {
    ~script16665("Opening chests will fill the bar, the more chests opened the higher chance of getting a Plague Chest.", wheel_of_fortune:background_holder, .cc_getid);
}
if (cc_findbycategory(wheel_of_fortune:background_holder, 1, 1) = 1) {
    cc_setsize(0, calc(30 + scale(~script16647, 500, 300)), ^setsize_minus, ^setsize_abs);
}
if (cc_findbycategory(wheel_of_fortune:background_holder, 1, 3) = 1) {
    cc_settext(~script16650);
}
if (cc_find(wheel_of_fortune:background_holder, 2) = true & .cc_findbycategory(wheel_of_fortune:background_holder, 2, 3) = 1) {
    ~script16665(~script16689, wheel_of_fortune:background_holder, .cc_getid);
}
if (cc_findbycategory(wheel_of_fortune:background_holder, 2, 1) = 1) {
    cc_setsize(0, calc(21 + scale(~script16648, 15, 320)), ^setsize_minus, ^setsize_abs);
}
if (cc_findbycategory(wheel_of_fortune:background_holder, 2, 3) = 1) {
    cc_settext(~script16654);
}
def_obj $obj0 = null;
def_int $int1 = 0;
if (cc_findbycategory(wheel_of_fortune:background_holder, 2, 4) = 1) {
    $obj0, $int1 = ~script16653(%trh185_progress_track_reward_id);
    if (oc_param($obj0, mtxmgt_category) = 2) {
        cc_setgraphic(enum(int, graphic, trh185_progress_prize_graphic, %trh185_progress_track_reward_id));
        ~script16670;
    } else {
        cc_setobject($obj0, $int1);
        cc_setsize(50, 50, ^setsize_abs, ^setsize_abs);
    }
}
~trh185_set_background;
if (cc_findbycategory(wheel_of_fortune:background_holder, 3, 0) = 1) {
    cc_sethide(~not_bool(~script16682));
}
if (cc_findbycategory(wheel_of_fortune:background_holder, 3, 1) = 1) {
    cc_sethide(~script16682);
}
if (cc_findbycategory(wheel_of_fortune:background_holder, 3, 2) = 1) {
    cc_sethide(~script16682);
}
if (cc_findbycategory(wheel_of_fortune:background_holder, 0, 0) = 1) {
    cc_sethide(~not_bool(~script16682));
}
if (cc_find(wheel_of_fortune:foreground_wrapper, 0) = true) {
    cc_sethide(~script16682);
}
if (cc_find(wheel_of_fortune:foreground_wrapper, 1) = true) {
    cc_sethide(~not_bool(~script16682));
}
~script7780;
