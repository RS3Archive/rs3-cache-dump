// 4445
[proc,script4445](component $component0)
def_struct $struct1 = ~clan_chat_get_struct($component0);
def_component $component2 = struct_param($struct1, guest_chat_drag);
def_component $component3 = struct_param($struct1, guest_chat_rectangles);
def_component $component4 = struct_param($struct1, guest_chat_clanlist);
def_component $component5 = struct_param($struct1, guest_chat_clanlist_rank);
def_component $component6 = struct_param($struct1, guest_chat_clanlist_world);
def_component $component7 = struct_param($struct1, guest_chat_clanlist_worldicon);
def_component $component8 = struct_param($struct1, guest_chat_info);
def_component $component9 = struct_param($struct1, guest_chat_joinleave_graphic);
def_component $component10 = struct_param($struct1, guest_chat_clan_name);
def_component $component11 = struct_param($struct1, guest_chat_joinleave_layer);
def_int $int12 = 0;
while ($int12 < 600) {
    if (cc_find($component4, $int12) = true) {
        cc_sethide(true);
    }
    if (cc_find($component3, $int12) = true) {
        cc_sethide(true);
    }
    if (cc_find($component5, $int12) = true) {
        cc_sethide(true);
    }
    if (cc_find($component6, $int12) = true) {
        cc_sethide(true);
    }
    if (cc_find($component7, $int12) = true) {
        cc_sethide(true);
    }
    $int12 = calc($int12 + 1);
}
if_setop(1, "Join chat", $component11);
if_setgraphic("aif_clanchat_icons,13", $component9);
if_sethide(true, $component2);
if_sethide(false, $component8);
if_settext("", $component10);
def_string $string0 = "Join another<br>clan's clan chat.";
if_setonmouserepeat("script8799($string0, event_com, event_comsubid)", $component11);
if_setonmouseleave("script8805", $component11);
if_setop(1, "Join Clan Chat channel", $component11);
