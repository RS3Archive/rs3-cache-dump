// 1702
[proc,scrollbar_horizontal_doscroll](component $component0, component $component1, int $int2, int $int3)
def_int $int4 = max(1, calc(if_getscrollwidth($component1) - if_getwidth($component1)));
$int2 = min(max(0, $int2), $int4);
def_int $int5 = if_getscrollx($component1);
if_setscrollpos($int2, if_getscrolly($component1), $component1);
switch_component ($component1) {
    case interface_1588:com_2, interface_1681:com_5 :
        ~telemetry_set_scroll_horizontal($component1, $int2, $int3);
    case interface_1843:com_261 :
        ~script13174($int5, $int2);
    case interface_853:com_3, interface_855:com_5, interface_843:com_6 :
        ~script16220($component1, $int2);
    case interface_1227:com_36 :
        ~script18026($component1, $int2, $int4);
}
def_int $int6 = 0;
if (cc_find($component0, 1) = true) {
    if (%varplayerbit_22875 = 2 | cc_param(param_7986) = 2) {
        $int6 = calc(if_getwidth($component0) - cc_getwidth);
        cc_setposition(scale($int2, $int4, $int6), 4, ^setpos_abs_left, ^setpos_abs_top);
    } else {
        $int6 = calc(if_getwidth($component0) - 32 - cc_getwidth - 10);
        cc_setposition(calc(21 + scale($int2, $int4, $int6)), 0, ^setpos_abs_left, ^setpos_abs_top);
    }
    if (.cc_find($component0, 2) = true) {
        .cc_setposition(calc(cc_getx - 5), 0, ^setpos_abs_left, ^setpos_abs_top);
    }
    if (.cc_find($component0, 3) = true) {
        .cc_setposition(calc(cc_getx + cc_getwidth), 0, ^setpos_abs_left, ^setpos_abs_top);
    }
}
