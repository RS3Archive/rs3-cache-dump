// 10567
[clientscript,script10567]
if (%trh29_pirate_sheep_unlocked = 1) {
    return;
}
if (inv_total(inv, trh29_doubloons) < 3000) {
    return;
}
%trh29_pirate_coins_shop_selection = 1;
if_setgraphic(trh29_pirate_icon_sheep, trh29_pirate_coins_shop:popup_icon);
if_settext("A pirate sheep companion pet, who keeps calm even when things get woolly out at sea.", trh29_pirate_coins_shop:popup_description);
if_settext("Buy pirate sheep?", trh29_pirate_coins_shop:popup_question);
if_sethide(false, trh29_pirate_coins_shop:popup_layer);
