// 1582
[clientscript,script1582](component $component0)
def_string $string0 = %hvh_opp_name;
def_int $int1 = if_getwidth($component0);
if (parawidth($string0, ^max_32bit_int, if_getfontmetrics($component0)) > $int1) {
    while (parawidth("<$string0>...", ^max_32bit_int, if_getfontmetrics($component0)) > $int1) {
        $string0 = substring($string0, 0, calc(string_length($string0) - 1));
    }
    $string0 = "<$string0>...";
    if_setonmouserepeat("script8799(%hvh_opp_name, $component0, -1)", $component0);
} else {
    if_setonmouserepeat(null, $component0);
}
if_settext($string0, $component0);
