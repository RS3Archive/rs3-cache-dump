// 10844
[clientscript,dom_points_refresh]
if_settext(tostring(%dom_reward_points), dom_climber:current_points);
if (%dom_reward_points > 0) {
    if_settext(tostring(calc(%dom_reward_points / 3)), dom_climber:death_points);
} else {
    if_settext(tostring(%dom_climber_prog), dom_climber:death_points);
}
