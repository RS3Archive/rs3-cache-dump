// 16976
[proc,script16976]
switch_int (%trh188_tutorial_current_step) {
    case 0 :
        if_sethide(true, trh188:spells);
        if_sethide(true, trh188:ingredient_1_info_layer);
        if_sethide(true, trh188:ingredient_1_layer);
        if_sethide(true, trh188:ingredient_2_info_layer);
        if_sethide(true, trh188:ingredient_2_layer);
        if_sethide(true, trh188:ingredient_3_info_layer);
        if_sethide(true, trh188:ingredient_3_layer);
    case 1, 2 :
        if_sethide(true, trh188:spells);
        if_sethide(false, trh188:ingredient_1_info_layer);
        if_sethide(false, trh188:ingredient_1_layer);
        if_sethide(true, trh188:ingredient_2_info_layer);
        if_sethide(true, trh188:ingredient_2_layer);
        if_sethide(true, trh188:ingredient_3_info_layer);
        if_sethide(true, trh188:ingredient_3_layer);
    case 3, 4 :
        if_sethide(true, trh188:spells);
        if_sethide(false, trh188:ingredient_2_info_layer);
        if_sethide(false, trh188:ingredient_2_layer);
        if_sethide(true, trh188:ingredient_3_info_layer);
        if_sethide(true, trh188:ingredient_3_layer);
    case 5, 6 :
        if_sethide(true, trh188:spells);
        if_sethide(false, trh188:ingredient_3_info_layer);
        if_sethide(false, trh188:ingredient_3_layer);
    case 7 :
        if_sethide(true, trh188:spells);
    case 8 :
        if_sethide(false, trh188:spells);
}
