// 19304
[proc,script19304](int $int0)
sound_vorbis_rate(tli_click_01, 1, 0, 160, random_sound_pitch(10, 10));
def_struct $struct1 = ~script16161;
switch_struct ($struct1) {
    case trh202_promo :
        switch_int (map_lang) {
            case 0 :
                if_setgraphic(trh_dungeon_crawl_daemonheim_title_en, trh_dungeon_crawl_overlay:splash_title_graphic);
            case 1 :
                if_setgraphic(trh_dungeon_crawl_daemonheim_title_de, trh_dungeon_crawl_overlay:splash_title_graphic);
            case 2 :
                if_setgraphic(trh_dungeon_crawl_daemonheim_title_fr, trh_dungeon_crawl_overlay:splash_title_graphic);
            case 3 :
                if_setgraphic(trh_dungeon_crawl_daemonheim_title_pt, trh_dungeon_crawl_overlay:splash_title_graphic);
        }
}
if_sethide(true, trh_dungeon_crawl_overlay:splash_page_1_layer);
if_sethide(true, trh_dungeon_crawl_overlay:splash_page_2_layer);
if_sethide(true, trh_dungeon_crawl_overlay:splash_page_3_layer);
switch_int ($int0) {
    case 1 :
        if_sethide(false, trh_dungeon_crawl_overlay:splash_page_1_layer);
        ~script19269(trh_dungeon_crawl_overlay:splash_page_1_button_graphic, trh_dungeon_crawl_overlay:splash_page_1_button_layer);
    case 2 :
        if_sethide(false, trh_dungeon_crawl_overlay:splash_page_2_layer);
        ~script19269(trh_dungeon_crawl_overlay:splash_page_2_button_graphic, trh_dungeon_crawl_overlay:splash_page_2_button_layer);
    case 3 :
        if_sethide(false, trh_dungeon_crawl_overlay:splash_page_3_layer);
        ~script19305;
}
