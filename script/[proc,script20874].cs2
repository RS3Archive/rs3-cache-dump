// 20874
[proc,script20874]
def_int $int0 = 0;
def_int $int1 = 0;
def_int $int2 = 0;
def_int $int3 = 0;
if (if_find(stockmarket:offeritem_marketprice) = true & .if_find(stockmarket:offeritem_marketpriceicon) = true) {
    $int1 = cc_getwidth;
    $int2 = parawidth(cc_gettext, $int1, museo_sans_11pt_regular);
    $int3 = .cc_getwidth;
    $int0 = calc(($int1 - $int2) / 2 - ($int3 - 5));
    .cc_setposition($int0, 14, ^setpos_abs_left, ^setpos_abs_bottom);
}
if (if_find(stockmarket:offeritem_recentprice) = true & .if_find(stockmarket:offeritem_recentpriceicon) = true) {
    $int1 = cc_getwidth;
