// 9815
[clientscript,script9815](component $component0)
def_int $int1 = 0;
def_int $int2 = 0;
if (if_find($component0) = true & .if_find(cc_getparentlayer) = true) {
    $int1 = .cc_getwidth;
    $int2 = .cc_getheight;
    if (scale($int1, cc_param(param_8059), cc_param(param_8060)) < $int2) {
        cc_setsize($int1, scale($int1, cc_param(param_8059), cc_param(param_8060)), ^setsize_abs, ^setsize_abs);
    } else {
        cc_setsize(scale($int2, cc_param(param_8060), cc_param(param_8059)), $int2, ^setsize_abs, ^setsize_abs);
    }
    cc_callonresize;
}
