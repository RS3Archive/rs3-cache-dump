// 20021
[clientscript,trh210_interface_init]
cc_deleteall(wheel_of_fortune:fake_op);
def_int $int0 = -1;
while (++$int0 < 4) {
    cc_create(wheel_of_fortune:fake_op, ^iftype_graphic, $int0);
}
def_int $int1 = 0;
while (++$int1 <= 8) {
    ~script20025($int1);
}
if_setsize(200, 120, ^setsize_abs, ^setsize_abs, wheel_of_fortune:wheel_spin_button_layer_1);
if_setposition(100, 60, ^setpos_abs_left, ^setpos_abs_top, wheel_of_fortune:wheel_spin_button_layer_1);
if_setopcursor(1, cursor_use, trh210_overlay:currency_buy_button);
if_setopcursor(1, wof_trh_key_cursor, trh210_overlay:trail_pos_1);
~script20023;
