[clientscript,script5377]
if (if_find(hw11_dancefloor_manual:spread1) = true) {
    cc_sethide(true);
}
if (if_find(hw11_dancefloor_manual:spread2) = true) {
    cc_sethide(false);
}
if (if_find(hw11_dancefloor_manual:spread3) = true) {
    cc_sethide(true);
}
if (if_find(hw11_dancefloor_manual:pagenum_left) = true) {
    cc_settext("Page 3");
}
if (if_find(hw11_dancefloor_manual:pagenum_right) = true) {
    cc_settext("Page 4");
}
