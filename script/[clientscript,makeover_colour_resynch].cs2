// 2378
[clientscript,makeover_colour_resynch](component $component0)
def_component $component1 = null;
switch_int (%player_kit_mom_colour) {
    case 0 :
        $component1 = makeover_mage:colour0;
    case 1 :
        $component1 = makeover_mage:colour1;
    case 2 :
        $component1 = makeover_mage:colour2;
    case 3 :
        $component1 = makeover_mage:colour3;
    case 4 :
        $component1 = makeover_mage:colour4;
    case 5 :
        $component1 = makeover_mage:colour5;
    case 6 :
        $component1 = makeover_mage:colour6;
    case 7 :
        $component1 = makeover_mage:colour7;
    case 8 :
        $component1 = makeover_mage:colour8;
    case 9 :
        $component1 = makeover_mage:colour9;
    case 10 :
        $component1 = makeover_mage:colour10;
    case 11 :
        $component1 = makeover_mage:colour11;
    case 13 :
        $component1 = makeover_mage:colour13;
        $component0 = makeover_mage:tick_promo;
    case 37 :
        $component1 = makeover_mage:colour37;
        $component0 = makeover_mage:tick_promo;
    case 38 :
        $component1 = makeover_mage:colour38;
        $component0 = makeover_mage:tick_promo;
}
~makeover_colour($component1, $component0);
