// 6661
[clientscript,script6661](component $component0)
def_int $int1 = -1;
switch_component ($component0) {
    case clav_customise:all_crystal_button :
        if (~script7768 = true) {
            $int1 = 2;
        }
    case clav_customise:all_water_button :
        $int1 = 4;
    case clav_customise:all_lava_button :
        $int1 = 3;
    case clav_customise:all_magic_button :
        $int1 = 1;
    case clav_customise:all_nature_button :
        $int1 = 5;
}
if ($int1 = -1) {
    return;
}
%clav_head_varp = $int1;
%clav_torso_varp = $int1;
%clav_bottom_varp = $int1;
%clav_upper_arm_right_varp = $int1;
%clav_lower_arm_right_varp = $int1;
%clav_arm_connect_right_varp = $int1;
%clav_upper_arm_left_varp = $int1;
%clav_lower_arm_left_varp = $int1;
%clav_arm_connect_left_varp = $int1;
~script6650;
~script6662;
