// 1213
[clientscript,info_box_coord_timer](int $int0)
def_int $int1 = 0;
def_component $component2 = ~script15709(1);
if ($int0 = 0) {
    while ($int1 < 16) {
        ~info_fade_component($int1, $component2);
        $int1 = calc($int1 + 1);
    }
    if (cc_find($component2, 9) = true & cc_gettrans = 255) {
        ~info_reset;
    }
} else if (if_find($component2) = true) {
    cc_setontimer("info_box_coord_timer(calc($int0 - 1))");
}
