// 9760
[clientscript,script9760]
if (%spirittree_coord = null) {
    return;
}
~script8844(1, 13, 8, spirittree2:spirittree_window_close_button, -1);
def_int $int0 = 0;
def_int $int1 = 16;
def_int $int2 = 0;
def_component $component3 = null;
while ($int0 < enum_getoutputcount(spirittree_component)) {
    $int2 = ~script9765($int0);
    $component3 = enum(int, component, spirittree_component, $int0);
    if_setonmouseover("script9761($int0, $int2)", $component3);
    if_setonmouserepeat("script9762($int0, $int2)", $component3);
    if_setonmouseleave("script9763($int0, $int2)", $component3);
    if ($int2 = 1) {
        if_setop(1, "Teleport", $component3);
        if_setgraphic("aif_spirittree_map,0", $component3);
        if ($int0 < 10) {
            ~script8844(1, $int1, 8, $component3, -1);
        } else {
            switch_int ($int0) {
                case 10 :
                    ~script8844(1, 70, 8, $component3, -1);
                case 11 :
                    ~script8844(1, 53, 8, $component3, -1);
            }
        }
    } else {
        if_setop(1, "", $component3);
        if_setgraphic("aif_spirittree_map,2", $component3);
    }
    $int0 = calc($int0 + 1);
    $int1 = calc($int1 + 1);
}
