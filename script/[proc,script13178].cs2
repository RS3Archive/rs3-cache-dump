// 13178
[proc,script13178](dbrow $dbrow0)(struct, struct, graphic)
def_struct $struct1 = struct_35515;
def_graphic $graphic2 = rs3_ragdoll_glow_unavailable;
def_struct $struct3 = struct_35559;
if ($dbrow0 ! null) {
    if (db_getfield($dbrow0, dbtable_163:col5, 0) = 2 & db_getfield($dbrow0, dbtable_163:col6, 0) = 19) {
        $struct1 = struct_35508;
        $graphic2 = rs3_ragdoll_glow_available;
        $struct3 = struct_35554;
    } else if (var_reference_get(db_getfield($dbrow0, dbtable_163:col26, 0)) >= db_getfield($dbrow0, dbtable_163:col27, 0)) {
        $struct1 = struct_35508;
        $graphic2 = rs3_ragdoll_glow_available;
        if (db_getfield($dbrow0, dbtable_163:col8, 0) = 12) {
            $struct3 = struct_35558;
        } else if (db_getfield($dbrow0, dbtable_163:col28, 0) = 1 & playermember = false) {
            $struct3 = struct_35555;
        }
    } else {
        switch_int (db_getfield($dbrow0, dbtable_163:col8, 0)) {
            case 1, 2 :
                $struct1 = struct_35522;
                $graphic2 = rs3_ragdoll_glow_buyable;
            case 14 :
                $struct1 = struct_35529;
                $graphic2 = rs3_ragdoll_glow_treasure_hunter;
                $struct3 = struct_35557;
            case 8, 9, 4 :
                $struct1 = struct_35529;
                $graphic2 = rs3_ragdoll_glow_treasure_hunter;
            case 12 :
                $struct1 = struct_35508;
                $graphic2 = rs3_ragdoll_glow_available;
                $struct3 = struct_35558;
        }
        if ($struct3 = struct_35559 & db_getfield($dbrow0, dbtable_163:col23, 0) > calc(~date_runeday - 14) & db_getfield($dbrow0, dbtable_163:col23, 0) <= ~date_runeday) {
            $struct3 = struct_35556;
        }
    }
}
return($struct1, $struct3, $graphic2);
