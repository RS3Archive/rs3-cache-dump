// 2377
[proc,makeover_gender](int $int0, component $component1, component $component2)
if ($int0 = 0) {
    if_setcolour(^white, $component1);
    if_settextshadow(true, $component1);
    if_setcolour(~script10495(3), $component2);
    if_settextshadow(false, $component2);
    cc_deleteall(makeover_mage:male_select);
    cc_deleteall(makeover_mage:female_select);
    ~script13971(makeover_mage:male_select, null, rs3tli_neutral_button_disabled, "Selected", true);
    ~script13969(makeover_mage:female_select, null, rs3tli_neutral_button, "Select");
} else {
    if_setcolour(^white, $component2);
    if_settextshadow(true, $component2);
    if_setcolour(~script10495(3), $component1);
    if_settextshadow(false, $component1);
    cc_deleteall(makeover_mage:male_select);
    cc_deleteall(makeover_mage:female_select);
    ~script13969(makeover_mage:male_select, null, rs3tli_neutral_button_disabled, "Select");
    ~script13971(makeover_mage:female_select, null, rs3tli_neutral_button, "Selected", true);
}
