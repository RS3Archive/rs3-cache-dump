// 2377
[proc,makeover_gender](int $int0, component $component1, component $component2)
if ($int0 = 0) {
    if_setcolour(^white, $component1);
    if_settextshadow(true, $component1);
    if_setcolour(~script10495(3), $component2);
    if_settextshadow(false, $component2);
    cc_deleteall(interface_900:com_15);
    cc_deleteall(interface_900:com_9);
    ~script13971(interface_900:com_15, null, struct_24106, "Selected", true);
    ~script13969(interface_900:com_9, null, struct_28554, "Select");
} else {
    if_setcolour(^white, $component2);
    if_settextshadow(true, $component2);
    if_setcolour(~script10495(3), $component1);
    if_settextshadow(false, $component1);
    cc_deleteall(interface_900:com_15);
    cc_deleteall(interface_900:com_9);
    ~script13969(interface_900:com_15, null, struct_24106, "Select");
    ~script13971(interface_900:com_9, null, struct_28554, "Selected", true);
}
