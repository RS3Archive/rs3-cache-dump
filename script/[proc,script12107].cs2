// 12107
[proc,script12107](component $component0)
def_int $int1 = if_getwidth($component0);
def_string $string0 = "Turn off Active Prayers";
if (~script12015($component0) = true) {
    if (stringwidth($string0, notosans_14) > $int1) {
        $string0 = "Turn off";
        if (stringwidth($string0, notosans_14) > $int1) {
            $string0 = "Off";
        }
    }
} else {
    $string0 = "Activate Quick Prayers";
    if (stringwidth($string0, notosans_14) > $int1) {
        $string0 = "Activate QP";
        if (stringwidth($string0, notosans_14) > $int1) {
            $string0 = "QP";
        }
    }
}
if_settext($string0, $component0);
