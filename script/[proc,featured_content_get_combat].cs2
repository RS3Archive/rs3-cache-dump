    case 3 :
        $struct0 = enum(int, struct, omge_challenges_combat, %omge_challenge_current_id_3);
        return(false, ~challenge_name($struct0), struct_param($struct0, task_details), $graphic1);
    case 4 :
        $struct0 = enum(int, struct, omge_challenges_combat, %omge_challenge_current_id_4);
        return(false, ~challenge_name($struct0), struct_param($struct0, task_details), $graphic1);
    case 5 :
        $struct0 = enum(int, struct, omge_challenges_combat, %omge_challenge_current_id_5);
