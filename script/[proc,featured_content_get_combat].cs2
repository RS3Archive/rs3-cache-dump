switch_int (random(3)) {
    case 0 :
        $graphic1 = rs3_challenge_melee;
    case 1 :
        $graphic1 = rs3_challenge_magic;
    case 2 :
        $graphic1 = rs3_challenge_ranged;
}
switch_int (%omge_featured_interface_combat_challenge) {
    case 1 :
        $struct0 = enum(int, struct, omge_challenges_combat, %omge_challenge_current_id_1);
