// 6192
[proc,script6192]
if (%evalid_received_rewards < 1 & %evalid_rewards < 1) {
    if_sethide(false, lobbyscreen:email_validation);
    if_sethide(true, lobbyscreen_evalid:request_email);
    if_sethide(false, lobbyscreen_evalid:success);
    if_settext("You have successfully validated your email address.<br> This gives you access to all these perks.", lobbyscreen_evalid:body_text);
    if_settext("To collect your perks head into the game world and visit Diango in Draynor Market. Your extra bank space has already been added to your account.", lobbyscreen_evalid:success_text);
    if_settext("continue", lobbyscreen_evalid:evalid_success_confirm_button);
} else {
    ~script6190;
}
