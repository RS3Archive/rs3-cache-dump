// 12792
[proc,script12792]()(int)
def_int $int0 = inv_totalcat(worn, trh103_outfit_warped);
if ($int0 >= 5) {
    return(5);
} else if (calc($int0 + inv_totalcat(worn, trh103_outfit_frozen)) >= 5) {
    return(1);
} else if (calc($int0 + inv_totalcat(worn, trh103_outfit_furnished)) >= 5) {
    return(2);
} else if (calc($int0 + inv_totalcat(worn, trh103_outfit_abandoned)) >= 5) {
    return(3);
} else if (calc($int0 + inv_totalcat(worn, trh103_outfit_occult)) >= 5) {
    return(4);
}
return(0);
