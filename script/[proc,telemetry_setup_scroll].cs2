// 371
[proc,telemetry_setup_scroll](component $component0, component $component1, component $component2, int $int3)
if (~swipe_enabled_check($component2) = false) {
    return;
}
~script14191($component2, 20, 10, 8, $int3);
if (calc(12 & $int3) > 0) {
    if_setonswipevertical("scrollbar_vertical_swipe($component0, $component2, event_mousey)", $component2);
}
if (calc(3 & $int3) > 0) {
    if_setonswipehorizontal("scrollbar_horizontal_swipe($component1, $component2, event_mousex)", $component2);
}
