// 9812
[clientscript,script9812](int $setsize0, int $int1, component $component2, component $component3)
if (if_find($component2) = true & .if_find(cc_getparentlayer) = true) {
    cc_setsize($int1, scale(~script9550($setsize0, $int1, .cc_getwidth), cc_param(rs3tli_component_initial_width), cc_param(rs3tli_component_initial_height)), $setsize0, ^setsize_abs);
    if ($component3 ! $component2) {
        cc_callonresize;
    }
}
