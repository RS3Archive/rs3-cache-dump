        $string0 = "Give your Astromancer Credits to the Armadyl faction.";
    case trh55_world_event:armadyl_amount :
        $string0 = "You have given <tostring(%trh55_armadyl_currency)>/<tostring(1000)> credits to the Armadyl faction.";
    case trh55_world_event:godless_button :
        $string0 = "Give your Astromancer Credits to the Godless faction.";
    case trh55_world_event:godless_amount :
        $string0 = "You have given <tostring(%trh55_godless_currency)>/<tostring(1000)> credits to the Godless faction.";
    case trh55_world_event:saradomin_tier_one :
        $string0 = oc_param(trh55_world_event_saradomin_legs, trh_extended_desc);
    case trh55_world_event:saradomin_tier_two :
        $string0 = oc_param(trh55_world_event_saradomin_torso, trh_extended_desc);
    case trh55_world_event:saradomin_tier_three :
        $string0 = "A follower pet to represent your faith in Saradomin.";
    case trh55_world_event:zamorak_tier_one :
        $string0 = oc_param(trh55_world_event_zamorak_legs, trh_extended_desc);
    case trh55_world_event:zamorak_tier_two :
        $string0 = oc_param(trh55_world_event_zamorak_torso, trh_extended_desc);
    case trh55_world_event:zamorak_tier_three :
        $string0 = "A follower pet to represent your faith in Zamorak.";
    case trh55_world_event:armadyl_tier_one :
        $string0 = oc_param(trh55_world_event_armadyl_legs, trh_extended_desc);
    case trh55_world_event:armadyl_tier_two :
        $string0 = oc_param(trh55_world_event_armadyl_torso, trh_extended_desc);
    case trh55_world_event:armadyl_tier_three :
        $string0 = "A follower pet to represent your faith in Armadyl.";
    case trh55_world_event:godless_tier_one :
