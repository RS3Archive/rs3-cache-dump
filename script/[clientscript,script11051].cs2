// 11051
[clientscript,script11051](component $component0)
if ($component0 = null) {
    return;
}
def_string $string0 = "";
switch_component ($component0) {
    case trh55_world_event:saradomin_button :
        $string0 = "Give your Astromancer Credits to the Saradomin faction.";
    case trh55_world_event:saradomin_amount :
        $string0 = "You have given <tostring(%trh55_saradomin_currency)>/<tostring(1000)> credits to the Saradomin faction.";
    case trh55_world_event:zamorak_button :
        $string0 = "Give your Astromancer Credits to the Zamorak faction.";
    case trh55_world_event:zamorak_amount :
        $string0 = "You have given <tostring(%trh55_zamorak_currency)>/<tostring(1000)> credits to the Zamorak faction.";
