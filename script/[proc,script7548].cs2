// 7548
[proc,script7548]
if (%wof33_emote_love_unlocked = 1) {
    if_settrans(200, wof33_valentines_shop:love_emote_icon);
}
if (%wof33_emote_hate_unlocked = 1) {
    if_settrans(200, wof33_valentines_shop:hate_emote_icon);
}
if (%wof33_pendant_love_owned = 1) {
    if_settrans(200, wof33_valentines_shop:love_pendant_icon);
}
if (%wof33_pendant_hate_owned = 1) {
    if_settrans(200, wof33_valentines_shop:hate_pendant_icon);
}
if (map_members = false) {
    if_settrans(200, wof33_valentines_shop:love_pendant_icon);
    if_settrans(200, wof33_valentines_shop:hate_pendant_icon);
    if_settrans(200, wof33_valentines_shop:love_weapon_icon);
    if_settrans(200, wof33_valentines_shop:hate_weapon_icon);
}
