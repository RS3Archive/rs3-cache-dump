// 8759
[clientscript,script8759]
if (%oct13_isrunefest = 1) {
    if_sethide(false, oct13_therm:oct13_therm);
    if (if_find(oct13_therm:oct13_therm) = true) {
        cc_deleteall(oct13_therm:oct13_therm);
        cc_create(oct13_therm:oct13_therm, ^iftype_graphic, 0);
        cc_setposition(25, 17, ^setpos_abs_left, ^setpos_abs_top);
        cc_setsize(18, 200, ^setsize_abs, ^setsize_abs);
        cc_setgraphic(aif_oct_event_therm_bar_02);
        cc_setonvartransmit("script8756{oct13_if_data}");
        cc_create(oct13_therm:oct13_therm, ^iftype_text, 1);
        cc_setposition(19, 245, ^setpos_abs_left, ^setpos_abs_top);
        cc_setsize(32, 14, ^setsize_abs, ^setsize_abs);
        cc_settextfont(museo_sans_11pt_regular);
        cc_settextalign(^settextalign_centre, ^settextalign_centre, 0);
        cc_settext("0%");
        cc_setonvartransmit("script8756{oct13_if_data}");
    }
    ~script8757;
} else {
    if_sethide(true, oct13_therm:oct13_therm);
}
