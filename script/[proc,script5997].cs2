// 5997
[proc,script5997]
def_string $string0 = "";
def_component $component0 = null;
$string0 = "You have gained <col=F3B13F><tostring_localised(%elfcity_hefin_serenity_cap, true)></col>/<col=F3B13F><tostring_localised(20000, true)></col> Agility XP from this activity today.";
$component0 = elfcity_hefin_serenity_overlay:agility_layer;
if_setonmouserepeat("script8799($string0, event_com, event_comsubid)", $component0);
def_int $int1 = 0;
if (if_find(elfcity_hefin_serenity_overlay:agility_bar_layer) = true & .if_find(cc_getparentlayer) = true) {
    $int1 = ~scale_round(%elfcity_hefin_serenity_cap, 20000, .cc_getwidth);
    cc_setsize($int1, cc_getheight, ^setsize_abs, ^setsize_abs);
}
