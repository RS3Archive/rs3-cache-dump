// 19158
[proc,trh182_overlay_onload]
if_sethide(false, interface_1288:com_5);
if_sethide(false, interface_1288:com_3);
if_sethide(false, interface_1288:com_51);
if_sethide(false, interface_1288:com_7);
if_sethide(true, interface_1288:com_10);
switch_int (map_lang) {
    case 0 :
        if (if_getgraphic(interface_1288:com_8) = null) {
            if_setgraphic(trh182_attack_button_en, interface_1288:com_8);
        }
        if_setgraphic(trh182_vs_text_en_fr, interface_1288:com_5);
    case 2 :
        if (if_getgraphic(interface_1288:com_8) = null) {
            if_setgraphic(trh182_attack_button_fr, interface_1288:com_8);
        }
        if_setgraphic(trh182_vs_text_en_fr, interface_1288:com_5);
    case 1 :
        if (if_getgraphic(interface_1288:com_8) = null) {
            if_setgraphic(trh182_attack_button_de, interface_1288:com_8);
        }
        if_setgraphic(trh182_vs_text_de_pt, interface_1288:com_5);
    case 3 :
        if (if_getgraphic(interface_1288:com_8) = null) {
            if_setgraphic(trh182_attack_button_pt, interface_1288:com_8);
        }
        if_setgraphic(trh182_vs_text_de_pt, interface_1288:com_5);
}
