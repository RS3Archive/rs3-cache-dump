// 19158
[proc,trh182_overlay_onload]
if_sethide(false, trh_academy_shared_overlay:vs);
if_sethide(false, trh_academy_shared_overlay:swirly);
if_sethide(false, trh_academy_shared_overlay:character_stats_holder);
if_sethide(false, trh_academy_shared_overlay:attack_button_layer);
if_sethide(true, trh_academy_shared_overlay:generic_interaction_button);
switch_int (map_lang) {
    case 0 :
        if (if_getgraphic(trh_academy_shared_overlay:attack_button_graphic) = null) {
            if_setgraphic(trh182_attack_button_en, trh_academy_shared_overlay:attack_button_graphic);
        }
        if_setgraphic(trh182_vs_text_en_fr, trh_academy_shared_overlay:vs);
    case 2 :
        if (if_getgraphic(trh_academy_shared_overlay:attack_button_graphic) = null) {
            if_setgraphic(trh182_attack_button_fr, trh_academy_shared_overlay:attack_button_graphic);
        }
        if_setgraphic(trh182_vs_text_en_fr, trh_academy_shared_overlay:vs);
    case 1 :
        if (if_getgraphic(trh_academy_shared_overlay:attack_button_graphic) = null) {
            if_setgraphic(trh182_attack_button_de, trh_academy_shared_overlay:attack_button_graphic);
        }
        if_setgraphic(trh182_vs_text_de_pt, trh_academy_shared_overlay:vs);
    case 3 :
        if (if_getgraphic(trh_academy_shared_overlay:attack_button_graphic) = null) {
            if_setgraphic(trh182_attack_button_pt, trh_academy_shared_overlay:attack_button_graphic);
        }
        if_setgraphic(trh182_vs_text_de_pt, trh_academy_shared_overlay:vs);
}
