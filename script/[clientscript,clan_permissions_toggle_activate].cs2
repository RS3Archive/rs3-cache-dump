// 5142
[clientscript,clan_permissions_toggle_activate](component $component0)
switch_component ($component0) {
    case clansettings:cankick_button_selected_layer :
        %clan_permissions_chat_kick_varc = -1;
    case clansettings:cantalk_button_selected_layer :
        %clan_permissions_chat_talk_varc = -1;
}
if_sethide(false, $component0);
