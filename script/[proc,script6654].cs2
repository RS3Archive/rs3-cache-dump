// 6654
[proc,script6654](component $component0)
if_setposition(calc(if_getx(if_getlayer($component0)) + if_getwidth($component0)), calc(if_gety(if_getlayer($component0)) - if_getheight(if_getlayer($component0)) / 2), ^setpos_abs_left, ^setpos_abs_top, clav_customise:part_theme_layer);
if_sethide(false, clav_customise:part_theme_layer);
if_sethide(false, clav_customise:prevent_click);
if (%clav_current_part_customise_varp = 1 | %clav_current_part_customise_varp = 2 | %clav_current_part_customise_varp = 3) {
    if_sethide(false, clav_customise:none_selected);
} else {
    if_sethide(true, clav_customise:none_selected);
}
