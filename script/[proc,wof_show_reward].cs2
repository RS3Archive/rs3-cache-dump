if_sethide(true, wheel_of_fortune:foreground_grey);
if_sethide(false, wheel_of_fortune:reward_layer);
if_sethide(true, wheel_of_fortune:play_again_layer);
if_sethide(true, wheel_of_fortune:ticker_tooltip_layer);
switch_struct ($struct0) {
    case trh87_promo :
        if_sethide(true, wheel_of_fortune:foreground_layer);
