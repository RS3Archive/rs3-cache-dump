// 19059
[proc,script19059](int $int0, component $component1, int $int2)(graphic)
def_graphic $graphic3 = null;
switch_int ($int0) {
    case 1 :
        if (%trh183_power_up_1_charges = 0) {
            if ($int2 = 1) {
                $graphic3 = trh183_power_icon_reroll_inactive_rollover;
            } else {
                $graphic3 = trh183_power_icon_reroll_inactive;
            }
        } else if ($int2 = 1) {
            $graphic3 = trh183_power_icon_reroll_rollover;
        } else {
            $graphic3 = trh183_power_icon_reroll_available;
        }
    case 2 :
        if (%trh183_power_up_2_charges = 0 | %trh183_power_up_multiplier_used = 1) {
            if ($int2 = 1) {
                $graphic3 = trh183_power_icon_multiplier_inactive_rollover;
            } else {
                $graphic3 = trh183_power_icon_multiplier_inactive;
            }
        } else if ($int2 = 1) {
            $graphic3 = trh183_power_icon_multiplier_rollover;
        } else {
            $graphic3 = trh183_power_icon_multiplier_available;
        }
    case 3 :
        if (%trh183_chests_frozen = 1) {
            if ($int2 = 1) {
                $graphic3 = trh183_power_icon_unfreeze_rollover;
            } else {
                $graphic3 = trh183_power_icon_unfreeze_available;
            }
        } else if (%trh183_power_up_3_charges = 0) {
            if ($int2 = 1) {
                $graphic3 = trh183_power_icon_freeze_inactive_rollover;
            } else {
                $graphic3 = trh183_power_icon_freeze_inactive;
            }
        } else if ($int2 = 1) {
            $graphic3 = trh183_power_icon_freeze_rollover;
        } else {
            $graphic3 = trh183_power_icon_freeze_available;
        }
}
return($graphic3);
