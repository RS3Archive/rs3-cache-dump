// 18770
[proc,script18770](string $string0)
if (if_find(combatv2_channel_bar:title_text) = true) {
    cc_settext($string0);
    cc_settextalign(^settextalign_centre, ^settextalign_centre, 12);
    if (paraheight(cc_gettext, cc_getwidth, cc_getfontmetrics) > 1) {
        if_setsize(0, calc(2 * 12 + 4), ^setsize_minus, ^setsize_abs, combatv2_channel_bar:header_layer);
        if_setsize(0, 0, ^setsize_minus, ^setsize_minus, combatv2_channel_bar:background_layer);
    }
}
