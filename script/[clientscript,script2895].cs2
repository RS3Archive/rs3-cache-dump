// 2895
[clientscript,script2895](component $component0)
if (%sfa_client_time > %sfa_event_time) {
    if (%sfa_client_timer ! 1) {
        if_setontimer("script2896($component0)", $component0);
        %sfa_client_timer = 1;
    }
} else if (%sfa_client_time = 0) {
    %sfa_client_time = %sfa_event_time;
}
