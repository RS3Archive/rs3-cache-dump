// 410
[clientscript,script410](int $int0)
if (%conq_current_phase = $int0) {
    return;
}
if_setonvarctransmit("script410(%conq_current_phase){conq_current_phase}", conq_side_turn:phase_check_layer);
if (%conq_current_team = %conq_team) {
    if_sethide(false, conq_side_turn:your_turn_layer);
    if_sethide(true, conq_side_turn:confirm_end_layer);
}
if_sethide(true, conq_side_turn:checkbox_selected_layer);
if_sethide(true, conq_side_turn:checkbox_selected_layer_1);
if_sethide(true, conq_side_turn:checkbox_selected_layer_2);
if_sethide(true, conq_side_turn:checkbox_selected_layer_3);
if_sethide(true, conq_side_turn:checkbox_deselected_layer);
if_sethide(true, conq_side_turn:checkbox_deselected_layer_1);
if_sethide(true, conq_side_turn:checkbox_deselected_layer_2);
if_sethide(true, conq_side_turn:checkbox_deselected_layer_3);
if (%conq_current_phase = 0) {
    if_sethide(false, conq_side_turn:checkbox_selected_layer);
    if_sethide(false, conq_side_turn:checkbox_deselected_layer_1);
    if_sethide(false, conq_side_turn:checkbox_deselected_layer_2);
    if_sethide(false, conq_side_turn:checkbox_deselected_layer_3);
} else if (%conq_current_phase = 1) {
    if (%conq_is_active_player = 1) {
        if (random(2) = 0) {
            sound_vorbis_volume(vk_conq_end_phase_01a, 1, 0, 255);
        } else {
            sound_vorbis_volume(vk_conq_end_phase_01b, 1, 0, 255);
        }
    }
    if_sethide(false, conq_side_turn:checkbox_selected_layer);
    if_sethide(false, conq_side_turn:checkbox_selected_layer_1);
    if_sethide(false, conq_side_turn:checkbox_deselected_layer_2);
} else if (%conq_current_phase = 2) {
    if (%conq_is_active_player = 1) {
        sound_vorbis_volume(vk_conq_end_phase_02, 1, 0, 255);
    }
    if_sethide(false, conq_side_turn:checkbox_selected_layer);
    if_sethide(false, conq_side_turn:checkbox_selected_layer_1);
    if_sethide(false, conq_side_turn:checkbox_selected_layer_2);
    if_sethide(false, conq_side_turn:checkbox_deselected_layer_3);
} else {
    if (%conq_is_active_player = 1) {
        sound_vorbis_volume(vk_conq_end_phase_03, 1, 0, 255);
    }
    if_sethide(false, conq_side_turn:checkbox_selected_layer);
    if_sethide(false, conq_side_turn:checkbox_selected_layer_1);
    if_sethide(false, conq_side_turn:checkbox_selected_layer_2);
    if_sethide(false, conq_side_turn:checkbox_selected_layer_3);
}
