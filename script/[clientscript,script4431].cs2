// 4431
[clientscript,script4431](component $component0)
def_struct $struct1 = ~clan_chat_get_struct($component0);
def_component $component2 = struct_param($struct1, clan_chat_list_parent);
def_component $component3 = struct_param($struct1, clan_chat_join_affined_graphic);
def_string $string0 = "";
def_component $component4 = struct_param($struct1, clan_chat_clanlist);
if (activeclanchannel_find_affined(0) = true) {
    if_setontimer(null, $component2);
    ~clan_chat_onclansettingstransmit($component0);
    if_setonclansettingstransmit("clan_chat_onclansettingstransmit($component0)", $component0);
    if_setonclanchanneltransmit("clan_chat_onclansettingstransmit($component0)", $component0);
