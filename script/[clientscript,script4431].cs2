    if_setonclantransmit("clan_chat_onclantransmit($component0, $component4)", $component2);
    if_setgraphic("aif_clanchat_icons,12", $component3);
} else {
    ~clan_chat_clearlist($component0);
    $string0 = "Join Clan Chat channel.";
    if_setonmouserepeat("script8799($string0, event_com, event_comsubid)", clan_chat:clan_join_affinedchat_button);
    if_setonmouseleave("script8805", clan_chat:clan_join_affinedchat_button);
