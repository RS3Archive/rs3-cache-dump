// 18466
[clientscript,script18466](component $component0, int $int1)
if (cc_find($component0, 0) = true) {
    switch_int ($int1) {
        case 2 :
            if (cc_crmview_contains("title_text") = true) {
                if_settext(cc_crmview_getstring("title_text"), db_getfield(crm_braze_lobby_main, crm_braze:col1, 0));
            }
            ~script10593(1);
        case 3, 4, 5, 6 :
            if (cc_find($component0, 0) = true) {
                cc_delete;
            }
            ~script3014(0);
    }
}
