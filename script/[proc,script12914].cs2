// 12914
[proc,script12914](obj $obj0)(int)
def_int $int1 = ~magic_runecount($obj0);
if (oc_param($obj0, ge_category) = 34 | oc_category($obj0) = lore_spell_pouch) {
    $int1 = inv_total(inv, $obj0);
    if ($obj0 = %combatv2_summoning_spell) {
        $int1 = calc($int1 + %combatv2_summoning_scrollcount);
    }
}
return($int1);
