// 6833
[proc,bslay_setup_items]
if_sethide(false, bslay_shop:items);
if_sethide(true, bslay_shop:effects);
if_sethide(true, bslay_shop:rewards);
if_sethide(false, bslay_shop:items_tab_selected_layer);
if_sethide(true, bslay_shop:effects_tab_selected_layer);
if_sethide(true, bslay_shop:rewards_tab_selected_layer);
if_setobject(enchanted_hydrix_ring_new, 1, bslay_shop:overcharge_ring_of_death_model);
if_sethide(true, bslay_shop:scrollbar);
if (%bslay_points < 40) {
    ~bslay_disable_button(49414177, 1);
}
if (%bslay_points < 300) {
    ~bslay_disable_button(49414193, 1);
}
if (%bslay_points < 25 & %smki_slayer_points < 250) {
    ~bslay_disable_button(49414209, 1);
}
