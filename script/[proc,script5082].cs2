// 5082
[proc,script5082](component $component0)
def_int $int1 = 0;
def_int $int2 = 0;
def_int $int3 = 0;
if (%welcome_screen_time ! -1 & .cc_find($component0, calc(%welcome_screen_time * 10 + 2)) = true) {
    $int1 = calc(~script4405 + .cc_getheight - ~script3366(clan_field_setup:dropdown_container));
    if ($int1 >= if_getheight($component0)) {
        if_sethide(true, clan_field_setup:dropdown);
    } else if ($int1 <= 0) {
        if_sethide(true, clan_field_setup:dropdown);
    } else {
        if_sethide(false, clan_field_setup:dropdown);
        if_setposition(calc(~script1815 - ~script3365(clan_field_setup:dropdown_container)), $int1, ^setpos_abs_left, ^setpos_abs_top, clan_field_setup:dropdown);
        if (.if_find(clan_field_setup:dropdown) = true) {
            $int3 = calc(.cc_param(clan_field_element_h) + 8);
            $int2 = max(min($int3, calc(if_getheight(clan_field_setup:dropdown_container) - $int1)), 0);
            .cc_setsize(.cc_param(clan_field_element_w), $int2, ^setsize_abs, ^setsize_abs);
        }
        if_setontimer("script5083(event_com, %welcome_screen_time, calc(clientclock + 2))", clan_field_setup:dropdown);
    }
} else {
    if_sethide(true, clan_field_setup:dropdown);
}
