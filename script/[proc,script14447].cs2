// 14447
[proc,script14447](int $int0)(int)
def_int $int1 = calc($int0 % 32);
switch_int (calc($int0 / 32)) {
    case 0 :
        return(testbit(%6awe3_seedicide_1, $int1));
    case 1 :
        return(testbit(%6awe3_seedicide_2, $int1));
    case 2 :
        return(testbit(%6awe3_seedicide_3, $int1));
    case 3 :
        return(testbit(%6awe3_seedicide_4, $int1));
    case default :
        ~error("Seedicide get state. Number <tostring($int0)> is not supported.");
}
return(-1);
