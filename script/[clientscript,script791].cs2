// 791
[clientscript,script791](component $component0, int $int1, int $int2)
if (targetmode_active = true) {
    targetmode_cancel;
    if (cc_find($component0, $int1) = true) {
        if (cc_gettrans ! 0) {
            cc_setontimer("script1621($component0, $int1, 0, 8)");
        } else {
            cc_setontimer(null);
        }
    }
    return;
} else if (clientclock > $int2 & cc_find($component0, $int1) = true) {
    if (cc_gettrans ! 0) {
        cc_setontimer("script1621($component0, $int1, 0, 8)");
    } else {
        cc_setontimer(null);
    }
}
