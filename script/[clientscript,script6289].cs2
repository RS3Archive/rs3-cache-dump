// 6289
[clientscript,script6289]
def_int $int0 = 0;
if (calc(clientclock % 4) = 0 & cc_find(cruc_battle_overlay:brp_layer, 0) = true) {
    if (%cruc_overlay_brp_pause = 0) {
        $int0 = cc_gety;
        if (++$int0 > 30) {
            %cruc_overlay_brp_pause = 1;
        } else {
            cc_setposition(0, $int0, ^setpos_abs_left, ^setpos_abs_top);
        }
    } else if (++%cruc_overlay_brp_pause = 30) {
        cc_delete;
        if_setontimer(null, cruc_battle_overlay:brp_layer);
    }
}
