// 10964
[proc,script10964]
def_string $string0 = "Unlocked!";
if (~ironman_mode = true) {
    $string0 = "Passed";
}
def_int $int0 = if_getheight(trh44_valentines15_milestones:hate_fill);
if ($int0 >= 35) {
    if_settext($string0, trh44_valentines15_milestones:hate_low_cost);
    if_sethide(false, trh44_valentines15_milestones:hate_low_highlight);
}
if ($int0 >= 105) {
    if_settext($string0, trh44_valentines15_milestones:hate_med_cost);
    if_sethide(false, trh44_valentines15_milestones:hate_med_highlight);
}
if ($int0 >= 225) {
    if_settext("Unlocked!", trh44_valentines15_milestones:hate_high_cost);
    if_sethide(false, trh44_valentines15_milestones:hate_high_highlight);
}
if ($int0 >= 325) {
    if_settext("Unlocked!", trh44_valentines15_milestones:hate_absurd_cost);
    if_sethide(false, trh44_valentines15_milestones:hate_absurd_highlight);
}
if ($int0 >= 398) {
    if_sethide(false, trh44_valentines15_milestones:bubbles_1);
}
if ($int0 >= 398 & if_getheight(trh44_valentines15_milestones:love_fill) >= 398) {
    if_settext("Unlocked!", trh44_valentines15_milestones:insane_cost);
    if_sethide(false, trh44_valentines15_milestones:insane_highlight);
}
return;
