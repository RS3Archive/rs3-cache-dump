// 7716
[proc,script7716](component $component0, component $component1, int $int2, component $component3, string $string0)
if (cc_find(clantool_profile:variables, $int2) = true) {
    cc_setonvarctransmit(null);
    cc_sethide(false);
    cc_settext($string0);
    if_sethide(true, clantool_profile:text_input_box);
    if_sethide(true, $component0);
    if_sethide(true, $component1);
    if_sethide(true, $component3);
    if_settext("", $component0);
}
