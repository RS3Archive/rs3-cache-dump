// 20964
[proc,script20964](obj $obj0)(boolean)
if (%league_active_player > 0) {
    switch_obj ($obj0) {
        case naturerune :
            if (~inv_find(inv, league_2_transmute_relic, 0) ! -1 | inv_getobj(worn, 17) = league_2_transmute_relic) {
                return(true);
            }
    }
}
return(false);
