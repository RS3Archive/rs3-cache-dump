// 16585
[proc,script16585](obj $obj0)(int)
switch_obj ($obj0) {
    case default :
        return(1);
    case mhaw_may22_power_bundle_giftbox :
        return(max(0, calc(%mhaw_may22_power_bundles_purchased - %mhaw_may22_power_bundles_opened - ~obj_gettotal($obj0))));
    case mhaw_may22_cosmetic_bundle_giftbox :
