// 19121
[proc,trh201_chest_setup]
def_int $int0 = calc(22 + random(72));
if_setmodelanim(trh_chest_closed_idle, wheel_of_fortune:chest_model_1);
if_setontimer("script9683(wheel_of_fortune:chest_model_1, $int0)", wheel_of_fortune:chest_model_1);
if_setontimer(null, wheel_of_fortune:wheel_spin_button_active_layer_1);
if_setonmouseover("wof_chest_mouseover(wheel_of_fortune:chest_model_1)", wheel_of_fortune:wheel_spin_button_active_layer_1);
if_setonmouseleave("wof_chest_mouseleave(wheel_of_fortune:chest_model_1)", wheel_of_fortune:wheel_spin_button_active_layer_1);
if_setsize(435, 400, ^setsize_abs, ^setsize_abs, wheel_of_fortune:chest_layer_1);
if_setposition(60, 178, ^setpos_abs_left, ^setpos_abs_top, wheel_of_fortune:chest_layer_1);
if_setposition(55, 0, ^setpos_abs_left, ^setpos_abs_top, wheel_of_fortune:chest_model_1);
if_setsize(330, 200, ^setsize_abs, ^setsize_abs, wheel_of_fortune:wheel_spin_button_layer_1);
if_setposition(80, 0, ^setpos_abs_left, ^setpos_abs_top, wheel_of_fortune:wheel_spin_button_layer_1);
