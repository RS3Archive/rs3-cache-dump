// 10556
[proc,script10556](obj $obj0)(int)
def_int $int1 = inv_total(inv, $obj0);
def_int $int2 = inv_total(bank, $obj0);
if ($int1 = ^max_32bit_int | $int2 = ^max_32bit_int) {
    return(^max_32bit_int);
}
if (calc(^max_32bit_int - $int1 - $int2) < 0) {
    return(^max_32bit_int);
}
return(calc($int1 + $int2));
