// 6804
[proc,skillpets_combat_unlocked]()(int)
return(calc(%skillpets_slayer_unlocked + %skillpets_attack_unlocked + %skillpets_strength_unlocked + %skillpets_defence_unlocked + %skillpets_constitution_unlocked + %skillpets_ranged_unlocked + %skillpets_prayer_unlocked + %skillpets_magic_unlocked + %skillpets_necromancy_unlocked + %skillpets_summoning_unlocked));
