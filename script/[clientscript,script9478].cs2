// 9478
[clientscript,script9478]
if (%6awe2_contribution_currency = 0) {
    mes("You have no votes to spend.");
    return;
}
if_sethide(false, 6awe2_vote:confirm_layer);
if_sethide(true, 6awe2_vote:choice_1);
if_sethide(true, 6awe2_vote:choice_2);
if_settext(tostring_localised(%6awe2_votedisplay, true), 6awe2_vote:votes_to_spend);
