// 6326
[proc,script6326](int $int0, component $component1, component $component2)
if ($int0 = 1) {
    if_setgraphic("aif_treasure_chest_buttons,2", $component1);
    if_settrans(100, $component1);
    if_sethide(true, $component2);
    if_settrans(255, $component2);
    if_clearscripthooks($component1);
    if_clearscripthooks($component2);
} else {
    if_setgraphic("aif_treasure_chest_buttons,0", $component1);
    if_settrans(100, $component1);
    if_sethide(false, $component2);
    if_setonmouserepeat("script6327(event_com)", $component2);
    if_setonop("script6329(event_op, $component2)", $component1);
}
