// 6897
[proc,script6897]
def_string $string0 = "Press 'Confirm' when you're happy.";
if (%duel3_confirm = 1) {
    ~script13972(duel3_confirm:button, null, rs3tli_positive_button, "Wait...", 1);
    $string0 = "Waiting for opponent...";
} else {
    ~script13972(duel3_confirm:button, null, rs3tli_positive_button, "Confirm", 0);
    if (%friends_lastscrollpos = true) {
        $string0 = append($string0, "<br>(Your opponent has confirmed.)");
    }
}
if (reboottimer > 0) {
    $string0 = "<col=ff0000>You will forfeit if the server reboots during your duel.</col>";
}
if_settext($string0, duel3_confirm:output);
