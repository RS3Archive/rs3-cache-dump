// 9610
[proc,patchy_highlight](int $int0)
if ($int0 = -1) {
    if_sethide(true, patchy_interface:highlight);
} else if (cc_find(patchy_interface:click, $int0) = true) {
    if_sethide(false, patchy_interface:highlight);
    if_setsize(cc_getwidth, cc_getheight, ^setsize_abs, ^setsize_abs, patchy_interface:highlight);
    if_setposition(cc_getx, cc_gety, ^setpos_abs_left, ^setpos_abs_top, patchy_interface:highlight);
}
