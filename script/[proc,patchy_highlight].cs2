// 9610
[proc,patchy_highlight](int $int0)
if ($int0 = -1) {
    if_sethide(true, interface_419:com_6);
} else if (cc_find(interface_419:com_5, $int0) = true) {
    if_sethide(false, interface_419:com_6);
    if_setsize(cc_getwidth, cc_getheight, ^setsize_abs, ^setsize_abs, interface_419:com_6);
    if_setposition(cc_getx, cc_gety, ^setpos_abs_left, ^setpos_abs_top, interface_419:com_6);
