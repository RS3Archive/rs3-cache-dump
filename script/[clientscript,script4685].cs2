// 4685
[clientscript,script4685]
def_string $string0 = tostring(%loy_wave_total);
def_string $string1 = "Waiting for next wave...";
if (%loy_wave_waiting ! 0) {
    if_sethide(false, loy_waves:waiting_layer);
    if_setsize(if_getwidth(loy_waves:background), 79, ^setsize_abs, ^setsize_abs, loy_waves:background);
} else {
    if_sethide(true, loy_waves:waiting_layer);
    if_setsize(if_getwidth(loy_waves:background), 45, ^setsize_abs, ^setsize_abs, loy_waves:background);
}
~script4699(29294603, loy_waves:gfx_box_brown_1, loy_waves:gfx_box_blue_1, "Wave", $string0);
if (%loy_wave_waiting ! 0) {
    ~script4699(29294606, loy_waves:gfx_box_brown_2, loy_waves:gfx_box_blue_2, "Waiting?", $string1);
}
