def_obj $obj2 = inv_getobj(worn_display_preview, 3);
if (%mtx_skill_anim_walk_override ! 8 & $int0 = 0 | %mtx_skill_anim_walk_override = 8 & $int0 = 1) {
    if ($int0 = 1) {
        if ($obj2 ! null) {
            return(bas_getanim_ready(struct_param(oc_param($obj2, weapon_category), combatv2_casual_bas)));
        } else {
            return(bas_getanim_ready(default_human));
        }
    }
    return(null);
}
if ($obj2 ! null) {
    switch_struct (oc_param($obj2, weapon_category)) {
        case combatv2_weapon_maul :
            $seq1 = mtx93_zoltan_showcase_player_revenant_maul_idle;
        case combatv2_weapon_staff :
            $seq1 = mtx93_zoltan_showcase_player_revenant_staff_idle;
        case default :
            $seq1 = mtx93_zoltan_showcase_player_revenant_idle;
    }
}
if (oc_param(inv_getobj(worn_display_preview, 5), combatv2_item_is_shield) = 1) {
    $seq1 = mtx93_zoltan_showcase_player_revenant_idle;
}
return($seq1);
