// 213
[clientscript,script213](component $component0, component $component1, component $component2, component $component3)
switch_int (%darkness_level) {
    case default :
        if_settrans(255, $component2);
    case 1 :
        if_settrans(200, $component2);
    case 2 :
        if_settrans(150, $component2);
    case 3 :
        if_settrans(50, $component2);
}
switch_int (%playerdesign2_client_feetcol) {
    case default :
        if_sethide(true, $component0);
        if_sethide(false, $component2);
    case 1 :
        ~tutorial3_fadeout(^black, 20, $component3);
    case 2 :
        if_sethide(false, $component0);
        if_setmodelanim(luc2_chasm_cutscene, $component1);
        if_sethide(true, $component2);
        ~tutorial3_fadein(10, $component3);
    case 3 :
        if_sethide(true, $component0);
        if_sethide(true, $component2);
        ~tutorial3_fadein(50, $component3);
    case 4 :
        if_sethide(false, $component0);
        if_setmodelanim(luc2_chasm_cutscene_reverse, $component1);
        if_sethide(true, $component2);
        ~tutorial3_fadein(115, $component3);
    case 5 :
        if_sethide(true, $component0);
        if_sethide(false, $component2);
        ~tutorial3_fadein(50, $component3);
}
