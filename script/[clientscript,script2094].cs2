// 2094
[clientscript,script2094]
if (%snp_tut_flash_counter_client < 100) {
    %snp_tut_flash_counter_client = calc(%snp_tut_flash_counter_client + 1);
}
if (%snp_tut_flash_counter_client = 50) {
    if_sethide(true, snp_tutorial_game_overlay:obelisk_flash_layer);
}
if (%snp_tut_flash_counter_client = 100) {
    if_sethide(false, snp_tutorial_game_overlay:obelisk_flash_layer);
    %snp_tut_flash_counter_client = 0;
}
