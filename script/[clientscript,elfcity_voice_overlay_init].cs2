// 10598
[clientscript,elfcity_voice_overlay_init](component $component0, component $component1, component $component2, component $component3)
def_graphic $graphic4 = ~elfcity_get_clan_icon(%elfcity_voice1_player);
def_graphic $graphic5 = ~elfcity_get_clan_icon(%elfcity_voice2_player);
if ($graphic4 = null) {
    if_sethide(true, $component0);
} else {
    if_setgraphic($graphic4, $component1);
    if_sethide(false, $component0);
}
if ($graphic5 = null) {
    if_sethide(true, $component2);
} else {
    if_setgraphic($graphic5, $component3);
    if_sethide(false, $component2);
}
