// 6935
[proc,script6935]
def_int $int0 = 0;
if (%worldswitcher_1stfavfailed = true) {
    $int0 = 69;
}
if (string_length(%duel3_problemwithoptions) > 0) {
    if_sethide(true, duel3_options:accept);
    if_sethide(true, duel3_options:save);
    if_setsize($int0, 0, ^setsize_minus, ^setsize_minus, duel3_options:output);
    if_settext(%duel3_problemwithoptions, duel3_options:output);
    return;
}
if_sethide(false, duel3_options:accept);
if_sethide(false, duel3_options:save);
if_setsize($int0, if_getheight(duel3_options:accept), ^setsize_minus, ^setsize_minus, duel3_options:output);
def_string $string0 = "";
def_string $string1 = "<col=ff0000>You will forfeit if the server reboots during your duel.</col>";
if (%vkq2_chem_update = true) {
    ~script13973(duel3_options:accept, null, rs3tli_positive_button, "---", true, 0);
    if_sethide(false, duel3_options:accept_disabled);
    $string0 = "<col=ff0000>Check the options carefully.</col>";
} else if (%duel3_accept = 1) {
    ~script13973(duel3_options:accept, null, rs3tli_positive_button, "Wait...", false, 1);
    if_sethide(false, duel3_options:accept_disabled);
    if (reboottimer > 0) {
        $string0 = $string1;
    } else {
        $string0 = "Waiting for opponent...";
    }
} else {
    ~script13973(duel3_options:accept, null, rs3tli_positive_button, "Accept", false, 0);
    if_sethide(true, duel3_options:accept_disabled);
    if (reboottimer > 0) {
        $string0 = $string1;
    } else {
        $string0 = "Press 'Accept' when you're happy.";
        if (%friends_lastscrollpos = true) {
            $string0 = append($string0, "<br>(Your opponent has accepted.)");
        }
    }
}
if_settext($string0, duel3_options:output);
